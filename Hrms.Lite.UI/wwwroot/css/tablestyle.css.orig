



:root {
    --main-color-one: #2cc185;
    --main-color-one-hover: #0e9c62;
    /*   --blue-color-theme: #1a84d9;*/
    --blue-color-theme-hover: #0060ad;
    --green-color-theme: #2cc185;
    --green-color-theme-hover: #0e9c62;
    --backcolor: #eaedf1;
}

@media only screen and (min-width: 769px) {
    /* Onboarding List */
    .onboarding table thead tr th:nth-child(1),
    .onboarding table tbody tr td:nth-child(1) {
        width: 5%;
    }

    .onboarding table thead tr th:nth-child(2),
    .onboarding table tbody tr td:nth-child(2) {
        width: 16%;
        font-weight: 500 !important;
        background-color: var(--backcolor);
    }

    .onboarding table thead tr th:nth-child(3),
    .onboarding table tbody tr td:nth-child(3) {
        width: 15%;
    }

    .onboarding table thead tr th:nth-child(4),
    .onboarding table tbody tr td:nth-child(4) {
        width: 10%;
    }

    .onboarding table thead tr th:nth-child(5),
    .onboarding table tbody tr td:nth-child(5) {
        width: 10%;
    }

    .onboarding table thead tr th:nth-child(6),
    .onboarding table tbody tr td:nth-child(6) {
        width: 9%;
    }

    .onboarding table thead tr th:nth-child(7),
    .onboarding table tbody tr td:nth-child(7) {
        width: 8%;
        font-weight: 500 !important;
        background-color: var(--backcolor);
    }

    .onboarding table thead tr th:nth-child(8),
    .onboarding table tbody tr td:nth-child(8) {
        width: 8%;
    }

    .onboarding table thead tr th:nth-child(9),
    .onboarding table tbody tr td:nth-child(9) {
        width: 16%;
    }
    /* Onboarding List End */


    /* Onboarding Pre Enrollment Approval List */
