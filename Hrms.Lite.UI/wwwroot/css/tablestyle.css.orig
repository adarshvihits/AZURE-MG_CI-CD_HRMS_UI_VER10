@media only screen and (max-width: 1367px) {
    .daily-attendance-entry-list table thead tr th:nth-child(1),
    .daily-attendance-entry-list table tbody tr td:nth-child(1) {
        width: 120px !important;
        min-width:120px;
        max-width:120px;
       
    }
    .daily-attendance-entry-list table thead tr th:nth-child(2),
    .daily-attendance-entry-list table tbody tr td:nth-child(2) {
        width: 200px !important;
        min-width: 200px;
        max-width: 200px;
    }
    .daily-attendance-entry-list table thead tr th,
    .daily-attendance-entry-list table tbody tr td {
        width: 35px !important;
        min-width: 35px;
        max-width: 35px;
    }


    .daily-footer tr td:nth-child(1) {
        width: 112px !important;
    }

    .daily-footer tr td:nth-child(2) {
        width: 192px !important;
    }

    .daily-footer tr td {
        width: 33px !important;
    }


