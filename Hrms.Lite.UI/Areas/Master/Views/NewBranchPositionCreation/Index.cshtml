@model Hrms.Lite.Shared.Master.NewBranchPositionCreationViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/scripts/Master/NewBranchPositionCreation.js?v=6"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>

<script>
    $(document).ready(function () {
        GetList();
    });
</script>


 <style>
    /* =========================================================
       POSITION REQUEST MODAL
       ========================================================= */

    #positionRequestModal .modal-dialog {
        max-width: 1320px;
        width: calc(100% - 30px);
        margin: 1rem auto;
    }

    #positionRequestModal .modal-content {
        max-height: 96vh;
        border: none;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
    }


    /* =========================================================
       HEADER
       ========================================================= */

    #positionRequestModal .modal-header {
        flex-shrink: 0;
        padding: 18px 24px;
        background: #ffffff;
        border-bottom: 1px solid #e5e7eb;
    }

    #positionRequestModal .modal-title {
        margin: 0;
        font-size: 18px;
        font-weight: 600;
        color: #172b4d;
    }

    #positionRequestModal .modal-header .close {
        margin: 0;
        padding: 0;
        width: 32px;
        height: 32px;

        display: flex;
        align-items: center;
        justify-content: center;

        border: none;
        border-radius: 6px;
        background: transparent;

        color: #6b7280;
        opacity: 1;
    }

    #positionRequestModal .modal-header .close:hover {
        background: #f3f4f6;
        color: #111827;
    }


    /* =========================================================
       BODY
       ========================================================= */

    #positionRequestModal .modal-body {
        overflow-y: auto;
        padding: 24px;
        background: #ffffff;
    }

    /*
       Nice scrollbar
    */

    #positionRequestModal .modal-body::-webkit-scrollbar,
    #positionRequestModal #jdEditor::-webkit-scrollbar {
        width: 6px;
    }

    #positionRequestModal .modal-body::-webkit-scrollbar-track,
    #positionRequestModal #jdEditor::-webkit-scrollbar-track {
        background: #f1f3f5;
    }

    #positionRequestModal .modal-body::-webkit-scrollbar-thumb,
    #positionRequestModal #jdEditor::-webkit-scrollbar-thumb {
        background: #c7cdd4;
        border-radius: 10px;
    }

    #positionRequestModal .modal-body::-webkit-scrollbar-thumb:hover,
    #positionRequestModal #jdEditor::-webkit-scrollbar-thumb:hover {
        background: #aeb5bd;
    }


    /* =========================================================
       FORM SECTION
       ========================================================= */

    #positionRequestModal .form-section {
        width: 100%;
    }


    /* =========================================================
       COMMON FIELD
       ========================================================= */

    #positionRequestModal .field {
        min-width: 0;
        margin-bottom: 16px;
    }

    #positionRequestModal .field-label {
        display: block;
        margin-bottom: 7px;

        font-size: 13px;
        font-weight: 600;
        color: #374151;
    }


    /* =========================================================
       TOP ROW
       Positions / Priority / Target Date
       ========================================================= */

    #positionRequestModal .form-grid3 {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px;
        width: 100%;
        margin-bottom: 4px;
    }

    #positionRequestModal .form-grid3 .field {
        min-width: 0;
    }


    /* =========================================================
       SALARY ROW
       Average Salary / Total Salary
       ========================================================= */

    #positionRequestModal .salary-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
        width: 100%;
        margin-bottom: 4px;
    }

    #positionRequestModal .salary-row .field {
        min-width: 0;
    }


    /* =========================================================
       INPUTS / SELECTS
       ========================================================= */

    #positionRequestModal .form-grid3 input,
    #positionRequestModal .form-grid3 select {
        width: 100%;
        height: 52px;
        min-height: 52px;

        box-sizing: border-box;

        border: 1px solid #d9e0ea;
        border-radius: 6px;

        background: #ffffff;
        color: #172b4d;

        font-size: 14px;
        padding: 0 14px;

        outline: none;
        transition: border-color 0.15s ease,
                    box-shadow 0.15s ease;
    }

    #positionRequestModal .form-grid3 input:focus,
    #positionRequestModal .form-grid3 select:focus,
    #positionRequestModal #prReportsTo:focus {
        border-color: #3699ff;
        box-shadow: 0 0 0 3px rgba(54, 153, 255, 0.10);
    }


    /* =========================================================
       NUMBER INPUT
       ========================================================= */

    #positionRequestModal #prCount {
        text-align: left;
    }


    /* =========================================================
       DATE INPUT
       ========================================================= */

    #positionRequestModal #prTargetDate {
        cursor: pointer;
    }

    #positionRequestModal #targetDateMessage {
        display: block;
        margin-top: 5px;
        font-size: 11px;
        color: #6b7280;
    }


    /* =========================================================
       SALARY BOXES
       ========================================================= */

    #positionRequestModal .crit-box {
        display: flex;
        align-items: center;

        width: 100%;
        min-height: 52px;
        height: 52px;

        box-sizing: border-box;

        padding: 0 14px;

        background: #f8f9fa;
        border: 1px solid #d9e0ea;
        border-radius: 6px;

        color: #172b4d;
        font-size: 14px;
        font-weight: 600;

        box-shadow: none;
    }


    /* =========================================================
       REPORTS TO
       ========================================================= */

    #positionRequestModal #prReportsTo {
        width: 100%;
        height: 52px;
        min-height: 52px;

        box-sizing: border-box;

        padding: 0 14px;

        border: 1px solid #d9e0ea;
        border-radius: 6px;

        background: #ffffff;
        color: #172b4d;

        font-size: 14px;

        outline: none;

        transition: border-color 0.15s ease,
                    box-shadow 0.15s ease;
    }


    /* =========================================================
       JOB DESCRIPTION
       ========================================================= */

    #positionRequestModal .jdform-section-head {
        margin-bottom: 7px;
    }

    #positionRequestModal .jdform-section-head label {
        font-size: 13px;
        font-weight: 600;
        color: #374151;
    }

    #positionRequestModal .jdform-editor-shell {
        width: 100%;

        border: 1px solid #d9e0ea;
        border-radius: 8px;

        background: #ffffff;

        overflow: hidden;
    }

    #positionRequestModal #jdEditor {
        min-height: 220px;
        max-height: 420px;

        overflow-y: auto;

        padding: 16px;

        box-sizing: border-box;

        background: #f8f9fb;

        color: #374151;

        font-size: 14px;
        line-height: 1.6;
    }

    #positionRequestModal #jdEditor:focus {
        outline: none;
    }


    /* =========================================================
       JOB DESCRIPTION CONTENT
       ========================================================= */

    #positionRequestModal #jdEditor p {
        margin-top: 0;
        margin-bottom: 10px;
    }

    #positionRequestModal #jdEditor ul,
    #positionRequestModal #jdEditor ol {
        margin-top: 5px;
        margin-bottom: 12px;
        padding-left: 22px;
    }

    #positionRequestModal #jdEditor h1,
    #positionRequestModal #jdEditor h2,
    #positionRequestModal #jdEditor h3,
    #positionRequestModal #jdEditor h4 {
        margin-top: 0;
        margin-bottom: 10px;
        color: #172b4d;
    }


    /* =========================================================
       JOB DESCRIPTION EMPTY STATE
       ========================================================= */

    #positionRequestModal .jd-context {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px 10px;
        padding: 10px 16px;
        background: #ffffff;
        border-bottom: 1px solid #e5e7eb;
        font-size: 13px;
        color: #374151;
    }

    #positionRequestModal .jd-context:empty {
        display: none;
    }

    #positionRequestModal .jd-context .jd-ctx-item b {
        margin-right: 4px;
        font-weight: 600;
        color: #6b7280;
    }

    #positionRequestModal .jd-context .jd-ctx-sep {
        color: #c7cdd4;
    }

    /* No JD: let the box fit its content, no inner scrollbar */
    #positionRequestModal #jdEditor.jd-none {
        min-height: 0;
        max-height: none;
        overflow: visible;
        padding: 0;
    }

    #positionRequestModal .jd-empty {
        text-align: center;
        padding: 24px 16px;
        background: #ffffff;
    }

    #positionRequestModal .jd-empty-icon {
        font-size: 40px;
        line-height: 1;
        margin-bottom: 12px;
    }

    #positionRequestModal .jd-empty-title {
        font-size: 16px;
        font-weight: 600;
        color: #172b4d;
        margin-bottom: 6px;
    }

    #positionRequestModal .jd-empty-text {
        max-width: 420px;
        margin: 0 auto 16px;
        color: #6b7280;
    }

    #positionRequestModal a.jd-empty-btn {
        display: inline-block;
        background-color: var(--main-color-one);
        border: 1px solid var(--main-color-one);
        color: #fff !important;
        padding: 8px 20px;
        border-radius: 4px;
        font-weight: 500;
        text-decoration: none !important;
        cursor: pointer;
    }

    #positionRequestModal a.jd-empty-btn:hover {
        opacity: .9;
        color: #fff !important;
    }


    /* =========================================================
       JOB DESCRIPTION FOOTER
       ========================================================= */

    #positionRequestModal .jdform-editor-footer {
        padding: 7px 12px;

        border-top: 1px solid #e5e7eb;

        background: #ffffff;

        font-size: 12px;
        color: #7b8794;
    }


    /* =========================================================
       MODAL FOOTER
       ========================================================= */

    #positionRequestModal .modal-footer {
        flex-shrink: 0;

        padding: 14px 24px;

        background: #ffffff;

        border-top: 1px solid #e5e7eb;

        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }



  

   

   
</style>

