                    </div>

                    <div class="form-grid3" style="grid-template-columns: repeat(2, minmax(0, 1fr));">

                        <div class="field">
                            <span class="field-label">
                                Priority *
                            </span>

                            @Html.DropDownList("prPriority", (SelectList)ViewBag.Priority, "-- Select --", new { @class = "form-control", id = "prPriority" })
                        </div>

                        <div class="field">
                            <span class="field-label">
                                Target fill date
                            </span>

                            <input type="date"
                                   class="date-input"
                                   id="prTargetDate">

                            <small id="targetDateMessage" class="text-muted"></small>
                        </div>

                    </div>


