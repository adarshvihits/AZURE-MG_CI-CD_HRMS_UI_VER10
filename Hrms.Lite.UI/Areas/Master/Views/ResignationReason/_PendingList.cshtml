@model Hrms.Lite.Shared.Master.ResignationReason
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");
    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table resignationreason-master-pending pt-1">
    @Html.HiddenFor(m => m.ResigantionReasonList.Count)
    <table id="PendingResignationReasonTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Resignation Type</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.ResigantionReasonList != null && Model.ResigantionReasonList.Count > 0)
                {

                    for (int i = 0; i < Model.ResigantionReasonList.Count; i++)
                    {
                        <tr>

                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(m => m.ResigantionReasonList[i].MakerChecker)
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Name">@Model.ResigantionReasonList[i].Name</td>
                            <td data-label="ShortName">@Model.ResigantionReasonList[i].ShortName</td>
                            <td data-label="ShortName">@Model.ResigantionReasonList[i].ResignationType.Name</td>
                            <td data-label="Entry Type">@Model.ResigantionReasonList[i].Mode</td>
                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="resignationreasonapprove"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.ResigantionReasonList[i].GI', '@Model.ResigantionReasonList[i].LogGI','APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="resignationreasonapprove"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.ResigantionReasonList[i].GI', '@Model.ResigantionReasonList[i].LogGI', 'APPROVAL',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                            </td>

                        </tr>
                    }
                }

            }

        </tbody>
    </table>
</div>