
@model Hrms.Lite.Shared.Master.CheckupType

@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.PendingCount').html("@Model.PendingCount");

    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table medicalcheckup-pending pt-1">
    @Html.HiddenFor(m => m.CheckupTypeList.Count)
    <table id="CheckUpPendingTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>
            @{


                if (Model.CheckupTypeList != null && Model.CheckupTypeList.Count > 0)
                {
                    for (int i = 0; i < Model.CheckupTypeList.Count; i++)

                    {
                        <tr>
                            @Html.HiddenFor(m => m.CheckupTypeList[i].MakerChecker)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Code)
                            @Html.HiddenFor(model => Model.Mode)
                            <td data-label="Name">@Model.CheckupTypeList[i].Name</td>
                            <td data-label="Short Name">@Model.CheckupTypeList[i].ShortName</td>

                            <td data-label="Status">@Model.CheckupTypeList[i].Mode</td>
                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="approvemedicalcheckup" type="button"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.CheckupTypeList[i].GI', '@Model.CheckupTypeList[i].LogGI', 'APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                { 
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="approvemedicalcheckup" type="button"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.CheckupTypeList[i].GI', '@Model.CheckupTypeList[i].LogGI', 'APPROVAL',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                    <!-- Approve Slider -->
                                    <!-- Approve Slider end-->
                                </td>
                            <!-- <second></second> -->
                        </tr>
                    }
                }
            }

        </tbody>
    </table>
</div>