@model Hrms.Lite.Shared.Master.CheckupType
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
       $('.PendingCount').html("@Model.PendingCount");




    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table medicalcheckup-master-list pt-1">
    @Html.HiddenFor(m => m.CheckupTypeList.Count)
    <table id="CheckUpTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.CheckupTypeList != null && Model.CheckupTypeList.Count > 0)
                {
                    for (int i = 0; i < Model.CheckupTypeList.Count; i++)

                    {
                        <tr>
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(m => m.CheckupTypeList[i].EditActive)
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Name">@Model.CheckupTypeList[i].Name</td>
                            <td data-label="Short Name">@Model.CheckupTypeList[i].ShortName</td>
                            <td data-label="Actions">
                                @if (CurrentUserRoleActions.Modify == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="editmedicalcheckup" type="button"
                                       class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY','@Model.CheckupTypeList[i].GI','@Model.CheckupTypeList[i].LogGI',@i)">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="editmedicalcheckup" type="button"
                                       class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY', '@Model.CheckupTypeList[i].GI', '@Model.CheckupTypeList[i].LogGI',@i);
                                       swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#AddNewOrEditSlider');});">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>
                                }
                                <!-- Edit Slider start-->
                                <!-- Edit Slider  end-->
                                <!-- delete Slider  start-->
                                @if (CurrentUserRoleActions.Delete == true)
                                {

                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="deletemedicalcheckup" type="button"
                                       class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.CheckupTypeList[i].GI','@Model.CheckupTypeList[i].LogGI','DELETE',@i)">
                                        <i class="icon-xl far fa-trash-alt"></i>
                                    </a>
                                }
                                else
                                { 
                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="deletemedicalcheckup" type="button"
                                       class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.CheckupTypeList[i].GI', '@Model.CheckupTypeList[i].LogGI', 'DELETE',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-trash-alt"></i>
                                    </a>
                                }


                                    <!-- <end delete section></end> -->
                                </td>
                        </tr>
                    }
                }
            }

        </tbody>
    </table>
</div>
