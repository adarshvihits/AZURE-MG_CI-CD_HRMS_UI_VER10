@model Hrms.Lite.Shared.Master.AssessmentYear
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;

        $('.pendingTabCount').html("@Model.PendingCount");
        });
</script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table assessment-master-pending-list">
    @Html.HiddenFor(m => Model.AssessmentYearList.Count)
    <table class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Assessment Year</th>
                <th scope="col">From</th>
                <th scope="col">To</th>

                <th scope="col">Financial Year</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>
            @{ 
            if (Model.AssessmentYearList != null && Model.AssessmentYearList.Count > 0)
            {
            for (int i = 0; i < Model.AssessmentYearList.Count; i++)

            {

                        <tr>

                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Code)
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.ApproveMode)
                            @Html.HiddenFor(m => m.AssessmentYearList[i].MakerChecker)



                            <td data-label="Assessment Year">@Model.AssessmentYearList[i].Name</td>
                            <td data-label="From">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.AssessmentYearList[i].From))</td>
                            <td data-label="To">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.AssessmentYearList[i].To))</td>
                            <td data-label="financial Year">@Model.AssessmentYearList[i].FinancialYear.Name</td>
                            <td data-label="Status">@Model.AssessmentYearList[i].Mode</td>
                            <td data-label="Approve">


                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="vdaapprove" type="button"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.AssessmentYearList[i].GI', '@Model.AssessmentYearList[i].LogGI','APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="vdaapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.AssessmentYearList[i].GI', '@Model.AssessmentYearList[i].LogGI', 'APPROVAL',@i);
                                       swal.fire(MasterPersmissionMsg)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                <!-- Approve Slider -->
                                <!-- Approve Slider end-->
                            </td>
                            <!-- <second></second> -->
                        </tr>
            }
            }
            }
        </tbody>
    </table>
</div>
