@model Hrms.Lite.Shared.Master.AssessmentYear

@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>
    (Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/bootstrap-datepicker.js"></script>

<script>
    $(document).ready(function () {
        debugger;

    });


</script>

@using (Html.BeginForm("Save", "AssessmentYear", FormMethod.Post, new { id = "AssessmentYear_Save" }))
{
<div id="addvda" class="slider-forms slider-forms-open addNew">
    <div class="slider-inner-style">
        <div class="slider-form-close" onclick="CloseSlider('addNew')">
            <i class="ki ki-close icon-xs text-muted"></i>
        </div>
        <h4>
            Assessment Year
        </h4>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Assessment Year
                    @Html.HiddenFor(model => Model.Mode)
                    @Html.HiddenFor(model => Model.LogGI)
                    @Html.HiddenFor(model => Model.GI)

                    <span class="Mandatory">*</span>
                    </label>
                    @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm", @placeholder = "Assessment Year", @onblur = "validate(this,'assYear')" })
                    <span id="assYear" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label>
                        From
                        <span class="Mandatory">*</span>
                    </label>
                    <div class="input-group date">
                        @Html.TextBoxFor(Model => Model.From, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "From", @onchange = "validate(this,'FDate');validateFromToDate(this,'FDate')" })

                        <div class="input-group-append">
                            <span class="input-group-text">
                                <i class="la la-calendar"></i>
                            </span>
                        </div>

                    </div>
                    <span id="FDate" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="row my-3">
            <div class="col-md-6">
                <div class="form-group">
                    <label>
                        To
                        <span class="Mandatory">*</span>
                    </label>
                    <div class="input-group date">
                        @Html.TextBoxFor(Model => Model.To, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "To", @onchange = "validate(this,'TDate');validateFromToDate(this,'TDate')" })

                        <div class="input-group-append">
                            <span class="input-group-text">
                                <i class="la la-calendar"></i>
                            </span>
                        </div>

                    </div>
                    <span id="TDate" class="text-danger"></span>
                </div>
            </div>


            <div class="col-md-6">
                <div class="form-group">
                    <label>
                        Financial Year
                        <span class="Mandatory">*</span>
                    </label>
                    @Html.DropDownListFor(Model => Model.FinancialYear.Code, (SelectList)ViewBag.AssFinYear, "--Select--", new { @class = "form-control form-control-sm", @onblur = "validate(this,'Fin_yr')" })
                    <span id="Fin_yr"></span>
                </div>
            </div>

            @*<div class="col-md-6">
                <div class="form-group">
                    <label>Financial Year</label>
                    <div>


                        @Html.DropDownListFor(Model => Model.FinancialYear.Code, (SelectList)ViewBag.FinYear, "--Select--", new { @class = "form-control form-control-sm", @onblur = "validate(this,'ShiftType')" })


                    </div>
                </div>
            </div>*@
        </div>
        <div class="row my-3">

            <div class="col-md-12 d-flex align-items-center">
                <div>
                    Active
                </div> 



                  

                <label class="switch" @*onchange="ActiveInactiveValidationAssessment('ASSESSMENTYEAR', '@Model.Code')"*@>
                    @Html.HiddenFor(m => Model.Code)
                    @Html.CheckBoxFor(Model => Model.Active, new { @id = "AssYearActive" })
                    <span class="slider round"></span>
                </label>



            </div>

        </div>

        <div class="row card-footer-bottom-fixed border-none">

            <div class="col-md-12 align-right">
                @if (Model.Mode == "CREATE")
                {
                    @if (CurrentUserRoleActions.Create == true)
                    {
                        <a type="button"
                           class="btn btn-default  mobile-full-width" onclick="SaveAssessmentYear('Save')">
                            Save
                        </a>
                    }
                }
                @if (Model.Mode == "MODIFY")
                {
                    @if (CurrentUserRoleActions.Modify == true)
                    {
                        <button type="button" class="btn btn-default  mobile-full-width" onclick="SaveAssessmentYear('Modify')">
                            Modify
                        </button>
                    }
                }
            </div>

        </div>
    </div>



   




</div>
   
}