@model Hrms.Lite.Shared.Master.AssessmentYear

@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
@using (Html.BeginForm("Delete", "AssessmentYear", FormMethod.Post, new { @id = "delete_AssessmentYear" }))
{


    <div id="vdadelete" class="slider-forms slider-forms-open delete">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('delete')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>Assessment Year</h4>
            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Assessment Year</label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.Name)

                            @Html.HiddenFor(model => Model.GI)

                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Mode)
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            From
                        </label>
                        <div class="view-details">
                            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.From))
                        </div>
                    </div>
                </div>

            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">To</label>
                        <div class="view-details">
                            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.To))
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Financial Year
                        </label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.FinancialYear.Name)
                        </div>
                    </div>
                </div>

            </div>
            <div class="row ">

                <div class="col-md-12">
                    <label class="view-title">Active</label>
                    <div class="view-details">
                        @if (Model.Active == true)
                        {

                            <button type="button" class="btn btn-icon btn-tick">
                                <i class="icon-xl fas fa-check"></i>
                            </button>

                        }
                        else
                        {
                            <button type="button" class="btn btn-icon btn-close">
                                <i class="icon-xl fas fa-times"></i>

                            </button>
                        }
                    </div>
                </div>

            </div>



            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    @if (CurrentUserRoleActions.Delete == true)
                    {
                        <button type="button"
                                data-bs-toggle="tooltip" title=""
                                data-bs-original-title="Delete"
                                class="btn btn-icon btn-delete big-btn float-none"onclick="return confirmDelete('@Model.GI', '@Model.LogGI')">
                            <i class="icon-xl far fa-trash-alt"></i>
                        </button>
                    }
                    </div>


            </div>
        </div>
    </div>
}