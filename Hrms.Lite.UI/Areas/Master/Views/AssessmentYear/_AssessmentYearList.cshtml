@model Hrms.Lite.Shared.Master.AssessmentYear

@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>
    (Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<link href="~/css/custom.css" rel="stylesheet" />
<script src="~/js/settings.js"></script>

<script>
        $(document).ready(function () {
            debugger;

            $('.pendingTabCount').html("@Model.PendingCount");




        });
</script>



<div class="ihits-table table-border hover-color odd-even mobile-responsive-table assessment-master-list ">
    @Html.HiddenFor(Model => Model.AssessmentYearList.Count)
    <table class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Assessment Year</th>
                <th scope="col">From</th>
                <th scope="col">To</th>

                <th scope="col">Financial Year</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>

        @{
            if (Model.AssessmentYearList != null && Model.AssessmentYearList.Count > 0)
            {
                for (int i = 0; i < Model.AssessmentYearList.Count; i++)

                {

                    @*<tbody>*@

                    <tr>

                        <td data-label="Assessment Year">@Model.AssessmentYearList[i].Name</td>
                        <td data-label="From">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.AssessmentYearList[i].From))</td>
                        <td data-label="To">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.AssessmentYearList[i].To))</td>
                        <td data-label="financial Year">@Model.AssessmentYearList[i].FinancialYear.Name</td>


                        <td data-label="Actions">



                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Active)
                            @Html.HiddenFor(m => m.AssessmentYearList[i].EditActive)
                            @Html.HiddenFor(model => Model.GI)


                            @if (CurrentUserRoleActions.Modify == true)
                            {
                                <a data-bs-toggle="tooltip" title="Edit"
                                   id="vdaedit" type="button"
                                   class="btn btn-icon btn-edit icon-only " onclick="AddNewOrEditClick('MODIFY', '@Model.AssessmentYearList[i].GI', '@Model.AssessmentYearList[i].LogGI',@i)">
                                    <i class="icon-xl fas fa-pencil-alt"></i>
                                </a>
                            }


                            else
                            {
                                <a data-bs-toggle="tooltip" title="Edit"
                                   id="vdaedit"
                                   class="btn btn-icon btn-edit icon-only" onclick="AddNewOrEditClick('MODIFY', '@Model.AssessmentYearList[i].GI', '@Model.AssessmentYearList[i].LogGI',@i);
                                                swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#AddNewOrEditSlider');});">
                                    <i class="icon-xl fas fa-pencil-alt"></i>
                                </a>
                            }
                            <!-- Edit Slider start-->
                            <!-- Edit Slider  end-->
                            <!-- delete Slider  start-->


                            @if (CurrentUserRoleActions.Delete == true)
                            {
                                <a data-bs-toggle="tooltip" title="Delete"
                                   id="vdadelete" type="button"
                                   class="btn btn-icon  icon-only mobile-full-width slider-btn btn-delete" onclick="onDeleteClick('@Model.AssessmentYearList[i].GI', '@Model.AssessmentYearList[i].LogGI','DELETE',@i)">
                                    <i class="icon-xl far fa-trash-alt"></i>
                                </a>
                            }

                            else
                            {


                                <a data-bs-toggle="tooltip" title="Delete"
                                   id="vdadelete"
                                   class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.AssessmentYearList[i].GI', '@Model.AssessmentYearList[i].LogGI', 'DELETE',@i);
                                           swal.fire(MasterPersmissionMsg)">
                                    <i class="icon-xl far fa-trash-alt"></i>
                                </a>
                            }
                            <!-- <end delete section></end> -->
                        </td>
                    </tr>


                    @*</tbody>*@
                }
            }
        }
    </table>
</div>
