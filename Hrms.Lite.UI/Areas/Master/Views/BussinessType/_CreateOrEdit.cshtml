@model Hrms.Lite.Shared.Master.BussinessType
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');


         $('#Grades')
            .multiselect('selectAll', true);
    });

        


</script>
<script src="~/js/tooltip.js"></script>
@using (Html.BeginForm("Save", "BussinessType", FormMethod.Post, new { id = "BussinessTypesave" }))
{
    <div id="BussinessTypeedit" class="slider-forms slider-forms-open AddnewOrEditDiv">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddnewOrEditDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>BussinessType</h4>
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm DeptName", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'BussinessTypeName')", maxlength = "120" })
                            <span id="BussinessTypeName"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Short Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm DeptShtName", @placeholder = "Short Name", @onblur = "validate(this,'DeptShortName')", maxlength = "5" })


                        </div>
                        <span id="DeptShortName"></span>
                    </div>
                </div>

                                                                    <div class="col-md-5">


                                                        <div class="form-group">
                                                            <label>Grade</label>
                                                            @Html.ListBoxFor(Model => Model.Grades, (SelectList)ViewBag.Grd, new
                                                       {
                                                           @class = "multiselectDropdownFields form-control-multiselect form-control-sm",
                                                           @multiple = "multiple",

                                                           data_db_filter = "true",


                                                       })
                                                            @*@Html.ListBoxFor(m => m.Grades, (SelectList)ViewBag.Grd, new { @class = "multiselectDropdownField", @multiple = "multiple" })*@

                                                        </div>

                                                    </div>

                <div class="row">
                    <div class="col-md-12 mt-4">
                        <div class="d-flex align-items-center">
                            <div> Active</div>
                            <label class="switch" @*onchange="ActiveInactiveValidation('DPT','@Model.Code')"*@>
                                @Html.HiddenFor(m=>Model.Code)
                                @Html.CheckBoxFor(model => model.Active ,new {@id="Activeinactivedpt" })
                                <span class="slider round"></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="row my-3">
                    <div class="col-md-12">
                        <label>Description</label>
                        <div class="view-details">
                            @if (Model.Mode == "CREATE")
                            {

                                @Html.TextAreaFor(model => Model.Description, new { @class = "form-control form-control-sm DeptDiscription", @placeholder = "Description", maxlength = "250" })



                            }
                            @if (Model.Mode == "MODIFY")
                            {

                                @Html.HiddenFor(model => Model.Description)

                                @Html.DisplayFor(model => Model.Description)

                            }

                        </div>
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12 align-right">
                        @if (Model.Mode == "CREATE")
                        {
                            @if (CurrentUserRoleActions.Create == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="BussinessTypeSave('Save')">
                                    Save
                                </button>
                            }
                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            @if (CurrentUserRoleActions.Modify == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="BussinessTypeSave('Modify')">
                                    Modify
                                </button>
                            }
                        }
                        </div>
                </div>
            </div>
        </div>
    </div>
}