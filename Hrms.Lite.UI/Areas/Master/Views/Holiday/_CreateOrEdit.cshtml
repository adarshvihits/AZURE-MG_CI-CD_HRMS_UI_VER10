@model Hrms.Lite.Shared.DataBank.Generic.Master.Holiday
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}

<script src="~/js/bootstrap-datepicker.js"></script>
<link href="~/css/custom.css" rel="stylesheet" />
<script src="~/js/multiselect.js"></script>
<script src="~/js/custom.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Year_Code');
    });


</script>
<style>
    .dropdown-toggle {
        border: none !important;
    }
</style>
@using (Html.BeginForm("", "", FormMethod.Post, new { id = "hollidaySave" }))
{
    <div id="addholiday" class="slider-forms slider-forms-open AddNewDiv">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddNewDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>
                Holiday
            </h4>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">

                        <label>
                            Year
                            <span class="Mandatory">*</span>
                        </label>
                        @Html.HiddenFor(model => Model.Mode)
                        @Html.HiddenFor(model => Model.LogGI)
                        @Html.HiddenFor(model => Model.GI)
                        @Html.DropDownListFor(Model => Model.Year.Code, (SelectList)ViewBag.HolidayYear, "--Select--", new { @class = "form-control form-control-sm HYear", @onblur = "validate(this,'year')" })
                        <span id="year"></span>
                        @*<select class="form-control form-control-sm">
                                <option>Demo1 </option>
                                <option>Demo2 </option>
                                <option>Demo3 </option>

                            </select>*@

                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">

                        <label>
                            Type
                            <span class="Mandatory">*</span>
                        </label>
                        @Html.DropDownListFor(Model => Model.HolidayType.Code, (SelectList)ViewBag.HolidayType, "--Select--", new { @class = "form-control form-control-sm HType", @onblur = "validate(this,'HType')" })
                        <span id="HType"></span>
                        @*<select class="form-control form-control-sm">
                                <option>Demo1 </option>
                                <option>Demo2 </option>
                                <option>Demo3 </option>

                            </select>*@

                    </div>
                </div>
            </div>
            <div class="row ">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Date
                            <span class="Mandatory">*</span>
                        </label>
                        <div class="input-group date">
                            @Html.TextBoxFor(Model => Model.HolidayDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2 holidaydate", @readonly = "true", @placeholder = "Date", @onchange = "validate(this,'HDate')" })

                            <div class="input-group-append">
                                <span class="input-group-text">
                                    <i class="la la-calendar"></i>
                                </span>
                                @*<span id="epFrom"></span>*@

                            </div>

                        </div>

                    </div>
                    <span id="HDate"></span>
                </div>


                <div class="col-md-6">
                    <div class="form-group">

                        <label>
                            Holiday Session
                            <span class="Mandatory">*</span>
                        </label>
                        @Html.DropDownListFor(Model => Model.HolidaySession.Code, (SelectList)ViewBag.HolidaySession, "--Select--", new { @class = "form-control form-control-sm HSession", @onblur = "validate(this,'HSession')" })
                        <span id="HSession"></span>
                        @*<select class="form-control form-control-sm">
                                <option>First Half</option>
                                <option>Second Half</option>
                                <option>Full Day</option>

                            </select>*@

                    </div>
                </div>


            </div>



            <div class="row ">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Holiday Group
                            <span class="Mandatory">*</span>
                        </label>
                        <div class="form-control  form-control-sm  HolidayGrp">

                            @Html.ListBoxFor(Model => Model.HolidayGroups, (SelectList)ViewBag.Holidaygroup, new { @class = "multiselectDropdownField form-control-multiselect HGroup", @multiple = "multiple", data_placeholder = "--Select--", @onchange = "validateHolidayGrp(this,'HGroup','HolidayGrp')" })
                        </div>


                        @*@Html.DropDownListFor(Model => Model.HolidayGroup.Code, (SelectList)ViewBag.Holidaygroup, "--Select--", new { @class = "form-control form-control-sm HGroup", @onblur = "validate(this,'HGroup')" })*@

                        @*<input type="text"
                            class="form-control form-control-sm"
                            placeholder="Description">*@
                    </div>
                    <span id="HGroup"></span>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Holiday Description
                            <span class="Mandatory">*</span>
                        </label>
                        @Html.TextBoxFor(Model => Model.HolidayDescription, new { @class = "form-control form-control-sm HDescription", @placeholder = "Holiday Description", @onblur = "validate(this,'HDescription')", maxlength = "120" })
                        <span id="HDescription"></span>
                        @*<input type="text"
                            class="form-control form-control-sm"
                            placeholder="Description">*@
                    </div>
                </div>



            </div>
            @*<div class="row ">
                <div class="col-md-6">
                    <div class="form-group">
                        <div class="col-md-6 d-flex align-items-center">
                            <label class="switch">
                                Active
                                @Html.CheckBoxFor(model => model.Active)
                                <span class="slider round"></span>
                            </label>
                        </div>
                        </div>
                    </div>
                </div>*@


        <div class="row my-3">

        
                <div class="col-md-7 d-flex align-items-center">

                    <div class="d-flex align-items-center">

                        <div>Holiday Allowance Applicable</div>

                        <div class="checkbox-inline" style="margin-left:10px;">
                            <label class="checkbox checkbox-outline checkbox-success">
                                @Html.CheckBoxFor(m => m.HolidayAllowance)

                                <span></span>
                            </label>
                        </div>
                    </div>
                
                </div>
                <div class="col-md-5">
                    <div class="d-flex align-items-center">
                        <div> Active</div>
                        <label class="switch" onchange="ActiveInactiveValidationHoliday('')">
                            @Html.CheckBoxFor(model => model.Active, new { @id = "activeinactiveholiday" })
                            <span class="slider round"></span>
                        </label>
                    </div>
                </div>



        </div>


            <div class="row my-3">

                <div class="col-md-12">
                    @if (Model.Mode == "CREATE")
                    {
                        <label>Description</label>
                        @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm HolidaytDescription", @placeholder = "Description", maxlength = "250" })

                    }
                    @if (Model.Mode == "MODIFY")
                    {
                        <label class="view-title">Description</label>
                        <div class="view-details">

                            @Html.DisplayFor(Model => Model.Description)
                            @Html.HiddenFor(model => Model.Description)
                        </div>
                    }
                </div>
            </div>

            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    @if (Model.Mode == "CREATE")
                    {

                        @if (CurrentUserRoleActions.Create == true)
                        {
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="SaveHoliday('Save')">
                                Save
                            </button>
                        }
                    }
                    @if (Model.Mode == "MODIFY")
                    {
                        @if (CurrentUserRoleActions.Modify == true)
                        {
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="SaveHoliday('Modify')">
                                Modify
                            </button>
                        }
                    }
                    </div>

            </div>
        </div>
    </div>
}
