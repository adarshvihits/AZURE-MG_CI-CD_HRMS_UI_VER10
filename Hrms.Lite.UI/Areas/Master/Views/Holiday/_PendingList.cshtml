@model Hrms.Lite.Shared.DataBank.Generic.Master.Holiday
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}

<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InActiveCount");
        $('.PendingTabCount').html("@Model.PendingCount");

        //$('#HolidayPendingTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');


    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table holiday-master-pending">
    @Html.HiddenFor(m => m.HolidayList.Count)
    <table id="HolidayPendingTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Holiday Description</th>
                <th scope="col">Type </th>
                <th scope="col">Date </th>
                <th scope="col">Holiday Group</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>


            @{


                if (Model.HolidayList != null && Model.HolidayList.Count > 0)
                {
                    for (int i = 0; i < Model.HolidayList.Count; i++)

                    {

                        <tr>
                            @Html.HiddenFor(m => m.HolidayList[i].MakerChecker)
                            @Html.HiddenFor(model => Model.HolidayDate)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Mode)
                            <td data-label="HolidayDiscription">@Model.HolidayList[i].HolidayDescription</td>
                            <td data-label="Type">@Model.HolidayList[i].HolidayType.Name</td>
                            <td data-label="Date">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.HolidayList[i].HolidayDate))</td>
                            <td data-label="HolidayGroup">@Model.HolidayList[i].HolidayGroup.Name</td>
                            <td data-label="Status">@Model.HolidayList[i].Mode</td>
                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="approveholiday"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.HolidayList[i].GI', '@Model.HolidayList[i].LogGI','APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="approveholiday"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.HolidayList[i].GI', '@Model.HolidayList[i].LogGI', 'APPROVAL',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }

                            </td>

                        </tr>
                    }
                }

            }


        </tbody>
    </table>
</div>