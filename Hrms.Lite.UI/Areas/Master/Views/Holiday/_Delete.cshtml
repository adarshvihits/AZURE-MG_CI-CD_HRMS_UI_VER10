@model Hrms.Lite.Shared.DataBank.Generic.Master.Holiday
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}

<script src="~/js/tooltip.js"></script>
@using (Html.BeginForm("Delete", "Holiday", FormMethod.Post, new { @id = "DeleteHoliday" }))
{
    <div id="holidaydelete" class="slider-forms slider-forms-open Delete">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('Delete')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>Holiday</h4>
            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Year  </label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.Year.Name)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Mode)
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Type
                        </label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.HolidayType.Name)
                        </div>
                    </div>
                </div>

            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Date</label>
                        <div class="view-details">
                            @*@Html.DisplayFor(model => Model.HolidayDate)*@
                            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.HolidayDate))
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Holiday Session
                        </label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.HolidaySession.Name)
                        </div>
                    </div>
                </div>

            </div>
            <div class="row ">

                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Holiday Group
                        </label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.HolidayGroup.Name)
                        </div>
                    </div>
                </div>


                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Holiday Description
                        </label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.HolidayDescription)
                        </div>
                    </div>
                </div>
            </div>
            <div class="row ">
                <div class="col-md-6">
                    <label class="view-title">Holiday Allowance Applicable</label>
                    <div class="checkbox-inline">
                        <label class="checkbox checkbox-outline checkbox-success mt-2">
                            @Html.DisplayFor(m => m.HolidayAllowance)
                            <span></span>
                        </label>
                        <label class="checkbox checkbox-outline checkbox-success"></label>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="view-title">Active</label>
                    <div class="view-details">
                        @if (Model.Active == true)
                        {
                            <button type="button" class="btn btn-icon btn-tick">
                                <i class="icon-xl fas fa-check"></i>
                            </button>

                        }
                        else
                        {
                            <button type="button" class="btn btn-icon btn-close">
                                <i class="icon-xl fas fa-times"></i>

                            </button>
                        }
                    </div>
                </div>

                </div>

                <div class="row my-3">

                    <div class="col-md-12">
                        <label class="view-title">Description</label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.Description)
                        </div>
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">

                        @if (CurrentUserRoleActions.Delete == true)
                        {
                            <a type="button"
                               data-bs-toggle="tooltip" title=""
                               data-bs-original-title="Delete"
                               class="btn btn-icon btn-delete big-btn float-none" onclick="return ConfirmDelete('@Model.GI', '@Model.LogGI')">
                                <i class="icon-xl far fa-trash-alt"></i>
                            </a>
                        }
                    </div>


                </div>
            </div>
    </div>
}