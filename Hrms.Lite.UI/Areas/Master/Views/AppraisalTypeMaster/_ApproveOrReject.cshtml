@model Hrms.Lite.Shared.Master.AppraisalTypeMaster
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "appraisalApproveOrReject" }))
{
    <div id="appraisaltypeapprove" class="slider-forms slider-forms-open appraisalTypeMasterApprove">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('appraisalTypeMasterApprove')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>Appraisal Type</h4>
            @Html.HiddenFor(m => m.GI)
            @Html.HiddenFor(m => m.LogGI)
            @Html.HiddenFor(m => m.Mode)
            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Name</label>
                        <div class="view-details">
                            @Model.Name
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Short
                            Name
                        </label>
                        <div class="view-details">
                            @Model.ShortName
                        </div>
                    </div>
                </div>

            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Assessment Mode</label>
                        <div class="view-details">
                            @Model.AssesmentMode.Name
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Active</label>
                        <div class="view-details">
                            @if (Model.Active)
                            {

                                <button type="button"
                                        class="btn btn-icon btn-tick">
                                    <i class="icon-xl fas fa-check"></i>
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-icon btn-close">
                                    <i class="icon-xl fas fa-times"></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="row my-3">

                <div class="col-md-12">
                    <label class="view-title">Description</label>
                    <div class="view-details">
                        @Model.Description
                    </div>
                </div>
            </div>

            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    @if (CurrentUserRoleActions.Approve == true)
                    {
                        <button type="button"
                                class="btn btn-danger  mobile-full-width" onclick="confirmReject('@Model.GI', '@Model.LogGI')">
                            Reject
                        </button>
                        <button type="button"
                                class="btn btn-default  mobile-full-width" onclick="confirmApprove('@Model.GI', '@Model.LogGI')">
                            Approve
                        </button>
                    }
                    </div>


            </div>
        </div>
    </div>
}