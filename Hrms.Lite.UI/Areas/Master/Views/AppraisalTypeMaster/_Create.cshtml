@model Hrms.Lite.Shared.Master.AppraisalTypeMaster
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });


</script>
@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "appraisal-save-slider" }))
{
    <div id="appraisaltypeadd" class="slider-forms slider-forms-open appraisalCreate">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('appraisalCreate')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>
                Appraisal Type
            </h4>
            @Html.HiddenFor(m => m.Mode)
            @Html.HiddenFor(m => m.GI)
            @Html.HiddenFor(m => m.LogGI)
            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Name</label>
                        <span class="Mandatory">*</span>
                        @*<input type="text"
                            class="form-control form-control-sm"
                            placeholder="Name">*@
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control form-control-sm", @placeholder = "Name", maxlength = "120", onblur = "firstLetterCaps(this,'AName')" })
                    </div>
                    <span id="AName"></span>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Short Name</label>
                        <span class="Mandatory">*</span>
                        @*<input type="text"
                            class="form-control form-control-sm"
                            placeholder="Short Name">*@
                        @Html.TextBoxFor(m => m.ShortName, new { @class = "form-control form-control-sm", @placeholder = "Short Name", maxlength = "5", onblur = "validate(this,'AShortName')" })
                    </div>
                    <span id="AShortName"></span>
                </div>
            </div>



            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Assessment Mode</label>
                        <span class="Mandatory">*</span>
                        @*<select class="form-control form-control-sm " id="exampleSelects">
                                <option>Rating</option>
                                <option>Score</option>
                            </select>*@
                        @Html.DropDownListFor(m => m.AssesmentMode.Code, (SelectList)ViewBag.AppraisalTypeAssesmentMode, "--Select--", new { @class = "form-control form-control-sm", onblur = "validate(this,'AMode')" })
                    </div>
                    <span id="AMode">
                    </span>
                </div>
                <div class="col-md-6 mt-2 mt-5 ">
                    <div class="d-flex align-items-center">
                        <div>Active</div>
                        <label class="switch" onclick="ActiveInactiveValidationAppType('Appraisal Type',@Model.Code)">
                            @*<input type="checkbox" checked="">*@
                            @Html.CheckBoxFor(m => m.Active,new { @id="type"})
                            <span class="slider round"></span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="row my-3">
                @if (Model.Mode != "MODIFY")
                {
                    <div class="col-md-12">
                        <label>Description</label>
                        @*<textarea class="form-control form-control-sm"
                            placeholder="Description"></textarea>*@
                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control form-control-sm", @placeholder = "Description", maxlength = "250" })
                    </div>
                }
                else
                {
                    <div class="col-md-12">
                        <label class="view-title">Description</label>
                        <div class="view-details">
                            @Html.HiddenFor(m => m.Description)
                            @Model.Description
                        </div>
                    </div>
                }

            </div>

            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    @if (Model.Mode != "MODIFY")
                    {

                        @if (CurrentUserRoleActions.Create == true)
                        {
                            <button type="button"
                                    class="btn btn-default  mobile-full-width" onclick="appraisalSave('Save')">
                                Save
                            </button>
                        }
                    }
                    else
                    {
                        @if (CurrentUserRoleActions.Modify == true)
                        {
                            <button type="button"
                                    class="btn btn-default  mobile-full-width" onclick="appraisalSave('Modify')">
                                Modify
                            </button>
                        }
                    }
                    </div>

            </div>
        </div>
    </div>
}