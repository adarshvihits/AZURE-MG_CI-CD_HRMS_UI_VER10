@model Hrms.Lite.Shared.Master.AppraisalTypeMaster
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<link href="~/css/custom.css" rel="stylesheet" />
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");



        //$('#appraisalTypePendingTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');

        });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table appraisaltype-pending pt-1">
    @Html.HiddenFor(m => m.AppraisalTypeMasterList.Count)
    <table id="appraisalTypePendingTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.AppraisalTypeMasterList != null && Model.AppraisalTypeMasterList.Count > 0)
            {

                for (int i = 0; i < Model.AppraisalTypeMasterList.Count; i++)
                {
                    <tr>
                        @Html.HiddenFor(m => m.AppraisalTypeMasterList[i].MakerChecker)
                        @Html.HiddenFor(m => m.AppraisalTypeMasterList[i].GI)
                        @Html.HiddenFor(m => m.AppraisalTypeMasterList[i].LogGI)
                        <td data-label="Name">@Model.AppraisalTypeMasterList[i].Name</td>
                        <td data-label="Short Name">@Model.AppraisalTypeMasterList[i].ShortName</td>

                        <td data-label="Status">@Model.AppraisalTypeMasterList[i].EntryType</td>
                        <td data-label="Approve">
                            @if (CurrentUserRoleActions.Approve == true)
                            {
                                <a data-bs-toggle="tooltip" title="Approve"
                                   id="appraisaltypeapprove"
                                   class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.AppraisalTypeMasterList[i].GI','@Model.AppraisalTypeMasterList[i].LogGI','@Model.AppraisalTypeMasterList[i].EntryType',@i)">
                                    <i class="icon-xl far fa-check-circle"></i>
                                </a>
                            }
                            else
                            { 
                                <a data-bs-toggle="tooltip" title="Approve"
                                   id="appraisaltypeapprove"
                                   class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.AppraisalTypeMasterList[i].GI', '@Model.AppraisalTypeMasterList[i].LogGI', '@Model.AppraisalTypeMasterList[i].EntryType',@i);
                                   swal.fire(MasterPersmissionMsg);">
                                    <i class="icon-xl far fa-check-circle"></i>
                                </a>
                            }
                                <!-- Approve Slider -->
                                <!-- Approve Slider end-->
                            </td>
                        <!-- <second></second> -->
                    </tr>
                }
            }
        </tbody>
    </table>
    <div id="approveAppraisalMaster">

    </div>
</div>