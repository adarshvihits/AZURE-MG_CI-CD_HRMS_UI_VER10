@model Hrms.Lite.Shared.Master.AppraisalTypeMaster
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<link href="~/css/custom.css" rel="stylesheet" />
<script src="~/js/settings.js"></script>

<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");



        //$('#appraisaltypetable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');

        });
</script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table appraisal-type pt-1">
    @Html.HiddenFor(m => m.AppraisalTypeMasterList.Count)
    <table id="appraisaltypetable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.AppraisalTypeMasterList != null && Model.AppraisalTypeMasterList.Count > 0)
            {

                for (int i = 0; i < Model.AppraisalTypeMasterList.Count; i++)
                {
                    <tr>
                        @Html.HiddenFor(m => m.AppraisalTypeMasterList[i].EditActive)
                        @Html.HiddenFor(m => m.AppraisalTypeMasterList[i].GI)
                        <td data-label="Name">@Model.AppraisalTypeMasterList[i].Name</td>
                        <td data-label="Short Name">@Model.AppraisalTypeMasterList[i].ShortName</td>
                        <td data-label="Actions">
                            <div>
                                @if (CurrentUserRoleActions.Modify == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="appraisaltypeedit"
                                       class="btn btn-icon btn-edit icon-only" onclick="onAddNewOrEditClick('MODIFY','@Model.AppraisalTypeMasterList[i].GI', '@Model.AppraisalTypeMasterList[i].LogGI',@i)">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="appraisaltypeedit"
                                       class="btn btn-icon btn-edit icon-only" onclick="onAddNewOrEditClick('MODIFY', '@Model.AppraisalTypeMasterList[i].GI', '@Model.AppraisalTypeMasterList[i].LogGI',@i);
                                       swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#appraisalTypeCreate');});">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>
                                }
                                <!-- Edit Slider start-->
                                <!-- Edit Slider  end-->
                                <!-- delete Slider  start-->
                                @if (CurrentUserRoleActions.Delete == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="appraisaltypedelete"
                                       class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.AppraisalTypeMasterList[i].GI', '@Model.AppraisalTypeMasterList[i].LogGI','DELETE',@i)">
                                        <i class="icon-xl far fa-trash-alt"></i>
                                    </a>
                                }
                                else
                                { 
                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="appraisaltypedelete"
                                       class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.AppraisalTypeMasterList[i].GI', '@Model.AppraisalTypeMasterList[i].LogGI', 'DELETE',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-trash-alt"></i>
                                    </a>
                                }
                                </div>

                            <!-- <end delete section></end> -->
                        </td>
                    </tr>
                }
            }

        </tbody>
    </table>
</div>