@model Hrms.Lite.Shared.Master.NightAllowanceAmountSettings
@{
    ViewData["Title"] = "View";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>

<script src="~/scripts/Master/nightAllowanceAmountSettings.js"></script>
<div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->

            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Night Allowance Amount Settings</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index","Home",new { Area=""})"><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            Night Allowance Amount Settings
                        </li>
                    </ul>
                </div>
            </div>
            <!--begin::Topbar-->
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->

                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body">
                        <!--begin: Search Form-->

                        <div class="row tab-style-button">
                            <div class="tab-button-wrap align-items-center">
                                <div class="tab-items">
                                    <label class="font-weight-bold">Department</label>
                                    <div class="form-group filter-combobox mt-0">
                                        @Html.DropDownListFor(m => m.Department.Code, (SelectList)ViewBag.Department, "--Select Type--", new { @class = "form-control form-control-sm", @onchange = "OnTypeChange(this,'Type')" })
                                    </div>
                                    <span id="department" style="bottom: -20px;"></span>
                                </div>


                                <div class="tab-items ml-5 pr-0 border-none  ">
                                    <div class="form-group filter-combobox mr-2" style="width: 200px;">

                                        <label>Purpose </label>

                                        @Html.DropDownListFor(m => m.Purpose.Code, (SelectList)ViewBag.Purpose, "--Select--", new { @class = "form-control form-control-sm", @onchange = "PurposeChangeHandler()" })
                                        <span id="pms_Appraisal"></span>
                                    </div>

                                </div>
                                <div class="tab-items ml-5 pr-0 border-none ">
                                    <div class="form-group filter-combobox mr-10" style="width: 280px;">

                                        <label>Designation</label>
                                        @Html.DropDownListFor(m => m.Grade.Code, (SelectList)ViewBag.Grade, "--All--", new { @class = "form-control form-control-sm", @onchange = "fillData()" })
                                        <span id="pms_Authority"></span>
                                    </div>

                                </div>





                                <div class="tab-items select-option mb-2">


                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="Time">
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div id="NAASList">
                            @await Html.PartialAsync("_List")
                        </div>
                        <div class="row card-footer-bottom-fixed">

                            <div class="col-md-12 align-right">
                                <button id="addbankname" type="button"
                                        class="btn btn-default float-right mobile-full-width" onclick="AddNewOrEditClick('CREATE')">
                                    Add
                                    New
                                </button>
                            </div>

                        </div>

                        <div id="newRequestSlider">

                        </div>
                        <div id="DeleteSlider">


                        </div>
                        <div id="ApproveSlider">


                        </div>
                        
                        <div id="AddNewOrEditSlider">


                        </div>
                        <!--end: Datatable-->

                    </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>
    <!--end::Content-->

</div>
