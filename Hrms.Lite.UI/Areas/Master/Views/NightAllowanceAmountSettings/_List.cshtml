@model Hrms.Lite.Shared.Master.NightAllowanceAmountSettings
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;

<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Night-Allowance-Amount-Settings pt-1">
    @Html.HiddenFor(m => m.NightAllowanceAmountSettingsList.Count)
    <table id="NightAllowanceAmounttable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Time From</th>
                <th scope="col">Time To</th>
                <th scope="col">Amount</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>


            @{
                if (Model.NightAllowanceAmountSettingsList != null && Model.NightAllowanceAmountSettingsList.Count > 0)
                {
                    for (int i = 0; i < Model.NightAllowanceAmountSettingsList.Count; i++)

                    {


                        <tr>

                            @Html.HiddenFor(model => Model.Code)

                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Time From">@Model.NightAllowanceAmountSettingsList[i].TimeFrom</td>
                            <td data-label="Name">@Model.NightAllowanceAmountSettingsList[i].TimeTo</td>
                            <td data-label="Name">@Model.NightAllowanceAmountSettingsList[i].Amount</td>
                            <td data-label="Actions">
                                <div>

                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="departmentedit"
                                       class="btn btn-icon btn-edit icon-only" onclick="AddNewOrEditClick( '@Model.NightAllowanceAmountSettingsList[i].Code','MODIFY')">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>


                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="deletedepartment"
                                       class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.NightAllowanceAmountSettingsList[i].Code','DELETE')">
                                        <i class="icon-xl far fa-trash-alt"></i>
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                }
            }


        </tbody>
    </table>
</div>