@model Hrms.Lite.Shared.Master.NightAllowanceAmountSettings
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;

<script src="~/js/tooltip.js"></script>

@using (Html.BeginForm("Delete", "NAAS", FormMethod.Post, new { @id = "DeleteNAAS" }))
{
    <div id="deletedepartment" class="slider-forms slider-forms-open delete">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('delete')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>Night Allowance Amount Settings</h4>
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Department
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.Department.Name)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Purpose
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.Purpose.Name)
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Designation
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.Grade.Name)
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Time From</label>
                            <div class="view-details">

                                @Html.HiddenFor(model => Model.GI)
                                @Html.HiddenFor(model => Model.Code)
                                @Html.DisplayFor(model => Model.TimeFrom)

                                @Html.HiddenFor(model => Model.Mode)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Time To
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.TimeTo)
                            </div>
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Amount
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.Amount)
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row my-3">


                </div>

                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">

                        <a type="button"
                           data-bs-toggle="tooltip" title="Delete"
                           data-bs-original-title="Delete"
                           class="btn btn-icon btn-delete big-btn float-none" onclick="return confirmDelete('@Model.Code')">
                            <i class="icon-xl far fa-trash-alt"></i>
                        </a>

                    </div>
                </div>
            </div>
        </div>
    </div>
}