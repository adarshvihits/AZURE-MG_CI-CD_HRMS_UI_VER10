@model Hrms.Lite.Shared.Master.NightAllowanceAmountSettings
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;


<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });


</script>
<script src="~/js/tooltip.js"></script>
@using (Html.BeginForm("Save", "NightAllowanceAmountSettings", FormMethod.Post, new { id = "NightAllowanceAmountSettingsSave" }))
{
    <div id="departmentedit" class="slider-forms slider-forms-open AddnewOrEditDiv">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddnewOrEditDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>Night Allowance Amount Settings</h4>
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Department
                                <span class="Mandatory">*</span>
                            </label>


                            @Html.DropDownListFor(Model => Model.Department.Code, (SelectList)ViewBag.Department, "--Select Type--", new { @class = "form-control form-control-sm", @onchange = "OnTypeChangeS1(this,'Type')", id = "Department_Code_S1" })
                            <span id="DepartmentName"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Purpose
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.DropDownListFor(Model => Model.Purpose.Code, (SelectList)ViewBag.Purpose, "--Select--", new { @class = "form-control form-control-sm", id = "Purpose_Code_S1" })


                        </div>
                        <span id="PurposeName"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Designation
                                <span class="Mandatory">*</span>
                            </label>


                            @Html.DropDownListFor(Model => Model.Grade.Code, (SelectList)ViewBag.Grade, "--All--", new { @class = "form-control form-control-sm", id = "Grid_Code_S1" })
                            <span id="Grade"></span>
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Time From
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.Code)
                            @Html.TextBoxFor(Model => Model.TimeFrom, new { @class = "form-control form-control-sm DeptName", @placeholder = "Time From" })
                            <span id="TimeFrom"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Time To
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.TextBoxFor(Model => Model.TimeTo, new { @class = "form-control form-control-sm DeptShtName", @placeholder = "Time To" })


                        </div>
                        <span id="TimeTo"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Amount
                                <span class="Mandatory">*</span>
                            </label>
                           

                            @Html.TextBoxFor(Model => Model.Amount, new { @class = "form-control form-control-sm DeptName", @placeholder = "Amount" })
                            <span id="Amount"></span>
                        </div>
                    </div>
                 
                </div>




                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12 align-right">
                        @if (Model.Mode == "CREATE")
                        {

                            <button type="button" class="btn btn-default  mobile-full-width" onclick="NAASSave('Save')">
                                Save
                            </button>

                        }
                        @if (Model.Mode == "MODIFY")
                        {

                            <button type="button" class="btn btn-default  mobile-full-width" onclick="NAASSave('Modify')">
                                Modify
                            </button>

                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}





