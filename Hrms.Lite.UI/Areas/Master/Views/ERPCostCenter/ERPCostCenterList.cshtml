@model Hrms.Lite.Shared.DataBank.Generic.Master.ERPCostCenter
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");

        //$('#ERPCostCenterTable').DataTable({
        //    "pageLength": 25
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');


    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table ERPCostCenter-list pt-1">
    @Html.HiddenFor(m => m.ERPCostCenterList.Count)
    <table id="ERPCostCenterTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.ERPCostCenterList != null && Model.ERPCostCenterList.Count > 0)
                {
                    for (int i = 0; i < Model.ERPCostCenterList.Count; i++)

                    {


                        <tr>

                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(m => m.ERPCostCenterList[i].EditActive)
                            @Html.HiddenFor(model => Model.Active)
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Name">@Model.ERPCostCenterList[i].Name</td>
                            <td data-label="Short Name">@Model.ERPCostCenterList[i].ShortName</td>

                            <td data-label="Actions">
                                <div>
                                    @if (CurrentUserRoleActions.Modify == true)
                                    {

                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="ERPCostCenteredit"
                                           class="btn btn-icon btn-edit icon-only" onclick="onAddOrEditClick('MODIFY','@Model.ERPCostCenterList[i].LogGI','@Model.ERPCostCenterList[i].GI',@i)">

                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="ERPCostCenteredit"
                                           class="btn btn-icon btn-edit icon-only" onclick="onAddOrEditClick('MODIFY', '@Model.ERPCostCenterList[i].LogGI', '@Model.ERPCostCenterList[i].GI',@i);
                                           swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#AddNewOrEditERPCostCenterSlider');});">

                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    @if (CurrentUserRoleActions.Delete == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deleteERPCostCenter"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.ERPCostCenterList[i].LogGI','@Model.ERPCostCenterList[i].GI','DELETE',@i)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deleteERPCostCenter"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.ERPCostCenterList[i].LogGI', '@Model.ERPCostCenterList[i].GI', 'DELETE',@i);
                                           swal.fire(MasterPersmissionMsg)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            }


        </tbody>
    </table>
</div>