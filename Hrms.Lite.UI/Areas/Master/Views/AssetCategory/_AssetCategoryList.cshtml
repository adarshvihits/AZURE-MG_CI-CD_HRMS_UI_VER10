@model Hrms.Lite.Shared.Master.AssetCategory
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/settings.js"></script>
<script src="~/js/tooltip.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");

        });
</script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table assetcategory-master-list pt-1">
    @Html.HiddenFor(m => m.AssetCategoryList.Count)
    <table id="AssetCategoryTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.AssetCategoryList != null && Model.AssetCategoryList.Count > 0)
                {
                    for (int i = 0; i < Model.AssetCategoryList.Count; i++)

                    {
                        <tr>
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(m => m.AssetCategoryList[i].EditActive)
                            <td data-label="Name">
                                @Model.AssetCategoryList[i].Name

                            </td>
                            <td data-label="Short Name"> @Model.AssetCategoryList[i].ShortName</td>
                            <td data-label="Actions">

                                <div>
                                    @if (CurrentUserRoleActions.Modify == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="editassetcategory"
                                           class="btn btn-icon btn-edit icon-only">
                                            <i class="icon-xl fas fa-pencil-alt" onclick="AddNewOrEditClick('MODIFY', '@Model.AssetCategoryList[i].GI', '@Model.AssetCategoryList[i].LogGI',@i)"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="editassetcategory"
                                           class="btn btn-icon btn-edit icon-only">
                                            <i class="icon-xl fas fa-pencil-alt" onclick="AddNewOrEditClick('MODIFY', '@Model.AssetCategoryList[i].GI', '@Model.AssetCategoryList[i].LogGI',@i);
                                            swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#AddNewOrEditSlider');});"></i>
                                        </a>
                                    }
                                    @if (CurrentUserRoleActions.Delete == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deleteassetcategory"
                                           class="btn btn-icon  icon-only mobile-full-width btn-delete">
                                            <i class="icon-xl far fa-trash-alt" onclick="onDeleteClick('@Model.AssetCategoryList[i].GI','@Model.AssetCategoryList[i].LogGI','DELETE',@i)"></i>
                                        </a>
                                    }
                                    else
                                    { 
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deleteassetcategory"
                                           class="btn btn-icon  icon-only mobile-full-width btn-delete">
                                            <i class="icon-xl far fa-trash-alt" onclick="onDeleteClick('@Model.AssetCategoryList[i].GI', '@Model.AssetCategoryList[i].LogGI', 'DELETE',@i);
                                            swal.fire(MasterPersmissionMsg);"></i>
                                        </a>
                                    }
                                    </div>

                            </td>
                        </tr>
                    }
                }
            }


        </tbody>
    </table>
</div>