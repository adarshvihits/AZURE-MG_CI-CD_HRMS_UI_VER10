@model Hrms.Lite.Shared.Master.EmploymentType
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}

<script src="~/scripts/Master/EmploymentType.js"></script>
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");



        //$('#EmploymentTypeTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');

        });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table employment-master-list pt-1">
    @Html.HiddenFor(m => m.EmploymentTypeList.Count)
    <table id="TableEmploymentType" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>

            @{
                if (Model.EmploymentTypeList != null && Model.EmploymentTypeList.Count > 0)
                {
                    for (int i = 0; i < Model.EmploymentTypeList.Count; i++)

                    {
                        <tr>
                            @Html.HiddenFor(m => m.EmploymentTypeList[i].EditActive)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Active)
                            <td data-label="Name">@Model.EmploymentTypeList[i].Name</td>
                            <td data-label="Short Name">@Model.EmploymentTypeList[i].ShortName</td>
                            <td data-label="Actions">

                                @if (CurrentUserRoleActions.Modify == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="employmentedit"
                                       class="btn btn-icon btn-edit icon-only slider-btn">
                                        <i class="icon-xl fas fa-pencil-alt" onclick="AddNewOrEdit('MODIFY', '@Model.EmploymentTypeList[i].GI', '@Model.EmploymentTypeList[i].LogGI',@i)"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="employmentedit"
                                       class="btn btn-icon btn-edit icon-only slider-btn">
                                        <i class="icon-xl fas fa-pencil-alt" onclick="AddNewOrEdit('MODIFY', '@Model.EmploymentTypeList[i].GI', '@Model.EmploymentTypeList[i].LogGI',@i);
                                        swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#AddNewOrEditSlider');});"></i>
                                    </a>
                                }
                                @if (CurrentUserRoleActions.Delete == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="employmentdelete"
                                       class="btn btn-icon  icon-only mobile-full-width slider-btn btn-delete">
                                        <i class="icon-xl far fa-trash-alt" onclick="onDeleteClick('@Model.EmploymentTypeList[i].GI','@Model.EmploymentTypeList[i].LogGI','DELETE',@i)"></i>
                                    </a>
                                }
                                else
                                { 
                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="employmentdelete"
                                       class="btn btn-icon  icon-only mobile-full-width slider-btn btn-delete">
                                        <i class="icon-xl far fa-trash-alt" onclick="onDeleteClick('@Model.EmploymentTypeList[i].GI', '@Model.EmploymentTypeList[i].LogGI', 'DELETE',@i);
                                        swal.fire(MasterPersmissionMsg);"></i>
                                    </a>
                                }
                                </td>
                        </tr>
                    }
                }


            }

        </tbody>
    </table>
</div>