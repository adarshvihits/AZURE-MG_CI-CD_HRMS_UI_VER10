@model Hrms.Lite.Shared.Master.EmploymentType
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}

<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");



        //$('#PendingTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');

        });
</script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table employment-master-pending pt-1">
    @Html.HiddenFor(m => m.EmploymentTypeList.Count)
    <table id="PendingEmpTypeTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>

            @{


                if (Model.EmploymentTypeList != null && Model.EmploymentTypeList.Count > 0)
                {
                    for (int i = 0; i < Model.EmploymentTypeList.Count; i++)

                    {

                        <tr>
                            @Html.HiddenFor(m => m.EmploymentTypeList[i].MakerChecker)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            <td data-label="Name">@Model.EmploymentTypeList[i].Name</td>
                            <td data-label="Short Name">@Model.EmploymentTypeList[i].ShortName</td>
                            <td data-label="Mode">@Model.EmploymentTypeList[i].Mode</td>


                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="emplymenttypeapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.EmploymentTypeList[i].GI','@Model.EmploymentTypeList[i].LogGI','APPROVL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="emplymenttypeapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.EmploymentTypeList[i].GI', '@Model.EmploymentTypeList[i].LogGI', 'APPROVL',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }


            }

        </tbody>
    </table>
</div>

