@model Hrms.Lite.Shared.Master.DueClearanceSettings
    <script src="~/js/tooltip.js"></script>
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "DueClearanceSettingsDelete" }))
{
    @Html.HiddenFor(m=>m.ParameterGI)
    @Html.HiddenFor(m=>m.Mode)
    <div id="deleteskilltype" class="slider-forms slider-forms-open DeleteDiv">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('DeleteDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>
                Dues Clearance Settings
            </h4>
            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Parameter</label>
                        <div class="view-details">
                            @Model.ParameterName
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Applicable Department
                        </label>
                        <div class="view-details">
                            @Model.Department.Name
                        </div>
                    </div>
                </div>

            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="row-outer">
                        <label class="view-title">Responsible Person</label>
                        <div class="view-details">
                            @Model.ResponsiblePerson.Name
                        </div>
                    </div>
                </div>


            </div>
            <div class="row my-3">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Default Settings

                        </label>
                        <div class="view-details">
                            @if (@Model.DefaultSettings != true)
                            {
                                <button type="button" class="btn btn-icon btn-close">
                                    <i class="icon-xl fas fa-times"></i>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-icon btn-tick">
                                    <i class="icon-xl fas fa-check"></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>


            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">

                    <a type="button" onclick="confirmDelete()"
                       data-bs-toggle="tooltip" title=""
                       data-bs-original-title="Delete"
                       class="btn btn-icon btn-delete big-btn float-none">
                        <i class="icon-xl far fa-trash-alt"></i>
                    </a>
                </div>


            </div>
        </div>
    </div>
}