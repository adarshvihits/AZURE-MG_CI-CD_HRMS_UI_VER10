@model Hrms.Lite.Shared.Master.DueClearanceSettings
    <script src="~/js/settings.js"></script>
    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table dues-master-clearance-list pt-2">
        @Html.HiddenFor(m => m.List.Count)
    <table class="common-table dt-width-fix">
            <thead>
                <tr class="table-dark">
                    <th scope="col">Parameter</th>
                    <th scope="col">Department</th>
                    <th scope="col">Responsible Person</th>
                    <th scope="col">Default Settings</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.List != null && Model.List.Count > 0)
                {

                    for (int i = 0; i < Model.List.Count; i++)
                    {
                        <tr>

                            <td data-label="Parameter">@Model.List[i].ParameterName</td>
                            <td data-label="Department">
                                @Model.List[i].Department.Name
                            </td>
                            <td data-label="Responsible Person">
                                @Model.List[i].ResponsiblePerson.Name
                            </td>
                            <td data-label="Default Settings" class=" d-flex justify-content-center w-100">
                                @if (@Model.List[i].DefaultSettings != true)
                                {
                                    <button type="button" class="btn btn-icon btn-close">
                                        <i class="icon-xl fas fa-times"></i>
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-icon btn-tick">
                                        <i class="icon-xl fas fa-check"></i>
                                    </button>
                                }
                            </td>
                            <td data-label="Actions">
                                <a data-bs-toggle="tooltip" title="Edit"
                                   id="editskilltype" type="button" onclick="AddNewOrEditClick('MODIFY','@Model.List[i].ParameterGI')"
                                   class="btn btn-icon btn-edit icon-only slider-btn">
                                    <i class="icon-xl fas fa-pencil-alt"></i>
                                </a>
                                <!-- Edit Slider start-->
                                <!-- Edit Slider  end-->
                                <!-- delete Slider  start-->
                                <a data-bs-toggle="tooltip" title="Delete"
                                   id="deleteskilltype" type="button" onclick="onDeleteClick('DELETE','@Model.List[i].ParameterGI')"
                                   class="btn btn-icon  icon-only mobile-full-width slider-btn btn-delete">
                                    <i class="icon-xl far fa-trash-alt"></i>
                                </a>


                                <!-- <end delete section></end> -->
                            </td>

                        </tr>

                    }
                }

            </tbody>
        </table>
    </div>