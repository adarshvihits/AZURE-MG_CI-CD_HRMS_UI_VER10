@model Hrms.Lite.Shared.Master.ExitInterviewGroup
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");



        //$('#Pendingcategorytable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');

        });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table exit-interview-pending pt-1">
    <table id="pendingExitGroupTable" class="common-table dt-width-fix">
        <thead>
            @Html.HiddenFor(m => Model.GroupList.Count)
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>

                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>

            @{


                if (Model.GroupList != null && Model.GroupList.Count > 0)
                {

                    for (int i = 0; i < Model.GroupList.Count; i++)
                    {

                        <tr>

                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Code)
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.ApproveMode)

                            @Html.HiddenFor(m => m.GroupList[i].MakerChecker)
                            <td data-label="Name"> @Model.GroupList[i].Name</td>
                            <td data-label="Short Name">@Model.GroupList[i].ShortName</td>

                            <td data-label="Entry Type">@Model.GroupList[i].Mode</td>

                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="categoryapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.GroupList[i].GI','@Model.GroupList[i].LogGI','APPROVAL', @i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                {                                 
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="categoryapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.GroupList[i].GI','@Model.GroupList[i].LogGI','APPROVAL', @i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }

                                </td>
                        </tr>
                    }
                }

            }

        </tbody>
    </table>
</div>