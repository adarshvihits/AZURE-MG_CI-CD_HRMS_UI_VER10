@model Hrms.Lite.Shared.Master.ExitInterviewGroup
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
@*<script src="~/scripts/commonValidators.js"></script>*@
<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });


</script>
@using (Html.BeginForm("Create", "ExitinterviewGroup", FormMethod.Post, new { id = "Save-Interviewgroup" }))
{
    <div id="categoryedit" class="slider-forms slider-forms-open AddInterviewGroup">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddInterviewGroup')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>Exit Interview Group</h4>
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Name
                                <span class="Mandatory">*</span>
                            </label>

                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm GroupName", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'InterviewName')", maxlength = "120" })
                            <span id="InterviewName"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Short Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm GroupshtName", @placeholder = "Short Name", @onblur = "validate(this,'GroupShortName')", maxlength = "5" })
                            <span id="GroupShortName"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 mt-2 mb-2">
                        <div class="d-flex align-items-center">
                            <div> Active</div>
                            <label class="switch" onclick="ActiveInactiveValidationExitGp('EXIT_INTERVIEW_GROUP',@Model.Code)">


                                @Html.CheckBoxFor(model => model.Active,new { @id= "exitGP" })
                                <span class="slider round"></span>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="row my-3">

                    <div class="col-md-12">
                        @*<label class="view-title">Description</label>*@
                        <div class="view-details">
                            @if (Model.Mode == "CREATE")
                            {
                                <label>Description</label>
                                @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm GroupDescription", @placeholder = "Description", maxlength = "250" })
                                <span id="GroupDes" class="text-danger"></span>
                            }
                            @if (Model.Mode == "MODIFY")
                            {
                                <label class="view-title">Description</label>
                                <div class="view-details">

                                    @Html.DisplayFor(Model => Model.Description)
                                    @Html.HiddenFor(model => Model.Description)
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12 align-right">
                        @if (Model.Mode == "CREATE")
                        {

                            @if (CurrentUserRoleActions.Create == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="ExitInterviewGroupSave('Save')">
                                    Save
                                </button>
                            }
                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            @if (CurrentUserRoleActions.Modify == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="ExitInterviewGroupSave('Modify')">
                                    Modify
                                </button>
                            }
                        }
                        </div>
                </div>
            </div>
        </div>
    </div>
}