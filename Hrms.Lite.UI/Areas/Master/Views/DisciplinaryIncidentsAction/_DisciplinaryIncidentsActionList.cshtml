
@model Hrms.Lite.Shared.Master.DisciplinaryIncidentsAction
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");


        });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table diciplinaryaction-master-list pt-1">
    @Html.HiddenFor(m => m.DisciplinaryIncidentsActionList.Count)
    <table id="diciplinaryActnTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>


            @{
                if (Model.DisciplinaryIncidentsActionList != null && Model.DisciplinaryIncidentsActionList.Count > 0)
                {
                    for (int i = 0; i < Model.DisciplinaryIncidentsActionList.Count; i++)

                    {
                        <tr>
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(m => m.DisciplinaryIncidentsActionList[i].EditActive)

                            <td data-label="Name">@Model.DisciplinaryIncidentsActionList[i].Name</td>
                            <td data-label="Short Name">@Model.DisciplinaryIncidentsActionList[i].ShortName</td>
                            <td data-label="Action">
                                @if (CurrentUserRoleActions.Modify == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="editdiciplinaryaction"
                                       class="btn btn-icon btn-edit icon-only ">
                                        <i class="icon-xl fas fa-pencil-alt" onclick="onAddNewOrEditClick('MODIFY','@Model.DisciplinaryIncidentsActionList[i].GI','@Model.DisciplinaryIncidentsActionList[i].LogGI',@i)"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="editdiciplinaryaction"
                                       class="btn btn-icon btn-edit icon-only ">
                                        <i class="icon-xl fas fa-pencil-alt" onclick="onAddNewOrEditClick('MODIFY', '@Model.DisciplinaryIncidentsActionList[i].GI', '@Model.DisciplinaryIncidentsActionList[i].LogGI',@i);
                                        swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#AddNewOrEditSlider');});"></i>
                                    </a>
                                }
                                <!-- Edit Slider start-->
                                <!-- Edit Slider  end-->
                                <!-- delete Slider  start-->
                                @if (CurrentUserRoleActions.Delete == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="deletediciplinaryaction"
                                       class="btn btn-icon  icon-only mobile-full-width  btn-delete">
                                        <i class="icon-xl far fa-trash-alt" onclick="onDeleteClick('@Model.DisciplinaryIncidentsActionList[i].GI','@Model.DisciplinaryIncidentsActionList[i].LogGI','DELETE',@i)"></i>
                                    </a>
                                }
                                else
                                { 
                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="deletediciplinaryaction"
                                       class="btn btn-icon  icon-only mobile-full-width  btn-delete">
                                        <i class="icon-xl far fa-trash-alt" onclick="onDeleteClick('@Model.DisciplinaryIncidentsActionList[i].GI', '@Model.DisciplinaryIncidentsActionList[i].LogGI', 'DELETE',@i);
                                        swal.fire(MasterPersmissionMsg);"></i>
                                    </a>
                                }


                                </td>
                        </tr>
                    }
                }


            }


        </tbody>
    </table>
</div>
<!-- <end table></end> -->