
@model Hrms.Lite.Shared.Master.Zone
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");

        //$('#Gradetable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');


    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table zone-list pt-1">
    @Html.HiddenFor(m => m.ZoneList.Count)
    <table id="Zonetable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                 <th scope="col">Domain</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>

            @{
                if (Model.ZoneList != null && Model.ZoneList.Count > 0)
                {
                    for (int i = 0; i < Model.ZoneList.Count; i++)

                    {
                        <tr>

                           
                            <td data-label="Name">
                             @Html.HiddenFor(model => Model.LogGI)
                             @Html.HiddenFor(model => Model.ZoneCode)

                            @Html.HiddenFor(m => m.ZoneList[i].EditActive)
                            @Html.HiddenFor(model => Model.GI)
                            
                            @Model.ZoneList[i].Name</td>
                            <td data-label="ShortName">@Model.ZoneList[i].ShortName</td>
                            <td data-label="domain">@Model.ZoneList[i].Domain?.Name</td>
                             
                            <td data-label="Actions">
                                <div>

                                    @if (CurrentUserRoleActions.Modify == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="zoneMaseredit"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY','@Model.ZoneList[i].GI','@Model.ZoneList[i].ZoneCode','@Model.ZoneList[i].LogGI',@i)">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="zoneMaseredit"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY', '@Model.ZoneList[i].GI','@Model.ZoneList[i].ZoneCode', '@Model.ZoneList[i].LogGI',@i);
                                           swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#CreateOrEditSlider');});">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                  @if (CurrentUserRoleActions.Delete == true)
{
    <a data-bs-toggle="tooltip" title="Delete"
       id="deletezoneMaster"
       class="btn btn-icon icon-only mobile-full-width btn-delete"
       onclick="onDeleteClick('@Model.ZoneList[i].GI', @Model.ZoneList[i].ZoneCode, '@Model.ZoneList[i].LogGI', 'DELETE', @i)">
        <i class="icon-xl far fa-trash-alt"></i>
    </a>
}
else
{
    <a data-bs-toggle="tooltip" title="Delete"
       id="deleteZoneMaster"
       class="btn btn-icon icon-only mobile-full-width btn-delete"
       onclick="onDeleteClick('@Model.ZoneList[i].GI', @Model.ZoneList[i].ZoneCode, '@Model.ZoneList[i].LogGI', 'DELETE', @i);
       swal.fire(MasterPersmissionMsg);">
        <i class="icon-xl far fa-trash-alt"></i>
    </a>
}
                                    </div>
                            </td>
                        </tr>
                    }
                }


            }

        </tbody>
    </table>
</div>