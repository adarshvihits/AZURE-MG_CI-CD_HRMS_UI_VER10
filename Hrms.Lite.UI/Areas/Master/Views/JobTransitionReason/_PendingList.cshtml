@model Hrms.Lite.Shared.Master.JobTransitionReason
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>

<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");



        //$('#PendingTableJob').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');

        });
</script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table job-transition-master-pending pt-1">
    @Html.HiddenFor(m => m.JobTransitionReasonList.Count)
    <table id="PendingTableJob" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Transition Type</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>

            @{


                if (Model.JobTransitionReasonList != null && Model.JobTransitionReasonList.Count > 0)
                {
                    for (int i = 0; i < Model.JobTransitionReasonList.Count; i++)

                    {

                        <tr>
                            @Html.HiddenFor(m => m.JobTransitionReasonList[i].MakerChecker)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Code)
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.ApproveMode)


                            <td data-label="Name">@Model.JobTransitionReasonList[i].Name</td>
                            <td data-label="ShortName">@Model.JobTransitionReasonList[i].ShortName</td>
                            <td data-label="JobTransitionType">@Model.JobTransitionReasonList[i].JobTransitionsType.Name</td>
                            <td data-label="Entry Type">@Model.JobTransitionReasonList[i].Mode</td>
                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="jobtransitionapprove"
                                       class="btn btn-icon btn-tick icon-only" onclick="onApproveClick('@Model.JobTransitionReasonList[i].GI','@Model.JobTransitionReasonList[i].LogGI','APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                { 
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="jobtransitionapprove"
                                       class="btn btn-icon btn-tick icon-only" onclick="onApproveClick('@Model.JobTransitionReasonList[i].GI', '@Model.JobTransitionReasonList[i].LogGI', 'APPROVAL',@i);
                                        swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }


                                </td>

                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>