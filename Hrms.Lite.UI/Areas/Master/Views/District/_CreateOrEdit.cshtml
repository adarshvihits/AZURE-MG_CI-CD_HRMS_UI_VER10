@model Hrms.Lite.Shared.DataBank.Generic.Master.District
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });


</script>
@using (Html.BeginForm("Save", "District", FormMethod.Post, new { id = "DistrictSave" }))

{
    <div id="districtedit" class="slider-forms slider-forms-open AddNewDiv">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddNewDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>District</h4>
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.Code)

                            @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm dName", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'districtName')", maxlength = "120" })
                            <span id="districtName"></span>

                            @*<input type="text"
                                class="form-control form-control-sm"
                                placeholder="Name">*@
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Short Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm dShortName", @placeholder = "Short Name", @onblur = "validate(this,'districtshortName')", maxlength = "5" })
                            <span id="districtshortName"></span>
                            @*<input type="text"
                                class="form-control form-control-sm"
                                placeholder="Short Name">*@
                        </div>
                    </div>
                </div>
                <div class="row">

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Country
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.DropDownListFor(Model => Model.Country.Code, (SelectList)ViewBag.CountryDropdown, "--Select Country--", new { @class = "form-control form-control-sm Cname", @onchange = "onCountryChange(this,'CountryName')", @onblur = "validate(this,'CountryName')" })
                            <span id="CountryName"></span>
                        </div>
                    </div>


                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                State
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.DropDownListFor(Model => Model.State.Code, (SelectList)ViewBag.StateDropDown, "--Select State--", new { @class = "form-control form-control-sm dStCode", @onblur = "validate(this,'stateName')" })

                        </div>
                        <span id="stateName"></span>

                    </div>



                </div>
                <div class="row">
                    <div class="col-md-6 d-flex align-items-center">
                        <div class="d-flex align-items-center">
                            <div> Active</div>
                            <label class="switch" onchange="ActiveInactiveValidationDist('DISTRICT','@Model.Code')">
                                @Html.HiddenFor(m => Model.Code)
                                @Html.CheckBoxFor(Model => Model.Active, new { @id = "Activeinactivedist" })
                                <span class="slider round"></span>
                            </label>
                        </div>

                    </div>

                </div>

                <div class="row my-3">

                    <div class="col-md-12">
                        @*<label class="view-title">Description</label>*@
                        <div class="view-details">
                            @if (Model.Mode == "CREATE")
                            {
                                <label>Description</label>
                                @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm dDescription", @placeholder = "Description", maxlength = "250", })
                                @Html.HiddenFor(model => Model.Description)
                                <span id="DistrictDescription"></span>
                            }
                            @if (Model.Mode == "MODIFY")
                            {
                                <label class="view-title">Description</label>
                                @*<div class="view-details">*@

                                @Html.DisplayFor(Model => Model.Description, new { })
                                @Html.HiddenFor(model => Model.Description)
                                <span id="DistrictDescription" class="text-danger"></span>

                            }
                        </div>
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12 align-right">
                        @if (Model.Mode == "CREATE")
                        {
                            @if (CurrentUserRoleActions.Create == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="DistrictSaveClick('Save')">
                                    Save
                                </button>
                            }
                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            @if (CurrentUserRoleActions.Modify == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="DistrictSaveClick('Modify')">
                                    Modify
                                </button>

                            }
                        }
                        </div>
                </div>
            </div>
        </div>
    </div>
}