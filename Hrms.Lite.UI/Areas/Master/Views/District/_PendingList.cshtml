@model Hrms.Lite.Shared.DataBank.Generic.Master.District
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");




    });
</script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table district-pending pt-1">
    @Html.HiddenFor(m => m.DistrictList.Count)
    <table id="PendingDistrictTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">State</th>
                <th scope="col">Country</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>

            @{


                if (Model.DistrictList != null && Model.DistrictList.Count > 0)
                {
                    for (int i = 0; i < Model.DistrictList.Count; i++)

                    {

                        <tr>
                            @Html.HiddenFor(m => m.DistrictList[i].MakerChecker)
                            <td data-label="Name">@Model.DistrictList[i].Name</td>
                            <td data-label="Short Name">@Model.DistrictList[i].ShortName</td>
                            <td data-label="State">@Model.DistrictList[i].StateName</td>
                            <td data-label="Country">@Model.DistrictList[i].CountryName</td>
                            <td data-label="Entry Type">@Model.DistrictList[i].Mode</td>

                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.State.Code)
                            @Html.HiddenFor(model => Model.State.Name)
                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="districtapprove" type="button"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.DistrictList[i].GI', '@Model.DistrictList[i].LogGI','APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="districtapprove" type="button"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.DistrictList[i].GI', '@Model.DistrictList[i].LogGI', 'APPROVAL',@i);
                                   swal.fire(MasterPersmissionMsg)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }

            }

        </tbody>
    </table>
</div>
