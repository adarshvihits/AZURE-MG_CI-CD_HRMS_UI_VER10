@model Hrms.Lite.Shared.Master.DisciplinaryIncidentsMaster
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/settings.js"></script>
<script src="~/js/tooltip.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");

    

    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table disciplinary-incidents-master-list pt-1">
    @Html.HiddenFor(m => m.DisciplinaryIncidentsList.Count)
    <table id="DisciplinaryMasterTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.DisciplinaryIncidentsList != null && Model.DisciplinaryIncidentsList.Count > 0)
                {
                    for (int i = 0; i < Model.DisciplinaryIncidentsList.Count; i++)

                    {
                        <tr>
                            @Html.HiddenFor(m => m.DisciplinaryIncidentsList[i].EditActive)
                            @Html.HiddenFor(model => Model.Mode)
                            <td data-label="Name">@Model.DisciplinaryIncidentsList[i].Name</td>
                            <td data-label="Short Name">@Model.DisciplinaryIncidentsList[i].ShortName</td>
                            <td data-label="Actions">
                                <div>
                                    @if (CurrentUserRoleActions.Modify == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="addNewDisciplinaryIncidentsMaster"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY', '@Model.DisciplinaryIncidentsList[i].GI', '@Model.DisciplinaryIncidentsList[i].LogGI',@i)">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="addNewDisciplinaryIncidentsMaster"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY', '@Model.DisciplinaryIncidentsList[i].GI', '@Model.DisciplinaryIncidentsList[i].LogGI',@i);
                                           swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#newRequestSlider');});">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    @if (CurrentUserRoleActions.Delete == true)
                                    {
                                        <!-- delete Slider  start-->
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="id=deleteDisciplinaryIncidentsMaster"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.DisciplinaryIncidentsList[i].GI','@Model.DisciplinaryIncidentsList[i].LogGI','DELETE',@i)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                    else
                                    { 
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="id=deleteDisciplinaryIncidentsMaster"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.DisciplinaryIncidentsList[i].GI', '@Model.DisciplinaryIncidentsList[i].LogGI', 'DELETE',@i);
                                           swal.fire(MasterPersmissionMsg);">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                    </div>
                            </td>
                        </tr>
                    }
                }


            }



        </tbody>
    </table>
</div>