@model Hrms.Lite.Shared.Master.DisciplinaryIncidentsMaster
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        
        moveCursorToEnd('Name');
    });


</script>
@using (Html.BeginForm("Save", "DisciplinaryMaster", FormMethod.Post, new { id = "disciplinarySave" }))
{
    <script src="~/scripts/Master/disciplinaryMaster.js"></script>
    <div id="addNewDisciplinaryIncidentsMaster" class="slider-forms slider-forms-open disciplinarySaveclose">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('disciplinarySaveclose')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>
                Incidents Settings
            </h4>
            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Name
                            <span class="Mandatory">*</span>
                        </label>
                        @Html.HiddenFor(model => Model.Mode)
                        @Html.HiddenFor(model => Model.LogGI)
                        @Html.HiddenFor(model => Model.GI)
                        @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm DName", @placeholder = "Name", @onchange = "OnlycapitalizeFirstLetter(this,'DisciplinaryName')", maxlength = "120" })
                        <span id="DisciplinaryName"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Short Name
                            <span class="Mandatory">*</span>
                        </label>
                        @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm DShort", @placeholder = "Short Name", @onchange = "validate(this,'DisciplinaryShortName')", maxlength = "5" })
                        <span id="DisciplinaryShortName"></span>
                    </div>
                </div>

            </div>

            <div class="row my-3">
                <div class="col-md-12">
                    <div class="d-flex align-items-center">
                        <div> Active</div>
                        <label class="switch" onclick="ActiveInactiveValidationIncidents('Incidents settings',@Model.Code)">
                            @Html.CheckBoxFor(model => model.Active,new { @id="incidents"})
                            @*<input type="checkbox" checked>*@
                            <span class="slider round"></span>
                        </label>
                    </div>
                </div>
            </div>
            <div class="row my-3">

                <div class="col-md-12">
                    @if (Model.Mode == "CREATE")
                    {
                        <label>Description</label>
                        @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm", @placeholder = "Description", maxlength = "250" })
                    }
                    @if (Model.Mode == "MODIFY")
                    {
                        <label class="view-title">Description</label>
                        <div class="view-details">

                            @Html.DisplayFor(Model => Model.Description)
                            @Html.HiddenFor(model => Model.Description)
                        </div>
                    }
                </div>
            </div>

            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    @if (Model.Mode == "CREATE")
                    {

                        @if (CurrentUserRoleActions.Create == true)
                        {
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="disciplinarySave('Save')">
                                Save
                            </button>
                        }
                    }
                    @if (Model.Mode == "MODIFY")
                    {
                        @if (CurrentUserRoleActions.Modify == true)
                        {
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="disciplinarySave('Modify')">
                                Modify
                            </button>
                        }
                    }

                    </div>

            </div>
        </div>
    </div>
}
