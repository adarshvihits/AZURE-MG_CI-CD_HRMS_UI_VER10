@model Hrms.Lite.Shared.Master.DisciplinaryIncidentsMaster
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    debugger;

     $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
         $('.pendingTabCount').html("@Model.PendingCount");

    });
</script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table country-pending pt-1">
    @Html.HiddenFor(m => m.DisciplinaryIncidentsList.Count)
    <table id="DisciplinaryPendingTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>

            @{


                if (Model.DisciplinaryIncidentsList != null && Model.DisciplinaryIncidentsList.Count > 0)
                {
                    for (int i = 0; i < Model.DisciplinaryIncidentsList.Count; i++)

                    {

                        <tr>
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(m => m.DisciplinaryIncidentsList[i].MakerChecker)
                            <td data-label="Name">@Model.DisciplinaryIncidentsList[i].Name</td>
                            <td data-label="Short Name">@Model.DisciplinaryIncidentsList[i].ShortName</td>
                            <td data-label="Entry Type">@Model.DisciplinaryIncidentsList[i].EntryType</td>


                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="disciplinaryapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.DisciplinaryIncidentsList[i].GI','@Model.DisciplinaryIncidentsList[i].LogGI','APPROVAL', @i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                { 
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="disciplinaryapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.DisciplinaryIncidentsList[i].GI', '@Model.DisciplinaryIncidentsList[i].LogGI', 'APPROVAL', @i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                </td>

                        </tr>
                    }
                }


            }

        </tbody>
    </table>
</div>

