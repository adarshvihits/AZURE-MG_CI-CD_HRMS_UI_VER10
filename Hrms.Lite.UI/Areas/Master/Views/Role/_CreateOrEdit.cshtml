
@model Hrms.Lite.Shared.Master.Role
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;

<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });


</script>
@using (Html.BeginForm("Save", "Role", FormMethod.Post, new { id = "Rolesave" }))
{
    <div id="addRolename" class="slider-forms slider-forms-open AddNewDiv">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddNewDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>Role  </h4>
            </div>
            <div class="add-padding">
                <div class="row">

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Name
                                <span class="Mandatory">*</span>
                            </label>

                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm BName", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'RoleName')", maxlength = "120" })
                            <span id="RoleName"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Short Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm BShtName", @placeholder = "Short Name", @onblur = "validate(this,'RoleShortName')", maxlength = "5" })
                            <span id="RoleShortName"></span>
                        </div>
                    </div>
                </div>

                <div class="row my-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Role Classification</label>
                            @Html.DropDownListFor(m => m.RoleClassification.Code, (SelectList)ViewBag.RoleClassification, "Select", new { @class = "form-control form-control-sm" })
                            <span id="classificationApplicability"></span>

                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-center">
                            <div>Active</div>
                            <label class="switch" onchange="ActiveInactiveValidationRole('Role', '@Model.Code')">
                                @Html.HiddenFor(m => Model.Code)
                                @Html.CheckBoxFor(model => model.Active, new { @id = "activeinactiveRole" })
                                <span class="slider round"></span>
                            </label>
                        </div>
                    </div>
                </div>

         



            <div class="row my-3">

                <div class="col-md-12">

                    @if (Model.Mode == "CREATE")
                    {
                        <label>Description</label>
                        @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm BDescription", @placeholder = "Description", maxlength = "250" })

                    }
                    @if (Model.Mode == "MODIFY")
                    {
                        <label class="view-title">Description</label>
                        <div class="view-details">

                            @Html.DisplayFor(Model => Model.Description)
                            @Html.HiddenFor(model => Model.Description)
                        </div>
                    }
                </div>
            </div>

            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    @if (Model.Mode == "CREATE")
                    {
                        

                            <button type="button" class="btn btn-default  mobile-full-width" onclick="SaveRole('Save')">
                                Save
                            </button>
                       
                    }
                    @if (Model.Mode == "MODIFY")
                    {

                            <button type="button" class="btn btn-default  mobile-full-width" onclick="SaveRole('Modify')">
                                Modify
                            </button>
                       
                    }
                </div>

            </div>
        </div>
    </div>
    </div>
}