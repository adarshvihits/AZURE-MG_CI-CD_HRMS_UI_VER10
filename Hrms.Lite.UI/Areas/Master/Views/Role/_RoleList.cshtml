@model Hrms.Lite.Shared.Master.Role
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;

<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>

<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");



        //$('#RoleTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');

        });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Roleist-master-list pt-1">
    @Html.HiddenFor(model => Model.RoleList.Count)
    <table id="RoleTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Role Classification</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>

            @{
                if (Model.RoleList != null && Model.RoleList.Count > 0)
                {
                    for (int i = 0; i < Model.RoleList.Count; i++)

                    {
                        <tr>

                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Name">
                                @Model.RoleList[i].Name
                                @Html.HiddenFor(m => m.RoleList[i].EditActive)
                            </td>
                            <td data-label="Short Name"> @Model.RoleList[i].ShortName</td>

                            <td data-label="Role Classification"> @Model.RoleList[i].RoleClassification.Name</td>
                            <td data-label="Actions">
                                <div>

                                   
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="Rolenameedit"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY', '@Model.RoleList[i].GI', '@Model.RoleList[i].LogGI',@i)">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    
                                   
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="Rolenamedelete"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.RoleList[i].GI', '@Model.RoleList[i].LogGI','DELETE',@i)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    
                                </div>
                            </td>
                        </tr>
                    }
                }


            }


        </tbody>
    </table>
</div>