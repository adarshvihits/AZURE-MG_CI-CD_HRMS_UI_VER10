
@model Hrms.Lite.Shared.Master.VDAGroup
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>
    (Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<link href="~/css/custom.css" rel="stylesheet" />
<script src="~/js/settings.js"></script>

<script>
        $(document).ready(function () {
            debugger;

            $('.pendingTabCount').html("@Model.PendingCount");




        });
</script>


<div class="ihits-table table-border hover-color odd-even mobile-responsive-table vda-master-list ">
    <table id="VDATable" class="common-table dt-width-fix">
        @Html.HiddenFor(m=>Model.VDAGroupList.Count)
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        @{
            if (Model.VDAGroupList != null && Model.VDAGroupList.Count > 0)
            {
                for (int i = 0; i < Model.VDAGroupList.Count; i++)

                {

            <tr>


                <td data-label="Name">@Model.VDAGroupList[i].Name</td>
                <td data-label="Name">@Model.VDAGroupList[i].ShortName</td>

                <td data-label="Actions">
                    <div>

                        @Html.HiddenFor(model => Model.LogGI)
                        @Html.HiddenFor(model => Model.Description)
                        @Html.HiddenFor(model => Model.Active)
                        @Html.HiddenFor(m => m.VDAGroupList[i].EditActive)
                        @Html.HiddenFor(model => Model.GI)
                        @if (CurrentUserRoleActions.Modify == true)
                                {
                        <a data-bs-toggle="tooltip" title="Edit"
                           id="circleedit"
                           class="btn btn-icon btn-edit icon-only" onclick="AddNewOrEditClick('MODIFY', '@Model.VDAGroupList[i].GI', '@Model.VDAGroupList[i].LogGI',@i)">
                            <i class="icon-xl fas fa-pencil-alt"></i>
                        </a>
                                }
                                else
                                {
                        <a data-bs-toggle="tooltip" title="Edit"
                           id="circleedit"
                           class="btn btn-icon btn-edit icon-only" onclick="AddNewOrEditClick('MODIFY', '@Model.VDAGroupList[i].GI', '@Model.VDAGroupList[i].LogGI',@i);
                                                swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#AddNewOrEditSlider');});">
                            <i class="icon-xl fas fa-pencil-alt"></i>
                        </a>
                                }
                        @if (CurrentUserRoleActions.Delete == true)
                                {
                        <a data-bs-toggle="tooltip" title="Delete"
                           id="deletecircle"
                           class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.VDAGroupList[i].GI', '@Model.VDAGroupList[i].LogGI','DELETE',@i)">
                            <i class="icon-xl far fa-trash-alt"></i>
                        </a>
                                }
                                else
                                {
                        <a data-bs-toggle="tooltip" title="Delete"
                           id="deletecircle"
                           class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.VDAGroupList[i].GI', '@Model.VDAGroupList[i].LogGI', 'DELETE',@i);
                                           swal.fire(MasterPersmissionMsg)">
                            <i class="icon-xl far fa-trash-alt"></i>
                        </a>
                                }
                    </div>
                </td>
            </tr>
                }
            }
        }


    </table>
</div>
