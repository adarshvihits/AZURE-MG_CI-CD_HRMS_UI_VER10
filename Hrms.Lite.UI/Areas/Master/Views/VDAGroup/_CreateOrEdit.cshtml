@model Hrms.Lite.Shared.Master.VDAGroup
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>
    (Context.Session.GetString("UserRoleActions"));
}

<script>
    $(document).ready(function () {
        debugger;

    });


</script>


@using (Html.BeginForm("Save", "VDAGroup", FormMethod.Post, new { id = "VDASave" }))
{
    <div id="addvda" class="slider-forms slider-forms-open addNew">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('addNew')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>
                VDA Group
            </h4>
            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Name
                            <span class="Mandatory">*</span>
                        </label>

                        @Html.HiddenFor(model => Model.Mode)
                        @Html.HiddenFor(model => Model.LogGI)
                        @Html.HiddenFor(model => Model.GI)
                        @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm VdaName", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'VDAName')", maxlength = "120" })
                        <span id="VDAName"></span>

                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Short Name
                            <span class="Mandatory">*</span>
                        </label>
                        @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm wShtName", @placeholder = "ShortName", @onblur = "validate(this,'ShName')", maxlength = "5" })
                        <span id="ShName"></span>
                    </div>
                </div>
            </div>


            <div class="row my-3">


                <div class="col-md-12 d-flex align-items-center">
                    <div>
                        Active
                    </div>




                    <label class="switch" onchange="ActiveInactiveValidationVDA('VDAGROUP', '@Model.Code')">
                        @Html.HiddenFor(m => Model.Code)
                        @Html.CheckBoxFor(Model => Model.Active, new { @id = "VDAActive" })
                        <span class="slider round"></span>
                    </label>


                </div>


            </div>



            <div class="row my-3">

                <div class="col-md-12">

                    @if (Model.Mode == "CREATE")
                    {
                        <label>Description</label>
                        @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm VDADescription", @placeholder = "Description", maxlength = "250" })

                    }
                    @if (Model.Mode == "MODIFY")
                    {
                        <label class="view-title">Description</label>
                        <div class="view-details">
                            @Html.HiddenFor(model => Model.Description)
                            @Html.DisplayFor(Model => Model.Description)
                        </div>
                    }

                </div>
            </div>

            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    @if (Model.Mode == "CREATE")
                    {
                        @if (CurrentUserRoleActions.Create == true)
                        {
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="VDAGroupSave('Save')">
                                Save
                            </button>
                        }
                    }
                    @if (Model.Mode == "MODIFY")
                    {
                        @if (CurrentUserRoleActions.Modify == true)
                        {
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="VDAGroupSave('Modify')">
                                Modify
                            </button>
                        }
                    }
                </div>

            </div>
        </div>
    </div>
}