@model Hrms.Lite.Shared.Account.PasswordPolicySettings
@{
    ViewData["Title"] = "PasswordPolicySettings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "PWDPolicy" }))
{
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->
            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">
                        Password Policy Settings
                    </h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            Password Policy Settings
                        </li>

                    </ul>
                </div>
            </div>
            <!--end::Header Menu Wrapper-->
            <!--begin::Topbar-->
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->


    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->

                <div class="row height-100per">

                    <div class="col-md-12">
                        <div class="card card-custom height-100per">

                            <div class="card-body">
                                <div class="row tab-style-button">

                                    <div class="col-md-6">
                                        <div class="page_white">
                                            <div class="changepassword">

                                                <div class=" pb-2">
                                                    <h4 class="changeword"> Password Policy Settings</h4>
                                                </div>
                                                <div class="row ">
                                                    <div class="col-md-6">

                                                        <div class="form-group newpasscode">
                                                            <label class="">Password Minimum Length</label>
                                                            @Html.TextBoxFor(m => m.MinimumLength, new { @class = "form-control form-control-sm", @placeholder = "Password Minimum Length", @maxlength = 2, @onkeypress = "return onlyNumberKey(event)", @onblur = "validate(this,'minLen')" })
                                                            <span id="minLen"></span>
                                                        </div>
                                                    </div>

                                                    <div class="col-md-6">
                                                        <div class="form-group newpasscode">
                                                            <label class="">Minimum Special Character</label>
                                                            @Html.TextBoxFor(m => m.MinimumSpecialCharacter, new { @class = "form-control form-control-sm", @placeholder = "Minimum Special Character", @maxlength = 2, @onkeypress = "return onlyNumberKey(event)", @onblur = "validate(this,'minSplChar')" })
                                                            <span id="minSplChar"></span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row ">
                                                    <div class="col-md-6">
                                                        <div class="form-group newpasscode">
                                                            <label class="">Password Maximum Length</label>
                                                            @Html.TextBoxFor(m => m.MaximumLength, new { @class = "form-control form-control-sm", @placeholder = "Password Maximum Length", @maxlength = 2, @onkeypress = "return onlyNumberKey(event)", @onblur = "validate(this,'maxLen')" })
                                                            <span id="maxLen"></span>
                                                        </div>


                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="form-group newpasscode">
                                                            <label class="">Minimum Numeric Values</label>
                                                            @Html.TextBoxFor(m => m.MinimumNumericValues, new { @class = "form-control form-control-sm", @placeholder = "Minimum Numeric Values", @maxlength = 2, @onkeypress = "return onlyNumberKey(event)", @onblur = "validate(this,'minNum')" })
                                                            <span id="minNum"></span>
                                                        </div>


                                                    </div>

                                                </div>
                                                <div class="row ">
                                                    <div class="col-md-6">
                                                        <div class="form-group newpasscode">
                                                            <label class=""> Minimum  Uppercase Letters</label>
                                                            @Html.TextBoxFor(m => m.MinimumUppercaseLetters, new { @class = "form-control form-control-sm", @placeholder = "Minimum  Uppercase Letters", @maxlength = 2, @onkeypress = "return onlyNumberKey(event)", @onblur = "validate(this,'minUpper')" })
                                                            <span id="minUpper"></span>
                                                        </div>


                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="form-group newpasscode">
                                                            <label class="">Password Expiry Days</label>

                                                            @Html.TextBoxFor(m => m.PasswordExpiryDays, new { @class = "form-control form-control-sm", @placeholder = "Password Expiry Days", @maxlength = 3, @onkeypress = "return onlyNumberKey(event)", @onblur = "validate(this,'passExpiry')" })
                                                            <span id="passExpiry"></span>
                                                        </div>


                                                    </div>

                                                </div>
                                                <div class="row ">
                                                    <div class="col-md-6">
                                                        <div class="form-group newpasscode">
                                                            <label class=""> Minimum Lowercase Letters</label>
                                                            @Html.TextBoxFor(m => m.MinimumLowercaseLetters, new { @class = "form-control form-control-sm", @placeholder = "Minimum Lowercase Letters", @maxlength = 2, @onkeypress = "return onlyNumberKey(event)", @onblur = "validate(this,'minLower')" })
                                                            <span id="minLower"></span>
                                                        </div>


                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="form-group newpasscode">
                                                            <label class="">Enforce Password History</label>
                                                            @Html.TextBoxFor(m => m.EnforcePasswordHistory, new { @class = "form-control form-control-sm", @placeholder = "Enforce Password History", @maxlength = 2, @onkeypress = "return onlyNumberKey(event)", @onblur = "validate(this,'passHistory')" })
                                                            <span id="passHistory"></span>
                                                        </div>


                                                    </div>

                                                </div>
                                                <div class="row pt-7 ">

                                                    <div class="col-md-12 align-right">
                                                        <a type="button"
                                                           class="btn btn-default  mobile-full-width" onclick="PasswordPolicySave()">
                                                            Save
                                                        </a>

                                                    </div>

                                                </div>
                                            </div>
                                        </div>


                                    </div>



                                </div>
                            </div>
                        </div>
                    </div>

                    <!--
                    <end col-12></end> -->



                </div>




                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->
    </div>
    <!--end::Content-->

}