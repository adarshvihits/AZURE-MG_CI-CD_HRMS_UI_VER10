@model Hrms.Lite.Shared.Master.Category
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}

<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>

<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InActiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");



        //$('#CategoryTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');

        });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table category-list pt-1">
    @Html.HiddenFor(model => Model.CategoryList.Count)
    <table id="CategoryTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Type</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.CategoryList != null && Model.CategoryList.Count > 0)
                {


                    for (int i = 0; i < Model.CategoryList.Count; i++)

                    {
                        <tr>

                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(m => m.CategoryList[i].EditActive)
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Name">@Model.CategoryList[i].Name</td>
                            <td data-label="Short Name">@Model.CategoryList[i].ShortName</td>
                            <td data-label="Category Type">@Model.CategoryList[i].CategoryType.Name</td>
                            <td data-label="Actions">
                                <div>


                                    @if (CurrentUserRoleActions.Modify == true)
                                    {

                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="categoryedit"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY', '@Model.CategoryList[i].GI','@Model.CategoryList[i].LogGI',@i)">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    else
                                    { 
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="categoryedit"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY', '@Model.CategoryList[i].GI', '@Model.CategoryList[i].LogGI',@i);
                                           swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#CreateOrEditSlider');});">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deletecategory"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.CategoryList[i].GI', '@Model.CategoryList[i].LogGI','DELETE',@i)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>

                                    </div>
                            </td>
                        </tr>
                    }
                }

            }
        </tbody>
    </table>
</div>
