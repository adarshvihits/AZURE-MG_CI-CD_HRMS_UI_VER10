@model Hrms.Lite.Shared.Master.Category
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}

@*<script src="~/scripts/commonValidators.js"></script>*@
<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });


</script>
@using (Html.BeginForm("Create", "Category", FormMethod.Post, new { id = "Save-category" }))
{
    <div id="categoryedit" class="slider-forms slider-forms-open AddNewDiv">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddNewDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>Category</h4>
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Name
                                <span class="Mandatory">*</span>
                            </label>

                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm CName", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'CategoryName')", maxlength = "120" })
                            <span id="CategoryName"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Short Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm CShtName", @placeholder = "Short Name", @onblur = "validate(this,'CategoryShortName')", maxlength = "5" })
                            <span id="CategoryShortName"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 mt-2 mb-2">
                        <div class="d-flex align-items-center">

                            <div> Active</div>
                            <label class="switch" @*onchange="ActiveInactiveValidation('CAT','@Model.Code')"*@>
                                @Html.HiddenFor(m => Model.Code)
                                @Html.CheckBoxFor(model => model.Active, new { @id = "Activeinactivedcat" })
                                <span class="slider round"></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Type
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.DropDownListFor(Model => Model.CategoryType.Code, (SelectList)ViewBag.CategoryDropdown, "--Select Type--", new { @class = "form-control form-control-sm CType", @onchange = "validateCatType(this,'CategoryType')", maxlength = "5" })
                            <span id="CategoryType"></span>
                        </div>
                    </div>
                    <div class="col-md-6 expiry">
                        <div class="form-group">
                            <label>
                                Expiry Period(in
                                month)
                                <span class="Mandatory">*</span>
                            </label>
                            <div class="input-group date">
                                @*<input type="text" class="form-control" id="kt_datepicker_2"
                                    readonly="readonly" placeholder="Expiry Period" />*@
                                @Html.TextBoxFor(Model => Model.ExpiryPeriod, new { @class = "form-control form-control-sm CExpiryPeriod", @placeholder = "Expiry Period", @autocomplete = "off", @onblur = "validate(this,'Period')", onkeypress = "return onlyNumberKey(event)", maxlength = "4", @oninput = "process(this)" })
                                <!--<div class="input-group-append">
                                <span id="DateTime" class="input-group-text">-->
                                @*<i class="la la-calendar"></i>*@
                                <!--</span>
                                </div>-->
                            </div>
                            <span id="Period"></span>
                        </div>
                    </div>
                </div>

                <div class="row my-3">

                    <div class="col-md-12">
                        @*<label class="view-title">Description</label>*@
                        <div class="view-details">
                            @if (Model.Mode == "CREATE")
                            {
                                <label>Description</label>
                                @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm CDescription", @placeholder = "Description", maxlength = "250" })
                                <span id="CategoryDescription" class="text-danger"></span>
                            }
                            @if (Model.Mode == "MODIFY")
                            {
                                <label class="view-title">Description</label>
                                <div class="view-details">

                                    @Html.DisplayFor(Model => Model.Description)
                                    @Html.HiddenFor(model => Model.Description)
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12 align-right">
                        @if (Model.Mode == "CREATE")
                        {
                            @if (CurrentUserRoleActions.Create == true)
                            {

                                <button type="button" class="btn btn-default  mobile-full-width" onclick="CategorySave('Save')">
                                    Save
                                </button>
                            }
                        }
                        @if (Model.Mode == "MODIFY")
                        {


                            @if (CurrentUserRoleActions.Modify == true)
                            {

                                <button type="button" class="btn btn-default  mobile-full-width" onclick="CategorySave('Modify')">
                                    Modify
                                </button>
                            }
                        }
                        </div>
                </div>
            </div>
        </div>
    </div>
}