@model Hrms.Lite.Shared.DataBank.Generic.Master.DepartmentCostCenter
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });


</script>
@using (Html.BeginForm("Save", "DepartmentCostCenter", FormMethod.Post, new { id = "DepartmentCostCenterSave" }))

{
    <div id="DepartmentCostCenteredit" class="slider-forms slider-forms-open AddNewDiv">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddNewDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>DepartmentCostCenter</h4>
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.Code)

                            @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm dName", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'DepartmentCostCenterName')", maxlength = "120" })
                            <span id="DepartmentCostCenterName"></span>

                            @*<input type="text"
                                class="form-control form-control-sm"
                                placeholder="Name">*@
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Short Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm dShortName", @placeholder = "Short Name", @onblur = "validate(this,'DepartmentCostCentershortName')", maxlength = "5" })
                            <span id="DepartmentCostCentershortName"></span>
                            @*<input type="text"
                                class="form-control form-control-sm"
                                placeholder="Short Name">*@
                        </div>
                    </div>
                </div>





                <div class="row">
                    <div class="col-md-6 d-flex align-items-center">
                        <div class="d-flex align-items-center">
                            <div> Active</div>
                            <label class="switch" onchange="ActiveInactiveValidationDist('DepartmentCostCenter','@Model.Code')">
                                @Html.HiddenFor(m => Model.Code)
                                @Html.CheckBoxFor(Model => Model.Active, new { @id = "Activeinactivedist" })
                                <span class="slider round"></span>
                            </label>
                        </div>

                    </div>

                </div>

                <div class="row my-3">

                    <div class="col-md-12">
                        @*<label class="view-title">Description</label>*@
                        <div class="view-details">
                            @if (Model.Mode == "CREATE")
                            {
                                <label>Description</label>
                                @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm dDescription", @placeholder = "Description", maxlength = "250", })
                                @Html.HiddenFor(model => Model.Description)
                                <span id="DepartmentCostCenterDescription"></span>
                            }
                            @if (Model.Mode == "MODIFY")
                            {
                                <label class="view-title">Description</label>
                                @*<div class="view-details">*@

                                @Html.DisplayFor(Model => Model.Description, new { })
                                @Html.HiddenFor(model => Model.Description)
                                <span id="DepartmentCostCenterDescription" class="text-danger"></span>

                            }
                        </div>
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12 align-right">
                        @if (Model.Mode == "CREATE")
                        {
                            @if (CurrentUserRoleActions.Create == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="DepartmentCostCenterSaveClick('Save')">
                                    Save
                                </button>
                            }
                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            @if (CurrentUserRoleActions.Modify == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="DepartmentCostCenterSaveClick('Modify')">
                                    Modify
                                </button>

                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
