@model Hrms.Lite.Shared.Master.Consultancy
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;

<script src="~/js/tooltip.js"></script>

@using (Html.BeginForm("Delete", "Consultancy", FormMethod.Post, new { @id = "DeleteConsultancy" }))
{
    <div id="deletedepartment" class="slider-forms slider-forms-open delete">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('delete')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>Consultancy</h4>
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Name</label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.Name)
                                @Html.HiddenFor(model => Model.Name)
                                @Html.HiddenFor(model => Model.Active)
                                @Html.HiddenFor(model => Model.Description)
                                @Html.HiddenFor(model => Model.GI)
                                @Html.HiddenFor(model => Model.ShortName)
                                @Html.HiddenFor(model => Model.LogGI)

                                @Html.HiddenFor(model => Model.Mode)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Short
                                Name
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.ShortName)
                            </div>
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Valid From
                            </label>
                            <div class="view-details">
                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.ValidFrom))
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Valid To
                            </label>
                            <div class="view-details">
                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.ValidTo))
                            </div>
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Contact Person
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.ContactPerson)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="row-outer">
                            <label class="view-title">Active</label>
                            <div class="view-details">
                                @if (Model.Active == true)
                                {

                                    <a type="button" class="btn btn-icon btn-tick">
                                        <i class="icon-xl fas fa-check"></i>
                                    </a>

                                }
                                else
                                {
                                    <a type="button" class="btn btn-icon btn-close">
                                        <i class="icon-xl fas fa-times"></i>

                                    </a>
                                }
                            </div>
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Mobile No.
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.MobileNo)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Land NO.
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.LandNO)
                            </div>
                        </div>
                    </div>
                </div>
                

                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">
                        
                            <a type="button"
                               data-bs-toggle="tooltip" title="Delete"
                               data-bs-original-title="Delete"
                               class="btn btn-icon btn-delete big-btn float-none" onclick="return confirmDelete('@Model.GI', '@Model.LogGI')">
                                <i class="icon-xl far fa-trash-alt"></i>
                            </a>
                       
                    </div>
                </div>
            </div>
        </div>
    </div>
}