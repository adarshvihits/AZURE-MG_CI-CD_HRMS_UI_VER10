
@model Hrms.Lite.Shared.Master.SalaryPeriodLock
    <script src="~/scripts/Master/SalaryperiodLock.js"></script>


<div class="row">
    <div class="col-md-3">
        <div class="form-group">
            <label>Month</label>
            @Html.DropDownListFor(m => Model.MonthCode, (SelectList)ViewBag.month, new { @class = "form-control form-control-sm popupLockMonth", @onchange = "GetLockUnLockList(this)" })


        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label>Payroll Group</label>
            @Html.DropDownListFor(m => Model.PGCode, (SelectList)ViewBag.PGroup,"ALL",new { @class = "form-control form-control-sm popupLockPGCode", @onchange = "GetLockUnLockList(this)" })


        </div>
    </div>

    <div class="col-md-6 d-flex justify-content-end">

        <button data-bs-toggle="tooltip" title="" class="btn btn-excel" data-bs-original-title="Export to Excel"  onclick="getOpen_UnlockExcel('LockUnlock','popupLockMonth','popupLockPGCode')">
            <i class="icon-xl far fa-file-excel"></i>
        </button>
    </div>

</div>
<div id="LockunlockTable">
    @await Html.PartialAsync("_LockUnlockLogPopUpList")

</div>