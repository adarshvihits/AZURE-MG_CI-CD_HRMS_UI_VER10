@model Hrms.Lite.Shared.Master.SalaryPeriodLock
<div class="row" style="padding:10px;">
    <div class="col-md-3">
        <div class="form-group">
            <label>Month</label>
            @Html.DropDownListFor(m => Model.MonthCode, (SelectList)ViewBag.month, new { @class = "form-control form-control-sm popupOpenMonth", @onchange = "GetMonthPopUpList(this)" })

        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label>Payroll Group</label>
            @Html.DropDownListFor(m => Model.PGCode, (SelectList)ViewBag.PGroup, "ALL", new { @class = "form-control form-control-sm popupOpenPGCode", @onchange = "GetMonthPopUpList(this)" })

        </div>
    </div>

    <div class="col-md-6 d-flex justify-content-end">

        <button data-bs-toggle="tooltip" title="" class="btn btn-excel" data-bs-original-title="Export to Excel" onclick="getOpen_UnlockExcel('OPenMonth','popupOpenMonth','popupOpenPGCode')">
            <i class="icon-xl far fa-file-excel"></i>
        </button>
    </div>


</div>
<div id="openmonthTable">
    @await Html.PartialAsync("_OpenMonthPopUpList")

</div>