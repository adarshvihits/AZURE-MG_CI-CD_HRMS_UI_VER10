@model Hrms.Lite.Shared.Master.SalaryPeriodLock
    <script src="~/js/settings.js"></script>
    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table refer-candidate-list vertical-scroll-200 " style="padding:10px;">
        @Html.HiddenFor(m => m.LockUnlock.Count)
        <table class="common-table">
            <thead>
                <tr class="table-light">

                    <th scope="col">Month</th>
                    <th scope="col"> Payroll Group</th>

                    <th scope="col">
                        Lock Type

                    </th>

                    <th scope="col">
                        Lock / Unlock

                    </th>
                    <th scope="col">
                        User

                    </th>
                    <th scope="col">
                        Date & Time

                    </th>
                    <th scope="col">Reason / Remarks</th>
                </tr>
            </thead>
            <tbody>

                @if (Model.LockUnlock != null && Model.LockUnlock.Count > 0)
                {

                    @for (int i = 0; i < Model.LockUnlock.Count; i++)
                    {
                        <tr>

                            <td data-label="Month">@Model.LockUnlock[i].MonthName</td>
                            <td data-label="Payroll Group">
                                @Model.LockUnlock[i].PGName
                            </td>
                            <td data-label="Lock Type">
                                @Model.LockUnlock[i].LockType
                            </td>
                            <td data-label="Lock / Unlock ">
                                @Model.LockUnlock[i].Lock
                            </td>
                            <td data-label="User">
                                @Model.LockUnlock[i].User
                            </td>
                            <td data-label="Date & Time">
                                @*@Model.LockUnlock[i].Date*@
                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.LockUnlock[i].Date))
                            </td>

                            <td data-label="Reason / Remarks">
                                @Model.LockUnlock[i].Reason
                            </td>
                        </tr>
                    }
                }

            </tbody>
        </table>
    </div>