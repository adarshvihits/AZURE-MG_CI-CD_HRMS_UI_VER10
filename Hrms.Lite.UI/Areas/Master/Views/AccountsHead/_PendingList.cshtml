@model Hrms.Lite.Shared.Master.AccountsHead
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script>
    $(document).ready(function () {
        debugger;
        @*$('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");*@
        $('.pendingTabCount').html("@Model.PendingCount");



        //$('#PendingdepartmentTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');

        });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Accounts-head-pending-list">
    @Html.HiddenFor(m => m.AccountsHeadList.Count)
    <table id="PendingdepartmentTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col" data-bs-toggle="tooltip" title="Accounts Head Code">Act. Head Code</th>
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Head Type</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>

            @{


                if (Model.AccountsHeadList != null && Model.AccountsHeadList.Count > 0)
                {
                    for (int i = 0; i < Model.AccountsHeadList.Count; i++)

                    {

                        <tr>

                         
                                        <td data-label="Name">
                                            @Model.AccountsHeadList[i].AccountsHeadUserCode
                                            @Html.HiddenFor(model => Model.AccountsHeadList[i].GI)
                                            @Html.HiddenFor(model => Model.AccountsHeadList[i].LogGI)
                                            @Html.HiddenFor(model => Model.AccountsHeadList[i].Code)
                                            @Html.HiddenFor(model => Model.AccountsHeadList[i].Mode)
                                            @Html.HiddenFor(model => Model.AccountsHeadList[i].ApproveMode)
                                          
                                            @Html.HiddenFor(m => m.AccountsHeadList[i].MakerChecker)
                                        </td>

                            <td data-label="Name">@Model.AccountsHeadList[i].Name</td>
                            <td data-label="Name">@Model.AccountsHeadList[i].ShortName</td>
                            <td data-label="Name">@Model.AccountsHeadList[i].AccountsHeadCodeTypeName</td>
                            <td data-label="Name">@Model.AccountsHeadList[i].Mode</td>
                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="circleapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.AccountsHeadList[i].GI', '@Model.AccountsHeadList[i].LogGI','APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="circleapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.AccountsHeadList[i].GI', '@Model.AccountsHeadList[i].LogGI', 'APPROVAL',@i);
                                       swal.fire(MasterPersmissionMsg)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                            </td>

                        </tr>
                    }
                }


            }
        </tbody>
    </table>
</div>