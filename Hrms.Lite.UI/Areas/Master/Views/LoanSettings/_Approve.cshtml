@model Hrms.Lite.Shared.Master.LoanSettings
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "approve" }))
{
    <div id="loanapprove" class="slider-forms slider-forms-open ApprovalPending">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('ApprovalPending')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>Loan</h4>
            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Name</label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.Name)
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.ApproveMode)
                            @Html.HiddenFor(model => Model.RepaymentMethod.Name)
                            @Html.HiddenFor(model => Model.RepaymentMethod.Code)
                            @Html.HiddenFor(model => Model.AdvType )


                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Short
                            Name
                        </label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.ShortName)

                        </div>
                    </div>
                </div>

            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Company Principle
                            Amount
                        </label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.CompanyLoanAmount)

                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Maximum LImit Per Employee
                        </label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.MaximumLimitPerEmployee)

                        </div>
                    </div>
                </div>

            </div>

            <div class="row ">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Repayment Method
                        </label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.RepaymentMethod.Name)

                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Maximum Tenure
                        </label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.MaximumTenure)

                        </div>
                    </div>
                </div>


            </div>

            <div class="row ">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Active
                        </label>
                        <div class="view-details">
                            @if (Model.Active == true)
                            {

                                <button type="button" class="btn btn-icon btn-tick">
                                    <i class="icon-xl fas fa-check"></i>
                                </button>

                            }
                            else
                            {
                                <button type="button" class="btn btn-icon btn-close">
                                    <i class="icon-xl fas fa-times"></i>

                                </button>
                            }
                        </div>
                    </div>
                </div>



            </div>
            <div class="row ">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Description
                        </label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.Description)

                        </div>
                    </div>
                </div>

            </div>

            <div class="row card-footer-bottom-fixed border-none">

                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">
                        @if (CurrentUserRoleActions.Approve == true)
                        {
                            <button type="button"
                                    class="btn btn-danger  mobile-full-width" onclick="return confirmReject('@Model.GI','@Model.LogGI')">
                                Reject
                            </button>
                            <button type="button"
                                    class="btn btn-default  mobile-full-width" onclick="return confirmApprove('@Model.GI','@Model.LogGI')">
                                Approve
                            </button>
                        }
                        </div>


                </div>


            </div>
        </div>
    </div>
}