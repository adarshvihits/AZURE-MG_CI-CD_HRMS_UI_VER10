@model Hrms.Lite.Shared.Master.LoanSettings
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");



        //$('#LoanTable').DataTable({
        //    "pageLength": 25,
        //    "language":
        //    {
        //        searchPlaceholder: "Search",
        //    }
        //});
        ////$(".dataTables_filter").addClass("dataTables_filter_trn");
        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style')


        });
</script>



<div class="ihits-table table-border hover-color odd-even mobile-responsive-table loan-master-list  pt-1">
    @Html.HiddenFor(m => m.LoanSettingsList.Count)
    <table id="LoanTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Repayment Method </th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.LoanSettingsList != null && Model.LoanSettingsList.Count > 0)
                {
                    for (int i = 0; i < Model.LoanSettingsList.Count; i++)

                    {
                        <tr>
                            @Html.HiddenFor(m => m.LoanSettingsList[i].EditActive)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Description)
                            @Html.HiddenFor(model => Model.Active)

                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Name">@Model.LoanSettingsList[i].Name</td>
                            <td data-label="Short Name">@Model.LoanSettingsList[i].ShortName</td>
                            <td data-label="Repayment Method">@Model.LoanSettingsList[i].RepaymentMethod.Name</td>
                            <td data-label="Actions">

                                @if (CurrentUserRoleActions.Modify == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Edit" id="editloan"
                                       class="btn btn-icon btn-edit icon-only" onclick="onAddNewOrEditClick('MODIFY', '@Model.LoanSettingsList[i].GI','@Model.LoanSettingsList[i].LogGI',@i)">

                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Edit" id="editloan"
                                       class="btn btn-icon btn-edit icon-only" onclick="onAddNewOrEditClick('MODIFY', '@Model.LoanSettingsList[i].GI', '@Model.LoanSettingsList[i].LogGI',@i);
                                        swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#CreateOrEditSlider');});">

                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>
                                }
                                @if (CurrentUserRoleActions.Delete == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="deleteloan"
                                       class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.LoanSettingsList[i].GI', '@Model.LoanSettingsList[i].LogGI','DELETE',@i)">
                                        <i class="icon-xl far fa-trash-alt"></i>
                                    </a>
                                }
                                else
                                { 
                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="deleteloan"
                                       class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.LoanSettingsList[i].GI', '@Model.LoanSettingsList[i].LogGI', 'DELETE',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-trash-alt"></i>
                                    </a>
                                }
                                </td>
                        </tr>
                    }
                }

            }

        </tbody>
    </table>
</div>
