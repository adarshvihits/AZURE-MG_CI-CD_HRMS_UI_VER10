@model Hrms.Lite.Shared.Master.LoanSettings
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");



        //$('#Pendingloantable').DataTable({
        //    "pageLength": 25,
        //    "language":
        //    {
        //        searchPlaceholder: "Search",
        //    }
        //});
        //$(".dataTables_filter").addClass("dataTables_filter_trn");
        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style')


        });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table loan-master-pending-list pt-1">
    @Html.HiddenFor(m => m.LoanSettingsList.Count)
    <table id="Pendingloantable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Repayment Method </th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>

            @{


                if (Model.LoanSettingsList != null && Model.LoanSettingsList.Count > 0)
                {
                    for (int i = 0; i < Model.LoanSettingsList.Count; i++)

                    {

                        <tr>
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Code)
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.ApproveMode)

                            @Html.HiddenFor(m => m.LoanSettingsList[i].MakerChecker)
                            <td data-label="Name">@Model.LoanSettingsList[i].Name</td>
                            <td data-label="Short Name">@Model.LoanSettingsList[i].ShortName</td>
                            <td data-label="Repayment Method">@Model.LoanSettingsList[i].RepaymentMethod.Name </td>
                            <td data-label="Status">@Model.LoanSettingsList[i].Mode</td>
                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="loanapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.LoanSettingsList[i].GI','@Model.LoanSettingsList[i].LogGI','APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="loanapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.LoanSettingsList[i].GI', '@Model.LoanSettingsList[i].LogGI', 'APPROVAL',@i);
                                        swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }

                            </td>

                        </tr>
                    }
                }

            }
        </tbody>
    </table>
</div>
