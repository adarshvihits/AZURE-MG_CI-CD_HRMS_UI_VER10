@model Hrms.Lite.Shared.DataBank.Generic.Master.Country
@{ ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}

<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/Master/country.js?v=1"></script>

<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Country
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Country
                    </li>

                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>


<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body ">

                            <div class="mobile-tab-section">
                                <div class="row mb-2">
                                    <div class="col-12">
                                        <div class="form-group">
                                            <label>Type</label>
                                            <select class="form-control form-control-sm "
                                                    id="tabsDropdownCountry"
                                                    onchange="tabClick(this)">
                                                <option value="ACTIVE">Active</option>
                                                <option value="INACTIVE">Inactive</option>
                                                <option value="APPROVAL_PENDING">
                                                    Pending
                                                </option>

                                            </select>

                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="row tab-style-button">
                                <div class="tab-button-wrap">

                                    <div class="tab-items">
                                        @*<a href="country-master.html" class="btn-title active">
                                                Active
                                                <span class="btn-notification">025</span>
                                            </a>*@

                                        <span class="btn-title ActiveTab active" onclick="OnTabClick('ActiveTab','ACTIVE')">
                                            Active
                                            @*<span class="btn-notification AllTabCount">@Model.ActiveCount</span>*@
                                        </span>

                                    </div>
                                    <div class="tab-items medium">
                                        <span class="btn-title InActiveTab" onclick="OnTabClick('InActiveTab','INACTIVE')">
                                            Inactive
                                            @*<span class="btn-notification InActiveTabCount">@Model.InactiveCount</span>*@
                                        </span>
                                    </div>
                                    <div class="tab-items low">
                                        @*<a href="@Url.Action("Pending", "Country", new { Area = "Master" })" class="btn-title">
                                                Pending
                                                <span class="btn-notification">025</span>
                                            </a>*@

                                        <span class="btn-title PendingTab" onclick="OnTabClick('PendingTab','APPROVAL_PENDING')">
                                            Pending
                                            <span class="btn-notification pendingTabCount">@Model.PendingCount</span>
                                        </span>
                                    </div>



                                    <div class="tab-items select-option">

                                        <div class="sraech-slider">
                                            <div class="search-slider-inner">
                                                <i class="fa fa-search"></i>
                                            </div>
                                            <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                                   placeholder="ID/Name">
                                        </div>
                                        <a data-bs-toggle="tooltip" title="Export to Excel" class="btn btn-excel" onclick="ExportToExcel()">
                                            <i class="icon-xl far fa-file-excel"></i>
                                        </a>

                                    </div>


                                </div>
                            </div>
                            <div id="countryMasterlist">
                                @await Html.PartialAsync("_CountryList", Model)

                            </div>

                            <div class="row card-footer-bottom-fixed">

                                <div class="col-md-12 align-right">
                                    @if (CurrentUserRoleActions.Create == true)
                                    {

                                        <button id="addcountry" type="button"
                                                class="btn btn-default float-right mobile-full-width " onclick="onAddNewOrEditClick('Create')">
                                            Add New
                                        </button>
                                    }
                                    else
                                    { 
                                        <button id="addcountry" type="button"
                                                class="btn btn-default float-right mobile-full-width" onclick="swal.fire(MasterPersmissionMsg)">
                                            Add New
                                        </button>
                                    }
                                    </div>


                            </div>
                            <div id="AddNewCountrySlider">
                                @*@await Html.PartialAsync("_CreateOrEdit")*@

                            </div>

                            <div id="ApproveSlider">
                                @*@await Html.PartialAsync("_Approve")*@

                            </div>
                            <div id="DeleteSlider">
                                @*@await Html.PartialAsync("_Delete")*@

                            </div>
                            <!--<div id="pendingcountrylist" >-->
                            @*@await Html.PartialAsync("_PendingList")*@
                            <!--</div>-->


                        </div>

                    </div>
                </div>
            </div>
            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>





    <!--end::Entry-->
</div>
<!--end::Content-->
