
@model Hrms.Lite.Shared.DataBank.Generic.Master.Country
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");


    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table country-list pt-1">
    @Html.HiddenFor(model => Model.CountryList.Count)
    <table id="CountryTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>


            @{
                if (Model.CountryList != null && Model.CountryList.Count > 0)
                {
                    for (int i = 0; i < Model.CountryList.Count; i++)

                    {
                        <tr>

                            @Html.HiddenFor(m => m.CountryList[i].EditActive)
                            <td data-label="Name"> @Model.CountryList[i].Name</td>
                            <td data-label="Short Name">@Model.CountryList[i].ShortName</td>
                            <td data-label="Actions">
                                <div>
                                    @if (CurrentUserRoleActions.Modify == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="addcountry"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY',  '@Model.CountryList[i].GI','@Model.CountryList[i].LogGI',@i)">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="addcountry"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY', '@Model.CountryList[i].GI', '@Model.CountryList[i].LogGI',@i);
                                           swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#AddNewCountrySlider');});">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    @if (CurrentUserRoleActions.Delete == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deletecountry"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.CountryList[i].GI','@Model.CountryList[i].LogGI','DELETE',@i)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deletecountry"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.CountryList[i].GI', '@Model.CountryList[i].LogGI', 'DELETE',@i);
                                           swal.fire(MasterPersmissionMsg)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }


            }




        </tbody>
    </table>
</div>