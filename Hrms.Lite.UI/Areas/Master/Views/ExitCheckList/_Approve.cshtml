
@model Hrms.Lite.Shared.Master.ExitCheckList
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "checklistApprove" }))
{
    <div id="exitchecklistapprove" class="slider-forms slider-forms-open ApproveDiv">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('ApproveDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>Exit Checklist</h4>
            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        @Html.HiddenFor(model => Model.GI)

                        @Html.HiddenFor(model => Model.LogGI)
                        <label class="view-title">Check Item</label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.Name)
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Type
                        </label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.CheckListType.Name)
                        </div>
                    </div>
                </div>

            </div>

            <div class="row ">

                <div class="col-md-12">
                    <div class="row-outer">
                        <label class="view-title">Active</label>
                        <div class="view-details">
                            @if (Model.Active == true)
                            {

                                <button type="button" class="btn btn-icon btn-tick">
                                    <i class="icon-xl fas fa-check"></i>
                                </button>

                            }
                            else
                            {
                                <button type="button" class="btn btn-icon btn-close">
                                    <i class="icon-xl fas fa-times"></i>

                                </button>
                            }
                        </div>
                    </div>

                </div>

            </div>

            <div class="row my-3">

                <div class="col-md-12">
                    <label class="view-title">Description</label>
                    <div class="view-details">
                        @Html.DisplayFor(model => Model.Description)
                    </div>
                </div>
            </div>

            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    @if (CurrentUserRoleActions.Approve == true)
                    {
                        <a class="btn btn-danger  mobile-full-width" onclick="return confirmReject('@Model.GI','@Model.LogGI')">
                            Reject
                        </a>
                        <a class="btn btn-default  mobile-full-width" onclick="return confirmApprove('@Model.GI','@Model.LogGI')">
                            Approve
                        </a>
                    }
                    </div>


            </div>
        </div>
    </div>
}