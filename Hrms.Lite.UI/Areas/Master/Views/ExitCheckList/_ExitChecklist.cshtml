@model Hrms.Lite.Shared.Master.ExitCheckList
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>
<script>
    @*$(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");

        $('#CheckListTable').DataTable({
            "pageLength": 25,
            "language": {
                searchPlaceholder: "Search"
            }
        });


        $('.ihits-table table').removeClass("dataTable no-footer");
        $(".ihits-table table tr th").removeAttr('style');


    });*@
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table exitchecklist-master-list pt-1 ">
    @Html.HiddenFor(m => m.ExitChecklist.Count)
    <table id="CheckListTable" class="common-table dt-width-fix ">
        <thead>
            <tr class="table-dark">

                <th scope="col">Check Item</th>
                <th scope="col">Type</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.ExitChecklist != null && Model.ExitChecklist.Count > 0)
                {
                    for (int i = 0; i < Model.ExitChecklist.Count; i++)

                    {
                        <tr>
                            @Html.HiddenFor(m => m.ExitChecklist[i].EditActive)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Check Item">@Model.ExitChecklist[i].Name</td>
                            <td data-label="Type">@Model.ExitChecklist[i].CheckListType.Name</td>
                            <td data-label="Actions">
                                @if (CurrentUserRoleActions.Modify == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="editchecklist"
                                       class="btn btn-icon btn-edit icon-only  " onclick="onAddNewOrEditClick('MODIFY', '@Model.ExitChecklist[i].GI', '@Model.ExitChecklist[i].LogGI',@i)">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="editchecklist"
                                       class="btn btn-icon btn-edit icon-only  " onclick="onAddNewOrEditClick('MODIFY', '@Model.ExitChecklist[i].GI', '@Model.ExitChecklist[i].LogGI',@i);
                                       swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#AddNewOrEditSlider');});">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>
                                }
                                <!-- Edit Slider start-->
                                <!-- Edit Slider  end-->
                                <!-- delete Slider  start-->
                                @if (CurrentUserRoleActions.Delete == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="exitchecklist"
                                       class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.ExitChecklist[i].GI', '@Model.ExitChecklist[i].LogGI','DELETE',@i)">
                                        <i class="icon-xl far fa-trash-alt"></i>
                                    </a>
                                }
                                else
                                { 
                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="exitchecklist"
                                       class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.ExitChecklist[i].GI', '@Model.ExitChecklist[i].LogGI', 'DELETE',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-trash-alt"></i>
                                    </a>
                                }

                                    <!-- <end delete section></end> -->
                                </td>
                        </tr>
                    }
                }

            }

        </tbody>
    </table>
</div>