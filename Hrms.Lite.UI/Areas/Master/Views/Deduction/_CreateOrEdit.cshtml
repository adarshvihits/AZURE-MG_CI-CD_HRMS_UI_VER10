@model Hrms.Lite.Shared.DataBank.Generic.Master.Deduction
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });


</script>
@using (Html.BeginForm("Save", "Deduction", FormMethod.Post, new { id = "SaveDeduction" }))
{
    <div id="adddeduction" class="slider-forms slider-forms-open AddNewOrEditDiv">
        <div class="slider-inner-style  new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddNewOrEditDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>Deduction  </h4>
            </div>
            <div class="add-padding">
                <div class="row">

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm DName", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'DeductionName')", maxlength = "120" })
                            <span id="DeductionName"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Short Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm DShtName", @placeholder = "Short Name", @onblur = "validate(this,'DeductionShortName')", maxlength = "5" })
                            <span id="DeductionShortName"></span>
                        </div>
                    </div>
                </div>

                <div class="row my-3">

                    <div class="col-md-6">

                        <div class="form-group">
                            <label>Deduction Type</label>
                            <span class="Mandatory">*</span>
                            @*<select class="form-control form-control-sm " id="exampleSelects">
                                    <option>..Select..</option>
                                    <option>Demo</option>
                                    <option>Demo</option>
                                </select>*@
                            @Html.DropDownListFor(m => m.DeductionType.Code, (SelectList)ViewBag.DeductionType, "--Select Deduction Type--", new { @class = "form-control form-control-sm", @onblur = "validate(this,'Type')" })
                            <span id="Type"></span>
                        </div>

                    </div>
                    <div class="col-md-6">

                        <div class="form-group">
                            <label>Display Order </label>
                            <span class="Mandatory">*</span>
                            @*<input type="text"
                                class="form-control form-control-sm"
                                placeholder="Display Order">*@
                            @Html.TextBoxFor(m => m.DisplayOrder, new { @class = "form-control form-control-sm displayorder", @placeholder = "Display Order", @onblur = "validate(this,'Display')", @onkeypress = "return onlyNumberKey(event)", maxlength = "3", @oninput = "process(this)" })
                            <span id="Display"></span>
                        </div>

                    </div>
                </div>


                <div class="row my-3">


                    <div class="col-md-12 d-flex align-items-center">
                        <div class="d-flex align-items-center">
                            <div> Active</div>
                            <label class="switch" onchange="ActiveInactiveValidation('DEDUCTION','@Model.Code')">
                                @Html.CheckBoxFor(model => model.Active, new { @id = "Activeinactivededuction" })
                                <span class="slider round"></span>
                            </label>
                        </div>
                    </div>


                </div>



                <div class="row my-3">

                    <div class="col-md-12">

                        @if (Model.Mode == "CREATE")
                        {
                            <label>Description</label>
                            @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm DDescription", @placeholder = "Description", maxlength = "250" })

                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            <label class="view-title">Description</label>
                            <div class="view-details">

                                @Html.DisplayFor(Model => Model.Description)
                                @Html.HiddenFor(model => Model.Description)
                            </div>
                        }
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">
                        @if (Model.Mode == "CREATE")
                        {

                            @if (CurrentUserRoleActions.Create == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="onSaveDeductionClick('Save')">
                                    Save
                                </button>
                            }
                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            @if (CurrentUserRoleActions.Modify == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="onSaveDeductionClick('Modify')">
                                    Modify
                                </button>
                            }
                        }
                        </div>

                </div>
            </div>
        </div>
    </div>
}