@model Hrms.Lite.Shared.Master.EvaluationPeriodMaster
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/bootstrap-datepicker.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });


</script>
@using (Html.BeginForm("EvaluationPeriodSave", "EvaluationPeriod", FormMethod.Post, new { @id = "epsave" }))
{
    <div id="addNewEvaluationMaster" class="slider-forms slider-forms-open evaluationSaveclose">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('evaluationSaveclose')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>
                Evaluation Period
            </h4>
            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Name</label>
                        @Html.HiddenFor(model => Model.Mode)
                        @Html.HiddenFor(model => Model.LogGI)
                        @Html.HiddenFor(model => Model.GI)
                        @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'epName')", @maxlength = 120 })
                        <span id="epName"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Short Name</label>
                        @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm", @placeholder = "Short Name", @onblur = "validate(this,'epShortName')", @maxlength = 5 })
                        <span id="epShortName"></span>
                    </div>
                </div>
            </div>

            <div class="row">

                <div class="col-md-4">
                    <div class="form-group">
                        <label>From</label>
                        <div class="input-group date">
                            @Html.TextBoxFor(Model => Model.From, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2 fromdp", @readonly = "true", @placeholder = "From", @onchange = "validate(this,'epFrom')" })
                            <div class="input-group-append">
                                <span class="input-group-text">
                                    <i class="la la-calendar"></i>
                                </span>
                            </div>
                        </div>
                        <span id="epFrom"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>To</label>
                        <div class="input-group date">
                            @Html.TextBoxFor(Model => Model.To, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2 todp", @readonly = "true", @placeholder = "To", @onchange = "validate(this,'epTo')" })
                            <div class="input-group-append">
                                <span class="input-group-text">
                                    <i class="la la-calendar"></i>
                                </span>
                            </div>
                        </div>
                        <span id="epTo"></span>
                    </div>
                </div>
                <div class="col-md-4 mt-5 d-flex align-items-center">
                    <div class="d-flex align-items-center">
                        <div> Active</div>
                        <label class="switch" onclick="ActiveInactiveValidationEvalution('EVALPERIOD',@Model.Code)">
                            @Html.CheckBoxFor(model => model.Active,new { @id="evaluationStatus"})
                            <span class="slider round"></span>
                        </label>
                    </div>
                </div>
            </div>




            <div class="row my-3">

                <div class="col-md-12">
                    @if (Model.Mode == "Create")
                    {
                        <label>Description</label>
                        @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm desEv", @placeholder = "Description", @onchange = "validate(this,'assetDescription')", @maxlength = 250 })
                        @Html.HiddenFor(model => Model.Description)
                    }
                    @if (Model.Mode == "MODIFY")
                    {
                        <label class="view-title">Description</label>
                        <div class="view-details">

                            @Html.DisplayFor(Model => Model.Description)
                            @Html.HiddenFor(model => Model.Description)
                        </div>
                    }
                </div>
            </div>

            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    @if (Model.Mode == "Create")
                    {

                        @if (CurrentUserRoleActions.Create == true)
                        {
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="validateAllEvaluationPeriodSave('@Model.GI','Save')">
                                Save
                            </button>
                        }
                    }
                    @if (Model.Mode == "MODIFY")
                    {
                        @if (CurrentUserRoleActions.Modify == true)
                        {
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="validateAllEvaluationPeriodSave('@Model.GI','Modify')">
                                Modify
                            </button>
                        }
                    }
                    </div>

            </div>
        </div>
    </div>
}