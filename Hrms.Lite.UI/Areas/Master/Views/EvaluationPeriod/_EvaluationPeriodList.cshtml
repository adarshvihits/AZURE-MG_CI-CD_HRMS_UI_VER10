@model Hrms.Lite.Shared.Master.EvaluationPeriodMaster
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");

        //$('#EvaluationMasterTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');

    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table appraisal-master-list pt-1">
    @Html.HiddenFor(m => m.EvaluationPeriodMasterList.Count)
    <table id="EvaluationMasterTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.EvaluationPeriodMasterList != null && Model.EvaluationPeriodMasterList.Count > 0)
                {
                    for (int i = 0; i < Model.EvaluationPeriodMasterList.Count; i++)

                    {
                        <tr>
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(m => m.EvaluationPeriodMasterList[i].EditActive)
                            <td data-label="Name">@Model.EvaluationPeriodMasterList[i].Name</td>
                            <td data-label="Short Name">@Model.EvaluationPeriodMasterList[i].ShortName</td>
                            <td data-label="Actions">
                                <div>
                                    @if (CurrentUserRoleActions.Modify == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="addNewEvaluationMaster"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddOrEditClick('MODIFY', '@Model.EvaluationPeriodMasterList[i].GI', '@Model.EvaluationPeriodMasterList[i].LogGI',@i)">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="addNewEvaluationMaster"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddOrEditClick('MODIFY', '@Model.EvaluationPeriodMasterList[i].GI', '@Model.EvaluationPeriodMasterList[i].LogGI',@i);
                                           swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#newRequestSlider');});">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    <!-- delete Slider  start-->
                                    @if (CurrentUserRoleActions.Delete == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="id=EvaluationPerioddelete"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.EvaluationPeriodMasterList[i].GI', '@Model.EvaluationPeriodMasterList[i].LogGI', 'DELETE',@i)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                    else
                                    { 
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="id=EvaluationPerioddelete"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.EvaluationPeriodMasterList[i].GI', '@Model.EvaluationPeriodMasterList[i].LogGI', 'DELETE',@i);
                                           swal.fire(MasterPersmissionMsg);">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                    </div>
                                <!-- <end delete section></end> -->
                            </td>
                        </tr>
                    }
                }


            }
        </tbody>
    </table>
</div>