@model Hrms.Lite.Shared.Master.HolidayGroup
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}

<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.PendingTabCount').html("@Model.PendingCount");

        //$('#HolidayGroupTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');


    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table holidaygroup-master-list p-1">
    @Html.HiddenFor(m => m.HolidayGroupList.Count)
    <table id="HolidayGroupTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.HolidayGroupList != null && Model.HolidayGroupList.Count > 0)
                {
                    for (int i = 0; i < Model.HolidayGroupList.Count; i++)

                    {
                        <tr>
                            @Html.HiddenFor(m => m.HolidayGroupList[i].EditActive)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Name">@Model.HolidayGroupList[i].Name</td>
                            <td data-label="ShortName">@Model.HolidayGroupList[i].ShortName</td>
                            <td data-label="Actions">
                                <div>
                                    @if (CurrentUserRoleActions.Modify == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="editholidayoffday"
                                           class="btn btn-icon btn-edit icon-only" onclick="onAddNewOrEditClick('MODIFY', '@Model.HolidayGroupList[i].GI', '@Model.HolidayGroupList[i].LogGI',@i)">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="editholidayoffday"
                                           class="btn btn-icon btn-edit icon-only" onclick="onAddNewOrEditClick('MODIFY', '@Model.HolidayGroupList[i].GI', '@Model.HolidayGroupList[i].LogGI',@i);
                                           swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#AddNewOrEditSlider');});">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    @if (CurrentUserRoleActions.Delete == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deleteholidayoffday"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.HolidayGroupList[i].GI', '@Model.HolidayGroupList[i].LogGI','DELETE',@i)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                    else
                                    { 
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deleteholidayoffday"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.HolidayGroupList[i].GI', '@Model.HolidayGroupList[i].LogGI', 'DELETE',@i);
                                           swal.fire(MasterPersmissionMsg);">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                    </div>

                            </td>
                        </tr>
                    }
                }

            }

        </tbody>
    </table>
</div>