@model Hrms.Lite.Shared.Master.HolidayGroup
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}

<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });


</script>

@using (Html.BeginForm("Save", "HolidayGroup", FormMethod.Post, new { id = "holidayGroupsave" }))
{
    <div id="addholidayoffday" class="slider-forms slider-forms-open AddNewDiv">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddNewDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>
                Holiday Group
            </h4>
            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Name
                            <span class="Mandatory">*</span>
                        </label>
                        @Html.HiddenFor(model => Model.Mode)
                        @Html.HiddenFor(model => Model.LogGI)
                        @Html.HiddenFor(model => Model.GI)
                        @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm HolidayName", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'HolidayGroupName')", maxlength = "120" })
                        <span id="HolidayGroupName"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Short Name<span class="Mandatory">*</span>
                        </label>
                        @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm HolidayShtName", @placeholder = "Short Name", @onblur = "validate(this,'HolidayGroupShortName')", maxlength = "5" })
                        <span id="HolidayGroupShortName"></span>
                    </div>
                </div>
            </div>



            <div class="row my-3">


                <div class="col-md-12 d-flex align-items-center">
                    <div class="d-flex align-items-center">
                        <div> Active</div>
                        <label class="switch" onchange="ActiveInactiveValidation('HOLIDAY GROUP','@Model.Code')">
                            @Html.HiddenFor(m => Model.Code)
                            @Html.CheckBoxFor(model => model.Active, new { @id = "Activeinactiveholdatgroup" })
                            <span class="slider round"></span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="row my-3">

                <div class="col-md-12">


                    @if (Model.Mode == "CREATE")
                    {
                        <label>Description</label>
                        @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm HDescription", @placeholder = "Description", maxlength = "250" })

                    }
                    @if (Model.Mode == "MODIFY")
                    {
                        <label class="view-title">Description</label>
                        <div class="view-details">

                            @Html.DisplayFor(Model => Model.Description)
                            @Html.HiddenFor(model => Model.Description)
                        </div>
                    }
                </div>
            </div>

            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    @if (Model.Mode == "CREATE")
                    {
                        @if (CurrentUserRoleActions.Create == true)
                        {
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="HolidayGroupSave('Save')">
                                Save
                            </button>
                        }
                    }
                    @if (Model.Mode == "MODIFY")
                    {
                        @if (CurrentUserRoleActions.Modify == true)
                        {
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="HolidayGroupSave('Modify')">
                                Modify
                            </button>
                        }
                    }
                    </div>

            </div>
        </div>
    </div>
}