@model Hrms.Lite.Shared.Master.Faq

@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });
</script>
@using (Html.BeginForm("Save", "Faq", FormMethod.Post, new { id = "FaqSave" }))
{
    <div id="addregion" class="slider-forms slider-forms-open FaqSaveclose">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('FaqSaveclose')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>
                    Faq
                </h4>
            </div>
            <div class="add-padding">
                <div class="row">

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Software
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.GI)


                            <div class="form-group filter-combobox mt-0">
                                @Html.DropDownListFor(m => m.SoftwareCode, (SelectList)ViewBag.FaqCode, "--Select--", new { @class = "form-control form-control-sm" })

                            </div>
                            @*<span id="RegionName" class="error-message is-invalid"></span>*@
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Faq Category
                                <span class="Mandatory">*</span>
                            </label>
                            <div class="form-group filter-combobox mt-0">
                                @Html.DropDownListFor(m => m.FaqCategoryCode, (SelectList)ViewBag.FaqCategCode, "--Select--", new { @class = "form-control form-control-sm" })

                            </div>
                        </div>
                    </div>
                </div>
                @*/////////////*@
                <div class="row">

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Question
                                <span class="Mandatory">*</span>
                            </label>



                            @Html.TextAreaFor(Model => Model.Question, new { @class = "form-control form-control-sm", @placeholder = "Description", maxlength = "250" })

                            @*<span id="RegionName" class="error-message is-invalid"></span>*@
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Answer
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.TextAreaFor(Model => Model.Answer, new { @class = "form-control form-control-sm", @placeholder = "Description", maxlength = "250" })

                        </div>
                    </div>
                </div>
                @*///////////////*@







                <div class="row my-3">


                    <div class="col-md-12 d-flex align-items-center">
                        <div class="d-flex align-items-center">

                            <div> Active</div>
                            <label class="switch" onchange="ActiveInactiveValidation('REGION','@Model.Code')">

                                @Html.CheckBoxFor(model => model.Active, new { @id = "Activeinactivereg" })
                                <span class="slider round"></span>
                            </label>
                        </div>
                    </div>


                </div>



                @*<div class="row my-3">

                    <div class="col-md-12">
                        @if (Model.Mode == "Create")
                        {
                            <label>Description</label>
                            @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm", @placeholder = "Description", maxlength = "250" })
                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            <label class="view-title">Description</label>
                            <div class="view-details">
                                @Html.HiddenFor(model => Model.Description)
                                @Html.DisplayFor(Model => Model.Description)
                            </div>
                        }
                    </div>
                </div>*@

                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">
                        @if (Model.Mode == "Create")
                        {
                            @if (CurrentUserRoleActions.Create == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="SaveFaq('Save')">
                                    Save
                                </button>
                            }
                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            @if (CurrentUserRoleActions.Modify == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="SaveFaq('Modify')">
                                    Modify
                                </button>
                            }
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
}
