@model Hrms.Lite.Shared.Master.AttendanceRequestReason
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");
        });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table attendance-requestpending pt-1">
    @Html.HiddenFor(model => Model.RequestReason.Count)
    <table id="PendingAttendanceRequestReasonTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Reason</th>
                <th scope="col">Applicable Request</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>
            @{


                if (Model.RequestReason != null && Model.RequestReason.Count > 0)
                {
                    for (int i = 0; i < Model.RequestReason.Count; i++)

                    {
                        <tr>
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.ApproveMode)
                            @Html.HiddenFor(m => m.RequestReason[i].MakerChecker)
                            <td data-label="Reason">@Model.RequestReason[i].Name</td>
                            <td data-label="Applicable Request">@Model.RequestReason[i].ApplicableRequest</td>

                            <td data-label="Status">@Model.RequestReason[i].Mode</td>
                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="attendancerequestapprove" type="button"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.RequestReason[i].ReasonGI', '@Model.RequestReason[i].LogGI', 'APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                { 
                                
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="attendancerequestapprove" type="button"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.RequestReason[i].ReasonGI', '@Model.RequestReason[i].LogGI', 'APPROVAL',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                </td>
                            <!-- <second></second> -->
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>