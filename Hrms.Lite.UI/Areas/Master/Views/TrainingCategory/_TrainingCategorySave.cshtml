@model Hrms.Lite.Shared.Master.TrainingCategory
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });
</script>
@using (Html.BeginForm("Save", "TrainingCategory", FormMethod.Post, new { id = "trainingCategorySave" }))
{
    <div id="addregion" class="slider-forms slider-forms-open trainingCategorySaveclose">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('trainingCategorySaveclose')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>
                    Training Category
                </h4>
            </div>
            <div class="add-padding">
                <div class="row">

                    <div class="col-md-12">
                        <div class="form-group">
                            <label>
                                Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm TCName", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'RegionName')", maxlength = "120" })
                            <span id="TCategoryName"></span>
                            @*<span id="RegionName" class="error-message is-invalid"></span>*@
                        </div>
                    </div>
                   
                </div>



                <div class="row my-3">

                    @*<div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Short Name
                           
                            </label>
                            @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm TCShortName", @placeholder = "Short Name", @onblur = "validate(this,'RegionShortName')", maxlength = "5" })
                            <span id="TCategoryShortName"></span>
                        </div>
                    </div>*@
                    <div class="col-md-6 d-flex align-items-center">
                        <div class="d-flex align-items-center">

                            <div> Active</div>
                            <label class="switch" onchange="ActiveInactiveValidation('TRAININGCATEGORY','@Model.Code')">

                                @Html.CheckBoxFor(model => model.Active, new { @id = "Activeinactivereg" })
                                <span class="slider round"></span>
                            </label>
                        </div>
                    </div>


                </div>



                <div class="row my-3">

                    <div class="col-md-12">
                        @if (Model.Mode == "Create")
                        {
                            <label>Description</label>
                            @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm", @placeholder = "Description", maxlength = "250" })
                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            <label class="view-title">Description</label>
                            <div class="view-details">
                                @Html.HiddenFor(model => Model.Description)
                                @Html.DisplayFor(Model => Model.Description)
                            </div>
                        }
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">
                        @if (Model.Mode == "Create")
                        {
                            @if (CurrentUserRoleActions.Create == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="SaveTrainingCategory('Save')">
                                    Save
                                </button>
                            }
                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            @if (CurrentUserRoleActions.Modify == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="SaveTrainingCategory('Modify')">
                                    Modify
                                </button>
                            }
                        }
                        </div>

                </div>
            </div>
        </div>
    </div>
}