@model Hrms.Lite.Shared.Master.Asset
@*<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>*@
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
@*<link href="~/css/custom.css" rel="stylesheet" />*@

<script>
    debugger;

     $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
         $('.pendingTabCount').html("@Model.PendingCount");
    });
</script>

<div class="ihits-table table-border  odd-even mobile-responsive-table asset-master-list-pending pt-1">
    <table id="AssetMasterPendingTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Category</th>
                <th scope="col">Code</th>
                <th scope="col">Entry type</th>
                <th scope="col">Approve</th>

            </tr>
        </thead>
        <tbody>
            @{

                if (Model.AssetList != null && Model.AssetList.Count > 0)
                {

                    for (int i = 0; i < Model.AssetList.Count; i++)

                    {

                        <tr>
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Name">
                                @Model.AssetList[i].Name
                                @Html.HiddenFor(m => m.AssetList[i].MakerChecker)
                            </td>
                            <td data-label="Short Name">@Model.AssetList[i].ShortName</td>
                            <td data-label="Category">@Model.AssetList[i].AssetCategory.Name</td>
                            <td data-label="Code">@Model.AssetList[i].AssetCode</td>

                            <td data-label="Entry type">@Model.AssetList[i].EntryType</td>
                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="addNewAssetsMasterApprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.AssetList[i].GI', '@Model.AssetList[i].LogGI', 'APPROVAL', @i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                { 
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="addNewAssetsMasterApprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.AssetList[i].GI', '@Model.AssetList[i].LogGI', 'APPROVAL', @i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                </td>

                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>