@using (Html.BeginForm("Create", "AssetMaster", FormMethod.Post, new { @id = "assetSave" }))
{
    <div id="addAssetMaster" class="slider-forms slider-forms-open assetSaveclose">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('assetSaveclose')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>Asset</h4>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Name
                            <span class="Mandatory">*</span>
                        </label>
                        @Html.HiddenFor(model => Model.Mode)
                        @Html.HiddenFor(model => Model.LogGI)
                        @Html.HiddenFor(model => Model.GI, new { @class = "assetgi" })
                        @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm AsName", @placeholder = "Name", @onblur = "OnlyOnlycapitalizeFirstLetter(this,'fullname')", @onchange = "validate(this,'AssetName')", maxlength = "120" })
                        <span id="AssetName"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Short Name
                            <span class="Mandatory">*</span>
                        </label>
                        @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm AsShort", @placeholder = "Short Name", @onchange = "validate(this,'AssetShortName')", maxlength = "20" })
                        <span id="AssetShortName"></span>
                    </div>
                </div>


            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Category
                            <span class="Mandatory">*</span>
                        </label>
                        @Html.DropDownListFor(Model => Model.AssetCategory.Code, (SelectList)ViewBag.Asc, "--Select Category--", new { @class = "form-control form-control-sm AsCat", @onblur = "validate(this,'AssetCategory')" })
                        <span id="AssetCategory" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Asset Code
                            <span class="Mandatory">*</span>
                        </label>


                        @Html.TextBoxFor(Model => Model.AssetCode, new { @class = "form-control form-control-sm Ascode", @placeholder = "Asset Code", @onchange = "validate(this,'AssetCod')", @onblur = "firstLetterCaps(this,'fullname')", maxlength = "10" })
                        <span id="AssetCod" class="text-danger"></span>
                    </div>
                </div>

            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Date of Purchase
                            <span class="Mandatory">*</span>
                        </label>
                        <div class="input-group date">
                            @Html.TextBoxFor(Model => Model.DateOfPurchase, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2 dop", @readonly = "true", @placeholder = "Date of Purchase", @onchange = "validate(this,'DOP')", @id = "dopp" })

                            @*@Html.TextBoxFor(Model => Model.DateOfPurchase, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2 dop", @readonly = "true", @placeholder = "Date of Purchase", @onchange = "validate(this,'DOP')", @id = "dopp" })*@

                            <div class="input-group-append">
                                <span class="input-group-text">
                                    <i class="la la-calendar"></i>
                                </span>
                            </div>
                        </div>

                    </div>
                    <span id="DOP"></span>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Brand
                            <span class="Mandatory">*</span>
                        </label>
                        @Html.TextBoxFor(Model => Model.Brand, new { @class = "form-control form-control-sm AsBrand", @placeholder = "Brand", @onchange = "validate(this,'AsBrand')", @onblur = "firstLetterCaps(this,'fullname')", @maxlength = 120 })
                        <span id="AsBrand" class="text-danger"></span>
                    </div>
                </div>


            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Model No / Serial No
                            <span class="Mandatory">*</span>
                        </label>
                        @Html.TextBoxFor(Model => Model.ModelNo, new { @class = "form-control form-control-sm Asmodelno", @placeholder = "Model No/Serial No", @onchange = "validate(this,'modelno')", @onblur = "firstLetterCaps(this,'fullname')", maxlength = "120" })
                        <span id="modelno" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Asset Cost
                            <span class="Mandatory">*</span>
                        </label>
                        @Html.TextBoxFor(Model => Model.Cost, new { @class = "form-control form-control-sm Asscost", @placeholder = " Asset Cost", @onchange = "validate(this,'Ascost')", @onblur = "firstLetterCaps(this,'fullname')", @onkeypress = "return onlyNumberKey(event)", maxlength = "8", @oninput = "process(this)" })
                        <span id="Ascost" class="text-danger"></span>
                    </div>
                </div>


            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Issuing Department
                            <span class="Mandatory">*</span>
                        </label>
                        @Html.DropDownListFor(Model => Model.IssuingDepartment.Code, (SelectList)ViewBag.Asd, "--Select Department--", new { @class = "form-control form-control-sm Asdepart", @onblur = "validate(this,'assetdepartment')" })
                        <span id="assetdepartment" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Condition
                            <span class="Mandatory">*</span>
                        </label>
                        @Html.DropDownListFor(Model => Model.Condition.Code, (SelectList)ViewBag.Aco, "--Select Condition--", new { @class = "form-control form-control-sm Ascondition", @onblur = "validate(this,'assetcondition')" })
                        <span id="assetcondition" class="text-danger"></span>
                    </div>
                </div>

            </div>
            <div class="row my-3">
                <div class="col-md-12">
                    <div class="d-flex align-items-center">
                        <div> Active</div>
                        <label class="switch" onchange="ActiveInactiveValidationAsset('ASSET',@Model.Code)">
                            @Html.CheckBoxFor(model => model.Active,new { @id="asset"})
                            @*@Html.CheckBoxFor(model => model.Active, true)*@
                            @*@Html.CheckBoxFor(model => model.Active,new { @checked = "checked" })*@
                            <span class="slider round"></span>

                        </label>
                    </div>
                </div>
            </div>
            <div class="row my-3">

                <div class="col-md-12">

                    @if (Model.Mode == "Create")
                    {
                        <label>Description</label>
                        @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm Asdesc", @placeholder = "Description", @onchange = "validate(this,'assetDescription')", maxlength = "250" })
                        <span id="assetDescription" class="text-danger"></span>
                    }
                    @if (Model.Mode == "MODIFY")
                    {
                        <label class="view-title">Description</label>
                        <div class="view-details">

                            @Html.DisplayFor(Model => Model.Description)
                            @Html.HiddenFor(model => Model.Description)
                        </div>
                    }
                </div>
            </div>
            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    @if (Model.Mode == "Create")
                    {
                        @if (CurrentUserRoleActions.Create == true)
                        {
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="assetSave('Save')">
                                Save
                            </button>
                        }
                    }
                    @if (Model.Mode == "MODIFY")
                    {
                        @if (CurrentUserRoleActions.Modify == true)
                        {
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="assetSave('Modify')">
                                Modify
                            </button>
                        }
                    }

                    </div>

            </div>
        </div>
    </div>

}