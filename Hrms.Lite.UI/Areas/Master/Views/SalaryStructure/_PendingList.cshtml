@model Hrms.Lite.Shared.Master.SalaryStructureMaster
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}

<script src="~/js/settings.js"></script>
<script src="~/js/tooltip.js"></script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table salary-pending-list  pt-1">
    @Html.HiddenFor(m => m.List.Count)
    <table id="salryStructurePendingTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Type</th>
                <th scope="col">Wage Type</th>
                <th scope="col">Wage Grade</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.List != null && Model.List.Count > 0)
            {

                for (int i = 0; i < Model.List.Count; i++)
                {
            <tr>
                @Html.HiddenFor(m => m.List[i].GI)
                @Html.HiddenFor(m => m.List[i].LogGI)
                @Html.HiddenFor(m => m.List[i].MakerChecker)

                <td data-label=" Name">@Model.List[i].Name</td>
                <td data-label=" Type">@Model.List[i].SalaryStructureType.Name</td>
                <td data-label="Wage Type">@Model.List[i].WageType.Name</td>
                <td data-label="Wage Grade">@Model.List[i].WageGrade.Name</td>

                <td data-label="Status">@Model.List[i].ApprovalStatus</td>
                <td data-label="Approve">
                    @if (CurrentUserRoleActions.Approve == true)
                    {
                        <a data-bs-toggle="tooltip" title="Approve"
                           id="interviewapprove" type="button"
                           class="btn btn-icon btn-tick icon-only" onclick="onApproveClick('@Model.List[i].GI','@Model.List[i].LogGI',@i)">
                            <i class="icon-xl far fa-check-circle"></i>
                        </a>
                    }
                    else
                    {
                        <a data-bs-toggle="tooltip" title="Approve"
                           id="interviewapprove" type="button"
                           class="btn btn-icon btn-tick icon-only" onclick="swal.fire(MasterPersmissionMsg).then(function () { onApproveClick('@Model.List[i].GI','@Model.List[i].LogGI',@i)});">
                            <i class="icon-xl far fa-check-circle"></i>
                        </a>
                    }
                    <!-- Approve Slider -->
                    <!-- Approve Slider end-->
                </td>
                <!-- <second></second> -->
            </tr>
                }
            }
        </tbody>
    </table>
</div>