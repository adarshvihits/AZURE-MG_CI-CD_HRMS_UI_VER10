@model Hrms.Lite.Shared.Master.SalaryStructureMaster
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/scripts/Master/salaryStructure.js"></script>
<script src="~/js/settings.js"></script>
<script src="~/js/tooltip.js"></script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table salary-structure-list">
    @Html.HiddenFor(m => m.List.Count)
    <table id="salryStructureListTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Type</th>
                <th scope="col">Wage Type</th>
                <th scope="col">Wage Grade</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.List != null && Model.List.Count > 0)
            {

                for (int i = 0; i < Model.List.Count; i++)
                {
            <tr>
                @Html.HiddenFor(m => m.List[i].GI)
                @Html.HiddenFor(m => m.List[i].LogGI)
                @Html.HiddenFor(m => m.List[i].MakerChecker)
                @Html.HiddenFor(m => m.List[i].EditActive)

                <td data-label="Name">@Model.List[i].Name</td>
                <td data-label="Type">@Model.List[i].SalaryStructureType.Name</td>
                <td data-label="Wage Type ">@Model.List[i].WageType.Name</td>
                <td data-label="Wage Grade ">@Model.List[i].WageGrade.Name</td>
                <td data-label="Actions">

                    @if (CurrentUserRoleActions.Create == true)
                    {
                        <a data-bs-toggle="tooltip" title="Edit"
                           id="" type="button"
                           class="btn btn-icon btn-edit icon-only" onclick="onEditClick('@Model.List[i].GI','@Model.List[i].LogGI',@i)">
                            <i class="icon-xl fas fa-pencil-alt"></i>
                        </a>
                    }
                    else
                    {
                        <a data-bs-toggle="tooltip" title="Edit"
                           id="" type="button"
                           class="btn btn-icon btn-edit icon-only" onclick="swal.fire(MasterPersmissionMsg).then(function () {
                                    onEditClick('@Model.List[i].GI', '@Model.List[i].LogGI',@i);
                                    });">
                            <i class="icon-xl fas fa-pencil-alt"></i>
                        </a>
                    }
                    <!-- Edit Slider start-->
                    <!-- Edit Slider  end-->
                    <!-- delete Slider  start-->
                    @if (CurrentUserRoleActions.Delete == true)
                    {
                        <a data-bs-toggle="tooltip" title="Delete"
                           id="" type="button"
                           class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.List[i].GI','@Model.List[i].LogGI',@i)">
                            <i class="icon-xl far fa-trash-alt"></i>
                        </a>
                    }
                    else
                    {
                        <a data-bs-toggle="tooltip" title="Delete"
                           id="" type="button"
                           class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="swal.fire(MasterPersmissionMsg).then(function () { onDeleteClick('@Model.List[i].GI', '@Model.List[i].LogGI',@i);});">
                            <i class="icon-xl far fa-trash-alt"></i>
                        </a>
                    }

                    <!-- <end delete section></end> -->
                </td>
            </tr>
                }
            }

        </tbody>
    </table>
</div>