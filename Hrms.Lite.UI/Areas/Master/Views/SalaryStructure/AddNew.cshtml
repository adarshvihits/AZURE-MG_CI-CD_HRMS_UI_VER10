                                                                </div>
                                                                <span id="SCCANonMetro"></span>
                                                            </div>
                                                        </div>
                                                        <div class="row my-3">
                                                            <div class="col-md-4">
                                                                <label>CCA For Kerala</label>
                                                            </div>
                                                            <div class="col-md-4">
                                                                <div class="form-group">

                                                                    @Html.TextBoxFor(m => m.CCAKerala, new
                                                               {
                                                                   @class = "form-control form-control-sm Fdpercent",
                                                                   @placeholder = "%",
                                                                   @maxlength = 8,
                                                                   @onkeypress = "return onlyAmount(event);"
                                                               })
                                                                </div>
                                                                <span id="SCCAKerala"></span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>


                                            </div>

                                        </div>
                                        <div class="tab-pane" id="tabs-6" role="tabpanel">
                                            <div class="row">
                                                <div class="col-md-12">
                                                    <div class="ihits-table table-border  mobile-responsive-table salary-structure-tab vertical-scroll-150">
                                                        <table>
                                                            <thead>
                                                                <tr class="table-light">
                                                                    <th scope="col">
                                                                       Group Company
                                                                    </th>
                                                                    <th scope="col" id="AssuredAmt">ASD Bonus(% of Gross)</th>
                                                                    <th scope="col" id="BlokedAmt">ASDB Blocked(in Amt)</th>

                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @if (Model.AssuredBonous != null && Model.AssuredBonous.Count > 0)
                                                                {

                                                                    for (int i = 0; i < Model.AssuredBonous.Count; i++)
                                                                    {
                                                                <tr>
                                                                    <td data-label="Group Company">@Html.HiddenFor(m => m.AssuredBonous[i].Code)@Model.AssuredBonous[i].Name</td>

                                                                    <td data-label="ASD Bonus(% of Gross)">
                                                                        @Html.TextBoxFor(m => m.AssuredBonous[i].AssuredAmt, new { @class = "form-control form-control-sm", @placeholder = "Amount", @maxlength = 8, @onkeypress = "return onlyAmount(event)" })
                                                                    </td>

                                                                    <td data-label="ASDB Blocked(in Amt)">
                                                                        @Html.TextBoxFor(m => m.AssuredBonous[i].BlokedAmt, new { @class = "form-control form-control-sm", @placeholder = "Amount", @maxlength = 8, @onkeypress = "return onlyAmount(event)" })
                                                                    </td>

                                                                </tr>
                                                                    }
                                                                }




                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                    </div>


                                </div>



                            </div>
                        </div>

                        <!--end: Datatable-->
                        <div class="row my-3">
                            <div class="col-md-6">
                                <label>Description</label>
                                @*<textarea class="form-control form-control-sm"
                placeholder="Description"></textarea>*@
                                @Html.TextAreaFor(m => m.Description, new { @class = "form-control form-control-sm", @placeholder = "Description" })
                            </div>

                        </div>
                    </div>
                    <div class="row card-footer-bottom-fixed">

                        <div class="col-md-12 align-right">
                            @if (CurrentUserRoleActions.Create == true)
                            {
                                <button id="addskilltype" type="button"
                                        class="btn btn-default float-right mobile-full-width " onclick="SaveSalaryStructure('Save',@Model.FixedAllowance.Count)">
                                    Save

                                </button>
                            }

                            </div>

                    </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>


    </div>
    <!--end::Wrapper-->

