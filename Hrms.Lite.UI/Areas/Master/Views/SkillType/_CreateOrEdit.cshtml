@model Hrms.Lite.Shared.DataBank.Generic.Master.SkillType
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });
</script>
@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "SkillTypeSave" }))

{


    <div id="addskilltype" class="slider-forms slider-forms-open AddNewOrEdit">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddNewOrEdit')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>
                Skill Type
            </h4>
            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Name</label>
                        <span class="Mandatory">*</span>
                        @Html.HiddenFor(model => Model.Mode)
                        @Html.HiddenFor(model => Model.GI)
                        @Html.HiddenFor(model => Model.LogGI)
                        @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm STName", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'skillname')", @maxlength = 120 })
                        <span id="skillname"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Short Name</label>
                        <span class="Mandatory">*</span>
                        @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm STShtName", @placeholder = "Short Name", @onblur = "validate(this,'skillShort')", @maxlength = 5 })
                        <span id="skillShort"></span>
                    </div>
                </div>
            </div>
            <!-- <div class="row my-3">

                <div class="col-md-6">

                        <div class="form-group">
                            <label>Deduction Type</label>
                            <select class="form-control form-control-sm " id="exampleSelects">
                                <option>..Select..</option>
                                <option>Demo</option>
                                <option>Demo</option>
                            </select>
                        </div>

                </div>
                <div class="col-md-6">

                    <div class="form-group">
                        <label>Display Order </label>
                        <input type="text"
                            class="form-control form-control-sm"
                            placeholder="Display Order">
                    </div>

            </div>
            </div> -->



            <div class="row my-3">


                <div class="col-md-12 d-flex align-items-center">
                    <div class="d-flex align-items-center">
                        <div>Active</div>
                        <label class="switch" onchange="ActiveInactiveValidationSkillType('SKILL TYPE', '@Model.Code')">
                            @Html.HiddenFor(m=>Model.Code)
                            @Html.CheckBoxFor(model => model.Active,new { @id="skilltype"})
                            <span class="slider round"></span>
                        </label>
                    </div>
                </div>

            </div>



            <div class="row my-3">

                <div class="col-md-12">
                    <label>Description</label>
                    @if (Model.Mode == "CREATE")
                    {

                        @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm STDescription", @placeholder = "Description", @maxlength = 250 })

                    }
                    @if (Model.Mode == "MODIFY")
                    {

                        <div class="view-details">

                            @Html.DisplayFor(Model => Model.Description)
                            @Html.HiddenFor(model => Model.Description)
                        </div>
                    }
                </div>
            </div>

            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    @if (Model.Mode == "CREATE")
                    {
                        @if (CurrentUserRoleActions.Create == true)
                        {
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="SkillTypeSave('Save')">
                                Save
                            </button>
                        }
                    }
                    @if (Model.Mode == "MODIFY")
                    {
                        @if (CurrentUserRoleActions.Modify == true)
                        {
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="SkillTypeSave('Modify')">
                                Modify
                            </button>
                        }
                    }
                    </div>

            </div>
        </div>
    </div>
}