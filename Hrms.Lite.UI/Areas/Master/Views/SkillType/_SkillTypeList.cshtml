@model Hrms.Lite.Shared.DataBank.Generic.Master.SkillType
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>



<div class="ihits-table table-border hover-color odd-even mobile-responsive-table skilltype-master-list pt-1 ">
    @Html.HiddenFor(m => m.SkillTypeList.Count)
    <table id="skilltypeTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>

            @{
                if (Model.SkillTypeList != null && Model.SkillTypeList.Count > 0)
                {
                    for (int i = 0; i < Model.SkillTypeList.Count; i++)

                    {
                        <tr>
                            @Html.HiddenFor(m => m.SkillTypeList[i].EditActive)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Active)

                            <td data-label="Name">@Model.SkillTypeList[i].Name</td>
                            <td data-label="Short Name">@Model.SkillTypeList[i].ShortName</td>
                            <td data-label="Actions">
                                @if (CurrentUserRoleActions.Modify == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="editskilltype"
                                       class="btn btn-icon btn-edit icon-only ">
                                        <i class="icon-xl fas fa-pencil-alt" onclick="onAddNewOrEditClick('MODIFY','@Model.SkillTypeList[i].GI','@Model.SkillTypeList[i].LogGI',@i)"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="editskilltype"
                                       class="btn btn-icon btn-edit icon-only ">
                                        <i class="icon-xl fas fa-pencil-alt" onclick="onAddNewOrEditClick('MODIFY', '@Model.SkillTypeList[i].GI', '@Model.SkillTypeList[i].LogGI',@i);
                                        swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#AddNewOrEditSlider');});"></i>
                                    </a>
                                }
                                <!-- Edit Slider start-->
                                <!-- Edit Slider  end-->
                                <!-- delete Slider  start-->
                                @if (CurrentUserRoleActions.Delete == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="deleteskilltype"
                                       class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.SkillTypeList[i].GI', '@Model.SkillTypeList[i].LogGI', 'DELETE',@i)">
                                        <i class="icon-xl far fa-trash-alt"></i>
                                    </a>
                                }
                                else
                                { 
                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="deleteskilltype"
                                       class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.SkillTypeList[i].GI', '@Model.SkillTypeList[i].LogGI', 'DELETE',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-trash-alt"></i>
                                    </a>                                
                                }

                                </td>
                        </tr>
                    }
                }


            }

        </tbody>
    </table>
</div>
