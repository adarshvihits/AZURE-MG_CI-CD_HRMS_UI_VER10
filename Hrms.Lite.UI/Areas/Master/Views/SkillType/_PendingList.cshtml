@model Hrms.Lite.Shared.DataBank.Generic.Master.SkillType
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");

        });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table skilltype-master-pending pt-1">
    @Html.HiddenFor(m => m.SkillTypeList.Count)
    <table id="skillTypePendingTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>

            @{


                if (Model.SkillTypeList != null && Model.SkillTypeList.Count > 0)
                {
                    for (int i = 0; i < Model.SkillTypeList.Count; i++)
                    {

                        <tr>
                            @Html.HiddenFor(m => m.SkillTypeList[i].MakerChecker)
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Name">@Model.SkillTypeList[i].Name</td>
                            <td data-label="Short Name">@Model.SkillTypeList[i].ShortName</td>

                            <td data-label="Status">@Model.SkillTypeList[i].Mode</td>
                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="deductionapprove"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.SkillTypeList[i].GI', '@Model.SkillTypeList[i].LogGI','APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                { 
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="deductionapprove"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.SkillTypeList[i].GI', '@Model.SkillTypeList[i].LogGI', 'APPROVAL',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                </td>

                        </tr>
                    }
                }


            }

        </tbody>
    </table>
</div>