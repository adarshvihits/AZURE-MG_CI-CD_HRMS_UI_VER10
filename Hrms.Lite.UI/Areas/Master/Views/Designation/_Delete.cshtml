@model Hrms.Lite.Shared.Master.Designation
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
@using (Html.BeginForm("Delete", "Designation", FormMethod.Post, new { @id = "DeleteDesignation" }))
{
    <div id="deletedesignation" class="slider-forms slider-forms-open DeleteDiv">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('DeleteDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>Functional Designation</h4>
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Name</label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.Name)
                                @Html.HiddenFor(model => Model.Active)
                                @Html.HiddenFor(model => Model.GI)
                                @Html.HiddenFor(model => Model.LogGI)
                                @Html.HiddenFor(model => Model.Mode)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Short
                                Name
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.ShortName)
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row my-3">
                    <div class="col-md-6">
                        <label class="view-title">MRF Approval Required </label>
                        @if (Model.MRFApproval == 0)
                        {
                            <div class="view-details">
                                No
                            </div>
                        }
                        else
                        {
                            <div class="view-details">
                                Yes
                            </div>
                        }
                    </div>
                    <div class="col-md-6">
                        <label class="view-title">No.of Interview Levels </label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.InterviewLevels.Name)
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <label class="view-title">Driving License required</label>
                        @if (Model.LicenseRequired == 0)
                        {
                            <div class="view-details">
                                No
                            </div>
                        }
                        else
                        {
                            <div class="view-details">
                                Yes
                            </div>
                        }
                    </div>

                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Notice Period
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.NoticePeriod)
                            </div>
                        </div>
                    </div>


                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Active</label>
                            <div class="view-details">
                                @if (Model.Active == true)
                                {

                                    <button type="button" class="btn btn-icon btn-tick">
                                        <i class="icon-xl fas fa-check"></i>
                                    </button>

                                }
                                else
                                {
                                    <button type="button" class="btn btn-icon btn-close">
                                        <i class="icon-xl fas fa-times"></i>

                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row my-3">
                    <div class="col-md-12">
                        <label class="view-title">Description</label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.Description)

                        </div>
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12 align-right">
                        @if (CurrentUserRoleActions.Delete == true)
                        {
                            <a type="button" data-bs-toggle="tooltip" title="" data-bs-original-title="Delete"
                               class="btn btn-icon btn-delete big-btn float-none" onclick="return confirmDelete('@Model.GI', '@Model.LogGI')">
                                <i class="icon-xl far fa-trash-alt"></i>
                            </a>
                        }
                        </div>
                </div>
            </div>
        </div>
    </div>
}