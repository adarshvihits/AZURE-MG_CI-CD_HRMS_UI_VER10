@model Hrms.Lite.Shared.Master.Designation
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });


</script>
@using (Html.BeginForm("Save", "Designation", FormMethod.Post, new { id = "DesignationSave" }))
{
    <div id="designationedit" class="slider-forms slider-forms-open AddNewOrEdit">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddNewOrEdit')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>

            <div class="location-slider">
                <h4>
                    Functional Designation
                </h4>
            </div>

            <div class="add-padding">

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.Code)
                            @*@Html.HiddenFor(model => Model.Description)*@
                            @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'DesignationName')", maxlength = "120" })
                            <span id="DesignationName"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Short Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm DesShtName", @placeholder = "Short Name", @onblur = "validate(this,'DesignationShortName')", maxlength = "5" })

                            <span id="DesignationShortName"></span>
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-6 mt-4">
                        <div class="form-group">
                            <label>
                                MRF Approval Required
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.DropDownListFor(model => model.MRFApproval,
                     new List<SelectListItem> {
                                                                new SelectListItem {  Value= "0" , Text = "No"},
                                                                new SelectListItem {  Value= "1" , Text = "Yes" },

                       },
                     new { @class = "form-control form-control-sm" })

                        </div>
                    </div>
                    <div class="col-md-6 mt-4">
                        <div class="form-group">
                            <label>
                                No.of Interview Levels
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.DropDownListFor(Model => Model.InterviewLevels.Code, (SelectList)ViewBag.InterviewLevels, "--Select--", new { @class = "form-control form-control-sm intervw", @onblur = "validate(this,'intr')" })


                        </div>
                    </div>
                </div>
                <div class="row my-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Driving License required
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.DropDownListFor(model => model.LicenseRequired,
                     new List<SelectListItem> {
                                                                new SelectListItem {  Value= "0" , Text = "No"},
                                                                new SelectListItem {  Value= "1" , Text = "Yes" },

                       },
                     new { @class = "form-control form-control-sm" })

                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                               Notice Period
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.TextBoxFor(Model => Model.NoticePeriod, new { @class = "form-control form-control-sm DesNoticePeriod", @placeholder = "Notice Period", @onkeypress = "return onlyNumberKey(event)", @onblur = "validate(this,'DesignationNoticePeriod')", @maxlength = "3" })

                            <span id="DesignationNoticePeriod"></span>
                        </div>
                    </div>




                    <div class="col-md-6 d-flex align-items-center">
                        <div class="form-group pt-2">
                            <div class="d-flex align-items-center">
                                <div>  Active</div>
                                <label class="switch" @*onchange="ActiveInactiveValidation('DSG', '@Model.Code')"*@>
                                    @Html.HiddenFor(m => Model.Code)
                                    @Html.CheckBoxFor(model => model.Active, new { @id = "activeInactive" })
                                    <span class="slider round"></span>
                                </label>
                            </div>

                        </div>
                    </div>
                </div>
                <div class="row my-3">
                    <div class="col-md-12">
                        <label>Description</label>
                        <div class="view-details">
                            @if (Model.Mode == "CREATE")
                            {
                                
                                    @Html.TextAreaFor(model => Model.Description, new { @class = "form-control form-control-sm DesDiscription", @placeholder = "Description", maxlength = "250" })

                            }
                            @if (Model.Mode == "MODIFY")
                            {

                                @Html.HiddenFor(model => Model.Description)

                                @Html.DisplayFor(model => Model.Description)

                            }

                        </div>
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12 align-right">
                        @if (Model.Mode == "CREATE")
                        {
                            @if (CurrentUserRoleActions.Create == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="onDesignationSaveClick('Save')">
                                    Save
                                </button>
                            }
                        }
                        @if (Model.Mode == "MODIFY")
                        {

                            @if (CurrentUserRoleActions.Modify == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="onDesignationSaveClick('Modify')">
                                    Modify
                                </button>
                            }
                        }
                        </div>
                </div>
            </div>
        </div>
    </div>
}
