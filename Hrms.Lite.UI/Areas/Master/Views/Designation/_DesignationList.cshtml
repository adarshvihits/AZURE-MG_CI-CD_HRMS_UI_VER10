@model Hrms.Lite.Shared.Master.Designation
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");

        //$('#DesignationTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');


    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table designation-list pt-1">
    @Html.HiddenFor(model => Model.DesignationList.Count)
    <table id="DesignationTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.DesignationList != null && Model.DesignationList.Count > 0)
                {
                    for (int i = 0; i < Model.DesignationList.Count; i++)

                    {


                        <tr>

                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Description)
                            @Html.HiddenFor(model => Model.Active)
                            @Html.HiddenFor(m => m.DesignationList[i].EditActive)
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Name">@Model.DesignationList[i].Name</td>
                            <td data-label="Short Name">@Model.DesignationList[i].ShortName</td>
                            <td data-label="Actions">
                                <div>
                                    @if (CurrentUserRoleActions.Modify == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="designationedit"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY','@Model.DesignationList[i].GI','@Model.DesignationList[i].LogGI',@i)">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="designationedit"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY', '@Model.DesignationList[i].GI', '@Model.DesignationList[i].LogGI',@i);
                                            swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#addOrEditSlider');});">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    @if (CurrentUserRoleActions.Delete == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deletedesignation"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.DesignationList[i].GI','@Model.DesignationList[i].LogGI','DELETE',@i)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deletedesignation"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.DesignationList[i].GI', '@Model.DesignationList[i].LogGI', 'DELETE',@i)
                                            swal.fire(MasterPersmissionMsg)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>

                    }
                }

            }
        </tbody>
    </table>
</div>