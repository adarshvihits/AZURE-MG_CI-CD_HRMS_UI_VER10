@model Hrms.Lite.Shared.Master.YearlyOffdaySettings
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<style>
    [aria-expanded="true"] i {
        -webkit-transform: rotate(90deg);
        -moz-transform: rotate(90deg);
        transform: rotate(90deg);
    }
    .add-padding {
        padding: 0px 30px 300px;
    }
</style>
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "offdaylistSubmit" }))
{
    <div id="offdaysettingsedit" class="slider-forms slider-forms-open AddNewOredit">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddNewOredit')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>
                    Yearly Offday Settings
                </h4>
            </div>
            <div class="add-padding">
                <div class="row">

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Year
                                <span class="Mandatory">*</span>
                            </label>

                            @Html.HiddenFor(model => Model.OffdaySettingsGI)

                            @Html.DropDownListFor(Model => Model.Year.Code, (SelectList)ViewBag.Year, "--Select--", new { @class = "form-control form-control-sm yr", @onblur = "validate(this,'year')" })
                            <span id="year"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Combination Name</label>

                            @Html.TextBoxFor(Model => Model.CombinationName, new { @class = "form-control form-control-sm cname", @placeholder = "Combination Name", maxlength = "120", })
                            <span id="comboname"></span>
                        </div>
                    </div>
                </div>



                <div class="row m-0 my-3">
                    <div class="col-md-5 pl-0">

                        <div class="tble_days">
                            <div class="ihits-table table-border w-100 hover-color odd-even   table-head-small hover-color odd-even compensationBenefits offdaysetting-slider">
                                <div class="panel-body">
                                    <table class="table table-condensed table-striped " id="daystable">
                                        <thead>
                                            <tr class="table-light yearly-table">
                                                <th scope="col">Days</th>

                                                <th scope="col"></th>


                                            </tr>
                                        </thead>

                                        <tbody>
                                            @if (Model != null && Model.Days != null && Model.Days.Count > 0)
                                            {

                                                for (int i = 0; i < Model.Days.Count; i = i + 6)
                                                {
                                                    @Html.HiddenFor(model => model.Days[i].Days)
                                                    @Html.HiddenFor(model => model.Days[i].DayCode)
                                                    @Html.HiddenFor(model => model.Days[i].WeekCode)
                                                    <tr data-bs-toggle="collapse"
                                                        data-target="#@Model.Days[i].Days"
                                                        class="accordion-toggle">
                                                        <td data-label="Particular">
                                                            <div class="newday">
                                                                <i class="fa fa-chevron-right newfa"
                                                                   aria-hidden="true"></i>@Model.Days[i].Days
                                                            </div>
                                                        </td>

                                                        <td data-label="Applicability">
                                                            <div class="checkbox-inline justify-content-center">
                                                                <label class="checkbox checkbox-outline checkbox-success">
                                                                    @Html.CheckBoxFor(m => m.Days[i].Applicability, new { @class = "parentCheck_" + i, @onclick = "onColumnApplicabilityClick(" + i + ")" })
                                                                    <span></span>
                                                                </label>
                                                            </div>
                                                        </td>

                                                    </tr>
                                                    <tr class="pt-0">
                                                        <td colspan="12"
                                                            class="hiddenRow p-0">
                                                            <div class="accordian-body collapse"
                                                                 id="@Model.Days[i].Days">
                                                                <table class="table table-striped">


                                                                    <tbody>
                                                                        @for (int j = i + 1; j < i + 6; j++)
                                                                        {
                                                                            @Html.HiddenFor(model => model.Days[j].Days)
                                                                            @Html.HiddenFor(model => model.Days[j].DayCode)
                                                                            @Html.HiddenFor(model => model.Days[j].WeekCode)
                                                                            <tr data-bs-toggle="collapse"
                                                                                class="accordion-toggle"
                                                                                data-target="#demo10">


                                                                                <td data-label="Particular">
                                                                                    <div class="newday">
                                                                                        @Model.Days[j].Days
                                                                                    </div>
                                                                                </td>

                                                                                <td data-label="Applicability">
                                                                                    <div class="checkbox-inline justify-content-center">
                                                                                        <label class="checkbox checkbox-outline checkbox-success">
                                                                                            @Html.CheckBoxFor(m => m.Days[j].Applicability, new { @class = "childCheck_" + i, @onclick = "onRowApplicabilityClick(" + i + ")" })
                                                                                            <span></span>
                                                                                        </label>
                                                                                    </div>
                                                                                </td>
                                                                            </tr>

                                                                        }


                                                                    </tbody>

                                                                </table>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>






                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-1 newoffday">
                        <div id="modulebtn" class="arrow-outer mt-0">
                            <button type="button" class="arrow-next pt-0"
                                    onclick="onNextClick()">
                                <i class="icon-xl fas fa-angle-double-right"></i>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-6 pr-0">


                        <div id="DayGridSlider" class="day-number ">
                            @await Html.PartialAsync("_DaysGrid", Model) 
                        </div>



                    </div>

                </div>



                <div class="row my-3">

                    <div class="col-md-12">
                        <label>Description</label>
                        @if (Model.mode == "Modify")
                        {

                            @Html.DisplayFor(model => Model.Description)
                        }
                        else
                        {

                            @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm offdayDescription", @placeholder = "Description", maxlength = "250" })
                        }
                    </div>
                </div>

                <div class="row ">
                    <div class="col-md-6">
                        <h4 class="daywise-count">DayWise Total Count</h4>

                    </div>
                    <div class="col-md-6">
                        <h4 class="daywise-count">Total Day Count</h4>
                        <h4 id="totcount" class="pt-2">@Model.Dates.Count</h4>
                    </div>
                </div>
                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12 align-right">
                        @if (Model.mode == "Modify")
                        {
                            @if (CurrentUserRoleActions.Modify == true)
                            {

                                <button class="btn btn-default  mobile-full-width" type="button" onclick="YearlyOffdaySave('Modify')">
                                    Modify
                                </button>
                            }
                        }

                        else
                        {
                            @if (CurrentUserRoleActions.Create == true)
                            {
                                <button class="btn btn-default  mobile-full-width" type="button" onclick="YearlyOffdaySave('Save')">
                                    Save
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
        </div>
}