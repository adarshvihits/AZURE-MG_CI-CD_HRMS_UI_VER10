@model Hrms.Lite.Shared.Master.DutyRosterLock
  
    @using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "dutyRosterLockBatch" }))
    {

        <div id="BatchUpdate" class="slider-forms slider-forms-open BatchUpdateDutyRosterLock">
            <div class="slider-inner-style">
                <div class="slider-form-close" onclick="CloseSlider('BatchUpdateDutyRosterLock')"><i class="ki ki-close icon-xs text-muted"></i></div>
                <h4>
                    Batch Update
                </h4>
                <div class="row">
                    <div class="col-md-6">
                        <label class="">Lock Date</label>
                        <div class="input-group date">
                            @Html.TextBoxFor(m => m.LockDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_12", @readonly = "true", @placeholder = "Lock Date" })
                            @Html.HiddenFor(m => m.Month.Code)
                            <div class="input-group-append">
                                <span class="input-group-text">
                                    <i class="la la-calendar"></i>
                                </span>
                            </div>
                        </div>
                        <span id="fromdate"></span>
                        @*<div class="row-outer">
            <label class="view-title">Lock Date</label>
            <div class="view-details">

            </div>
        </div>*@
                    </div>
                </div>
            


                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">
                        <button type="button" class="btn btn-default  mobile-full-width" onclick="BatchUpdateSave()">
                            Update
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }
