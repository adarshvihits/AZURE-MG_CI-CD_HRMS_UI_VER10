@model Hrms.Lite.Shared.Master.NightAllowancePurpose

<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Night-Allowance-Purpose-List">
    @Html.HiddenFor(m => m.NightAllowancePurposeList.Count)
    <table id="nightallwPurposetable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Department</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.NightAllowancePurposeList != null && Model.NightAllowancePurposeList.Count > 0)
                {
                    for (int i = 0; i < Model.NightAllowancePurposeList.Count; i++)
                    {
                        <tr>
                            @Html.HiddenFor(model => Model.PurposeCode)
                            @Html.HiddenFor(model => Model.PurposeGi)
                            <td data-label="Name">@Model.NightAllowancePurposeList[i].Name</td>
                            <td data-label="ShortName">@Model.NightAllowancePurposeList[i].ShortName</td>
                            <td data-label="Department">@Model.NightAllowancePurposeList[i].Department</td>
                            <td data-label="Actions">
                                <div>
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="ERPAccountHeadedit"
                                       class="btn btn-icon btn-edit icon-only" onclick="onAddNewOrEditClick('MODIFY','@Model.NightAllowancePurposeList[i].PurposeGi')">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>
                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="deleteERPAccountHead"
                                       class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.NightAllowancePurposeList[i].PurposeGi')">
                                        <i class="icon-xl far fa-trash-alt"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            }

        </tbody>
    </table>
</div>