

@model Hrms.Lite.Shared.Master.RoundOffSettings
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>

<script src="~/scripts/Master/RoundOffSettings.js"></script>
<!--begin::Header-->
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Round Off Settings</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Round Off Settings
                    </li>

                </ul>
            </div>
        </div>

        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <!--begin: Search Form-->

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items">
                                <span class="btn-title tab1 active" onclick="OnTabClick('tab1','ALLOWANCE')">
                                    Allowances
                                </span>
                            </div>
                            <div class="tab-items medium">
                                <span class="btn-title tab2" onclick="OnTabClick('tab2','DEDUCTION')">
                                    Deduction
                                </span>
                            </div>
                            <div class="tab-items low">
                                <span class="btn-title tab3" onclick="OnTabClick('tab3','LOAN_ADVANCE')">
                                    Loan & Advance
                                </span>
                            </div>
                            <div class="tab-items low">
                                <span class="btn-title tab4" onclick="OnTabClick('tab4','OTHERS')">
                                    Others
                                </span>
                            </div>

                            <div class="tab-items select-option">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="Name">
                                </div>
                                <a data-bs-toggle="tooltip" title="Export to Excel"
                                   class="btn btn-excel" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>

                            </div>


                        </div>
                    </div>


                    <!-- Table Section -->
                    @using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "RoundOffSettingsSave" }))
                    {
                        <div id="roundoffsettingsList">
                            @await Html.PartialAsync("_RoudoffSettingsList", Model)
                        </div>
                        <!-- Table Setion End -->

                        <div class="row card-footer-bottom-fixed">

                            <div class="col-md-12  float-right-btn">



                                <a id="addApplicableAllowance" type="button"
                                   class="btn btn-default mobile-full-width" onclick="SaveRoundOffSettings()">
                                    Save
                                </a>

                            </div>

                        </div>

                    }

                    <div id="validationDiv"></div>
                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>




