@model Hrms.Lite.Shared.Master.Rewards
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
@using (Html.BeginForm("Delete", "RewardsMaster", FormMethod.Post, new { id = "deleteReward" }))
{
    <div id="deleterewardmaster" class="slider-forms slider-forms-open DeleteDiv">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('DeleteDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>Rewards</h4>
            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Name</label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.Name)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Mode)
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Short
                            Name
                        </label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.ShortName)
                        </div>
                    </div>
                </div>

            </div>
            <div class="row">

                <div class="col-md-12">
                    <div class="ihits-table table-border  reward-master-departmentadd mt-2 vertical-scroll-300">
                        <table>
                            <thead>
                                <tr class="table-gray">
                                    <th scope="col">
                                        Department
                                    </th>



                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    if (Model.RewardsGridFill != null && Model.RewardsGridFill.Count > 0)
                                    {

                                        foreach (var item in Model.RewardsGridFill)
                                        {
                                            <tr>
                                                <td>@item.Name</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>

                                            <td colspan="3" stye="text-align:center;">  No  Data Found</td>
                                        </tr>
                                    }

                                }
                            </tbody>

                        </table>
                    </div>

                </div>
            </div>
            <div class="ihits-table table-border  mobile-responsive-table reward-master-list-add-two-col my-4">
                <table>
                    <thead>
                        <tr class="table-gray">
                            <th scope="col">
                                Point Criteria
                            </th>
                            <th scope="col">
                                Rewards Point
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ if (Model.RewardVsPointCriteriaList != null && Model.RewardVsPointCriteriaList.Count > 0)
                            {

                                foreach (var item in Model.RewardVsPointCriteriaList)
                                {
                                    <tr>
                                        <td>@item.Name</td>
                                        <td>@item.Point</td>
                                    </tr>
 }
                            }
                        }
                    </tbody>
                </table>
            </div>


            <div class="row my-3">
                <div class="col-md-12">
                    <div class="row-outer">
                        <label class="view-title">Active</label>
                        <div class="view-details">
                            @if (Model.Active == true)
                            {

                                <button type="button" class="btn btn-icon btn-tick">
                                    <i class="icon-xl fas fa-check"></i>
                                </button> }
                            else
                            {
                                <button type="button" class="btn btn-icon btn-close">
                                    <i class="icon-xl fas fa-times"></i>

                                </button>}
                        </div>
                    </div>
                </div>
            </div>

            <div class="row my-3">
                <div class="col-md-12">
                    <label class="view-title">Description</label>
                    <div class="view-details">
                        @Html.DisplayFor(model => model.Description)
                    </div>
                </div>
            </div>

            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    @if (CurrentUserRoleActions.Delete == true)
                    {
                        <a type="button" title="Delete" data-bs-toggle="tooltip"
                           class="btn btn-icon btn-delete big-btn float-none" onclick="confirmDelete('@Model.GI','@Model.LogGI')">
                            <i class="icon-xl far fa-trash-alt"></i>
                        </a>
                    }
                    </div>


            </div>
        </div>
    </div>
}