@model Hrms.Lite.Shared.Master.Rewards
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    debugger;

     $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
         $('.pendingTabCount').html("@Model.PendingCount");

         //$('#RewardsPendingTable').DataTable({
         //    "pageLength": 25,
         //    "language": {
         //        searchPlaceholder: "Search"
         //    }
         //});


         //$('.ihits-table table').removeClass("dataTable no-footer");
         //$(".ihits-table table tr th").removeAttr('style');

     });

</script>

<div class="ihits-table table-border  odd-even mobile-responsive-table rewards-master-pendinglist pt-1">
    @Html.HiddenFor(m => m.RewardsList.Count)
    <table id="RewardsPendingTable" class="common-table layout-ihits dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Entry type</th>
                <th scope="col">Actions</th>

            </tr>
        </thead>
        <tbody>
            @{


                if (Model.RewardsList != null && Model.RewardsList.Count > 0)
                {
                    for (int i = 0; i < Model.RewardsList.Count; i++)

                    {

                        <tr>
                            @Html.HiddenFor(m => m.RewardsList[i].MakerChecker)
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Name">@Model.RewardsList[i].Name</td>
                            <td data-label="ShortName">@Model.RewardsList[i].ShortName</td>
                            <td data-label="Entry Type">@Model.RewardsList[i].EntryType</td>
                            <td data-label="Approve">

                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="addNewRewardsMasterApprove"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.RewardsList[i].GI','@Model.RewardsList[i].LogGI','APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="addNewRewardsMasterApprove"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.RewardsList[i].GI', '@Model.RewardsList[i].LogGI', 'APPROVAL',@i);swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                            </td>

                        </tr>
                    }
                }



            }



        </tbody>
    </table>
</div>