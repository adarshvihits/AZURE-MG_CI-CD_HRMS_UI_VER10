@model Hrms.Lite.Shared.Master.Rewards
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    debugger;

     $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");

         //$('#RewardsActiveList').DataTable({
         //    "pageLength": 25,
         //    "language": {
         //        searchPlaceholder: "Search"
         //    }
         //});


         //$('.ihits-table table').removeClass("dataTable no-footer");
         //$(".ihits-table table tr th").removeAttr('style');

     });

</script>
<div class="ihits-table table-border  odd-even mobile-responsive-table rewards-master-list pt-1">
    @Html.HiddenFor(m => m.RewardsList.Count)
    <table id="RewardsActiveList" class="common-table layout-ihits dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.RewardsList != null && Model.RewardsList.Count > 0)
                {
                    for (int i = 0; i < Model.RewardsList.Count; i++)

                    {
                        <tr>
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(m => m.RewardsList[i].EditActive)
                            <td data-label="Name">@Model.RewardsList[i].Name</td>
                            <td data-label="Short Name">@Model.RewardsList[i].ShortName</td>
                            <td data-label="Actions">
                                <div>
                                    @if (CurrentUserRoleActions.Modify == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="addNewRewardsMaster"
                                           class="btn btn-icon btn-edit icon-only" onclick="onAddNewOrEditClick('MODIFY', '@Model.RewardsList[i].GI', '@Model.RewardsList[i].LogGI',@i)">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="addNewRewardsMaster"
                                           class="btn btn-icon btn-edit icon-only" onclick="onAddNewOrEditClick('MODIFY', '@Model.RewardsList[i].GI', '@Model.RewardsList[i].LogGI',@i);
                                          swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#newRequestSlider');});">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    } 
                                    @if (CurrentUserRoleActions.Delete == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deletecountry"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.RewardsList[i].GI','@Model.RewardsList[i].LogGI','DELETE',@i)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                    else
                                    { 
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deletecountry"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.RewardsList[i].GI', '@Model.RewardsList[i].LogGI', 'DELETE',@i);
                                            swal.fire(MasterPersmissionMsg);">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                    </div>
                            </td>
                        </tr>
                    }
                }


            }


        </tbody>
    </table>
</div>