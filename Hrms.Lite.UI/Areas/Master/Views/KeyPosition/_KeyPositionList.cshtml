@model Hrms.Lite.Shared.Master.KeyPosition
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>

    $(document).ready(function () {
        debugger;
    
        $('.PendingTabCount').html("@Model.PendingCount");
        });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table pt-1">
    @Html.HiddenFor(m => m.KeyPositionList.Count)
    <table id="KeyPositionTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Key Position Code</th>
                <th scope="col">Key Position Risk</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.KeyPositionList != null && Model.KeyPositionList.Count > 0)
                {
                    for (int i = 0; i < Model.KeyPositionList.Count; i++)

                    {

                        <tr>
                            @Html.HiddenFor(model => Model.LogGI)

                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(m => m.KeyPositionList[i].EditActive)
                            <td data-label="Name">@Model.KeyPositionList[i].Name</td>
                            <td data-label="Short Name">@Model.KeyPositionList[i].ShortName</td>
                            <td data-label="Key Position Code">@Model.KeyPositionList[i].KeyPositionCodeDesc</td>
                            <td data-label="Key Position Risk">@Model.KeyPositionList[i].KeyPositionRisk.Name</td>
                            <td data-label="Actions">
                                @if (CurrentUserRoleActions.Modify == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="editkeyposition"
                                       class="btn btn-icon btn-edit icon-only " onclick="onAddOrEditClick('MODIFY','@Model.KeyPositionList[i].LogGI','@Model.KeyPositionList[i].GI',@i)">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="editkeyposition"
                                       class="btn btn-icon btn-edit icon-only" onclick="onAddOrEditClick('MODIFY', '@Model.KeyPositionList[i].LogGI', '@Model.KeyPositionList[i].GI',@i);
                                       swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#AddNewOrEditSlider');});">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>
                                }
                                <!-- Edit Slider start-->
                                <!-- Edit Slider  end-->
                                <!-- delete Slider  start-->
                                @if (CurrentUserRoleActions.Delete == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="deletekeyposition"
                                       class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.KeyPositionList[i].LogGI','@Model.KeyPositionList[i].GI','DELETE',@i)">
                                        <i class="icon-xl far fa-trash-alt"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="deletekeyposition"
                                       class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.KeyPositionList[i].LogGI', '@Model.KeyPositionList[i].GI', 'DELETE',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-trash-alt"></i>
                                    </a>
                                }

                                <!-- <end delete section></end> -->
                            </td>
                        </tr>

                    }
                }
            }
        </tbody>
    </table>
</div>
