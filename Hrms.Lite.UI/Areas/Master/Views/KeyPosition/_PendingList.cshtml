@model Hrms.Lite.Shared.Master.KeyPosition
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>

    $(document).ready(function () {
        debugger;
        
        $('.PendingTabCount').html("@Model.PendingCount");
        });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table pt-1">
    <table id="KeyPositionPendingTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Key Position Code</th>
                <th scope="col">Key Position Risk</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>

            @{


                if (Model.KeyPositionList != null && Model.KeyPositionList.Count > 0)
                {
                    for (int i = 0; i < Model.KeyPositionList.Count; i++)

                    {

                        <tr>
                            @Html.HiddenFor(m => m.KeyPositionList[i].MakerChecker)
                            @Html.HiddenFor(model => Model.KeyPositionList[i].GI)
                            @Html.HiddenFor(model => Model.KeyPositionList[i].LogGI)
                            @*@Html.HiddenFor(model => Model.LogGI)*@
                            @Html.HiddenFor(model => Model.Mode)
                            <td data-label="Name">@Model.KeyPositionList[i].Name</td>
                            <td data-label="Short Name">@Model.KeyPositionList[i].ShortName</td>
                            <td data-label="Key Position Code">@Model.KeyPositionList[i].KeyPositionCodeDesc</td>
                            <td data-label="Key Position Risk">@Model.KeyPositionList[i].KeyPositionRisk.Name</td>

                            <td data-label="Status">@Model.KeyPositionList[i].Mode</td>
                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="approvekeyposition"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.KeyPositionList[i].GI', '@Model.KeyPositionList[i].LogGI','APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                { 
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="approvekeyposition"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.KeyPositionList[i].GI', '@Model.KeyPositionList[i].LogGI', 'APPROVAL',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                    <!-- Approve Slider -->
                                    <!-- Approve Slider end-->
                                </td>
                            <!-- <second></second> -->
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>
