@model Hrms.Lite.Shared.Master.KeyPosition
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}

<script>
    $(document).ready(function () {
        $('#Genders').multiselect();
    });
</script>

@using (Html.BeginForm("Save", "KeyPosition", FormMethod.Post, new { @id = "KeyPositionSave" }))
{

    <div id="addkeyposition" class="slider-forms slider-forms-open AddNewDiv">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddNewDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>
                    Key Position
                </h4>
            </div>
            <div class="add-padding">
                <div class="row pt-2">

                    <div class="col-md-6">
                        <div class="form-group">
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.GI)
                            <label>Name</label>
                            <span class="Mandatory">*</span>
                            @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm", @placeholder = "Name", @onblur = "validate(this,'KeyName')", maxlength = "120" })
                            <span id="KeyName"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Short Name</label>
                            <span class="Mandatory">*</span>
                            @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm", @placeholder = "Short Name", @onblur = "validate(this,'KeyshtName')", maxlength = "5" })
                            <span id="KeyshtName"></span>
                        </div>
                    </div>

                </div>
                <div class="row my-1">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Key Position Code</label>
                            <span class="Mandatory">*</span>
                            @Html.TextBoxFor(Model => Model.KeyPositionCodeDesc, new { @class = "form-control form-control-sm", @placeholder = "Key Position Code", @onblur = "validate(this,'KeyCod')", maxlength = "250" })
                            <span id="KeyCod"></span>
                        </div>
                    </div>
                    <div class="col-md-6">

                        <div class="form-group">
                            <label>Designation </label>
                            <span class="Mandatory">*</span>
                            @Html.DropDownListFor(Model => Model.Designation.Code, (SelectList)ViewBag.Desig, "--Select--", new { @class = "form-control form-control-sm ", @onblur = "validate(this,'desDD')" })
                        </div>
                        <span id="desDD"></span>
                    </div>

                </div>

                @if (Model.Mode == "CREATE")
                {
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group" id="DDIv">
                                <label>Years of Service</label>
                                <span class="Mandatory">*</span>

                                @Html.HiddenFor(m => m.YSAboveOrBelow.Name)
                                @Html.DropDownListFor(m => m.YSAboveOrBelow.Code, (SelectList)ViewBag.Operators, "All", new { @class = "form-control form-control-sm", @onchange = "onYOSChange(this,'yrsSer')" })
                                <span id="yrsSer"></span>
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group mt-6">
                                @Html.TextBoxFor(m => m.YOSFrom, new { @class = "form-control form-control-sm hide", @placeholder = "" })

                            </div>
                        </div>
                        <div class="col-md-3" id="yosDiv">
                            <div class="form-group mt-6">

                                @Html.TextBoxFor(m => m.YOSTo, new { @class = "form-control form-control-sm hide", @placeholder = "" })

                            </div>
                        </div>





                    </div>
                }
                else
                {
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group" id="DDIv">
                        <label>Years of Service</label>
                        <span class="Mandatory">*</span>

                        @Html.HiddenFor(m => m.YSAboveOrBelow.Name)
                        @Html.DropDownListFor(m => m.YSAboveOrBelow.Code, (SelectList)ViewBag.Operators, "All", new { @class = "form-control form-control-sm", @onchange = "onYOSChange(this,'yrsSer')" })
                        <span id="yrsSer"></span>
                    </div>
                </div>
                
            <div class="col-md-3">
                <div class="form-group mt-6">
                    @Html.TextBoxFor(m => m.YOSFrom, new { @class = "form-control form-control-sm", @placeholder = "" })

                </div>
            </div>
                
                
                <div class="col-md-3" id="yosDiv">
                    <div class="form-group mt-6">

                        @Html.TextBoxFor(m => m.YOSTo, new { @class = "form-control form-control-sm", @placeholder = "" })
                    </div>
                </div>





            </div>
                }
                @if (Model.Mode == "CREATE")
                {
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Age</label>
                                <span class="Mandatory">*</span>
                                @Html.HiddenFor(m => m.AgeAboveOrBelow.Name)
                                @Html.DropDownListFor(m => m.AgeAboveOrBelow.Code, (SelectList)ViewBag.Operators, "All", new { @class = "form-control form-control-sm", @onchange = "onAgeChange(this,'AgeKey')" })
                                <span id="AgeKey"></span>
                            </div>
                        </div>
                        <div class="col-md-3" id="ageDiv">
                            <div class="form-group mt-6">
                                @Html.TextBoxFor(m => m.AgeFrom, new { @class = "form-control form-control-sm hide", @placeholder = "" })

                            </div>
                        </div>

                        <div class="col-md-3" id="ageDiv">
                            <div class="form-group mt-6">

                                @Html.TextBoxFor(m => m.AgeTo, new { @class = "form-control form-control-sm hide", @placeholder = "" })
                            </div>
                        </div>

                    </div>
                }
                else
                {
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Age</label>
                                <span class="Mandatory">*</span>
                                @Html.HiddenFor(m => m.AgeAboveOrBelow.Name)
                                @Html.DropDownListFor(m => m.AgeAboveOrBelow.Code, (SelectList)ViewBag.Operators, "All", new { @class = "form-control form-control-sm", @onchange = "onAgeChange(this,'AgeKey')" })
                                <span id="AgeKey"></span>
                            </div>
                        </div>
                        <div class="col-md-3" id="ageDiv">
                            <div class="form-group mt-6">
                                @Html.TextBoxFor(m => m.AgeFrom, new { @class = "form-control form-control-sm", @placeholder = "" })

                            </div>
                        </div>

                        <div class="col-md-3" id="ageDiv">
                            <div class="form-group mt-6">

                                @Html.TextBoxFor(m => m.AgeTo, new { @class = "form-control form-control-sm", @placeholder = "" })
                            </div>
                        </div>

                    </div>
                }
            <div class="row">

                <div class="col-md-4">

                    <div class="form-group">
                        <label>Gender </label>
                        <span class="Mandatory">*</span>
                        @Html.HiddenFor(m => m.Gender.Name)
                        @Html.ListBoxFor(m => m.Genders, (SelectList)ViewBag.Gend, new { @class = "multiselectDropdownField form-control-multiselect form-control-sm ", @multiple = "multiple", data_placeholder = "All", @onchange = "onGenderChange('Gend')" })
                        <span id="Gend"></span>

                    </div>

                </div>
                <div class="col-md-5">

                    <div class="form-group">
                        <label>  Key Position Risk </label>
                        <span class="Mandatory">*</span>                    
                        @Html.DropDownListFor(m => m.KeyPositionRisk.Code, (SelectList)ViewBag.Risk,"--Select--", new { @class = "form-control form-control-sm", @onchnage="validate(this, 'risk')"})
                        <span id="Risk"></span>

                    </div>

                </div>
                <div class="col-md-3 d-flex align-center">
                    <div class="d-flex align-items-center">
                        <div> Active</div>
                        <label class="switch" onchange="ActiveInactiveValidationPosition('Key Position','@Model.Code')">
                            @Html.HiddenFor(m => Model.Code)
                            @Html.CheckBoxFor(m => m.Active, new { @id = "Activeinactivekeyposition" })
                            <span class="slider round pl-3"
                                  style="margin:4px 20px;"></span>
                        </label>
                    </div>
                </div>
            </div>
                <div class="row my-2">
                    <div class="col-md-12">
                        <div class="ihits-table table-border mobile-responsive-table key-position-entry-two vertical-scroll-100">
                            <table>
                                <thead>
                                    <tr class="table-light">
                                        <th scope="col">Skill</th>
                                        <th scope="col">Select</th>

                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        if (Model.Skills != null && Model.Skills.Count > 0)
                                        {
                                            for (int i = 0; i < Model.Skills.Count; i++)

                                            {
                                                <tr>
                                                    <td data-label="ID">
                                                        @Html.HiddenFor(model => Model.Skills[i].CODE)
                                                        @Model.Skills[i].NAME
                                                    </td>
                                                    <td data-label="Employee Name">
                                                        <div class="checkbox-inline">
                                                            <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                                                @Html.CheckBoxFor(Model => Model.Skills[i].APPLICABILITY)
                                                                <span></span>
                                                            </label>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    }

                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="row my-4">
                    <div class="col-md-12">
                        <div class="ihits-table table-border  mobile-responsive-table key-position-entry-two vertical-scroll-100">
                            <table>
                                <thead>
                                    <tr class="table-light">
                                        <th scope="col">
                                            Skill Proficiency
                                        </th>
                                        <th scope="col">Select</th>

                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        if (Model.SkillProficiency != null && Model.SkillProficiency.Count > 0)
                                        {
                                            for (int i = 0; i < Model.SkillProficiency.Count; i++)

                                            {
                                                <tr>
                                                    <td data-label="ID">
                                                        @Html.HiddenFor(model => Model.SkillProficiency[i].CODE)
                                                        @Model.SkillProficiency[i].NAME
                                                    </td>
                                                    <td data-label="Employee Name">
                                                        <div class="checkbox-inline">
                                                            <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                                                @Html.CheckBoxFor(Model => Model.SkillProficiency[i].APPLICABILITY)
                                                                <span></span>
                                                            </label>
                                                        </div>
                                                    </td>
                                                </tr>

                                            }
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="row my-4">
                    <div class="col-md-12">
                        <div class="ihits-table table-border mobile-responsive-table key-position-entry-two vertical-scroll-100">
                            <table>
                                <thead>
                                    <tr class="table-light">
                                        <th scope="col">Qualification</th>
                                        <th scope="col">Select</th>

                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        if (Model.Education != null && Model.Education.Count > 0)
                                        {
                                            for (int i = 0; i < Model.Education.Count; i++)

                                            {
                                                <tr>

                                                    <td data-label="ID">
                                                        @Html.HiddenFor(model => Model.Education[i].CODE)
                                                        @Model.Education[i].NAME
                                                    </td>
                                                    <td data-label="Employee Name">
                                                        <div class="checkbox-inline">
                                                            <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                                                @Html.CheckBoxFor(Model => Model.Education[i].APPLICABILITY)
                                                                <span></span>
                                                            </label>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    }

                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <div class="row my-4">
                    <div class="col-md-12">
                        <div class="ihits-table table-border  mobile-responsive-table language-kry-position vertical-scroll-100">
                            <table>
                                <thead>
                                    <tr class="table-light">
                                        <th scope="col">Languages</th>
                                        <th scope="col">Read</th>
                                        <th scope="col">Write</th>
                                        <th scope="col">Speak</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        if (Model.Languages != null && Model.Languages.Count > 0)
                                        {
                                            for (int i = 0; i < Model.Languages.Count; i++)

                                            {
                                                <tr>

                                                    <td data-label="ID">
                                                        @Html.HiddenFor(model => Model.Languages[i].CODE)
                                                        @Model.Languages[i].NAME
                                                    </td>
                                                    <td data-label="Employee Name">
                                                        <div class="checkbox-inline">
                                                            <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                                                @Html.CheckBoxFor(Model => Model.Languages[i].Read)
                                                                <span></span>
                                                            </label>
                                                        </div>
                                                    </td>
                                                    <td data-label="ID">
                                                        <div class="checkbox-inline">
                                                            <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                                                @Html.CheckBoxFor(Model => Model.Languages[i].Write)
                                                                <span></span>
                                                            </label>
                                                        </div>
                                                    </td>
                                                    <td data-label="ID">
                                                        <div class="checkbox-inline">
                                                            <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                                                @Html.CheckBoxFor(Model => Model.Languages[i].Speak)
                                                                <span></span>
                                                            </label>
                                                        </div>
                                                    </td>
                                                </tr>

                                            }
                                        }
                                    }


                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>

                <div class="row">

                </div>



                <div class="row my-3">

                    <div class="col-md-12">
                        @if (Model.Mode == "CREATE")
                        {
                            <label>Description</label>
                            @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm IntDescription", @placeholder = "Description", maxlength = "250" })

                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            <label class="view-title">Description</label>
                            <div class="view-details">

                                @Html.DisplayFor(Model => Model.Description)
                                @Html.HiddenFor(model => Model.Description)
                            </div>
                        }
                        @*<label>Description</label>
                            @Html.TextAreaFor(m => m.Description, new { @class = "form-control form-control-sm", @placeholder = "Description", maxlength = "250" })*@

                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">
                        @if (Model.Mode == "CREATE")
                        {

                            @if (CurrentUserRoleActions.Create == true)
                            {
                                <button type="button"
                                        class="btn btn-default mobile-full-width" onclick="SaveKeyPosition('Save')">
                                    Save
                                </button>
                            }
                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            @if (CurrentUserRoleActions.Modify == true)
                            {
                                <button type="button"
                                        class="btn btn-default mobile-full-width" onclick="SaveKeyPosition('Save')">
                                    Modify
                                </button>
                            }
                        }

                        </div>

                </div>
            </div>
        </div>
    </div>
}