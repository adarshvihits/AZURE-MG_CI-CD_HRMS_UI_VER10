@model Hrms.Lite.Shared.Master.QuotesOfDay


<div class="ihits-table table-border hover-color odd-even mobile-responsive-table quotes_lists vertical-scroll-500">

    @Html.HiddenFor(m => m.QuotesOfDayDetails.Count)
    <table id="QuotesTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Date</th>
                <th scope="col">Quotes Of The Day</th>
                <th scope="col">Action</th>



            </tr>
        </thead>
        <tbody>
            @if (Model.QuotesOfDayDetails != null && Model.QuotesOfDayDetails.Count > 0)
            {

                for (int i = 0; i < Model.QuotesOfDayDetails.Count; i++)
                {
            <tr>
                <td data-label="date">
                    @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.QuotesOfDayDetails[i].Date))
                    @Html.HiddenFor(m => m.QuotesOfDayDetails[i].Thought)
                    @Html.HiddenFor(m => m.QuotesOfDayDetails[i].ThoughtCode)   
                    @Html.HiddenFor(m => m.QuotesOfDayDetails[i].Date)

                </td>             
           
                <td data-label="Quote Of The Day">
                <span id="hideThought_@i">@Model.QuotesOfDayDetails[i].Thought</span>
                <span id="thoughtTxtbox_@i" +  class="hide">
                  <input id="newThought_@i"  QuotesOfDayDetails  class="form-control form-control-sm" placeholder="Thought">
                    </span></td>
                <td data-label="Action">                    

                    <div class="small-btn-group" id="edit_@i">
                        <a data-bs-toggle="tooltip" title="Edit" 
                           class="btn btn-icon btn-edit icon-only" onclick="onEditClick(@i)">
                            <i class="icon-xl fas fa-pencil-alt"></i>
                        </a>
                    </div>
                    <div class="small-btn-group hide" id="updatecancel_@i" >
                        <button type="button" data-bs-toggle="tooltip" title="Update" class="btn btn-icon btn-update btn-cancel icon-only">
                            <span id="">
                        <i class="icon-xl fas fa-sync-alt update-icon" onclick="onUpdateClick(@i, '@Model.QuotesOfDayDetails[i].ThoughtCode')">
                            </i>
                        </button>

                        <button type="button" data-bs-toggle="tooltip"
                                title="Cancel"
                                class="btn btn-icon btn-delete icon-only btn-bg-info " onclick="onCancelClick(@i)">
                            <i class="icon-xl fas fa-times"></i>
                        </button>
                    </div>
                    <div>
                        @if (Model.QuotesOfDayDetails[i].Thought != "")
                        {
                        <a data-bs-toggle="tooltip" title="Delete"
                           id="deletequotes"
                           class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="confirmDelete(@Model.QuotesOfDayDetails[i].ThoughtCode ,'DELETE',@i); ">
                                         
                            <i class="icon-xl far fa-trash-alt"></i>
                        </a>
                        }
                    </div>
                </td>

            </tr>

               


            }
        }
            </tbody>


        </table>

        </div>
