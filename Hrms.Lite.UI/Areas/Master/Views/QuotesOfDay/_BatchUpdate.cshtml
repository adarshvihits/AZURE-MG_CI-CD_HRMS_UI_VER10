@model Hrms.Lite.Shared.Master.QuotesOfDay


@using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "offdayBatchUpdateSave" }))
{
    @Html.HiddenFor(m => m.FYCODE)
    @Html.HiddenFor(m => m.FYNAME)
    @*@Html.HiddenFor(m => m.Year.Name)*@
    <div id="BatchUpdate" class="slider-forms slider-forms-open batchSlider">
        <div class="slider-inner-style">
            <div class="slider-form-close">
                <i class="ki ki-close icon-xs text-muted" onclick="CloseSlider('batchSlider')"></i>
            </div>
            <h4>
                Batch Update
            </h4>
            <div class="row">

                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Year</label>
                        <div class="view-details">
                            @Model.FYNAME
                        </div>
                    </div>
                </div>

            </div>

            <div class="row my-3">
                <div class="col-md-6">
                    <div class="form-group m-0">
                        <label>From</label>
                        @Html.DropDownListFor(m => m.From, (SelectList)ViewBag.From, "--Select--", new { @class = "form-control form-control-sm", @onchange = "validateYear()" })
                        <span id="prevcombination"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group m-0">
                        <label>To </label>
                        @Html.DropDownListFor(m => m.To, (SelectList)ViewBag.From, "--Select--", new { @class = "form-control form-control-sm", @onchange = "validateYear()" })
                        <span id="newcombination"></span>
                    </div>
                </div>
            </div>

            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    <a type="button" onclick="batchUpdateSave()"
                       class="btn btn-default  mobile-full-width">
                        Update
                    </a>
                </div>

            </div>
        </div>
    </div>
}