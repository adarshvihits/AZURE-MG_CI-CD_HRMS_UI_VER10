@model Hrms.Lite.Shared.Master.JoiningCheckList
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/settings.js"></script>
<script src="~/js/tooltip.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");



        //$('#JoiningCheckListPendingTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');

        });
</script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table skilltype-master-pending pt-1">
    @Html.HiddenFor(m => m.JoiningChecklist.Count)
    <table id="JoiningCheckListPendingTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Items</th>
                <th scope="col">Type</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>

            @{


                if (Model.JoiningChecklist != null && Model.JoiningChecklist.Count > 0)
                {


                    for (int i = 0; i < Model.JoiningChecklist.Count; i++)
                    {

                        <tr>
                            @Html.HiddenFor(m => m.JoiningChecklist[i].MakerChecker)
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Check Item">@Model.JoiningChecklist[i].Name</td>
                            <td data-label="Type">@Model.JoiningChecklist[i].CheckListType.Name</td>
                            <td data-label="Entry Type">@Model.JoiningChecklist[i].Mode</td>
                            <!--<td data-label="Status">-->@*@Model.JoiningChecklist[i].S*@<!--</td>-->



                        <td data-label="Approve">
                            @if (CurrentUserRoleActions.Approve == true)
                            {
                                <a data-bs-toggle="tooltip" title="Approve"
                                   id="joiningapprove"
                                   class="btn btn-icon btn-tick icon-only" onclick="onApproveClick('@Model.JoiningChecklist[i].GI','@Model.JoiningChecklist[i].LogGI','APPROVAL',@i)">
                                    <i class="icon-xl far fa-check-circle"></i>
                                </a>
                            }
                            else
                            {
                                <a data-bs-toggle="tooltip" title="Approve"
                                   id="joiningapprove"
                                   class="btn btn-icon btn-tick icon-only" onclick="onApproveClick('@Model.JoiningChecklist[i].GI', '@Model.JoiningChecklist[i].LogGI', 'APPROVAL',@i);
                                   swal.fire(MasterPersmissionMsg);">
                                    <i class="icon-xl far fa-check-circle"></i>
                                </a>
                            }

                        </td>
                        </tr>
                    }
                }



            }

        </tbody>
    </table>
</div>






