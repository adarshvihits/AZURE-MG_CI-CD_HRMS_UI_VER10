
@model Hrms.Lite.Shared.Master.JoiningCheckList
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });
</script>
@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "JoiningCheckList-Save" }))

{

    <div id="addjoiningchecklist" class="slider-forms slider-forms-open AddNewOrEdit">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddNewOrEdit')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>
                Onboarding Checklist
            </h4>
            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Item</label>
                        <span class="Mandatory">*</span>
                        @Html.HiddenFor(model => Model.Mode)
                        @Html.HiddenFor(model => Model.GI)
                        @Html.HiddenFor(model => Model.LogGI)
                        @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm ItemName", @placeholder = "Item", @onblur = "OnlycapitalizeFirstLetter(this,'item')", maxlength = "120", @onchange = "validate(this,'item')" })
                        <span id="item"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Type</label>
                        <span class="Mandatory">*</span>
                        @Html.DropDownListFor(Model => Model.CheckListType.Code, (SelectList)ViewBag.CheckListType, "--Select CheckList type--", new { @class = "form-control form-control-sm CheckType", @onblur = "validate(this,'checklisttype')" })
                        <span id="checklisttype"></span>
                    </div>
                </div>
            </div>




            <div class="row my-4 ">


                <div class="col-md-6 d-flex align-items-center">
                    <label class="switch" onchange="ActiveInactiveValidationChecklist('JOINING CHECKLIST',@Model.Code)">
                        Active
                        @Html.CheckBoxFor(Model => Model.Active, new { @id = "checklist" })
                        <span class="slider round"></span>
                    </label>
                </div>
                <div class="col-md-6">
                    <div class="checkbox-inline h-100 align-content-center">
                        <label>Is Mandatory</label>
                        <label class="checkbox checkbox-outline checkbox-success">
                            @Html.CheckBoxFor(Model => Model.IsMandatory)
                            <span style="margin-left:10px;"></span>
                        </label>
                    </div>
                </div>
               
            </div>



            <div class="row my-3">

                <div class="col-md-12">

                    @if (Model.Mode == "CREATE")
                    {
                        <label>Description</label>
                        @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm checkDescription", @placeholder = "Description", maxlength = "250" })

                    }
                    @if (Model.Mode == "MODIFY")
                    {
                        <label class="view-title">Description</label>
                        <div class="view-details">

                            @Html.DisplayFor(Model => Model.Description)
                            @Html.HiddenFor(model => Model.Description)
                        </div>
                    }
                </div>
            </div>

            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    @if (Model.Mode == "CREATE")
                    {

                        @if (CurrentUserRoleActions.Create == true)
                        {
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="JoiningCheckListSave('Save')">
                                Save
                            </button>
                        }
                    }
                    @if (Model.Mode == "MODIFY")
                    {
                        @if (CurrentUserRoleActions.Modify == true)
                        {
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="JoiningCheckListSave('Modify')">
                                Modify
                            </button>
                        }
                    }
                    </div>

            </div>
        </div>
    </div>
}