
@model Hrms.Lite.Shared.Master.CoffLeaveRule

<script src="~/js/bootstrap-timepicker.js"></script>

<style>
    [aria-expanded="true"] i {
        -webkit-transform: rotate(90deg);
        -moz-transform: rotate(90deg);
        transform: rotate(90deg);
      
    }
    .newday{
        cursor:pointer;
    }

</style>

<style>
    .ihits-table.table-border table tbody tr th {
        padding: 2px 13px;
    }

    .checkbox.checkbox-outline.checkbox-primary > span {
        background-color: transparent;
        border-color: #7a7a91 !important;
    }

    .ihits-table .form-control {
        border-color: #7a7a91 !important;
        background-color: #fff;
    }

    table {
        border-collapse: collapse !important;
    }

    .clubdropdown {
        height: 32px;
    }

        .clubdropdown .btn-multi-selection {
            border: 1px solid #7a7a91 !important;
        }
</style>
<script>
    $(document).ready(function () {
        debugger;
        //document.getElementById("myCheckBox").disabled = true;
        if ('@Model.CoffCreditApprovalRequired'!='True') {
            $('.order1').addClass('hide');
        }              

    });
</script>
<script>
    $(document).ready(function () {
        /*enableDisableTextBoxes();*/

        $('.multiselectDropdownLeave').multiselect({
            includeSelectAllOption: true,
            /*  enableFiltering: true,*/
            enableCaseInsensitiveFiltering: true,
            includeFilterClearBtn: false,
            



        });



        if ($('#ClubWithOtherLeaves').is(':checked')) {
            //GetClubbingDropdowns();
            $('.clubDropdown').removeClass('hide');
            $('#ClubbingLeaves').multiselect('rebuild')
        }
    });

</script>

