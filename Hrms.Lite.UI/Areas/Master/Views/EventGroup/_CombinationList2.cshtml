@model Hrms.Lite.Shared.Master.EventGroup
@Html.HiddenFor(model => model.Combinations2.Count)
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table vertical-scroll-180">
    <table id="combination2tblID">
        <thead>
            <tr class="table-dark">
                @if (ViewBag.CombinationName == "Employee")
                {
                    <th id="cmb2tID" scope="col">ID</th>
                }
                @if (ViewBag.CombinationName != "--Select--")
                {
                    <th id="cmb2theadID" scope="col">@ViewBag.CombinationName</th>
                }
                else
                {
                    <th scope="col"></th>
                }

                <th scope="col">
                    <div class="checkbox-inline ml-2">
                        <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                            <input type="checkbox"
                                   name="Checkboxes15" id="combination2All" onclick="onAllClick('combination2All','combination2tblID')">
                            <span></span>
                        </label>
                    </div>
                </th>


            </tr>
        </thead>
        <tbody id="combination2tblbodyID">
            <div id="smallspinnerouter2">
                <div id="smallspinnerinner2">
                    <div class="double-bounce1"></div>
                    <div class="double-bounce2"></div>
                </div>
            </div>
            @if (Model.Combinations2 != null && Model.Combinations2.Count > 0)
            {
                @for (int i = 0; i < Model.Combinations2.Count; i++)
                {
                    <tr>
                        @if (ViewBag.CombinationName == "Employee")
                        {
                            <td data-label="ID">@Model.Combinations2[i].EmployeeID</td>
                        }
                        <td data-label="Employee Name">
                                    @Html.HiddenFor(Model => Model.Combinations2[i].Code)
                        @Model.Combinations2[i].Name</td>
                        <td data-label="Action">
                            <div class="checkbox-inline">
                                <label class="checkbox checkbox-outline checkbox-success">
                                    @Html.CheckBoxFor(m => m.Combinations2[i].Applicable, new { @onchange = "onChkBoxClick(this,'combination2All','combination2tblID')')" })
                                    <span></span>
                                </label>
                            </div>
                        </td>

                    </tr>

                }
            }
        </tbody>
    </table>
</div>