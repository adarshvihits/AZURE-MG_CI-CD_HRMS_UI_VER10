@model Hrms.Lite.Shared.Master.EventGroup
<script>
    $(document).ready(function () {
        fillData();
        $('.search-slider-inner').click(function () {

            $('.pop-up').val('');
            $('.pop-up').focus();
            dataTable.search('').draw();
        });

    });

    searchClick = 0;
    function onSearchClick() {
        debugger;
        if (searchClick == 0) {
            searchClick = 1;
            $('.dataTableSearchPopup').addClass('field-width-big');
            /*CursorFocusOnSearch();*/
        }
        else {
            searchClick = 0;
            $('.dataTableSearchPopup').removeClass('field-width-big');
        }
    }
</script>

<div>
    <div class="col-md-12 align-right">

        <div class=" tab-style-button">

            <div class="tab-button-wrap">
                <div class="tab-items select-option">

                    <div class="sraech-slider" style=" margin-top: 0px;">
                        <div class="search-slider-inner">
                            <i class="fa fa-search" onclick="onSearchClick()"></i>
                        </div>
                        <input type="text" id="searchList" class="form-control form-control-sm pop-up dataTableSearchPopup"
                               placeholder="Search Employee" onkeyup="searchRows()">
                    </div>
                </div>
            </div>

        </div>

    </div>

</div>
<div style=" margin-top: 20px;">
    <div class="ihits-table table-border  mobile-responsive-table event_group_popup">

        <table id="addRecipientTable">
            <thead>
                <tr class="table-light">
                    <th scope="col">ID</th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">Designation</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>