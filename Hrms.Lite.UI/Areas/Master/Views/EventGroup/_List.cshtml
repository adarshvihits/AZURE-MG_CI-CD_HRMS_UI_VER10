@model Hrms.Lite.Shared.Master.EventGroup
    <script src="~/js/settings.js"></script>


<div id="one" class="ihits-table table-border hover-color odd-even mobile-responsive-table EventGroup ">
    @Html.HiddenFor(m => m.EventGroupList.Count)
    <table id="eventGrpTable" class="common-table layout-ihits dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Event</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.EventGroupList != null && Model.EventGroupList.Count > 0)
            {

                for (int i = 0; i < Model.EventGroupList.Count; i++)
                {
            <tr>
                <td data-label="Name">
                    @Html.HiddenFor(m => m.EventGroupList[i].EventGroupCode)
                    @Model.EventGroupList[i].Name
                </td>
                <td data-label="Short Name">@Model.EventGroupList[i].ShortName</td>
                <td data-label="Event">@Model.EventGroupList[i].EventName</td>
                <td data-label="Actions">
                    <a data-bs-toggle="tooltip" title="Edit"
                       class="btn btn-icon btn-edit icon-only" onclick="Edit('@Model.EventGroupList[i].EventGroupCode')">
                        <i class="icon-xl fas fa-pencil-alt"></i>
                    </a>
                    <a data-bs-toggle="tooltip" title="Delete" id="deleteskilltype"
                       type="button"
                       class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="confirmDelete('@Model.EventGroupList[i].EventGroupCode')">
                        <i class="icon-xl far fa-trash-alt"></i>
                    </a>
                </td>
            </tr>

                }
            }

        </tbody>
    </table>
</div>