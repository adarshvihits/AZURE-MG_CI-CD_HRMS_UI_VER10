@model Hrms.Lite.Shared.Master.EventGroup
@{ ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>

<script>
    $(document).ready(function () {
        debugger;
        if ("@Model.Mode" == "Modify") {
        var Event = $('#Event_Code').val();
        var IsYOEApplicable = $('#IsYOEApplicable').val();
        if (Event != 1) {
            $("#yearOfExpTab").removeClass('hide');
            if (IsYOEApplicable !== "false") {
                $('.YOExp').removeClass('hide');
            } else {
                $('.YOExp').addClass('hide');
            }
            $("#MultipleCombination1_Code").find("option").eq(1).show();
        }
        else {
            $("#yearOfExpTab").addClass('hide');
            $("#MultipleCombination1_Code").find("option").eq(1).hide();
        }        
    }
    });
</script>

@if (Model.Combinations1 != null && Model.Combinations2 != null)
{
    <script>

    $(document).ready(function () {
        debugger;
        if ("@Model.Mode" == "Modify") {
            if ('@Model.IsMultiCombination' == 1) {
                debugger;
                $('.cmb2').removeClass('hide');
                $("#MultipleCombination1_Code").find("option").eq(1).hide();
                $("#MultipleCombination2_Code").find("option").eq(1).hide();

                $('#totcomb1Count').html(@Model.Combinations1.Count);
                $('#totcomb2Count').html(@Model.Combinations2.Count);
                $('#cmb2theadID').html($('#MultipleCombination2_Code option:selected').text());
                $('#cmb1theadID').html($('#MultipleCombination1_Code option:selected').text());
        }
            else {
                debugger;
                $("#MultipleCombination1_Code").find("option").eq(1).show();
                $('#totcomb1Count').html(@Model.Combinations1.Count);
                $('#cmb1theadID').html($('#MultipleCombination1_Code option:selected').text());
                $('#cmb1tID').html("ID");
                $('.cmb2').addClass('hide');
                }
        }
    });
    </script>

}

<script src="~/scripts/Master/eventGroup.js"></script>

<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Event Group</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a href="@Url.Action("Index", "EventGroup", new { Area = "Master" })" class="">Event Group List</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Event Group
                    </li>
                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>

@Html.HiddenFor(model => model.Mode)
@Html.HiddenFor(model => model.EventGroupCode)
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->


            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body">
                            @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "eventGrpSave" }))
                            {
                                @Html.HiddenFor(model => model.Mode)
                                @Html.HiddenFor(model => model.EventGroupCode)

                                <div class="page_white" style="margin-bottom: 10px !important; padding: 1px 23px 2px !important;">

                                    <div class="row my-2">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label>Name </label>
                                                <span class="Mandatory">*</span>
                                                @Html.TextBoxFor(m => m.Name, new { @class = "form-control form-control-sm", @placeholder = "Name", @maxlength = "100", @onblur = "validate(this,'eventgrp_name')" })
                                            </div>
                                            <span id="eventgrp_name"></span>
                                        </div>
                                        <div class="col-md-3">

                                            <div class="form-group">
                                                <label>Short Name</label>
                                                <span class="Mandatory">*</span>
                                                @Html.TextBoxFor(m => m.ShortName, new { @class = "form-control form-control-sm", @placeholder = "Short Name", @maxlength = "50", @onblur = "validate(this,'shrtName')" })
                                            </div>
                                            <span id="shrtName"></span>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>Event</label>
                                                <span class="Mandatory">*</span>
                                                @Html.DropDownListFor(m => m.Event.Code, (SelectList)ViewBag.Event, "--Select Event--", new { @class = "form-control form-control-sm", @onblur = "validate(this,'evnt')", @onchange = "onEventChange()" })
                                            </div>
                                            <span id="evnt"></span>
                                        </div>
                                    </div>
                                    <div class="row my-2">
                                        <div class="col-md-2 d-flex align-items-center hide" id="yearOfExpTab">
                                            <div class="d-flex align-items-center">
                                                <div>
                                                    Please Tick if Year of Experience is Applicable
                                                </div>
                                                <div class="checkbox-inline" style="margin-left:10px;">
                                                    <label class="checkbox checkbox-outline checkbox-success">
                                                        @Html.CheckBoxFor(m => m.IsYOEApplicable, new { @onclick = "onApplicabilityTick(this)" })
                                                        <span></span>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-2 YOExp hide">
                                            <label>Year of Experience</label>
                                            <span class="Mandatory">*</span>
                                            @Html.TextBoxFor(m => m.Years, new { @class = "form-control form-control-sm", @placeholder = "", @onkeypress = "return onlyNumberKey(event)" })
                                            <span id="yoe_Year"></span>
                                        </div>
                                        <div class="col-md-2 YOExp hide">
                                            <label>Month</label>
                                            <span class="Mandatory">*</span>
                                            @Html.TextBoxFor(m => m.Months, new { @class = "form-control form-control-sm", @placeholder = "", @onkeypress = "return onlyNumberKey(event)" })
                                            <span id="yoe_Month"></span>
                                        </div>

                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>Remarks</label>
                                                @Html.TextAreaFor(m => m.Remarks, new { @class = "form-control form-control-sm", @placeholder = "Remarks", @maxlength = "250" })
                                            </div>
                                        </div>
                                        <div class="col-md-2 d-flex align-items-center">
                                            <div class="d-flex align-items-center">
                                                <div> Active</div>
                                                <label class="switch">
                                                    @Html.CheckBoxFor(model => model.Active, new { @id = "ActiveinactivedocCat" })
                                                    <span class="slider round"></span>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">

                                    <div class="col-md-6">

                                        <!--begin: Search Form-->
                                        <div class="page_white" style="margin-bottom: 1px !important; padding: 1px 23px 2px !important;">


                                            <div class="row tab-style-button">
                                                <div class="tab-button-wrap">
                                                    <div class="tab-items ">
                                                        <div class="form-group filter-combobox pl-2 ">
                                                            <div class="d-flex align-items-center h-100 pt-4">
                                                                <label class="mr-2">Multiple Combinations :</label>
                                                                <div class="radio-inline">

                                                                    <label class="radio radio-outline radio-success">
                                                                        @Html.RadioButtonFor(m => m.IsMultiCombination, "0", new { @onchange = "radiobtnChange(this)" })
                                                                        <span></span>No
                                                                    </label>
                                                                    <label class="radio radio-outline radio-success">
                                                                        @Html.RadioButtonFor(m => m.IsMultiCombination, "1", new { @onchange = "radiobtnChange(this)" })
                                                                        <span></span>Yes
                                                                    </label>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="tab-items d-flex align-items-center pt-2">
                                                        <div class="form-group filter-combobox pl-2 ">
                                                            <div>
                                                                <h4 class="total_count">Total Count:<span id="totcomb1Count"></span></h4>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="tab-items select-option d-flex align-items-center">


                                                        <div class="form-group filter-combobox"
                                                             style="width: 140px; margin: auto;">
                                                            <label>Based On</label>
                                                            @Html.DropDownListFor(m => m.MultipleCombination1.Code, (SelectList)ViewBag.MultipleCombination, "--Select--", new { @class = "form-control form-control-sm", @onchange = "getCombinationDetails(this,0)" })
                                                            <span id="mcombination1"></span>
                                                        </div>
                                                        <div class="sraech-slider mt-0 ml-5">
                                                            <div class="search-slider-inner">
                                                                <i class="fa fa-search" onclick="$('#searchList').focus();"></i>
                                                            </div>
                                                            <input id="searchList" type="text" class="form-control form-control-sm"
                                                                   placeholder="Search Here..." onkeyup="combination1searchRows()">
                                                        </div>



                                                    </div>








                                                </div>
                                            </div>
                                            <!--Table Section-->


                                            <div id="CombinationList1">
                                                @await Html.PartialAsync("_CombinationList1", Model)
                                            </div>

                                        </div>
                                    </div>
                                    <div class="col-md-6 cmb2 hide">

                                        <!--begin: Search Form-->
                                        <div class="page_white" style="margin-bottom: 1px !important; padding: 1px 23px 2px !important;">
                                            <div class="row tab-style-button">
                                                <div class="tab-button-wrap">

                                                    <div class="tab-items">
                                                        <div class="form-group filter-combobox"
                                                             style="width: 140px; margin: auto;">
                                                            <label>Based On</label>
                                                            @Html.DropDownListFor(m => m.MultipleCombination2.Code, (SelectList)ViewBag.MultipleCombination, "--Select--", new { @class = "form-control form-control-sm", @onchange = "getCombinationDetails(this,1)" })
                                                            <span id="mcombination2"></span>
                                                        </div>
                                                    </div>
                                                    <div class="tab-items d-flex align-items-center pt-2">
                                                        <div class="form-group filter-combobox pl-2 ">
                                                            <div>
                                                                <h4 class="total_count">Total Count:<span id="totcomb2Count"></span></h4>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <div class="tab-items select-options d-flex align-items-center">

                                                        <div class="sraech-slider-circular mt-0">
                                                            <div class="search-slider-new">
                                                                <i class="fa fa-search" onclick="$('#searchList2').focus();"></i>
                                                            </div>
                                                            <input id="searchList2" type="text" class="form-controls form-control-sm"
                                                                   placeholder="Search Here..." onkeyup="combination2searchRows()">
                                                        </div>


                                                    </div>


                                                </div>
                                            </div>
                                            <!--Table Section-->
                                            <div id="CombinationList2">
                                                @await Html.PartialAsync("_CombinationList2", Model)
                                            </div>
                                            @*<div class="row">
                            <div class="col-md-12 align-right">
                                <a type="button" class="btn btn-default  mobile-full-width" onclick="GetEmpList()">
                                    Add or Modify Recipient
                                </a>
                            </div>
                        </div>*@

                                        </div>

                                    </div>
                                </div>
                            }
                         <div class="row">
                             <div class="col-md-12 " style="text-align:end;">
                                 <a type="button" class="btn btn-default  mobile-full-width mb-2 mr-5" onclick="GetEmpList()">
                                     Add or Modify Recipient
                                 </a>
                             </div>
                         </div>
                            <div class="page_white" style="margin-bottom: 5px !important; padding: 1px 23px 2px !important;">
                                @using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "AddempRecipientSave" }))
                                {
                                    <div class="row">

                                        <div class="">

                                            <div id="AppliEmp">
                                                @await Html.PartialAsync("_RecipientEmpList", Model)
                                            </div>
                                        </div>
                                    </div>

                                }
                                <div class="row @*card-footer-bottom-fixed*@">
                                    @if (Model.Mode != "Modify")
                                    {
                                        <div class="col-md-12 align-right">
                                            <a type="button" class="btn btn-default  mobile-full-width" onclick="onSaveClick('@Model.Mode')">
                                                Save
                                            </a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="col-md-12 align-right">
                                            <a type="button" class="btn btn-default  mobile-full-width" onclick="onSaveClick('@Model.Mode')">
                                                Modify
                                            </a>
                                        </div>
                                    }

                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>



            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>

<div class="modal fade addRecipientPopup" tabindex="-1" aria-labelledby="myLargeModalLabel" aria-hidden="true" style="display: none;">
    <div class="modal-dialog" style="max-width: 750px;">
        <div class="modal-content popup ">
            <div class="modal-header" style=" padding: 10px 20px;">
                <h5 class="modal-title">
                    Add Recipient
                </h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body" style=" padding: 10px 20px;">
            </div>
            <!-- <end table></end> -->
        </div>
    </div>
</div>