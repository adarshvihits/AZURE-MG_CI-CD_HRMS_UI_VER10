@model Hrms.Lite.Shared.Master.AccountsHead
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>

<script src="~/scripts/Master/allowanceDeductionVsErpAccountHead.js"></script>
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Allowance / Deduction Wise ERP Accounts Head</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Allowance / Deduction Wise ERP Accounts Head
                    </li>

                </ul>
            </div>
        </div>

        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <!--begin: Search Form-->

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items">
                                <span class="btn-title tab1 active" onclick="OnTabClick('tab1','ALLOWANCE')">
                                    Allowances
                                    @*<span class="btn-notification hrcount AllTabCount">@Model.ActiveCount</span>*@
                                </span>
                            </div>
                            <div class="tab-items medium">
                                <span class="btn-title tab2" onclick="OnTabClick('tab2','DEDUCTION')">
                                    Deductions
                                    @*<span class="btn-notification InActiveTabCount">@Model.InactiveCount</span>*@
                                </span>
                            </div>
                            <div class="tab-items low">
                                <span class="btn-title tab3" onclick="OnTabClick('tab3','PROVISIONS_PERKS')">
                                    Provisions & Perks
                                    @*<span class="btn-notification pendingTabCount">@Model.PendingCount</span>*@
                                </span>
                            </div>
                            <div class="tab-items low">
                                <span class="btn-title tab4" onclick="OnTabClick('tab4','LOAN_ADVANCE')">
                                    Loan & Advance
                                    @*<span class="btn-notification pendingTabCount">@Model.PendingCount</span>*@
                                </span>
                            </div>

                            <div class="form-group filter-combobox mt-0" style="width:200px;">

                                @Html.DropDownListFor(m => m.GroupCompanyCode, (SelectList)ViewBag.GroupCompany, "---Group Company---", new { @class = "form-control form-control-sm", @onchange = "loadList();" })
                                <span id="GroupCompany"></span>
                            </div>

                            <div class="tab-items select-option">

                                <div class="form-group filter-combobox filterList">

                                    @Html.DropDownListFor(m => m.Grouping.Code, (SelectList)ViewBag.Groupby,
                                   new { @class = "form-control form-control-sm hide", @onchange = "OnTabClick('tab5','ERP_CODE')" })
                                </div>
                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <a data-bs-toggle="tooltip" title="Export to Excel"
                                   class="btn btn-excel" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>

                            </div>


                        </div>
                    </div>


                    <!-- Table Section -->
                    @using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "AllowanceDeductionAccountheadSave" }))
                    {
                        <div id="allowdedaccountheadList">
                            @await Html.PartialAsync("_List", Model)
                        </div>
                        <!-- Table Setion End -->

                      

                    }

                    <div id="validationDiv"></div>



                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
<!--end::Content-->
