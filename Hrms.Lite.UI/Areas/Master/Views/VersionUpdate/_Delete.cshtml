
@model Hrms.Lite.Shared.Master.VersionUpdate
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
@using (Html.BeginForm("Delete", "VersionUpdate", FormMethod.Post, new { @id = "deleteVersionUpdate" }))
{
    <div id="wageGradeMasterDelete" class="slider-forms slider-forms-open delete">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('delete')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>Version Update</h4>
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Version</label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.Version.Name)

                                @Html.HiddenFor(model => Model.GI)

                                @Html.HiddenFor(model => Model.Mode)

                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Module
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.Module.Name)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Type
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.Type.Name)
                            </div>
                        </div>
                    </div>

                </div>
               
                <div class="row my-3">

                    <div class="col-md-12">
                        <label class="view-title">Description</label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.Description)
                        </div>
                    </div>
                </div>
                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">
                        @if (CurrentUserRoleActions.Delete == true)
                        {
                            <a type="button"
                               data-bs-toggle="tooltip" title="Delete"
                               data-bs-original-title="Delete"
                               class="btn btn-icon btn-delete big-btn float-none" onclick="return confirmDelete('@Model.GI')">
                                <i class="icon-xl far fa-trash-alt"></i>
                            </a>
                        }
                    </div>


                </div>
            </div>
        </div>
    </div>
}