@model Hrms.Lite.Shared.Master.VersionUpdate
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/Master/VersionUpdate.js"></script>



<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->

        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Version Update</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Version Update
                    </li>
                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                    <!--begin: Search Form-->
                    <div class="row tab-style-button">
                        @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "VersionUpdate", enctype = "multipart/form-data" }))
                        {
                            <div class="tab-button-wrap">
                                <div class="form-group filter-combobox pt-2 pl-2">
                                    @Html.DropDownListFor(m => m.Version.Code, (SelectList)ViewBag.VersionName, "--Select Version--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'Version');onChange();" })
                                    <span id="Version"></span>
                                </div>



                                <div class="tab-items select-option highs d-flex ">

                                    <div class="sraech-slider ml-4">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="Module/Description">
                                    </div>
                                    <a data-bs-toggle="tooltip" title="Export to Excel"
                                       class="btn btn-excel" onclick="onExportToExcelClick()">
                                        <i class="icon-xl far fa-file-excel"></i>
                                    </a>
                                    <button type="button" data-bs-toggle="tooltip" title="Import From Excel"
                                            class="btn btn-excel ml-0 import" onclick="validateVersionUpdateDropdowns()">
                                        <i class="fa fa-upload icon-xls" aria-hidden="true"></i>
                                    </button>
                                </div>



                            </div>
                            @*<div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-lg">
                    <div class="modal-content popup">
                        <div class="modal-header" style="padding:10px">
                            <h5 class="modal-title" id="exampleModalLabel">Upload Format</h5>
                            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close" onclick="$('#Unmatchedlist').html('');$('#Excel_FileData').val()">
                                <i aria-hidden="true" class="ki ki-close"></i>
                            </button>
                        </div>

                        <div class="modal-body pt-3">
                            <div class="colums_list pb-1">
                                Please ensure your Excel file contains the following columns with the exact headings. Spelling and case must match precisely for a successful import -

                                Version,
                                Module,
                                Type,
                                Description<br />
                            </div>
                            <div class="row">
                                <div class="col-md-4">
                                    <div class="file-upload-form-group">
                                        <label for="formFileMultiple" class="form-label">
                                            Attach
                                            File
                                            <span class="Mandatory">*</span>
                                        </label>

                                        <div class="file-upload-form mb-1" data-bs-toggle="tooltip" data-bs-original-title=" Only pdf, doc, docx files are
                            allowed , File size less than 1 MB.">
                                            @Html.HiddenFor(model => model.Excel.FileData, new { type = "file", @class = "input-file PreviewImage form-control h-100", @onchange = "onImportExcelClick()" })
                                        </div>


                                    </div>


                                </div>

                            </div>

                            <div id="Unmatchedlist">

                            </div>
                        </div>

                    </div>
                </div>
            </div>*@
                            <div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-lg">
                                    <div class="modal-content popup">
                                        <div class="modal-header" style="padding:10px">
                                            <h5 class="modal-title" id="exampleModalLabel">Upload Format</h5>
                                            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close" onclick="$('#Unmatchedlist').html('');$('#Excel_FileData').val()">
                                                <i aria-hidden="true" class="ki ki-close"></i>
                                            </button>
                                        </div>

                                        <div class="modal-body pt-3">
                                            <div class="colums_list pb-1">
                                                Please ensure your Excel file contains the following columns with the exact headings. Spelling and case must match precisely for a successful import -

                                                <span id="popupMsg">
                                                    Version,
                                                    Module,
                                                    Type,
                                                    Description
                                                </span><br />
                                            </div>
                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="file-upload-form-group">
                                                        <label for="formFileMultiple" class="form-label">
                                                            Attach
                                                            File
                                                            <span class="Mandatory">*</span>
                                                        </label>

                                                        <div class="file-upload-form mb-1">
                                                            <div class="small-btn-group">

                                                                <button type="button" data-bs-toggle="tooltip" data-placement="top" data-bs-original-title="View Image" class="btn btn-icon btn-default"><i class="icon-xl far fa-eye"></i></button>

                                                            </div>
                                                            <input id="File_AbsoluteUri" name="File.AbsoluteUri" type="hidden" value="">
                                                            @Html.HiddenFor(model => model.Excel.FileData, new { type = "file", @class = "input-file PreviewImage form-control h-100", @onchange = "onImportExcelClick()" })
                                                        </div>


                                                    </div>


                                                </div>

                                            </div>

                                            <div id="Unmatchedlist">

                                            </div>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <!-- Table Section -->
                    <div id="VersionUpdateList">
                        @await Html.PartialAsync("_VersionUpdateList")
                    </div>


                    <div id="CreateOrEditSlider">
                        @*@await Html.PartialAsync("_CreateOrEdit")*@
                    </div>
                    <div id="deleteSlider">
                        @*@await Html.PartialAsync("_Delete")*@
                    </div>



                    <div class="modal fade Exit_Questionnaire" tabindex="-1"
                         role="dialog" aria-labelledby="myLargeModalLabel"
                         aria-hidden="true">
                        <div class="modal-dialog" style="max-width:800px;">
                            <div class="modal-content popup " style="height:400px ; ">
                                <div class="modal-header" style="padding:10px">
                                    <h5 class="modal-title" id="exampleModalLabel">
                                        Version
                                    </h5>
                                    <button type="button" class="close"
                                            data-bs-dismiss="modal" aria-label="Close">
                                        <i aria-hidden="true" class="ki ki-close"></i>
                                    </button>
                                </div>
                                <div class="modal-body"></div>

                            </div>

                        </div>

                    </div>
                    <div class="row card-footer-bottom-fixed">
                        <div class="col-md-6">

                            @if (CurrentUserRoleActions.Create == true)
                            {
                                <a class="pl-10" data-bs-toggle="modal" data-target=".Exit_Questionnaire">
                                    <div class="application-btn d-flex align-items-center">
                                        <div class="history-btn">
                                            <img src="/images/add-category-icon (1).png">

                                        </div>
                                        <div class="application-icon" onclick="GetNewVersionPopUp()"> <h3 class="pt-2 pl-3">    Version</h3></div>
                                    </div>
                                </a>
                            }
                            else
                            {
                                <a class="pl-10">
                                    <div class="application-btn d-flex align-items-center">
                                        <div class="history-btn">
                                            <img src="/images/add-category-icon (1).png">

                                        </div>
                                        <div class="application-icon" onclick="swal.fire(MasterPersmissionMsg);"> <h3 class="pt-2 pl-3">   Version</h3></div>
                                    </div>
                                </a>
                            }

                        </div>
                        <div class="col-md-6 align-right">
                            <div class="d-flex align-items-center justify-content-end h-100">

                                @if (CurrentUserRoleActions.Create == true)
                                {
                                    <a type="button"
                                       class="btn btn-default float-right mobile-full-width " onclick="AddNewOrEditClick('CREATE')">
                                        Add
                                        New
                                    </a>
                                }
                                else
                                {
                                    <a type="button"
                                       class="btn btn-default float-right mobile-full-width " onclick="swal.fire(MasterPersmissionMsg);">
                                        Add
                                        New
                                    </a>
                                }
                            </div>


                        </div>


                    </div>
                </div>
            </div>

        </div>
          
    </div>

</div>


