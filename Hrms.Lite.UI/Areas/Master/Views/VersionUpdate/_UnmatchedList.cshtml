@model Hrms.Lite.Shared.Master.VersionUpdate

<script src="~/js/settings.js"></script>
<h2 style="font-size: 16px; padding-top: 15px; ">Upload Failed<span>:Unmatched List</span></h2>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table budget-upload-list">
    <table id="VersionUpdateUnMatched" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
               
                <th scope="col">
                    Remarks
                </th>

            </tr>
        </thead>
        <tbody>
            @if (Model.VersionUpdateList != null && Model.VersionUpdateList.Count > 0)
            {

                for (int i = 0; i < Model.VersionUpdateList.Count; i++)
                {

                    <tr>
                        <td data-label="Remarks">@Model.VersionUpdateList[i].Description</td>

                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<!-- Table Setion End -->