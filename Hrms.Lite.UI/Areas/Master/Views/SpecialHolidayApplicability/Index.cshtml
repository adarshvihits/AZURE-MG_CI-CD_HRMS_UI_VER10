@model Hrms.Lite.Shared.Master.SpecialHolidayApplicability

@{ ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/Master/specialHolidayapplicability.js?v=1"></script>
@*<script>
    $(document).ready(function () {
        GetList();
    });s
</script>*@

<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Special Holiday Applicability
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Special Holiday Applicability
                    </li>

                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--begin::Topbar-->
        <div class="topbar">

        </div>
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">


@using (Html.BeginForm("Save", "SpecialHolidayApplicability", FormMethod.Post, new { id = "SpecialList" }))
{ 
                        <div class="card-body ">
                            <div class="row tab-style-button">
                                <div class="tab-button-wrap">
                                    <div class="tab-items">
                                        <label class="font-weight-bold">Year</label>
                                        <div class="form-group filter-combobox mt-0">
                                            @Html.DropDownListFor(m => m.Year.Code, (SelectList)ViewBag.HolidayYear, "--Select Year--", new { @class = "form-control form-control-sm", @onchange = "OnTypeChange(this,'Type')", @style = "width:130px;" })
                                        </div>
                                        <span id="entrytype" style="bottom: -20px;"></span>
                                    </div>
                                    <div class="tab-items">
                                        <label id="Uploadingtype" class="font-weight-bold">Holiday Type</label>

                                        <div class="form-group filter-combobox mt-0">
                                            @Html.DropDownListFor(m => m.HolidayCode, (SelectList)ViewBag.SpecialHoliday, "--Select Type--", new { @class = "form-control form-control-sm", @style = "width:130px;" , @onchange = "GetList()" })
                                        </div>
                                        <span id="uploadingtype" style="bottom: -20px;"></span>
                                    </div>



                                    <div class="tab-items select-option">

                                        <div class="sraech-slider">
                                            <div class="search-slider-inner">
                                                <i class="fa fa-search"></i>
                                            </div>
                                            <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                                   placeholder="ID/Name" onkeyup="searchRows()">
                                        </div>
                                        <div class="filter-button slider-btn" id="filterForm" data-bs-toggle="tooltip" title="Filter">
                                            <i class="fas fa-filter"></i>
                                            <i class="fas fa-check"></i>
                                        </div>
                                        <a data-bs-toggle="tooltip" title="Export to Excel"
                                           class="btn btn-excel" onclick="ExportToExcel()">
                                            <i class="icon-xl far fa-file-excel"></i>
                                        </a>

                                    </div>


                                </div>
                            </div>
                            <div id="List">
                                @await Html.PartialAsync("_List")
                            </div>

                            <div class="row card-footer-bottom-fixed">

                                <div class="col-md-12 align-right">


                                    <a id="addholiday"
                                       class="btn btn-default float-right mobile-full-width " onclick="Save('Save')">
                                        Save
                                    </a>



                                </div>

                            </div>
                            <div id="AddNewOrEditSlider">

                            </div>
                            <div id="DeleteSlider">

                            </div>
                            <div id="ApproveSlider">

                            </div>
                        </div>
}
                        

                    </div>
                </div>
            </div>

        </div>

    </div>

</div>
<div id="filterSlider">
    @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
</div>
