@model Hrms.Lite.Shared.Master.Activity
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>

    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");



        });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Activity-list pt-1">
    @Html.HiddenFor(m => m.ActivityList.Count)
    <table id="Activitytable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>


            @{
                if (Model.ActivityList != null && Model.ActivityList.Count > 0)
                {
                    for (int i = 0; i < Model.ActivityList.Count; i++)

                    {


                        <tr>

                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Description)
                            @Html.HiddenFor(model => Model.Active)
                            @Html.HiddenFor(m => m.ActivityList[i].EditActive)
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Name">@Model.ActivityList[i].Name</td>
                            <td data-label="Name">@Model.ActivityList[i].ShortName</td>
                            <td data-label="Actions">
                                <div>
                                   
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="Activityedit"
                                           class="btn btn-icon btn-edit icon-only" onclick="AddNewOrEditClick('MODIFY', '@Model.ActivityList[i].GI', '@Model.ActivityList[i].LogGI',@i)">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    
                                    
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deleteActivity"
                                           class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.ActivityList[i].GI', '@Model.ActivityList[i].LogGI','DELETE',@i)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                   
                                </div>
                            </td>
                        </tr>
                    }
                }
            }


        </tbody>
    </table>
</div>