@model Hrms.Lite.Shared.Master.Activity
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>

<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");




        });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Activity-pending pt-1">
    @Html.HiddenFor(m => m.ActivityList.Count)
    <table id="PendingActivityTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>

            @{


                if (Model.ActivityList != null && Model.ActivityList.Count > 0)
                {
                    for (int i = 0; i < Model.ActivityList.Count; i++)

                    {

                        <tr>

                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Code)
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.ApproveMode)
                            @Html.HiddenFor(m => m.ActivityList[i].MakerChecker)

                            <td data-label="Name">@Model.ActivityList[i].Name</td>
                            <td data-label="Name">@Model.ActivityList[i].ShortName</td>
                            <td data-label="Name">@Model.ActivityList[i].Mode</td>
                            <td data-label="Approve">
                                
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="Activityapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.ActivityList[i].GI', '@Model.ActivityList[i].LogGI','APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                
                            </td>

                        </tr>
                    }
                }


            }
        </tbody>
    </table>
</div>