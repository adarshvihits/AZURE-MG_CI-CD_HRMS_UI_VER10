@model Hrms.Lite.Shared.Master.PTGroup
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}

<script src="~/scripts/commonValidators.js"></script>
<script src="~/js/tooltip.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });
</script>
@using (Html.BeginForm("Save", "PTGroup", FormMethod.Post, new { id = "ptgroupsave" }))
{
    <div id="addptgroup" class="slider-forms slider-forms-open AddNewDiv">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddNewDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>PT Group </h4>
            </div>
            <div class="add-padding">

                <div class="row">

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Name</label>
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.LogGI)

                            @Html.HiddenFor(model => Model.GI)
                            @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm PTName", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'PTGName')", maxlength = 120 })
                            <span id="PTGName"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Short Name</label>
                            @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm PTShtName", @placeholder = "Short Name", @onblur = "validate(this,'PTGShortName')", maxlength = 5 })
                            <span id="PTGShortName"></span>
                        </div>
                    </div>
                </div>
                <div class="row my-3">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Slab based on Monthly/Yearly</label>
                            @Html.DropDownListFor(Model => Model.Duration.Code, (SelectList)ViewBag.DurationDropDown, "--Select Duration--", new { @class = "form-control form-control-sm PTDuration", @onblur = "validate(this,'PTGDuration')" })
                            <span id="PTGDuration"></span>
                        </div>
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <div class="d-flex align-items-center">
                            <div>Active</div>
                            <label class="switch" onchange="ActiveInactiveValidation('PTGROUP','@Model.Code')">
                                @Html.HiddenFor(m => Model.Code)
                                @Html.CheckBoxFor(model => model.Active, new { @id = "Activeinactiveptgroup" })
                                <span class="slider round"></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="row my-3">

                    <div class="col-md-12">

                        @if (Model.Mode == "CREATE")
                        {
                            <label>Description</label>
                            @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm PTDescription", @placeholder = "Description", maxlength = 250 })
                            <span id="PTGDescription"></span>
                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            <label class="view-title">Description</label>
                            <div class="view-details">

                                @Html.DisplayFor(Model => Model.Description)
                                @Html.HiddenFor(model => Model.Description)
                            </div>
                        }
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">
                        @if (Model.Mode == "CREATE")
                        {
                            @if (CurrentUserRoleActions.Create == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="PTGroupSave('Save')">
                                    Save
                                </button>
                            }
                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            @if (CurrentUserRoleActions.Modify == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="PTGroupSave('Modify')">
                                    Modify
                                </button>
                            }
                        }
                        </div>

                </div>
            </div>
        </div>
    </div>
}