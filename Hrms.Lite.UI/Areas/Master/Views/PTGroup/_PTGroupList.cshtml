@model Hrms.Lite.Shared.Master.PTGroup
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InActiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");

        //$('#PTGroupList').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');


    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table ptgroup-master-list pt-1">
    @Html.HiddenFor(m => m.PTGroupList.Count)
    <table id="PTGroupList" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Slab based on Monthly/Yearly</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>

            @{
                if (Model.PTGroupList != null && Model.PTGroupList.Count > 0)
                {
                    for (int i = 0; i < Model.PTGroupList.Count; i++)

                    {
                        <tr>
                            @Html.HiddenFor(m => m.PTGroupList[i].EditActive)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Name">@Model.PTGroupList[i].Name</td>
                            <td data-label="Short Name">@Model.PTGroupList[i].ShortName</td>
                            <td data-label="Duration">@Model.PTGroupList[i].Duration.Name</td>
                            <td data-label="Actions">
                                <div>
                                    @if (CurrentUserRoleActions.Modify == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="ptgroupedit"
                                           class="btn btn-icon btn-edit icon-only slider-btn" onclick="onAddNewOrEditClick('MODIFY', '@Model.PTGroupList[i].GI', '@Model.PTGroupList[i].LogGI',@i)">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="ptgroupedit"
                                           class="btn btn-icon btn-edit icon-only slider-btn" onclick="onAddNewOrEditClick('MODIFY', '@Model.PTGroupList[i].GI', '@Model.PTGroupList[i].LogGI',@i);
                                           swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#AddNewOrEditSlider');});">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    @if (CurrentUserRoleActions.Delete == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="ptgroupdelete"
                                           class="btn btn-icon  icon-only mobile-full-width slider-btn btn-delete" onclick="onDeleteClick('@Model.PTGroupList[i].GI','@Model.PTGroupList[i].LogGI','DELETE',@i)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="ptgroupdelete"
                                           class="btn btn-icon  icon-only mobile-full-width slider-btn btn-delete" onclick="onDeleteClick('@Model.PTGroupList[i].GI', '@Model.PTGroupList[i].LogGI', 'DELETE',@i);
                                           swal.fire(MasterPersmissionMsg)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }

            }
        </tbody>
    </table>
</div>