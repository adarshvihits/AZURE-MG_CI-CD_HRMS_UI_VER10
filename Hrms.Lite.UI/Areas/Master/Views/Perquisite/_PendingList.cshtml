@model Hrms.Lite.Shared.Master.Perquisite
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;

<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");



        //$('#PendingdepartmentTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');

        });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table department-pending pt-1">
    @Html.HiddenFor(m => m.PerquisiteList.Count)
    <table id="PendingdepartmentTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>

            @{


                if (Model.PerquisiteList != null && Model.PerquisiteList.Count > 0)
                {
                    for (int i = 0; i < Model.PerquisiteList.Count; i++)

                    {

                        <tr>

                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Code)
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.ApproveMode)
                            @Html.HiddenFor(m => m.PerquisiteList[i].MakerChecker)

                            <td data-label="Name">@Model.PerquisiteList[i].Name</td>
                            <td data-label="Name">@Model.PerquisiteList[i].ShortName</td>
                            <td data-label="Name">@Model.PerquisiteList[i].Mode</td>
                            <td data-label="Approve">
                                
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="departmentapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.PerquisiteList[i].GI', '@Model.PerquisiteList[i].LogGI','APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                
                            </td>

                        </tr>
                    }
                }


            }
        </tbody>
    </table>
</div>