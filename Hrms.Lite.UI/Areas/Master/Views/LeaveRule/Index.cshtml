@model Hrms.Lite.Shared.Master.LeaveRule
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/scripts/Master/LeaveRule.js"></script>
    <div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
        <!--begin::Header-->
        <div id="kt_header" class="header header-fixed">
            <!--begin::Container-->
            <div class="container-fluid d-flex align-items-stretch justify-content-between">
                <!--begin::Header Menu Wrapper-->
                <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                    <!--begin::Header Menu-->
                    <div class="d-flex align-items-baseline flex-wrap mr-5">
                        <h3 class="main-title">Leave Rule </h3>
                        <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                            <li class="breadcrumb-item ">
                                <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                            </li>


                            <li class="breadcrumb-item">
                                Leave Rule
                            </li>

                        </ul>
                    </div>
                </div>
                <!--begin::Topbar-->
                <!--end::Topbar-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Header-->
        <!--begin::Content-->
        <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
            <!--begin::Entry-->
            <div class="d-flex flex-column-fluid">
                <!--begin::Container-->
                <div class="container full-width">
                    <!--begin::Dashboard-->
                    <!--begin::Row-->



                    <div class="card card-custom height-100per">

                        <div class="card-body">
                            <div class="row tab-style-button">
                                <div class="tab-button-wrap align-items-center">

                                    <div class="tab-items">

                                        <div class="row-outer ">
                                            <div class="form-group">
                                                @*<label>Leave Group </label>*@

                                                @Html.DropDownListFor(Model => Model.LeaveGroup.Code, (SelectList)ViewBag.LeaveGrp, "--Select Leave Group--", new { @class = "form-control form-control-sm Cname", @onchange = "GetDetails();validate(this,'LeaveGp')" })
                                                @Html.HiddenFor(Model => Model.LeaveGroup.Code)

                                                <span id="LeaveGp"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tab-items">

                                        <div class="row-outer ">
                                            <div class="form-group">
                                                @*<label>Leave </label>*@

                                                @Html.DropDownListFor(Model => Model.Leave.Code, (SelectList)ViewBag.Leave, "-- Select Leave--", new { @class = "form-control form-control-sm LCode", @onchange = "GetDetails();validate(this,'Leave')" })
                                                @Html.HiddenFor(Model => Model.Leave.Code)
                                                <span id="Leave"></span>
                                            </div>
                                        </div>
                                    </div>









                                    <div class="tab-items select-option">



                                        <button data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                                data-bs-original-title="Export to Excel">
                                            <i class="icon-xl far fa-file-excel " onclick="ExportToExcel()"></i>
                                        </button>
                                      
                                    </div>


                                </div>
                            </div>

                            <div id="LeaveRuleDetailsID">
                                @await Html.PartialAsync("_LeaveRuleDetails", Model)
                            </div>

                            <!-- Table Setion End -->
                            <!--end: Datatable-->

                        </div>
                        <div class="row card-footer-bottom-fixed">

                            <div class="col-md-12 align-right">
                                <button type="button"
                                        class="btn btn-default float-right mobile-full-width" onclick="OnLeaveRuleSaveClick()">
                                    Save
                                </button>

                            </div>
                        </div>


                        <!--end::Row-->
                        <!--begin::Row-->
                        <!--end::Row-->
                        <!--end::Dashboard-->
                    </div>
                    <!--end::Container-->
                </div>
                <!--end::Entry-->

            </div>
            <!--end::Content-->



        </div>
    </div>
