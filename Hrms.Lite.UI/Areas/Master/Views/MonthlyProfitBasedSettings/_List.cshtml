
@model Hrms.Lite.Shared.Master.MonthlyProfitBasedSettings
<script src="~/js/settings.js"></script>
<script src="~/js/tooltip.js"></script>
<style>
    .dataTables_scrollBody tfoot {
        display: none !important;
    }

    .wid50 {
        width: 50px !important;
    }
</style>
<div class="ihits-table table-border odd-even  mobile-responsive-table profit-based-settings-upload-list">
    @Html.HiddenFor(m => m.MonthlyProfitBasedSettingsList.Count)
    <table id="profitSettingsUploadTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Location</th>
                <th scope="col">Product</th>
                <th scope="col">Percentage</th>

            </tr>
        </thead>
        <tbody>
            @if (Model.MonthlyProfitBasedSettingsList != null && Model.MonthlyProfitBasedSettingsList.Count > 0)
            {

                for (int i = 0; i < Model.MonthlyProfitBasedSettingsList.Count; i++)
                {
            <tr>
                <td data-label="Location">
                    @Model.MonthlyProfitBasedSettingsList[i].Location
                </td>
                <td data-label="product">
                    @Model.MonthlyProfitBasedSettingsList[i].Product
                </td>
                <td data-label="Percentage">
                    @Model.MonthlyProfitBasedSettingsList[i].Percentage
                </td>
            </tr>
                }
            }
        </tbody>
    </table>
</div>