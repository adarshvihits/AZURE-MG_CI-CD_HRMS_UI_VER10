@model Hrms.Lite.Shared.DataBank.Generic.Master.Commitment
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    debugger;

     $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
         $('.pendingTabCount').html("@Model.PendingCount");

         //$('#PendingCommitmentTable').DataTable({
         //    "pageLength": 25,
         //    "language": {
         //        searchPlaceholder: "Search"
         //    }
         //});


         //$('.ihits-table table').removeClass("dataTable no-footer");
         //$(".ihits-table table tr th").removeAttr('style')

    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Commitment-pending pt-1 ">
    @Html.HiddenFor(model => Model.CommitmentList.Count)
    <table id="PendingCommitmentTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Commitment Type</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>

            @{


                if (Model != null && Model.CommitmentList != null && Model.CommitmentList.Count > 0)
                {
                    for (int i = 0; i < Model.CommitmentList.Count; i++)

                    {

                        <tr>
                            @Html.HiddenFor(m => m.CommitmentList[i].MakerChecker)
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Name">@Model.CommitmentList[i].Name</td>
                            <td data-label="Short Name">@Model.CommitmentList[i].ShortName</td>
                            <td data-label="Commitment Type">@Model.CommitmentList[i].CommitmentType</td>
                            <td data-label="Entry Type">@Model.CommitmentList[i].Mode</td>

                            @*<tr>
                                <td data-label="Name">11</td>
                                <td data-label="Short Name">Demo</td>

                                <td data-label="Status">New</td>*@
                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="Commitmentapprove"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.CommitmentList[i].GI','@Model.CommitmentList[i].LogGI','APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="Commitmentapprove"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.CommitmentList[i].GI', '@Model.CommitmentList[i].LogGI', 'APPROVAL',@i);
                                   swal.fire(MasterPersmissionMsg)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                            </td>
                            @*<div id="ApproveSlider" class="hide">
                                    @await Html.PartialAsync("_ApproveOrDelete")

                                </div>*@

                            @*</td>*@
                            <!-- <second></second> -->
                        </tr>
                    }
                }



            }

        </tbody>
    </table>
</div>

