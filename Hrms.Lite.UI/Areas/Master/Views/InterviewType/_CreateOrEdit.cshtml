@model Hrms.Lite.Shared.Master.InterviewType
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
@using (Html.BeginForm("Save", "InterviewType", FormMethod.Post, new { id = "InterviewType-Save" }))
{

    <div id="addinterview" class="slider-forms slider-forms-open AddNewDiv">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddNewDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>
                Interview Type
            </h4>
            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        @Html.HiddenFor(model => Model.Mode)
                        @Html.HiddenFor(model => Model.LogGI)
                        @Html.HiddenFor(model => Model.GI)
                        <label>Name</label>
                        <span class="Mandatory">*</span>
                        @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm IntName", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'InterName')", maxlength = "120" })
                        <span id="InterName"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Short Name</label>
                        <span class="Mandatory">*</span>
                        @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm short", @placeholder = "Short Name", maxlength = "5" })
                        <span id="InterShort"></span>
                    </div>
                </div>
            </div>



            <div class="row my-3">


                <div class="col-md-12 d-flex align-items-center">
                    <div class="d-flex align-items-center">
                        <div> Active</div>
                        <label class="switch" onchange="ActiveInactiveValidation('Interview Type',@Model.Code)">
                            @Html.HiddenFor(m => Model.Code)

                            @Html.CheckBoxFor(model => model.Active, new { @class = "form-control form-control-sm", @id = "Activeinactiveinttype" })

                            <span class="slider round"></span>
                        </label>
                    </div>
                </div>

            </div>



            <div class="row my-3">

                <div class="col-md-12">
                    @if (Model.Mode == "CREATE")
                    {
                        <label>Description</label>
                        @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm IntDescription", @placeholder = "Description", maxlength = "250" })

                    }
                    @if (Model.Mode == "MODIFY")
                    {
                        <label class="view-title">Description</label>
                        <div class="view-details">

                            @Html.DisplayFor(Model => Model.Description)
                            @Html.HiddenFor(model => Model.Description)
                        </div>
                    }
                </div>
            </div>

            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    @if (Model.Mode == "CREATE")
                    {

                        @if (CurrentUserRoleActions.Create == true)
                        {
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="InterviewTypeSave('Save')">
                                Save
                            </button>
                        }
                    }
                    @if (Model.Mode == "MODIFY")
                    {
                        @if (CurrentUserRoleActions.Modify == true)
                        {
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="InterviewTypeSave('Modify')">
                                Modify
                            </button>
                        }
                    }
                    </div>

            </div>
        </div>
    </div>
}