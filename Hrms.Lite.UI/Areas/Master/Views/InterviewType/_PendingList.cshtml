
@model Hrms.Lite.Shared.Master.InterviewType
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");
    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table interview-master-pending pt-1">
    @Html.HiddenFor(m => m.InterviewTypeList.Count)
    <table id="InterviewTypePendingTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.InterviewTypeList != null && Model.InterviewTypeList.Count > 0)
                {
                    for (int i = 0; i < Model.InterviewTypeList.Count; i++)

                    {

                        <tr>
                            @Html.HiddenFor(m => m.InterviewTypeList[i].MakerChecker)
                            <td data-label="Name">@Model.InterviewTypeList[i].Name</td>
                            <td data-label="Short Name">@Model.InterviewTypeList[i].ShortName</td>

                            <td data-label="Status">@Model.InterviewTypeList[i].Mode</td>
                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="interviewapprove"
                                       class="btn btn-icon btn-tick icon-only" onclick="onApproveClick('@Model.InterviewTypeList[i].GI', '@Model.InterviewTypeList[i].LogGI','APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                { 
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="interviewapprove"
                                       class="btn btn-icon btn-tick icon-only" onclick="onApproveClick('@Model.InterviewTypeList[i].GI', '@Model.InterviewTypeList[i].LogGI', 'APPROVAL',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                </td>

                        </tr>
                    }
                }

            }

        </tbody>
    </table>
</div>