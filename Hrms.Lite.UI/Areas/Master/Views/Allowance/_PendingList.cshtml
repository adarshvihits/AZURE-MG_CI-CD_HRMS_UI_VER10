@model Hrms.Lite.Shared.Master.Allowance
@*<script src="~/js/custom.js"></script>*@
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}

<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");
    });


</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table allowance-master-pending pt-1">
    @Html.HiddenFor(model => Model.AllowanceList.Count)
    <table id="PendingAllowanceTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Allowance Type</th>
                <th scope="col">Display order</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>

            @{
                if (Model.AllowanceList != null && Model.AllowanceList.Count > 0)
                {


                    for (int i = 0; i < Model.AllowanceList.Count; i++)
                    {
                        <tr>
                            @Html.HiddenFor(model => Model.GI)

                            <td data-label="Name">
                                @Model.AllowanceList[i].Name
                                @Html.HiddenFor(m => m.AllowanceList[i].MakerChecker)
                            </td>
                            <td data-label="ShortName">@Model.AllowanceList[i].ShortName</td>
                            <td data-label="Allowance Type">@Model.AllowanceList[i].AllowanceType</td>
                            <td data-label="Display Order">@Model.AllowanceList[i].DisplayOrder</td>
                            <td data-label="Entry Type">@Model.AllowanceList[i].Mode</td>
                            <td data-label="Approve">

                                @if (CurrentUserRoleActions.Approve == true)
                                {

                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="allowanceapprove"
                                       class="btn btn-icon btn-tick icon-only" onclick="onApproveClick('@Model.AllowanceList[i].GI', '@Model.AllowanceList[i].LogGI', 'APPROVAL', @i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="allowanceapprove"
                                       class="btn btn-icon btn-tick icon-only" onclick="onApproveClick('@Model.AllowanceList[i].GI', '@Model.AllowanceList[i].LogGI', 'APPROVAL', @i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                            </td>

                        </tr>
                    }
                }


            }

        </tbody>
    </table>
</div>