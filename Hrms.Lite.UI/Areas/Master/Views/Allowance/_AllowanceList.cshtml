@model Hrms.Lite.Shared.Master.Allowance
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}

<script src="~/js/settings.js"></script>

<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");
        });
</script>


<div class="ihits-table table-border hover-color odd-even mobile-responsive-table allowance-master-list pt-1">
    @Html.HiddenFor(model => Model.AllowanceList.Count)
    <table id="AllowanceTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Allowance Type</th>
                <th scope="col">Display Order</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>

            @{
                if (Model.AllowanceList != null && Model.AllowanceList.Count > 0)
                {

                    for (int i = 0; i < Model.AllowanceList.Count; i++)
                    {
                        <tr>
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Active)


                            <td data-label="Name">
                                @Model.AllowanceList[i].Name
                                @Html.HiddenFor(m => m.AllowanceList[i].EditActive)
                            </td>
                            <td data-label="Short Name"> @Model.AllowanceList[i].ShortName</td>
                            <td data-label="Allowance Type"> @Model.AllowanceList[i].AllowanceType</td>
                            <td data-label="Display Order"> @Model.AllowanceList[i].DisplayOrder</td>
                            <td data-label="Actions">
                                <div>
                                    @if (CurrentUserRoleActions.Modify == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="allowanceedit"
                                           class="btn btn-icon btn-edit icon-only ">
                                            <i class="icon-xl fas fa-pencil-alt" onclick="onAddNewOrEditClick('MODIFY', '@Model.AllowanceList[i].GI', '@Model.AllowanceList[i].LogGI',@i)"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="allowanceedit"
                                           class="btn btn-icon btn-edit icon-only ">
                                            <i class="icon-xl fas fa-pencil-alt" onclick="onAddNewOrEditClick('MODIFY', '@Model.AllowanceList[i].GI', '@Model.AllowanceList[i].LogGI',@i);
                                            swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#AddNewOrEditSlider');});"></i>
                                        </a>
                                    }

                                    @if (CurrentUserRoleActions.Delete == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="allowancedelete"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete">
                                            <i class="icon-xl far fa-trash-alt" onclick="onDeleteClick('@Model.AllowanceList[i].GI', '@Model.AllowanceList[i].LogGI', 'DELETE',@i)"></i>
                                        </a>
                                    }
                                    else
                                    { 
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="allowancedelete"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete">
                                            <i class="icon-xl far fa-trash-alt" onclick="onDeleteClick('@Model.AllowanceList[i].GI', '@Model.AllowanceList[i].LogGI', 'DELETE',@i);
                                            swal.fire(MasterPersmissionMsg);"></i>
                                        </a>
                                    }
                                    </div>


                            </td>
                        </tr>
                    }
                }
            }

        </tbody>
    </table>
</div>