@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "approveAllowance" }))
{
    <div id="allowanceapprove" class="slider-forms slider-forms-open ApproveDiv">
        <div class="slider-inner-style  new-inner-style">
            <div class="slider-form-close">
                <i class="ki ki-close icon-xs text-muted" onclick="CloseSlider('ApproveDiv')"></i>
            </div>
            <div class="location-slider">
                <h4>Allowance</h4>
            </div>
            <div class="add-padding">

                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Name</label>
                            <div class="view-details">
                                @Html.DisplayFor(model => model.Name)
                                @Html.HiddenFor(model => model.LogGI)
                                @Html.HiddenFor(model => model.GI)
                                @Html.HiddenFor(model => Model.DisplayOrder)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Short
                                Name
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => model.ShortName)
                            </div>
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Allowance Type</label>
                            <div class="view-details">
                                @Html.DisplayFor(model => model.AllowanceTypeCbo.Name)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Applicable For
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => model.ApplicableFor.Name)
                            </div>
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Display Order</label>
                            <div class="view-details">
                                @Html.DisplayFor(model => model.DisplayOrder)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Salary Component
                            </label>
                            <div class="view-details">
                                @if (Model.SalaryComponent == true)
                                {

                                    <button type="button" class="btn btn-icon btn-tick">
                                        <i class="icon-xl fas fa-check"></i>
                                    </button>

                                }
                                else
                                {
                                    <button type="button" class="btn btn-icon btn-close">
                                        <i class="icon-xl fas fa-times"></i>

                                    </button>
                                }
                            </div>
                        </div>
                      

                    </div>

                </div>
                <div class="row ">

                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Active</label>
                            <div class="view-details">
                                @if (Model.Active == true)
                                {

                                    <button type="button" class="btn btn-icon btn-tick">
                                        <i class="icon-xl fas fa-check"></i>
                                    </button>

                                }
                                else
                                {
                                    <button type="button" class="btn btn-icon btn-close">
                                        <i class="icon-xl fas fa-times"></i>

                                    </button>
                                }
                            </div>

                        </div>

                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Display Type</label>
                            <div class="view-details">
                                @Html.DisplayFor(model => model.DisplayType.Name)
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row m-0 ">
                    <h4 class="pt-1">Set Applicability</h4>
                    <div class="ihits-table table-border w-100 hover-color odd-even vertical-scroll-150   allowance-master-new">
                        <table class="mb-0">
                            <thead>
                                <tr class="table-light">
                                    <th scope="col">Particular</th>
                                    <th scope="col">Type</th>
                                    <th scope="col">Applicability</th>
                                    <th scope="col">%</th>

                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Deduction_SetApplicability != null && Model.Deduction_SetApplicability.Count > 0)
                                {

                                    for (int i = 0; i < Model.Deduction_SetApplicability.Count; i++)
                                    {
                                        <tr>
                                            <td data-label="Particular">
                                                @Html.HiddenFor(m => m.Deduction_SetApplicability[i].Particular)
                                                @Html.HiddenFor(m => m.Deduction_SetApplicability[i].Type)
                                                @Html.HiddenFor(m => m.Deduction_SetApplicability[i].DeductionCode)
                                                @Model.Deduction_SetApplicability[i].Particular
                                            </td>
                                            <td data-label="Type">@Model.Deduction_SetApplicability[i].Type</td>
                                            <td data-label="Applicability">
                                                <div class="d-flex justify-content-center">
                                                    @if (Model.Deduction_SetApplicability[i].Applicability == true)
                                                    {

                                                        <button type="button" class="btn btn-icon btn-tick">
                                                            <i class="icon-xl fas fa-check"></i>
                                                        </button>

                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="btn btn-icon btn-close">
                                                            <i class="icon-xl fas fa-times"></i>

                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                            <td data-label="%">
                                                @Model.Deduction_SetApplicability[i].Percentage
                                            </td>
                                        </tr>
                                    }
                                }

                            </tbody>

                        </table>
                    </div>
                </div>
                <div class="row my-3">

                    <div class="col-md-12">
                        <label class="view-title">Description</label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.Description)
                        </div>
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">
                        @if (CurrentUserRoleActions.Approve == true)
                        {
                            <button type="button" class="btn btn-danger  mobile-full-width" onclick="return confirmReject('@Model.GI','@Model.LogGI')">
                                Reject
                            </button>
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="return confirmApprove('@Model.GI','@Model.LogGI')">
                                Approve
                            </button>
                        }
                        </div>


                </div>
            </div>
        </div>
    </div>
}