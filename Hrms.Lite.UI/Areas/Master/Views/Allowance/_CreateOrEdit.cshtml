@using (Html.BeginForm("Save", "Allowance", FormMethod.Post, new { id = "AllowanceSave" }))
{
    <div id="allowanceedit" class="slider-forms slider-forms-open AddNewOrEdit">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close">
                <i class="ki ki-close icon-xs text-muted" onclick="CloseSlider('AddNewOrEdit')"></i>
            </div>
            <div class="location-slider">
                <h4>
                    Allowance
                </h4>
            </div>
            <div class="add-padding">

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Name</label><span class="Mandatory">*</span>
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)

                            @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'AllowanceName')", maxlength = "120" })
                            <span id="AllowanceName"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Short Name
                            </label>
                            <span class="Mandatory">*</span>
                            @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm AShtName", @placeholder = "Short Name", @onblur = "validate(this,'AllowanceShort')", maxlength = "5" })
                            <span id="AllowanceShort"></span>
                        </div>
                    </div>
                </div>
                <div class="row  my-3">

                    <div class="col-md-6">

                        <div class="form-group">
                            <label>Allowance Type</label>
                            <span class="Mandatory">*</span>
                            @Html.DropDownListFor(m => m.AllowanceTypeCbo.Code, (SelectList)ViewBag.AllowanceType, "--Select--", new { @class = "form-control form-control-sm", @onblur = "validate(this,'AllowanceType')" })
                            <span id="AllowanceType"></span>

                            @*<select class="form-control form-control-sm "
                                        id="exampleSelects">
                                    <option>Select</option>
                                    <option>Demo</option>
                                    <option>Demo</option>
                                </select>*@
                        </div>

                    </div>
                    <div class="col-md-6">

                        <div class="form-group">
                            <label>Applicable For</label>
                            <span class="Mandatory">*</span>
                            @Html.DropDownListFor(m => m.ApplicableFor.Code, (SelectList)ViewBag.ApplicableFor, "--Select--", new { @class = "form-control form-control-sm", @onblur = "validate(this,'Applicable')" })
                            <span id="Applicable"></span>


                            @*<select class="form-control form-control-sm "
                                        id="exampleSelects">
                                    <option>Select</option>
                                    <option>Demo</option>
                                    <option>Demo</option>
                                </select>*@
                        </div>

                    </div>
                </div>
                <div class="row  my-3">

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Display Order</label>
                            <span class="Mandatory">*</span>
                            @*<input type="text"
                                class="form-control form-control-sm"
                                placeholder="Display Order">*@
                            @Html.TextBoxFor(Model => Model.DisplayOrder, new { @class = "form-control form-control-sm", @placeholder = "Display Order", @onblur = "validate(this,'Display')", maxlength = "3" })
                            <span id="Display"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label></label>
                            <div class="d-flex ">
                                <label>Salary Component</label>
                                <div class="checkbox-inline"
                                     style="padding-left: 45px;">
                                    <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                        @*<input type="checkbox"
                                            name="Checkboxes16">*@
                                        @Html.CheckBoxFor(m => m.SalaryComponent)
                                        <span></span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
                <div>
                    <div class="col-md-6">

                        <div class="form-group">
                            <label>Display Type</label>
                            <span class="Mandatory">*</span>
                            @Html.DropDownListFor(m => m.DisplayType.Code, (SelectList)ViewBag.DisplayType, "--Select--", new{ @class = "form-control form-control-sm",@onchange = "validateById(this, 'DisplayType')" })

                            <span id="DisplayType"></span>

                         
                        </div>

                    </div>
                </div>

                <div class="row my-3">

                    <div class="col-md-12 d-flex align-items-center">

                        <div class="d-flex align-items-center">
                            <div>Active</div>
                            <label class="switch"  onchange="ActiveInactiveValidation('ALLOWANCE', '@Model.Code')">

                                @*<input type="checkbox" checked="">*@
                                @Html.HiddenFor(m=>Model.Code)
                                @Html.CheckBoxFor(m => m.Active,new { @id= "activeInactiveAllowance" })
                                <span class="slider round"></span>
                            </label>
                        </div>
                    </div>

                </div>
                <div class="row m-0 ">
                    <h4 class="pt-3">Set Applicability</h4>
                    <div class="ihits-table table-border w-100 hover-color odd-even vertical-scroll-150  allowance-master-new">
                        <table class="mb-0">
                            <thead>
                                <tr class="table-light">
                                    <th scope="col">Particular</th>
                                    <th scope="col">Type</th>
                                    <th scope="col">Applicability</th>
                                    <th scope="col">%</th>

                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Deduction_SetApplicability != null && Model.Deduction_SetApplicability.Count > 0)
                                {

                                    for (int i = 0; i < Model.Deduction_SetApplicability.Count; i++)
                                    {
                                        <tr>


                                            <td data-label="Particular">
                                                @Html.HiddenFor(m => m.Deduction_SetApplicability[i].Particular)
                                                @Html.HiddenFor(m => m.Deduction_SetApplicability[i].Type)
                                                @Html.HiddenFor(m => m.Deduction_SetApplicability[i].DeductionCode)
                                                @Model.Deduction_SetApplicability[i].Particular
                                            </td>
                                            <td data-label="Type">@Model.Deduction_SetApplicability[i].Type</td>
                                            <td data-label="Applicability">
                                                <div class="checkbox-inline justify-content-center">
                                                    <label class="checkbox checkbox-outline checkbox-success">
                                                        @*<input type="checkbox" name="Checkboxes15">*@
                                                        @Html.CheckBoxFor(m => m.Deduction_SetApplicability[i].Applicability)
                                                        <span></span>
                                                    </label>
                                                </div>
                                            </td>
                                            <td data-label="%">
                                                @*<input type="text" class="form-control form-control-sm" placeholder="">*@
                                                @Html.TextBoxFor(m => m.Deduction_SetApplicability[i].Percentage, new { @class = "form-control form-control-sm", @placeholder = "" })
                                            </td>
                                        </tr>
                                    }
                                }


                            </tbody>

                        </table>
                    </div>
                </div>

                <div class="row my-3">

                    <div class="col-md-12">
                        @*<label class="view-title">Description</label>
                            <div class="view-details">
                                Lorem ipsum
                                dolor sit amet, consectetur
                                adipiscing elit. Cras sed est metus.
                            </div>*@
                        @if (Model.Mode == "CREATE")
                        {
                            <label>Description</label>
                            @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm ADescription", @placeholder = "Description", maxlength = "250" })

                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            <label class="view-title">Description</label>
                            <div class="view-details">
                                @Html.HiddenFor(Model => Model.Description)
                                @Html.DisplayFor(Model => Model.Description)

                            </div>
                        }
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12 align-right">
                        @if (Model.Mode == "CREATE")
                        {
                            @if (CurrentUserRoleActions.Create == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="onAllowanceSaveClick('Save')">
                                    Save
                                </button>
                            }
                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            @if (CurrentUserRoleActions.Modify == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="onAllowanceSaveClick('Modify')">
                                    Modify
                                </button>
                            }
                        }

                        </div>
                </div>
            </div>
        </div>
    </div>
}
