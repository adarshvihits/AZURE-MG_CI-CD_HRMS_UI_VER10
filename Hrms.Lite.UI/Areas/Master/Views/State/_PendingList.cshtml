@model Hrms.Lite.Shared.DataBank.Generic.Master.State
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");

        //$('#PendingStateTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');


    });
</script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table statemaster-pending p-1">
    @Html.HiddenFor(m => m.StateList.Count)
    <table id="PendingStateTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Country</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>
            @{


                if (Model.StateList != null && Model.StateList.Count > 0)
                {

                    for (int i = 0; i < Model.StateList.Count; i++)
                    {

                        <tr>
                            <td data-label="Name">@Model.StateList[i].Name</td>
                            @Html.HiddenFor(m => m.StateList[i].MakerChecker)
                            <td data-label="Short Name">@Model.StateList[i].ShortName</td>
                            <td data-label="Country">@Model.StateList[i].CountryName</td>
                            <td data-label="Entry Type">@Model.StateList[i].Mode</td>
                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="statemasterapprove"
                                       class="btn btn-icon btn-tick icon-only" onclick="onApproveClick('@Model.StateList[i].GI', '@Model.StateList[i].LogGI', 'APPROVAL', @i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="statemasterapprove"
                                       class="btn btn-icon btn-tick icon-only" onclick="onApproveClick('@Model.StateList[i].GI', '@Model.StateList[i].LogGI', 'APPROVAL', @i);
                                       swal.fire(MasterPersmissionMsg)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }

            }

        </tbody>
    </table>
</div>