@model Hrms.Lite.Shared.DataBank.Generic.Master.State
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");

        //$('#StateTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');


    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table statemaster-list pt-1">
    @Html.HiddenFor(m => m.StateList.Count)
    <table id="StateTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Country</th>
                @*<th scope="col">LogGi</th>*@
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>

            @{
                if (Model.StateList != null && Model.StateList.Count > 0)
                {

                    for (int i = 0; i < Model.StateList.Count; i++)
                    {
                        <tr>
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Description)
                            <td data-label="Name">@Model.StateList[i].Name</td>
                            @Html.HiddenFor(m => m.StateList[i].EditActive)
                            <td data-label="Short Name">@Model.StateList[i].ShortName</td>
                            <td data-label="Country">@Model.StateList[i].CountryName</td>
                            @*<td>@item.LogGI</td>*@
                            <td data-label="Actions">
                                <div>
                                    @if (CurrentUserRoleActions.Modify == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="statemasteredit"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY', '@Model.StateList[i].GI', '@Model.StateList[i].LogGI',@i)">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="statemasteredit"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY', '@Model.StateList[i].GI', '@Model.StateList[i].LogGI',@i);
                                           swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#CreateOrEditSlider');});">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    @if (CurrentUserRoleActions.Delete == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deletestatemaster"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.StateList[i].GI', '@Model.StateList[i].LogGI', 'DELETE',@i)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deletestatemaster"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.StateList[i].GI', '@Model.StateList[i].LogGI', 'DELETE',@i);
                                            swal.fire(MasterPersmissionMsg)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }


            }


        </tbody>
    </table>
</div>
