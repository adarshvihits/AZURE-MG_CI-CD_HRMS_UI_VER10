@model Hrms.Lite.Shared.DataBank.Generic.Master.State
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script>
    function test(sender) {
        var code = $(sender).val();
        $("Country_Code").val(code);
    }
</script>
<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });
</script>

@using (Html.BeginForm("Save", "State", FormMethod.Post, new { id = "StateSave" }))
{
    <div id="statemasteredit" class="slider-forms slider-forms-open AddNewStateDiv">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddNewStateDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>State </h4>
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.Code)

                            @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm sName", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'StateName')", maxlength = 120 })
                            <span id="StateName"></span>

                            @*<input type="text"
                                class="form-control form-control-sm"
                                placeholder="Name">*@
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Short Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm sShtName", @placeholder = "Short Name", @onblur = "validate(this,'StateShortName')", maxlength = 5 })
                            <span id="StateShortName"></span>
                            @*<input type="text"
                                class="form-control form-control-sm"
                                placeholder="Short Name">*@
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Country
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.DropDownListFor(Model => Model.Country.Code, (SelectList)ViewBag.CountryDropdown, "--Select Country--", new { @class = "form-control form-control-sm stateCountry", @onblur = "validate(this,'CountryName')" })
                            <span id="CountryName"></span>
                            @*<select class="form-control form-control-sm "
                                        id="exampleSelects">
                                    <option>India</option>
                                    <option>Category2</option>
                                </select>*@
                        </div>
                    </div>
                    <div class="col-md-6 d-flex align-items-center">
                        <div class="d-flex align-items-center">
                            <div>Active</div>
                            <label class="switch" onchange="ActiveInactiveValidationState('STATE', '@Model.Code')">
                                @Html.HiddenFor(m=>Model.Code)
                                @Html.CheckBoxFor(model => model.Active,new { @id="activeinactivestate"})
                                @*<input type="checkbox" checked>*@
                                <span class="slider round"></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="row my-3">

                    <div class="col-md-12">
                        @*<label class="view-title">Description</label>*@
                        <div class="view-details">
                            @if (Model.Mode == "CREATE")
                            {
                                <label>Description</label>
                                @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm sDescription", @placeholder = "Description", maxlength = 250 })
                                <span id="StateDescription"></span>
                            }
                            @if (Model.Mode == "MODIFY")
                            {
                                <label class="view-title">Description</label>
                                <div class="view-details">

                                    @Html.DisplayFor(Model => Model.Description)
                                    @Html.HiddenFor(model => Model.Description)
                                </div>
                            }
                            <span id="StateDescription" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12 align-right">
                        @if (Model.Mode == "CREATE")
                        {

                            @if (CurrentUserRoleActions.Create == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="StateSaveClick('Save')">
                                    Save
                                </button>
                            }
                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            @if (CurrentUserRoleActions.Modify == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="StateSaveClick('Modify')">
                                    Modify
                                </button>
                            }
                        }
                        </div>
                </div>
            </div>
        </div>
    </div>
}