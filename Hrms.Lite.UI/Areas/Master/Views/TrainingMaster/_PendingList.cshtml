@model Hrms.Lite.Shared.Master.TrainingMaster
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
        $(document).ready(function () {
            debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");

            //$('#trainingMasterPendingTable').DataTable({
            //    "pageLength": 25,
            //    "language": {
            //        searchPlaceholder: "Search"
            //    }
            //});


            //$('.ihits-table table').removeClass("dataTable no-footer");
            //$(".ihits-table table tr th").removeAttr('style')

        });</script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table training-pending">
    @Html.HiddenFor(m => m.TrainingMasterList.Count)
    <table id="trainingMasterPendingTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                @*<th scope="col">Short Name</th>*@
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.TrainingMasterList != null && Model.TrainingMasterList.Count > 0)
            {

                for (int i = 0; i < Model.TrainingMasterList.Count; i++)
                {
                    @Html.HiddenFor(m => m.TrainingMasterList[i].GI)
                    @*@Html.HiddenFor(m => m.TrainingMasterList[i].LogGI)*@

                    <tr>
                        <td data-label="Name">@Model.TrainingMasterList[i].Name</td>
                        @*<td data-label="Short Name">@Model.TrainingMasterList[i].ShortName</td>*@
                        @Html.HiddenFor(m => m.TrainingMasterList[i].MakerChecker)
                        <td data-label="Status">@Model.TrainingMasterList[i].EntryType</td>
                        <td data-label="Approve">
                            @if (CurrentUserRoleActions.Approve == true)
                            {
                                <a data-bs-toggle="tooltip" title="Approve"
                                   id="trainingapprove"
                                   class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.TrainingMasterList[i].GI', '@Model.TrainingMasterList[i].LogGI','APPROVAL',@i)">
                                    <i class="icon-xl far fa-check-circle"></i>
                                </a>
                            }
                            else
                            { 
                                <a data-bs-toggle="tooltip" title="Approve"
                                   id="trainingapprove"
                                   class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.TrainingMasterList[i].GI', '@Model.TrainingMasterList[i].LogGI', 'APPROVAL',@i);
                                   swal.fire(MasterPersmissionMsg);">
                                    <i class="icon-xl far fa-check-circle"></i>
                                </a>
                            }
                                <!-- Approve Slider -->
                                <!-- Approve Slider end-->
                            </td>
                        <!-- <second></second> -->
                    </tr>
                }
            }
            <div id="approveTraining">

            </div>
        </tbody>
    </table>
</div>