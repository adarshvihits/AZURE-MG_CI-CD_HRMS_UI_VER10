@model Hrms.Lite.Shared.Master.TrainingMaster
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
@using (Html.BeginForm("Delete", "Allowance", FormMethod.Post, new { @id = "delete-Training" }))
{
    <div id="deletetrainingmaster" class="slider-forms slider-forms-open deleteTraining">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('deleteTraining')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>Training</h4>
            @Html.HiddenFor(m => m.GI)
            @Html.HiddenFor(m => m.LogGI)
            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Name</label>
                        <div class="view-details">
                            @Model.Name
                        </div>
                    </div>
                </div>
                @*<div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Short
                            Name
                        </label>
                        <div class="view-details">
                            @Model.ShortName
                        </div>
                    </div>
                </div>*@

            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Type
                        </label>
                        <div class="view-details">
                            @Model.TrainingType.Name
                        </div>
                    </div>

                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="view-title">Assessment Mode</label>
                        <div class="view-details">
                            @Model.AssesmentMode.Name
                        </div>

                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label class="view-title">Training Category</label>
                        <div class="view-details">
                            @Model.TrainingCategory.Name
                        </div>

                    </div>
                </div>

            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Active</label>
                        <div class="view-details">
                            @if (Model.Active)
                            {

                                <button type="button"
                                        class="btn btn-icon btn-tick">
                                    <i class="icon-xl fas fa-check"></i>
                                </button>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-icon btn-close">
                                    <i class="icon-xl fas fa-times"></i>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="row my-3">

                <div class="col-md-12">
                    <label class="view-title">Description</label>
                    <div class="view-details">
                        @Model.Description
                    </div>
                </div>
            </div>

            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    @if (CurrentUserRoleActions.Delete == true)
                    {
                        <a type="button" data-bs-toggle="tooltip" title="Delete" data-bs-original-title="Delete"
                           class="btn btn-icon btn-delete big-btn float-none" onclick="return confirmDelete('@Model.GI','@Model.LogGI')">
                            <i class="icon-xl far fa-trash-alt"></i>
                        </a>
                    }
                    </div>


            </div>
        </div>
    </div>
}