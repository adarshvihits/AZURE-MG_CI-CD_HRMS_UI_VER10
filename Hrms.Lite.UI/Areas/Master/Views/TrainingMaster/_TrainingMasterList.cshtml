@model Hrms.Lite.Shared.Master.TrainingMaster
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
        $(document).ready(function () {
            debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");

            //$('#trainingMasterTable').DataTable({
            //    "pageLength": 25,
            //    "language": {
            //        searchPlaceholder: "Search"
            //    }
            //});


            //$('.ihits-table table').removeClass("dataTable no-footer");
            //$(".ihits-table table tr th").removeAttr('style')

        });</script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table training-list">
    @Html.HiddenFor(m => m.TrainingMasterList.Count)
    <table id="trainingMasterTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                @*<th scope="col">Short Name</th>*@
                <th scope="col">Category</th>
                <th scope="col">Category Type</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.TrainingMasterList != null && Model.TrainingMasterList.Count > 0)
            {

                for (int i = 0; i < Model.TrainingMasterList.Count; i++)
                {

            <tr>
                @Html.HiddenFor(Model => Model.TrainingMasterList[i].GI)
                @Html.HiddenFor(Model => Model.TrainingMasterList[i].LogGI)
                @Html.HiddenFor(m => m.TrainingMasterList[i].EditActive)
                <td data-label="Name">@Model.TrainingMasterList[i].Name</td>
                @*<td data-label="Short Name">@Model.TrainingMasterList[i].ShortName</td>*@
                <td data-label="Short Name">@Model.TrainingMasterList[i].TrainingCategory.Name</td>
                <td data-label="Short Name">@Model.TrainingMasterList[i].TrainingType.Name</td>
                <td data-label="Actions">
                    <div>
                        @if (CurrentUserRoleActions.Modify == true)
                        {
                            <a data-bs-toggle="tooltip" title="Edit"
                               id="trainingmasteredit"
                               class="btn btn-icon btn-edit icon-only" onclick="onAddNewOrEditClick('MODIFY', '@Model.TrainingMasterList[i].GI', '@Model.TrainingMasterList[i].LogGI',@i)">
                                <i class="icon-xl fas fa-pencil-alt"></i>
                            </a>
                        }
                        else
                        {
                            <a data-bs-toggle="tooltip" title="Edit"
                               id="trainingmasteredit"
                               class="btn btn-icon btn-edit icon-only" onclick="onAddNewOrEditClick('MODIFY', '@Model.TrainingMasterList[i].GI', '@Model.TrainingMasterList[i].LogGI',@i);
                                       swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#training-master-create');});">
                                <i class="icon-xl fas fa-pencil-alt"></i>
                            </a>
                        }
                        <!-- Edit Slider start-->
                        <!-- Edit Slider  end-->
                        <!-- delete Slider  start-->
                        @if (CurrentUserRoleActions.Delete == true)
                        {
                            <a data-bs-toggle="tooltip" title="Delete"
                               id="deletetrainingmaster"
                               class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.TrainingMasterList[i].GI', '@Model.TrainingMasterList[i].LogGI', 'DELETE',@i)">
                                <i class="icon-xl far fa-trash-alt"></i>
                            </a>
                        }
                        else
                        {
                            <a data-bs-toggle="tooltip" title="Delete"
                               id="deletetrainingmaster"
                               class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.TrainingMasterList[i].GI', '@Model.TrainingMasterList[i].LogGI', 'DELETE',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                <i class="icon-xl far fa-trash-alt"></i>
                            </a>
                        }
                    </div>

                    <!-- <end delete section></end> -->
                </td>
            </tr>
                }
            }

        </tbody>
    </table>
    <div id="editTraining">
    </div>
</div>