
@model Hrms.Lite.Shared.Master.LeaveGroup
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/scripts/commonValidators.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });
</script>
@using (Html.BeginForm("Create", "Leavegroup", FormMethod.Post, new { id = "saveLeaveGroup" }))
{
    <div id="addleavegroup" class="slider-forms slider-forms-open AddNewDiv">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddNewDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>
                Leave Group
            </h4>
            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Name
                            <span class="Mandatory">*</span>
                        </label>
                        @Html.HiddenFor(model => Model.Mode)
                        @Html.HiddenFor(model => Model.GI)
                        @Html.HiddenFor(model => Model.Code)

                        @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm LGName", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'LGroupName')", maxlength = "120" })
                        <span id="LGroupName"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Short Name
                            <span class="Mandatory">*</span>
                        </label>
                        @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm LGShortName", @placeholder = "Short Name", @onblur = "validate(this,'LGShrtName')", maxlength = "5" })
                        <span id="LGShrtName"></span>
                    </div>

                </div>

            </div>
            <div class="row my-3">


                <div class="col-md-12 d-flex align-items-center">
                    <div class="d-flex align-items-center">
                        <div> Active </div>
                        <label class="switch" onchange="ActiveInactiveValidationLeaveGroup('LEAVE_GROUP', '@Model.Code')">
                            @Html.HiddenFor(m=>Model.Code)
                            @Html.CheckBoxFor(Model => Model.Active,new { @id="activeinactivegroup"})
                            <span class="slider round"></span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="row my-3">

                <div class="col-md-12">
                    <div class="view-details">
                        @*<label class="view-title">Description</label>*@

                        @if (Model.Mode == "CREATE")
                        {
                            <label>Description</label>
                            @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm GDescription", @placeholder = "Description", maxlength = "250" })
                            @Html.HiddenFor(model => Model.Description)

                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            <label class="view-title">Description</label>
                            @Html.DisplayFor(Model => Model.Description, new { })
                            @Html.HiddenFor(model => Model.Description)


                        }
                    </div>
                </div>
            </div>

            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    @if (Model.Mode == "CREATE")
                    {
                        @if (CurrentUserRoleActions.Create == true)
                        {
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="SaveLeaveGroup('Save')">
                                Save
                            </button>
                        }
                    }
                    @if (Model.Mode == "MODIFY")
                    {
                        @if (CurrentUserRoleActions.Modify == true)
                        {
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="SaveLeaveGroup('Modify')">
                                Modify
                            </button>
                        }
                    }
                    </div>

            </div>
        </div>
    </div>
}