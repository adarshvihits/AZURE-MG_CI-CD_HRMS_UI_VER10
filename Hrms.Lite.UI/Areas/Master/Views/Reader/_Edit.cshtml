@model Hrms.Lite.Shared.Master.Reader
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "readerEdit" }))
{
    <div id="readeredit" class="slider-forms slider-forms-open editSlider">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('editSlider')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>
                Reader
            </h4>

            @Html.HiddenFor(m => m.GI)
            @Html.HiddenFor(m => m.LogGI)
            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>User Code</label><span class="Mandatory">*</span>
                        @Html.TextBoxFor(m => m.UserCode, new { @class = "form-control form-control-sm", @placeholder = "User Code", @onblur = "validate(this,'UsrCod')" })
                        <span id="UsrCod"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Reader Name</label><span class="Mandatory">*</span>
                        @Html.TextBoxFor(m => m.ReaderName, new { @class = "form-control form-control-sm", @placeholder = "Reader Name", @onblur = "validate(this,'ReadName')" })
                        <span id="ReadName"></span>
                    </div>
                </div>
            </div>

            <div class="row my-3">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>IP Address</label><span class="Mandatory">*</span>
                        @Html.TextBoxFor(m => m.IPAddress, new { @class = "form-control form-control-sm", @placeholder = "IP Address", @onblur = "validate(this,'IP')" })
                        <span id="IP"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Port</label><span class="Mandatory">*</span>
                        @Html.TextBoxFor(m => m.Port, new { @class = "form-control form-control-sm", @placeholder = "Port", @onblur = "validate(this,'portNo')" })
                        <span id="portNo"></span>
                    </div>
                </div>
            </div>

            <div class="row my-3">


                <div class="col-md-6">
                    <div class="form-group">
                        <label>Reader Type </label><span class="Mandatory">*</span>
                        @Html.DropDownListFor(m => m.ReaderType.Code, (SelectList)ViewBag.ReaderType, "--Select Reader Type--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'ReadTpe')" })
                        <span id="ReadTpe"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Location </label><span class="Mandatory">*</span>
                        @Html.DropDownListFor(m => m.Location.Code, (SelectList)ViewBag.Location, "--Select Location--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'Loc')" })
                        <span id="Loc"></span>
                    </div>
                </div>


            </div>
            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Biometric ID In Attendance DB</label>
                        @Html.TextBoxFor(m => m.BiometricIDInAttendanceDB, new { @class = "form-control form-control-sm", @placeholder = "Biometric ID In Attendance DB" })
                    </div>
                </div>
                <div class="col-md-6 d-flex align-items-center">
                    <label class="switch" onchange="ActiveInactiveValidationReader('READER',@Model.Code)">
                        @Html.HiddenFor(m => Model.Code)
                        @Html.CheckBoxFor(m => m.Active, new {@id="reader" })
                        <span class="slider round"></span>
                    </label>
                </div>
            </div>






            <div class="row my-3">

                <div class="col-md-12">
                    <label class="view-title">Description</label>
                    <div class="view-details">
                        @Html.HiddenFor(m => m.Remarks)
                        @Model.Remarks
                    </div>
                </div>
            </div>

            <div class="row card-footer-bottom-fixed border-none">
                <div class="col-md-12 align-right">
                    @if (CurrentUserRoleActions.Modify == true)
                    {

                        <a type="button"
                           class="btn btn-default  mobile-full-width" onclick="Edit('Modify')">
                            Modify
                        </a>
                    }
                    </div>
            </div>
        </div>
    </div>
}