@model Hrms.Lite.Shared.Master.Reader
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.ActiveTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");

        //$('#ReaderTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');

    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table reader-master-list pt-1">
    @Html.HiddenFor(m => m.ReaderList.Count)
    <table id="ReaderTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Reader Name</th>
                <th scope="col">User Code</th>
                <th scope="col">Reader Type</th>
                <th scope="col">Location</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ReaderList != null && Model.ReaderList.Count > 0)
            {

                for (int i = 0; i < Model.ReaderList.Count; i++)
                {
                    <tr>
                        @Html.HiddenFor(m => m.ReaderList[i].EditActive)
                        <td data-label="Reader Name">@Html.HiddenFor(m => m.ReaderList[i].GI)@Html.HiddenFor(m => m.ReaderList[i].LogGI)@Model.ReaderList[i].ReaderName</td>
                        <td data-label="User Code">@Model.ReaderList[i].UserCode</td>
                        <td data-label="Reader Type">@Model.ReaderList[i].ReaderType.Name</td>
                        <td data-label="Location">@Model.ReaderList[i].Location.Name</td>
                        <td data-label="Actions">
                            @if (CurrentUserRoleActions.Modify == true)
                            {

                                <a data-bs-toggle="tooltip" title="Edit"
                                   id="readeredit" type="button"
                                   class="btn btn-icon btn-edit icon-only " onclick="onCreateOrEditClick('MODIFY','@Model.ReaderList[i].GI','@Model.ReaderList[i].LogGI',@i)">
                                    <i class="icon-xl fas fa-pencil-alt"></i>
                                </a>
                            }
                            else
                            {
                                <a data-bs-toggle="tooltip" title="Edit"
                                   id="readeredit" type="button"
                                   class="btn btn-icon btn-edit icon-only " onclick="onCreateOrEditClick('MODIFY', '@Model.ReaderList[i].GI', '@Model.ReaderList[i].LogGI',@i);
                                   swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#CreateSlider');});">
                                    <i class="icon-xl fas fa-pencil-alt"></i>
                                </a>
                            }
                            <!-- Edit Slider start-->
                            <!-- Edit Slider  end-->
                            <!-- delete Slider  start-->
                            @if (CurrentUserRoleActions.Delete == true)
                            {
                                <a data-bs-toggle="tooltip" title="Delete"
                                   id="readerdelete" type="button"
                                   class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('DELETE','@Model.ReaderList[i].GI','@Model.ReaderList[i].LogGI',@i)">
                                    <i class="icon-xl far fa-trash-alt"></i>
                                </a> 
                            }
                            else
                            { 
                                <a data-bs-toggle="tooltip" title="Delete"
                                   id="readerdelete" type="button"
                                   class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('DELETE', '@Model.ReaderList[i].GI', '@Model.ReaderList[i].LogGI',@i);
                                   swal.fire(MasterPersmissionMsg);">
                                    <i class="icon-xl far fa-trash-alt"></i>
                                </a>
                            }


                                <!-- <end delete section></end> -->
                            </td>
                    </tr>

                }
            }
        </tbody>
    </table>
</div>