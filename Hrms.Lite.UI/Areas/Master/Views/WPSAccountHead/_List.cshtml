@model Hrms.Lite.Shared.Master.WPSAccountHead
<script src="~/js/settings.js"></script>

<div class="ihits-table table-border odd-even vertical-scroll-90-per mobile-responsive-table allowance-deduction-accounthead-list">
    @Html.HiddenFor(model => Model.TabName)
    @Html.HiddenFor(model => Model.WPSAccountHeadTablist.Count)
    <table id="AllowDedtable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col"> Name</th>

                <th scope="col" class="text-left">Type</th>
                <th scope="col" class="text-left">WPSHeader</th>


                <th scope="col">Action</th>


            </tr>
        </thead>
        <tbody>
            @{
                if (Model.WPSAccountHeadTablist != null && Model.WPSAccountHeadTablist.Count > 0)
                {
                    for (int i = 0; i < Model.WPSAccountHeadTablist.Count; i++)

                    {

                        <tr>
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Description)
                            @Html.HiddenFor(model => Model.Active)
                            @Html.HiddenFor(m => m.WPSAccountHeadTablist[i].Code)
                            @Html.HiddenFor(m => m.WPSAccountHeadTablist[i].Name)
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Name"> @Model.WPSAccountHeadTablist[i].Name </td>

                            <td data-label="Type">
                                @Model.WPSAccountHeadTablist[i].AllowanceType
                            </td>
                            <td data-label="WPSHeader">


                                <div class="form-group">

                                    <span id="amtLabel2_@i">@Model.WPSAccountHeadTablist[i].WPSHeaderName</span><span id="amtTxtbox2_@i" class="hide">
                                        @Html.DropDownListFor(Model => Model.WPSAccountHeadTablist[i].WPSHeader, (SelectList)ViewBag.WPSAccountHead, "--Select WPS Header--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'accounthead')", @style = "width:100%;" })
                                        <span id="accounthead"></span>
                                    </span>

                                </div>



                            </td>


                            <td data-label="Edit">
                                <span id="editbt2_@i">
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="ceedit"
                                       class="btn btn-icon btn-edit icon-only" onclick="onEditClick(@i)">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>
                                </span>


                                <span id="updateCancel2_@i" class="hide">
                                    <a data-bs-toggle="tooltip" title="Update"
                                       id="cupdate"
                                       class="btn btn-icon btn-edit icon-only" onclick="onUpdateClick(@i)">
                                        <i class="icon-xl fas fa-sync-alt"></i>
                                    </a>
                                    <a data-bs-toggle="tooltip" title="Update"
                                       id="ccancel"
                                       class="btn btn-icon btn-cancel icon-only" onclick="onCancelClick(@i)">
                                        <i class="icon-xl fas fa-times"></i>
                                    </a>
                                </span>

                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>
