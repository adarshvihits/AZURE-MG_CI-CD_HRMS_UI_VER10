
@model Hrms.Lite.Shared.DataBank.Generic.Master.FieldOfCertification
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.PendingTabCount').html("@Model.PendingCount");

        //$('#FieldOfcertificationPendingTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');


    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table fieldofcertification-master-pending-list pt-1">
    @Html.HiddenFor(m => m.FieldOfCertificationList.Count)
    <table id="FieldOfcertificationPendingTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>

            @{


                if (Model.FieldOfCertificationList != null && Model.FieldOfCertificationList.Count > 0)
                {
                    for (int i = 0; i < Model.FieldOfCertificationList.Count; i++)

                    {

                        <tr>
                            @Html.HiddenFor(m => m.FieldOfCertificationList[i].MakerChecker)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.ApproveMode)

                            <td data-label="Name">@Model.FieldOfCertificationList[i].Name</td>
                            <td data-label="Short Name">@Model.FieldOfCertificationList[i].ShortName</td>
                            <td data-label="Mode">@Model.FieldOfCertificationList[i].Mode</td>
                            <td data-label="Approve">

                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="approvefieldcertification"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.FieldOfCertificationList[i].GI', '@Model.FieldOfCertificationList[i].LogGI','APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                { 
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="approvefieldcertification"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.FieldOfCertificationList[i].GI', '@Model.FieldOfCertificationList[i].LogGI', 'APPROVAL',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }

                                </td>
                            <!-- <second></second> -->
                        </tr>
                    }
                }

            }

        </tbody>
    </table>
</div>
