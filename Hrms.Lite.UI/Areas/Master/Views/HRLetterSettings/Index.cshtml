@model Hrms.Lite.Shared.Master.HRLetterSettings
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/scripts/Master/HRLetterSettings.js"></script>


<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">HR Letter Settings</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        HR Letter Settings
                    </li>
                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->









<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->








            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                    <!--begin: Search Form-->






                    <div class="row tab-style-button">
                        <div class="tab-button-wrap align-items-center">




                            <div class="tab-items">

                                <div class="row-outer pb-2 " style="width:150px">
                                    <label>Letter Type</label>
                                    
                                        @Html.DropDownListFor(m => m.LetterType, (SelectList)ViewBag.doc, "--Select Type--", new
                                   {
                                       @class = "form-control form-control-sm",
                                       @onchange = "GetDetails()"
                                   })
                                       
                                    <span id="Lettype"></span>
                                </div>
                            </div>
   

                        </div>




                    </div>









                    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "HRLetterSettings", enctype = "multipart/form-data" }))
                    {

                        <div id="List">
                            @await Html.PartialAsync("_List", Model)
                        </div>


                        <div class="row card-footer-bottom-fixed border-none">

                            <div class="col-md-12 align-right">
                                <button type="button" onclick="Save()"
                                        class="btn btn-default  mobile-full-width">
                                    Save
                                </button>

                            </div>

                        </div>
                    }
                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
<div class="slider-over-flow"></div>
<!--end::Content-->