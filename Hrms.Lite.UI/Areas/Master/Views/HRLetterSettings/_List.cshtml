@model Hrms.Lite.Shared.Master.HRLetterSettings


    <script>
        $(document).ready(function () {
            debugger;
            var b = document.getElementById('Attachment1_AbsoluteUri');
            if (b.value == null) {
                //fileLabel.innerHTML = "No File Chosen";
                $('#fileLabel').html("No File Chosen")
            }
            else {
                var b = document.getElementById('Attachment1_ActualFileName');
                if (b.value != '') {

                    let replacemnt = '..';
                    theSplit = b.value.slice(0, 18);
                    //fileLabel.innerHTML = theSplit.substring(0, theSplit.length - 2) + replacemnt;
                    $('#fileLabel').html(theSplit.substring(0, theSplit.length - 2) + replacemnt);
                }
                else {
                    //fileLabel.innerHTML = "";
                    $('#fileLabel').html('');

                }
            }
        });


   function onAttachment1Change() {
            debugger
            var a = document.getElementById('Attachment1_FileData');
            if (a.value == "") {
                //fileLabel.innerHTML = "No File Chosen";
                $('#fileLabel').html("No File Chosen");
            }
            else {
                debugger
                var theSplit = a.value.split('\\');
                theSplit = theSplit[theSplit.length - 1];
                let replacemnt = '..';
                theSplit = theSplit.slice(0, 18);
                //fileLabel.innerHTML = theSplit.substring(0, theSplit.length - 2) + replacemnt;
                $('#fileLabel').html(theSplit.substring(0, theSplit.length - 2) + replacemnt);
            }
        };



        $(document).ready(function () {
            debugger;
            var b = document.getElementById('Attachment2_AbsoluteUri');
            if (b.value == null) {
                //fileLabel.innerHTML = "No File Chosen";
                $('#fileLabelll').html("No File Chosen")
            }
            else {
                var b = document.getElementById('Attachment2_ActualFileName');
                if (b.value != '') {

                    let replacemnt = '..';
                    theSplit = b.value.slice(0, 18);
                    //fileLabel.innerHTML = theSplit.substring(0, theSplit.length - 2) + replacemnt;
                    $('#fileLabelll').html(theSplit.substring(0, theSplit.length - 2) + replacemnt);
                }
                else {
                    //fileLabel.innerHTML = "";
                    $('#fileLabelll').html('');

                }
            }
        });


        function onAttachment2Change() {
            debugger
            var a = document.getElementById('Attachment2_FileData');
            if (a.value == "") {
                //fileLabel.innerHTML = "No File Chosen";
                $('#fileLabelll').html("No File Chosen");
            }
            else {
                debugger
                var theSplit = a.value.split('\\');
                theSplit = theSplit[theSplit.length - 1];
                let replacemnt = '..';
                theSplit = theSplit.slice(0, 18);
                //fileLabel.innerHTML = theSplit.substring(0, theSplit.length - 2) + replacemnt;
                $('#fileLabelll').html(theSplit.substring(0, theSplit.length - 2) + replacemnt);
            }
        };




        function Preview1() {
            debugger
            if ($('#Attachment1_FileData').val() == '' && $('#Attachment1_AbsoluteUri').val() == '') {
                swal.fire("No file uploaded");
            }

            else if ($('#Attachment1_FileData').val() != '') {
                var path = URL.createObjectURL($('.PreviewImage1')[0].files[0]);
                window.open(path, "_blank");
            }
            else {
                window.open($('#Attachment1_AbsoluteUri').val(), '_blank');
            }
        }

        function Preview2() {
            debugger
            if ($('#Attachment2_FileData').val() == '' && $('#Attachment2_AbsoluteUri').val() == '') {
                swal.fire("No file uploaded");
            }

            else if ($('#Attachment2_FileData').val() != '') {
                var path = URL.createObjectURL($('.PreviewImage2')[0].files[0]);
                window.open(path, "_blank");
            }
            else {
                window.open($('#Attachment2_AbsoluteUri').val(), '_blank');
            }
        }



    </script>

