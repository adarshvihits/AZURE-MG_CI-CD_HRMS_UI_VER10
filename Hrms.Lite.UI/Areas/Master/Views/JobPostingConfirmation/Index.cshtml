@model Hrms.Lite.Shared.Master.JobPostingConfirmationViewModel
@{
    ViewData["Title"] = "Job Posting Confirmation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/css/hrplan.css" rel="stylesheet" type="text/css" />
<link href="~/css/JobPostingConfirmation.css?v=11" rel="stylesheet" type="text/css" />
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/Master/JobPostingConfirmation.js?v=7"></script>



<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Job Posting Confirmation</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Position Lifecycle
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Job Posting Confirmation
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <div class="d-flex flex-column-fluid">
        <div class="container full-width">
            <div class="card card-custom height-100per footer-row-fixed">
                <div class="card-body">

                  

                    <div class="approval-tab-row">
                        <div class="approval-tab-btn tab1 active" onclick="Tab('tab1','PENDING')">
                            Pending confirmation <span id="tb1" class="tab-count">@Model.PendingCount</span>
                        </div>
                        <div class="approval-tab-btn tab2" onclick="Tab('tab2','CONFIRMED')">
                            Confirmed &amp; posted <span id="tb2" class="tab-count">@Model.ConfirmedCount</span>
                        </div>

                        <div class="tab-items select-option ml-auto">
                            <div class="sraech-slider">
                                <div class="search-slider-inner">
                                    <i class="fa fa-search"></i>
                                </div>
                                <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                       placeholder="Position, Branch, Department">
                            </div>

                            <a data-bs-toggle="tooltip" title="Export to Excel"
                               class="btn btn-excel" onclick="ExportToExcel()">
                                <i class="icon-xl far fa-file-excel"></i>
                            </a>
                        </div>
                    </div>

                    <div id="JobPostingConfirmationList">
                        @await Html.PartialAsync("_PendingList", Model)
                    </div>

                </div>
            </div>
            <div id="JobPostingConfirmationSlider"></div>
        </div>
    </div>
</div>
<!--end::Content-->
