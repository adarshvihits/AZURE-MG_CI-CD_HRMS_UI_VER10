@model Hrms.Lite.Shared.Master.ESIGroup
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });


</script>
@using (Html.BeginForm("Save", "ESIGroup", FormMethod.Post, new { id = "esiGroupSave" }))
{
    <div id="esigroupedit" class="slider-forms slider-forms-open AddNewDiv">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddNewDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>ESI Group  </h4>
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Name
                                <span class="Mandatory">*</span>
                            </label>

                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm EName", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'EsiName')", maxlength = "120" })
                            <span id="EsiName"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Short Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm EShtName", @placeholder = "Short Name", @onblur = "validate(this,'EsiShortName')", maxlength = "5" })
                            <span id="EsiShortName"></span>
                        </div>
                    </div>
                </div>

                <div class="row my-3">

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Code
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.TextBoxFor(Model => Model.ESIGroupCode, new { @class = "form-control form-control-sm ", @placeholder = "Code", @onblur = "validate(this,'EsiGrpCode')" })
                            <span id="EsiGrpCode"></span>
                        </div>
                    </div>

                    <div class="col-md-6 d-flex align-items-center">
                        <div>Active</div>
                        <label class="switch" onchange="ActiveInactiveValidationEsiGroup('ESI_GROUP', '@Model.Code')">
                            @Html.HiddenFor(m => Model.Code)

                            @Html.CheckBoxFor(model => model.Active, new { @id = "activeinactiveEsi" })
                            <span class="slider round"></span>
                        </label>
                    </div>

                </div>


                <div class="row my-3">

                    <div class="col-md-12">

                        <div class="view-details">
                            @if (Model.Mode == "CREATE")
                            {
                                <label>Description</label>
                                @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm EDescription", @placeholder = "Description", maxlength = "250" })

                            }
                            @if (Model.Mode == "MODIFY")
                            {
                                <label class="view-title">Description</label>
                                <div class="view-details">

                                    @Html.DisplayFor(Model => Model.Description)
                                    @Html.HiddenFor(model => Model.Description)
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12 align-right">
                        @if (Model.Mode == "CREATE")
                        {
                            @if (CurrentUserRoleActions.Create == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="ESIGroupSave('Save')">
                                    Save
                                </button>
                            }
                        }
                        @if (Model.Mode == "MODIFY")
                        {

                            @if (CurrentUserRoleActions.Modify == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="ESIGroupSave('Modify')">
                                    Modify
                                </button>
                            }
                        }
                        </div>
                </div>
            </div>
        </div>
    </div>
}