@model Hrms.Lite.Shared.Master.JobDescription
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>

@using (Html.BeginForm("Delete", "JobDescription", FormMethod.Post, new { @id = "DeleteJobDescription" }))
{
    <div id="deletejobdescription" class="slider-forms slider-forms-open delete">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('delete')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>Job Description</h4>
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Master Job</label>
                            <div class="view-details">
                                @Model.MasterJob?.Name
                                @Html.HiddenFor(model => Model.MasterJobCode)
                                @Html.HiddenFor(model => Model.Active)
                                @Html.HiddenFor(model => Model.JDescription)
                                @Html.HiddenFor(model => Model.GI)
                                @Html.HiddenFor(model => Model.LogGI)
                                @Html.HiddenFor(model => Model.Mode)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Business Type</label>
                            <div class="view-details">
                                @Model.BusinessType?.Name
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <div class="row-outer">
                            <label class="view-title">Department</label>
                            <div class="view-details">
                                @Model.Department?.Name
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="row-outer">
                            <label class="view-title">Section</label>
                            <div class="view-details">
                                @Model.Section?.Name
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="row-outer">
                            <label class="view-title">Grade</label>
                            <div class="view-details">
                                @Model.Grade?.Name
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="row-outer">
                            <label class="view-title">Active</label>
                            <div class="view-details">
                                @if (Model.Active == true)
                                {

                                    <a type="button" class="btn btn-icon btn-tick">
                                        <i class="icon-xl fas fa-check"></i>
                                    </a>

                                }
                                else
                                {
                                    <a type="button" class="btn btn-icon btn-close">
                                        <i class="icon-xl fas fa-times"></i>

                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">
                        @if (CurrentUserRoleActions.Delete == true)
                        {
                            <a type="button"
                               data-bs-toggle="tooltip" title="Delete"
                               data-bs-original-title="Delete"
                               class="btn btn-icon btn-delete big-btn float-none" onclick="return confirmDelete('@Model.GI', '@Model.LogGI')">
                                <i class="icon-xl far fa-trash-alt"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
