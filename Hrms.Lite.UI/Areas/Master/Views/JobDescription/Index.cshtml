@model Hrms.Lite.Shared.Master.JobDescription
@{
    ViewData["Title"] = "Job Description";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/Master/jobDescription.js"></script>
<script>
    // The Active tab's table is server-rendered inline with the page, so its
    // DataTable is initialized (by settings.js) before the surrounding Metronic
    // layout finishes sizing #kt_content — leaving the header/body columns out
    // of alignment until something forces a redraw (e.g. switching tabs, which
    // rebuilds the table fresh). Re-run that redraw once the page has fully
    // loaded so the Active tab looks right without needing a manual tab switch.
    $(window).on('load', function () {
        if (typeof dataTable !== 'undefined' && dataTable) {
            dataTable.columns.adjust().draw(false);
        }
    });
</script>
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Job Description
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Job Description
                    </li>

                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->


<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body">
                            <div class="mobile-tab-section">
                                <div class="row mb-2">
                                    <div class="col-12">
                                        <div class="form-group">
                                            <label>Type</label>
                                            <select class="form-control form-control-sm "
                                                    id="tabsDropdownJobDescription"
                                                    onchange="tabClick(this)">
                                                <option value="ACTIVE">Active</option>
                                                <option value="INACTIVE">Inactive</option>
                                                <option value="APPROVAL_PENDING">
                                                    Pending
                                                </option>

                                            </select>

                                        </div>
                                    </div>

                                </div>
                            </div>

                            <div class="row tab-style-button">
                                <div class="tab-button-wrap">
                                    <div class="tab-items">
                                        <span class="btn-title active ActiveTab" onclick="OnTabClick('ActiveTab','ACTIVE')">
                                            Active
                                        </span>
                                    </div>
                                    <div class="tab-items medium">
                                        <span class="btn-title InActiveTab" onclick="OnTabClick('InActiveTab','INACTIVE')">
                                            Inactive
                                        </span>
                                    </div>
                                    <div class="tab-items low">
                                        <span class="btn-title PendingTab" onclick="OnTabClick('PendingTab','APPROVAL_PENDING')">
                                            Pending
                                            <span class="btn-notification pendingTabCount">@Model.PendingCount</span>
                                        </span>
                                    </div>

                                    <div class="tab-items select-option">

                                        <div class="sraech-slider">
                                            <div class="search-slider-inner">
                                                <i class="fa fa-search"></i>
                                            </div>

                                            <input type="text" id="dataTableSearch" class="form-control form-control-sm" placeholder="ID/Name">
                                        </div>

                                    @*     <a data-bs-toggle="tooltip" title="Export to Excel"
                                           class="btn btn-excel" onclick="clickOnExportToExcel()">
                                            <i class="icon-xl far fa-file-excel"></i>
                                        </a> *@

                                    </div>
                                </div>
                            </div>



                            <div id="JobDescriptionList">
                                @await Html.PartialAsync("_List", Model)
                            </div>
                            <!-- <end table></end> -->
                            <div class="row card-footer-bottom-fixed">

                                <div class="col-md-12 align-right">

                                    @if (CurrentUserRoleActions.Create == true)
                                    {
                                        <a type="button" onclick="onAddClick()"
                                           class="btn btn-default float-right mobile-full-width ">
                                            Add
                                            New
                                        </a>
                                    }
                                    else
                                    {
                                        <a type="button" onclick="swal.fire(MasterPersmissionMsg);"
                                           class="btn btn-default float-right mobile-full-width ">
                                            Add
                                            New
                                        </a>
                                    }
                                </div>

                            </div>
                            <div id="DeleteSlider">


                            </div>
                            <div id="ApproveSlider">


                            </div>
                        </div>

                    </div>
                </div>
            </div>




            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>
<!--end::Content-->
