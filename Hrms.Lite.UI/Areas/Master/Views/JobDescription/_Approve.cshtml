@model Hrms.Lite.Shared.Master.JobDescription
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "approve" }))
{
    <div id="jobdescriptionapprove" class="slider-forms slider-forms-open Approve">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('Approve')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>Job Description</h4>
            </div>
            <div class="add-padding">
                @Html.HiddenFor(model => Model.MasterJobCode)
                @Html.HiddenFor(model => Model.Mode)
                @Html.HiddenFor(model => Model.GI)
                @Html.HiddenFor(model => Model.LogGI)
                @Html.HiddenFor(model => Model.Active)
                @Html.HiddenFor(model => Model.ApproveMode)
                <div class="row">
                    <div class="col-md-3">
                        <div class="row-outer">
                            <label class="view-title">Department</label>
                            <div class="view-details">
                                @Model.Department?.Name
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="row-outer">
                            <label class="view-title">Section</label>
                            <div class="view-details">
                                @Model.Section?.Name
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="row-outer">
                            <label class="view-title">Grade</label>
                            <div class="view-details">
                                @Model.Grade?.Name
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="row-outer">
                            <label class="view-title">Business Type</label>
                            <div class="view-details">
                                @Model.BusinessType?.Name
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="row-outer">
                            <label class="view-title">Active</label>
                            <div class="view-details">
                                @if (Model.Active == true)
                                {

                                    <button type="button" class="btn btn-icon btn-tick">
                                        <i class="icon-xl fas fa-check"></i>
                                    </button>

                                }
                                else
                                {
                                    <button type="button" class="btn btn-icon btn-close">
                                        <i class="icon-xl fas fa-times"></i>

                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row my-3">

                    <div class="col-md-12">
                        <label class="view-title">Job Description</label>
                        <div class="view-details">
                            @Html.Raw(Model.JDescription)
                            @Html.HiddenFor(model => Model.JDescription)
                        </div>
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">
                        @if (CurrentUserRoleActions.Approve == true)
                        {
                            <button type="button"
                                    class="btn btn-danger  mobile-full-width" onclick="return confirmReject('@Model.GI','@Model.LogGI')">
                                Reject
                            </button>
                            <button type="button"
                                    class="btn btn-default  mobile-full-width" onclick="return confirmApprove('@Model.GI','@Model.LogGI')">
                                Approve
                            </button>
                        }
                        </div>


                </div>
            </div>
        </div>
    </div>
}
