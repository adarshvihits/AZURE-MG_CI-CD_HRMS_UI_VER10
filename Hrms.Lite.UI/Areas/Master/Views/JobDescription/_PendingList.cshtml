@model Hrms.Lite.Shared.Master.JobDescription
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        $('.pendingTabCount').html("@Model.PendingCount");
    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table job-description-pending pt-1">
    @Html.HiddenFor(m => m.JobDescriptionList.Count)
    <table id="PendingJDTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
             
                <th scope="col">Business Type</th>
                <th scope="col">Department</th>
                <th scope="col">Section</th>
                <th scope="col">Grade</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>

            @{
                if (Model.JobDescriptionList != null && Model.JobDescriptionList.Count > 0)
                {
                    for (int i = 0; i < Model.JobDescriptionList.Count; i++)

                    {

                        <tr>

                            @Html.HiddenFor(m => Model.JobDescriptionList[i].MakerChecker)

                         
                            <td data-label="Business Type">@Model.JobDescriptionList[i].BusinessType?.Name</td>
                            <td data-label="Department">@Model.JobDescriptionList[i].Department?.Name</td>
                            <td data-label="Section">@Model.JobDescriptionList[i].Section?.Name</td>
                            <td data-label="Grade">@Model.JobDescriptionList[i].Grade?.Name</td>
                            <td data-label="Entry Type">@Model.JobDescriptionList[i].Mode</td>
                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="jobdescriptionapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.JobDescriptionList[i].GI', '@Model.JobDescriptionList[i].LogGI', @i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="jobdescriptionapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="swal.fire(MasterPersmissionMsg)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                            </td>

                        </tr>
                    }
                }


            }
        </tbody>
    </table>
</div>
