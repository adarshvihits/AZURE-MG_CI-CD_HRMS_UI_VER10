@model Hrms.Lite.Shared.Master.ResumeSources
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/Master/resumeSource.js"></script>
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Resume Source
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Resume Source

                    </li>

                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->


<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body">

                            <div class="row tab-style-button">
                                <div class="tab-button-wrap">
                                    <div class="tab-items">
                                        <span class="btn-title active tab1" onclick="TabOnClick('tab1','ACTIVE')">
                                            Active
                                            @*<span class="btn-notification ">@Model.ActiveCount</span>*@
                                        </span>
                                    </div>
                                    <div class="tab-items medium">
                                        <span class="btn-title tab2" onclick="TabOnClick('tab2','INACTIVE')">
                                            Inactive
                                            @*<span class="btn-notification ">@Model.InactiveCount</span>*@
                                        </span>
                                    </div>
                                    <div class="tab-items low">
                                        <span class="btn-title tab3" onclick="TabOnClick('tab3','APPROVAL_PENDING')">
                                            Pending
                                            <span class="btn-notification tab3Count">@Model.PendingCount</span>
                                        </span>
                                    </div>



                                    <div class="tab-items select-option">

                                        <div class="sraech-slider">
                                            <div class="search-slider-inner">
                                                <i class="fa fa-search"></i>
                                            </div>
                                            <input type="text" class="form-control form-control-sm"
                                                   placeholder="Search">
                                        </div>
                                        <button data-bs-toggle="tooltip" title="Export to Excel"
                                                class="btn btn-excel" onclick="ExportToExcel()">
                                            <i class="icon-xl far fa-file-excel"></i>
                                        </button>

                                    </div>


                                </div>
                            </div>



                            <div id="resumeList">
                                @await Html.PartialAsync("_List")
                            </div>
                            <div id="sliderView"></div>
                            <!-- <end table></end> -->
                            <div class="row card-footer-bottom-fixed">

                                <div class="col-md-12 align-right">
                                    @if (CurrentUserRoleActions.Create == true)
                                    {
                                        <a id="adddeduction" type="button"
                                           class="btn btn-default float-right mobile-full-width slider-btn" onclick="onAddNewOrEditClick('Create')">
                                            Add
                                            New
                                        </a> 
                                    }
                                    else
                                    { 
                                        <a id="adddeduction" type="button"
                                           class="btn btn-default float-right mobile-full-width" onclick="swal.fire(MasterPersmissionMsg);">
                                            Add
                                            New
                                        </a>
                                    }

                                    </div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>




            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>
<!--end::Content-->
