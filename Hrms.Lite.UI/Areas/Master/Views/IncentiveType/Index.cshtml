@model Hrms.Lite.Shared.Master.IncentiveType
@{ ViewData["Title"] = "Department";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;

<script src="~/scripts/Master/incentiveType.js" asp-append-version="true"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Bonus Type
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Bonus Type
                    </li>

                </ul>
            </div>
        </div>

    </div>

</div>
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body ">
                            <div class="mobile-tab-section">
                                <div class="row mb-2">
                                    <div class="col-12">
                                        <div class="form-group">
                                            <label>Type</label>
                                            <select class="form-control form-control-sm "
                                                    id="tabsDropdownDepartment"
                                                    onchange="tabClick(this)">
                                                <option value="ACTIVE">Active</option>
                                                <option value="INACTIVE">Inactive</option>
                                                <option value="APPROVAL_PENDING">
                                                    Pending
                                                </option>

                                            </select>

                                        </div>
                                    </div>

                                </div>
                            </div>

                            <div class="row tab-style-button">
                                <div class="tab-button-wrap">
                                    <div class="tab-items">
                                        <span class="btn-title active ActiveTab" onclick="OnTabClick('ActiveTab','ACTIVE')">
                                            Active
                                            @*<span class="btn-notification AllTabCount">@Model.ActiveCount</span>*@
                                        </span>
                                    </div>

                                    <div class="tab-items medium">
                                        <span class="btn-title InActiveTab" onclick="OnTabClick('InActiveTab','INACTIVE')">
                                            Inactive
                                            @*<span class="btn-notification InActiveTabCount">@Model.InactiveCount</span>*@
                                        </span>
                                    </div>
                                    <div class="tab-items low">
                                        <span class="btn-title PendingTab" onclick="OnTabClick('PendingTab','APPROVAL_PENDING')">
                                            Pending
                                            <span class="btn-notification pendingTabCount">@Model.PendingCount</span>
                                        </span>
                                    </div>



                                    <div class="tab-items select-option">


                                        <div class="sraech-slider">
                                            <div class="search-slider-inner">
                                                <i class="fa fa-search"></i>
                                            </div>
                                            <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                                   placeholder="ID/Name">
                                        </div>

                                        <a data-bs-toggle="tooltip" title="Export to Excel"
                                           class="btn btn-excel" onclick="clickOnExportToExcel()">
                                            <i class="icon-xl far fa-file-excel"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>


                            <div id="IncentiveTypeList">
                                @await Html.PartialAsync("_IncentiveTypeList", Model)

                            </div>

                            <div class="row card-footer-bottom-fixed">

                                <div class="col-md-12 align-right">
                                    
                                        <button id="adddepartment" type="button"
                                                class="btn btn-default float-right mobile-full-width " onclick="AddNewOrEditClick('CREATE')">
                                            Add
                                            New
                                        </button>
                                    
                                </div>

                            </div>
                            <div id="DeleteSlider">


                            </div>
                            <div id="ApproveSlider">


                            </div>
                            <div id="DepartmentPendingList">


                            </div>
                            <div id="AddNewOrEditSlider">


                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>