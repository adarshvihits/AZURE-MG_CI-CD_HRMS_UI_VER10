<div class="ihits-table table-border hover-color odd-even mobile-responsive-table department-list pt-1">
    @Html.HiddenFor(m => m.IncentiveTypeList.Count)
    <table id="Departmenttable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>


            @{
                if (Model.IncentiveTypeList != null && Model.IncentiveTypeList.Count > 0)
                {
                    for (int i = 0; i < Model.IncentiveTypeList.Count; i++)

                    {


                        <tr>

                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Description)
                            @Html.HiddenFor(model => Model.Active)
                            @Html.HiddenFor(m => m.IncentiveTypeList[i].EditActive)
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Name">@Model.IncentiveTypeList[i].Name</td>
                            <td data-label="Name">@Model.IncentiveTypeList[i].ShortName</td>
                            <td data-label="Actions">
                                <div>
                                    
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="departmentedit"
                                           class="btn btn-icon btn-edit icon-only" onclick="AddNewOrEditClick('MODIFY', '@Model.IncentiveTypeList[i].GI', '@Model.IncentiveTypeList[i].LogGI',@i)">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                   
                                   
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deletedepartment"
                                           class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.IncentiveTypeList[i].GI', '@Model.IncentiveTypeList[i].LogGI','DELETE',@i)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                   
                                </div>
                            </td>
                        </tr>
                    }
                }
            }


        </tbody>
    </table>
</div>
