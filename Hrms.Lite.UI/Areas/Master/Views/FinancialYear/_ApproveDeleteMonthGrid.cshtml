@model Hrms.Lite.Shared.Master.FinancialYear
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table addfinancial-year-lists  pt-5 vertical-scroll-400">
    <table>
        <thead>
            <tr class="table-dark">
                <th scope="col">Month</th>
                <th scope="col">Short Name</th>
                <th scope="col">Start Date</th>
                <th scope="col">End Date</th>
                <th scope="col">Total Days</th>
                <th scope="col" data-bs-toggle="tooltip" title="Average Days Of Loss Of Pay">Avg. LOP</th>
                <th scope="col" data-bs-toggle="tooltip" title="Average Days Of LJP">Avg. LJP</th>
                <th scope="col" data-bs-toggle="tooltip" title="Average Days Of LTP">Avg. LTP</th>
                <th scope="col" data-bs-toggle="tooltip" title="Average Days Of ESI">Avg. ESI</th>
                <th scope="col" data-bs-toggle="tooltip" title="Average PR Days for 1 Off Day">Avg. PR Days for 1 Off Day</th>
                <th scope="col" data-bs-toggle="tooltip" title="Average Days Of Overtime">Avg. Day OT</th>
                <th scope="col" data-bs-toggle="tooltip" title="Attendance Closing Date">Att. Close Date</th>
                <th scope="col">Leave Period</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>

            @{
                if (Model.salaryPeriod.Month != null && Model.salaryPeriod.Month.Count > 0)
                {
                    for (int i = 0; i < Model.salaryPeriod.Month.Count; i++)

                    {
                        <tr>

                            <td data-label="Month">
                                @Html.DisplayFor(model => Model.salaryPeriod.Month[i].Name)
                            </td>
                            <td data-label="Short Name"> @Html.DisplayFor(model => Model.salaryPeriod.Month[i].ShortName)</td>
                            <td data-label="Start Date">
                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.salaryPeriod.Month[i].StartDate))
                            </td>
                            <td data-label="End Date">

                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.salaryPeriod.Month[i].EndDate))
                            </td>
                            <td data-label="Total Days">@Html.DisplayFor(model => Model.salaryPeriod.Month[i].TotalDays)</td>
                            <td data-label="Average LOP">@Html.DisplayFor(model => Model.salaryPeriod.Month[i].AvgLOP)</td>
                            <td data-label="Average LOP">@Html.DisplayFor(model => Model.salaryPeriod.Month[i].AvgPrDaysOffday)</td>
                            <td data-label="Avg. LJP">@Html.DisplayFor(model => Model.salaryPeriod.Month[i].AvgDaysLJP)</td>
                            <td data-label="Avg. LTP">@Html.DisplayFor(model => Model.salaryPeriod.Month[i].AvgDaysLTP)</td>
                            <td data-label="Avg. ESI">@Html.DisplayFor(model => Model.salaryPeriod.Month[i].AvgDaysESI)</td>
                            <td data-label="Average Day OT">@Html.DisplayFor(model => Model.salaryPeriod.Month[i].AvgDayOT)</td>
                            <td data-label="Attendance Close Date">   @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.salaryPeriod.Month[i].AttendanceCloseDate))</td>
                            <td data-label="Leave Period">@Html.DisplayFor(model => Model.salaryPeriod.Month[i].LeavePeriod.Name)</td>
                            <td data-label="Leave Period">
                                <div class="view-details">
                                    <label class="switch">
                                        @Html.DisplayFor(model => Model.salaryPeriod.Month[i].Active)
                                        <span class="slider round"></span>
                                    </label>
                                </div>
                            </td>
                        </tr>
                    }
                }
            }



        </tbody>
    </table>
</div>