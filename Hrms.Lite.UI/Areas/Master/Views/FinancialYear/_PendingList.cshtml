@model Hrms.Lite.Shared.Master.FinancialYear
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table financial-approve-list pt-1">
    @Html.HiddenFor(m => m.FinancialYearList.Count)
    <table id="FinancialPendingTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Financial Year</th>
                <th scope="col">From</th>
                <th scope="col">To</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{


                if (Model.FinancialYearList != null && Model.FinancialYearList.Count > 0)
                {
                    for (int i = 0; i < Model.FinancialYearList.Count; i++)

                    {

                        <tr>
                            @Html.HiddenFor(m => m.FinancialYearList[i].MakerChecker)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.Code)
                            @Html.HiddenFor(model => Model.Mode)
                            <td data-label="Name">@Model.FinancialYearList[i].Name</td>
                            <td data-label="From"> @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.FinancialYearList[i].FromDate))</td>
                            <td data-label="To"> @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.FinancialYearList[i].ToDate))</td>
                            <td data-label="Entry Type">@Model.FinancialYearList[i].Mode</td>
                            <td data-label="Actions">

                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="interviewapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.FinancialYearList[i].GI','@Model.FinancialYearList[i].LogGI','APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                { 
                                
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="interviewapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.FinancialYearList[i].GI', '@Model.FinancialYearList[i].LogGI', 'APPROVAL',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }


                                </td>
                        </tr>
                    }
                }
            }

        </tbody>
    </table>
</div>
