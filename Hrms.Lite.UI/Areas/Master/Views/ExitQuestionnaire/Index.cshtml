@model Hrms.Lite.Shared.Master.ExitInterviewQuestionnaire
@{ ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/scripts/Master/ExitQuestionnaire.js"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Exit Questionnaire
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Exit Questionnaire

                    </li>

                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--begin::Topbar-->
        <div class="topbar">


        </div>
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body ">

                            <div class="row tab-style-button">
                                <div class="tab-button-wrap">
                                    <div class="tab-items">
                                        <span class="btn-title active ActiveTab" onclick="OnTabClick('ActiveTab','ACTIVE')">
                                            Active
                                            @*<span class="btn-notification AllTabCount">@Model.ActiveCount</span>*@
                                        </span>

                                        @*<span class="btn-title active ActiveTab" onclick="OnTabClick('ActiveTab','ACTIVE')">
                                                Active
                                                <span class="btn-notification AllTabCount">@Model.ActiveCount</span>
                                            </span>*@


                                    </div>
                                    <div class="tab-items medium">
                                        <span class="btn-title InActiveTab" onclick="OnTabClick('InActiveTab','INACTIVE')">
                                            Inactive
                                            @*<span class="btn-notification InActiveTabCount">@Model.InactiveCount</span>*@
                                        </span>
                                    </div>
                                    <div class="tab-items low">
                                        <span class="btn-title Pendingtab" onclick="OnTabClick('Pendingtab','APPROVAL_PENDING')">
                                            Pending
                                            <span class="btn-notification PendingTabCount">@Model.PendingCount</span>
                                        </span>
                                    </div>



                                    <div class="tab-items select-option">

                                        <div class="sraech-slider">
                                            <div class="search-slider-inner">
                                                <i class="fa fa-search"></i>
                                            </div>
                                            <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                                   placeholder="ID/Name">
                                        </div>

                                        <button data-bs-toggle="tooltip" title="Export to Excel"
                                                class="btn btn-excel" onclick="ExportToExcel()">
                                            <i class="icon-xl far fa-file-excel"></i>
                                        </button>

                                    </div>


                                </div>
                            </div>



                            <div id="Quetionnairelist">
                                @await Html.PartialAsync("_ExitQuestionnaireList")
                            </div>



                            <div id="AddNewOrEdit">

                            </div>

                            <div id="DeleteSlider">

                            </div>
                            <div id="ApproveSlider">

                            </div>

                            <div class="modal fade Exit_Questionnaire" tabindex="-1"
                                 role="dialog" aria-labelledby="myLargeModalLabel"
                                 aria-hidden="true">
                                <div class="modal-dialog" style="max-width:800px;">
                                    <div class="modal-content popup " style="height:400px ; ">
                                        <div class="modal-header" style="padding:10px">
                                            <h5 class="modal-title" id="exampleModalLabel">
                                                Objective Possible Results
                                            </h5>
                                            <button type="button" class="close"
                                                    data-bs-dismiss="modal" aria-label="Close">
                                                <i aria-hidden="true" class="ki ki-close"></i>
                                            </button>
                                        </div>
                                        <div class="modal-body"></div>

                                    </div>

                                </div>

                            </div>

                            <!-- <end table></end> -->
                            <div class="row card-footer-bottom-fixed">
                                <div class="col-md-6">

                                    @if (CurrentUserRoleActions.Create == true)
                                    {
                                        <a class="pl-10" data-bs-toggle="modal" data-target=".Exit_Questionnaire">
                                            <div class="application-btn d-flex align-items-center">
                                                <div class="history-btn">
                                                    <img src="/images/add-category-icon (1).png">

                                                </div>
                                                <div class="application-icon" onclick="GetQuestionnairePopUp()"> <h3 class="pt-2 pl-3">    Objective Possible Results</h3></div>
                                            </div>
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="pl-10">
                                            <div class="application-btn d-flex align-items-center">
                                                <div class="history-btn">
                                                    <img src="/images/add-category-icon (1).png">

                                                </div>
                                                <div class="application-icon" onclick="swal.fire(MasterPersmissionMsg);"> <h3 class="pt-2 pl-3">    Objective Possible Results</h3></div>
                                            </div>
                                        </a>
                                    }

                                </div>
                                <div class="col-md-6 align-right">
                                    <div class="d-flex align-items-center justify-content-end h-100">

                                        @if (CurrentUserRoleActions.Create == true)
                                        {
                                            <a type="button"
                                               class="btn btn-default float-right mobile-full-width " onclick="AddNewOrEditClick('CREATE')">
                                                Add
                                                New
                                            </a>
                                        }
                                        else
                                        {
                                            <a type="button"
                                               class="btn btn-default float-right mobile-full-width " onclick="swal.fire(MasterPersmissionMsg);">
                                                Add
                                                New
                                            </a>
                                        }
                                    </div>


                                </div>


                            </div>
                        </div>

                    </div>
                </div>
            </div>




            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>