<link href="~/css/custom.css" rel="stylesheet" />


<script src="~/js/multiselect.js"></script>
<script src="~/js/custom.js"></script>
@using (Html.BeginForm("Save", "ExitQuestionnaire", FormMethod.Post, new { id = "QuestionnaireSave" }))

{
    <div id="districtedit" class="slider-forms slider-forms-open AddNewDiv">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddNewDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>Exit Questionnaire</h4>
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label>
                                Question
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)


                            @Html.TextAreaFor(Model => Model.Name, new { @class = "form-control form-control-sm", maxlength = "250", @placeholder = "Question", @onblur = "validate(this,'Qname')" })
                            <span id="Qname"></span>

                            @*<input type="text"
                                class="form-control form-control-sm"
                                placeholder="Name">*@
                        </div>
                    </div>

                </div>
                <div class="row">



                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Type
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.DropDownListFor(Model => Model.TypeCode, (SelectList)ViewBag.Type, "--Select--", new { @class = "form-control form-control-sm", @onchange = "DisableDropDown(this)", @onblur = "validate(this,'type')" })
                            <span id="type"></span>

                            @*<input type="text"
                class="form-control form-control-sm"
                placeholder="Short Name">*@
                        </div>


                    </div>

                    <div class="col-md-6">
                        <div class="checkbox-inline h-100 align-content-center">
                            <label>Is Mandatory</label>
                            <label class="checkbox checkbox-outline checkbox-success">
                                @Html.CheckBoxFor(Model => Model.IsMandatory)
                                <span style="margin-left:10px;"></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="row">


                    <div class="col-md-6" id="resultDropdown" style="display:none">
                        <div class="form-group">
                            <label>
                                Result Type
                                <span class="Mandatory">*</span>
                            </label>

                            <div class="form-control  form-control-sm  Result1">
                                @Html.ListBoxFor(Model => Model.Result, (SelectList)ViewBag.possibleResult, new { @class = "multiselectDropdownField form-control-multiselect form-control-sm ", @id = "listBox1", @multiple = "multiple", data_placeholder = "Select--", @onblur = "validateResult(this,'result1','Result1')" })
                            </div>
                            <span id="result1"></span>
                        </div>


                    </div>
                </div>

           




                <div class="row">

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Group
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.DropDownListFor(Model => Model.GroupCode, (SelectList)ViewBag.Group, "--Select--", new { @class = "form-control form-control-sm Gcode", @onblur = "validate(this,'GrpCode')" })
                            <span id="GrpCode"></span>


                        </div>
                        
                    </div>



                    <div class="col-md-6 d-flex align-items-center">
                        <div class="d-flex align-items-center">
                            <div> Active</div>
                            <label class="switch" onclick="ActiveInactiveValidationQuestionnaire('Exit Questionnaire',@Model.Code)">
                                @Html.CheckBoxFor(Model => Model.Active,new { @id="questionnaire"})
                                <span class="slider round"></span>
                            </label>
                        </div>
                    </div>

                </div>






                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12 align-right">
                        @if (Model.Mode == "CREATE")
                        {

                            @if (CurrentUserRoleActions.Create == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="SaveQuestionnaire('Save')">
                                    Save
                                </button>
                            }
                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            @if (CurrentUserRoleActions.Modify == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="SaveQuestionnaire('Modify')">
                                    Modify
                                </button>
                            }
                        }
                        </div>
                </div>
            </div>
        </div>
    </div>
}