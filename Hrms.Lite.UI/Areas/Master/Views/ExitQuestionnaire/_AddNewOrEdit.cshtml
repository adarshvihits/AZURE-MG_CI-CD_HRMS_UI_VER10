@model Hrms.Lite.Shared.Master.ExitInterviewQuestionnaire
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script>
    $(document).ready(function () {
        debugger;
        var Typevalue = $('#TypeCode').val();
        if (Typevalue == 1) {
            $("#resultDropdown").css("display", "block");
        } else {
            var element = document.getElementById("resultDropdown");
            element.style.display = "none";

            /* $("#resultDropdown").addClass('hide');*/
        }
        //$('#Name').focus();
        moveCursorToEnd('Name');

    });


</script>
