@model Hrms.Lite.Shared.Master.ExitInterviewQuestionnaire
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
@using (Html.BeginForm("Delete", "ExitQuestionnaire", FormMethod.Post, new { @id = "QuestionnaireDelete" }))
{
    <div id="deletedistrict" class="slider-forms slider-forms-open delete">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('delete')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>Exit Questionnaire</h4>
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-12">
                        <div class="row-outer">
                            <label class="view-title">Question</label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.Name)
                                @Html.HiddenFor(model => Model.GI)
                                @Html.HiddenFor(model => Model.LogGI)
                                @Html.HiddenFor(model => Model.Mode)
                                @Html.HiddenFor(model => Model.EditActive)


                            </div>
                        </div>
                    </div>


                </div>


                <div class="row">

                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Type
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.TypeName)
                            </div>
                        </div>

                    </div>

                    @if (Model.TypeName == "OBJECTIVE")
                    {

                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">
                                    Possible Result
                                </label>
                                <div class="view-details">
                                    @Html.DisplayFor(model => Model.ResultName)
                                </div>
                            </div>

                        </div>
                    }


                </div>
                <div class="row">
                    <div class="col-md-6">



                        <div class="row-outer">
                            <label class="view-title">

                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.GroupName)
                            </div>
                        </div>



                    </div>

                    <div class="row-outer">
                        <label class="view-title">Active</label>
                        <div class="view-details">
                            @if (Model.Active == true)
                            {

                                <button type="button" class="btn btn-icon btn-tick">
                                    <i class="icon-xl fas fa-check"></i>
                                </button>

                            }
                            else
                            {
                                <button type="button" class="btn btn-icon btn-close">
                                    <i class="icon-xl fas fa-times"></i>

                                </button>
                            }
                        </div>
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">
                        @if (CurrentUserRoleActions.Delete == true)
                        {
                            <button type="button"
                                    data-bs-toggle="tooltip" title="Delete"
                                    data-bs-original-title="Delete"
                                    class="btn btn-icon btn-delete big-btn float-none" onclick="return confirmDelete('@Model.GI')">
                                <i class="icon-xl far fa-trash-alt"></i>
                            </button>
                        }
                        </div>


                </div>
            </div>
        </div>
    </div>
}