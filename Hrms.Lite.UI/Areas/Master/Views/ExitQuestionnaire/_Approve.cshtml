@model Hrms.Lite.Shared.Master.ExitInterviewQuestionnaire
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "approveQuestionnnaire" }))
{
    <div id="districtapproves" class="slider-forms slider-forms-open PendingApprove">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('PendingApprove')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>Exit Questionnaire</h4>
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-12">
                        <div class="row-outer">
                            <label class="view-title">Question</label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.Name)

                                @Html.HiddenFor(model => Model.Mode)
                                @Html.HiddenFor(model => Model.GI)
                                @Html.HiddenFor(model => Model.LogGI)
                                @Html.HiddenFor(model => Model.GroupName)
                                @Html.HiddenFor(model => Model.ResultName)
                                @Html.HiddenFor(model => Model.Active)
                                @Html.HiddenFor(model => Model.MakerChecker)
                                @Html.HiddenFor(model => Model.EditActive)
                                @Html.HiddenFor(model => Model.ApproveMode)
                            </div>
                        </div>
                    </div>


                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Type
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.TypeName)
                            </div>
                        </div>
                    </div>



                    @if (Model.TypeName == "OBJECTIVE")
                    {

                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">
                                    Possible Result
                                </label>
                                <div class="view-details">
                                    @Html.DisplayFor(model => Model.ResultName)
                                </div>
                            </div>
                        </div>
                    }

                </div>
                <div class="row">

                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Group
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.GroupName)
                            </div>
                        </div>
                    </div>


                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Active</label>
                            <div class="view-details">
                                @if (Model.Active == true)
                                {

                                    <button type="button" class="btn btn-icon btn-tick">
                                        <i class="icon-xl fas fa-check"></i>
                                    </button>

                                }
                                else
                                {
                                    <button type="button" class="btn btn-icon btn-close">
                                        <i class="icon-xl fas fa-times"></i>

                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                </div>


                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">
                        @if (CurrentUserRoleActions.Approve == true)
                        {
                            <button type="button"
                                    class="btn btn-danger  mobile-full-width" onclick="return confirmReject('@Model.GI', '@Model.LogGI')">
                                Reject
                            </button>
                            <button type="button"
                                    class="btn btn-default  mobile-full-width" onclick="return confirmApprove('@Model.GI', '@Model.LogGI')">
                                Approve
                            </button>
                        }
                        </div>


                </div>
            </div>
        </div>
    </div>
}