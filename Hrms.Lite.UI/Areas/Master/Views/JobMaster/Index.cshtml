@model Hrms.Lite.Shared.Master.JobMaster

<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/Master/jobMaster.js"></script>

<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Job Master
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Job Master
                    </li>

                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
    </div>
    <!--end::Container-->
</div>
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body ">
                            <div class="jm-subtitle">Positions available for recruitment across departments and branches</div>

                            <div class="jm-toolbar">
                                <div class="sraech-slider jm-search">
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="Search job title or code">
                                </div>
                                    <button id="addJobMaster" type="button" class="btn btn-primary jm-add-btn" onclick="onAddNewOrEditClick('CREATE')">
                                        <i class="fas fa-plus"></i> Add New Job
                                    </button>
                                
                            </div>

                            <div class="jm-filters">
                                <select id="DepartmentFilter" class="form-control form-control-sm jm-filter" onchange="loadJobMasterList()">
                                    <option value="0">Department: All</option>
                                    @foreach (var item in (SelectList)ViewBag.DepartmentDropDown)
                                    {
                                        <option value="@item.Value">@item.Text</option>
                                    }
                                </select>
                                <select id="StatusFilter" class="form-control form-control-sm jm-filter" onchange="loadJobMasterList()">
                                    <option value="">Status: All</option>
                                    <option value="ACTIVE">Active</option>
                                    <option value="INACTIVE">Inactive</option>
                                    <option value="APPROVAL_PENDING">Pending</option>
                                </select>
                            </div>

                            <div id="JobMasterList">
                                @await Html.PartialAsync("_JobMasterList")
                            </div>

                        </div>
                        <div id="AddNewOrEditSlider">

                        </div>
                        <div id="ApproveSlider">

                        </div>
                    </div>
                </div>
            </div>

        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>
