@model Hrms.Lite.Shared.Master.EmployeeDocumentType
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");



        //$('#Pendingtable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');

        });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table division-master-pending pt-1">
    @Html.HiddenFor(m => m.EmployeeDocumentTypeList.Count)
    <table id="EmployeeDocumentTypePendingtable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                @*<th scope="col">Type</th>*@
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>
            @{


                if (Model.EmployeeDocumentTypeList != null && Model.EmployeeDocumentTypeList.Count > 0)
                {

                    for (int i = 0; i < Model.EmployeeDocumentTypeList.Count; i++)
                    {

                        <tr>

                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Code)
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.ApproveMode)
                            @Html.HiddenFor(m => m.EmployeeDocumentTypeList[i].MakerChecker)
                            <td data-label="Name">@Model.EmployeeDocumentTypeList[i].Name</td>
                            <td data-label="ShortName">@Model.EmployeeDocumentTypeList[i].ShortName</td>
                            @*<td data-label="Type">@Model.EmployeeDocumentTypeList[i].DocumentType.Name</td>*@
                            <td data-label="Entry Type">@Model.EmployeeDocumentTypeList[i].Mode</td>
                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="divisionapprove"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.EmployeeDocumentTypeList[i].GI', '@Model.EmployeeDocumentTypeList[i].LogGI','APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="divisionapprove"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.EmployeeDocumentTypeList[i].GI', '@Model.EmployeeDocumentTypeList[i].LogGI', 'APPROVAL',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                            </td>

                        </tr>
                    }
                }

            }

        </tbody>
    </table>
</div>











