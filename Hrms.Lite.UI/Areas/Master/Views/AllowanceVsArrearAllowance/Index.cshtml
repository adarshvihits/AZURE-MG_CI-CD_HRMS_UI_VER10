@model Hrms.Lite.Shared.Master.AllowanceVsArrearAllowance
@{

    Layout = "~/Views/Shared/_Layout.cshtml";

}
    <script src="~/js/jquery.min.js"></script>

    <script src="~/scripts/Master/allowanceVsArrearAllowance.js"></script>



   

<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Allowance Vs Arrear Allowance
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Allowance Vs Arrear Allowance

                    </li>

                </ul>
            </div>
        </div>


    </div>

</div>

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">

    <div class="d-flex flex-column-fluid">

        <div class="container full-width">

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body ">



                            <div class="row tab-style-button">
                                <div class="tab-button-wrap">


                                    <div class="tab-items select-option d-flex">

                                        <div class="tab-items select-option">
                                            <div class="sraech-slider">
                                                <div class="search-slider-inner">
                                                    <i class="fa fa-search" onclick="$('#searchList').focus();"></i>
                                                </div>
                                                <input id="searchList" type="text" class="form-control form-control-sm"
                                                       placeholder="Search Here" onkeyup="searchRows()">
                                            </div>


                                        </div>


                                    </div>
                                </div>
                                @using (Html.BeginForm("", "", FormMethod.Post, new { id = "arrearvsAllowanceform" }))
                                {
                                    <div id="List">
                                        @await Html.PartialAsync("AllowanceVsArrearAllowanceList")

                                    </div>
                                    <div class="row card-footer-bottom-fixed">


                                        <div class="col-md-12">
                                            <a type="button" class="btn btn-default float-right mobile-full-width" onclick="Save()">
                                                Save
                                            </a>

                                        </div>


                                    </div>


                                }


                            </div>

                        </div>
                    </div>
                </div>




                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->
    </div>

</div>