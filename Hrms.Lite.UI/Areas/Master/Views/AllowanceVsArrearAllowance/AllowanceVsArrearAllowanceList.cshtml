@model Hrms.Lite.Shared.Master.AllowanceVsArrearAllowance

    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table allowance_vs_arrearallowance vertical-scroll-500 mt-5">

        @Html.HiddenFor(m => m.AllowanceVsArrearAllowanceList.Count)
    <table id="ArrearVsAllowanceTable" class="common-table dt-width-fix">
            <thead>
                <tr class="table-dark">

                    <th scope="col">Allowance</th>
                    <th scope="col">Arrear Vs Allowance</th>



                </tr>
            </thead>
            <tbody>
                @if (Model.AllowanceVsArrearAllowanceList != null && Model.AllowanceVsArrearAllowanceList.Count > 0)
                {

                    for (int i = 0; i < Model.AllowanceVsArrearAllowanceList.Count; i++)
                    {

                <tr>
                    
                    <td data-label="Allowance">
                        @Html.HiddenFor(m => m.AllowanceVsArrearAllowanceList[i].AllowanceCode)
                        @Html.DisplayFor(m => m.AllowanceVsArrearAllowanceList[i].AllowanceName)
                    </td>
                    <td data-label="Arrear Vs Allowance">
                        @Html.DropDownListFor(m => m.AllowanceVsArrearAllowanceList[i].ArrearAllowance.Code ,(SelectList)ViewBag.ArrearAllowance, "--Select--",new { @class = "form-control form-control-sm" })

                    </td>


                </tr>




                    }
                }
                </tbody>


            </table>

            </div>

