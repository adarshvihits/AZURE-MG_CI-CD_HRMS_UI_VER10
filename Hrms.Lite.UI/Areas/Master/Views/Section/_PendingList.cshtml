@model Hrms.Lite.Shared.Master.Section
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");

        //$('#PendingSectiontable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');


    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table section-master-pending pt-1">
    @Html.HiddenFor(m => m.SectionList.Count)
    <table id="PendingSectiontable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Ax Dimension</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>


            @{
                if (Model.SectionList != null && Model.SectionList.Count > 0)
                {
                    for (int i = 0; i < Model.SectionList.Count; i++)

                    {
                        <tr>
                            @Html.HiddenFor(m => m.SectionList[i].MakerChecker)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Name">@Model.SectionList[i].Name</td>
                            <td data-label="ShortName">@Model.SectionList[i].ShortName</td>
                            <td data-label="Ax Dimension">@Model.SectionList[i].AxDimention</td>
                            <td data-label="Entry Type">@Model.SectionList[i].Mode</td>
                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="sectionapprove"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.SectionList[i].GI','@Model.SectionList[i].LogGI','APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                { 
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="sectionapprove"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.SectionList[i].GI', '@Model.SectionList[i].LogGI', 'APPROVAL',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>                                
                                }
                                </td>

                        </tr>
                    }
                }

            }
        </tbody>
    </table>
</div>
