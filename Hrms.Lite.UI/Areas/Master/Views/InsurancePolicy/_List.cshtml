@model Hrms.Lite.Shared.Master.InsurancePolicy
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>
    (Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/settings.js"></script>
<script>
        $(document).ready(function () {
            $('.pendingTabCount').html("@Model.PendingCount");
        });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table  insurance-policy-master-list ">
    @Html.HiddenFor(m => m.InsurancePolicyList.Count)
    <table class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Policy Name</th>

                <th scope="col">Short Name</th>

                <th scope="col">Insurance Company</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.InsurancePolicyList != null && Model.InsurancePolicyList.Count > 0)
                {
                    for (int i = 0; i < Model.InsurancePolicyList.Count; i++)

                    {
                        <tr>

                            <td data-label="Name">@Model.InsurancePolicyList[i].Name</td>

                            <td data-label="short Name">@Model.InsurancePolicyList[i].ShortName</td>
                            <td data-label="Short Name">@Model.InsurancePolicyList[i].InsuranceCompany.Name</td>
                            <td data-label="Actions">

                                <div>

                                    @Html.HiddenFor(model => Model.LogGI)
                                    @Html.HiddenFor(model => Model.Description)
                                    @Html.HiddenFor(model => Model.Active)
                                    @Html.HiddenFor(m => m.InsurancePolicyList[i].EditActive)
                                    @Html.HiddenFor(model => Model.GI)
                                    @if (CurrentUserRoleActions.Modify == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="circleedit"
                                           class="btn btn-icon btn-edit icon-only" onclick="AddNewOrEditClick('MODIFY', '@Model.InsurancePolicyList[i].GI', '@Model.InsurancePolicyList[i].LogGI',@i)">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="circleedit"
                                           class="btn btn-icon btn-edit icon-only" onclick="AddNewOrEditClick('MODIFY', '@Model.InsurancePolicyList[i].GI', '@Model.InsurancePolicyList[i].LogGI',@i);
                                                swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#sliderView');});">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    @if (CurrentUserRoleActions.Delete == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deletecircle"
                                           class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.InsurancePolicyList[i].GI', '@Model.InsurancePolicyList[i].LogGI','DELETE',@i)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deletecircle"
                                           class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.InsurancePolicyList[i].GI', '@Model.InsurancePolicyList[i].LogGI', 'DELETE',@i);
                                           swal.fire(MasterPersmissionMsg)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            }

        </tbody>
    </table>
</div>