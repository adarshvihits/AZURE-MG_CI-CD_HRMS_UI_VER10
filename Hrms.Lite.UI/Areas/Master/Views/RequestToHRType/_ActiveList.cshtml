@model Hrms.Lite.Shared.Master.RequestToHRType
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");
           });
</script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table grade-list pt-1">
    @Html.HiddenFor(m => m.RequestToHRTypeList.Count)
    <table id="RequestTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>

            @if (Model.RequestToHRTypeList != null && Model.RequestToHRTypeList.Count > 0)
            {
                for (int i = 0; i < Model.RequestToHRTypeList.Count; i++)

                {
                    <tr>

                        @Html.HiddenFor(model => Model.LogGI)

                        @Html.HiddenFor(m => m.RequestToHRTypeList[i].EditActive)
                        @Html.HiddenFor(model => Model.GI)
                        <td data-label="Name">@Model.RequestToHRTypeList[i].Name</td>
                        <td data-label="ShortName">@Model.RequestToHRTypeList[i].ShortName</td>
                        <td data-label="Actions">
                            <div>

                                @if (CurrentUserRoleActions.Modify == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="rewardtypeMaseredit"
                                       class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY','@Model.RequestToHRTypeList[i].GI','@Model.RequestToHRTypeList[i].LogGI',@i)">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="rewardtypeMaseredit"
                                       class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY', '@Model.RequestToHRTypeList[i].GI', '@Model.RequestToHRTypeList[i].LogGI',@i);
                                           swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#CreateOrEditSlider');});">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>
                                }
                                @if (CurrentUserRoleActions.Delete == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="deleteRewardtypeMaster"
                                       class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.RequestToHRTypeList[i].GI','@Model.RequestToHRTypeList[i].LogGI','DELETE',@i)">
                                        <i class="icon-xl far fa-trash-alt"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="deleteRewardtypeMaster"
                                       class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.RequestToHRTypeList[i].GI', '@Model.RequestToHRTypeList[i].LogGI', 'DELETE',@i);
                                           swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-trash-alt"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }



        </tbody>
    </table>
</div>
