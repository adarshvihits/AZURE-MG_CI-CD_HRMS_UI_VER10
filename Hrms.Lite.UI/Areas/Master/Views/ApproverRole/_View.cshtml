@model Hrms.Lite.Shared.Master.ApproverRole
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
@using (Html.BeginForm("Delete", "ApproverRole", FormMethod.Post, new { @id = "deleteApproverRole" }))
{

    <div id="ApproverRoledelete" class="slider-forms slider-forms-open delete">
        <div class="slider-inner-style  new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('delete')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>Role Matrix Settings </h4>
            </div>
            <div class="add-padding">

                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Name</label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.Name)
                                @Html.HiddenFor(model => Model.Code)
                            </div>
                        </div>
                    </div>
                    @*<div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">
                        Short Name
                    </label>
                    <div class="view-details">
                        @Html.DisplayFor(model => Model.ShortName)
                    </div>
                </div>
            </div>*@

                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Country</label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.CountryName)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="row-outer matrix_location">
                            <label class="view-title">
                                Location
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.LocationName)
                            </div>
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="row-outer matrix_location">
                            <label class="view-title">Department</label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.DepartmentName)
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="row-outer matrix_location">
                            <label class="view-title">
                                Section
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.SectionName)
                            </div>
                        </div>
                    </div>

                </div>
                <div class="row ">

                    <div class="col-md-12">
                        <label class="view-title">Active</label>
                        <div class="view-details">
                            @if (Model.Active == true)
                            {

                                <button type="button" class="btn btn-icon btn-tick">
                                    <i class="icon-xl fas fa-check"></i>
                                </button>

                            }
                            else
                            {
                                <button type="button" class="btn btn-icon btn-close">
                                    <i class="icon-xl fas fa-times"></i>

                                </button>
                            }
                        </div>
                    </div>

                </div>



            </div>
        </div>
    </div>
}