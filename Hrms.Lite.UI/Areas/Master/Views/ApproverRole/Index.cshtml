@model Hrms.Lite.Shared.Master.ApproverRole
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/scripts/Master/ApproverRole.js"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Role Matrix
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Role Matrix

                    </li>

                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->


<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body">
                            <div class="mobile-tab-section">
                                <div class="row mb-2">
                                    <div class="col-12">
                                        <div class="form-group">
                                            <label>Type</label>
                                            <select class="form-control form-control-sm "
                                                    id="tabsDropdownPayrollGroup"
                                                    onchange="tabClick(this)">
                                                <option value="ACTIVE">Active</option>
                                                <option value="INACTIVE">Inactive</option>

                                            </select>

                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="row tab-style-button">
                                <div class="tab-button-wrap">
                                    <div class="tab-items">
                                        <span class="btn-title active ActiveTab" onclick="OnTabClick('ActiveTab','ACTIVE')">
                                            Active
                                            @*<span class="btn-notification AllTabCount">@Model.ActiveCount</span>*@
                                        </span>
                                    </div>
                                    <div class="tab-items medium">
                                        <span class="btn-title InActiveTab" onclick="OnTabClick('InActiveTab','INACTIVE')">
                                            Inactive
                                            @*<span class="btn-notification InActiveTabCount">@Model.InactiveCount</span>*@
                                        </span>
                                    </div>

                                    <div class="tab-items mt-2">
                                        <!-- <label>Group By</label> -->
                                        <div class="form-group filter-combobox mt-0 d-flex ">
                                            <label class="d-flex align-items-center pr-3">	Classification Type</label>
                                            @Html.DropDownListFor(m => m.Applicability, (SelectList)ViewBag.ClassificationApplicability, "ALL", new { @class = "form-control form-control-sm", @onchange = "getList()", @style = "width:180px;" })
                                            <span id="workFlowCode"></span>
                                        </div>
                                    </div>
                                    <div class="tab-items mt-2">
                                        <div class="form-group filter-combobox mt-0 d-flex">
                                        <label class="d-flex align-items-center pr-3">Country</label>
                                            @Html.DropDownListFor(m => m.Country, (SelectList)ViewBag.Country, "All", new { @class = "form-control form-control-sm", @onchange = "getList()", @style = "width:180px" })
                                            @*@Html.DropDownListFor(m => m.Region.Code, (SelectList)ViewBag.Region, "All", new { @class = "form-control form-control-sm", @onchange = "getList()" })*@
                                        </div>
                                    </div>


                                    <div class="tab-items select-option">

                                        <div class="sraech-slider">
                                            <div class="search-slider-inner">
                                                <i class="fa fa-search"></i>
                                            </div>
                                            <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                                   placeholder="ID/Name">
                                        </div>
                                        <a data-bs-toggle="tooltip" title="Export to Excel"
                                           class="btn btn-excel">
                                            <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                        </a>

                                    </div>


                                </div>
                            </div>

                            <div id="ApproverRoleList">
                                @await Html.PartialAsync("_ApproverRoleList")

                            </div>

                            <!-- <end table></end> -->
                            <div class="row card-footer-bottom-fixed">
                               
                                @*<div class="col-md-6">
                                    <a type="button"
                                       class="btn btn-default  mobile-full-width slider-btn" onclick="getDefaultSettings()">
                                        Default Role Matrix
                                    </a>
                                </div>*@
                                <div class="col-md-12 align-right">                                  
                                    <button id="addapproverrole" type="button"
                                            class="btn btn-default float-right mobile-full-width " onclick="onAddNewOrEditClick('CREATE')">
                                        Add Role Matrix
                                    </button>    
                                </div>

                            </div>
                            <div id="AddNewOrEditSlider">


                            </div>
                            <div id="DeleteSlider">


                            </div>
                            <div id="viewSlider">


        </div>
        <div id="pendinglist">

        </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

