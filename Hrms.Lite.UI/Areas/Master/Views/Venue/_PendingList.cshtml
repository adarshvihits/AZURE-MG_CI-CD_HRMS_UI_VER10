@model Hrms.Lite.Shared.Master.Venue
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");
    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table zone-pending pt-1">
    @Html.HiddenFor(m => m.VenueList.Count)
    <table id="PendingVenueTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Region</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>

            @{
                if (Model.VenueList != null && Model.VenueList.Count > 0)
                {
                    for (int i = 0; i < Model.VenueList.Count; i++)
                    {
                        <tr>
                            <td data-label="Name">
                                @Html.HiddenFor(m => m.VenueList[i].MakerChecker)
                                @Model.VenueList[i].Name
                            </td>
                            <td data-label="ShortName">@Model.VenueList[i].ShortName</td>
                            <td data-label="Region">@Model.VenueList[i].Region?.Name</td>
                            <td data-label="Entry Type">@Model.VenueList[i].Mode</td>
                            <td data-label="Approve">

                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="venueapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.VenueList[i].GI','@Model.VenueList[i].LogGI','APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="venueapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.VenueList[i].GI', '@Model.VenueList[i].LogGI', 'APPROVAL',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }
            }

        </tbody>
    </table>
</div>