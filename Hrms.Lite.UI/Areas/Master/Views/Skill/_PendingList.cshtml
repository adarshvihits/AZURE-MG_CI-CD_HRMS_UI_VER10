
@model Hrms.Lite.Shared.DataBank.Generic.Master.Skill
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");

        //$('#PendingSkillTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');


    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table skill-master-pending pt-1">
    @Html.HiddenFor(m => m.SkillList.Count)
    <table id="PendingSkillTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Skill Type</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>

            @{


                if (Model.SkillList != null && Model.SkillList.Count > 0)
                {
                    for (int i = 0; i < Model.SkillList.Count; i++)

                    {

                        <tr>
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Name">@Model.SkillList[i].Name</td>
                            @Html.HiddenFor(m => m.SkillList[i].MakerChecker)
                            <td data-label="ShortName">@Model.SkillList[i].ShortName</td>
                            <td data-label="SkillType">@Model.SkillList[i].SkillType.Name</td>
                            <td data-label="Entry Type">@Model.SkillList[i].Mode</td>
                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="skillapprove"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.SkillList[i].GI','@Model.SkillList[i].LogGI','APPROVAl',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                { 
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="skillapprove"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.SkillList[i].GI', '@Model.SkillList[i].LogGI', 'APPROVAl',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }

                                </td>

                        </tr>
                    }
                }


            }
        </tbody>
    </table>
</div>