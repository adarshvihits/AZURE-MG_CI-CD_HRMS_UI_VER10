@*@model Hrms.Lite.Shared.General.EmployeeHeader*@
@model Hrms.Lite.Shared.Master.RoleMatrix
<script>
   $(document).ready(function () {
       debugger
        $.ajax({

            type: 'GET',
            url: '/AccessFile/GetFileStorageType',

            success: function (data) {

                if (data == 'BLOB') ifAzure();
                else
                    document.getElementById('myImage').src = '@Model.EmployeeHeader.EmployeeAbsoluteUri';

            },
            error: function (xhr, textStatus, errorThrown) {
                if ($($.parseHTML(xhr.responseText)).filter(".Login_Session").length > 0) {
                    window.location.reload();
                }
                else {
                    document.body.id = "kt_body";
                    $('body').html(xhr.responseText);
                }
            }
        });
        function ifAzure() {
            $.ajax({
                type: "POST",
                url: "/AccessFile/ViewAsBackGroundImage", // do not hard code your url's
                data: { filename: '@Model.EmployeeHeader.FileName' },
                success: function (data, jqXHR, response) {

                    if (jqXHR = "success") {
                        var mimeType = getMimeTypeFromFilename('@Model.EmployeeHeader.FileName');
                        debugger
                        document.getElementById('myImage').src = mimeType + data;


                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                }
            });
        }
   })

</script>
