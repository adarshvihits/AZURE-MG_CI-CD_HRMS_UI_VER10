
@model Hrms.Lite.Shared.Master.UserRole
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");
        });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table user-role-master-list pt-1">
    @Html.HiddenFor(m => m.UserRoleList.Count)
    <table id="ActiveUserRoleTable" class="common-table layout-ihits">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Salary Visibility</th>
                <th scope="col">Permitted Action</th>
                <th scope="col">Tab Settings</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>

            @{
                if (Model.UserRoleList != null && Model.UserRoleList.Count > 0)
                {
                    int i = 0;
                    foreach (var item in Model.UserRoleList)
                    {
                        <tr>
                            @Html.HiddenFor(m => m.UserRoleList[i].EditActive)
                            <td data-label="Name">@item.userrole</td>
                            <td data-label="Short Name">@item.ShortName</td>
                            <td data-label="Salary Visibility">@item.SalaryVisibility.Name</td>
                            <td data-label="Permitted Action">@item.PermittedActions</td>
                            <td data-label="Tab Settings">                                
                                <a class="btn btn-icon btn-edit icon-only " onclick="AddTabSettings('@item.GI')" data-bs-toggle="tooltip" title="Add">
                                    <i class="fa fa-plus" aria-hidden="true"></i>
                                </a>
                            </td>
                            <td data-label="Actions">
                                <div>
                                    @if (CurrentUserRoleActions.Modify == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="addcountry"
                                           class="btn btn-icon btn-edit icon-only " onclick="Edit('@item.GI', '@item.LogGI','@i')">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="addcountry"
                                           class="btn btn-icon btn-edit icon-only " onclick="swal.fire(MasterPersmissionMsg).then(function () { Edit('@item.GI', '@item.LogGI','@i')});">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>

                                    }
                                    @if (CurrentUserRoleActions.Delete == true)
                                    {
                                        <!-- delete Slider  start-->
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deletecountry"
                                           class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="Delete('@item.GI','@item.LogGI','@i')">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deletecountry"
                                           class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="swal.fire(MasterPersmissionMsg).then(function () {Delete('@item.GI','@item.LogGI','@i')});">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr>

                        <td colspan="3" stye="text-align:center;">  No  Data Found</td>
                    </tr>
                }

            }



        </tbody>
    </table>
</div>

<div class="modal fade tab-settings-popup" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content popup">
            <div class="modal-header" style="padding:10px">
                <h5 class="modal-title" id="exampleModalLabel">Tab Settings</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body">


              


            </div>

        </div>
    </div>
</div>