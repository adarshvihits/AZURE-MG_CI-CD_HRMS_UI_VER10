@model Hrms.Lite.Shared.Master.UserRole
@using (Html.BeginForm("", "", FormMethod.Post, new { @id = "UserVsTab" }))
{

<div class="col-md-12">
    <div class="ihits-table table-border applicable-menus-list mb-0 vertical-scroll-250">
        <table>
            <thead>
                <tr class="table-light">
                    <th scope="col">Menu</th>
                    <th scope="col">Tabs</th>
                    <th scope="col">Applicability</th>

                </tr>
            </thead>
            <tbody>
                @if (Model.UserVsMenuTab != null && Model.UserVsMenuTab.Count > 0)
                {
                    for (int i = 0; i < Model.UserVsMenuTab.Count; i++)
                    { 
                <tr>
                    <td data-label="Module">
                        @Html.HiddenFor(m => m.UserVsMenuTab[i].GI)
                        @Html.HiddenFor(m => m.UserVsMenuTab[i].TabCode)
                        @Html.HiddenFor(m => m.UserVsMenuTab[i].MenuCode)
                        @Model.UserVsMenuTab[i].MenuName
                    </td>
                    <td data-label="Sub Module">@Model.UserVsMenuTab[i].TabName</td>
                    <td data-label="Menu">

                        <div class="checkbox-inline">

                            <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted mr-1">
                                @Html.CheckBoxFor(m => m.UserVsMenuTab[i].Applicable)
                
                    <span></span>
                    </label>
                   
</div>
                        </td>
                            
                         
                        </tr>
                    }
                }


            </tbody>

        </table>
    </div>
</div>
<div class="col-md-12 align-right mt-4">

    <a type="button" class="btn btn-default  mobile-full-width" onclick="UserVSTabSave()">
        Save
    </a>
</div>
}
