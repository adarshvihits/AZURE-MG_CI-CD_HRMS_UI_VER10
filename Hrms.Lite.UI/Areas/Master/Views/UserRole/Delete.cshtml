@model Hrms.Lite.Shared.Master.UserRole
@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/scripts/Master/userRole.js"></script>
<script src="~/js/jquery.min.js"></script>
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    User Role
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        <a href="@Url.Action("Index", "UserRole", new { Area = "Master" })" class="">
                            User Role List
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        User Role

                    </li>
                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->


<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body ">

                            <div class="row">
                                <div class="col-md-2">
                                    <div class="row-outer">
                                        <label class="view-title">User Role</label>
                                        <div class="view-details">@Model.userrole</div>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="row-outer">
                                        <label class="view-title">Short Name</label>
                                        <div class="view-details">@Model.ShortName</div>
                                    </div>

                                </div>
                                <div class="col-md-2">
                                    <div class="row-outer">
                                        <label class="view-title">Salary Visibility</label>
                                        <div class="view-details">
                                            @if (@Model.Active == true)
                                            {
                                                <button type="button" class="btn btn-icon btn-tick"><i class="icon-xl fas fa-check"></i></button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-icon btn-close"><i class="icon-xl fas fa-times"></i></button>
                                            }
                                        </div>
                                    </div>

                                </div>

                                <div class="col-md-6">
                                    <h6>Actions Allowed in Masters</h6>
                                    <div class="row-outer">
                                        <div class="view-details inline-block mr-5">
                                            <label class="view-title">View</label>
                                            @if (@Model.View == true)
                                            {
                                                <button type="button" class="btn btn-icon btn-tick"><i class="icon-xl fas fa-check"></i></button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-icon btn-close"><i class="icon-xl fas fa-times"></i></button>
                                            }
                                        </div>
                                        <div class="view-details inline-block mr-5">
                                            <label class="view-title">Create</label>
                                            @if (@Model.Create == true)
                                            {
                                                <button type="button" class="btn btn-icon btn-tick"><i class="icon-xl fas fa-check"></i></button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-icon btn-close"><i class="icon-xl fas fa-times"></i></button>
                                            }
                                        </div>
                                        <div class="view-details inline-block mr-5">
                                            <label class="view-title">Modify</label>
                                            @if (@Model.Modify == true)
                                            {
                                                <button type="button" class="btn btn-icon btn-tick"><i class="icon-xl fas fa-check"></i></button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-icon btn-close"><i class="icon-xl fas fa-times"></i></button>
                                            }
                                        </div>
                                        <div class="view-details inline-block mr-5">
                                            <label class="view-title">Approve</label>
                                            @if (@Model.Approve == true)
                                            {
                                                <button type="button" class="btn btn-icon btn-tick"><i class="icon-xl fas fa-check"></i></button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-icon btn-close"><i class="icon-xl fas fa-times"></i></button>
                                            }
                                        </div>
                                        <div class="view-details inline-block mr-5">
                                            <label class="view-title">Delete</label>

                                            @if (@Model.Delete == true)
                                            {
                                                <button type="button" class="btn btn-icon btn-tick"><i class="icon-xl fas fa-check"></i></button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-icon btn-close"><i class="icon-xl fas fa-times"></i></button>
                                            }
                                        </div>


                                    </div>

                                </div>

                            </div>
                            <div class="row">
                                <div class="col-md-1">
                                    <div class="row-outer">
                                        <label class="view-title">Active</label>
                                        <div class="view-details">
                                            @if (@Model.Active == true)
                                            {
                                                <button type="button" class="btn btn-icon btn-tick"><i class="icon-xl fas fa-check"></i></button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-icon btn-close"><i class="icon-xl fas fa-times"></i></button>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="row-outer">
                                        <label class="view-title">Remarks</label>
                                        <div class="view-details">@Model.Remarks</div>
                                    </div>
                                </div>
                            </div>


                            <div class="row mt-5">
                                <div class="col-md-12">
                                    <div class="ihits-table table-border user-role-menu-list mb-0 vertical-scroll-300">
                                        <table>
                                            <thead>
                                                <tr class="table-light">
                                                    <th scope="col">Module</th>
                                                    <th scope="col">Sub Module</th>
                                                    <th scope="col">Menu</th>
                                                    <th scope="col">
                                                        <div class="checkbox-inline">
                                                            <label class="checkbox checkbox-outline checkbox-success">
                                                                <input type="checkbox" name="Checkboxes15" checked="checked">
                                                                <span></span>All
                                                            </label>
                                                        </div>
                                                    </th>

                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model.UserVsMenu != null && Model.UserVsMenu.Count > 0)
                                                {

                                                    for (int i = 0; i < Model.UserVsMenu.Count; i++)
                                                    {

                                                        <tr>
                                                            <td data-label="m.UserVsMenu[i].Name">@Model.UserVsMenu[i].ModuleName</td>
                                                            <td data-label="m.UserVsMenu[i].Name">@Model.UserVsMenu[i].SubModuleName</td>
                                                            <td data-label="m.UserVsMenu[i].Name">@Model.UserVsMenu[i].Name</td>
                                                            <td data-label="Y/S">
                                                                <div class="checkbox-inline">
                                                                    <button type="button" class="btn btn-icon btn-tick"><i class="icon-xl fa fa-check-circle"></i></button>
                                                                </div>
                                                            </td>
                                                        </tr>



                                                    }
                                                }
                                            </tbody>

                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- <end table></end> -->
                            <div class="row card-footer-bottom-fixed">

                                <div class="col-md-12 align-right">
                                    @if (CurrentUserRoleActions.Delete == true)
                                    {
                                        <a onclick="deleteClick('@Model.GI')" data-bs-toggle="tooltip" title="" data-bs-original-title="Delete"
                                           class="btn btn-icon btn-delete big-btn float-none">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }                                   
                                    </div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>




            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>
<!--end::Content-->
<!--begin::Header-->
