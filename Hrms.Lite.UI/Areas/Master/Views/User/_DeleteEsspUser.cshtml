@model Hrms.Lite.Shared.Master.User
    <script src="~/js/tooltip.js"></script>
<div id="userMasterESSPDelete" class="slider-forms slider-forms-open deleteEssp">
    <div class="slider-inner-style">
        <div class="slider-form-close" onclick="CloseSlider('deleteEssp')">
            <i class="ki ki-close icon-xs text-muted"></i>
        </div>
        <h4>User</h4>
        <div class="row">
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">User Name</label>
                    <div class="view-details">@Model.EmployeeName</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Employee Name</label>
                    <div class="view-details">@Model.Name</div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Mobile</label>
                    <div class="view-details">@Model.Mobile </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Email</label>
                    <div class="view-details">
                        @Model.Email
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Active From</label>
                    <div class="view-details">
                        @Model.ActiveFrom
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Active To</label>
                    <div class="view-details">
                        @Model.ActiveTo
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12">
                <div class="row-outer">
                    <label class="view-title">Active</label>
                    <div class="view-details">
                        <button type="button" class="btn btn-icon btn-tick"><i class="icon-xl fas fa-check"></i></button>
                    </div>
                </div>
            </div>
        </div>
        <div class="row my-3">

            <div class="col-md-12">
                <label class="view-title">Remarks</label>
                <div class="view-details">
                    @Model.Remarks
                </div>
            </div>
        </div>

        <div class="row card-footer-bottom-fixed border-none">

            <div class="col-md-12 align-right">

                <a type="button" data-bs-toggle="tooltip" title="Delete" class="btn btn-icon btn-delete big-btn float-none" onclick="DeleteUser('@Model.UserMasterGI')"><i class="icon-xl far fa-trash-alt"></i></a>
            </div>


        </div>
    </div>
</div>