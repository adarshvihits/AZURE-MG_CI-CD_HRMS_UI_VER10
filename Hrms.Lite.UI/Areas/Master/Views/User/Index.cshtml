@model Hrms.Lite.Shared.Master.User
@{
    ViewData["Title"] = "UserList";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/scripts/Master/user.js"></script>

<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script>
    $(document).ready(function () {
        debugger;

    /*    fillData();*/
        hideSpinner();

    });
</script>
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    User
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        User

                    </li>

                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->


<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body ">
                            <div class="mobile-tab-section">
                                <div class="row mb-2">
                                    <div class="col-12">
                                        <div class="form-group">
                                            <label>Type</label>
                                            <select class="form-control form-control-sm "
                                                    id="tabsDropdownQualification"
                                                    onchange="tabClick(this)">
                                                <option value="ACTIVE">Active</option>
                                                <option value="INACTIVE">Inactive</option>
                                                <option value="APPROVAL_PENDING">
                                                    Pending
                                                </option>

                                            </select>

                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="row tab-style-button">
                                <div class="tab-button-wrap">


                                    <div class="tab-items medium">
                                        <span  class="btn-title active tab1" onclick="tabClick('tab1','ESSP')">
                                            ESSP
                                            <span class="btn-notification essp">@Model.EsspCount</span>
                                        </span>
                                    </div>
                                    <div class="tab-items medium">
                                        <span  class="btn-title tab2" onclick="tabClick('tab2','HR')">
                                            HR
                                            <span class="btn-notification hr">@Model.HrCount</span>
                                        </span>
                                    </div>
                                    <div class="tab-items medium">
                                        <span class="btn-title tab3" onclick="tabClick('tab3','Non_Employee')">
                                            Non Employee Users
                                            <span class="btn-notification nonEmp">@Model.NonEmployeeUsersCount</span>
                                        </span>
                                    </div>
                                    <div class="tab-items medium">
                                        <span class="btn-title tab4" onclick="tabClick('tab4','INACTIVE')">
                                            Inactive
                                            <span class="btn-notification  ">@Model.InactiveCount</span>
                                        </span>
                                    </div>
                                    <div class="tab-items low">
                                        <span class="btn-title tab5" onclick="tabClick('tab5','APPROVAL_PENDING')">
                                            Approval Pending
                                            <span class="btn-notification approval">@Model.PendingCount</span>
                                        </span>
                                    </div>



                                    <div class="tab-items select-option">

                                        <div class="sraech-slider">
                                            <div class="search-slider-inner">
                                                <i class="fa fa-search"></i>
                                            </div>
                                            <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                                   placeholder="ID/Name">
                                        </div>
                                        <a data-bs-toggle="tooltip" title="Export to Excel" onclick="onExportToExcelClick()"
                                           class="btn btn-excel">
                                            <i class="icon-xl far fa-file-excel"></i>
                                        </a>

                                    </div>


                                </div>
                            </div>



                            <!--Partial views here-->
                            <div id="esspList">
                                @await Html.PartialAsync("_ESSPList", Model)
                            </div>
                            @*<div id="hrList" class="hide">
                                @await Html.PartialAsync("_HRList", Model)
                            </div>
                            <div id="nonEmployeeUsersList" class="hide">
                                @await Html.PartialAsync("_NonEmployeeUsersList", Model)
                            </div>
                            <div id="inActiveList" class="hide">
                                @await Html.PartialAsync("_InActiveList", Model)
                            </div>
                            <div id="approvalPendingList" class="hide">
                                @await Html.PartialAsync("_ApprovalPendingList", Model)
                            </div>*@


                            <!--Partial views here-->
                            <!-- <end table></end> -->
                            <div class="row card-footer-bottom-fixed">

                                <div class="col-md-12 align-right">
                                    <button class="btn btn-default float-right mobile-full-width" onclick="onCreateHRBackofficeUsersClick()">Create HR Backoffice Users</button>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>




            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>
<!--end::Content-->
