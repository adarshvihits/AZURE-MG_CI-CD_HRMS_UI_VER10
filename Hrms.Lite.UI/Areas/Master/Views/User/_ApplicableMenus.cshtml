@model Hrms.Lite.Shared.Master.User





    <div class="col-md-12">
        <div class="ihits-table table-border applicable-menus-list mb-0 vertical-scroll-250">
            <table>
                <thead>
                    <tr class="table-light">
                        <th scope="col">Module</th>
                        <th scope="col">Sub Module</th>
                        <th scope="col">Menu</th>

                    </tr>
                </thead>
                <tbody>
                    @if (Model.ApplicableMenus != null && Model.ApplicableMenus.Count > 0)
                    {

                        for (int i = 0; i < Model.ApplicableMenus.Count; i++)
                        {
                            <tr>
                                <td data-label="Module">@Model.ApplicableMenus[i].Module</td>
                                <td data-label="Sub Module">@Model.ApplicableMenus[i].SubModule</td>
                                <td data-label="Menu">@Model.ApplicableMenus[i].Menus</td>
                            </tr>
                        }
                    }

                </tbody>

            </table>
        </div>
    </div>
