                                            <div class="row">
                                                
                                                    <div class="col-md-4">
                                                        <div class="ihits-table table-border advance-user-control-two-col mb-0 vertical-scroll-250">
                                                            <table id="grpC">
                                                                <thead>
                                                                    <tr class="table-light">
                                                                        <th scope="col">Group Company</th>
                                                                        <th scope="col">
                                                                            <label class="checkbox checkbox-outline checkbox-success">
                                                                                <input type="checkbox" name="Checkboxes15" id="allGrpCmp" onclick="onAllClick('allGrpCmp','grpC')">
                                                                                <span class="mr-1"></span>
                                                                            </label>
                                                                        </th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @if (Model.UserVsEmployeeApplicability.GroupCompany != null && Model.UserVsEmployeeApplicability.GroupCompany.Count > 0)
                                                                    {

                                                                        for (int i = 0; i < Model.UserVsEmployeeApplicability.GroupCompany.Count; i++)
                                                                        {
                                                                            @Html.HiddenFor(m => m.UserVsEmployeeApplicability.GroupCompany[i].Code)
                                                                            <tr>
                                                                                <td data-label="Allowance">@Model.UserVsEmployeeApplicability.GroupCompany[i].Name</td>
                                                                                <td data-label="Y/S">
                                                                                    <div class="checkbox-inline">
                                                                                        <label class="checkbox checkbox-outline checkbox-success">
                                                                                            @*<input type="checkbox" name="Checkboxes15">*@
                                                                                            @Html.CheckBoxFor(m => m.UserVsEmployeeApplicability.GroupCompany[i].Applicable, new { @onclick = "onChkBoxClick(this,'allGrpCmp','grpC')" })
                                                                                            <span></span>
                                                                                        </label>
                                                                                    </div>
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    }
                                                                </tbody>

                                                            </table>
                                                        </div>
                                                    </div>
                                                
                                              
                                            </div>
                                        </div>
                                    </ul>
                                </div>


                                <!-- <end table></end> -->
                                <div class="row card-footer-bottom-fixed">

                                    <div class="col-md-12 align-right">
                                        <button type="button"
                                                class="btn btn-default float-right mobile-full-width" onclick="SaveUser()">
                                            Save
                                        </button>

                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>
                </div>




                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->
    </div>
    <!--end::Content-->
}


