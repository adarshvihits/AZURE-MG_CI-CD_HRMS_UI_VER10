                                                <div class="col-md-4">
                                                    <div class="ihits-table table-border advance-user-control-two-col mb-0 vertical-scroll-250">
                                                        <table id="dsg">
                                                            <thead>
                                                                <tr class="table-light">
                                                                    <th scope="col">Designation</th>
                                                                    <th scope="col">
                                                                        <div class="checkbox-inline">
                                                                            <label class="checkbox checkbox-outline checkbox-success">
                                                                                <input type="checkbox" name="Checkboxes15" id="allDsg" onclick="onAllClick('allDsg','dsg')">
                                                                                <span></span>
                                                                            </label>
                                                                        </div>
                                                                    </th>

                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @if (Model.UserVsEmployeeApplicability.Designation != null && Model.UserVsEmployeeApplicability.Designation.Count > 0)
                                                                {

                                                                    for (int i = 0; i < Model.UserVsEmployeeApplicability.Designation.Count; i++)
                                                                    {
                                                                        @Html.HiddenFor(m => m.UserVsEmployeeApplicability.Designation[i].Code)
                                                                        <tr>
                                                                            <td data-label="Allowance">@Model.UserVsEmployeeApplicability.Designation[i].Name</td>
                                                                            <td data-label="Y/S">
                                                                                <div class="checkbox-inline">
                                                                                    <label class="checkbox checkbox-outline checkbox-success">
                                                                                        @*<input type="checkbox" name="Checkboxes15">*@
                                                                                        @Html.CheckBoxFor(m => m.UserVsEmployeeApplicability.Designation[i].Applicable, new { @onchange = "onChkBoxClick(this,'allDsg','dsg')" })
                                                                                        <span></span>
                                                                                    </label>
                                                                                </div>
                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                }

                                                            </tbody>

                                                        </table>
                                                    </div>
                                                </div>

                                                <div class="col-md-4">
                                                    <div class="ihits-table table-border advance-user-control-two-col mb-0 vertical-scroll-250">
