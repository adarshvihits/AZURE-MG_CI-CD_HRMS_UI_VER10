@model Hrms.Lite.Shared.Master.User
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/scripts/Master/user.js"></script>
<script src="~/js/jquery.min.js"></script>
<script>
    const myTimeout = setTimeout(changeFocus, 500);

    function changeFocus() {
        moveCursorToEnd('Name');
    }
</script>

@using (Html.BeginForm("Create", "User", FormMethod.Post, new { @id = "createUser", @class = "display-flex" }))
{
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->
            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">
                        User
                    </h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>
                        <li class="breadcrumb-item text-muted">
                            <a href="@Url.Action("Index", "User", new { Area = "Master" })">User List</a>
                        </li>
                        <li class="breadcrumb-item text-muted">
                            User
                        </li>

                    </ul>
                </div>
            </div>
            <!--end::Header Menu Wrapper-->
            <!--begin::Topbar-->
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->


    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->

                <div class="row height-100per">

                    <div class="col-md-12">
                        <div class="card card-custom height-100per">

                            <div class="card-body">

                                <div class="newcard">
                                    <div class="row">
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>User ID</label><span class="Mandatory">*</span>
                                                @Html.HiddenFor(m=>m.NonEmployeePassword)
                                                @Html.TextBoxFor(m => m.Name, new { @class = "form-control form-control-sm", @placeholder = "User ID",
                                               onkeypress = "return event.charCode != 32",
                                               @maxlength = 120, @onblur = "validateById('#Name', 'UName')" })
                                            </div>
                                            <span id="UName"></span>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>User Role</label><span class="Mandatory">*</span>
                                                @Html.DropDownListFor(m => m.UserRole.Code, (SelectList)ViewBag.UserR, "--Select--", new { @class = "form-control form-control-sm", @onchange = "validateById('#UserRole_Code', 'URole')" })
                                            </div>
                                            <span id="URole"></span>
                                        </div>


                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>Mobile</label><span class="Mandatory">*</span>
                                                @Html.TextBoxFor(m => m.Mobile, new { @class = "form-control form-control-sm", @placeholder = "Mobile", @maxlength = 10, @onblur = "validateMobileNumber('Mobile', 'Mob')", @onkeypress = "return onlyNumberKey(event)" })
                                            </div>
                                            <span id="Mob"></span>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label>Email</label><span class="Mandatory">*</span>
                                                @Html.TextBoxFor(m => m.Email, new { @class = "form-control form-control-sm", @placeholder = "Email", @maxlength = 120, @onblur = "validateEmailID(this, 'email')" })
                                            </div>
                                            <span id="email"></span>
                                        </div>

                                    </div>

                                    <div class="row">



                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>Active From</label><span class="Mandatory">*</span>
                                                <div class="input-group date">
                                                    @Html.TextBoxFor(m => m.ActiveFrom, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "readonly", @placeholder = "Active From", @onchange = "validateById('#ActiveFrom', 'AFrom')" })
                                                    <div class="input-group-append">
                                                        <span class="input-group-text">
                                                            <i class="la la-calendar"></i>
                                                        </span>
                                                    </div>
                                                </div>
                                                <span id="AFrom"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>Active To</label><span class="Mandatory">*</span>
                                                <div class="input-group date">
                                                    @Html.TextBoxFor(m => m.ActiveTo, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "readonly", @placeholder = "Active To", @onchange = "validateById('#ActiveTo', 'ATo')" })
                                                    <div class="input-group-append">
                                                        <span class="input-group-text">
                                                            <i class="la la-calendar"></i>
                                                        </span>
                                                    </div>
                                                </div>
                                                <span id="ATo"></span>
                                            </div>
                                        </div>

                                        <div class="col-md-2 mt-6">
                                            <div class="d-flex align-items-center">
                                                <div> Active</div>
                                                <label class="switch">
                                                    @Html.CheckBoxFor(m => m.Active)
                                                    <span class="slider round"></span>
                                                </label>
                                            </div>
                                        </div>
                                        <div class="col-md-4">
                                            <div class="row-outer">
                                                <label>Remarks</label><span class="Mandatory">*</span>
                                                @Html.TextBoxFor(m => m.Remarks, new { @class = "form-control form-control-sm", @placeholder = "Remarks", @maxlength = 250, @onblur = "validateById('#Remarks', 'Rem')" })

                                            </div>
                                            <span id="Rem"></span>

                                        </div>

                                        <div class="col-md-2 mt-5 pl-0 ">
                                            <button type="button" class="btn btn-secondary mobile-full-width float-right view-appl" data-bs-toggle="modal" data-target="" onclick="onViewApplicableMenuClick()">
                                                View Applicable Menus
                                            </button>


                                        </div>

                                    </div>
                                </div>
                                <h6 class="mt-4">User vs Employee Applicability</h6>

                                <div class="tab-outer tab-only">
                                    <ul class="ulList">
                                        <div class="tab-top-right">
                                            <div class="checkbox-inline">
                                                <label class="checkbox checkbox-outline checkbox-success">
                                                    @Html.CheckBoxFor(m => m.SelectAll, new { @onchange = "onSelectAllClick()" })
                                                    <span></span>Select All
                                                </label>
                                                <label class="checkbox checkbox-outline checkbox-success">
                                            </div>
                                        </div>


                                        <!-- Tab Start -->
                                        <div class="TabMoving"></div>
                                        <li class="tabOne clickOnTab active">Job Details</li>
                                        <div id="tabOne" class="tab-content active">
