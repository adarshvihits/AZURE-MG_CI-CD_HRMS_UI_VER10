                                        <div class="checkbox-inline">
                                            <label class="checkbox checkbox-outline checkbox-success">
                                                <input  type="checkbox" name="Checkboxes15" checked="checked" disabled>
                                                <span></span>HR
                                            </label>
                                            <label class="checkbox checkbox-outline checkbox-success">

                                        </div>
                                    </div>
                                    <div class="form-group ml-3">

                                        <div class="checkbox-inline">
                                            <label class="checkbox checkbox-outline checkbox-success">
                                                @Html.CheckBoxFor(m => m.FullPermission, new {  @disabled="true"})

                                                <span></span>Is Admin
                                            </label>
                                            <label class="checkbox checkbox-outline checkbox-success">

                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-2 mt-3">
                                    <div class="row-outer">
                                        <label class="view-title">User Role</label>
                                        <div class="view-details">@Model.UserRole.Name</div>
                                    </div>

                                </div>
                            </div>
                            <div class="showCheckBox display-block">


                                <h6 class="mt-4">User vs Employee Applicability</h6>

                                <div class="tab-outer tab-only">
                                    <ul class="ulList">
                                        <div class="tab-top-right">
                                            <div class="checkbox-inline">
                                                <label class="checkbox checkbox-outline checkbox-success">
                                                    @*<input type="checkbox" name="Checkboxes15" checked="checked">*@
                                                    @Html.CheckBoxFor(m => m.SelectAll, new { @disabled = "disabled" })
                                                    <span></span>Select All
                                                </label>
                                                <label class="checkbox checkbox-outline checkbox-success">
                                            </div>
                                        </div>
                                        <!-- Tab Start -->
                                        <div class="TabMoving"></div>
                                        <li class="tabOne clickOnTab active">Job Details</li>
                                        <div id="tabOne" class="tab-content active">
                                            <div class="row">
                                                <div class="col-md-4">
                                                    <div class="ihits-table table-border advance-user-control-two-col mb-0 vertical-scroll-250">
                                                        <table>
                                                            <thead>
                                                                <tr class="table-light">
                                                                    <th scope="col">Designation</th>

                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @if (Model.UserVsEmployeeApplicability.Designation != null && Model.UserVsEmployeeApplicability.Designation.Count > 0)
                                                                {

                                                                    for (int i = 0; i < Model.UserVsEmployeeApplicability.Designation.Count; i++)
                                                                    {
                                                                        @Html.HiddenFor(m => m.UserVsEmployeeApplicability.Designation[i].Code)
                                                                        <tr>
                                                                            <td data-label="Allowance">@Model.UserVsEmployeeApplicability.Designation[i].Name</td>

                                                                        </tr>
                                                                    }
                                                                }

                                                            </tbody>

                                                        </table>
                                                    </div>
                                                </div>

