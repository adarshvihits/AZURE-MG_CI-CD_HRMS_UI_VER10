                            <div class="row">

                                <div class="col-md-2 mt-6">
                                    <label class="switch">
                                        Active
                                        @*<input type="checkbox" checked="">*@
                                        @Html.CheckBoxFor(m => m.Active)
                                        <span class="slider round"></span>
                                    </label>
                                </div>

                                <div class="col-md-4 mt-3">
                                    <div class="row-outer">
                                        <label class="view-title">Remarks</label>
                                        <div class="view-details">@Model.Remarks</div>
                                    </div>

                                </div>
                                <div class="col-md-2 mt-8">
