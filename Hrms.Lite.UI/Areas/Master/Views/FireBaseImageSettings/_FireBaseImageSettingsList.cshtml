
@model Hrms.Lite.Shared.Master.FireBaseImageSettings

<script src="~/js/settings.js"></script>
<style>

    .imgwidd {
        width: 40% !important;
    }
    </style>

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "FireBaseImageSettingslist" }))
{



    @*<script src="~/js/tooltip.js"></script>*@
    <div class="ihits-table table-border hover-color odd-even Firebase-Image-Settings ">
        <table id="test" class="common-table dt-width-fix">

            <thead>
                <tr class="table-dark">
                    <th scope="col">
                        Code
                        @*@Html.HiddenFor(m => Model.HRLetterSignatureList.Count)*@
                    </th>
                    <th scope="col">Name</th>
                    <th scope="col">Images</th>
                    <th scope="col">Enable Notification</th>
                    <th scope="col">Action</th>

                </tr>
            </thead>
            <tbody>
                @{
                    if (Model.FireBaseImageSettingsList != null && Model.FireBaseImageSettingsList.Count > 0)
                    {
                        for (int i = 0; i < Model.FireBaseImageSettingsList.Count; i++)

                        {
                                <tr>
                                    <td data-label="EmployeeID">
                                        @Model.FireBaseImageSettingsList[i].Code
                                        @Html.HiddenFor(m => Model.Code)
                                    </td>
                                    <td data-label="Employee Name">@Model.FireBaseImageSettingsList[i].Name </td>
                                    <td data-label="Designation" >
                                        
                                     <img src=@Model.FireBaseImageSettingsList[i].Base64string class="imgwidd">

                                    </td>
                                    @*<td data-label="Priority">@Model.FireBaseImageSettingsList[i].Enablenotification </td>*@

                                    <td data-label="Aadhar">
                                        @if (Model.FireBaseImageSettingsList[i].Enablenotification)
                                        {
                                            <button type="button"
                                                    class="btn btn-icon btn-tick border-radius align-center w-100">
                                                <i class="icon-xl fas fa-check"></i>
                                            </button>
                                        }
                                        else
                                        {

                                            <button type="button"
                                                    class="btn btn-icon btn-close border-radius w-100">
                                                <i class="icon-xl fas fa-times"></i>
                                            </button>
                                        }
                                    </td>

                                    <td data-label="Actions" >
                                        <div>

                                            <a data-bs-toggle="tooltip" title="Edit"
                                               id="departmentedit"
                                               class="btn btn-icon btn-edit icon-only float-right" onclick="AddNewOrEditClick('@Model.FireBaseImageSettingsList[i].Code')">
                                                <i class="icon-xl fas fa-pencil-alt"></i>
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                        }
                    }
                }
            </tbody>





        </table>





    </div>

}