@model Hrms.Lite.Shared.Master.HRPlanningMaster
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@using System.Linq;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
    var HRPlanningMasterList = Model.HRPlanningMasterList ?? new List<Hrms.Lite.Shared.Master.HRPlanningMaster>();
    var approvedHeadcount = HRPlanningMasterList.Sum(x => x.PlanCount);
    var totalPlanLines = HRPlanningMasterList.Count;
    var departmentsCovered = HRPlanningMasterList.Where(x => x.Department != null).Select(x => x.Department.Code).Distinct().Count();
    var totalDepartments = ((List<Hrms.Lite.Shared.General.Dropdown>)ViewBag.Department)?.Count ?? 0;
    Func<string, string> statusBadgeClass = status =>
    {
        switch ((status ?? "").Trim().ToUpper())
        {
            case "APPROVED": return "badge-success";
            case "PENDING": return "badge-warning";
            case "REJECTED": return "badge-danger";
            default: return "badge-secondary";
        }
    };
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>


 <link href="~/css/hrplan.css" rel="stylesheet" type="text/css" />







<div class="stat-row">
  <div class="stat-tile tone-">

    <div class="stat-label">Approved headcount</div>
    <div class="stat-value">@approvedHeadcount</div>
    <div class="stat-sub">@totalPlanLines approved lines</div>
  </div>
  <div class="stat-tile tone-">
    <div class="stat-label">Total plan lines</div>
    <div class="stat-value">@totalPlanLines</div>
    <div class="stat-sub">Current filter selection</div>
  </div>
  <div class="stat-tile tone-warning" style="cursor:pointer" onclick="ShowPendingList()" title="View pending approvals">
    <div class="stat-label">Pending approval</div>
    <div class="stat-value">@Model.PendingCount</div>
    <div class="stat-sub">@(Model.PendingCount > 0 ? "Awaiting review" : "Nothing waiting")</div>
  </div>
  <div class="stat-tile tone-accent">
    <div class="stat-label">Departments covered</div>
    <div class="stat-value">@departmentsCovered</div>
    <div class="stat-sub">@departmentsCovered of @totalDepartments departments</div>
  </div>
</div>












