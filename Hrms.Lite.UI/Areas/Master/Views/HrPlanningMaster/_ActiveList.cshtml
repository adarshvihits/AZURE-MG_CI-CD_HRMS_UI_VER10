<div class="ihits-table table-border hover-color odd-even mobile-responsive-table hr-planning-master-listss pt-1">
    @Html.HiddenFor(m => m.HRPlanningMasterList.Count)
    <table id="activeTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th >ID</th>
                <th >Department</th>
                <th >Section</th>
                <th >Grade</th>
                <th >Plan Count</th>
                <th >Avg Salary</th>
                <th >Total Salary</th>
                <th >Status</th>
                <th >Actions</th>
            </tr>
        </thead>
        <tbody>

            @if (HRPlanningMasterList.Count > 0)
            {

                for (int i = 0; i < HRPlanningMasterList.Count; i++)
                {
                      @Html.HiddenFor(m => m.HRPlanningMasterList[i].EditActive)
                        @Html.HiddenFor(m => m.HRPlanningMasterList[i].Logcode)
                    <tr data-gi="@HRPlanningMasterList[i].GI">
                      
                        <td data-label="ID">@HRPlanningMasterList[i].planId</td>
                        <td data-label="Department">@HRPlanningMasterList[i].DepartmentName</td>
                        <td data-label="Section">@HRPlanningMasterList[i].SectionName</td>
                        <td data-label="Grade">@HRPlanningMasterList[i].GradeName</td>
                        <td data-label="Plan Count">@HRPlanningMasterList[i].PlanCount</td>
                        <td data-label="Avg Salary">&#8377; @HRPlanningMasterList[i].AvgSalary</td>
                        <td data-label="Total Salary">&#8377; @HRPlanningMasterList[i].TotalSalary</td>
                        <td data-label="Status"><span class="badge @statusBadgeClass(HRPlanningMasterList[i].Status)">@HRPlanningMasterList[i].Status</span></td>
                        <td data-label="Actions">
                            <div>
                                @if (CurrentUserRoleActions.Modify == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="hrPlanningMaseredit"
                                       class="btn btn-icon btn-edit icon-only " onclick="OnEditClick('MODIFY','@HRPlanningMasterList[i].Logcode', '@HRPlanningMasterList[i].LogGI','@HRPlanningMasterList[i].GI',@i, this)">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="hrPlanningMaseredit"
                                       class="btn btn-icon btn-edit icon-only " onclick="OnEditClick('MODIFY', '@HRPlanningMasterList[i].Logcode', '@HRPlanningMasterList[i].LogGI', '@HRPlanningMasterList[i].GI',@i, this);
                                       swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#hrPlanningEditSlider');});">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>
                                }
                                </div>

                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
    <div id="EditOrDeleteHrPlanning"></div>
</div>
