@model Hrms.Lite.Shared.Master.HRPlanningMaster
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
@using (Html.BeginForm("Delete", "HrPlanningMaster", FormMethod.Post, new { id = "deleteHrPlanning" }))
{
    <div id="hrPlanningGradeMasterDelete" class="slider-forms slider-forms-open hrPlanningMasterDeleteSlider">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('hrPlanningMasterDeleteSlider')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>Manpower Plan</h4>
            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Department</label>
                        <div class="view-details">
                            @Model.Department?.Name
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Section
                        </label>
                        <div class="view-details">
                            @Model.Section?.Name
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Grade</label>
                        <div class="view-details">
                            @Model.Grade?.Name
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Plan Count</label>
                        <div class="view-details">
                            @Model.PlanCount
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">

                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Avg Salary</label>
                        <div class="view-details">
                            &#8377; @Model.AvgSalary
                        </div>
                    </div>

                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Total Salary</label>
                        <div class="view-details">
                            &#8377; @Model.TotalSalary
                        </div>
                    </div>


                </div>
            </div>

            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    @if (CurrentUserRoleActions.Delete == true)
                    {
                        <a type="button" data-bs-toggle="tooltip" title="Delete" class="btn btn-icon btn-delete big-btn float-none" onclick="confirmDelete('@Model.GI', '@Model.LogGI')">
                            <i class="icon-xl far fa-trash-alt"></i>
                        </a>
                    }
                    </div>


            </div>

        </div>
    </div>
}