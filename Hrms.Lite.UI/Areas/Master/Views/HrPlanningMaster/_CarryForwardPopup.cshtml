@model Hrms.Lite.Shared.Master.HRPlanningMaster
<p class="text-muted">
    Copies approved plan lines (branch, department, section, grade) from one period into another. Only combinations that don't already exist in the target period are copied — existing lines are left untouched.
</p>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label>From Period</label>
            @Html.DropDownList("FromPlanningPeriod", (SelectList)ViewBag.PlanningPeriod, "--Select--", new { @class = "form-control form-control-sm" })
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            <label>To Period</label>
            @Html.DropDownList("ToPlanningPeriod", (SelectList)ViewBag.PlanningPeriod, "--Select--", new { @class = "form-control form-control-sm" })
        </div>
    </div>
</div>
