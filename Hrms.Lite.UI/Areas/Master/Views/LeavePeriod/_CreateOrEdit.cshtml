@model Hrms.Lite.Shared.Master.LeavePeriod
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/bootstrap-datepicker.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });
</script>
@using (Html.BeginForm("Save", "LeavePeriod", FormMethod.Post, new { id = "leavePeriodsave" }))
{

    <div id="addleaveperiod" class="slider-forms slider-forms-open AddNewOrEdit">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddNewOrEdit')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>
                Leave Period
            </h4>
            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Name
                            <span class="Mandatory">*</span>
                        </label>
                        @Html.HiddenFor(model => Model.Mode)
                        @Html.HiddenFor(model => Model.GI)
                        @Html.HiddenFor(model => Model.LogGI)
                        @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm LPName", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'LeavePName')", maxlength = "120" })
                        <span id="LeavePName"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Short Name
                            <span class="Mandatory">*</span>
                        </label>
                        @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm LPShortName", @placeholder = "Short Name", @onblur = "validate(this,'LeavePShort')", maxlength = "5" })
                        <span id="LeavePShort"></span>
                    </div>
                </div>
            </div>
            <div class="row mb-2">
                <div class="col-md-6">
                    <label>
                        From
                        <span class="Mandatory">*</span>
                    </label>
                    <div class="input-group date">
                        @Html.TextBoxFor(Model => Model.From, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2 fromdate", @readonly = "true", @placeholder = "From Date", @onchange = "validate(this,'FromDate')" })

                        <div class="input-group-append">
                            <span class="input-group-text">
                                <i class="la la-calendar"></i>
                            </span>
                        </div>
                    </div>
                    <span id="FromDate"></span>
                </div>

                <div class="col-md-6">
                    <label>
                        To
                        <span class="Mandatory">*</span>
                    </label>
                    <div class="input-group date">

                        @Html.TextBoxFor(Model => Model.To, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2 toDate", @readonly = "true", @placeholder = "To Date", @onchange = "validateToDate(this,'ToDate')" })

                        <div class="input-group-append">
                            <span class="input-group-text">
                                <i class="la la-calendar"></i>
                            </span>
                        </div>
                    </div>
                    <span id="ToDate"></span>
                </div>


            </div>



            <div class="row my-3">


                <div class="col-md-12 d-flex align-items-center">
                    <div class="d-flex align-items-center">
                        <div> Active</div>
                        <label class="switch" onchange="ActiveInactiveValidationLeaveperiod('LEAVE PERIOD', '@Model.Code')">
                            @Html.HiddenFor(m=>Model.Code)
                            @Html.CheckBoxFor(model => model.Active,new { @id="Leaveperiod"})
                            <span class="slider round"></span>
                        </label>
                    </div>
                </div>

            </div>



            <div class="row my-3">

                <div class="col-md-12">
                    @if (Model.Mode == "CREATE")
                    {
                        <label>Description</label>
                        @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm LPDescription", @placeholder = "Description", maxlength = "250" })

                    }
                    @if (Model.Mode == "MODIFY")
                    {
                        <label class="view-title">Description</label>
                        <div class="view-details">

                            @Html.DisplayFor(Model => Model.Description)
                            @Html.HiddenFor(model => Model.Description)
                        </div>
                    }
                </div>
            </div>

            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    @if (Model.Mode == "CREATE")
                    {
                        @if (CurrentUserRoleActions.Create == true)
                        {

                            <button type="button" class="btn btn-default  mobile-full-width" onclick="LeavePeriodSave('Save')">
                                Save
                            </button>
                        }
                    }
                    @if (Model.Mode == "MODIFY")
                    {
                        @if (CurrentUserRoleActions.Modify == true)
                        {
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="LeavePeriodSave('Modify')">
                                Modify
                            </button>
                        }
                    }
                    </div>

            </div>
        </div>
    </div>
}