@model Hrms.Lite.Shared.Master.WorkLocation
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");



        //$('#PendingWorkLocation').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');

        });
</script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table physicallocation-master-pending p-1">
    @Html.HiddenFor(m => m.WorkLocationList.Count)
    <table id="PendingWorkLocation" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>


            @{


                if (Model.WorkLocationList != null && Model.WorkLocationList.Count > 0)
                {

                    for (int i = 0; i < Model.WorkLocationList.Count; i++)
                    {

                        <tr>
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(m => m.WorkLocationList[i].MakerChecker)
                            <td data-label="Name">@Model.WorkLocationList[i].Name</td>
                            <td data-label="ShortName">@Model.WorkLocationList[i].ShortName</td>
                            <td data-label="Entry Type">@Model.WorkLocationList[i].Mode</td>
                            <td data-label="Approve">

                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="physicallocationapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.WorkLocationList[i].GI','@Model.WorkLocationList[i].LogGI','APPROVE',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                { 
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="physicallocationapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.WorkLocationList[i].GI', '@Model.WorkLocationList[i].LogGI', 'APPROVE',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                </td>
                        </tr>
                    }
                }


            }

        </tbody>
    </table>
</div>









