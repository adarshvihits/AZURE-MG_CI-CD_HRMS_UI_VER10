@model Hrms.Lite.Shared.Master.WorkLocation
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script src="~/scripts/Master/WorkLocation.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");



        //$('#WorkLocationTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');

        });
</script>


<div class="ihits-table table-border hover-color odd-even mobile-responsive-table physicallocation-master-list pt-1">
    @Html.HiddenFor(m => m.WorkLocationList.Count)
    <table id="WorkLocationTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>


            @{
                if (Model.WorkLocationList != null && Model.WorkLocationList.Count > 0)
                {

                    for (int i = 0; i < Model.WorkLocationList.Count; i++)
                    {
                        <tr>
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Active)
                            @Html.HiddenFor(m => m.WorkLocationList[i].EditActive)
                            <td data-label="Name">@Model.WorkLocationList[i].Name</td>
                            <td data-label="Short Name">@Model.WorkLocationList[i].ShortName</td>
                            <td data-label="Actions">
                                <div>
                                    @if (CurrentUserRoleActions.Modify == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="physicallocationedit"
                                           class="btn btn-icon btn-edit icon-only">
                                            <i class="icon-xl fas fa-pencil-alt" onclick="onAddNewOrEditClick('MODIFY', '@Model.WorkLocationList[i].GI', '@Model.WorkLocationList[i].LogGI',@i)"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="physicallocationedit"
                                           class="btn btn-icon btn-edit icon-only">
                                            <i class="icon-xl fas fa-pencil-alt" onclick="onAddNewOrEditClick('MODIFY', '@Model.WorkLocationList[i].GI', '@Model.WorkLocationList[i].LogGI',@i);
                                            swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#AddNewOrEditSlider');});"></i>
                                        </a>
                                    }
                                    @if (CurrentUserRoleActions.Delete == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="physicallocationdelete"
                                           class="btn btn-icon  icon-only mobile-full-width btn-delete">
                                            <i class="icon-xl far fa-trash-alt" onclick="onDeleteClick('@Model.WorkLocationList[i].GI','@Model.WorkLocationList[i].LogGI','DELETE',@i)"></i>
                                        </a>
                                    }
                                    else
                                    { 
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="physicallocationdelete"
                                           class="btn btn-icon  icon-only mobile-full-width btn-delete">
                                            <i class="icon-xl far fa-trash-alt" onclick="onDeleteClick('@Model.WorkLocationList[i].GI', '@Model.WorkLocationList[i].LogGI', 'DELETE',@i);
                                            swal.fire(MasterPersmissionMsg);"></i>
                                        </a>
                                    }
                                    </div>

                            </td>
                        </tr>
                    }
                }


            }



        </tbody>
    </table>
</div>