@model Hrms.Lite.Shared.Master.CompanyDocuments
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });


</script>
@using (Html.BeginForm("Save", "CompanyDocuments", FormMethod.Post, new { id = "CompanyDocumentsSave" }))
{
    <div id="companydocedit" class="slider-forms slider-forms-open AddNewOrEdit">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddNewOrEdit')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>
                    Company Documents
                </h4>
            </div>
            <div class="add-padding">

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.Code)
                            @*@Html.HiddenFor(model => Model.Description)*@
                            @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'CompanyDocumentsName')", maxlength = "120" })
                            <span id="CompanyDocumentsName"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Short Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm DesShtName", @placeholder = "Short Name", @onblur = "validate(this,'CompanyDocumentsShortName')", maxlength = "5" })

                            <span id="CompanyDocumentsShortName"></span>
                        </div>
                    </div>

                </div>

                <div class="row my-3">
                    <div class="col-md-6 ">
                        <div >
                            <label></label>
                            <div class="form-group filter-combobox  mb-0 mt-0">
                                @Html.DropDownListFor(m => m.DocumentType.Code, (SelectList)ViewBag.doc, "--Select--", new { @class = "form-control form-control-sm" })
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 ">
                        <div class="form-group ">
                                <div>  Active</div>
                                <label class="switch" @*onchange="ActiveInactiveValidation('DSG', '@Model.Code')"*@>
                                    @Html.HiddenFor(m => Model.Code)
                                    @Html.CheckBoxFor(model => model.Active, new { @id = "activeInactive" })
                                    <span class="slider round"></span>
                                </label>
                        </div>
                    </div>
                </div>
                <div class="row my-3">
                    <div class="col-md-12">
                        <label>Description</label>
                        <div class="view-details">
                            @if (Model.Mode == "CREATE")
                            {
                                @Html.TextAreaFor(model => Model.Description, new { @class = "form-control form-control-sm DesDiscription", @placeholder = "Description", maxlength = "250" })
                            }
                            @if (Model.Mode == "MODIFY")
                            {
                                @Html.HiddenFor(model => Model.Description)

                                @Html.DisplayFor(model => Model.Description)
                            }
                        </div>
                    </div>
                </div>
                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12 align-right">
                        @if (Model.Mode == "CREATE")
                        {
                            @if (CurrentUserRoleActions.Create == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="onCompanyDocumentsSaveClick('Save')">
                                    Save
                                </button>
                            }
                        }
                        @if (Model.Mode == "MODIFY")
                        {

                            @if (CurrentUserRoleActions.Modify == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="onCompanyDocumentsSaveClick('Modify')">
                                    Modify
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
