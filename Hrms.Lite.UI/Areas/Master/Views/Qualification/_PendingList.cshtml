
@model Hrms.Lite.Shared.DataBank.Generic.Master.Qualification
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/settings.js"></script>
<script src="~/js/tooltip.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");



        //$('#PendingTableQualification').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');

        });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table qualification-master-pending pt-1">
    @Html.HiddenFor(m => m.QualificationList.Count)
    <table id="PendingTableQualification" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>


            @{


                if (Model.QualificationList != null && Model.QualificationList.Count > 0)
                {


                    for (int i = 0; i < Model.QualificationList.Count; i++)
                    {

                        <tr>
                            @Html.HiddenFor(m => m.QualificationList[i].MakerChecker)
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Name">@Model.QualificationList[i].Name</td>
                            <td data-label="ShortName">@Model.QualificationList[i].ShortName</td>
                            <td data-label="Entry Type">@Model.QualificationList[i].Mode</td>
                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="qualificationapprove"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.QualificationList[i].GI','@Model.QualificationList[i].LogGI','APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                { 
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="qualificationapprove"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.QualificationList[i].GI', '@Model.QualificationList[i].LogGI', 'APPROVAL',@i);
                                       swal.fire(MasterPersmissionMsg)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                </td>
                        </tr>
                    }
                }



            }

        </tbody>
    </table>
</div>