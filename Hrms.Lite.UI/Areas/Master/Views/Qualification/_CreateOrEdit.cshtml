@model Hrms.Lite.Shared.DataBank.Generic.Master.Qualification
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });
</script>
@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "Qualification-Save" }))

{



    <div id="addqualification" class="slider-forms slider-forms-open AddNewOrEdit">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddNewOrEdit')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>Qualification</h4>
            </div>
            <div class="add-padding">

                <div class="row">

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.GI)


                            @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm QName", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'QualificationName')", maxlength = "120", @onchange = "validate(this,'AssetName')" })
                            <span id="QualificationName"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">

                            <label>
                                Short Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm QShortName", @placeholder = "Short Name", @onblur = "validate(this,'QualshortName')", maxlength = "5" })
                            <span id="QualshortName"></span>
                        </div>
                    </div>
                </div>


                <div class="row my-1">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Qualification Type
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.DropDownListFor(Model => Model.QualificationTypeCode.Code, (SelectList)ViewBag.QualificationTypeDropdown, "--Select Qualification type--", new { @class = "form-control form-control-sm QType", @onblur = "validate(this,'QualType')" })
                            <span id="QualType"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mt-7 d-flex">
                            <label>
                                Is Professional :
                                <span class="Mandatory">*</span>
                            </label>
                            <div class="ml-4">
                                <label>
                                    @Html.RadioButtonFor(m => m.IsProfessional, "1")
                                    @*<span id="QISprofessional"></span>*@
                                    @*<label for="huey">Yes</label>*@
                                    <label>Yes</label>
                                </label>
                                <label>
                                    @Html.RadioButtonFor(m => m.IsProfessional, "0")
                                    @*<label for="dewey">No</label>*@
                                    <label>No</label>
                                </label>


                            </div>



                        </div>
                    </div>
                </div>
                <div class="row my-3">


                    <div class="col-md-12 d-flex align-items-center">
                        <div class="d-flex align-items-center">
                            <div> Active</div>
                            <label class="switch" onchange="ActiveInactiveValidationQualification('QUALIFICATION','@Model.Code')">
                                @Html.HiddenFor(m => Model.Code)
                                @Html.CheckBoxFor(Model => Model.Active, new { @id = "Activeinactivequalification" })
                                <span class="slider round"></span>
                            </label>
                        </div>
                    </div>


                </div>



                <div class="row my-3">

                    <div class="col-md-12">

                        @if (Model.Mode == "CREATE")
                        {
                            <label>Description</label>
                            @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm QDescription", @placeholder = "Description", maxlength = "250" })

                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            <label class="view-title">Description</label>
                            <div class="view-details">

                                @Html.DisplayFor(Model => Model.Description)
                                @Html.HiddenFor(model => Model.Description)
                            </div>
                        }
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">
                        @if (Model.Mode == "CREATE")
                        {
                            @if (CurrentUserRoleActions.Create == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="QualificationSave('Save')">
                                    Save
                                </button>
                            }
                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            @if (CurrentUserRoleActions.Modify == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="QualificationSave('Modify')">
                                    Modify
                                </button>
                            }
                        }
                        </div>

                </div>
            </div>
        </div>
    </div>
}