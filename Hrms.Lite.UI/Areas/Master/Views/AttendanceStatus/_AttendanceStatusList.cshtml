
@model Hrms.Lite.Shared.Master.AttendanceStatus
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}

<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");



        //$('#AttendanceStatusTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');

    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table attendancestatus-master-list pt-1 ">
    @Html.HiddenFor(model => Model.AttendanceStatusList.Count)
    <table id="AttendanceStatusTable" class="common-table layout-ihits dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Type</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>

        <tbody>


            @{
                if (Model.AttendanceStatusList != null && Model.AttendanceStatusList.Count > 0)
                {
                    for (int i = 0; i < Model.AttendanceStatusList.Count; i++)

                    {
                        <tr>

                            @Html.HiddenFor(m => m.AttendanceStatusList[i].EditActive)
                            <td data-label="Name"> @Model.AttendanceStatusList[i].Name</td>
                            <td data-label="Short Name">@Model.AttendanceStatusList[i].ShortName</td>
                            <td data-label="Short Name">@Model.AttendanceStatusList[i].AttendanceStatusType.Name</td>

                            <td data-label="Actions">
                                <div>
                                    @if (CurrentUserRoleActions.Modify == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit" id="addattendancestatus"
                                           class="btn btn-icon btn-edit icon-only" onclick="onAddNewOrEditClick('MODIFY', '@Model.AttendanceStatusList[i].GI','@Model.AttendanceStatusList[i].LogGI',@i)">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit" id="addattendancestatus"
                                           class="btn btn-icon btn-edit icon-only" onclick="onAddNewOrEditClick('MODIFY', '@Model.AttendanceStatusList[i].GI', '@Model.AttendanceStatusList[i].LogGI',@i);
                                           swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#AddNewOrEditSlider');});">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }

                                    @if (CurrentUserRoleActions.Delete == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete" id="deleteleave"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.AttendanceStatusList[i].GI','@Model.AttendanceStatusList[i].LogGI','DELETE',@i)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a> 
                                    }
                                    else
                                    { 
                                        <a data-bs-toggle="tooltip" title="Delete" id="deleteleave"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.AttendanceStatusList[i].GI', '@Model.AttendanceStatusList[i].LogGI', 'DELETE',@i);
                                           swal.fire(MasterPersmissionMsg);">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                    </div>
                            </td>
                        </tr>
                    }
                }


            }




        </tbody>

    </table>
</div>