@model Hrms.Lite.Shared.Master.AttendanceStatus
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}

<script src="~/js/tooltip.js"></script>
<script>

        $(document).ready(function () {
            debugger;
            var fontHEX = '@Model.ForeColor';
            var fontcolor = colours[fontHEX];
            $(".showFONT").html(fontcolor);

        });
</script>


@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "Approve-Attendance" }))
{
    <div id="approveleave" class="slider-forms slider-forms-open ApproveDiv">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('ApproveDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>Attendance Status</h4>
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Name</label>
                            <div class="view-details">
                                @Model.Name
                                @Html.HiddenFor(model => Model.LogGI)
                                @Html.HiddenFor(model => Model.GI)
                                @Html.HiddenFor(model => Model.Mode)
                                @Html.HiddenFor(model => Model.ApproveMode)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Short
                                Name
                            </label>
                            <div class="view-details">
                                @Model.ShortName
                            </div>
                        </div>
                    </div>

                </div>
                <div class="row ">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Type
                            </label>
                            <div class="view-details">
                                @Model.AttendanceStatusType.Name
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Font Color
                            </label>
                            <div class="view-details showFONT">
                                @Model.ForeColor
                            </div>
                        </div>
                    </div>


                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Active</label>
                            <div class="view-details">
                                @if (Model.Active == true)
                                {

                                    <button type="button" class="btn btn-icon btn-tick">
                                        <i class="icon-xl fas fa-check"></i>
                                    </button>

                                }
                                else
                                {
                                    <button type="button" class="btn btn-icon btn-close">
                                        <i class="icon-xl fas fa-times"></i>

                                    </button>
                                }
                            </div>
                        </div>

                    </div>
                </div>
                <div class="row my-3">

                    <div class="col-md-12">
                        <label class="view-title">Description</label>
                        <div class="view-details">
                            @Model.Description
                        </div>
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">
                        @if (CurrentUserRoleActions.Approve == true)
                        {
                            <button type="button"
                                    class="btn btn-danger  mobile-full-width" onclick="return confirmReject('@Model.GI', '@Model.LogGI')">
                                Reject
                            </button>
                            <button type="button"
                                    class="btn btn-default  mobile-full-width" onclick="return confirmApprove('@Model.GI', '@Model.LogGI')">
                                Approve
                            </button>
                        }
                        </div>


                </div>
            </div>
        </div>
    </div>
}