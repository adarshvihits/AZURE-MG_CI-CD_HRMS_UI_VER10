@model Hrms.Lite.Shared.DataBank.Generic.Master.ShiftDetails
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>

<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");



        //$('#ShiftTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');

    });
</script>


<div class="ihits-table table-border hover-color odd-even mobile-responsive-table shift-master-list pt-1 ">
    @Html.HiddenFor(m => m.ShiftList.Count)
    <table id="ShiftTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Shift Code</th>
                <th scope="col">Start Time</th>
                <th scope="col">End Time</th>
                <th scope="col">Scheduled hours</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>

            @{
                if (Model.ShiftList != null && Model.ShiftList.Count > 0)
                {
                    for (int i = 0; i < Model.ShiftList.Count; i++)

                    {
                        <tr>
                            @Html.HiddenFor(m => m.ShiftList[i].EditActive)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Active)
                            <td data-label="Name">@Model.ShiftList[i].Name</td>
                            <td data-label="ShortName">@Model.ShiftList[i].ShortName</td>
                            <td data-label="ShortName">@Model.ShiftList[i].ShiftCode</td>
                            <td data-label="starttime">@Model.ShiftList[i].ShiftStartTime</td>
                            <td data-label="endTime">@Model.ShiftList[i].ShiftEndTime</td>
                            <td data-label="scheduledhours">@Model.ShiftList[i].ScheduledHour</td>

                            <td data-label="Actions">
                                <div>
                                    @if (CurrentUserRoleActions.Modify == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit" id="shiftedit"
                                           class="btn btn-icon btn-edit icon-only">
                                            <i class="icon-xl fas fa-pencil-alt" onclick="onAddNewOrEditClick('MODIFY','@Model.ShiftList[i].GI','@Model.ShiftList[i].LogGI',@i)"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit" id="shiftedit"
                                           class="btn btn-icon btn-edit icon-only">
                                            <i class="icon-xl fas fa-pencil-alt" onclick="onAddNewOrEditClick('MODIFY', '@Model.ShiftList[i].GI', '@Model.ShiftList[i].LogGI',@i);
                                            swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#AddNewOrEditSlider');});"></i>
                                        </a>
                                    }
                                    @if (CurrentUserRoleActions.Delete == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete" id="shiftdelete"
                                           class="btn btn-icon  icon-only mobile-full-width btn-delete">
                                            <i class="icon-xl far fa-trash-alt" onclick="onDeleteClick('@Model.ShiftList[i].GI','@Model.ShiftList[i].LogGI','DELETE',@i)"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete" id="shiftdelete"
                                           class="btn btn-icon  icon-only mobile-full-width btn-delete">
                                            <i class="icon-xl far fa-trash-alt" onclick="onDeleteClick('@Model.ShiftList[i].GI', '@Model.ShiftList[i].LogGI', 'DELETE',@i);
                                            swal.fire(MasterPersmissionMsg);"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }


            }
    </table>
</div>
