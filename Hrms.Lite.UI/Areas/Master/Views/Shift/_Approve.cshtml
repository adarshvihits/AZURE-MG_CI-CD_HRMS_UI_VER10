@model Hrms.Lite.Shared.DataBank.Generic.Master.ShiftDetails
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script>

        $(document).ready(function () {
            debugger;

            var bgHEX = '@Model.DutyRosterBackgroundColor.Name';
            var bgcolor = colours[bgHEX];
            $(".showBG").html(bgcolor);
           var fontHEX = '@Model.DutyRosterFontColor.Name';
            var fontcolor = colours[fontHEX];
            $(".showFONT").html(fontcolor);

        });
</script>

@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "ApproveShift" }))
{
    <div id="shiftapprove" class="slider-forms slider-forms-open ApproveDiv">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('ApproveDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>Shift</h4>
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Name</label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.Name)
                                @Html.HiddenFor(model => Model.LogGI)
                                @Html.HiddenFor(model => Model.GI)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Short
                                Name
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.ShortName)
                            </div>
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Shift Code</label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.ShiftCode)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="view-title">Shift Category</label>
                        <div class="view-details">
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.ShiftCategory.Name)
                            </div>
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Shift Start Time</label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.ShiftStartTime)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Shift End Time
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.ShiftEndTime)
                            </div>
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Break Hours Start Time</label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.BreakHourStartTime)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Break Hours End Time
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.BreakHourEndTime)
                            </div>
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Break Hours  </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.BreakHour)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Scheduled Hours
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.ScheduledHour)
                            </div>
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Full Day Hours  </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.FullDayHour)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Half Day Hours
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.HalfDayHour)
                            </div>
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">HP/OP Full Day Hours  </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.HPOPFullDayHour)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                HP/OP Half Day Hours
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.HPOPHalfDayHour)
                            </div>
                        </div>
                    </div>

                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Duty Roster Background Color</label>
                            <div class="view-details showBG">
                                @Html.DisplayFor(model => Model.DutyRosterBackgroundColor.Name)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Duty Roster Font Color
                            </label>
                            <div class="view-details showFONT">
                                @Html.DisplayFor(model => Model.DutyRosterFontColor.Name)
                            </div>
                        </div>
                    </div>

                </div>
                <div class="row ">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">  Shift Allowance </label>
                            <div class="view-details">
                                @if (Model.ShiftAllowanceApplicable == true)
                                {

                                    <button type="button" class="btn btn-icon btn-tick">
                                        <i class="icon-xl fas fa-check"></i>
                                    </button>

                                }
                                else
                                {
                                    <button type="button" class="btn btn-icon btn-close">
                                        <i class="icon-xl fas fa-times"></i>

                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Active</label>
                            <div class="view-details">
                                @if (Model.Active == true)
                                {

                                    <button type="button" class="btn btn-icon btn-tick">
                                        <i class="icon-xl fas fa-check"></i>
                                    </button>

                                }
                                else
                                {
                                    <button type="button" class="btn btn-icon btn-close">
                                        <i class="icon-xl fas fa-times"></i>

                                    </button>
                                }
                            </div>
                        </div>

                    </div>

                </div>

                <div class="row my-3">

                    <div class="col-md-12">
                        <label class="view-title">Description</label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.Description)
                        </div>
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">

                        @if (CurrentUserRoleActions.Approve == true)
                        {
                            <button type="button" class="btn btn-danger  mobile-full-width" onclick="return confirmReject('@Model.GI','@Model.LogGI')">
                                Reject
                            </button>
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="return confirmApprove('@Model.GI','@Model.LogGI')">
                                Approve
                            </button>
                        }
                    </div>


                </div>
            </div>
        </div>
    </div>
}