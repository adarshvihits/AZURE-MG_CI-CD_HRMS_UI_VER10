<script>

    $(document).ready(function () {
        debugger;
       
        $('#BreakHourEndTime').change(function () {
            getBreakHour('#BreakHourEndTime','BreakEndTime');
        })

        $('#BreakHourStartTime').change(function () {
            getBreakHour('#BreakHourStartTime', 'BreakstartTime');
        })
        $('#ShiftStartTime').change(function () {
            getBreakHour('#ShiftStartTime', 'SStartTime');
        })
        $('#ShiftEndTime').change(function () {
            getBreakHour('#ShiftEndTime', 'SEndTime');
        })
        if (@Model.Mode= "MODIFY")
        {

            var bgHEX = '@Model.DutyRosterBackgroundColor.Name';
            var bgcolor = colours[bgHEX];
            $("#shiftDutyBgI").addClass('color-code ' + bgcolor);
            $("#shiftDutyBgSpan").html(bgcolor);


             var fontHEX = '@Model.DutyRosterFontColor.Name';
            var fontcolor = colours[fontHEX];
            $("#shiftDutyFontI").addClass('color-code ' + fontcolor);
            $("#shiftDutyFontSpan").html(fontcolor);

        }


    // SELECT COLOR CODE START
        $('.slider-color-list').click(function () {
            debugger
            var bg = $(this).attr('data-ticket');

            $("#DutyRosterBackgroundColor_Name").val(bg);
            validateById('#DutyRosterBackgroundColor_Name','BgName')
        });

            $('.slider-color-list-two').click(function () {
                debugger
                var front = $(this).attr('data-ticket');
                $(".ShiftFontColorName").val(front);
                validateById('#DutyRosterFontColor_Name', 'FName')

            });

        });

</script>
