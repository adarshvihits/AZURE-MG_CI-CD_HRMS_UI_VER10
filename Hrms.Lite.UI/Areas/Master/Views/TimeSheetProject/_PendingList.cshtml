@model Hrms.Lite.Shared.Master.TimeSheetProject
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script>
    $(document).ready(function () {
        debugger;
        @*$('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");*@
        $('.pendingTabCount').html("@Model.PendingCount");



        //$('#PendingdepartmentTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');

        });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table appraisal-role-pendinglist">
    @Html.HiddenFor(m => m.TimeSheetProjectList.Count)
    <table id="PendingdepartmentTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>

            @{


                if (Model.TimeSheetProjectList != null && Model.TimeSheetProjectList.Count > 0)
                {
                    for (int i = 0; i < Model.TimeSheetProjectList.Count; i++)

                    {

                        <tr>

                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Code)
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.ApproveMode)
                            @Html.HiddenFor(m => m.TimeSheetProjectList[i].MakerChecker)

                            <td data-label="Name">@Model.TimeSheetProjectList[i].Name</td>
                            <td data-label="Name">@Model.TimeSheetProjectList[i].ShortName</td>
                            <td data-label="Name">@Model.TimeSheetProjectList[i].Mode</td>
                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="circleapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.TimeSheetProjectList[i].GI', '@Model.TimeSheetProjectList[i].LogGI','APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="circleapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.TimeSheetProjectList[i].GI', '@Model.TimeSheetProjectList[i].LogGI', 'APPROVAL',@i);
                                       swal.fire(MasterPersmissionMsg)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                            </td>

                        </tr>
                    }
                }


            }
        </tbody>
    </table>
</div>