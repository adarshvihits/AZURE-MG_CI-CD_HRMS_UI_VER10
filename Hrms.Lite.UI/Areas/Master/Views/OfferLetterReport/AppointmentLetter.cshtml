@section scripts
    {
    <script src="/api/reports/resources/js/telerikReportViewer"></script>

    <script type="text/javascript">
        function onReady(e, args) {
            var kendoTouch = $(".trv-pages-area").data("kendoTouch");

            if (kendoTouch) {
                kendoTouch.unbind("doubletap");
            }
        }
        
        

        $(document).ready(function () {
              
            var code = $('#Basic_Filter_Location_Code').val();

            

            $("#appointmentLetter")
                .telerik_ReportViewer({  

                    serviceUrl: "/api/reports/",



                    pageReady: onReady,
                    ready: function () {
                        $("[data-command*='telerik_ReportViewer_toggleSendEmailDialog']").parent().hide();



                    },
                    reportSource: {


                      /*  report: "RoyalDriveAppointmentLetter.trdp",*/
                        report: '@Model.Url.offerLetter',



                        parameters: {

                            @*url: 'http://localhost:5001/api/AppointmentLetterReport/GetAppointmentLetterReport?empCode=' + parseInt('@Model.EmpCode'),*@
                             url: '@Model.Url.Urllink'+"/api/AppointmentLetterReport/GetAppointmentLetterReport?empCode=" + parseInt('@Model.EmpCode'),


                        }


                    },


                    viewMode: telerikReportViewer.ViewModes.PRINT_PREVIEW,

                    scaleMode: telerikReportViewer.ScaleModes.SPECIFIC,

                    scale: 1.0,

                    enableAccessibility: false,


                    sendEmail: { enabled: true }
                });




        });
    </script>
}
