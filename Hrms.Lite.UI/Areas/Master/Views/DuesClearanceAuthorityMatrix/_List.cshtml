@model Hrms.Lite.Shared.Master.DuesClearanceAuthorityMatrix
<script src="~/js/settings.js"></script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table DuesClearanceAuthorityMatrix-list vertical-scroll-450">
    @Html.HiddenFor(m => m.DuesClearanceAuthorityMatrixList.Count)
    <table id="DuesClearanceAuthorityTable">
        @*class="common-table"*@
        <thead>
            <tr class="table-dark">
                <th scope="col">Sl No</th>
                <th scope="col">Level Name</th>
                <th scope="col">Authority </th>

                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>

            @{if (Model.DuesClearanceAuthorityMatrixList != null && Model.DuesClearanceAuthorityMatrixList.Count > 0)
                {
                    for (int i = 0; i < Model.DuesClearanceAuthorityMatrixList.Count; i++)
                    {

                        @Html.HiddenFor(model => Model.DuesClearanceAuthorityMatrixList[i].LevelCode)
                        <tr>



                            <td data-label="Sl No">@Model.DuesClearanceAuthorityMatrixList[i].SlNo</td>
                            <td data-label="LevelName">@Model.DuesClearanceAuthorityMatrixList[i].LevelName</td>
                            <td data-label="Authority">@Model.DuesClearanceAuthorityMatrixList[i].EmployeName</td>


                            <td data-label="Actions">
                                <a id="objAdd" data-bs-toggle="tooltip" title="Add "
                                   class="btn btn-icon btn-edit icon-only slider-btn addObj" onclick="onClick('@Model.DuesClearanceAuthorityMatrixList[i].LevelCode')">
                                    <i class="fa fa-plus"
                                       aria-hidden="true"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }


            }

        </tbody>
    </table>
</div>