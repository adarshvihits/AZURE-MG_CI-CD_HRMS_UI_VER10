@model Hrms.Lite.Shared.Master.DuesClearanceAuthorityMatrix



<div class="row">


    <div class="col-md-9 d-flex align-items-center">
  
            <div class="form-group">
                <label> @Model.LevelName</label>
            </div>
    
    </div>





    <div class="col-md-3 d-flex justify-content-end">

        <div class="tab-items select-option">

            <div class="sraech-slider">
                <div class="search-slider-inner">
                    <i class="fa fa-search" onclick="onSearchClick()"></i>
                </div>
                <input type="text" id="dataTableSearch"  class="form-control form-control-sm"  placeholder="ID/Name"     >
                      
                      
                        <!-- ✅ CHANGE #1 -->
             
                @*<input type="text" id="dataTableSearch" class="form-control form-control-sm"
                       placeholder="ID/Name">*@
            </div>


            <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter" onclick="$('.basicFilter').addClass('slider-forms-open');$('#filterSlider').removeClass('hide')">
                <i class="fas fa-filter"></i>
                <i class="fas fa-check"></i>
            </div>

            
        </div>



       
    </div>
</div>
<div id="empList">
    @await Html.PartialAsync("~/Areas/Master/Views/DuesClearanceAuthorityMatrix/_PopUpList.cshtml", Model)
</div>
    <div class="row ">
        <div class="col-md-12 ">
            <button id="saveShift" type="button" class="btn btn-default float-right mobile-full-width" onclick="onSaveClick()">
                Save
            </button>
        </div>
    </div>
    <div id="filterSlider" class="hide">
        @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.SliderFilter)
    </div>
