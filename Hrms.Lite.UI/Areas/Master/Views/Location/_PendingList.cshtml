@model Hrms.Lite.Shared.Master.Location
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");

        //$('#PendingLocationTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');


    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table location-pending pt-1">
    @Html.HiddenFor(m => m.LocationList.Count)
    <table id="PendingLocationTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Region</th>
                <th scope="col">FunctionalState</th>
                <th scope="col">Zone</th>
                <th scope="col">Cluster</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{


                if (Model.LocationList != null && Model.LocationList.Count > 0)
                {
                    for (int i = 0; i < Model.LocationList.Count; i++)

                    {
                            @Html.HiddenFor(m => m.LocationList[i].MakerChecker)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Code)
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.ApproveMode)
                        <tr>
                        

                            <td data-label="Name">@Model.LocationList[i].Name</td>
                            <td data-label="ShortName">@Model.LocationList[i].ShortName</td>
                            <td data-label="Region">@Model.LocationList[i].Region.Name</td>
                            <td data-label="FunctionalState">@Model.LocationList[i].FunctionalState.Name</td>
                            <td data-label="Zone">@Model.LocationList[i].Zone.Name</td>
                            <td data-label="Cluster">@Model.LocationList[i].Cluster.Name</td>

                            <td data-label="Entry Type">@Model.LocationList[i].Mode</td>
                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="" id="addLocationMasterApprove"
                                       class="btn btn-icon btn-tick icon-only " data-bs-original-title="Approve" onclick="onApproveClick('@Model.LocationList[i].GI', '@Model.LocationList[i].LogGI','APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="" id="addLocationMasterApprove"
                                       class="btn btn-icon btn-tick icon-only " data-bs-original-title="Approve" onclick="onApproveClick('@Model.LocationList[i].GI', '@Model.LocationList[i].LogGI', 'APPROVAL',@i);
                                        swal.fire(MasterPersmissionMsg)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }

                            </td>
                        </tr>
                                }
                }

            }
        </tbody>
    </table>
</div>