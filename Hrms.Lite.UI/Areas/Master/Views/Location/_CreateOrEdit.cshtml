@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}

<script>
    $(document).ready(function () {
        moveCursorToEnd('Name');

        $('.kt_datepicker_2').datepicker({
            format: 'dd-M-yyyy',
            autoclose: true,
            todayHighlight: true,
            clearBtn: true
        });
    });
</script>
<style>

    .location-slidernew {
           width: 1030px !important;
    }

    /* ---------------- Section Card ---------------- */

.section-card {
    background: #fff;
    border: 1px solid #E6ECF3;
    border-radius: 12px;
    padding: 18px;
    margin-bottom: 20px;
    box-shadow: 0 2px 6px rgba(0,0,0,.04);
}

.section-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 600;
    color: #344054;
    padding-bottom: 12px;
    margin-bottom: 18px;
    border-bottom: 1px solid #EEF2F7;
}

.section-title i {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #F3F6FB;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
}

/* ---------------- Input Box ---------------- */

.field-box {
    border: 1px solid #E8EDF5;
    border-radius: 10px;
    padding: 10px;
    background: #FCFDFE;
    transition: .2s;
    min-height: 90px;
}

.field-box:hover {
    border-color: #5B8DEF;
}

.field-box label {
    font-size: 12px;
    font-weight: 600;
    color: #667085;
    margin-bottom: 8px;
    display: block;
}

.field-box label i {
    margin-right: 6px;
    color: #5B8DEF;
}

/* ---------------- Form Control ---------------- */

.field-box .form-control,
.field-box select {
    border: 1px solid #D9E2EC;
    border-radius: 8px;
    background: #fff;
    height: 36px;
}

.field-box .form-control:focus,
.field-box select:focus {
    border-color: #4F7EF7;
    box-shadow: 0 0 0 0.15rem rgba(79,126,247,.15);
}

/* ---------------- Checkbox ---------------- */

.checkbox-box {
    min-height: 110px;
}

.checkbox-box .custom-control {
    padding-top: 6px;
}

/* ---------------- Active Switch ---------------- */

.active-box {
    min-height: 90px;
}

/* ---------------- Description ---------------- */

.description-box {
    border-radius: 10px;
    border: 1px solid #D9E2EC;
    min-height: 100px;
}

/* ---------------- Validation ---------------- */

.text-danger,
.Mandatory {
    color: #E11D48 !important;
}

/* ---------------- Spacing ---------------- */

.form-group {
    margin-bottom: 0;
}

.row > div {
    margin-bottom: 15px;
}
</style>

