@model Hrms.Lite.Shared.Master.Location
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}

<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>

<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");

        //$('#LocationTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');


    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table location-list pt-1 ">
    @Html.HiddenFor(m => m.LocationList.Count)
    <table id="LocationTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Region</th>
                <th scope="col">Functional State</th>
                <th scope="col">Zone</th>
                <th scope="col">Cluster</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.LocationList != null && Model.LocationList.Count > 0)
                {
                    for (int i = 0; i < Model.LocationList.Count; i++)

                    {


                          @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(m => m.LocationList[i].EditActive)
                            @Html.HiddenFor(model => Model.GI)
                        <tr>

                          
                            <td data-label="Name">@Model.LocationList[i].Name</td>
                            <td data-label="ShortName">@Model.LocationList[i].ShortName</td>
                            <td data-label="Region">@Model.LocationList[i].Region.Name</td>
                            <td data-label="FunctionalState">@Model.LocationList[i].FunctionalState.Name</td>
                            <td data-label="Zone">@Model.LocationList[i].Zone.Name</td>
                            <td data-label="Cluster">@Model.LocationList[i].Cluster.Name</td>
                            <td data-label="Actions">
                                <div>
                                    @if (CurrentUserRoleActions.Modify == true)
                                    {

                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="editLocation"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY', '@Model.LocationList[i].GI', '@Model.LocationList[i].LogGI',@i)">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    else
                                    {

                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="editLocation"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY', '@Model.LocationList[i].GI', '@Model.LocationList[i].LogGI',@i);
                                            swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#AddNewOrEditSlider');});">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    @if (CurrentUserRoleActions.Delete == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deleteLocation"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.LocationList[i].GI','@Model.LocationList[i].LogGI','DELETE',@i)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deleteLocation"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.LocationList[i].GI', '@Model.LocationList[i].LogGI', 'DELETE',@i);
                                           swal.fire(MasterPersmissionMsg)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>

                    }
                }


            }
        </tbody>
    </table>
</div>