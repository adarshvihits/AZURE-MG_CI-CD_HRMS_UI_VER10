@model Hrms.Lite.Shared.Master.BonusGroup
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Bonus-Group-list pt-1">
    @Html.HiddenFor(m => m.BonusGroupList.Count)
    <table id="BonusGrpTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>


            @{
                if (Model.BonusGroupList != null && Model.BonusGroupList.Count > 0)
                {
                    for (int i = 0; i < Model.BonusGroupList.Count; i++)

                    {


                        <tr>

                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(m => m.BonusGroupList[i].EditActive)
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Name">@Model.BonusGroupList[i].Name</td>
                            <td data-label="Name">@Model.BonusGroupList[i].ShortName</td>
                            <td data-label="Actions">
                                <div>
                                    @if (CurrentUserRoleActions.Modify == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="bonusGrpEdit"
                                           class="btn btn-icon btn-edit icon-only" onclick="AddNewOrEditClick('MODIFY', '@Model.BonusGroupList[i].GI',@i)">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="bonusGrpEdit"
                                           class="btn btn-icon btn-edit icon-only" onclick="AddNewOrEditClick('MODIFY', '@Model.BonusGroupList[i].GI',@i);
                                                swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#AddNewOrEditSlider');});">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    @if (CurrentUserRoleActions.Delete == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deleteBonusGrp"
                                           class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.BonusGroupList[i].GI',@i)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deleteBonusGrp"
                                           class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.BonusGroupList[i].GI',@i);
                                           swal.fire(MasterPersmissionMsg)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            }


        </tbody>
    </table>
</div>