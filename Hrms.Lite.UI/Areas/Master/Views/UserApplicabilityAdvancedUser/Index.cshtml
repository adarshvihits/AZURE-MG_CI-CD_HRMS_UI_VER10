@model Hrms.Lite.Shared.Master.UserApplicabilityAdvancedUser
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/Master/UserApplicabilityAdvancedUser.js"></script>



<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Advanced User Control
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                         Advanced User Control
                    </li>

                </ul>
            </div>
        </div>


    </div>

</div>
@using (Html.BeginForm("Save", "UserApplicabilityAdvancedUser", FormMethod.Post, new { id = "UserApplicabilityAdvancedUserform" }))
{
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">

        <div class="d-flex flex-column-fluid">

            <div class="container full-width">

                <div class="row height-100per">

                    <div class="col-md-12">
                        <div class="card card-custom height-100per">

                            <div class="card-body ">



                                <div class="row tab-style-button">
                                    <div class="tab-button-wrap">

                                        <div class="tab-items">
                                            <label></label>
                                            <div class="form-group filter-combobox mt-0" style="width:200px;">
                                                @Html.DropDownListFor(m => m.GroupingCode, (SelectList)ViewBag.ClassificationType, "--Select--", new { @class = "form-control form-control-sm processMnth", @onchange = "onClassificationTypeChange(this,'classificationtype');validate(this,'classificationtype')" })
                                                <span id="classificationtype"></span>
                                            </div>
                                        </div>
                                        <div class="tab-items">
                                            <label></label>
                                            <div class="form-group filter-combobox mt-0" style="width:200px;">
                                                @Html.DropDownListFor(m => m.ClassificationCode, (SelectList)ViewBag.Classification, "--Select--", new { @class = "form-control form-control-sm Classification", @onchange = "fillData()" })
                                                <span id="classification"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-2  align-items-center d-flex justify-content-center">
                                            <a href="#" type="button"
                                               class="btn btn-default float-right mobile-full-width mt-5" onclick="BatchUpdateClick()">
                                                Batch Update
                                            </a>
                                        </div>
                                        <div class="tab-items select-option pt-5">






                                            <div class="tab-items select-option">
                                                <div class="sraech-slider">
                                                    <div class="search-slider-inner">
                                                        <i class="fa fa-search" onclick="$('#searchList').focus();"></i>
                                                    </div>
                                                    <input id="searchList" type="text" class="form-control form-control-sm"
                                                           placeholder="Search Here" onkeyup="searchRows()">
                                                </div>


                                            </div>


                                        </div>
                                    </div>
                                    @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "SaveService" }))
                                    {
                                        <div id="UserApplicabilityAdvancedUser">
                                            @await Html.PartialAsync("_List")

                                        </div>
                                        <div class="row card-footer-bottom-fixed">
                                            <div class="col-md-12 align-right" id="save" style="display:none;">
                                                <button type="button"
                                                        class="btn btn-default float-right mobile-full-width" onclick="SaveBatchClick()">
                                                    Save
                                                </button>

                                            </div>
                                            </div>
                                     }




                                        </div>

                                    </div>
                        </div>
                    </div>




                    <!--end::Row-->
                    <!--begin::Row-->
                    <!--end::Row-->
                    <!--end::Dashboard-->
                </div>
                <!--end::Container-->
            </div>
            <!--end::Entry-->
        </div>
    </div>
}
