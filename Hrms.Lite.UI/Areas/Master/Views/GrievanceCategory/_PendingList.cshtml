





@model Hrms.Lite.Shared.Master.GrievanceCategory
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
      
        $('.pendingTabCount').html("@Model.PendingCount");



        //$('#PendingDeductionTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');

        });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Grievance-Category-Pending">
    @Html.HiddenFor(m => m.GrievanceCategoryList.Count)
    <table class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Short Name</th>              
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>

            @{


                if (Model.GrievanceCategoryList != null && Model.GrievanceCategoryList.Count > 0)
                {
                    for (int i = 0; i < Model.GrievanceCategoryList.Count; i++)

                    {

                        <tr>
                            @Html.HiddenFor(m => m.GrievanceCategoryList[i].MakerChecker)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)

                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.ApproveMode)

                            <td data-label="Name">@Model.GrievanceCategoryList[i].Name</td>
                            <td data-label="Short Name">@Model.GrievanceCategoryList[i].ShortName</td>
                          
                            <td data-label="Entry Type">@Model.GrievanceCategoryList[i].Mode</td>

                            <td data-label="Approve">

                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="Categoryapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.GrievanceCategoryList[i].GI', '@Model.GrievanceCategoryList[i].LogGI','APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="Categoryapprove"
                                       class="btn btn-icon btn-tick icon-only slider-btn" onclick="onApproveClick('@Model.GrievanceCategoryList[i].GI', '@Model.GrievanceCategoryList[i].LogGI', 'APPROVAL',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                            </td>

                        </tr>
                    }
                }

            }

        </tbody>
    </table>
</div>