@model Hrms.Lite.Shared.Master.CompanyGeneralSettings






<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Company-GeneralSettings-list vertical-scroll-700" >
    <table>
        <thead>
            <tr class="table-dark">
                <th scope="col">Sl.No.</th>
                <th scope="col">Settings</th>
                <th scope="col">Action</th>
                <th></th>

            </tr>
        </thead>

        <tbody>
            <tr>
                <td>1.</td>
                <td>Notice Period</td>
                <td>
                    @Html.TextBoxFor(m => m.NoticePeriod, new { @onkeypress = "return onlyNumberKey(event)", @maxlength = "3", @class = "form-control", @style = "width: 45%;" })

                    <span id="NoticePeriod"></span>
                </td>
                <td></td>
            </tr>
            <tr>
                <td>2.</td>
                <td>Need Excel Password</td>
                <td>

                    @Html.DropDownListFor(model => model.NeedExcelPassword,
            new List<SelectListItem>
            {
                 new SelectListItem {  Value= "true" , Text = "YES" },
                 new SelectListItem { Value = "false" , Text = "NO" },

            }, "--Select--",
            new { @class = "form-control form-control-sm", @onchange = "validate(this,'genSettings')", @style = "width: 45%; }" })
                    <span id="NeedExcelPassword"></span>
                </td>
                <td></td>
            </tr>
            <tr>
                <td>3.</td>
                <td>PunchingID Same as EmployeeID</td>
                <td>
                    @Html.DropDownListFor(model => model.PunchingIDSameasComID,
            new List<SelectListItem> {
                 new SelectListItem {  Value= "1" , Text = "YES" },
                 new SelectListItem { Value = "0" , Text = "NO" },

              }, "--Select--",
            new { @class = "form-control form-control-sm", @style = "width: 45%;", @onchange = "validate(this,'genSettings')" })
                    <span id="PunchingIDSameasComID"></span>
                </td>

                <td></td>
            </tr>
            <tr>
                <td>4.</td>
                <td> Password Expiry Days</td>
                <td>
                    @Html.TextBoxFor(m => m.PasswordExpiry, new { @onkeypress = "return onlyNumberKey(event)", @maxlength = "3", @class = "form-control", @style = "width: 45%;" })
                    <span id="PasswordExpiry"></span>
                </td>
                <td></td>
            </tr>

            <tr>
                <td>5.</td>
                <td> Social Wall Expiry Period</td>
                <td>
                    @Html.TextBoxFor(m => m.SocialWallExpiry, new { @onkeypress = "return onlyNumberKey(event)", @maxlength = "3", @class = "form-control", @style = "width: 45%;" })
                    <span id="SocialWallExpiry"></span>
                </td>
                <td></td>
            </tr>


            <tr>
                <td>6.</td>
                <td>Show Celebrities In Social Wall</td>
                <td>



                    <label></label>
                    @Html.DropDownListFor(model => model.ShowCelebritiesinsocial,
            new List<SelectListItem> {
                 new SelectListItem {  Value= "1" , Text = "YES" },
                 new SelectListItem { Value = "0" , Text = "NO" },

              }, "--Select--",
            new { @class = "form-control form-control-sm", @style = "width: 45%;", @onchange = "validate(this,'ShowCelebinsocial');showdropdown()" })
                    <span id="ShowCelebinsocial"></span>

                </td>

                <td>

                    @if (Model.ShowCelebritiesinsocial == 1)
                    {

                        <div id="drop2">
                            <label>Show Photos In Social Wall</label>

                            @Html.DropDownListFor(model => model.ShowPhotoinsocial,
                    new List<SelectListItem> {
                         new SelectListItem {  Value= "1" , Text = "YES" },
                         new SelectListItem { Value = "0" , Text = "NO" },

                      }, "--Select--",
                    new { @class = "form-control form-control-sm", @onchange = "validate(this,'genSettings')" })
                            <span id="ShowPhotoinsocial"></span>
                            @*</div>*@
                        </div>
                    }
                    else
                    {
                        <div id="drop2" class="hide">
                            <label>Show Photos In Social Wall</label>

                            @Html.DropDownListFor(model => model.ShowPhotoinsocial,
                    new List<SelectListItem> {
                         new SelectListItem {  Value= "1" , Text = "YES" },
                         new SelectListItem { Value = "0" , Text = "NO" },

                      }, "--Select--",
                    new { @class = "form-control form-control-sm", @onchange = "validate(this,'ShowPicinsocial')" })
                            <span id="ShowPicinsocial"></span>
                            @*</div>*@
                        </div>
                    }


                </td>






            </tr>

            <tr>
                <td>7.</td>
                <td>Regularization Maximum Limit</td>
                <td>
                    @Html.TextBoxFor(m => m.RegularizationMaximumLimit, new { @onkeypress = "return onlyNumberKey(event)", @maxlength = "3", @class = "form-control", @style = "width: 45%;" })
                    <span id="RegularizationLimit"></span>
                </td>

                <td></td>
            </tr>

            <tr>
                <td>8.</td>
                <td>Regularization Apply Within Days</td>
                <td>
                    @Html.TextBoxFor(m => m.RegularizationApplyWithinDays, new { @onkeypress = "return onlyNumberKey(event)", @maxlength = "3", @class = "form-control", @style = "width: 45%;" })
                    <span id="RegularizationDays"></span>
                </td>

                <td></td>
            </tr>
            <tr>
                <td>9.</td>
                <td>Loan Workflow Enable Or Disable</td>
                <td>
                    @Html.DropDownListFor(model => model.LoanWFEnableOrDisable,
            new List<SelectListItem> {
                 new SelectListItem {  Value= "1" , Text = "Enabled" },
                 new SelectListItem { Value = "0" , Text = "Disabled" },

              }, "--Select--",
            new { @class = "form-control form-control-sm", @style = "width: 45%;", @onchange = "validate(this,'loanwf')" })
                    <span id="loanwf"></span>
                </td>

                <td></td>
            </tr>
        </tbody>


    </table>
</div>