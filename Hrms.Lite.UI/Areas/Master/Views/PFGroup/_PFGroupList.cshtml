
@model Hrms.Lite.Shared.Master.PFGroup
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>

<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");
    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table pfgroup-master-list pt-1 ">
    @Html.HiddenFor(m => m.PFGroupList.Count)
    <table id="PFGroupTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.PFGroupList != null && Model.PFGroupList.Count > 0)
                {
                    for (int i = 0; i < Model.PFGroupList.Count; i++)

                    {

                        <tr>
                            @Html.HiddenFor(m => m.PFGroupList[i].EditActive)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Name">@Model.PFGroupList[i].Name</td>
                            <td data-label="Short Name">@Model.PFGroupList[i].ShortName</td>
                            <td data-label="Actions">
                                @if (CurrentUserRoleActions.Modify == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="editpfgroup"
                                       class="btn btn-icon btn-edit icon-only slider-btn" onclick="onAddNewOrEditClick('MODIFY', '@Model.PFGroupList[i].GI', '@Model.PFGroupList[i].LogGI',@i)">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="editpfgroup"
                                       class="btn btn-icon btn-edit icon-only slider-btn" onclick="onAddNewOrEditClick('MODIFY', '@Model.PFGroupList[i].GI', '@Model.PFGroupList[i].LogGI',@i);
                                       swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#AddNewOrEditSlider');});">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>
                                }
                                <!-- Edit Slider start-->
                                <!-- Edit Slider  end-->
                                <!-- delete Slider  start-->

                                @if (CurrentUserRoleActions.Delete == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="deletepfgroup"
                                       class="btn btn-icon  icon-only mobile-full-width slider-btn btn-delete" onclick="onDeleteClick('@Model.PFGroupList[i].GI', '@Model.PFGroupList[i].LogGI','DELETE',@i)">
                                        <i class="icon-xl far fa-trash-alt"></i>
                                    </a>
                                }
                                else
                                { 
                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="deletepfgroup"
                                       class="btn btn-icon  icon-only mobile-full-width slider-btn btn-delete" onclick="onDeleteClick('@Model.PFGroupList[i].GI', '@Model.PFGroupList[i].LogGI', 'DELETE',@i);
                                       swal.fire(MasterPersmissionMsg)">
                                        <i class="icon-xl far fa-trash-alt"></i>
                                    </a>
                                }

                                    <!-- <end delete section></end> -->
                                </td>
                        </tr>
                    }
                }

            }
        </tbody>
    </table>
</div>