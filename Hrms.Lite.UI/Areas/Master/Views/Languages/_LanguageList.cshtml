@model Hrms.Lite.Shared.DataBank.Generic.Master.Languages
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");

        //$('#LanguageTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');


    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table languages-master-list pt-1">
    <table id="LanguageTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">
                    Name
                    @Html.HiddenFor(m => Model.LanguageList.Count)
                </th>
                <th scope="col">Short Name</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>

            @{
                if (Model.LanguageList != null && Model.LanguageList.Count > 0)
                {

                    for (int i = 0; i < Model.LanguageList.Count; i++)
                    {
                        <tr>
                            @Html.HiddenFor(m => m.LanguageList[i].EditActive)
                            @Html.HiddenFor(model => Model.LogGI)

                            @Html.HiddenFor(model => Model.Active)
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Name">@Model.LanguageList[i].Name</td>
                            <td data-label="ShortName">@Model.LanguageList[i].ShortName</td>
                            <td data-label="Actions">
                                <div>

                                    @if (CurrentUserRoleActions.Modify == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="editlanguages"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY', '@Model.LanguageList[i].GI', '@Model.LanguageList[i].LogGI',@i)">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="editlanguages"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY', '@Model.LanguageList[i].GI', '@Model.LanguageList[i].LogGI',@i);
                                           swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#AddNewOrEditSlider');});">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    @if (CurrentUserRoleActions.Delete == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deletelanguages"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.LanguageList[i].GI', '@Model.LanguageList[i].LogGI','DELETE',@i)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                    else
                                    { 
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="deletelanguages"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.LanguageList[i].GI', '@Model.LanguageList[i].LogGI', 'DELETE',@i);
                                           swal.fire(MasterPersmissionMsg)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                    </div>
                                <!-- <end delete section></end> -->
                            </td>
                        </tr>

                    }
                }

            }
        </tbody>
    </table>
</div>