@model Hrms.Lite.Shared.Master.ProductCompany
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/settings.js"></script>


<script>
    $(document).ready(function () {
        debugger;
      
        $('.Pendingtab').html("@Model.PendingCount");
    });
</script>



<div class="ihits-table table-border hover-color odd-even mobile-responsive-table product-master-pending pt-1">
    @Html.HiddenFor(m => m.ProductCompanyList.Count)
    <table id="ProductPendingTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">product Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>
            @{


                if (Model.ProductCompanyList != null && Model.ProductCompanyList.Count > 0)
                {
                    for (int i = 0; i < Model.ProductCompanyList.Count; i++)

                    {


                        <tr>
                            @Html.HiddenFor(m => m.ProductCompanyList[i].MakerChecker)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Code)
                            @Html.HiddenFor(model => Model.Mode)
                            <td data-label="product Name">@Model.ProductCompanyList[i].Name</td>
                            <td data-label="Short Name">@Model.ProductCompanyList[i].ShortName</td>

                            <td data-label="Status">@Model.ProductCompanyList[i].Mode</td>
                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="approvecompany"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.ProductCompanyList[i].GI', '@Model.ProductCompanyList[i].LogGI', 'APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                { 
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="approvecompany"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.ProductCompanyList[i].GI', '@Model.ProductCompanyList[i].LogGI', 'APPROVAL',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }

                                </td>

                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>