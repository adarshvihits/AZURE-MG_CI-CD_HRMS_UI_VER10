@model Hrms.Lite.Shared.Admin.SoftwareSettings
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    textarea.form-control {
        height: 424px;
        PADDING: 8PX;
    }
</style>
<script src="~/scripts/Admin/SoftwareSettings.js"></script>

  <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->
            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">
                        Software Settings
                    </h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            Software Settings

                        </li>

                    </ul>
                </div>
            </div>
            <!--end::Header Menu Wrapper-->
            <!--begin::Topbar-->
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>

    <!--begin::Wrapper-->
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Header-->
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body">
                        <!--begin: Search Form-->


                        <div class="page_white">


                            @using (Html.BeginForm("", "", FormMethod.Post, new { @id = "QueryUpload", @class = "display-flex" }))
                            {

                                <div class="row">
                                    <div class="col-md-6">
                                        <label class="view-title">Enter Query</label>
                                        @Html.TextAreaFor(m => m.QueryMessage, new { @class = "form-control form-control-sm Query", @placeholder = "Enter Query", @onblur = "validate(this,'qrymsg')" })
                                        <span id="qrymsg" class="Mandatory hide">Please Upload SVG Logo</span>
                                        <div class="form-group pt-3">
                                            <input type="button" class="btn btn-default  mobile-full-width" value="Execute" onclick="SoftwareSettingsQuerySave()" />
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="view-title">Result</label>
                                        @Html.TextAreaFor(m => m.QueryResult, new { @class = "form-control form-control-sm  Query", @placeholder = "Query Result" })

                                        <span class="Mandatory hide">Please Upload JPG Logo</span>

                                    </div>
                                </div>

                            }
                            <br />

                            @*<span>@Html.Raw(ViewBag.Message)</span>*@







                        </div>




                        <!--end: Datatable-->
                    </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>


    </div>
    <!--end::Wrapper-->
}
  
