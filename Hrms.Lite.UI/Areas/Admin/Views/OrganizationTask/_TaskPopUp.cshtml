@model Hrms.Lite.Shared.Admin.OrganizationTask

<script src="~/js/tooltip.js"></script>


<div class="ihits-table table-border hover-color odd-even mobile-responsive-table pt-1 ">

    @Html.HiddenFor(m => m.TaskCode)
    @Html.HiddenFor(m => m.Task)
  

    <div class="row">
        <div class="col-md-12">
            <div class="row-outer">
                <label class="view-title">Task Description</label>
                <div class="view-details">
                    @Html.DisplayFor(model => Model.Task)

                </div>
            </div>
        </div>

       
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="row-outer">
                <label class="view-title">Assigned To</label>
                <div class="view-details">
                    @Html.DisplayFor(model => Model.Employee.Name)
                </div>
            </div>
        </div>


        <div class="col-md-6">
            <div class="row-outer">
                <label class="view-title">Assigned Date</label>
                <div class="view-details">
                    @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.Assigneddate))
                </div>
            </div>
        </div>

      

    </div>


    <div class="row">
        <div class="col-md-6">
            <div class="row-outer">
                <label class="view-title">EDC</label>
                <div class="view-details">
                    @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.EDC))
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="row-outer">
                <label class="view-title">Supervisor</label>
                <div class="view-details">
                    @Html.DisplayFor(model => Model.EmployeeSupervisor.Name)

                </div>
            </div>
        </div>

        


    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="row-outer">
                <label class="view-title">Status</label>
                <div class="view-details">

                    @Html.DropDownListFor(model => model.StatusCode,
            new List<SelectListItem> {

                     new SelectListItem { Text = "Accept", Value = "1" },
                      new SelectListItem { Text = "In Progress", Value = "2" },
                      new SelectListItem { Text = "Completed", Value = "3" },
                      new SelectListItem { Text = "Rejected", Value = "4" },

            }, "--Select--",
            new { @class = "form-control form-control-sm", @style = "width: 70%;" })
                    <span id="Status"></span>
                </div>
            </div>
        </div>
    </div>
</div>

    <div class="col-md-12 align-right pt-2">

        <a id=""
           class="btn btn-default  mobile-full-width " onclick="statusUpdate('@Model.TaskCode')">
            Save
        </a>

    </div>

