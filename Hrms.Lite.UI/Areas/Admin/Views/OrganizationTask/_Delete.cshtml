@model Hrms.Lite.Shared.Admin.OrganizationTask

<script src="~/js/tooltip.js"></script>
<script src="~/scripts/Admin/organizationTask.js"></script>

@using (Html.BeginForm("Delete", "organization", FormMethod.Post, new { @id = "OrganizationDelete" }))
{
    @Html.HiddenFor(m => m.Mode)
    @Html.HiddenFor(m => m.TaskCode)
    <div id="deletedesignation" class="slider-forms slider-forms-open DeleteDiv">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('DeleteDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>Organization Task</h4>
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Task</label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.Task)

                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Assigned Date
                            </label>
                            <div class="view-details">
                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Assigneddate))
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Assingned To
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.Employee.Name)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                EDC
                            </label>
                            <div class="view-details">
                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.EDC))
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                SuperVisor User
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.EmployeeSupervisor.Name)
                            </div>
                        </div>
                    </div>
                
                </div>




                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12 align-right">


                        <a type="button" data-bs-toggle="tooltip" title="" data-bs-original-title="Delete"
                           class="btn btn-icon btn-delete big-btn float-none" onclick="OnOrganizationDeleteClick('@Model.TaskCode')">
                            <i class="icon-xl far fa-trash-alt"></i>
                        </a>

                    </div>
                </div>
            </div>
        </div>
    </div>
}