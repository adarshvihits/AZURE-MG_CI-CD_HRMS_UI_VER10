@model Hrms.Lite.Shared.Admin.RenewalsCategory

<script src="~/js/tooltip.js"></script>

@using (Html.BeginForm("Delete", "RenewalsCategory", FormMethod.Post, new { @id = "deleteRenewalsCategory" }))
{
    @Html.HiddenFor(model => Model.Mode)
    @Html.HiddenFor(model => Model.RenewalsCategoryCode)

    <div id="deleteRenewalsCategory" class="slider-forms slider-forms-open deleteRenewalsCategory">
        <div class="slider-inner-style  new-inner-style">
            <div class="slider-form-close">
                <i class="ki ki-close icon-xs text-muted" onclick="CloseSlider('deleteRenewalsCategory')"></i>
            </div>
            <div class="location-slider">
                <h4>
                    Renewals Category
                </h4>
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Name</label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.Name)

                                @Html.HiddenFor(model => Model.GI)


                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Short
                                Name
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.ShortName)
                            </div>
                        </div>
                    </div>

                </div>
                <div class="row my-3">
                    <div class="col-md-12">
                        <div class="row-outer">
                            <label class="view-title">Active</label>
                            <div class="view-details">

                                @if (Model.Active == true)
                                {

                                    <button type="button" class="btn btn-icon btn-tick">
                                        <i class="icon-xl fas fa-check"></i>
                                    </button>

                                }
                                else
                                {
                                    <button type="button" class="btn btn-icon btn-close">
                                        <i class="icon-xl fas fa-times"></i>

                                    </button>
                                }


                            </div>
                        </div>

                    </div>

                </div>
                <div class="row my-3">

                    <div class="col-md-12">
                        <label class="view-title">Description</label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.Description)
                        </div>
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">


                        <a type="button"
                           data-bs-toggle="tooltip" title="Delete"
                           data-bs-original-title="Delete"
                           class="btn btn-icon btn-delete big-btn float-none" onclick="confirmDelete('@Model.RenewalsCategoryCode')">
                            <i class="icon-xl far fa-trash-alt"></i>
                        </a>

                    </div>


                </div>
            </div>

        </div>
    </div>
}
