<script>

    function previewImages(event) {
        const files = event.target.files;
        const imagePreviewContainer = document.getElementById('imagePreviewContainer');

        // Clear the current preview images
        imagePreviewContainer.innerHTML = '';
        debugger;
        // Loop through all selected files
        for (let i = 0; i < files.length; i++) {
            const file = files[i];

            if (!file.type.startsWith('image/')) {
                continue; // Skip non-image files
            }

            const reader = new FileReader();

            reader.onload = function (e) {
                // Create a div to hold the image and the remove button
                const imageContainer = document.createElement('div');
                imageContainer.style.position = 'relative';
                imageContainer.style.width = '150px';
                imageContainer.style.height = '150px';

                // Create the image element
                const img = document.createElement('img');
                img.src = e.target.result;
                img.style.width = '100%';
                img.style.height = '100%';
                img.style.objectFit = 'cover';

                // Create the remove button
                const removeButton = document.createElement('button');
                removeButton.innerText = 'X';
                removeButton.style.position = 'absolute';
                removeButton.style.top = '2px';
                removeButton.style.right = '2px';
                removeButton.style.background = 'black';
                removeButton.style.color = 'white';
                removeButton.style.border = 'none';
                removeButton.style.padding = '2px';
                removeButton.style.cursor = 'pointer';

                removeButton.onclick = function () {
                    // Remove the image from the preview container
                    imageContainer.remove();

                    // Remove the file from the input (remove it from the FileList)
                    removeImageFromInput(i);
                };

                // Append the image and the remove button to the image container
                imageContainer.appendChild(img);
                imageContainer.appendChild(removeButton);

                // Append the image container to the preview container
                imagePreviewContainer.appendChild(imageContainer);
            };

            reader.readAsDataURL(file);
        }
    }

    function removeImageFromInput(index) {
        const imageInput = document.getElementById('fileInput');
        const dataTransfer = new DataTransfer();

        // Re-add all files except the one at the removed index
        for (let i = 0; i < imageInput.files.length; i++) {
            if (i !== index) {
                dataTransfer.items.add(imageInput.files[i]);
            }
        }

        // Update the file input with the new FileList
        imageInput.files = dataTransfer.files;
    }

    //function updateFileNames() {
    //    var fileInput = document.getElementById('fileInput');

    //    // Get the selected file names
    //    var fileNames = Array.from(fileInput.files).map(file => file.name).join(', ');

    //    // Update the textbox value with selected file names
    //    document.getElementsByName('FileNames')[0].value = fileNames;
    //    previewImages();
    //}

</script>
