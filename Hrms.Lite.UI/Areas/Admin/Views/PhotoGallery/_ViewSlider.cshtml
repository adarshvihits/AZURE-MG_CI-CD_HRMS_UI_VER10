    function removeImageFromInput(index) {
        const imageInput = document.getElementById('fileInput');
        const dataTransfer = new DataTransfer();

        // Re-add all files except the one at the removed index
        for (let i = 0; i < imageInput.files.length; i++) {
            if (i !== index) {
                dataTransfer.items.add(imageInput.files[i]);
            }
        }

        // Update the file input with the new FileList
        imageInput.files = dataTransfer.files;
    }
    function CloseSlider(id) {
        $("." + id).removeClass('slider-forms-open');
        $(".slider-forms").removeClass('slider_width');
        $(".form-overlay").remove();
    }

</script>

<script>
    function previewImages(event) {
        const files = event.target.files;
        const imagePreviewContainer = document.getElementById('imagePreviewContainer');

        // Clear the current preview images
        imagePreviewContainer.innerHTML = '';

        // Loop through all selected files
        for (let i = 0; i < files.length; i++) {
            const file = files[i];

            if (!file.type.startsWith('image/')) {
                continue; // Skip non-image files
            }

            const reader = new FileReader();

            reader.onload = function (e) {
                // Create a container for the image, description input, and remove button
                const imageContainer = document.createElement('div');
                imageContainer.classList.add('image-container');

                // Create the image element
                const img = document.createElement('img');
                img.src = e.target.result;

                // Create the description textarea
                const descriptionInput = document.createElement('textarea');
                descriptionInput.name = 'Descriptions';
                descriptionInput.placeholder = 'Enter description';
                descriptionInput.rows = 3;
                descriptionInput.classList.add('description-input');

                // Create the remove button
                const removeBtn = document.createElement('button');
                removeBtn.classList.add('remove-btn');
                removeBtn.innerText = 'X';
                removeBtn.onclick = function () {
                    imagePreviewContainer.removeChild(imageContainer);
                };

                // Append the image, description input, and remove button to the image container
                imageContainer.appendChild(img);
                imageContainer.appendChild(descriptionInput);
                imageContainer.appendChild(removeBtn);

                // Append the image container to the preview container
                imagePreviewContainer.appendChild(imageContainer);
            };

            reader.readAsDataURL(file);
        }
    }
</script>
@using (Html.BeginForm("Upload", "PhotoGallery", FormMethod.Post, new { id = "PhotoGallerysave", enctype = "multipart/form-data" }))
