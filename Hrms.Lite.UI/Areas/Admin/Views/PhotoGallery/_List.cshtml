@model Hrms.Lite.Shared.Admin.PhotoGallery

<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>


<div class="ihits-table table-border hover-color odd-even mobile-responsive-table photo_gallery_list">

    <table id="SocialWallTable" class="common-table">
        <thead>
            <tr class="table-dark">

                <th scope="col">Category</th>
                <th scope="col">Count</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>

            @{
                if (Model.GalleryList != null && Model.GalleryList.Count > 0)
                {
                    for (int i = 0; i < Model.GalleryList.Count; i++)

                    {
                        <tr>

                            <td data-label="Category"> @Model.GalleryList[i].Description</td>
                            <td data-label="Count"> @Model.GalleryList[i].PhotoCount</td>
                            <td data-label="Actions">
                                <div class="d-flex justify-content-center">
                                    <a data-bs-toggle="tooltip" title="" class="view_btn " data-bs-original-title="View" onclick="GetDetails('@Model.GalleryList[i].PhotoGalleryGI')"> </a>
                                    <a data-bs-toggle="tooltip" title="" class="btn btn-icon btn-edit icon-only  " data-bs-original-title="Edit" onclick="Edit('@Model.GalleryList[i].PhotoGalleryGI')">   
                                    <i class="icon-xl fas fa-pencil-alt"></i></a>
                                    <a data-bs-toggle="tooltip" title="Delete" class="btn btn-icon  icon-only mobile-full-width  float-right btn-delete" onclick="Delete('@Model.GalleryList[i].PhotoGalleryGI')">
                                        <i class="icon-xl far fa-trash-alt"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }

            }


        </tbody>
    </table>
</div>