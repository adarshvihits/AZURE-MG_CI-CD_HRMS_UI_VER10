@model Hrms.Lite.Shared.Admin.DocumentsFolder
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/Admin/documentsFolder.js"></script>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Documents Folder</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item">
                        <a href="dashboard.html"><i class="icon-nm fas fa-home"></i></a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Documents Folder
                    </li>
                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body ">

                            <div class="row tab-style-button">
                                <div class="tab-button-wrap">
                                    <div class="tab-items d-flex align-items-center">
                                        <label class="mr-2 mb-0">
                                            Category
                                        </label>
                                        @Html.DropDownListFor(model => model.CategoryDropdown, (SelectList)ViewBag.DocumentCategory, "All", new { @class = "form-control col-md-12 form-control-sm", @onchange = "GetList()" })
                                        <span id="category"></span>

                                    </div>


                                    <div class="tab-items select-option">
                                        <div class="sraech-slider">
                                            <div class="search-slider-inner">
                                                <i class="fa fa-search"></i>
                                            </div>
                                            <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                                   placeholder="Search Documents">
                                        </div>


                                    </div>


                                </div>
                            </div>



                            <!-- <end table></end> -->

                            <div class="row card-footer-bottom-fixed">
                                <div class="col-md-12 align-left">
                                    

                                </div>


                            </div>
                            <div class="row card-footer-bottom-fixed" style="padding: 9px 30px;font-weight:600;">
                                <div class="col-md-8 align-left"  >
                                    <label class="mr-2 mb-0">
                                        Total No. of Documents:
                                    </label>
                                    @Html.DisplayFor(Model => Model.TotalDocuments, new { @class = "form-control form-control-sm" })
                                    <span id="DocumentesUploaded"></span>

                                </div>

                                <div class="col-md-4 align-right">

                                    <a id="adddoc" class="btn btn-default float-right mobile-full-width " onclick="onAddNewOrEditOrDeleteClick('Create')">
                                        Add New Document
                                    </a>



                                    <a href="@Url.Action("Index", "DocumentCategory", new { Area = "Admin" })" class="btn btn-default float-right mobile-full-width">
                                        <span><i></i></span>
                                        Add New Category
                                    </a>

                                </div>

                            </div>


                            <div id="DocumentsList">
                                @await Html.PartialAsync("_DocumentsList", Model)
                            </div>
                            <div id="newRequestSlider">


                            </div>
                            <div id="deleteSlider">


                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>