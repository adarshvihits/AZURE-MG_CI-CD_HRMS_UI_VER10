@model Hrms.Lite.Shared.Admin.DocumentCategory
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table DocumentCategoryMaster-Table pt-1">
    @Html.HiddenFor(m => m.DocumentCategoryList.Count)
    <table id="DocumentCategoryTable" class="common-table">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Short Name</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>

            @{
                if (Model.DocumentCategoryList != null && Model.DocumentCategoryList.Count > 0)
                {

                    for (int i = 0; i < Model.DocumentCategoryList.Count; i++)
                    {
                        <tr>

                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(m => m.DocumentCategoryList[i].EditActive)
                            <td data-label="Name">@Model.DocumentCategoryList[i].Name</td>
                            <td data-label="Short Name">@Model.DocumentCategoryList[i].ShortName</td>
                            <td data-label="Actions">
                                <div>

                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="categoryedit"
                                       class="btn btn-icon btn-edit icon-only" onclick="AddNewOrEditClick('MODIFY','@Model.DocumentCategoryList[i].GI')">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>

                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="deletecategory"
                                       class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('DELETE','@Model.DocumentCategoryList[i].GI')">
                                        <i class="icon-xl far fa-trash-alt"></i>
                                    </a>


                                </div>
                            </td>
                        </tr>
                    }
                }


            }

        </tbody>
    </table>
</div>