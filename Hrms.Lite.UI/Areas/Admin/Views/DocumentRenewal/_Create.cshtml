
@model Hrms.Lite.Shared.Admin.DocumentRenewal
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}

<script src="~/js/bootstrap-datepicker.js"></script>
@*<script>
        $(document).ready(function () {
            debugger;
            //$('#Name').focus();
            moveCursorToEnd('Name');
        });


    </script>*@
@using (Html.BeginForm("Save", "DocumentRenewal", FormMethod.Post, new { id = "DocumentRenewalsave" }))
{
    <div id="addbankname" class="slider-forms slider-forms-open AddNewDiv">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddNewDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>Document Renewal  </h4>
            </div>

            
            <div class="add-padding">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Category</label>
                                <span class="Mandatory">*</span>

                                @Html.DropDownListFor(Model => Model.RenewalsCategory.Code, (SelectList)ViewBag.RenewalsCategory, " Select  Category ", new { @class = "form-control form-control-sm" })
                                <span id="renewalsCategory"></span>


                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>
                                    Name
                                    <span class="Mandatory">*</span>
                                </label>

                                @Html.HiddenFor(model => Model.Mode)
                                @Html.HiddenFor(model => Model.GI)
                                @Html.TextBoxFor(Model => Model.DocumentName, new { @class = "form-control form-control-sm BName", @placeholder = "Name", maxlength = "120" })
                                <span id="documentName"></span>
                            </div>
                        </div>

                    </div>
                    <div class="row my-2">

                        <div class="col-md-6">
                            <label>Renewal Date</label>
                            <span class="Mandatory">*</span>
                            <div class="input-group date">
                                @Html.TextBoxFor(Model => Model.RenewalDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2 dop", @readonly = "true", @placeholder = "Renewal Date", @onchange = "validate(this,'RenewalDate')" })
                                <span id="renewalDate"></span>
                                <div class="input-group-append">
                                    <span class="input-group-text">
                                        <i class="la la-calendar"></i>
                                    </span>
                                </div>
                            </div>
                        </div>



                    </div>




                    <div class="row my-3">

                    <div class="col-md-12">

                        @if (Model.Mode == "CREATE")
                            {
                        <label>Remarks</label>
                        @Html.TextAreaFor(Model => Model.Remarks, new { @class = "form-control form-control-sm BDescription", @placeholder = "Remarks", maxlength = "250" })

                            }
                        @if (Model.Mode == "MODIFY")
                            {
                    <label class="view-title">Remarks</label>
                    <div class="view-details">

                        @Html.TextAreaFor(Model => Model.Remarks, new { @class = "form-control form-control-sm BDescription", @placeholder = "Remarks", maxlength = "250" })

                    </div>
                            }
                    </div>
                </div>

                    <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">
                        @if (Model.Mode == "CREATE")
                        {
                            if (CurrentUserRoleActions.Create == true)
                            {

                                <button type="button" class="btn btn-default  mobile-full-width" onclick="Save('Save')">
                                    Save
                                </button>
                            }
                        }
                        @if (Model.Mode == "MODIFY")
                        {

                            if (CurrentUserRoleActions.Modify == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="Save('Modify')">
                                    Modify
                                </button>
                            }
                        }
                    </div>

                </div>
                </div>
        </div>
    </div>
}