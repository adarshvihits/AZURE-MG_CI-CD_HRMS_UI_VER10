@model Hrms.Lite.Shared.Admin.DocumentRenewal
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table DocumentRenewal pt-1">
    @Html.HiddenFor(model => Model.DocumentRenewalList.Count)
    <table id="BankTable" class="common-table">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Renewals Category</th>
                <th scope="col">Renewal Date</th>
                <th scope="col">Remarks</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>

            @{
                if (Model.DocumentRenewalList != null && Model.DocumentRenewalList.Count > 0)
                {
                    for (int i = 0; i < Model.DocumentRenewalList.Count; i++)

                    {
                        <tr>
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Name">
                                @Model.DocumentRenewalList[i].DocumentName
                            </td>
                            <td data-label="RenewalsCategory Name"> @Model.DocumentRenewalList[i].RenewalsCategory.Name</td>
                            <td data-label="RenewalDate"> @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.DocumentRenewalList[i].RenewalDate))</td>
                            <td data-label="Remarks"> @Model.DocumentRenewalList[i].Remarks</td>
                            <td data-label="Actions">
                                <div>

                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="banknameedit"
                                       class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY', '@Model.DocumentRenewalList[i].GI', '@Model.DocumentRenewalList[i].GI',@i)">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>

                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="banknamedelete"
                                       class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.DocumentRenewalList[i].GI', '@Model.DocumentRenewalList[i].GI','DELETE',@i)">
                                        <i class="icon-xl far fa-trash-alt"></i>
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                }


            }


        </tbody>
    </table>
</div>