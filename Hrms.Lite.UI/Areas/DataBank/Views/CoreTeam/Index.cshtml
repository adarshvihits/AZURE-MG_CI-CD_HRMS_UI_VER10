<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Core Team

                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Core Team

                    </li>

                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">


                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">

                            <div class="tab-items ">
                                <a class="btn-title active All" onclick="tabClick('All', '0');">
                                    All
                                    <span class="btn-notification AllCount">@Model.AllCount</span>
                                </a>
                            </div>
                            <div class="tab-items high">
                                <a class="btn-title Core_Team" onclick="tabClick('Core_Team','1');">
                                    Core Team
                                    <span class="btn-notification CoreTeamCount">@Model.CoreTeamCount</span>
                                </a>
                            </div>

                            @*@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "coreEmpList" }))
                            {
                               
                                <div id="tableCoreteam" class="hide">
                                    <table id="tableAllList">
                                        <thead>
                                            <tr class="table-dark">
                                                <th scope="col">ID</th>
                                                <th scope="col">Name</th>
                                                <th scope="col">Designation</th>
                                                <th scope="col">Department</th>
                                                <th scope="col">Location </th>
                                                <th scope="col">Category</th>
                                                <th scope="col">DOJ</th>
                                                <th scope="col">Y/S</th>
                                                <th scope="col">Applicability</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>
                            }*@

                            <div class="tab-items select-option">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search" onclick="$('#searchList').focus();"></i>
                                    </div>
                                    <input id="searchList" type="text" class="form-control form-control-sm"
                                           placeholder="Search ID/Name" onkeyup="searchRows()">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" id="excelButton" title="" class="btn btn-excel float-left hide" data-bs-original-title="Export to Excel" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>


                            </div>
                        </div>

                    </div>
                    <div id="AllListDiv">
                        @*class="hide"*@
                        @await Html.PartialAsync("~/Areas/DataBank/Views/CoreTeam/_AllList.cshtml", Model)
                    </div>
