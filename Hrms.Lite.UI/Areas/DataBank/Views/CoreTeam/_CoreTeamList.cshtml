@model Hrms.Lite.Shared.DataBank.CoreTeam
    <script src="~/js/tooltip.js"></script>

    <div class="ihits-table table-border mobile-responsive-table core_team_emp_list vertical-scroll-450">
        @*@Html.HiddenFor(m => m.CoreTeamList.Count)*@
        <table id="CoreTeamListTable">
            <thead>
                <tr class="table-dark">

                    <th scope="col">ID</th>
                    <th scope="col">Name</th>
                    <th scope="col">Fun.Designation</th>
                    <th scope="col">Department</th>
                    <th scope="col">Location </th>
                    <th scope="col">Category</th>
                    <th scope="col" data-bs-toggle="tooltip" title="Date Of Join">DOJ</th>
                    <th scope="col" data-bs-toggle="tooltip" title="Years Of Service">Y/S</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.TeamList != null && Model.TeamList.Count > 0)
                {
                    for (int i = 0; i < Model.TeamList.Count; i++)
                    {
                        <tr>
                            <td>
                                @Model.TeamList[i].EmployeeID
                                @Html.HiddenFor(m => m.TeamList[i].EmployeeCode)
                            </td>
                            <td>@Model.TeamList[i].EmployeeName </td>
                            <td>@Model.TeamList[i].Designation</td>
                            <td>@Model.TeamList[i].Department</td>
                            <td>@Model.TeamList[i].Location</td>
                            <td>@Model.TeamList[i].Category</td>
                            <td> @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.TeamList[i].DOJ))</td>
                            <td>@Model.TeamList[i].YOS</td>

                        </tr>
                    }
                }

                else
                {
                    <tr>
                        <td colspan="8">
                            <div style="text-align: center;display: flex;align-items: center;justify-content: center;height: 60vh;"><img src="/images/nodata.png" /></div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <!-- Table Setion End -->
