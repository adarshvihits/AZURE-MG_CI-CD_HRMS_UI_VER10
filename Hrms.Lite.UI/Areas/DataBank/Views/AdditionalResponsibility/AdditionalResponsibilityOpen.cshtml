@model Hrms.Lite.Shared.DataBank.AdditionalResponsibility
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/scripts/DataBank/AdditionalResponsibility.js"></script>
@using (Html.BeginForm("", "", FormMethod.Post, new { @class = "display-flex", enctype = "multipart/form-data", @id = "AdditionalResponsibility_Entry" }))
{
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->


            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Additional Responsibility </h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "DashBoard", new { Area = "" })" class="">
                                <i class="icon-nm fas fa-home mt-1"></i>
                            </a>
                        </li>
                        <li class="breadcrumb-item text-muted child-mute">
                            Additional Responsibility
                        </li>
                    </ul>
                </div>
            </div>
            <!--begin::Topbar-->
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <div class="card card-custom height-100per">

        <div class="card-body">
            <div class="profile-header  position-relative box-shadow-none mb-2">
                @Html.HiddenFor(m => m.EmployeeGI)
                @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeHeader.cshtml", Model.EmployeeHeader)
                <div class="profile-header-overflow"></div>
            </div>
            <!--begin: Search Form-->
            <div class="row mb-3">



            </div>

            @if (@Model.RowCount > 0)
            {
                <div class="page_white mb-4">


                    <div id="viewClarificationDetails">
                        <div class="ihits-table table-border hover-color odd-even mobile-responsive-table loan-request-clarification_detailed-list">
                            <h4>
                                Additional Responsibility
                            </h4>
                            @Html.HiddenFor(Model => Model.AdditionalResponsibilityHistory.Count)
                            @Html.HiddenFor(model => Model.RequestGI)
                            <table class="common-table">
                                <thead>
                                    <tr class="table-dark">
                                        <th scope="col">Description</th>
                                        <th scope="col">From</th>
                                        <th scope="col">To</th>
                                        <th scope="col">Branch</th>
                                        <th scope="col">Status</th>
                                        <th scope="col">Closing Date</th>
                                    </tr>

                                </thead>
                                <tbody>
                                    @if (Model.AdditionalResponsibilityHistory != null && Model.AdditionalResponsibilityHistory.Count > 0)
                                    {

                                        for (int i = 0; i < Model.AdditionalResponsibilityHistory.Count; i++)
                                        {
                                            <tr>
                                                <td data-label="From">@Model.AdditionalResponsibilityHistory[i].Description</td>
                                                <td data-label="Employee Name">@Model.AdditionalResponsibilityHistory[i].FromDate</td>
                                                <td data-label="Designation">@Model.AdditionalResponsibilityHistory[i].ToDate</td>
                                                <td data-label="Department">@Model.AdditionalResponsibilityHistory[i].Branch</td>
                                                <td data-label="Designation">@Model.AdditionalResponsibilityHistory[i].Status</td>
                                                <td data-label="Department">@Model.AdditionalResponsibilityHistory[i].ClosingDate</td>

                                            </tr>
                                        }
                                    }

                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
            <div class="page_white">


                <div class="row my-4">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Additional Responsibility</label><span class="Mandatory">*</span>

                            @Html.DropDownListFor(m => m.ResAdditionalResponsibility.Code, (SelectList)ViewBag.AdditionalResponsibility, new { @class = "form-control form-control-sm" })

                            <span id="examCode"></span>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group mb-0">
                            <label>From Date</label>
                            <div class="input-group date">
                                @Html.TextBoxFor(m => m.FromDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "From Date" })

                                <div class="input-group-append">
                                    <span class="input-group-text">
                                        <i class="la la-calendar"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="col-md-4">
                        <div class="form-group mb-0">
                            <label>To Date</label>
                            <div class="input-group date">
                                @Html.TextBoxFor(m => m.ToDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "To Date" })

                                <div class="input-group-append">
                                    <span class="input-group-text">
                                        <i class="la la-calendar"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>


                </div>
                <div class="row my-4">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Branch</label><span class="Mandatory">*</span>

                            @Html.DropDownListFor(m => m.Branch.Code, (SelectList)ViewBag.Branch, new { @class = "form-control form-control-sm" })

                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Status</label><span class="Mandatory">*</span>

                            @Html.DropDownListFor(m => m.Status.Code, (SelectList)ViewBag.Status, new { @class = "form-control form-control-sm" })

                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group mb-0">
                            <label>Closing Date</label>
                            <div class="input-group date">
                                @Html.TextBoxFor(m => m.ClosingDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "Closing Date" })

                                <div class="input-group-append">
                                    <span class="input-group-text">
                                        <i class="la la-calendar"></i>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row my-3">
                    <div class="col-md-6">
                        <div class="row-ithems">
                            <label class="">Remarks</label>
                            @Html.TextBoxFor(m => m.Remark, new { @class = "form-control form-control-sm", @placeholder = "Remarks", maxlength = "250", @onblur = "validate(this,'HrRemarks')" })
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="row-ithems">
                            <div class="row-outer">
                                <label class="view-title">View Upload</label>
                                <div class="view-details">
                                    <a data-bs-toggle="tooltip" data-bs-original-title="View File"
                                       class="btn btn-small btn-secondary mobile-full-width"
                                       onclick="showDecompressedDocument('@Model.RequestGI','@Model.EmployeeGI')">
                                        <i class="icon-xl far fa-eye"></i>View File
                                    </a>
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="col-md-2 align-right d-flex align-items-center">
                        <button type="button" onclick="SaveAdditionalResponsibility()"
                                class="btn btn-default mt-4 mobile-full-width ">
                            Save
                        </button>

                    </div>
                </div>
            </div>

        </div>
    </div>
}

