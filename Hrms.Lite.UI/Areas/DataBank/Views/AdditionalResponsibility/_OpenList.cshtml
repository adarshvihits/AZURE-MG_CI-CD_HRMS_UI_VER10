@model Hrms.Lite.Shared.DataBank.AdditionalResponsibility

<script src="~/js/settings.js"></script>
<script src="~/scripts/DataBank/AdditionalResponsibility.js"></script>
<script>
    $(document).ready(function () {
        debugger;

        $('.general_Count').text(' @Model.GeneralCount');
        $('.closed_Count').text(' @Model.ClosedCount');
        $('.open_Count').text(' @Model.OpenCount');
    });

</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table loan-request-approval-list">
    @Html.HiddenFor(Model => Model.AdditionalResponsibilityList.Count)
    <table class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">Employee ID</th>
                <th scope="col">Employee</th>
                <th scope="col">Designtion</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">Status</th>
                <th scope="col"></th>
            </tr>

        </thead>
        <tbody>
            @if (Model.AdditionalResponsibilityList != null && Model.AdditionalResponsibilityList.Count > 0)
            {

                for (int i = 0; i < Model.AdditionalResponsibilityList.Count; i++)
                {
                    <tr>
                        <td data-label="EmployeeID">@Model.AdditionalResponsibilityList[i].EmployeeID</td>
                        <td data-label="EmployeeName">@Model.AdditionalResponsibilityList[i].EmployeeName</td>
                        <td data-label="Designation">@Model.AdditionalResponsibilityList[i].Designation</td>
                        <td data-label="Department">@Model.AdditionalResponsibilityList[i].Department</td>
                        <td data-label="Location">@Model.AdditionalResponsibilityList[i].Location</td>
                        <td data-label="Status">@Model.AdditionalResponsibilityList[i].ApprovalStatus</td>


                        <td data-label="">
                            <a data-bs-toggle="tooltip" title="" class="view_btn m-0" onclick="GetAdditionalResponsibility('@Model.AdditionalResponsibilityList[i].EmployeeGI','Open');" data-bs-original-title="Approve"> </a>
                        </td>


                    </tr>
                }
            }




        </tbody>
    </table>
</div>
