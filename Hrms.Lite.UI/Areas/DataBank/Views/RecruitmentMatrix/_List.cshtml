@model Hrms.Lite.Shared.DataBank.DTO.RecruitmentMatrix
<script src="~/js/settings.js"></script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table RecruitmentMatrix-list">
    @Html.HiddenFor(m => m.RecruitmentMatrixList.Count)
    <table class="common-table" id="RecruitmentMatrixTable">
        <thead>
            <tr class="table-dark">
                <th scope="col">Level</th>
                <th scope="col">Recruitment Role Name</th>
                <th scope="col">Role Or Employee</th>
                <th scope="col">Role Name</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>

            @if (Model.RecruitmentMatrixList != null && Model.RecruitmentMatrixList.Count > 0)
            {
                for (int i = 0; i < Model.RecruitmentMatrixList.Count; i++)
                {
            <tr>
                @Html.HiddenFor(model => Model.RecruitmentMatrixList[i].RecruitmentMatrixGI)
                <td data-label="Code">Level -@Model.RecruitmentMatrixList[i].LevelCode</td>
                <td data-label="Role"> @Model.RecruitmentMatrixList[i].RecruitmentRoleName</td>
                <td data-label="Role"> @Model.RecruitmentMatrixList[i].RoleOrEmployee</td>
                <td data-label="Role"> @Model.RecruitmentMatrixList[i].RoleName</td>
                <td data-label="Role"> @Model.RecruitmentMatrixList[i].EmployeeName</td>

                <td data-label="Actions">
                    <div>
                        @*<a data-bs-toggle="tooltip" title="View" class="view_btn " onclick="getDetails('@Model.RecruitmentMatrixList[i].RecruitmentMatrixGI')"> </a>*@

                        <a data-bs-toggle="tooltip" title="Edit"
                           class="btn btn-icon btn-edit icon-only "
                           onclick="onEditClick('@Model.RecruitmentMatrixList[i].RecruitmentMatrixGI')">
                            <i class="icon-xl fas fa-pencil-alt"></i>
                        </a>
                        <a data-bs-toggle="tooltip" title="Delete"
                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="OnDeleteClick('@Model.RecruitmentMatrixList[i].RecruitmentMatrixGI')">
                            <i class="icon-xl far fa-trash-alt"></i>
                        </a>

                    </div>
                </td>
            </tr>
                }
            }


        </tbody>
    </table>

</div>