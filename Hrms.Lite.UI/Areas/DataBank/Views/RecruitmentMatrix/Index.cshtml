@model Hrms.Lite.Shared.DataBank.DTO.RecruitmentMatrix
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/DataBank/recruitmentMatrix.js"></script>

@*<script>
        debugger;
        $(document).ready(function () {

            fillData();

        });
    </script>*@
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Recruitment Matrix</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Recuritment Matrix
                    </li>

                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
        <div class="topbar">

        </div>
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                    <!--begin: Search Form-->

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap align-items-center">


                            <div class="tab-items ml-5 pr-0 border-none ">
                                <div class="form-group filter-combobox mr-10" style="width: 280px;">

                                    <label>Recruitment Template</label>
                                    @Html.DropDownListFor(m => m.TemplateList, (SelectList)ViewBag.Template, "--ALL--", new { @class = "form-control form-control-sm", @onchange = "getList()" })
                                    <span id="Role"></span>
                                </div>

                            </div>


                            <div class="tab-items select-option">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>

                                <button data-bs-toggle="tooltip" title="Export to Excel"
                                        class="btn btn-excel" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </button>
                            </div>


                        </div>
                    </div>



                    <div id="RecruitmentMatrixlist">
                        @await Html.PartialAsync("_List", Model)
                    </div>
                    <div id="CreateSlider">

                    </div>
                    <div id="EditSlider">

                    </div>
                    <div id="ViewSlider">

                    </div>
                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.filter)
                    </div>
                    <div id="LevelList">
                    </div>
                    <!--end: Datatable-->
                    @*<div class="row card-footer-bottom-fixed">

                            <div class="col-md-12 align-left">
                                <a id="wageGradeMasterAdd" type="button"
                                   class="btn btn-default float-right mobile-full-width slider-btn" onclick="getApproverRole()">
                                    Approver Role
                                </a>
                            </div>


                        </div>*@

                    <div class="row card-footer-bottom-fixed">
                        @*<div class="col-md-6">
                            <a class="btn btn-default  mobile-full-width slider-btn" onclick="getDefaultSettings()">
                                Default Approval Matrix
                            </a>
                            </div>*@
                        <div class="col-md-12 align-right">
                            <a id="wageGradeMasterAdd"
                               class="btn btn-default float-right mobile-full-width slider-btn" onclick="getCreate()">
                                Add  Recruitment Matrix
                            </a>

                        </div>


                    </div>


                </div>
            </div>
        </div>


        <!--end::Row-->
        <!--begin::Row-->
        <!--end::Row-->
        <!--end::Dashboard-->
    </div>
    <!--end::Container-->
</div>
<!--end::Entry-->
</div>
<div class="slider-over-flow"></div>
<!--end::Content-->