@model Hrms.Lite.Shared.DataBank.DTO.RecruitmentMatrix
<link href="~/css/custom.css" rel="stylesheet" />
<script src="~/js/tooltip.js"></script>
<script src="~/js/Multiselectdropdown.js"></script>
<script>
    $(document).ready(function () {
        // Prevent form submission on Enter for NoOfLevels
        $('#NoOfLevels').on('keydown', function (e) {
            if (e.key === "Enter" || e.keyCode === 13) {
                e.preventDefault();
                return false;
            }
        });
    });


</script>
<style>
   /* .multiselect-native-select .btn.dropdown-toggle {
        border: none !important;
    }*/

   
    .slider-forms-width {
        width: 1000px;
    }

</style>
@using (Html.BeginForm("Create", "RecruitmentMatrix", FormMethod.Post, new { id = "RecruitmentMatrixSave" }))
{
    @Html.HiddenFor(model => Model.RecruitmentMatrixGI)
    @Html.HiddenFor(model => Model.Template.Code)
    <div id="RecruitmentMatrix" class="slider-forms slider-forms-open closeEdit slider-forms-width">
        <div class="slider-inner-style  new-inner-style">
            <div class="slider-form-close">
                <i class="ki ki-close icon-xs text-muted" onclick="CloseeSlider('closeEdit');$('.closeEdit').removeClass('slider-forms-width')"></i>
            </div>
            <div class="location-slider">

                <h4>
                    Approval Matrix
                </h4>

            </div>
            <div class="add-padding">
                <div class="row">

                    <div class="col-md-6">
                        <div class="form-group">
                            <div class="row-ithems">
                                <label class="view-title">Template</label>
                                <div class="view-details">@Model.Template.Name</div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>No Of Levels</label>
                            @Html.TextBoxFor(Model => Model.NoOfLevels, new { @class = "form-control form-control-sm ", @placeholder = "NoOfLevels", @onkeypress = "return onlyNumberKey(event)", @onblur = "validate(this, 'noOfLevels')"@*, @onChange = "return GetEditRoleDetails()"*@ })
                            <span id="noOfLevels"></span>
                        </div>
                    </div>

                    <div class="col-md-4 form-group d-flex align-items-center">
                        <div class=" pt-4 align-right">

                            <div class="button-group">

                                <button type="button" class="btn btn-default btn-sm " onclick="GetEditRoleDetails()">
                                    Proceed
                                </button>

                            </div>

                        </div>
                    </div>

                </div>




                <div class="row">
                    <div class="col-md-12">
                        <div id="RoleList">
                            @await Html.PartialAsync("_LevelList", Model)
                        </div>
                    </div>

                </div>

                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12 align-right">
                        <a type="button" onclick="Modify('@Model.Template.Code')"
                           class="btn btn-default  mobile-full-width">
                            Modify
                        </a>
                        @*<a data-bs-toggle="tooltip" data-bs-original-title="Delete" class="btn btn-icon btn-delete big-btn float-none" onclick="Delete()">
                            <i class="icon-xl far fa-trash-alt"></i>
                        </a>*@
                    </div>
                </div>

            </div>
        </div>
    </div>
}
<!-- Edit Slider  end-->
