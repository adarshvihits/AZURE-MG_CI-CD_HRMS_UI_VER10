@model Hrms.Lite.Shared.DataBank.DTO.SkillRequisition
<script src="~/js/settings.js"></script>
<div class="ihits-table table-border odd-even mobile-responsive-table employee-notice-list new-tble-pad-tp">
    @Html.HiddenFor(m => m.SkillRequisitionList.Count)
    <table id="SkillRequisitionTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">Skill Name</th>
                <th scope="col">Skill Type Name</th>
                <th scope="col">Available</th>
                <th scope="col">Requirments</th>
            </tr>
        </thead>
        <tbody>

            @if (Model.SkillRequisitionList != null && Model.SkillRequisitionList.Count > 0)
            {


                for (int i = 0; i < Model.SkillRequisitionList.Count; i++)

                {
                    
            <tr>

                @Html.HiddenFor(model => Model.SkillRequisitionList[i].SkillCode)
                @Html.HiddenFor(model => Model.SkillRequisitionList[i].GI)
                <td data-label="Skill Name">@Model.SkillRequisitionList[i].SkillName</td>
                <td data-label="Skill Type Name"> @Model.SkillRequisitionList[i].SkillTypeName</td>
                <td data-label="Skill Type Name"> @Model.SkillRequisitionList[i].AvailableCount</td>
                <td data-label="Requiirments">
                    @Html.TextBoxFor(m => m.SkillRequisitionList[i].RequirmentCount, new { @class = "form-control form-control-sm", @onkeypress = "return onlyNumberKey(event)" })
                </td>



                @*@if (Model.EmployeeDtList[i].Replacement == "True")
        {
            <td data-label="Replacement">Yes</td>
        }
        else
        {
            <td data-label="Replacement">No</td>
        }*@


            </tr>
                }
            }


        </tbody>
    </table>
</div>