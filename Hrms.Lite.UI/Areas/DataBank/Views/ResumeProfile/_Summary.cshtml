@model Hrms.Lite.Shared.DataBank.DTO.ResumeDataBank

<div class="row">
    <div class="col-md-6">
        <div class="row-outer">
            <label class="view-title">Suited Designation</label>
            <div class="view-details">
                @if (Model.Details.SuitedDesignationName != null && Model.Details.SuitedDesignationName.Length != 0)
                {
                    for (int i = 0; i < Model.Details.SuitedDesignationName.Length; i++)
                    {
                        @Model.Details.SuitedDesignationName[i]
                        if (i != 0)
                        {
                            <span>,</span>
                        }
                    }
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="row-outer">
            <label class="view-title">Suited Location</label>
            <div class="view-details">
                @if (Model.Details.SuitedLocationName != null && Model.Details.SuitedLocationName.Length != 0)
                {
                    for (int i = 0; i < Model.Details.SuitedLocationName.Length; i++)
                    {
                        @Model.Details.SuitedLocationName[i]
                        if (i != 0)
                        {
                            <span>,</span>
                        }
                    }
                }
            </div>
        </div>
    </div>

</div>

<div class="row my-2">
    <div class="col-md-6">
        <div class="row-outer">
            <label class="view-title">Referral/Source of Application</label>
            <div class="view-details">@Model.Details.ResumeSource.Name</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="row-outer">
            <label class="view-title">Description</label>
            <div class="view-details">@Model.Details.Description</div>
        </div>
    </div>


</div>
