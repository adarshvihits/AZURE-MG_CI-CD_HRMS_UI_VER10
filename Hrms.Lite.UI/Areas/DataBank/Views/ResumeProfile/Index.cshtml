                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a href="@Url.Action(Model.Breadscrumb.Action, Model.Breadscrumb.Controller, new { Area = Model.Breadscrumb.Area })">@Model.Breadscrumb.DisplayName</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Resume Profile
                    </li>
                </ul>
            </div>
        </div>


    </div>
    <!--end::Container-->
</div>


