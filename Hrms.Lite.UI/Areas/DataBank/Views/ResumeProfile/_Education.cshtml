@model Hrms.Lite.Shared.DataBank.DTO.ResumeDataBank

<div class="row">
    <div class="col-md-12">
        <div class="ihits-table table-border mobile-responsive-table">
            <table id="education">
                <thead>
                    <tr class="table-light">
                        <th scope="col">Qualification Type</th>
                        <th scope="col">Qualification</th>
                        <th scope="col">Specialization of Branch</th>
                        @*<th scope="col">College/University</th>
                        <th scope="col">Aggregate</th>*@
                        <th scope="col">Year of Completion</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Education != null && Model.Education.Count > 0)
                    {
                        @for (int i = 0; i < Model.Education.Count; i++)
                        {
                        <tr>
                            <td data-label="Qualification Type">
                                @Html.DisplayFor(m => m.Education[i].QualificationType.Name)

                            </td>
                            <td data-label="Qualofication">

                                @Html.DisplayFor(m => m.Education[i].Qualification.Name)
                            </td>
                            <td data-label="Field of Study">

                                @Html.DisplayFor(m => m.Education[i].SpecializationOfBranch.Name)
                            </td>
                            @*<td data-label="Field of Study">

                    @Html.DisplayFor(m => m.Education[i].College_University)
                </td>
                <td data-label="Year of Completion">

                    @Html.DisplayFor(m => m.Education[i].Aggregate)
                </td>*@
                            <td data-label="Year of Completion">

                                @Html.DisplayFor(m => m.Education[i].YearOfCompletion)
                            </td>
                        </tr>
                        }
                    }
                    else
                    {
                    <tr>
                        <td>No table data</td>
                    </tr>
                    }


                </tbody>
            </table>
        </div>
    </div>
</div>

