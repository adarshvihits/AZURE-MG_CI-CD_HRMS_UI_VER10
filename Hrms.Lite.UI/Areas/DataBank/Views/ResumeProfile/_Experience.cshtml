@model Hrms.Lite.Shared.DataBank.DTO.ResumeDataBank

<style>
    .ex-fres-colo {
        font-size:21px;
        color: black;
        font-weight: 400;
    }
</style>
<div class="row">
    <div class="col-md-12">
        @if (Model.FresherOrExperienced == 1)
        {
            <h2 class="ex-fres-colo">Experienced</h2>
            <div class="ihits-table table-border mobile-responsive-table vertical-scroll-250">
                <table>
                    <thead>
                        <tr class="table-light">
                            <th scope="col">Company Name</th>
                            <th scope="col">Location</th>
                            <th scope="col">Designation</th>
                            <th scope="col">Area</th>
                            <th scope="col">From</th>
                            <th scope="col">To</th>
                            <th scope="col">Experience</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Experience != null && Model.Experience.Count > 0)
                        {
                            @for (int i = 0; i < Model.Experience.Count; i++)
                            {
                        <tr>
                            <td data-label="Company Name">
                                @Html.DisplayFor(m => m.Experience[i].CompanyName)
                            </td>
                            <td data-label="Location">
                                @Html.DisplayFor(m => m.Experience[i].Location)
                            </td>
                            <td data-label="Designation">
                                @Html.DisplayFor(m => m.Experience[i].Designation)
                            </td>
                            <td data-label="Area">
                                @Html.DisplayFor(m => m.Experience[i].Area)
                            </td>
                            <td data-label="From">
                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Experience[i].From))
                            </td>
                            <td data-label="To">
                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Experience[i].To))
                            </td>
                            <td data-label="Experience">
                                @Html.DisplayFor(m => m.Experience[i].Experience)
                            </td>
                        </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
          <h2 class="">Fresher</h2>    
        }
    </div>
</div>        
