@model Hrms.Lite.Shared.DataBank.DTO.ResumeDataBank

        <div class="row my-2">
            <div class="col-md-4">
                <div class="row-outer">
                    <label class="view-title">Mobile number linked to aadhar</label>
                    <div class="view-details">@Model.Details.Mobile</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="row-outer">
                    <label class="view-title">Email</label>
                    <div class="view-details">@Model.Details.Email</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="row-outer">
                    <label class="view-title">DOB</label>
                    <div class="view-details">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Details.DOB))</div>
                </div>
            </div>
        </div>


        <div class="row my-2">

            <div class="col-md-4">
                <div class="row-outer">
                    <label class="view-title">Gender</label>
                    <div class="view-details">@Model.Details.Gender.Name</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="row-outer">
                    <label class="view-title">Marital Status</label>
                    <div class="view-details">@Model.Details.MaritalStatus.Name</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="row-outer">
                    <label class="view-title">Aadhar Number</label>
                    <div class="view-details">@Model.Details.Adhar</div>
                </div>
            </div>

        </div>

        <div class="row my-2">

            <div class="col-md-4">
                <div class="row-outer">
                    <label class="view-title">Pan Number</label>
                    <div class="view-details">@Model.Details.PAN</div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="row-outer">
                    <label class="view-title">Driving License Number</label>
                    <div class="view-details">@Model.Details.DrivingLicenseNo</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="row-outer">
                    <label class="view-title">Resume View</label>
                    <div class="small-btn-group">
                        <button type="button" class=" btn btn-icon btn-eye icon-only pr-2" onclick="showDocument('@Model.Details.Resume.ActualFileName', '@Model.Details.Resume.AbsoluteUri')" data-bs-original-title="">
                            <i class="icon-xl far fa-eye"></i>
                        </button>
                    </div>
                </div>
            </div>

        </div>