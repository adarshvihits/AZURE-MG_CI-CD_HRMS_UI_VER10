@model Hrms.Lite.Shared.DataBank.DTO.ResumeDataBank

        <div class="row my-2">
            <div class="col-md-4">
                <div class="row-outer">
                    <label class="view-title">House</label>
                    <div class="view-details">@Model.Details.House</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="row-outer">
                    <label class="view-title">Street</label>
                    <div class="view-details">@Model.Details.Street</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="row-outer">
                    <label class="view-title">City</label>
                    <div class="view-details">@Model.Details.City</div>
                </div>
            </div>

        </div>

        <div class="row my-2">
            <div class="col-md-4">
                <div class="row-outer">
                    <label class="view-title">Pincode</label>
                    <div class="view-details">@Model.Details.Pin</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="row-outer">
                    <label class="view-title">Country</label>
                    <div class="view-details">@Model.Details.Country.Name</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="row-outer">
                    <label class="view-title">State</label>
                    <div class="view-details">@Model.Details.State.Name</div>
                </div>
            </div>
        </div>

        <div class="row my-2">
            <div class="col-md-4">
                <div class="row-outer">
                    <label class="view-title">District</label>
                    <div class="view-details">@Model.Details.District.Name</div>
                </div>
            </div>
        </div>
