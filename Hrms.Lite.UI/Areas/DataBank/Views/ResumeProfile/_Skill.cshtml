@model Hrms.Lite.Shared.DataBank.DTO.ResumeDataBank
    
<div class="row">
    <div class="col-md-12">
        <div class="ihits-table table-border mobile-responsive-table vertical-scroll-250">
            <table>
                <thead>
                    <tr class="table-light">
                        <th scope="col">Skill</th>
                        <th scope="col">Skill Type</th>
                        <th scope="col">Skill Proficiency</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Skill != null && Model.Skill.Count > 0)
                    {
                        @for (int i = 0; i < Model.Skill.Count; i++)
                        {
                            <tr>
                                <td data-label="Skill">
                                    @Html.DisplayFor(m => m.Skill[i].Skill.Name)

                                </td>
                                <td data-label="Skill Type">

                                    @Html.DisplayFor(m => m.Skill[i].SkillType.Name)
                                </td>
                                <td data-label="Skill Proficiency">

                                    @Html.DisplayFor(m => m.Skill[i].SkillProficiency.Name)
                                </td>
                            </tr>
                        }


                    }
                    else
                    {
                        <tr>
                            <td>No table data</td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>
