@model Hrms.Lite.Shared.DataBank.DTO.ResumeDataBank

<div class="row">
    <div class="col-md-12">
        <div class="ihits-table table-border mobile-responsive-table vertical-scroll-250">
            <table id="education">
                <thead>
                    <tr class="table-light">
                        <th scope="col">Certification</th>
                        @*<th scope="col">Registration Number</th>*@
                        <th scope="col">Certification Type</th>
                        <th scope="col">Issued By</th>
                        <th scope="col">Issued Date</th>
                        <th scope="col">Mode</th>
                        <th scope="col">Validity</th>
                        <th scope="col">Renewal</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Certifications != null && Model.Certifications.Count > 0)
                    {
                        @for (int i = 0; i < Model.Certifications.Count; i++)
                        {
                            <tr>
                                <td data-label="Certification">
                                    @Html.DisplayFor(m => m.Certifications[i].Certificate)

                                </td>
                                @*<td data-label="Registration Number">

                                    @Html.DisplayFor(m => m.Certifications[i].RegistrationNo)
                                </td>*@
                                <td data-label="Certification Type">

                                    @Html.DisplayFor(m => m.Certifications[i].CertificateType.Name)
                                </td>

                                <td data-label="Issued By">

                                    @Html.DisplayFor(m => m.Certifications[i].IssuedBy)
                                </td>
                                <td data-label="Issued Date">

                                    @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Certifications[i].IssuedDate))
                                </td>
                                <td data-label="Mode">

                                    @Html.DisplayFor(m => m.Certifications[i].CertificateMode.Name)
                                </td>
                                <td data-label="Validity">

                                    @Html.DisplayFor(m => m.Certifications[i].CertificateValidity.Name)
                                </td>
                                <td data-label="Renewal">

                                    @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Certifications[i].RenewalDate))
                                </td>
                            </tr>
                        }


                    }
                    else
                    {
                        <tr>
                            <td>No table data</td>
                        </tr>
                    }


                </tbody>
            </table>
        </div>
    </div>
</div>

