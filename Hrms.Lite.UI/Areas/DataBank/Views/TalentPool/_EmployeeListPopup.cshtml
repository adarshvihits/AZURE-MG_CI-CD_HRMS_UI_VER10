@model Hrms.Lite.Shared.DataBank.DTO.TalentPool



    <div class="col-md-12">
        <div class="ihits-table table-border">
            <table id="skillTable">
                <thead>
                    <tr class="table-light">
                        <th scope="col">Employee ID </th>
                        <th scope="col">Employee Name</th>
                        <th scope="col">
                            Department
                        </th>
                        <th scope="col">Designation</th>
                        <th scope="col">Location</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.TalentPoolList != null && Model.TalentPoolList.Count > 0)
                    {

                        for (int i = 0; i < Model.TalentPoolList.Count; i++)
                        {
                    <tr>
                        <td data-label="ID">

                            @Model.TalentPoolList[i].EmployeeID
                        </td>
                        <td data-label="Employee Name">   @Model.TalentPoolList[i].FullName</td>
                        <td data-label="Department"> @Model.TalentPoolList[i].Department</td>
                        <td data-label="Designation"> @Model.TalentPoolList[i].Designation</td>
                        <td data-label="Location"> @Model.TalentPoolList[i].Location</td>


                    </tr>
                        }
                    }

                </tbody>
            </table>
        </div>
    </div>
