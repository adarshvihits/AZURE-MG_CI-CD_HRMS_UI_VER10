@model Hrms.Lite.Shared.DataBank.DTO.TalentPool
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>

    .Skill_chrt-one{
        text-align:center;
    }


</style>



<script src="~/scripts/DataBank/TalentPool.js"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<link href="~/css/kendo/2023.1.117/kendo.bootstrap-main.min.css" rel="stylesheet" />
<script src="~/js/kendo/kendo.all.min.js"></script>
<script src="~/js/kendo/kendo.aspnetmvc.min.js"></script>
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->

        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Talent Pool</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index","Home",new { Area=""})"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Talent Pool
                    </li>
                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per">

                <div class="card-body">

                   



                   
                    
                    <h4 style=" padding-left: 8px;">Talent Pool Search</h4>
                
                    <div class="row">
                        <div class="col-md-6">
                            @await Html.PartialAsync("_ClassificationDetails", Model)


                        </div>
                        <div class="col-xl-6 col-md-6">
                            @*<div id="TalentPoolDetails">
                @await Html.PartialAsync("_TalentPoolDetails", Model)
            </div>*@
                            <div class="row">


                                <div class="col-md-6">
                                    <div class="page_white talent-brder-clr" style=" margin-bottom: 9px;">


                                        @await Html.PartialAsync("_ChartSkill")
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="page_white talent-brder-clr" style=" margin-bottom: 9px;">
                                        @await Html.PartialAsync("_ChartSkillProficency")
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="page_white talent-brder-clr">
                                        @await Html.PartialAsync("_ChartQualification")
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="page_white talent-brder-clr">
                                        @await Html.PartialAsync("_ChartLanguages")
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>



                </div>
            </div>
            <div id="filterSlider" class="hide">
                @*@await Html.PartialAsync("_Filter", Model.Filter)*@
                @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
            </div>

            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
<!--end::Content-->

<div class="modal fade bd-example-modal-lg" id="UHID_Popup" tabindex="-1" aria-labelledby="myLargeModalLabel" style="display: none;" aria-hidden="true">
    <div class="modal-dialog modal-lg" style="max-width:1000px;">
        <div class="modal-content popup">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Employee Details</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body pt-0">


            </div>

            <div class="modal-footer border-0 p-0">
                <div class="row">

                    @*<div class="col-md-12 align-right">
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="UHIDSave()">
                                Save
                            </button>
                        </div>*@

                </div>
            </div>
        </div>
    </div>
</div>

