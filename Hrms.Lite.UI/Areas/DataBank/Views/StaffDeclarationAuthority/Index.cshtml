@model Hrms.Lite.Shared.DataBank.StaffDeclarationAuthority
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/DataBank/staffDeclarationAuthority.js"></script>

<script>
    $(document).ready(function () {
        fillData();
        //setTimeout(fillData,1000)
    });
    </script>


<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">

        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title"> Staff Declaration Authority Settings</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Staff Declaration Authority Settings
                    </li>

                </ul>
            </div>
        </div>

    </div>
</div>



<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">


            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">

                            <div class="tab-items ml-5 pr-0 border-none ">


                            </div>
                            <div class="tab-items select-option">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="Export to Excel"
                                   class="btn btn-excel mr-0" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>

                            </div>
                        </div>



                    </div>
                    @using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "Staff_Declaration_Form" }))
                    {


                        @*<div class="hide">
                            <div class="form-group filter-combobox mr-3" style="width:275px; ">




                            </div>
                        </div>*@
                                @Html.HiddenFor(Model => Model.ActiveCount)
                        <div id="testOT" class="hide">
                            <table id="StaffDeclarationAuthorityTwo">
                                <thead>
                                    <tr class="table-dark">

                                        <th scope="col">EmployeeId</th>
                                        <th scope="col">FullName</th>
                                        <th scope="col">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>

                        <div id="testOT1" class="hide">
                            <table id="StaffDeclarationAuthorityThree">
                                <thead>
                                    <tr class="table-dark">

                                        <th scope="col">EmployeeId</th>
                                        <th scope="col">FullName</th>
                                        <th scope="col">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>
                        </div>
                    }
                    <div id="EmployeeVsGratuityList">
                        @await Html.PartialAsync("~/Areas/DataBank/Views/StaffDeclarationAuthority/_StaffDeclarationAuthorityList.cshtml", Model)
                    </div>



                    <div class="row card-footer-bottom-fixed">
                        <div class="col-md-6">

                        </div>

                        <div class="col-md-6 align-right batchleave">
                            <a type="button" class="btn btn-default mobile-full-width" onclick="onSaveClick()">
                                Save All
                            </a>
                        </div>

                    </div>









                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
                    </div>
                    <div id="AddNewOrEditSlider">


                    </div>

                </div>
            </div>

        </div>

    </div>

</div>



