@model Hrms.Lite.Shared.DataBank.DTO.Enrollment

    <div class="row Compensation">
        <div class="col-md-6">
            <div class="ihits-table table-border vertical-scroll-100 table-head-small hover-color odd-even compensationBenefits">
                <table id="Allowance">
                    <thead>
                        <tr class="table-dark">
                            <th scope="col">Allowance</th>
                            <th scope="col">Type</th>
                            <th scope="col">Amount</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model !=null && Model.PreEnrollment.Compensation.FixedAllowance != null)
                        {
                            @for (int i = 0; i < Model.PreEnrollment.Compensation.FixedAllowance.Count; i++)
                            {

                                <tr>
                                    <td data-label="Allowance">
                                        @Html.HiddenFor(m => m.PreEnrollment.Compensation.FixedAllowance[i].Code)
                                        @Html.HiddenFor(m => m.PreEnrollment.Compensation.FixedAllowance[i].Name)
                                        @Html.DisplayFor(m => m.PreEnrollment.Compensation.FixedAllowance[i].Name)
                                    </td>
                                    <td data-label="Type">
                                        @Html.TextBoxFor(m => m.PreEnrollment.Compensation.FixedAllowance[i].AllowanceType, new { @class = "form-control AllowanceType", @readonly = "true" })

                                    </td>
                                    <td data-label="Amount">
                                        @Html.TextBoxFor(m => m.PreEnrollment.Compensation.FixedAllowance[i].Amount, new { @class = "form-control AllowanceAmount", @style = "text-align:right", onchange = "CTCCalculation()", maxlength = 8, onkeypress = "return onlyNumberKey(event)", @oninput = "process(this)" })
                                    </td>

                                </tr>

                            }
                        }

                        </tbody>


                    @*<tr>
                            <td data-label="Allowance">Basic</td>
                            <td data-label="Type">Fixed</td>
                            <td data-label="Amount">7500</td>

                        </tr>
                        <tr>
