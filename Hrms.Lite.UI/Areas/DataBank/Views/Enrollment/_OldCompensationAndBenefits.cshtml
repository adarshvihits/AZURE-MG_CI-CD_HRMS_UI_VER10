                            <td data-label="Allowance">Esi management</td>
                            <td data-label="Type">CTC Component</td>
                            <td data-label="Amount">3000</td>

                        </tr>*@




                </table>
            </div>
            <div class="row">
                <div class="col-md-10">
                    <div class="ihits-table table-border table-head-small hover-color odd-even mt-mobile-0px mt-4  gross-salary">
                        <table>

                            <tbody>
                                <tr>
                                    <td style="padding: 10px; width: 50%;">
                                        <b>Gross Salary</b>
                                        @Html.TextBoxFor(m => m.PreEnrollment.Compensation.GrossSalary, new { @class = "form-control form-control-sm", @readonly = "true" })
                                    </td>
                                    <td style="padding: 10px;">
                                        <b>CTC</b>
                                        @Html.TextBoxFor(m => m.PreEnrollment.Compensation.CTC, new { @class = "form-control form-control-sm", @readonly = "true" })

                                    </td>

                                </tr>


                            </tbody>

                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="ihits-table table-border table-head-small vertical-scroll-100 hover-color odd-even compensationBenefits ">
                <table id="Deduction">
                    <thead>
                        <tr class="table-dark">
                            <th scope="col">Deduction</th>
                            <th scope="col" style="text-align: right;">
                                Amount
                            </th>

                        </tr>
                    </thead>
                    <tbody>
                        @*<tr>
                                <td data-label="Deduction">Canteen</td>
                                <td data-label="Amount" align="right">300</td>

                            </tr>
                            <tr>
                                <td data-label="Deduction">Transport</td>
                                <td data-label="Amount" align="right">100</td>

                            </tr>*@
                @if (Model != null && Model.PreEnrollment.Compensation.FixedDeduction != null)
                {
                        @for (int i = 0; i < Model.PreEnrollment.Compensation.FixedDeduction.Count; i++)
                        {

                            <tr>
                                <td data-label="Allowance">
                                    @Html.HiddenFor(m => m.PreEnrollment.Compensation.FixedDeduction[i].Code)
                                    @Html.HiddenFor(m => m.PreEnrollment.Compensation.FixedDeduction[i].Name)
                                    @Html.DisplayFor(m => m.PreEnrollment.Compensation.FixedDeduction[i].Name)
                                </td>

                                <td data-label="Amount">
                                    @Html.TextBoxFor(m => m.PreEnrollment.Compensation.FixedDeduction[i].Amount, new { @class = "form-control", @style = "text-align:right", maxlength = 8, onkeypress = "return onlyNumberKey(event)",@oninput = "process(this)" })
                                </td>

                            </tr>

                        }
                }
                    </tbody>






                </table>
            </div>
            <div class="row justify-content-end">

                <div class="col-md-6">
                    <div class="form-group mb-0 mt-4">
                        <div class="checkbox-inline">
                            <label class="mr-2">Statutory Deductions</label>
                            <label class="checkbox">
                                @Html.CheckBoxFor(m => m.PreEnrollment.Compensation.PF)
                                @*<input type="checkbox" checked="checked"
                                    name="Checkboxes3">*@
                                <span></span>PF
                            </label>
                            <label class="checkbox">
                                @Html.CheckBoxFor(m => m.PreEnrollment.Compensation.ESI)
                                @*<input type="checkbox" name="Checkboxes3">*@
                                <span></span>ESI
                            </label>

                        </div>

                    </div>
                </div>


            </div>
        </div>
    </div>

