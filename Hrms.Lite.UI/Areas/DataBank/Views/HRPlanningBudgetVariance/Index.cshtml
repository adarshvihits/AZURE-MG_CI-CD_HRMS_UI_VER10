@model Hrms.Lite.Shared.DataBank.DTO.HRPlanningBudget
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/DataBank/hrPlanningBudget.js"></script>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Budget Variance & MRF
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index","Home",new { Area =""})"><i class="icon-nm fas fa-home"></i></a>
                    </li>


                    <li class="breadcrumb-item text-muted">
                        Budget Variance & MRF
                    </li>
                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->


<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body">

                            <div class="row tab-style-button">
                                <div class="tab-button-wrap">
                                    <div class="tab-button-wrap align-items-center ">
                                        <div class="tab-items">
                                            <label>
                                                Planning Name
                                            </label>
                                            <div class="form-group filter-combobox mt-0">
                                                @Html.DropDownListFor(m => m.HRPlanning.Code, (SelectList)ViewBag.HrPlan, "--Select--", new
                                                {
                                                    @class = "form-control form-control-sm",
                                                    style = "width:210px",
                                               @onchange = "GetVarianceList();validate(this,'HRPlanCode')"
                                           })
                                            </div>
                                            <span id="HRPlanCode"></span>
                                        </div>



                                        <div class="tab-items">
                                            <label>
                                                Designation


                                            </label>
                                            <div class="form-group filter-combobox mt-0">
                                                @Html.DropDownListFor(m => m.Designation.Code, (SelectList)ViewBag.Designation, "--Select--", new
                                                {
                                                    @class = "form-control form-control-sm",
                                                    style = "width:210px",
                                           @onchange = "GetVarianceList();validate(this,'DsgCode')"
                                           })
                                            </div>
                                            <span id="DsgCode"></span>
                                        </div>

                                        <div class="tab-items select-option d-flex">
                                            <div class="tab-items pr-20">
                                                <div>
                                                    <label></label>
                                                    <div class="radio-inline">
                                                        <label class="radio radio-outline radio-success">
                                                            @Html.HiddenFor(m => m.Type.Code)
                                                            @Html.RadioButtonFor(m => m.Type.Code, "1", new { @onclick = "onTypeChange(this)" })
                                                            <span></span>Location Wise
                                                        </label>
                                                        <label class="radio radio-outline radio-success mr-5">
                                                            @Html.RadioButtonFor(m => m.Type.Code, "0", new { @onclick = "onTypeChange(this)" })
                                                            <span></span>Region Wise
                                                        </label>


                                                    </div>
                                                </div>
                                                <!-- <label></label> -->

                                            </div>
                                            <div class="sraech-slider pt-2">
                                                <div class="search-slider-inner">
                                                    <i class="fa fa-search"></i>
                                                </div>
                                                <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                                       placeholder="ID/Name">
                                            </div>
                                            @*<div data-bs-toggle="tooltip" data-bs-original-title="Filter"
                                                     class="filter-button">
                                                    <i class="fas fa-filter"></i>
                                                </div>*@

                                        </div>


                                    </div>
                                </div>
                            </div>


                            @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "varList" }))
                            {
                                <div id="varianceList">
                                    @await Html.PartialAsync("_List")
                                </div>
                            }
                            <!-- <end table></end> -->

                        </div>
                        <div class="row card-footer-bottom-fixed">

                            <div class="col-md-12 align-right">
                                <a type="button" class="btn btn-default  mobile-full-width mrfVarianceBtn" onclick="CreateMRFAgainstVariance()">
                                    Create MRF Against Variance

                                </a>
                            </div>

                        </div>
                    </div>

                </div>
            </div>




            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>
<!--end::Content-->
