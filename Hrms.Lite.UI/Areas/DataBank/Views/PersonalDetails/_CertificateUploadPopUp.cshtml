@model Hrms.Lite.Shared.DataBank.DTO.PersonalDetails






<div id="UploadedDocList">
    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table  vertical-scroll-200   Uploaded-Documents-Certifictions-list ">

        <table class="" id="tblDocument">
            <thead>
                <tr class="table-light">
                    <th scope="col">Sl.No.</th>
                    <th scope="col">Document Name</th>
                    <th scope="col">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.CertificationDocList != null && Model.CertificationDocList.Count > 0)
                {

                    for (int i = 0; i < Model.CertificationDocList.Count; i++)
                    {
                        <tr>

                            <td data-label="slno">


                                @(i+1)
                            </td>

                            <td data-label="Name">
                                @Html.TextBoxFor(m => m.CertificationDocList[i].DocName, new { @class = "form-control", @readonly = "true" })

                            </td>

                            <td data-label="Edit" align="center">
                                <div class="small-btn-group">

                                    <a id="addEducationDetails" type="button"
                                       class="btn btn-icon btn-secondar" data-bs-toggle="tooltip" data-placement="top" title="View" onclick="ViewDocument('@Model.CertificationDocList[i].CertificateDocCode','Certi')">
                                        <i class="icon-xl far fa-eye black"></i>
                                    </a>
                                 

                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" align="center"><em>No table data</em></td>
                    </tr>
                }




            </tbody>
        </table>
    </div>



</div>
