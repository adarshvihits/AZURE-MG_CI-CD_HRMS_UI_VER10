@model Hrms.Lite.Shared.DataBank.DTO.PersonalDetails
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/scripts/DataBank/PersonalDetails/personalDetails.js" asp-append-version="true"></script>
<script src="~/scripts/DataBank/PersonalDetails/personalDetailsGrid.js" asp-append-version="true"></script>
<script src="~/js/jquery.min.js"></script>



<script>
    $(document).ready(function () {
        debugger
         if ('@ViewBag.Message' != "") {
            swal.fire('@ViewBag.Message');
        }

        $('.emp_HeaderPic').css('background-image', `url('/AccessFile/GetEmpThumbnail?EmployeeGI=${'@Model.EmployeeGI'}')`);



    });


</script>






<style>
    .image-input.image-input-circle [data-action="change"] {
        right: -15px;
        top: -6px;
        z-index: 9;
    }
</style>
<div id="kt_header" class="header header-fixed">
    @Html.HiddenFor(m => m.EmployeeGI)
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <!--begin::Header Menu-->
                <h3 class="main-title">Personal Profile</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot p-0 mt-1 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a href="@Url.Action("Index", "PersonalDetails", new { Area = "DataBank" })" class="">Personal Profile List</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Personal Profile
                    </li>
                </ul>
                <!--end::Header Menu-->
            </div>
        </div>
        <!--end::Header Menu Wrapper-->

    </div>
    <!--end::Container-->
</div>


<div class="content d-flex flex-column flex-column-fluid " id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per">

                <div class="card-body">
                    <!--begin: Search Form-->
                    <div class="profile-header compnay-bg">
                        <div class="row">

                            <div class="col-md-12 pl-10">
                                <div class="row">

                                    @using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "per_profilephoto", enctype = "multipart/form-data" }))
                                    {

                                        <div class="image-input image-input-outline image-input-circle  float-right mr-5 emp_HeaderPic" id="kt_image_4">
                                            <div class="image-input-wrapper">
                                            </div>



                                            <label class="btn btn-icon btn-circle btn-white btn-hover-text-primary btn-shadow" data-action="change" data-bs-toggle="tooltip" data-bs-original-title="Click to upload photo" onclick="$('#enrollment_PreEnrollment_BasicInfo_File_FileData').trigger('click')">
                                                <i class="fa fa-pen icon-sm text-muted"></i>
                                            </label>
                                        </div>
                                        @Html.HiddenFor(model => model.enrollment.PreEnrollment.BasicInfo.File.FileData, new { type = "file", @name = "profile_avatar", @onchange = "validateProfilePhoto()", @style = "display:none", accept = ".jpg, .jpeg" })
                                    }

                                    <div class="flex-grow-1">
                                        <!--begin::Title-->
                                        <div class="d-flex justify-content-between flex-wrap mt-2 mb-3">
                                            <div class="d-flex mr-3 header-profile-name">

                                                <a href="#" class="">@Model.enrollment.PreEnrollment.BasicInfo.FullName</a>
                                            </div>

                                        </div>

                                        <!--end::Title-->
                                        <!--begin::Content-->
                                        <div class="d-flex flex-wrap justify-content-between">
                                            <div class="d-flex flex-column flex-grow-1 pr-8">
                                                <div class="d-flex flex-wrap mb-1">
                                                    <a data-bs-toggle="tooltip" data-bs-original-title="Designation" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                        <i class="fas fa-briefcase icon-nm mr-2"></i>@Model.enrollment.PreEnrollment.JobDetails.Designation.Name
                                                    </a>
                                                    <a data-bs-toggle="tooltip" data-bs-original-title="Department" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                        <i class="fas  fa-building icon-nm mr-2"></i>@Model.enrollment.PreEnrollment.JobDetails.Department.Name
                                                    </a>
                                                    <a data-bs-toggle="tooltip" data-bs-original-title="Location" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                        <i class="fas fa-map-marker-alt icon-nm mr-2"></i>@Model.enrollment.PreEnrollment.JobDetails.Location.Name
                                                    </a>
                                                    <a data-bs-toggle="tooltip" data-bs-original-title="Category" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                        <i class="fas fa-network-wired icon-nm mr-2"></i>@Model.enrollment.PreEnrollment.JobDetails.Category.Name
                                                    </a>
                                                    <a data-bs-toggle="tooltip" data-bs-original-title="Reporting Manager" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                        <i class="fas fa-user-tie icon-nm mr-2"></i>
                                                        @Model.enrollment.EmployeeSettings.ReportingManager.Name
                                                    </a>


                                                </div>



                                            </div>



                                        </div>

                                        <!--end::Content-->
                                    </div>

                                </div>
                            </div>
                        </div>



                        <div class="profile-header-overflow"></div>
                    </div>
                    <!-- Table Section -->

                    <div class="tab-outer accordion-only pt-7">
                        <ul class="ulList">
                            <div class="TabMoving"></div>
                            <li class="tabOne clickOnTab active">Address</li>
                            <div id="tabOne" class="tab-content active">
                                @await Html.PartialAsync("_Address", Model)
                            </div>

                            <!-- Contact Details Info Tab -->
                            <div class="TabMoving"></div>
                            <li class="tabContactDetails clickOnTab">Contact Details</li>
                            <div id="tabContactDetails" class="tab-content">

                                @await Html.PartialAsync("_ContactDetails", Model)
                            </div>
                            <!-- Contact Details Info Tab -->
                            <!-- Personal Info Tab -->
                            <div class="TabMoving"></div>
                            <li class="tabTwo clickOnTab">Personal Info</li>
                            <div id="tabTwo" class="tab-content">
                                @await Html.PartialAsync("_PersonalInfo", Model)
                            </div>
                            <!-- Personal Info Tab -->
                            <!-- Family Details Tab -->
                            <div class="TabMoving"></div>
                            <li class="tabThree clickOnTab">Family Details</li>
                            <div id="tabThree" class="tab-content">
                                @await Html.PartialAsync("_FamilyDetails", Model)
                            </div>
                            <!-- Family Details Tab -->
                            <!-- Education Details Tab -->
                            <div class="TabMoving"></div>
                            <li class="tabFive clickOnTab">Education</li>
                            <div id="tabFive" class="tab-content">
                                @await Html.PartialAsync("_Education", Model)
                            </div>
                            <!-- Education Details Tab -->
                            <!-- Skills Tab -->
                            <div class="TabMoving"></div>
                            <li class="tabSix clickOnTab">Skills</li>
                            <div id="tabSix" class="tab-content">
                                @await Html.PartialAsync("_Skills", Model)
                            </div>
                            <!-- Skills Tab -->
                            <!-- Certifications Tab -->
                            <div class="TabMoving"></div>
                            <li class="tabSeven clickOnTab">Certifications</li>
                            <div id="tabSeven" class="tab-content">
                                @await Html.PartialAsync("_Certifications", Model)
                            </div>
                            <!-- Certifications Tab -->
                            <!-- Previous Employment Tab -->
                            <div class="TabMoving"></div>
                            <li class="tabEight clickOnTab">Previous Employment</li>
                            <div id="tabEight" class="tab-content">
                                <div class="t4">
                                    @await Html.PartialAsync("_PreviousEmployment", Model)
                                </div>
                            </div>

                            <!-- Previous Employment Tab -->
                            <!-- Employee Vs Nominee Tab -->
                            <div class="TabMoving"></div>
                            <li class="tabNine clickOnTab">Employee Vs Nominee</li>
                            <div id="tabNine" class="tab-content">
                                <div class="t4">
                                    @await Html.PartialAsync("_EmployeeVsNominee", Model)
                                </div>
                            </div>

                            <!-- Employee Vs Nominee Tab -->
                        </ul>
                    </div>

                    <!-- Table Setion End -->

                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>
