@model Hrms.Lite.Shared.DataBank.DTO.PersonalDetails
<script src="~/js/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        //fillPunchingMethodDropdown();
        $('#PersonalInfo_Hobbies').multiselect({
            includeSelectAllOption: true,
            nonSelectedText: '--Select Hobbies--',
        });

        $('#PersonalInfo_Language').multiselect({
            includeSelectAllOption: true,
            nonSelectedText: '--Select Languages--',
        });

        if ($('#PersonalInfo_MaritalStatus_Code').val() != 2) {
            $('#weddingDte').addClass('hide');
        }
    });
</script>


@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "Personalinfo" }))
{
<div class="row">
    @{
        Model.TabIndex = "Personalinfo";
    }
    @Html.HiddenFor(m => m.TabIndex)
    @Html.HiddenFor(m => m.EmployeeGI)
    <div class="col-md-3">
        <div class="form-group">
            <label>Blood Group</label><span class="Mandatory">*</span>
            @Html.DropDownListFor(m => m.PersonalInfo.BloodGroup.Code, (SelectList)ViewBag.Blo, "--Select Blood Group--", new { @class = "form-control form-control-sm", @onchange = "onCountryChangepd(this,'bloodgroup')" })
            <span id="bloodgroup"></span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label>Marital Status</label><span class="Mandatory">*</span>
            @Html.DropDownListFor(m => m.PersonalInfo.MaritalStatus.Code, (SelectList)ViewBag.Mar, "--Select Marital Status--", new { @class = "form-control form-control-sm", @onchange = "DOWStatus(this,'maritalstatus')" })
            <span id="maritalstatus"></span>
        </div>
    </div>
    <div id="weddingDte" class="col-md-3">
        <div class="form-group">
            <label>Date of Wedding</label>
            <div class="input-group date">
                @Html.TextBoxFor(m => m.PersonalInfo.wedding, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_8", placeholder = "DOW", @onchange = "validateDOW(this,'dow')", @readonly = true })
                <div class="input-group-append">
                    <span class="input-group-text">
                        <i class="la la-calendar"></i>
                    </span>
                </div>
            </div>
            <span id="dow"></span>
        </div>
    </div>




    <div class="col-md-3">
        <div class="form-group">
            <label>Religious View</label><span class="Mandatory">*</span>
            @Html.DropDownListFor(m => m.PersonalInfo.ReligiousView.Code, (SelectList)ViewBag.Rel, "--Select Religious View--", new { @class = "form-control form-control-sm" })
            <span id="religiousview"></span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label>Caste</label><span class="Mandatory">*</span>
            @Html.TextBoxFor(m => m.PersonalInfo.Caste,  new { @class = "form-control form-control-sm", placeholder = "Caste" })
            <span id="castetext"></span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label>Category</label><span class="Mandatory">*</span>
            @Html.DropDownListFor(m => m.PersonalInfo.Category.Code, (SelectList)ViewBag.cat, "--Select Category--", new { @class = "form-control form-control-sm" })
            <span id="cate"></span>
        </div>
    </div>
</div>

    <div class="row">
        <div class="col-md-6">
            <div class="ihits-table table-border  talent-pool-entry-four vertical-scroll-150">
                <table>
                    <thead>
                        <tr class="table-light">
                            <th scope="col">Languages</th>
                            <th scope="col">Read</th>
                            <th scope="col">Write</th>
                            <th scope="col">Speak</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PersonalInfo.Languagess != null && Model.PersonalInfo.Languagess.Count > 0)
                        {

                            for (int i = 0; i < Model.PersonalInfo.Languagess.Count; i++)
                            {
                                <tr>
                                    <td data-label="ID">
                                        @Html.HiddenFor(m => m.PersonalInfo.Languagess[i].NAME)
                                        @Html.HiddenFor(m => m.PersonalInfo.Languagess[i].CODE)
                                        @Model.PersonalInfo.Languagess[i].NAME
                                    </td>
                                    <td data-label="Employee Name">
                                        <div class="checkbox-inline">
                                            <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                                @Html.CheckBoxFor(m => m.PersonalInfo.Languagess[i].Read)
                                                <span></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td data-label="ID">
                                        <div class="checkbox-inline">
                                            <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                                @Html.CheckBoxFor(m => m.PersonalInfo.Languagess[i].Write)
                                                <span></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td data-label="ID">
                                        <div class="checkbox-inline">
                                            <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                                @Html.CheckBoxFor(m => m.PersonalInfo.Languagess[i].Speak)
                                                <span></span>
                                            </label>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }


                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-md-6">
            <div class="ihits-table table-border  talent-pool-entry-four vertical-scroll-150">
                <table>
                    <thead>
                        <tr class="table-light">
                            <th scope="col">Hobbies</th>
                            <th scope="col">Yes/No</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.PersonalInfo.Hobby != null && Model.PersonalInfo.Hobby.Count > 0)
                        {

                            for (int i = 0; i < Model.PersonalInfo.Hobby.Count; i++)
                            {
                                <tr>
                                    <td data-label="ID">
                                        @Html.HiddenFor(m => m.PersonalInfo.Hobby[i].NAME)
                                        @Html.HiddenFor(m => m.PersonalInfo.Hobby[i].CODE)
                                        @Model.PersonalInfo.Hobby[i].NAME
                                    </td>
                                    <td data-label="Employee Name">
                                        <div class="checkbox-inline">
                                            <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                                @Html.CheckBoxFor(m => m.PersonalInfo.Hobby[i].APPLICABILITY)
                                                <span></span>
                                            </label>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }


                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="row">
        
        @*<div class="col-md-6">
            <div class="form-group">
                <label>Hobbies</label>
                @Html.ListBoxFor(m => m.PersonalInfo.Hobbies, (SelectList)ViewBag.Hob, new { @class = "form-control-multiselect form-control-sm JType", @multiple = "multiple" })
                <span id="punchingmethod"></span>
            </div>
        </div>*@
    </div>






    <div class="row">
        <div id="perInfoFooter" class="col-md-6">
            @if (Model.PersonalInfoApprovalPending == false)
            {
              
                <label  class="new_approval_pend_btn">
                    Approval Pending
                </label>
            }


        </div>
        <div class="col-md-6">
            <button type="button" onclick="validateAllPersonalInfo()"
                    class="btn btn-default float-right">
                Save
            </button>
        </div>
    </div>
}
