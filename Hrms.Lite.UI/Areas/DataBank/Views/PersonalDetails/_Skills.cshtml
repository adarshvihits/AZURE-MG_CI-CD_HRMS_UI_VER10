@model Hrms.Lite.Shared.DataBank.DTO.PersonalDetails
<div class="row">
    <div class="col-md-12">
        <div class="ihits-table table-border mobile-responsive-table personal-details-education-section mb-2">
            <table>
                <thead>
                    <tr class="table-light">
                        <th scope="col">Skill</th>
                        <th scope="col">Skill Type</th>
                        <th scope="col">Skill Proficiency</th>
                        <th scope="col">Edit</th>
                    </tr>
                </thead>
                <tbody>
                    @Html.HiddenFor(m => m.EmployeeGI)

                    @for (int i = 0; i < Model.Skills.Count; i++)
                    {
                        @if (Model.Skills[i].SkillLogGI != Guid.Parse("00000000-0000-0000-0000-000000000000"))
                        {
                            <tr id="row_OI_@i">
                                <td data-label="Qualification Type">
                                    @Html.HiddenFor(m => m.Skills[i].SkillLogGI)
                                    @Html.DisplayFor(m => m.Skills[i].Skill.Name)

                                </td>
                                <td data-label="Qualofication">

                                    @Html.DisplayFor(m => m.Skills[i].SkillType.Name)
                                </td>
                                <td data-label="Field of Study">

                                    @Html.DisplayFor(m => m.Skills[i].SkillProficiency.Name)
                                </td>
                                <td data-label="Edit">
                                    <div class="small-btn-group">
                                        <a id="addEducationDetails" type="button"
                                                class="btn btn-icon btn-edit icon-only " data-bs-toggle="tooltip" data-placement="top" title="Edit" onclick="SkillAddOrEditClick('@Model.Skills[i].SkillLogGI')">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>

                                        <a type="button"
                                                class="btn btn-icon btn-delete icon-only" data-bs-toggle="tooltip" data-placement="top" title="Delete" onclick="SkillDeleteClick('@Model.Skills[i].SkillLogGI')">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td>No table data</td>
                            </tr>
                        }

                    }







                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        @if (Model.SkillsApprovalPending == false)
        {
        <label class="new_approval_pend_btn">
            Approval Pending
        </label>
        }


    </div>
    <div class="col-md-6">
        <button id="skillSliderOpen" type="button" class="btn btn-default float-right" onclick="SkillAddOrEditClick()">
            <i class="icon-nm fas fa-plus"></i>Add
            New
        </button>
        <div id="SkillsDiv" class="hide">

            @await Html.PartialAsync("_SkillSave")
        </div>
    </div>
</div>