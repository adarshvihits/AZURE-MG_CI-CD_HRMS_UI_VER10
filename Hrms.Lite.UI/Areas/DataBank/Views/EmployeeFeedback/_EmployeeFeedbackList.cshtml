@model Hrms.Lite.Shared.DataBank.EmployeeFeedback


<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>

<script>
    $(document).ready(function () {
        debugger;

        

    });
</script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table ">
    @Html.HiddenFor(m => m.EmployeeFeedbackList.Count)
    <table id="ResignationDeleteTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">Subject</th>
                <th scope="col">Action</th>

            </tr>
        </thead>
        <tbody>
            @if (Model.EmployeeFeedbackList != null && Model.EmployeeFeedbackList.Count > 0)
            {
                for (int i = 0; i < Model.EmployeeFeedbackList.Count; i++)
                {
                    @Html.HiddenFor(m=>m.EmployeeFeedbackList[i].FeedbackCode)
                    @Html.HiddenFor(m=>m.EmployeeFeedbackList[i].EmployeeGI)
                    <tr>
                        <td data-label="ID">@Model.EmployeeFeedbackList[i].EmployeeID</td>
                        <td data-label="Employee Name">
                            @Model.EmployeeFeedbackList[i].EmployeeName
                        </td>
                        <td data-label="Designation">@Model.EmployeeFeedbackList[i].Designation.Name</td>
                        <td data-label="Department">@Model.EmployeeFeedbackList[i].Department.Name </td>
                        <td data-label="Location">@Model.EmployeeFeedbackList[i].Location.Name</td>       
                        <td data-label="Stage">@Model.EmployeeFeedbackList[i].Subject</td>


                        <td data-label="Action">
                            <a data-bs-toggle="tooltip" title="Edit"
                               id="categoryedit"
                               class="btn btn-icon btn-edit icon-only" onclick="onEditClick('@Model.EmployeeFeedbackList[i].EmployeeGI','@Model.EmployeeFeedbackList[i].FeedbackCode')">
                                <i class="icon-xl fas fa-pencil-alt"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                @*<tr><td colspan="11"> No data found</td></tr>*@
            }




        </tbody>
    </table>
</div>
