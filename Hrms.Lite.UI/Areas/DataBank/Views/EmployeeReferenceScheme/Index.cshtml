@model Hrms.Lite.Shared.DataBank.EmployeeReferenceScheme
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/DataBank/employeeReferenceScheme.js"></script>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Employee Referral Scheme</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Employee Referral Scheme
                    </li>

                </ul>
            </div>
        </div>

        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <!--begin: Search Form-->
                    <!-- Table Section -->
                    @using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "EmployeeReferenceSchemeSave" }))
                    {
                        <div id="EmployeeReferenceSchemeList">
                            @await Html.PartialAsync("_EmployeeReferenceScheme", Model)
                        </div>
                        <!-- Table Setion End -->



                    }
                    <div id="AddNewOrEditSlider">


                    </div>
                    <div id="validationDiv"></div>
                    <div class="row card-footer-bottom-fixed">

                        <div class="col-md-12 align-right">

                            <button id="addattendancerequest" type="button" onclick="AddNewOrEditClick()"
                                    class="btn btn-default float-left mobile-full-width ">
                                Add New Role 
                            </button>




                        </div>

                    </div>


                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
<!--end::Content-->
