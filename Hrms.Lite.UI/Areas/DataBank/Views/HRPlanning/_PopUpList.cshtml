
@model Hrms.Lite.Shared.DataBank.DTO.HRPlanning


<div style="padding:10px;" class="ihits-table table-border hover-color odd-even mobile-responsive-table act-table vertical-scroll-250">

    <table>
        <thead>
            <tr class="table-light">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">LWD</th>

            </tr>
        </thead>
        <tbody>
            @if (Model.EmployeeDtList!= null && Model.EmployeeDtList.Count > 0)
            {
                for (int i = 0; i < Model.EmployeeDtList.Count; i++)
                {
                    <tr>
                        <td data-label="ID">
                            @Model.EmployeeDtList[i].EmployeeID
                        </td>
                        <td data-label="Employee Name">
                            @Model.EmployeeDtList[i].FullName

                        </td>
                        <td data-label="Designation">@Model.EmployeeDtList[i].Designation.Name</td>
                        <td data-label="Department">
                            @Model.EmployeeDtList[i].Department.Name
                        </td>
                        <td data-label="Location">@Model.EmployeeDtList[i].Location.Name</td>
                        <td data-label="Last Working Date">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.EmployeeDtList[i].LWD))</td>



                    </tr>


                }
            }
        </tbody>


    </table>
</div>