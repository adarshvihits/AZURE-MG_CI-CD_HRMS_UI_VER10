@model Hrms.Lite.Shared.DataBank.DTO.HRPlanning
    <script>
        $(document).ready(function () {
            debugger;
            //$('#Name').focus();
            moveCursorToEnd('HRPlanningSettingsList_0__ManPower');
        });
    </script>
    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", id = "Modify-HRPlanning" }))
    {
        <div id="hrPlanningEdit" class="slider-forms slider-forms-open edit">
            <div class="slider-inner-style">
                <div class="slider-form-close" onclick="CloseSlider('edit')"><i class="ki ki-close icon-xs text-muted"></i></div>
                <h4>Resource Planning</h4>
                <div class="row mb-4">
                    @Html.HiddenFor(m => m.HRPlanningSettingsGI)
                    @Html.HiddenFor(m => m.HRPlanningSettingsId)
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="view-title">Planning Name</label>
                            @Html.HiddenFor(m => m.HRPlanningName.Code)

                            <div class="view-details">@Html.DisplayFor(mbox => Model.HRPlanningName.Name)</div>
                        </div>

                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="view-title">@Html.DisplayFor(m => m.Combination1Label)</label>
                            @Html.HiddenFor(m => m.Combination1.Code)
                            <div class="view-details">@Html.DisplayFor(m => m.Combination1.Name)</div>
                        </div>

                    </div>


                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="view-title">Planning Period From</label>
                            <div class="view-details">
                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.FromDateAddNew))
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="view-title">Planning Period To</label>
                            <div class="view-details"> @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.ToDateAddNew))</div>
                        </div>
                    </div>


                </div>
                <div class="ihits-table table-border mobile-responsive-table hr-planning-list">
                    <table>
                        <thead>
                            <tr class="table-light">
                                <th scope="col">@Html.DisplayFor(m => m.Combination2Label)</th>
                                <th scope="col">Manpower</th>
                                <th scope="col">Budget</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.HRPlanningSettingsList != null && Model.HRPlanningSettingsList.Count > 0)
                            {
                                for (int i = 0; i < Model.HRPlanningSettingsList.Count; i++)
                                {
                                    <tr>
                                        @Html.HiddenFor(m => m.HRPlanningSettingsList[i].Combination2TrnCode)
                                        <td data-label="Location">@Html.DisplayFor(m => m.HRPlanningSettingsList[i].Combination2TrnName)</td>
                                        <td data-label="Manpower">  @Html.TextBoxFor(m => m.HRPlanningSettingsList[i].ManPower, new { @placeholder = "Manpower", @maxlength = "6", @class = "form-control form-control-sm", @onkeypress = "return onlyNumberKey(event)" })</td>
                                        <td data-label="Budget">  @Html.TextBoxFor(m => m.HRPlanningSettingsList[i].Budget, new { @placeholder = "Budget", @maxlength = "8",@class = "form-control form-control-sm", @onkeypress = "return onlyNumberKey(event)" })</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12">
                        <button type="button" class="btn btn-default float-right mobile-full-width" onclick="ModifyHRPlanning()">
                            Modify
                        </button>
                    </div>

                </div>


            </div>
        </div>

    }