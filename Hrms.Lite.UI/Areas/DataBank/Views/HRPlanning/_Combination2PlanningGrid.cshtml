@model Hrms.Lite.Shared.DataBank.DTO.HRPlanning

<div class="ihits-table table-border mobile-responsive-table hr-planning-list vertical-scroll-200">
    <table>
        <thead>
            <tr class="table-light">              
                <th scope="col" class="create_Combination2Label">@Html.DisplayFor(m => m.Combination2Label)</th>
                <th scope="col">Manpower</th>
                <th scope="col">Budget</th>
            </tr>
        </thead>
        <tbody>
          
            @if (Model.HRPlanningSettingsList != null && Model.HRPlanningSettingsList.Count > 0)
            {
                for (int i = 0; i < Model.HRPlanningSettingsList.Count; i++)
                {
            <tr>
             
     
                <td data-label="Combination2">@Model.HRPlanningSettingsList[i].Combination2TrnName</td>
                <td data-label="Manpower">
                    @Html.HiddenFor(m => Model.HRPlanningSettingsList[i].Combination2TrnCode)
                    @Html.TextBoxFor(m => m.HRPlanningSettingsList[i].ManPower, new { @placeholder = "Manpower", @maxlength = "6", @class = "form-control form-control-sm plan_ifEmpty", @onkeypress = "return onlyNumberKey(event)" })
                </td>
                <td data-label="Budget">
                    @Html.TextBoxFor(m => m.HRPlanningSettingsList[i].Budget, new { @placeholder = "Budget", @maxlength = "8", @class = "form-control form-control-sm plan_ifEmpty", @onkeypress = "return onlyNumberKey(event)" })
                </td>
            </tr>

                }
            }
        </tbody>
    </table>
</div>
