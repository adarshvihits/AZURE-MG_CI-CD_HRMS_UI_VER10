                                        <i class="icon-xl far fa-list-alt"></i>
                                    </a>


                                    <a onclick="onGraphClick()" data-bs-toggle="tooltip" title="" class="btn btn-normal float-left mr-4" data-bs-original-title="Graph View">
                                        <i class="icon-xl fas fa-chart-line"></i>
                                    </a>
                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>

                                    <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>
                                    @*<a href="@Url.Action("Index", "HRPlanning", new { Area = "Databank" })" data-bs-toggle="tooltip" title="" class="btn btn-normal float-left active" data-bs-original-title="Grid View">
            <i class="icon-xl far fa-list-alt"></i>
        </a>*@
