                                </div>
                            </div>

                        </div>
                    </div>
                    <!-- --------------------------------------------------------------------- Partial view-------------------------------------------------------------------------------------------------- -->
                    <div id="create">

                    </div>
                    <div id="edit">

                    </div>

                    <div id="delete">

                    </div>

                    <div id="hRplanningMainGrid">
                        @await Html.PartialAsync("_HRPlanningList", Model)
                    </div>

                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
                    </div>

                    <!-- ----------------------------------------------------------------------------------------------------------------------------------------------------------------------- -->
                    <div class="row card-footer-bottom-fixed align-right">

                        <div class="col-md-12">

                            <a id="addPlanning" type="button"
