                                    <label>Planning Name</label>

                                    @Html.DropDownListFor(m => m.HRPlanningNameMain.Code, (SelectList)ViewBag.PlanningName, "--Select--", new { @class = "form-control form-control-sm grid_plan", @style = "width: 140px;", @onchange = "onHRPlanningNameChange(this,'index')" })



                                </div>
                            </div>
                            @*<div class="tab-items border-none d-flex align-items-center">

                    <div class="row-outer">
                        <label class="view-title">Planning Period</label>
                        <div class="view-details">

                            <span class="planningPeriod">@Model.PlanningPeriod</span>
                        </div>
                    </div>
                </div>*@
                            @*<div class="tab-items border-none">

                                <div class="form-group">
                                    <label>
                                        <span class="">Region</span>
                                    </label>
                                    @Html.DropDownListFor(m => m.Region.Code, (SelectList)ViewBag.region, "All", new { @class = "form-control form-control-sm", @style = "width: 140px;" })

                                </div>
                            </div>*@
                            @*<div class="tab-items border-none">

                                <div class="form-group">
                                    <label>
                                        <span class="">State</span>
                                    </label>
                                    @Html.DropDownListFor(m => m.State.Code, (SelectList)ViewBag.state, "All", new { @class = "form-control form-control-sm", @style = "width: 140px;" })

                                </div>
                            </div>*@

                            <div class="tab-items border-none">

                                <div class="form-group filter-combobox">
                                    <label>
                                        <span class="combination1Name">@Model.Combination1Label</span>
                                    </label>
                                    @Html.DropDownListFor(m => m.Combination1Main.Code, (SelectList)ViewBag.PlanningCombination1, "--Select--", new { @class = "form-control form-control-sm ", @style = "width: 140px;", @onchange = "GetList()" })

                                </div>
                            </div>

                            <div class="tab-items border-none d-flex align-items-center">
                                <div>
                                    <label>Based On</label>
                                    <div class="radio-inline">
                                        <label class="radio radio-outline radio-success">
                                            @Html.HiddenFor(m => m.ListCount)
                                            @Html.RadioButtonFor(m => m.BasedOn, "0", new { @onchange = "showMonthCalender(this)" })
                                            <span></span>Current
                                        </label>
                                        <label class="radio radio-outline radio-success">
