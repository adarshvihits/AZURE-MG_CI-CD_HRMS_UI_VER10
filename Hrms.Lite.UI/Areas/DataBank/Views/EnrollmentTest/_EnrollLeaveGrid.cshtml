@model Hrms.Lite.Shared.DataBank.DTO.Enrollment

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table">
    <table id="ELeaveGrid">
        <thead>
            <tr class="table-dark">
                <th scope="col">Leave</th>
                <th scope="col">Opening</th>
                <th scope="col">Applicability</th>

            </tr>
        </thead>
        <tbody>
            @if (Model.LeaveOpening != null && Model.LeaveOpening.Count > 0)
            {
                for (int i = 0; i < Model.LeaveOpening.Count; i++)
                {
            <tr>
                 @Html.HiddenFor(m=>m.LeaveOpening[i].Code)
                <td data-label="Leave"> @Model.LeaveOpening[i].Leave   </td>
                <td data-label="Opening">                   
                    @Html.TextBoxFor(m => m.LeaveOpening[i].Opening, new { @class = "form-control form-control-sm" })
                 </td>
                <td data-label="Applicability">                    
                 @Html.CheckBoxFor(Model => Model.LeaveOpening[i].Applicability, new { @class = "activeCheckbox" })       
                            </td>
            </tr>
                }
            }
          
        </tbody>
    </table>
</div>