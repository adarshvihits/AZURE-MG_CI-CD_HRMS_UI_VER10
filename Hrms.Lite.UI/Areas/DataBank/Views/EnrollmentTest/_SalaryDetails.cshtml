@model Hrms.Lite.Shared.DataBank.DTO.Enrollment


<style>
    #edoj {
        color: white;
    }
</style>

<div class="popup-inner-style">
    <div class="profile-header position-relative pb-12 mb-5 " style="padding-bottom: 2px !important; padding-top: 5px !important;">
        <div class="row">

            <div id="edoj"></div>
        </div>
    </div>
   
</div>

<div style="padding:10px;" class="ihits-table table-border hover-color odd-even mobile-responsive-table  vertical-scroll-200">



    <div id="GroupSummaryListDiv">
        <table id="GroupsummaryTable">
            <thead>
                <tr class="table-light">
                    <th scope="col">Salary Breakup</th>
                    <th scope="col">Per Month</th>
                    <th scope="col">Per Annum</th>


                </tr>
            </thead>
            <tbody>
                @if (Model.PreEnrollment.Compensation.FixedAllowance != null && Model.PreEnrollment.Compensation.FixedAllowance.Count > 0)
                {

                    for (int i = 0; i < Model.PreEnrollment.Compensation.FixedAllowance.Count; i++)
                    {


                        @if (Model.PreEnrollment.Compensation.FixedAllowance[i].AllowanceType == "GS" || Model.PreEnrollment.Compensation.FixedAllowance[i].AllowanceType == "NS" || Model.PreEnrollment.Compensation.FixedAllowance[i].AllowanceType == "CTC")
                        {
                            <tr>
                                <td style="font-weight:bold" data-label="FixedAllowance">@Model.PreEnrollment.Compensation.FixedAllowance[i].Name</td>

                                <td style="font-weight:bold" data-label="FixedAllowance">
                                    @Model.PreEnrollment.Compensation.FixedAllowance[i].Amount
                                </td>
                                <td style="font-weight:bold" data-label="PerAnnum">@Model.PreEnrollment.Compensation.FixedAllowance[i].PerAnnum</td>

                            </tr>
                        }
                        else @if (Model.PreEnrollment.Compensation.FixedAllowance[i].AllowanceType == "A")
                        {
                            <tr>
                                <td style="color:green" data-label="FixedAllowance">@Model.PreEnrollment.Compensation.FixedAllowance[i].Name</td>

                                <td style="color:green" data-label="FixedAllowance">
                                    @Model.PreEnrollment.Compensation.FixedAllowance[i].Amount
                                </td>
                                <td style="color:green" data-label="PerAnnum">@Model.PreEnrollment.Compensation.FixedAllowance[i].PerAnnum</td>

                            </tr>
                        }
                        else @if (Model.PreEnrollment.Compensation.FixedAllowance[i].AllowanceType == "D")
                        {
                            <tr>
                                <td style="color:red" data-label="FixedAllowance">@Model.PreEnrollment.Compensation.FixedAllowance[i].Name</td>

                                <td style="color:red" data-label="FixedAllowance">
                                    @Model.PreEnrollment.Compensation.FixedAllowance[i].Amount
                                </td>
                                <td style="color:red" data-label="PerAnnum">@Model.PreEnrollment.Compensation.FixedAllowance[i].PerAnnum</td>

                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td data-label="FixedAllowance">@Model.PreEnrollment.Compensation.FixedAllowance[i].Name</td>

                                <td data-label="FixedAllowance">
                                    @Model.PreEnrollment.Compensation.FixedAllowance[i].Amount
                                </td>
                                <td data-label="PerAnnum">@Model.PreEnrollment.Compensation.FixedAllowance[i].PerAnnum</td>

                            </tr>
                        }

                    }
                }



            </tbody>


        </table>

    </div>

</div>










