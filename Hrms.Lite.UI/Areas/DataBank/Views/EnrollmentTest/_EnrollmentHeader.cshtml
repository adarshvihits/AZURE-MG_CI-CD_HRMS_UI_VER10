@model Hrms.Lite.Shared.DataBank.DTO.Enrollment
<script>
    $(document).ready(function () {
        if ($('#Breadcrumb').val() == "Employee Rejoin")
            onEditClick();

          $('.emp_HeaderPic').css('background-image', "url('@Html.Raw(@ViewBag.dataUri)')");

    });

</script>
   

<div class="profile-header pb-12  position-relative box-shadow-none mb-2">

    <div class="justify-content-between content-right">

        <a href="#" class="my_profile_btn_edite editbtn" onclick="onEditClick()"></a>
    </div>
    <div class="row">
        <div class="col-md-1">
            <div class="image-input image-input-outline image-input-circle" id="kt_image_4"
                 style="background-image: url(/images/blank.png)">
                <div class="image-input-wrapper emp_HeaderPic" 
                     >
                </div>

                <div style="display:none">
                   
                    @Html.HiddenFor(m => m.PreEnrollment.BasicInfo.File.FileName)
                    @Html.HiddenFor(m => m.PreEnrollment.BasicInfo.File.fdata)
                    @Html.HiddenFor(m => m.PreEnrollment.PreEnrollCode)
                </div>
                <label class="btn btn-icon btn-circle btn-white btn-hover-text-primary btn-shadow"
                       data-action="change" data-bs-toggle="tooltip" title="Click to upload photo"
                       data-bs-original-title="Change avatar" onclick="$('#PreEnrollment_BasicInfo_File_FileData').trigger('click')">
                    <i class="fa fa-pen icon-sm text-muted"></i>

                    @Html.HiddenFor(m => m.EnrollGUID)
                 

                </label>




                <span class="btn btn-icon btn-circle btn-white btn-hover-text-primary btn-shadow"
                      data-action="remove" data-bs-toggle="tooltip" title="Remove Photo" id="removePhoto" onclick="onRemovePhotoClick()">
                    <i class="ki ki-bold-close icon-xs text-muted"></i>
                </span>
            </div>
            @Html.HiddenFor(m => m.PreEnrollment.BasicInfo.File.FileData, new { @type = "file", @name = "profile_avatar", @onchange = "validateProfilePhoto()", disabled = "disabled", @style = "display:none", accept = ".jpg, .jpeg" })
        </div>
        <div class="col-md-9 mt-2">
            <div class="row">
                <div class="col-md-6 pr-0">
                    <div class="form-group">

                        <div class="input-group">
                            <div class="input-group-merge">

                                @Html.DropDownListFor(m => m.PreEnrollment.BasicInfo.Salutation.Code, (SelectList)ViewBag.Sal, new { @class = "form-control form-control-sm", disabled = "disabled" })
                                @Html.HiddenFor(m => m.PreEnrollment.BasicInfo.Salutation.Code)
                            </div>

                            @Html.TextBoxFor(m => m.PreEnrollment.BasicInfo.FullName, new { @class = "form-control form-control-sm", @maxlength = 120, @placeholder = "Full Name", @onblur = "capitalizeAllLetter(this)"@*"firstLetterCaps(this,'fullname')"*@, @onkeypress = "return onlyLetters_Space_DotKeys(event)", disabled = "disabled" })
                            @Html.HiddenFor(m => m.PreEnrollment.BasicInfo.FullName)
                        </div>
                        <span id="fullname"></span>

                    </div>
                </div>
                <div class="col-md-3"></div>


            </div>

            <div class="row">
                <div class="col-md-3">
                    <div class="form-group mb-0">
                        <div class="input-group date">

                            @Html.TextBoxFor(m => m.PreEnrollment.BasicInfo.AcceptedDOJ, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "DOJ", @onchange = "validateDOJ(this,'doj');OnLeaveGroupChange($('#AttendanceSettings_LeaveGroup_Code'));", disabled = "disabled", @onclick = "$('#PreEnrollment_BasicInfo_AcceptedDOJ').datepicker('show'); " })
                            @Html.HiddenFor(m => m.PreEnrollment.BasicInfo.AcceptedDOJ)
                            <div class="input-group-append">
                                <span class="input-group-text">
                                    <i class="la la-calendar"></i>
                                </span>
                            </div>
                        </div>
                        <span id="doj"></span>

                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group mb-0">

                        @Html.TextBoxFor(m => m.PreEnrollment.PermanentAddress.MobileNo, new { @class = "form-control form-control-sm", @maxlength = 10, @placeholder = "Mobile", @onblur = "validateMobile('PreEnrollment_PermanentAddress_MobileNo','mobile')", @onkeypress = "return onlyNumberKey(event)", disabled = "disabled" })
                        @Html.HiddenFor(m => m.PreEnrollment.PermanentAddress.MobileNo)
                        <span id="mobile"></span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group mb-0">

                        @Html.TextBoxFor(m => m.PreEnrollment.PermanentAddress.MailID, new { @class = "form-control form-control-sm", @maxlength = 120, @placeholder = "E-Mail", @onblur = "validateEmail(this,'email','PreEnrollment_FiledValidations_0__Applicability')", disabled = "disabled" })
                        @Html.HiddenFor(m => m.PreEnrollment.PermanentAddress.MailID)
                        <span id="email"></span>
                    </div>
                </div>





            </div>




        </div>
    </div>




</div>




<div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content popup">
            <div class="modal-header" style="padding:10px">
                <h5 class="modal-title" id="exampleModalLabel">Update Profile Photo</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close" onclick="clearPopUp()">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            @*<div class="profile-header" style="text-align:center;">


                    <div class="image-input image-input-outline image-input-circle mr-5" id="kt_image_4">
                        <div class="image-input-wrapper"
                             style="background-image: url(@Model.enrollment.PreEnrollment.BasicInfo.File.AbsoluteUri)">
                        </div>
                        <label class="btn btn-icon btn-circle btn-white btn-hover-text-primary btn-shadow" data-action="change" data-bs-toggle="tooltip" data-bs-original-title="Click to upload photo">
                            <i class="fa fa-pen icon-sm text-muted"></i>
                            @Html.TextBoxFor(model => model.enrollment.PreEnrollment.BasicInfo.File.FileData, new { type = "file", @name = "profile_avatar", @onchange = "CheckProfileExtensionSize(this);validateProfilePhoto()" })
                        </label>
                    </div>
                </div>*@

            <div class="modal-body">

            </div>

        </div>
    </div>
</div>