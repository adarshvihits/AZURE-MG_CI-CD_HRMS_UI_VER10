@model Hrms.Lite.Shared.DataBank.DTO.Enrollment
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table emp-cost-center-list">
    @Html.HiddenFor(m => m.PreEnrollment.FiledValidations.Count)
    <table id="EmployeeVsCostTable" class="common-table">
        <thead>
            <tr class="table-dark">

                <th scope="col">Mandatory</th>

            </tr>
        </thead>
        <tbody>
            @if (Model.PreEnrollment.FiledValidations != null && Model.PreEnrollment.FiledValidations.Count > 0)
            {
                for (int i = 0; i < Model.PreEnrollment.FiledValidations.Count; i++)
                {
                    @Html.HiddenFor(m => m.PreEnrollment.FiledValidations[i].Applicability)
                    <tr>
                        <td data-label="Location">@Model.PreEnrollment.FiledValidations[i].Applicability</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>