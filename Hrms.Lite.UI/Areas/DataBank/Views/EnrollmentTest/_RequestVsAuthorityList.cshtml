@model Hrms.Lite.Shared.DataBank.DTO.Enrollment
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table requestauthorityenroll-list vertical-scroll-200">
    <table id="authorityTable">
        <thead>
            <tr class="table-dark">
                <th scope="col">Request Type</th>
                <th scope="col">Level</th>
                <th scope="col">Authority</th>

            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.EmployeeSettingsReqVsAuth != null && Model.EmployeeSettingsReqVsAuth.RequestVsAuthoritySettings != null && Model.EmployeeSettingsReqVsAuth.RequestVsAuthoritySettings.Count > 0)
            {
                for (int i = 0; i < Model.EmployeeSettingsReqVsAuth.RequestVsAuthoritySettings.Count; i++)
                {
                    <tr>
                        <td>
                            @*@Html.TextBoxFor(Model => Model.EmployeeSettingsReqVsAuth.RequestVsAuthoritySettings[i].RequestTypeCode)
                            @Html.TextBoxFor(Model => Model.EmployeeSettingsReqVsAuth.RequestVsAuthoritySettings[i].RequestTypeName)*@
                            @Html.HiddenFor(m => m.EmployeeSettingsReqVsAuth.RequestVsAuthoritySettings.Count)
                            @Model.EmployeeSettingsReqVsAuth.RequestVsAuthoritySettings[i].RequestTypeName
                            @{ 
                                string ReqId = "EmployeeSettingsReqVsAuth_RequestVsAuthoritySettings_" + i + "__RequestTypeName";
                                string ReqName = "EmployeeSettingsReqVsAuth.RequestVsAuthoritySettings[" + i + "].RequestTypeName";
                                string ReqCodeId = "EmployeeSettingsReqVsAuth_RequestVsAuthoritySettings_" + i + "__RequestTypeCode";
                                string ReqCodeName = "EmployeeSettingsReqVsAuth.RequestVsAuthoritySettings[" + i + "].RequestTypeCode";
                            }
                            <input type="hidden" id="@ReqId" name="@ReqName" class="form-control form-control-sm" value="@Model.EmployeeSettingsReqVsAuth.RequestVsAuthoritySettings[i].RequestTypeName" />
                            <input type="hidden" id="@ReqCodeId" name="@ReqCodeName" class="form-control form-control-sm" value="@Model.EmployeeSettingsReqVsAuth.RequestVsAuthoritySettings[i].RequestTypeCode" />

                                                       

                        </td>
                        <td>
                            @{
                                string LevelCodeId = "EmployeeSettingsReqVsAuth_RequestVsAuthoritySettings_" + i + "__LevelCode";
                                string LevelCodeName = "EmployeeSettingsReqVsAuth.RequestVsAuthoritySettings[" + i + "].LevelCode";
                                string LevelId = "EmployeeSettingsReqVsAuth_RequestVsAuthoritySettings_" + i + "__LevelName";
                                string LevelName = "EmployeeSettingsReqVsAuth.RequestVsAuthoritySettings[" + i + "].LevelName";
                            }

                            <input type="hidden" id="@LevelCodeId" name="@LevelCodeName" class="form-control form-control-sm" value="@Model.EmployeeSettingsReqVsAuth.RequestVsAuthoritySettings[i].LevelCode" />
                            <input type="hidden" id="@LevelId" name="@LevelName" class="form-control form-control-sm" value="@Model.EmployeeSettingsReqVsAuth.RequestVsAuthoritySettings[i].LevelName" />
                            @Model.EmployeeSettingsReqVsAuth.RequestVsAuthoritySettings[i].LevelName
                            
                        </td>
                        <td>
                            @Model.EmployeeSettingsReqVsAuth.RequestVsAuthoritySettings[i].AuthorityName                            
                            @{ 
                                string AuthCodeId = "EmployeeSettingsReqVsAuth_RequestVsAuthoritySettings_" + i + "__AuthorityCode";
                                string AuthCodeName = "EmployeeSettingsReqVsAuth.RequestVsAuthoritySettings[" + i + "].AuthorityCode";
                                string AuthId = "EmployeeSettingsReqVsAuth_RequestVsAuthoritySettings_" + i + "__AuthorityName";
                                string AuthName = "EmployeeSettingsReqVsAuth.RequestVsAuthoritySettings[" + i + "].AuthorityName";
                                }
                            <input type="hidden" id="@AuthCodeId" name="@AuthCodeName" class="form-control form-control-sm" value="@Model.EmployeeSettingsReqVsAuth.RequestVsAuthoritySettings[i].AuthorityCode"/>
                            <input type="hidden" id="@AuthId" name="@AuthName" class="form-control form-control-sm" value="@Model.EmployeeSettingsReqVsAuth.RequestVsAuthoritySettings[i].AuthorityName"/>

                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>