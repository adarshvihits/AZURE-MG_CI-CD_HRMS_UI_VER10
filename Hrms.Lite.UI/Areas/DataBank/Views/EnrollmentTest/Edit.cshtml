                        </div>
                        <div id="Enroll_leave" class="hide">
                            @await Html.PartialAsync("_EnrollLeave")
                        </div>
                        <div id="Enroll_payment" class="hide">
                            @await Html.PartialAsync("_EnrollPayment")
                        </div>
                        <div id="Enroll_classification" class="hide">
                            @await Html.PartialAsync("_EnrollClassification")
                        </div>

                        <div id="Enroll_generateEmpId" class="hide">
                            @await Html.PartialAsync("_EnrollGenerateEmpID")
                        </div>
                        <div id="Mandatory" class="hide">
                            @await Html.PartialAsync("_Mandatory.cshtml")
                        </div>
                    </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->
    </div> <!--end::Content-->
}


