@model Hrms.Lite.Shared.DataBank.DTO.Enrollment
@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>


<script src="~/scripts/DataBank/enrollTest.js"></script>

<script>
    $(document).ready(function () {
        debugger;
        onStepCircleClick('@Model.SelectedTab');


        $('#AttendanceSettings_ShiftDetailsIds').multiselect({
            includeSelectAllOption: true,
            nonSelectedText: '--Select Shift Details--',
        });

        $('#AttendanceSettings_PunchingMethodIDs').multiselect({
            includeSelectAllOption: true,
            nonSelectedText: '--Select Punching Method--',
        });

        fillSingleValueDropdown();
        CTCCalculation();
        if ('@Model.AttendanceSettings.ShiftDetailsId'== '') {

            $('#singleselect').hide();
        }
        else {
            $('#multipleselect').hide();
            $('#singleselect').show();
        }

        const myTimeout = setTimeout(changeFocus, 500);

        function changeFocus() {
            $('#PreEnrollment_BasicInfo_Salutation_Code').focus();
        }


        madatoryCheck();

        debugger

        if ('@Model.AutoGeneratedEmployeeID' == 'False') {
            $(".employeeIDTextBox").removeClass('hide');
            if (@Model.PunchingIDSameasEmployeeID == 1)
                $(".PunchingIDTextBox").addClass('hide')
                else
                $(".PunchingIDTextBox").removeClass('hide')

        }


        else  {
            $(".employeeIDTextBox").addClass('hide');

            if (@Model.PunchingIDSameasEmployeeID== 0)
                $(".PunchingIDTextBox").removeClass('hide');
            else
                $(".PunchingIDTextBox").addClass('hide');
        }
        if ($("#StatutoryClassification_PaymentMode_Code").val() == 2) {
            $('#bankdetails').hide();
            $("#PayMode").css("display", "none");
        }
        else {
            $('#bankdetails').show();
            $("#PayMode").css("display", "block");
        }

        //$('#authorityTableDiv').html('');
        //$("#authorityTable").clone().appendTo("#authorityTableDiv");
        //$('#authorityTableDiv table').attr('id', '')
        if (@Model.PreEnrollment.BasicInfo.Relation.Code == 1) {
            $('#labRel').html("Father's Name");
            $('#BasicInfo_FathersName').attr('placeholder', "Father's Name")

        }
        else {
            $('#labRel').html('Spouse Name');
            $('#BasicInfo_FathersName').attr('placeholder', 'Spouse Name')
        }

    });

</script>

@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "enrollSave", enctype = "multipart/form-data", @style = "height:100%" }))
{<!--begin::Header-->
    @Html.HiddenFor(m => m.Breadcrumb)

    @Html.HiddenFor(m => m.AutoGeneratedEmployeeID)
    @Html.HiddenFor(m => m.PunchingIDSameasEmployeeID)
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->
            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">


                <div class="d-flex align-items-baseline flex-wrap mr-5">
