@model Hrms.Lite.Shared.DataBank.DTO.Enrollment
<div class="step-outer step_row">


    <a href="#" class="step-item active" onclick="onStepCircleClick('Personal-Info')">
        Personal Info
        <span class="step-circle"></span>
    </a>
    <a href="#" class="step-item active" onclick="onStepCircleClick('Job-Details')">
        Job Details
        <span class="step-circle"></span>
    </a>
    <a href="#" class="step-item active" data-bs-toggle="tooltip" data-bs-original-title="Compensation & Benefits" onclick="onStepCircleClick('Compensation')">
        C & B
        <span class="step-circle"></span>
    </a>
    <a href="#" class="step-item active">
        Address
        <span class="step-circle"></span>
    </a>

    <a href="#" class="step-item">
        Attendance Settings
        <span class="step-circle"></span>
    </a>
    <a href="#" class="step-item">
        Leave
        <span class="step-circle"></span>
    </a>
    <a href="#" class="step-item">
        Statutory & Payment
        <span class="step-circle"></span>
    </a>
    @*<a href="#" class="step-item">
        Other Groupings
        <span class="step-circle"></span>
    </a>*@
    <a href="#" class="step-item">
        ID & Manager Generation
        <span class="step-circle"></span>
    </a>


</div>

<div class="step-progress-outer">

    <div class="step-left col-md-12">
        <h3>Address for Communication</h3>

        <div class="row my-3">

         
                <div class="col-md-3">
                    <div class="form-group">
                        <label>House</label><span class="Mandatory">*</span>
                   
                        @Html.TextBoxFor(m => m.PreEnrollment.PermanentAddress.House, new { @class = "form-control form-control-sm", @maxlength = 120, @placeholder = "House", @onblur = "validate(this,'house')" })
                        <span id="house"></span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Street</label><span class="Mandatory">*</span>
                     
                        @Html.TextBoxFor(m => m.PreEnrollment.PermanentAddress.Street, new { @class = "form-control form-control-sm", @maxlength = 120, @placeholder = "Street", @onblur = "validate(this,'street')" })
                        <span id="street"></span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label>City</label><span class="Mandatory">*</span>
                      
                        @Html.TextBoxFor(m => m.PreEnrollment.PermanentAddress.City, new { @class = "form-control form-control-sm", @maxlength = 120, @placeholder = "City", @onblur = "validate(this,'city')" })
                        <span id="city"></span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label>PIN code</label><span class="Mandatory">*</span>
                      
                        @Html.TextBoxFor(m => m.PreEnrollment.PermanentAddress.PinCode, new { @class = "form-control form-control-sm", @maxlength = 6, @placeholder = "PIN code", @onblur = "validatePincode(this,'pin')", @onkeypress = "return onlyNumberKey(event)" })
                        <span id="pin"></span>
                    </div>
                </div>

            </div>

            <div class="row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label>Country</label><span class="Mandatory">*</span>
                      
                        @Html.DropDownListFor(m => m.PreEnrollment.PermanentAddress.Country.Code, (SelectList)ViewBag.Cntry, "--Select--", new { @class = "form-control form-control-sm", @onchange = "onCountryChange(this,'country')" })
                        <span id="country"></span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label>State</label><span class="Mandatory">*</span>
                       
                        @Html.DropDownListFor(m => m.PreEnrollment.PermanentAddress.State.Code, (SelectList)ViewBag.St, "--Select--", new { @class = "form-control form-control-sm", @onchange = "onStateChange(this,'state')" })
                        <span id="state"></span>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="form-group">
                        <label>District</label><span class="Mandatory">*</span>
                       
                        @Html.DropDownListFor(m => m.PreEnrollment.PermanentAddress.District.Code, (SelectList)ViewBag.Dist, "--Select--", new { @class = "form-control form-control-sm", @onchange = "onDistrictChange(this,'district')" })
                        <span id="district"></span>
                    </div>
                </div>

            </div>
        </div>
    </div>

<div class="row card-footer-bottom-fixed">
    <div class="col-md-6">
        <button type="button" onclick="PopUp_Preview()"
                class="btn btn-default float-left mobile-full-width">
            Salary Details
        </button>

    </div>
    <div class="col-md-6">
        <button id="preEnrollID" type="button" onclick="onNextClick('Enroll_address','Compensation')"
                class="btn btn-default float-right mobile-full-width">
            Next
        </button>
    </div>
</div>
