                                                            }





                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>

                                    </div>

                                </div>


                            </div>



                        </div>
                    </div>




                    <div class="row ">
                        <div class="col-md-2">
                            <div class="form-group">
                                @Html.HiddenFor(m => m.PreEnrollment.Compensation.GrossSalary)
                                <label class="mr-2"><b>Gross Salary</b></label>
                                <b><span id="GrossSal">@Model.PreEnrollment.Compensation.GrossSalary</span></b>                               
                            </div>

                        </div>
                        <div class="col-md-2">
                            <div class="form-group">
                                @Html.HiddenFor(m => m.PreEnrollment.Compensation.CTC)
                                <label class="mr-2"><b>CTC</b></label>
                                <b><span id="ctc">@Model.PreEnrollment.Compensation.CTC</span></b>                                
                            </div>
                        </div> 
                        <div class="col-md-2">
                            <div class="form-group">                                
                                <label class="mr-2"><b>Total Deductions</b></label>
                                <b><span id="totDeductions"></span></b>                               
                            </div>
                        </div> 
                     

                        @*<div class="col-md-3 d-flex align-items-center">
                            <div class="form-group mb-0 mt-4">
