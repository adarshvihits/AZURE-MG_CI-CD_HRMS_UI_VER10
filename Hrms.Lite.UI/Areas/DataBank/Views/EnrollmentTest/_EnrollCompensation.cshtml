                                                            {

                                                                for (int i = 0; i < Model.PreEnrollment.Compensation.FixedDeduction.Count; i++)
                                                                {
                                                                    <tr>
                                                                        <td data-label="Fixed Deduction">@Html.HiddenFor(m => m.PreEnrollment.Compensation.FixedDeduction[i].Code)@Model.PreEnrollment.Compensation.FixedDeduction[i].Name</td>
                                                                        <td data-label="Amount">
                                                                            @*<input type="text"
                                                                                class="form-control form-control-sm"
                                                                                placeholder="Amount">*@
                                                                            @Html.TextBoxFor(m => m.PreEnrollment.Compensation.FixedDeduction[i].Amount, new { @class = "form-control input_height form-control-sm DeductionsAmount", @placeholder = "Amount", @onblur = "CTCCalculation()" })
                                                                        </td>


                                                                    </tr>
                                                                }
                                                            }




                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                            <!-- <end></end> -->
                                            <div class="col-md-6">

                                                <!-- <div class="newgroup">
                                                    <h5><i
                                                            class="fas fa-briefcase icon-md mr-2"></i>Evaluate
                                                        Your Company
                                                    </h5>
                                                </div> -->
                                                <div class="ihits-table table-border  mobile-responsive-table salary-add-allowance comp-width vertical-scroll-200">
                                                    <table class="compensationTables">
                                                        <thead>
                                                            <tr class="table-light">
                                                                <th scope="col">Other Applicable Deduction</th>

                                                                <th scope="col">Applicability</th>

                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @if (Model.PreEnrollment.Compensation.VariableDeduction != null && Model.PreEnrollment.Compensation.VariableDeduction.Count > 0)
                                                            {

                                                                for (int i = 0; i < Model.PreEnrollment.Compensation.VariableDeduction.Count; i++)
                                                                {
                                                                    <tr>
                                                                        <td data-label="Variable Deduction"> @Html.HiddenFor(m => m.PreEnrollment.Compensation.VariableDeduction[i].Code)@Model.PreEnrollment.Compensation.VariableDeduction[i].Name</td>

                                                                          <td data-label="Check Item">
                                                                                <div class="checkbox-inline ">
                                                                                    <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                                                                        @*<input type="checkbox"
                                                                                            name="Checkboxes16">*@
                                                                                        @Html.CheckBoxFor(m => m.PreEnrollment.Compensation.VariableDeduction[i].Applicable)
                                                                                        <span></span>
                                                                                    </label>
                                                                                </div>

                                                                        </td>


                                                                    </tr>
                                                                }
                                                            }




                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        </div>

                                    </div>

                                    <div class="tab-pane" id="tabs-3" role="tabpanel">
                                        <div class="row">
                                            <div class="col-md-6">

                                                <!-- <div class="newgroup">
                                                    <h5><i
                                                            class="fas fa-briefcase icon-md mr-2"></i>
                                                    </h5>
                                                </div> -->
                                                <div class="ihits-table table-border  mobile-responsive-table salary-structure-tab comp-width vertical-scroll-150">
                                                    <table class="compensationTables">
                                                        <thead>
                                                            <tr class="table-light">
                                                                <th scope="col">
                                                                    Fixed Provision & Perks
                                                                </th>
                                                                <th scope="col" id="FProvAmtOrPer">Amount</th>

                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @if (Model.PreEnrollment.Compensation.FixedProvisions != null && Model.PreEnrollment.Compensation.FixedProvisions.Count > 0)
                                                            {

                                                                for (int i = 0; i < Model.PreEnrollment.Compensation.FixedProvisions.Count; i++)
                                                                {
                                                            <tr>
                                                                <td data-label="Fixed Provision & Perks">@Html.HiddenFor(m => m.PreEnrollment.Compensation.FixedProvisions[i].Code)@Model.PreEnrollment.Compensation.FixedProvisions[i].Name</td>
                                                                @Html.HiddenFor(m => m.PreEnrollment.Compensation.FixedProvisions[i].CtcApplicable)
                                                                <td data-label="Amount">
                                                                    @*<input type="text"
            class="form-control form-control-sm"
            placeholder="Amount">*@
                                                                    @Html.TextBoxFor(m => m.PreEnrollment.Compensation.FixedProvisions[i].Amount, new { @class = "form-control input_height form-control-sm ProvisionsAmount", @placeholder = "Amount", @onblur = "CTCCalculation()" })
                                                                </td>


                                                            </tr>
                                                                }
                                                            }




                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                            <!-- <end></end> -->
                                            <div class="col-md-6">

                                                <!-- <div class="newgroup">
                                                    <h5><i
                                                            class="fas fa-briefcase icon-md mr-2"></i>Evaluate
                                                        Your Company
                                                    </h5>
                                                </div> -->
                                                <div class="ihits-table table-border  mobile-responsive-table salary-add-allowance comp-width vertical-scroll-150">
                                                    <table class="compensationTables">
                                                        <thead>
                                                            <tr class="table-light">
                                                                <th scope="col">
                                                                    Variable Provision
                                                                    & Perks
                                                                </th>

                                                                <th scope="col">Applicability</th>

                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @if (Model.PreEnrollment.Compensation.VariableProvisions != null && Model.PreEnrollment.Compensation.VariableProvisions.Count > 0)
                                                            {

                                                                for (int i = 0; i < Model.PreEnrollment.Compensation.VariableProvisions.Count; i++)
                                                                {
                                                                    <tr>
                                                                        <td data-label="SI">@Html.HiddenFor(m => m.PreEnrollment.Compensation.VariableProvisions[i].Code)@Model.PreEnrollment.Compensation.VariableProvisions[i].Name</td>

                                                                        <td data-label="Check Item">
                                                                                <div class="checkbox-inline ">
                                                                                    <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                                                                        @*<input type="checkbox"
                                                                                            name="Checkboxes16">*@
                                                                                        @Html.CheckBoxFor(m => m.PreEnrollment.Compensation.VariableProvisions[i].Applicable)
