    <a href="#" class="step-item active" onclick="onStepCircleClick('Job-Details')">
        Job Details
        <span class="step-circle active"></span>
    </a>
    <a href="#" class="step-item active" data-bs-toggle="tooltip" data-bs-original-title="Compensation & Benefits" onclick="onStepCircleClick('Compensation')">
        C & B
        <span class="step-circle"></span>
    </a>
    <a href="#" class="step-item active" onclick="onStepCircleClick('Address')">
        Address
        <span class="step-circle"></span>
    </a>

    <a href="#" class="step-item active" onclick="onStepCircleClick('Attendance-Settings')">
        Attendance Settings
