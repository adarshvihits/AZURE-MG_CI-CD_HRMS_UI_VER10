<div class="step-progress-outer">
    @Html.HiddenFor(model => model.PreEnrollment.PreEnrollGI)

    <div class="step-left col-md-12">
        <h3>     Statutory & Payment</h3>


        <div class="row my-3">
            <div class="col-md-3">
                <div class="form-group">
                    <label>PF Enroll Date</label>
                    <div class="input-group date">

                        @Html.TextBoxFor(m => m.StatutoryClassification.PFEnrollDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "readonly", @placeholder = "PF Enroll Date" })
                        <div class="input-group-append">
                            <span class="input-group-text">
                                <i class="la la-calendar"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>PF Group</label>
                    @Html.DropDownListFor(m => m.StatutoryClassification.PFGroup.Code, (SelectList)ViewBag.PFGroup, "--Select PF Group--", new { @class = "form-control form-control-sm" })

                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>PF Number</label>

                    @Html.TextBoxFor(m => m.StatutoryClassification.PFNumber, new { @class = "form-control form-control-sm", @maxlength = 20, @placeholder = "PF Number", @onchange = "trim(this)" })
                </div>
            </div>


            <div class="col-md-3">
                <div class="form-group">
                    <label>UAN Number</label>

                    @Html.TextBoxFor(m => m.StatutoryClassification.UANNumber, new { @class = "form-control form-control-sm", @maxlength = 25, @placeholder = "UAN Number", @onchange = "trim(this)" })
                </div>
            </div>

        </div>
        <div class="row my-3">
            <div class="col-md-3">
                <div class="form-group">
                    <label>ESI Enroll Date</label>
                    <div class="input-group date">

                        @Html.TextBoxFor(m => m.StatutoryClassification.ESIEnrollDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "readonly", @placeholder = "ESI Enroll Date" })
                        <div class="input-group-append">
                            <span class="input-group-text">
                                <i class="la la-calendar"></i>
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>ESI Group</label>
                    @Html.DropDownListFor(m => m.StatutoryClassification.ESIGroup.Code, (SelectList)ViewBag.ESIGroup, "--Select ESI Group--", new { @class = "form-control form-control-sm" })
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>ESI Number</label>

                    @Html.TextBoxFor(m => m.StatutoryClassification.ESINumber, new { @class = "form-control form-control-sm", @maxlength = 20, @placeholder = "ESI Number", @onchange = "trim(this)" })
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>ESI Dispensary</label>

                    @Html.TextBoxFor(m => m.StatutoryClassification.ESIDispensary, new { @class = "form-control form-control-sm", @maxlength = 20, @placeholder = "ESI Dispensary", @onchange = "trim(this)" })
                </div>
            </div>
        </div>
        <div class="row my-3">
            <div class="col-md-3">
                <div class="form-group">
                    <label>EDLI</label>

                    @Html.TextBoxFor(m => m.StatutoryClassification.EDLI, new { @class = "form-control form-control-sm", @maxlength = 20, @placeholder = "EDLI", @onchange = "trim(this)" })
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>Gratuity No</label>

                    @Html.TextBoxFor(m => m.StatutoryClassification.GratuityNo, new { @class = "form-control form-control-sm", @maxlength = 20, @placeholder = "Gratuity No", @onchange = "trim(this)" })
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>NSDL</label>

                    @Html.TextBoxFor(m => m.StatutoryClassification.NSDL, new { @class = "form-control form-control-sm", @maxlength = 20, @placeholder = "NSDL", @onchange = "trim(this)" })
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>MedicalPolicy</label>

                    @Html.TextBoxFor(m => m.StatutoryClassification.MedicalPolicy, new { @class = "form-control form-control-sm", @maxlength = 20, @placeholder = "Medical Policy", @onchange = "trim(this)" })
                </div>
            </div>

        </div>
        <div class="row my-3">
            <div class="col-md-3">
                <div class="form-group">
                    <label>AccidentPolicy</label>

                    @Html.TextBoxFor(m => m.StatutoryClassification.AccidentPolicy, new { @class = "form-control form-control-sm", @maxlength = 20, @placeholder = "Accident Policy", @onchange = "trim(this)" })
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label>PT Group</label>

                    @Html.DropDownListFor(m => m.StatutoryClassification.PTGroup.Code, (SelectList)ViewBag.PTGroup, "--Select PT Group--", new { @class = "form-control form-control-sm" })
                    <span id="ptGroup"></span>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label>Paymode</label><span class="Mandatory">*</span>

                    @Html.DropDownListFor(m => m.StatutoryClassification.PaymentMode.Code, (SelectList)ViewBag.Payment, new { @class = "form-control form-control-sm", @onblur = "validate(this,'payment')", @onchange = "onPaymentModeChange(this)" })
                    <span id="payment"></span>
                </div>
            </div>
            <div class="col-md-3" id="PayMode">
                <div class="form-group">
                    <label>Bank Name</label><span class="Mandatory">*</span>

                    @Html.DropDownListFor(m => m.StatutoryClassification.Bank.Code, (SelectList)ViewBag.BankName, "--Select Bank Name--", new { @class = "form-control form-control-sm", @onblur = "validate(this,'bankname')" })
                    <span id="bankname"></span>
                </div>
            </div>

        </div>

        <div class="row my-3" id="bankdetails">
            @*<div class="col-md-3">
                <div class="form-group">
                    <label>Bank Branch</label><span class="Mandatory">*</span>
                    @Html.TextBoxFor(m => m.StatutoryClassification.BankBranch, new { @class = "form-control form-control-sm", @placeholder = "Bank Branch", @onblur = "validate(this,'branchName')" })
                    <span id="branchName"></span>
                </div>
            </div>*@
            <div class="col-md-3">
                <div class="form-group">
                    <label>Acc No.</label><span class="Mandatory">*</span>
                    @Html.TextBoxFor(m => m.StatutoryClassification.AccountNo, new { @*type = "password",*@@class = "form-control form-control-sm", @maxlength = 25, @placeholder = "Acc No.", @onblur = "validate(this,'accno')", @onchange = "onAccountNumValidation(this)" })
                    <span id="accno"></span>
                    <h4><span class="colums_list pb-1" id="AccountNoValidation"></span></h4>
                </div>
            </div>

            <div class="col-md-3">
                <div class="form-group">
                    <label>IFSC Code</label><span class="Mandatory">*</span>

                    @Html.TextBoxFor(m => m.StatutoryClassification.IFSC, new { @class = "form-control form-control-sm", @maxlength = 20, @placeholder = "IFSC Code", @onblur = "validate(this,'ifsc')" })
                    <span id="ifsc"></span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="file-upload-form-group">
                    <label for="formFileMultiple" class="form-label">
                        File
                    </label>
                    <span class="Mandatory">*</span>
                    <div class="file-upload-form mb-1">
                        <div class="small-btn-group">
                            <button type="button" data-bs-toggle="tooltip"
                                    data-placement="top"
                                    data-bs-original-title="View"
                                    class="btn btn-icon btn-default" onclick="Preview()">
                                <i class="icon-xl far fa-eye"></i>
                            </button>
                        </div>
                        <div data-bs-toggle="tooltip" data-bs-original-title=" Only pdf@*, doc, docx*@ files are allowed , File size less than 5 MB.">
                            @Html.HiddenFor(model => model.StatutoryClassification.BankFile.FileName)
                            @Html.HiddenFor(model => model.StatutoryClassification.BankFile.fdata)
                            @Html.TextBoxFor(model => model.StatutoryClassification.BankFile.FileData, null, new { type = "file", @class = "form-control PreviewImage nofilechosen Resume_FileData", onchange = "CheckDocImageExtensionSize(this);onFileChange()", title = "" })
                            <label id="fileLabel" class="nofilelabel notchlabel"></label>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        <!-- Tab End -->
        <!-- Tab Start -->

    </div>

</div>

<div class="row card-footer-bottom-fixed">
    <div class="col-md-6">
        <button type="button" onclick="PopUp_Preview()"
                class="btn btn-default float-left mobile-full-width">
            Salary Details
        </button>

    </div>
    <div class="col-md-6">
        <button type="button" onclick="onNextClick('Enroll_payment','Enroll_generateEmpId')"
                class="btn btn-default float-right mobile-full-width">
            Next
        </button>
    </div>
</div>
 