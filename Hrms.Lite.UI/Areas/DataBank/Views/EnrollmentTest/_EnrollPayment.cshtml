
@model Hrms.Lite.Shared.DataBank.DTO.Enrollment
<script>
    $(document).ready(function () {
        debugger;
        var b = document.getElementById('StatutoryClassification_BankFile_FileName');
        if (b.value == null)
            fileLabel.innerHTML = "No File Chosen";
        else {
            var b = document.getElementById('StatutoryClassification_BankFile_FileName');
            if (b.value != '') {

                let replacemnt = '..';
                theSplit = b.value.slice(0, 18);
                fileLabel.innerHTML = theSplit.substring(0, theSplit.length - 2) + replacemnt;
            }
            else
                fileLabel.innerHTML = "";
        }
    });

</script>
<style>

    .Resume_FileData {
        color: white !important;
    }
</style>
