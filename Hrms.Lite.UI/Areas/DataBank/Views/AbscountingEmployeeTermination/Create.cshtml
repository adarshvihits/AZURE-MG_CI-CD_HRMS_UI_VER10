@model Hrms.Lite.Shared.DataBank.Reports.AbscondingReport
@{
    ViewData["Title"] = "RequestVsAuthority";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/scripts/DataBank/abscountingEmployeeTermination.js"></script>
<script>

</script>

@using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "AbscountingTerminationSave" }))
{
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->


            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Absconding Employee Termination</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot p-0 mt-1 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                                <i class="icon-nm fas fa-home mt-1"></i>
                            </a>
                        </li>
                        <li class="breadcrumb-item text-muted">
                            <a href="@Url.Action("Index", "AbscountingEmployeeTermination", new { Area = "DataBank" })" class="">Absconding Employee Termination</a>
                        </li>
                        <li class="breadcrumb-item text-muted">
                            Absconding Employee Termination
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per">

                    <div class="card-body">
                        <!--begin: Search Form-->
                        <div class="profile-header position-relative box-shadow-none mb-2">
                            @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeHeader.cshtml", Model.EmployeeHeader)
                            @Html.HiddenFor(m => m.EmployeeGI)
                            @Html.HiddenFor(m => m.Details.LastProcessedMonth)
                            @Html.HiddenFor(m => m.Details.LastReportingDate)
                            <div class="profile-header-overflow"></div>
                        </div>

                        <!--begin: Search Form-->
                        <div class="page_white mt-5">
                            <div class="row mb-2">

                                <div class="col-md-2">
                                    <label class="view-title">Last Punch Date</label>
                                    <div class="view-details">
                                        @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Details.LastPunchDate))
                                    </div>
                                </div>

                                <div class="col-md-2">
                                    <label class="view-title">Last Salary Processed Month</label>
                                    <div class="view-details">
                                        @Html.DisplayFor(model => model.Details.LastProcessedMonth)
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <label class="view-title">Last Present Day</label>
                                    <div class="view-details">
                                       @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Details.LastReportingDate))
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <label class="view-title">Aging</label>
                                    <div class="view-details">
                                        @Html.DisplayFor(model => model.Details.Ageing)
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <label>LWD</label><span class="Mandatory">*</span>
                                    <div class="input-group date">

                                        @Html.TextBoxFor(m => m.Details.LWD, "{0:dd/MMM/yyyy}", new { @class = "form-control kt_datepicker_2", @placeholder = "LWD", @readonly = "readonly", @onchange = "validate(this, 'lwd')" })

                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>

                                    </div>
                                    <span id="lwd"></span>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Reason</label><span class="Mandatory">*</span>

                                        @Html.DropDownListFor(m => m.Reason.Code, (SelectList)ViewBag.Reason, "Select Reason", new { @class = "form-control form-control-sm", @onchange = "validate(this,'reason')" })
                                        <span id="reason"></span>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12 align-right">
                                    <button type="button" class="btn btn-default mobile-full-width" onclick="getSalaryList()">Proceed</button>
                                </div>
                            </div>
                        </div>
                        <div id="SalaryList">

                            @await Html.PartialAsync("_SalaryList", Model)

                        </div>
                        <div class="row card-footer-bottom-fixed">
                            <div class="col-md-12 align-right">
                                <button type="button" class="btn btn-default mobile-full-width" onclick="SaveAbscounting()">Save</button>
                            </div>

                        </div>
                    </div>
                </div>

                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>
    <!--end::Content-->
}