@model Hrms.Lite.Shared.DataBank.Reports.AbscondingReport
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table emp-cost-center-list">
    @Html.HiddenFor(m => m.AbscondingReporttList.Count)
    <table id="AbscountingTerminationTable" class="common-table">
        <thead>
            <tr class="table-dark">

                <th scope="col">Month </th>
                <th scope="col">Gross Allowance</th>
                <th scope="col">Gross Deduction</th>
                <th scope="col">Net pay</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.SalaryDetails != null && Model.SalaryDetails.Count > 0)
            {

                for (int i = 0; i < Model.SalaryDetails.Count; i++)
                {
                    <tr>
                        @Html.HiddenFor(m => Model.SalaryDetails[i].Month.Code)
                        @Html.HiddenFor(m => Model.SalaryDetails[i].Month.Name)
                        @Html.HiddenFor(m => Model.SalaryDetails[i].GrossAllowance)
                        @Html.HiddenFor(m => Model.SalaryDetails[i].GrossDeduction)
                        @Html.HiddenFor(m => Model.SalaryDetails[i].NetPay)

                        <td data-label="Month">@Model.SalaryDetails[i].Month.Name</td>
                        <td data-label="Gross Allowance">@Model.SalaryDetails[i].GrossAllowance</td>
                        <td data-label="Gross Deduction">@Model.SalaryDetails[i].GrossDeduction</td>
                        <td data-label="Net pay" id="netPay_@i">@Model.SalaryDetails[i].NetPay</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>