<script src="~/js/custom.js"></script>

@model Hrms.Lite.Shared.General.EmployeeHeader

<script>
    $(document).ready(function () {
        debugger
      
                $('.emp_HeaderPic').css('background-image', `url('/AccessFile/GetEmpThumbnail?EmployeeGI=${'@Model.EmployeeGuid'}')`);

    });


</script>
<div class="row">

    <div class="col-md-12 ">
        <div class="d-flex">
            <div class="d-flex align-items-center">
                <div class="image-input image-input-outline image-input-circle  mr-5 emp_HeaderPic" id="kt_image_4">
                    <div class="image-input-wrapper">
                    </div>
                </div>
            </div>
            <div class="flex-grow-1">
                <!--begin::Title-->
                <div class="d-flex justify-content-between flex-wrap mt-2">
                    <div class="d-flex mr-3 header-profile-name">
                        <a class="header-profile-name">@Model.EmployeeName</a>
                       

                    </div>

                </div>

                <!--end::Title-->
                <!--begin::Content-->
                <div class="d-flex flex-wrap justify-content-between">
                    <div class="">
                        <div class="d-flex flex-wrap mb-1">
                            <a data-bs-toggle="tooltip" data-bs-original-title="Fun.Designation" class="header-profile-email mr-4 mb-lg-0 mb-2">
                                <i class="fas fa-briefcase icon-nm mr-2"></i>@Model.Designation.Name
                            </a>
                            <a data-bs-toggle="tooltip" data-bs-original-title="Department" class="header-profile-email mr-4 mb-lg-0 mb-2">
                                <i class="fas fa-building icon-nm mr-2"></i>@Model.Department.Name
                            </a>
                            <a data-bs-toggle="tooltip" data-bs-original-title="Location" class="header-profile-email mr-4 mb-lg-0 mb-2">
                                <i class="fas fa-map-marker-alt icon-nm mr-2"></i>@Model.Location.Name
                            </a>
                            <a data-bs-toggle="tooltip" data-bs-original-title="Category" class="header-profile-email mr-4 mb-lg-0 mb-2">
                                <i class="fas fa-check-square icon-nm mr-2"></i>@Model.Category.Name
                            </a>
                            <a data-bs-toggle="tooltip" data-bs-original-title="Date Of Joining" class="header-profile-email mr-4 mb-lg-0 mb-2">
                                <i class="fas fa-calendar-alt icon-nm mr-2"></i>@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.DOJ))
                            </a>
                            @if (Model.ReportingManager != "")
                            {
                                <a data-bs-toggle="tooltip" data-bs-original-title="Reporting Manager" class="header-profile-email mr-4 mb-lg-0 mb-2">
                                    <i class="fas fa-user-tie icon-nm mr-2"></i>

                                    @Model.ReportingManager
                                </a>
                            }


                        </div>



                    </div>



                </div>

                <!--end::Content-->
            </div>

        </div>







    </div>
</div>