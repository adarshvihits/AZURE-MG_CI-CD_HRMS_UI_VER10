@model Hrms.Lite.Shared.DataBank.DTO.OfferLetter

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>


<script src="~/scripts/DataBank/Offer.js" asp-append-version="true"></script>



<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Offer
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Offer
                    </li>

                </ul>
            </div>
        </div>

    </div>

</div>

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">


                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">


                            <div class="tab-items medium">
                                <span class="btn-title active Verification" onclick="OnTabClick('Verification','APPROVAL PENDING')">
                                    Offer Verification
                                    <!-- <span class="btn-notification">4</span> -->
                                </span>
                            </div>
                            <div class="tab-items high">
                                <span class="btn-title OfferSend" onclick="OnTabClick('OfferSend','APPROVED')">
                                    Offer Send
                                    <!-- <span class="btn-notification">3</span> -->
                                </span>
                            </div>
                            <div class="tab-items high">
                                <span class="btn-title OfferSend" onclick="OnTabClick('Verified','APPROVEDFINAL')">
                                    Offer Verified
                                @*<span class="btn-notification">3</span>*@ 
                                </span>
                            </div>
                            




                            <div class="tab-items select-option d-flex">
                                <div class="pl-8 d-flex align-items-center hide pr-8" id="radio">
                                    <div class="radio-inline pt-4 ml-auto">
                                     
                                        <label class="radio radio-outline radio-success">
                                            @Html.RadioButtonFor(m => m.radiomode, "0", new { @onchange = "CandidatelinkRadio()" })
                                            <span></span>Not Sent
                                        </label>
                                        <label class="radio radio-outline radio-success">
                                            @Html.RadioButtonFor(m => m.radiomode, "1", new { @onchange = "CandidatelinkRadio()" })
                                            <span></span>Sent
                                        </label>
                                        <label class="radio radio-outline radio-success">
                                           
                                            @Html.RadioButtonFor(m => m.radiomode, "2", new { @onchange = "CandidatelinkRadio()" })
                                            <span></span>Offer Verified
                                        </label>

                                    </div>
                                </div>
                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>

                                <div id="filterForm" class="filter-button slider-btn" data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                   data-bs-original-title="Export to Excel" onclick="onOfferExportToExcelClick()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>
                            </div>








                        </div>
                    </div>

                    <!-- Table Section -->

                    <div id="offerverification">
                        @await Html.PartialAsync("_OfferVerificationList", Model)
                    </div>


                    <div id="filterSlider">

                        @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
                    </div>
                </div>
            </div>


        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
