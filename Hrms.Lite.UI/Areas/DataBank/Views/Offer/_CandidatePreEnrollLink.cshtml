@model Hrms.Lite.Shared.DataBank.DTO.OfferLetter

<script src="~/js/settings.js"></script>
@*<script>
        $(document).ready(function () {
            fillData();
        });
</script>*@
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table  candidate_preentrolllink_list">


    @Html.HiddenFor(m => Model.OfferLetterList.Count)



    <table id="offercandidatelink" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">Sl no</th>
                <th scope="col">Candidate Name</th>
                <th scope="col">Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col" data-bs-toggle="tooltip" data-placement="right" title="Expected DOJ">E:DOJ</th>
                <th scope="col">Email</th>
                <th scope="col">Mobile</th>
                @* <th scope="col">E:DOJ</th>*@
                <th scope="col"></th>


            </tr>
        </thead>
        <tbody>

            @{
                if (Model.OfferLetterList != null && Model.OfferLetterList.Count > 0)
                {
                    for (int i = 0; i < Model.OfferLetterList.Count; i++)

                    {



                        <tr>

                            <td data-label="Sl no">
                                @*@Model.OfferLetterList[i].EmployeeID*@

                                @(i+1)
                            </td>
                            @Html.HiddenFor(m => m.OfferLetterList[i].PreEnrollCode)
                            @Html.HiddenFor(m => m.OfferLetterList[i].PreEnrollGI)

                            <td data-label="Candidate Name">@Model.OfferLetterList[i].EmployeeName </td>
                            <td data-label="Designation">@Model.OfferLetterList[i].Designation </td>
                            <td data-label="Department">@Model.OfferLetterList[i].Department</td>
                            <td data-label="Location">@Model.OfferLetterList[i].Location</td>
                            <td data-label="E:DOJ">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.OfferLetterList[i].DOJ)) </td>
                            <td data-label="Email">@Model.OfferLetterList[i].Email</td>
                            <td data-label="Mobile">@Model.OfferLetterList[i].Mobile</td>
                            @*<td data-label="Y/S">@Html.CheckBoxFor(model => model.OfferLetterList[i].YOS, new { @class = "checkbox-class" })</td>*@


                            <td data-label="Select">
                                <div class="checkbox-inline justify-content-center">
                                    <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                        @Html.CheckBoxFor(m => m.OfferLetterList[i].Applicable)
                                        <span></span>
                                    </label>
                                </div>
                            </td>



                        </tr>

                    }
                }

            }








        </tbody>


    </table>
    <div class="row card-footer-bottom-fixed ProceedClick " id="candidatelink" >

        <div class="col-md-12 align-right">
            <a type="button" class="btn btn-default mobile-full-width" id="HRProceedButton" onclick="SendCandidateLink()" >
                Send mail
            </a>

        </div>


    </div>
</div>
