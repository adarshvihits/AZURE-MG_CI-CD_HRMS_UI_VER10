<script>

    function OnApproveClick(ReportName, PreEnrollCode, EmpCode, EmpGI,mode) {
        debugger;

        swal.fire({
            text: "Do you want to Approve?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Ok'
        }).then((result) => {
            if (result.isConfirmed) {

                $.ajax({

                    type: 'POST',
                    url: '/DataBank/Offer/GenerateReportPDF',
                    dataType: 'json',
                    data: { ReportName: ReportName, PreEnrollCode: PreEnrollCode, EmpGI: EmpGI, EmpCode: EmpCode, Mode: mode },
                    success: function (result) {
                        debugger;
                        if (result.success == true) {
                            debugger
                            swal.fire(result.message).then(function () {
                                debugger;
                                var url = "/DataBank/Offer/Index"
                                window.location.href = url;
                            });

                        }

                        else {
                            debugger;
                            swal.fire(result.message).then(function () {
                                var url = "/DataBank/Offer/GetList?TabIndex=" + 'APPROVAL PENDING';

                                $('#offerverification').load(url, function () { });
                                //var url = "/Recruitment/OfferProcessing/GertOfferLetter?PreEnrollCode=" + PreEnrollCode + "&PreEnrollGI=" + PreEnrollGI;
                                //window.open(url, "_blank");
                               // window.location.reload();


                            });
                        }

                    },
                    error: function (xhr, textStatus, errorThrown) {
                        if ($($.parseHTML(xhr.responseText)).filter(".Login_Session").length > 0) {
                            window.location.reload();
                        }
                        else {
                            document.body.id = "kt_body";
                            $('body').html(xhr.responseText);
                        }
                    }
                });
            }
            else {
                return false;
            }
        })
    }

</script>


