@model Hrms.Lite.Shared.DataBank.p2pRecognition

<script src="~/js/tooltip.js"></script>
<script src="~/js/bootstrap-datepicker.js"></script>




@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "RecognitionSlider" }))
{
    <div id="resignationdelete" class="slider-forms slider-forms-open Recognition">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('Recognition')"><i class="ki ki-close icon-xs text-muted"></i></div>
            <h4 class="mb-4"> p2p Recognition</h4>
            <div class="profile-header position-relative pb-12 mb-5"
                 style="padding-bottom: 2px !important; padding-top: 5px !important;">
                <div class="row">
                    @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeSliderHeader.cshtml", Model.EmployeeHeader)
                </div>
                <div class="profile-header-overflow"></div>
            </div>



            <div class="reward-section border-none">

                <div class="row">

                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Reward</label>
                            <div class="view-details">
                                @Html.HiddenFor(Model => Model.EmployeeGI)
                                @Html.HiddenFor(Model => Model.RewardCode)
                                @Model.Remarks
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer pb-2">
                            <label class="view-title">Entry Date</label>
                            <div class="view-details">
                                @Model.EntryDate
                            </div>
                            <span id="EntryDate"></span>
                        </div>
                    </div>
                </div>
                <div class="row">


                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Remarks</label>
                            <div class="view-details">
                                @Html.HiddenFor(Model => Model.EmployeeGI)
                                @Html.HiddenFor(Model => Model.RewardCode)
                                @Model.ReplyStatus
                            </div>
                        </div>
                    </div>


                </div>
                <div class="row">


                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Recommended By</label>
                            <div class="view-details">
                                @Html.HiddenFor(Model => Model.EmployeeGI)
                                @Html.HiddenFor(Model => Model.RewardCode)
                                @Html.HiddenFor(Model => Model.RecommendedbyEmpid)
                                @Model.Recommendedby
                                <span id="Recommendedby"></span>
                            </div>
                        </div>
                    </div>


                </div>
                @if (Model.radiomode == 0)
                {
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Reward</label><span class="Mandatory">*</span>

                                @Html.DropDownListFor(m => m.Rewards.Code, (SelectList)ViewBag.Rewards, "Select Reward", new { @class = "form-control form-control-sm", @onchange = "onRewardChange(this,'reward')", tabindex = "@(++tabindex)" })
                                <span id="reward"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Point Criteria</label><span class="Mandatory">*</span>
                                @Html.DropDownListFor(m => m.PointCriteria.Code, (SelectList)ViewBag.PointCriteria, "Select Point Criteria", new { @class = "form-control form-control-sm", @onchange = "onPointCriteriaChange(this,'pointCriteria')", tabindex = "@(++tabindex)" })
                                <span id="pointCriteria"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="row-outer">
                                <label class="view-title">Points</label>
                                <div class="view-details">

                                    <span class="Points">@Html.DisplayFor(model => Model.PointCriteria.Points)</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">

                        <div class="col-md-6">
                            <label>Reward Date</label><span class="Mandatory">*</span>
                            <div class="input-group date">

                                @Html.TextBoxFor(m => m.RewardDate, "{0:dd/MMM/yyyy}", new { @class = "form-control kt_datepicker_8", @placeholder = "Reward Date", @onchange = "validate(this, 'rewardDate')", tabindex = "@(++tabindex)" })

                                <div class="input-group-append">
                                    <span class="input-group-text">
                                        <i class="la la-calendar"></i>
                                    </span>
                                </div>

                            </div>
                            <span id="rewardDate"></span>
                        </div>
                    
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Recommended for</label>
                                <div class="view-details">
                                    @Html.HiddenFor(Model => Model.EmployeeGI)
                                    @Html.HiddenFor(Model => Model.Recommendedfor)
                                    @Model.Recommendedfor
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row my-3">

                        <div class="col-md-12">
                            <label>Action taken</label>

                            @Html.TextAreaFor(Model => Model.Reply, new { @class = "form-control form-control-sm", @placeholder = "Action", maxlength = "250" })
                            @*@Html.HiddenFor(Model => Model.ResignationDeleteDetails.Reason)*@
                        </div>
                        <span id="DeleteReason"></span>
                    </div>
                }
                else
                {
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Reward</label>

                                @Html.DropDownListFor(m => m.Rewards.Code, (SelectList)ViewBag.Rewards, "Select Reward", new { @class = "form-control form-control-sm", @onchange = "onRewardChange(this,'reward')", tabindex = "@(++tabindex)",  @disabled = "disabled" })
                                <span id="reward"></span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Point Criteria</label>
                                @Html.DropDownListFor(m => m.PointCriteria.Code, (SelectList)ViewBag.PointCriteria, "Select Point Criteria", new { @class = "form-control form-control-sm", @onchange = "onPointCriteriaChange(this,'pointCriteria')", tabindex = "@(++tabindex)", @disabled = "disabled" })
                                <span id="pointCriteria"></span>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="row-outer">
                                <label class="view-title">Points</label>
                                <div class="view-details">

                                    <span class="Points">@Html.DisplayFor(model => Model.PointCriteria.Points)</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">

                        <div class="col-md-6">
                            <label class="view-title">Reward Date</label>
                            <div class="view-details">
                                @Model.RewardDate
                            </div>
                            <span id="rewardDate"></span>
                        </div>
                           
                    
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Recommended for</label>
                                <div class="view-details">
                                    @Html.HiddenFor(Model => Model.EmployeeGI)
                                    @Html.HiddenFor(Model => Model.Recommendedfor)
                                    @Model.Recommendedfor
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row my-3">

                        <div class="col-md-12">
                            <label class="view-title">Action taken</label>
                            <div class="view-details">
                                @Html.DisplayFor(Model => Model.Reply)
                            </div>
                            
                        </div>
                        <span id="DeleteReason"></span>
                    </div>
                }

                @if (Model.radiomode == 0)
                {
                    <div class="row card-footer-bottom-fixed border-none">

                        <div class="col-md-12 align-right">

                            <button type="button" class="btn btn-default  mobile-full-width" onclick="Recognitionsave()">
                                Save
                            </button>

                        </div>


                    </div>
                }

            </div>




        </div>
    </div>
}