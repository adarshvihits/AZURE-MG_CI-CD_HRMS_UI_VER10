<div class="ihits-table table-border hover-color odd-even mobile-responsive-table ">
    @Html.HiddenFor(m => m.p2pRecognitionList.Count)
    <table id="ResignationDeleteTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">Reward</th>
                <th scope="col">Action</th>

            </tr>
        </thead>
        <tbody>
            @if (Model.p2pRecognitionList != null && Model.p2pRecognitionList.Count > 0)
            {
                for (int i = 0; i < Model.p2pRecognitionList.Count; i++)
                {
                    @Html.HiddenFor(m=>m.p2pRecognitionList[i].RewardCode)
                    @Html.HiddenFor(m=>m.p2pRecognitionList[i].EmployeeGI)
                    <tr>
                        <td data-label="ID">@Model.p2pRecognitionList[i].EmployeeID</td>
                        <td data-label="Employee Name">
                            @Model.p2pRecognitionList[i].EmployeeName
                        </td>
                        <td data-label="Designation">@Model.p2pRecognitionList[i].Designation.Name</td>
                        <td data-label="Department">@Model.p2pRecognitionList[i].Department.Name </td>
                        <td data-label="Location">@Model.p2pRecognitionList[i].Location.Name</td>       
                        <td data-label="Stage">@Model.p2pRecognitionList[i].Remarks</td>


                        <td data-label="Action">
                            <a data-bs-toggle="tooltip" title="Edit"
                               id="categoryedit"
                               class="btn btn-icon btn-edit icon-only" onclick="onEditClick('@Model.p2pRecognitionList[i].EmployeeGI', '@Model.p2pRecognitionList[i].RewardCode')">
                                <i class="icon-xl fas fa-pencil-alt"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                @*<tr><td colspan="11"> No data found</td></tr>*@
            }




        </tbody>
    </table>
</div>
