@model Hrms.Lite.Shared.DataBank.DTO.AppraisalRequest
<td data-label="Evaluation Period">
    @*<a id="editevaluationperiod" class="slider-btn">Last 6 month</a>*@
    <div id="editevaluationperiod" class="slider-forms slider-forms-open appraisalclose">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('appraisalclose')"><i class="ki ki-close icon-xs text-muted"></i></div>
            <h4>Appraisal List</h4>
            <div class="row">
                <div class="col-md-4">
                    <div class="row-outer">
                        <label class="view-title">Evaluation Period</label>
                        <div class="view-details">
                            @Model.EvaluationPeriod.Name
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="row-outer">
                        <label class="view-title">Appraisal Type</label>
                        <div class="view-details">
                            @Model.AppraisalType.Name
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="row-outer">
                        <label class="view-title">Self Score</label>
                        <div class="view-details">
                            @Model.SelfScore
                        </div>
                    </div>
                </div>

            </div>
            <div class="row">


                <div class="col-md-8">
                    <div class="row-outer">
                        <label class="view-title">Appraiser Name</label>
                        <div class="view-details">
                            @Model.Appraiser.Name
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="row-outer">
                        <label class="view-title">Appraiser Score</label>
                        <div class="view-details">
                            @Model.AppraiserScore
                        </div>
                    </div>
                </div>

            </div>

            <div class="row">

                <div class="col-md-8">
                    <div class="row-outer">
                        <label class="view-title">Reviewer Name</label>
                        <div class="view-details">
                            @Model.Reviewer.Name
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="row-outer">
                        <label class="view-title">Reviewer Score</label>
                        <div class="view-details">
                            @Model.ReviewerScore
                        </div>
                    </div>
                </div>

            </div>


            <div class="row">


                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Recommendation</label>
                        <div class="view-details">
                            @Model.Recommendation.Name
                        </div>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="row-outer">
                        <label class="view-title">Remarks</label>
                        <div class="view-details">
                            @Model.Remarks
                        </div>
                    </div>
                </div>

            </div>
            <div class="row">




            </div>



        </div>
    </div>
</td>