@model Hrms.Lite.Shared.DataBank.DTO.Appraisal
    <script src="~/js/tooltip.js"></script>
    <div id="AppraisalView" class="slider-forms slider-forms-open delete-appraisal">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('delete-appraisal')"><i class="ki ki-close icon-xs text-muted"></i></div>
            <h4>Appraisal List</h4>
            <div class="profile-header position-relative pb-12 mb-5"
                 style="padding-bottom: 2px !important; padding-top: 5px !important;">
                <div class="row">
                    @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeSliderHeader.cshtml", Model.EmployeeHeader)
                </div>
                <div class="profile-header-overflow"></div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="row-outer">
                        <label class="view-title">Evaluation Period</label>
                        <div class="view-details">
                            @Model.AppraisalRequest.EvaluationPeriod.Name
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="row-outer">
                        <label class="view-title">Appraisal Type</label>
                        <div class="view-details">
                            @Model.AppraisalRequest.AppraisalType.Name
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="row-outer">
                        <label class="view-title">Self Score</label>
                        <div class="view-details">
                            @Model.AppraisalRequest.SelfScore
                        </div>
                    </div>
                </div>

            </div>
            <div class="row">


                <div class="col-md-8">
                    <div class="row-outer">
                        <label class="view-title">Appraiser Name</label>
                        <div class="view-details">
                            @Model.AppraisalRequest.Appraiser.Name
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="row-outer">
                        <label class="view-title">Appraiser Score</label>
                        <div class="view-details">
                            @Model.AppraisalRequest.AppraiserScore
                        </div>
                    </div>
                </div>

            </div>

            <div class="row">

                <div class="col-md-8">
                    <div class="row-outer">
                        <label class="view-title">Reviewer Name</label>
                        <div class="view-details">
                            @Model.AppraisalRequest.Reviewer.Name
                            @Model.AppraisalRequest.Reviewer.GI
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="row-outer">
                        <label class="view-title">Reviewer Score</label>
                        <div class="view-details">
                            @Model.AppraisalRequest.ReviewerScore
                        </div>
                    </div>
                </div>

            </div>


            <div class="row">


                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Recommendation</label>
                        <div class="view-details">
                            @Model.AppraisalRequest.Recommendation.Name
                        </div>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="row-outer">
                        <label class="view-title">Remarks</label>
                        <div class="view-details">
                            @Model.AppraisalRequest.Remarks
                        </div>
                    </div>
                </div>

            </div>
            <div class="row card-footer-bottom-fixed mt-2">
                <div class="col-md-12 pr-4 float-right-btn">
                    <a type="button" data-bs-toggle="tooltip" title="" data-bs-original-title="Delete"
                            class="btn btn-icon btn-delete big-btn float-none" onclick="onDeleteAppraisal('@Model.AppraisalRequest.AppraisalTrnGI')">
                        <i class="icon-xl far fa-trash-alt"></i>
                    </a>

                </div>
            </div>


        </div>
    </div>