@model Hrms.Lite.Shared.DataBank.DTO.Appraisal
    <script>
    $(document).ready(function () {
        debugger;
        $('#EmpId').val("");
        //$('select > option:first').hide();
        $("#EmpId").find("option").eq(0).hide();
    });
    </script>
    <div id="addNewAPPraisal" class="slider-forms slider-forms-open add-appraisal">
        <div class="slider-inner-style">
            <div class="slider-form-close"><i class="ki ki-close icon-xs text-muted"></i></div>
            <h4>Appraisal List</h4>
            <div class="slider-search-field">
                @Html.DropDownListFor(m => m.EmpId, (SelectList)ViewBag.Emp, "Search by Employee Name/ID", new
                    {
                        @class = "selectpicker sliderSearchInput form-control form-control-sm",
                        @onchange = "OnEmpChange(this)",
                        data_show_subtext = "true",
                   data_live_search = "true"
               })

                @await Html.PartialAsync("~/Areas/DataBank/Views/Appraisal/_EmployeeCard.cshtml", Model.EmployeeHeader)
            </div>

        </div>
    </div>