@model IList<Hrms.Lite.Shared.DataBank.DTO.AppraisalLog>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table appraisal-entry ">
    <table>
        <thead>
            <tr class="table-dark">
                <th scope="col">SlNo</th>
                <th scope="col">Evaluation Period</th>
                <th scope="col">Appraisal Type</th>
                <th scope="col">Self Score</th>
                <th scope="col">Appraiser Score</th>
                <th scope="col"  >Reviewer Score</th>
                <th scope="col">Recommendation</th>


            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {

                for (int i = 0; i < Model.Count; i++)
                {
            <tr>
                <td data-label="SlNo">@(i + 1)</td>
                <td data-label="Code">
                    @Html.HiddenFor(Model => Model[i].AppraisalRequest.AppraisalTrnGI)
                    <a id="EditDisciplinaryIncidentsEntryDetails" class="slider-btn" onclick="onAppraisalEvaluationPeriodClick('@Model[i].AppraisalRequest.AppraisalTrnGI')">@Model[i].AppraisalRequest.EvaluationPeriod.Name</a>
                    @*<div id="assetlog" class="hide">
                @await Html.PartialAsync("_AssetLog", Model)
            </div>*@

                </td>
                <td data-label="Appraisal Type">@Model[i].AppraisalRequest.AppraisalType.Name</td>
                <td data-label="Self Score">@Model[i].AppraisalRequest.SelfScore</td>
                <td data-label="Appraiser Score">@Model[i].AppraisalRequest.AppraiserScore</td>
                <td data-label="Reviewer Score">@Model[i].AppraisalRequest.ReviewerScore</td>
                <td data-label="Recommendation">@Model[i].AppraisalRequest.Recommendation.Name</td>
            </tr>
                }
            }
        </tbody>
    </table>
</div>
















