@model Hrms.Lite.Shared.DataBank.DTO.PersonalDetails
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "PoliceVerificationSave" }))
{

    <div class="row">
        <div class="col-md-3">
            @{
                Model.TabIndex = "PoliceVerification";
            }
            @Html.HiddenFor(m => m.TabIndex)
            @Html.HiddenFor(m => m.EmployeeGI)
            @Html.HiddenFor(m => m.PoliceVerificationLogGI)
            @Html.HiddenFor(m => m.ApproveMode)
            
            <div class="form-group">
                <label class="view-title" cursorshover="true">
                    Date Of Verification
                </label>
                <div class="view-details">
                    @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.PoliceVerification.VerificationDate))                    
                </div>

            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label class="view-title">Police Station Details</label>
                <div class="view-details">
                    @Model.PoliceVerification.PoliceStationDetails
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label class="view-title">Details Of Attesting Authority</label>
                <div class="view-details">
                    @Model.PoliceVerification.DetailsAuthority
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label class="view-title">Country</label>
                <div class="view-details">
                    @Model.PoliceVerification.Country.Name
                </div>
            </div>
        </div>

    </div>

    <div class="row my-3">
        <div class="col-md-3">
            <div class="form-group">
                <label class="view-title">State</label>
                <div class="view-details">
                    @Model.PoliceVerification.State.Name
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label class="view-title">District</label>
                <div class="view-details">
                    @Model.PoliceVerification.District.Name
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label class="view-title">Remarks</label>
                <div class="view-details">
                    @Model.PoliceVerification.Remarks
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label class="view-title">File</label>
                <div class="view-details">
                    <button data-bs-toggle="tooltip" title="" type="button" class=" btn btn-icon btn-eye icon-only pr-2" onclick="showDocument('@Model.PoliceVerification.Attachment.FileName', '@Model.PoliceVerification.Attachment.AbsoluteUri')" data-bs-original-title="View File">
                        <i class="icon-xl far fa-eye"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 align-right">

            <button type="button" id="AddressRejectbtnId"
                    class="btn btn-danger  mobile-full-width" onclick="PersonalProfilePoliceVerificationDetailsApprove('REJECT')">
                Reject
            </button>
            <button type="button" id="AddressApprovebtnId"
                    class="btn btn-default  mobile-full-width" onclick="PersonalProfilePoliceVerificationDetailsApprove('APPROVE')">
                Approve
            </button>
        </div>
    </div>
}