@model Hrms.Lite.Shared.DataBank.DTO.PersonalDetails
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/scripts/DataBank/CandidatePreEnrolLink.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        if ('@Model.ProfilePicApprovalPending' == 'False') {
            $('#tabprofile').addClass('active');
            $('.tabprofile').addClass('active');

        }
        else if ('@Model.AddressApprovalPending' == 'False') {
            $('#tabOne').addClass('active');
            $('.tabOne').addClass('active');

        }
        else if ('@Model.ContactDetailsApprovalPending' == 'False') {
            $('#tabContactDetails').addClass('active');
            $('.tabContactDetails').addClass('active');

        }
        else if ('@Model.PersonalInfoApprovalPending' == 'False') {
            $('#tabTwo').addClass('active');
            $('.tabTwo').addClass('active');

        }
        else if ('@Model.FamilyDetailsApprovalPending' == 'False') {
            $('#tabThree').addClass('active');
            $('.tabThree').addClass('active');

        }
        else if ('@Model.EducationApprovalPending' == 'False') {
            $('#tabFive').addClass('active');
            $('.tabFive').addClass('active');

        }
        else if ('@Model.SkillsApprovalPending' == 'False') {
            $('#tabSeven').addClass('active');
            $('.tabSeven').addClass('active');

        }
        else if ('@Model.CertificationApprovalPending' == 'False') {
            $('#tabTen').addClass('active');
            $('.tabTen').addClass('active');

        }
        else if ('@Model.PreviousEmploymentApprovalPending' == 'False') {
            $('#tabSix').addClass('active');
            $('.tabSix').addClass('active');

        }
        else if ('@Model.EmployeeVsNomineeApprovalPending' == 'False') {
            $('#tabEleven').addClass('active');
            $('.tabEleven').addClass('active');

        }
        else if ('@Model.BankDetailsApprovalPending' == 'False') {
            $('#tabTwelve').addClass('active');
            $('.tabTwelve').addClass('active');

        }
        else if ('@Model.DocumentDetailsApprovalPending' == 'False') {
            $('#tabThirteen').addClass('active');
            $('.tabThirteen').addClass('active');

        }
        else if ('@Model.PoliceVerificationApprovalPending' == 'False') {
            $('#tabfourteen').addClass('active');
            $('.tabfourteen').addClass('active');

        }
        else if ('@Model.MedicalCheckupApprovalPending' == 'False') {
            $('#tabfifteen').addClass('active');
            $('.tabfifteen').addClass('active');

        }
        else
        {

            var redirectUrl = '/DataBank/CandidatePreEnrolLink/Index';
            window.location.href = redirectUrl;
        }

  });
</script>


<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Personal Profile Approval</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot p-0 mt-1 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a href="@Url.Action("Index", "CandidatePreEnrolLink", new { Area = "DataBank" })" class="">PreEnrollment Approval List</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        PreEnrollment Approval
                    </li>
                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->


<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per">

                <div class="card-body">

                    <!--begin: Search Form-->
                    <div class="profile-header">
                        <div class="row">

                            <div class="col-md-12 pl-10">
                                <div class="row">
                                    <div class="image-input image-input-outline image-input-circle  float-right mr-5" id="kt_image_4"
                                         style="background-image: url(@Model.enrollment.PreEnrollment.BasicInfo.File.AbsoluteUri)">
                                        <div class="image-input-wrapper">
                                        </div>
                                    </div>
                                    <div class="flex-grow-1">
                                        <!--begin::Title-->
                                        <div class="d-flex justify-content-between flex-wrap mt-2">
                                            <div class="d-flex mr-3 header-profile-name">
                                                @*<a class="header-profile-name">Krishnakumar VG</a>
                                                    <span> ( IHS001 )</span>*@
                                                <a href="#" class="">@Model.enrollment.PreEnrollment.BasicInfo.FullName</a>
                                            </div>

                                        </div>

                                        <!--end::Title-->
                                        <!--begin::Content-->
                                        <div class="d-flex flex-wrap justify-content-between">
                                            <div class="d-flex flex-column flex-grow-1 pr-8">
                                                <div class="d-flex flex-wrap mb-1">
                                                    <a data-bs-toggle="tooltip" data-bs-original-title="Fun.Designation" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                        <i class="fas fa-briefcase icon-nm mr-2"></i>@Model.enrollment.PreEnrollment.JobDetails.Designation.Name
                                                    </a>
                                                    <a data-bs-toggle="tooltip" data-bs-original-title="Department" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                        <i class="fas fa-calendar-alt icon-nm mr-2"></i>@Model.enrollment.PreEnrollment.JobDetails.Department.Name
                                                    </a>
                                                    <a data-bs-toggle="tooltip" data-bs-original-title="Location" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                        <i class="fas fa-map-marker-alt icon-nm mr-2"></i>@Model.enrollment.PreEnrollment.JobDetails.Location.Name
                                                    </a>
                                                    <a data-bs-toggle="tooltip" data-bs-original-title="Category" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                        <i class="fas fa-network-wired icon-nm mr-2"></i>@Model.enrollment.PreEnrollment.JobDetails.Category.Name
                                                    </a>
                                                    <a data-bs-toggle="tooltip" data-bs-original-title="Reporting Manager" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                        <i class="fas fa-user-tie icon-nm mr-2"></i>
                                                        @Model.enrollment.EmployeeSettings.ReportingManager.Name
                                                    </a>


                                                </div>



                                            </div>



                                        </div>

                                        <!--end::Content-->
                                    </div>

                                </div>







                            </div>
                        </div>



                        <div class="profile-header-overflow"></div>
                    </div>
                    <!-- Table Section -->


                    <div class="tab-outer accordion-only pt-4">
                        @Html.HiddenFor(m=>m.enrollment.PreEnrollment.PreEnrollGI)
                        <ul class="ulList">

                            @if (Model.ProfilePicApprovalPending == false)
                            {
                                <div class="TabMoving"></div>
                                <li class="tabprofile clickOnTab">Profile Photo</li>
                                <div id="tabprofile" class="tab-content">
                                    @await Html.PartialAsync("_ProfilePic", Model)
                                </div>
                            }
                            @if (Model.AddressApprovalPending == false)
                            {
                                <div class="TabMoving"></div>
                                <li class="tabOne clickOnTab">Address</li>
                                <div id="tabOne" class="tab-content">
                                    @await Html.PartialAsync("_Address", Model)
                                </div>
                            }
                            @if (Model.ContactDetailsApprovalPending == false)
                            {
                                <!-- Contact Details Info Tab -->
                                <div class="TabMoving"></div>
                                <li class="tabContactDetails clickOnTab">Contact Details</li>
                                <div id="tabContactDetails" class="tab-content">
                                    @await Html.PartialAsync("_ContactDetails", Model)
                                </div>
                                <!-- Contact Details Info Tab -->
                            }
                            @if (Model.PersonalInfoApprovalPending == false)
                            {
                                <!-- Personal Info Tab -->
                                <div class="TabMoving"></div>
                                <li class="tabTwo clickOnTab">Personal Info</li>
                                <div id="tabTwo" class="tab-content">
                                    @await Html.PartialAsync("_PersonalInfo", Model)
                                </div>
                                <!-- Personal Info Tab -->
                            }
                            @if (Model.FamilyDetailsApprovalPending == false)
                            {
                                <!-- Family Details Tab -->
                                <div class="TabMoving"></div>
                                <li class="tabThree clickOnTab">Family Details</li>
                                <div id="tabThree" class="tab-content">
                                    @await Html.PartialAsync("_FamilyDetails", Model)
                                </div>
                                <!-- Family Details Tab -->
                            }
                            @if (Model.EducationApprovalPending == false)
                            {
                                <!-- Education Details Tab -->
                                <div class="TabMoving"></div>
                                <li class="tabFive clickOnTab">Education</li>
                                <div id="tabFive" class="tab-content">
                                    @await Html.PartialAsync("_Education", Model)
                                </div>
                                <!-- Education Details Tab -->
                            }
                            @if (Model.SkillsApprovalPending == false)
                            {
                                <!-- Skill Info Tab -->
                                <div class="TabMoving"></div>
                                <li class="tabSeven clickOnTab">Skills</li>
                                <div id="tabSeven" class="tab-content">
                                    @await Html.PartialAsync("_Skills", Model)
                                </div>
                                <!-- Skills Info Tab -->
                            }
                            @if (Model.CertificationApprovalPending == false)
                            {
                                <!-- Certification Tab -->
                                <div class="TabMoving"></div>
                                <li class="tabTen clickOnTab">Certifications</li>
                                <div id="tabTen" class="tab-content">
                                    @await Html.PartialAsync("_Certifications", Model)
                                </div>
                                <!-- Certification Tab -->
                            }
                            <!-- Previous Employment Tab -->
                            @if (Model.PreviousEmploymentApprovalPending == false)
                            {

                                <div class="TabMoving"></div>
                                <li class="tabSix clickOnTab">Previous Employment</li>
                                <div id="tabSix" class="tab-content">
                                    @await Html.PartialAsync("_PreviousEmployment", Model)
                                </div>

                            }
                            <!-- Previous Employment Tab -->
                            <!-- Employee Vs Nominee Tab -->
                            @if (Model.EmployeeVsNomineeApprovalPending == false)
                            {

                                <div class="TabMoving"></div>
                                <li class="tabEleven clickOnTab">Employee Vs Nominee</li>
                                <div id="tabEleven" class="tab-content">
                                    @await Html.PartialAsync("_EmployeeVsNominee", Model)
                                </div>

                            }

                            <!-- Employee Vs Nominee Tab -->
                            <!-- Bank Details Tab -->
                            @if (Model.BankDetailsApprovalPending == false)
                            {

                                <div class="TabMoving"></div>
                                <li class="tabTwelve clickOnTab">Bank Details</li>
                                <div id="tabTwelve" class="tab-content">
                                    @await Html.PartialAsync("_BankDetails", Model)
                                </div>

                            }

                            <!-- Bank Details Tab -->
                            <!-- Document Details Tab -->
                            @if (Model.DocumentDetailsApprovalPending == false)
                            {

                                <div class="TabMoving"></div>
                                <li class="tabThirteen clickOnTab">Document Details</li>
                                <div id="tabThirteen" class="tab-content">
                                    @await Html.PartialAsync("_Documents", Model)
                                </div>

                            }

                            @if (Model.PoliceVerificationApprovalPending == false)
                            {
                                <div class="TabMoving"></div>
                                <li class="tabfourteen clickOnTab">Police Verification </li>
                                <div id="tabfourteen" class="tab-content">
                                    @await Html.PartialAsync("_PoliceVerification", Model)
                                </div>
                            }
                            @if (Model.MedicalCheckupApprovalPending == false)
                            {
                                <div class="TabMoving"></div>
                                <li class="tabfifteen clickOnTab">Medical Checkup</li>
                                <div id="tabfifteen" class="tab-content">
                                    @await Html.PartialAsync("_MedicalCheckup", Model)

                                </div>
                            }
                                <!-- Document Details Tab -->
                            </ul>
                    </div>

                    <!-- Table Setion End -->
                   


                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>
<!--end::Content-->