@model Hrms.Lite.Shared.DataBank.DTO.PersonalDetails
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "MedicalCheckupSave" }))
{
    <div class="row">
        <div class="col-md-3">
            @{
                Model.TabIndex = "MedicalCheckup";
            }
            @Html.HiddenFor(m => m.TabIndex)
            @Html.HiddenFor(m => m.EmployeeGI)
            @Html.HiddenFor(m => m.MedicalCheckupLogGI)
            @Html.HiddenFor(m => m.ApproveMode)
            <div class="form-group">
                <label class="view-title" cursorshover="true">
                    Checkup Type
                </label>
                <div class="view-details">
                   @Model.MedicalCheckup.CheckupType.Name
                </div>

            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label class="view-title">Date Of Checkup</label>
                <div class="view-details">     
                    @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.MedicalCheckup.CheckupDate))
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label class="view-title">Hospital/ Clinic Details</label>
                <div class="view-details">
                    @Model.MedicalCheckup.HospitalDetails
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label class="view-title">Checkup Validity</label>
                <div class="view-details">                   
                    @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.MedicalCheckup.CheckupValidity))
                </div>
            </div>
        </div>

    </div>

    <div class="row my-3">
        <div class="col-md-3">
            <div class="form-group">
                <label class="view-title">Health Card Number</label>
                <div class="view-details">
                    @Model.MedicalCheckup.HealthCardNumber
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label class="view-title">Checkup Details</label>
                <div class="view-details">
                    @Model.MedicalCheckup.CheckupDetails
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label class="view-title">Checkup By</label>
                <div class="view-details">
                    @Model.MedicalCheckup.CheckupBy
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label class="view-title">Remarks</label>
                <div class="view-details">
                    @Model.MedicalCheckup.Remarks
                </div>
            </div>
        </div>

    </div>
    <div class="row">
        <div class="col-md-3">
            <div class="form-group">
                <label class="view-title">File</label>
                <div class="view-details">
                    <button data-bs-toggle="tooltip" title="" type="button" class=" btn btn-icon btn-eye icon-only pr-2" onclick="showDocument('@Model.MedicalCheckup.Attachment.FileName', '@Model.MedicalCheckup.Attachment.AbsoluteUri')" data-bs-original-title="View File">
                        <i class="icon-xl far fa-eye"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 align-right">

            <button type="button" id="AddressRejectbtnId"
                    class="btn btn-danger  mobile-full-width" onclick="PersonalProfileMedicalCheckupDetailsApprove('REJECT')">
                Reject
            </button>
            <button type="button" id="AddressApprovebtnId"
                    class="btn btn-default  mobile-full-width" onclick="PersonalProfileMedicalCheckupDetailsApprove('APPROVE')">
                Approve
            </button>
        </div>
    </div>
}