@model Hrms.Lite.Shared.DataBank.DTO.PersonalDetails

@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "EmployeeVsNomineeSave" }))
{
    <div class="row">

        <div class="col-md-6">


            <div class="row">

                <div class="col-md-6">
                    @{
                        Model.TabIndex = "EmployeeVsNominee";
                    }
                    @Html.HiddenFor(m => m.TabIndex)
                    @Html.HiddenFor(m => m.EmployeeGI)
                    @Html.HiddenFor(m => m.EmployeeVsNomineeLogGI)
                    @Html.HiddenFor(m => m.ApproveMode)
                    <div class="form-group">
                        <label class="view-title">Name</label>
                        <div class="view-details">
                            @Model.EmployeeVsNominee.Name
                        </div>
                    </div>
                </div>
                <div class="col-md-6">

                    <div class="form-group">
                        <label class="view-title">Relation</label>
                        <div class="view-details">
                            @Model.EmployeeVsNominee.Relation.Name
                        </div>
                    </div>
                </div>
            </div>


        </div>

        <div class="col-md-6">

            <div class="row">

                <div class="col-md-6">

                    <div class="form-group">
                        <label class="view-title">Mobile</label>
                        <div class="view-details">
                            @Model.EmployeeVsNominee.Mobile
                        </div>
                    </div>
                </div>
                <div class="col-md-6">

                    <div class="form-group">
                        <label class="view-title">Aadhar Number</label>
                        <div class="view-details">
                            @Model.EmployeeVsNominee.Aadhar
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>


    <div class="row">
        <div class="col-md-12 align-right">
            <button type="button" id="EmployeeVsNomineeLabel"
                    class="btn btn-default mobile-full-width hide">
                Test
            </button>
            <button type="button" id="EmployeeVsNomineeRejectbtnId"
                    class="btn btn-danger mobile-full-width" onclick="PersonalProfileEmployeeVsNomineeApprove('REJECT')">
                Reject
            </button>
            <button type="button" id="EmployeeVsNomineeApprovebtnId"
                    class="btn btn-default mobile-full-width" onclick="PersonalProfileEmployeeVsNomineeApprove('APPROVE')">
                Approve
            </button>
        </div>
    </div>
}