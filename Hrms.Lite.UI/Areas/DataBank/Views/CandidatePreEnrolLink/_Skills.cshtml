@model Hrms.Lite.Shared.DataBank.DTO.PersonalDetails
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "SkillsSave" }))
{
    <div class="row">
        <div class="col-md-12">
            @{
                Model.TabIndex = "Skills";
            }
            @Html.HiddenFor(m => m.TabIndex)
            @Html.HiddenFor(m => m.EmployeeGI)
            @Html.HiddenFor(m => m.ApproveMode)
            <div class="ihits-table table-border mobile-responsive-table personal-profile-education-section mb-2">
                <table>
                    <thead>
                        <tr class="table-dark">
                            <th scope="col">Skill</th>
                            <th scope="col">Skill Type</th>
                            <th scope="col">Skill Name</th>
                            <th scope="col"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @Html.HiddenFor(m => m.EmployeeGI)

                        @for (int i = 0; i < Model.Skills.Count; i++)
                        {

                            <tr id="row_OI_@i">
                                <td data-label="Qualification Type">
                                    @Html.HiddenFor(m => m.Skills[i].SkillLogGI)
                                    @Html.HiddenFor(m => m.Skills[i].flag)
                                    @Html.DisplayFor(m => m.Skills[i].Skill.Name)

                                </td>
                                <td data-label="Qualofication">

                                    @Html.DisplayFor(m => m.Skills[i].SkillType.Name)
                                </td>
                                <td data-label="Field of Study">

                                    @Html.DisplayFor(m => m.Skills[i].SkillProficiency.Name)
                                </td>
                                <td data-label="Year of Completion">
                                    <div class="row">
                                        <div class="col-md-12 align-right">
                                            <button type="button" id="SkillLabel_@i"
                                                    class="btn btn-default mobile-full-width hide">
                                                Test
                                            </button>

                                            <a data-bs-toggle="tooltip" data-bs-original-title="Reject" id="SkillsRejectbtnId_@i"
                                               class="btn_reject" onclick="PersonalProfileSkillApprove(@i,'REJECT')">

                                            </a>
                                            <a data-bs-toggle="tooltip" data-bs-original-title="Approve" id="SkillsApprovebtnId_@i"
                                               class="btn_approve" onclick="PersonalProfileSkillApprove(@i,'APPROVE')">

                                            </a>
                                        </div>
                                    </div>
                                </td>
                            </tr>

                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

}