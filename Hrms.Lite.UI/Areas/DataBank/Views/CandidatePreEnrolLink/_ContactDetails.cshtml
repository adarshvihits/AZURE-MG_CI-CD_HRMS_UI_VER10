@model Hrms.Lite.Shared.DataBank.DTO.PersonalDetails

@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "ContactDetailsSave" }))
{
    <div class="row">

        <div class="col-md-6">


            <div class="row">

                <div class="col-md-6">
                    @{
                        Model.TabIndex = "Contactdetails";
                    }
                    @Html.HiddenFor(m => m.TabIndex)
                    @Html.HiddenFor(m => m.EmployeeGI)
                    @Html.HiddenFor(m => m.ContactDetailsLogGI)
                    @Html.HiddenFor(m => m.ApproveMode)
                    <div class="form-group">
                        <label class="view-title">Personal Mobile</label>
                        <div class="view-details">
                            @Model.ContactDetails.PersonalMobile
                        </div>
                    </div>
                </div>
                <div class="col-md-6">

                    <div class="form-group">
                        <label class="view-title">Personal Email</label>
                        <div class="view-details">
                            @Model.ContactDetails.PersonalEmail
                        </div>
                    </div>
                </div>
            </div>


        </div>

        <div class="col-md-6">

            <div class="row">

                <div class="col-md-6">

                    <div class="form-group">
                        <label class="view-title">Office Number</label>
                        <div class="view-details">
                            @Model.ContactDetails.OfficeMobile
                        </div>
                    </div>
                </div>
                <div class="col-md-6">

                    <div class="form-group">
                        <label class="view-title">Office Email</label>
                        <div class="view-details">
                            @Model.ContactDetails.OfficeEmail
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>
    <div class="row">
        <div class="col-md-12">

            <div class="row">

                <div class="col-md-3">

                    <div class="form-group">
                        <label class="view-title">Emergency Contact Person</label>
                        <div class="view-details">
                            @Model.ContactDetails.EmergencyContactPerson
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="view-title">Emergency Contact Number</label>
                        <div class="view-details">
                            @Model.ContactDetails.EmergencyContactNumber
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="view-title">Relation</label>
                        <div class="view-details">
                            @Model.ContactDetails.Relation.Name
                        </div>
                    </div>
                </div>
            </div>


        </div>
    </div>


    <div class="row">
        <div class="col-md-12 align-right">
            <button type="button" id="ContactDetailsLabel"
                    class="btn btn-default mobile-full-width hide">
                Test
            </button>
            <button type="button" id="ContactRejectbtnId"
                    class="btn btn-danger mobile-full-width" onclick="PersonalProfileContactDetailsApprove('REJECT')">
                Reject
            </button>
            <button type="button" id="ContactApprovebtnId"
                    class="btn btn-default mobile-full-width" onclick="PersonalProfileContactDetailsApprove('APPROVE')">
                Approve
            </button>
        </div>
    </div>
}
