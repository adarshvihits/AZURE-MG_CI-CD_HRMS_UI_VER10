
@model Hrms.Lite.Shared.DataBank.DTO.PersonalDetails

<script src="~/js/settings.js"></script>
<script src="~/js/tooltip.js"></script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table candidate_preentroll_list">
    @Html.HiddenFor(m => m.PreEnrollCandidateLinkApprovalList.Count)
    <table id="PreEnrollCandidateLinkApprovalListApprovalTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">SlNo</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">DOJ</th>
                <th data-bs-toggle="tooltip" data-bs-original-title="Profile Photo" scope="col">Photo</th>
                <th data-bs-toggle="tooltip" data-bs-original-title="Address" scope="col">Addr</th>
                <th data-bs-toggle="tooltip" data-bs-original-title="Contact Details" scope="col">Cont</th>
                <th data-bs-toggle="tooltip" data-bs-original-title="Personal Info" scope="col">Pers</th>
                <th data-bs-toggle="tooltip" data-bs-original-title="Family Details" scope="col">Fmly</th>
                <th data-bs-toggle="tooltip" title="Education" scope="col">Educ</th>
                <th data-bs-toggle="tooltip" title="Skills" scope="col">Skills</th>
                <th data-bs-toggle="tooltip" data-bs-original-title="Certifications" scope="col">Cert</th>
                <th data-bs-toggle="tooltip" data-bs-original-title="Previous Employment" scope="col">Prev</th>
                <th data-bs-toggle="tooltip" data-bs-original-title="Employee Vs Nominee" scope="col">Nom</th>
                <th data-bs-toggle="tooltip" data-bs-original-title="Bank Details" scope="col">Bank</th>
                <th data-bs-toggle="tooltip" data-bs-original-title="Document Details" scope="col">Doc</th>    
                <th data-bs-toggle="tooltip" data-bs-original-title="Police Verification" scope="col">Pol. Verf.</th>
                <th data-bs-toggle="tooltip" data-bs-original-title="Medical Checkup" scope="col">Med. Chk.</th>

            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.PreEnrollCandidateLinkApprovalList.Count > 0)
            {
                for (int i = 0; i < Model.PreEnrollCandidateLinkApprovalList.Count; i++)
                {

            <tr>
                @Html.HiddenFor(m => m.PreEnrollCandidateLinkApprovalList[i].MakerChecker)
                <td data-label="ID">@(i+1)</td>
                <td data-label="Employee Name">
                    <a onclick="OnEmpNameClick('@Model.PreEnrollCandidateLinkApprovalList[i].PreEnrollGI',@i)">@Model.PreEnrollCandidateLinkApprovalList[i].EmployeeName</a>
                    @*@Html.ActionLink(Model.PreEnrollCandidateLinkApprovalList[i].EmployeeName, "Create", "PreEnrollCandidateLinkApprovalListApprove", new { EmployeeGI = @Model.PreEnrollCandidateLinkApprovalList[i].EmployeeGI }, null)*@
                </td>
                <td data-label="Designation">@Model.PreEnrollCandidateLinkApprovalList[i].Designation</td>
                <td data-label="Department">@Model.PreEnrollCandidateLinkApprovalList[i].Department</td>

                <td data-label="Location">@Model.PreEnrollCandidateLinkApprovalList[i].Location</td>
                <td data-label="DOJ">@Model.PreEnrollCandidateLinkApprovalList[i].DOJ.ToString("dd-MMM-yyyy")</td>
                <td data-label="Photo">
                    @if (Model.PreEnrollCandidateLinkApprovalList[i].Photo != true)
                    {
                        <button type="button" class="btn btn-icon btn-tick">
                            <i class="icon-xl fa fa-hourglass-half"></i>
                        </button>
                    }

                </td>
                <td data-label="Addr">
                    @if (Model.PreEnrollCandidateLinkApprovalList[i].Addr != true)
                    {
                        <button type="button" class="btn btn-icon btn-tick">
                            <i class="icon-xl fa fa-hourglass-half"></i>
                        </button>
                    }

                </td>
                <td data-label="Cont">
                    @if (Model.PreEnrollCandidateLinkApprovalList[i].Cont != true)
                    {
                        <button type="button" class="btn btn-icon btn-tick">
                            <i class="icon-xl fa fa-hourglass-half"></i>
                        </button>
                    }

                </td>
                <td data-label="Pers">
                    @if (Model.PreEnrollCandidateLinkApprovalList[i].Pers != true)
                    {
                        <button type="button" class="btn btn-icon btn-tick">
                            <i class="icon-xl fa fa-hourglass-half"></i>
                        </button>
                    }

                </td>
                <td data-label="Fmly">
                    @if (Model.PreEnrollCandidateLinkApprovalList[i].Fmly != true)
                    {
                        <button type="button" class="btn btn-icon btn-tick">
                            <i class="icon-xl fa fa-hourglass-half"></i>
                        </button>
                    }

                </td>
                <td data-label="Educ">
                    @if (Model.PreEnrollCandidateLinkApprovalList[i].Educ != true)
                    {
                        <button type="button" class="btn btn-icon btn-tick">
                            <i class="icon-xl fa fa-hourglass-half"></i>
                        </button>
                    }

                </td>
                <td data-label="Skills">
                    @if (Model.PreEnrollCandidateLinkApprovalList[i].Skills != true)
                    {
                        <button type="button" class="btn btn-icon btn-tick">
                            <i class="icon-xl fa fa-hourglass-half"></i>
                        </button>
                    }

                </td>
                <td data-label="Certificates">
                    @if (Model.PreEnrollCandidateLinkApprovalList[i].Cert != true)
                    {
                        <button type="button" class="btn btn-icon btn-tick">
                            <i class="icon-xl fa fa-hourglass-half"></i>
                        </button>
                    }

                </td>
                <td data-label="Prev">
                    @if (Model.PreEnrollCandidateLinkApprovalList[i].Prev != true)
                    {
                        <button type="button" class="btn btn-icon btn-tick">
                            <i class="icon-xl fa fa-hourglass-half"></i>
                        </button>
                    }

                </td>
                <td data-label="EmpVsNom">
                    @if (Model.PreEnrollCandidateLinkApprovalList[i].EmployeeVsNominee != true)
                    {
                        <button type="button" class="btn btn-icon btn-tick">
                            <i class="icon-xl fa fa-hourglass-half"></i>
                        </button>
                    }

                </td>
                <td data-label="Prev">
                    @if (Model.PreEnrollCandidateLinkApprovalList[i].Bank != true)
                    {
                        <button type="button" class="btn btn-icon btn-tick">
                            <i class="icon-xl fa fa-hourglass-half"></i>
                        </button>
                    }

                </td>
                <td data-label="EmpVsNom">
                    @if (Model.PreEnrollCandidateLinkApprovalList[i].Doc != true)
                    {
                        <button type="button" class="btn btn-icon btn-tick">
                            <i class="icon-xl fa fa-hourglass-half"></i>
                        </button>
                    }

                </td>
                <td data-label="EmpVsNom">
                    @if (Model.PreEnrollCandidateLinkApprovalList[i].PoliceVerification != true)
                    {
                        <button type="button" class="btn btn-icon btn-tick">
                            <i class="icon-xl fa fa-hourglass-half"></i>
                        </button>
                    }
                    </td>
                <td data-label="EmpVsNom">
                    @if (Model.PreEnrollCandidateLinkApprovalList[i].MedicalCheckup != true)
                    {
                        <button type="button" class="btn btn-icon btn-tick">
                            <i class="icon-xl fa fa-hourglass-half"></i>
                        </button>
                    }

                </td>

            </tr>
                }
            }
        </tbody>
    </table>
</div>
<!-- Table Setion End -->