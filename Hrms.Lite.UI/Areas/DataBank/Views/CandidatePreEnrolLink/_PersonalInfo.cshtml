@model Hrms.Lite.Shared.DataBank.DTO.PersonalDetails
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "PersonalInfoSave" }))
{
    <div class="row">
        <div class="col-md-3">
            @{
                Model.TabIndex = "Personalinfo";
            }
            @Html.HiddenFor(m => m.TabIndex)
            @Html.HiddenFor(m => m.EmployeeGI)
            @Html.HiddenFor(m => m.PersonalInfoLogGI)
            @Html.HiddenFor(m => m.ApproveMode)

            @for (int i = 0; i < Model.PersonalInfo.Hobby.Count; i++)
            {
                @Html.HiddenFor(model => Model.PersonalInfo.Hobby[i].HobbiesLogGI)
            }
            @for (int i = 0; i < Model.PersonalInfo.Languagess.Count; i++)
            {
                @Html.HiddenFor(model => Model.PersonalInfo.Languagess[i].LanguageLogGI)
            }


            <div class="form-group">
                <label class="view-title">Blood Group</label>
                <div class="view-details">
                    @Model.PersonalInfo.BloodGroup.Name
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label class="view-title">Marital Status</label>
                <div class="view-details">
                    @Model.PersonalInfo.MaritalStatus.Name
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label class="view-title">DOW</label>
                <div class="view-details">
                    @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.PersonalInfo.wedding))
                </div>
            </div>
        </div>




        <div class="col-md-3">
            <div class="form-group">
                <label class="view-title">Religious View</label>
                <div class="view-details">
                    @Model.PersonalInfo.ReligiousView.Name
                </div>
            </div>
        </div>

    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label class="view-title">Language</label>
                <div class="view-details">
                    @Model.Languages
                </div>

            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label class="view-title">Hobbies</label>
                <div class="view-details">

                    @Model.Hobbies
                </div>

            </div>
        </div>
    </div>



    <div class="row">
        <div class="col-md-12 align-right">
            <button type="button" id="PersonalInfoLabel"
                    class="btn btn-default mobile-full-width hide">
                Test
            </button>
            <button type="button" id="PersonalInfoRejectbtnId"
                    class="btn btn-danger  mobile-full-width" onclick="PersonalProfileInfoApprove('REJECT')">
                Reject
            </button>
            <a type="button" id="PersonalInfoApprovebtnId"
               class="btn btn-default mobile-full-width" onclick="PersonalProfileInfoApprove('APPROVE')">
                Approve
            </a>
        </div>
    </div>
}