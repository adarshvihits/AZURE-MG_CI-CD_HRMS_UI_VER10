@model Hrms.Lite.Shared.DataBank.DTO.PersonalDetails

<script src="~/js/settings.js"></script>
<script>
        //$(document).ready(function () {
        //    fillData();
        //});
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table  candidate_preentrolllink_list">


    @Html.HiddenFor(m => Model.PersonalDetailsList.Count)



    <table id="offercandidatelink" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">Sl no</th>
                <th scope="col">Candidate Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col" data-bs-toggle="tooltip" data-placement="right" title="Expected DOJ">E:DOJ</th>
                <th scope="col">Email</th>
                <th scope="col">Mobile</th>
                @* <th scope="col">E:DOJ</th>*@
                <th scope="col">Action</th>
                <th scope="col"></th>



            </tr>
        </thead>
        <tbody>

            @{
                if (Model.PersonalDetailsList != null && Model.PersonalDetailsList.Count > 0)
                {
                    for (int i = 0; i < Model.PersonalDetailsList.Count; i++)

                    {



                        <tr>

                            <td data-label="Sl no">
                                @*@Model.OfferLetterList[i].EmployeeID*@

                                @(i+1)
                            </td>
                            @Html.HiddenFor(m => m.PersonalDetailsList[i].PreEnrollCode)
                            @Html.HiddenFor(m => m.PersonalDetailsList[i].PreEnrollGI)

                            <td data-label="Candidate Name">@Model.PersonalDetailsList[i].EmployeeName </td>
                            <td data-label="Designation">@Model.PersonalDetailsList[i].Designation </td>
                            <td data-label="Department">@Model.PersonalDetailsList[i].Department</td>
                            <td data-label="Location">@Model.PersonalDetailsList[i].Location</td>
                            <td data-label="E:DOJ">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.PersonalDetailsList[i].DOJ)) </td>
                            @*<td data-label="Email">@Model.PersonalDetailsList[i].Email</td>*@
                            <td data-label="Email" id="row_@i">
                                <span id="EmailLabel_@i">@Model.PersonalDetailsList[i].Email</span>
                                <span id="EmailTxtbox_@i" class="hide">
                                    <input type="text" id="newEmail_@i" class="form-control form-control-sm" placeholder="Email">
                                </span>
                            </td>
                            <td data-label="Mobile">@Model.PersonalDetailsList[i].Mobile</td>
                            <td data-label="Action">
                                <div class="small-btn-group hide" id="updatecancel_@i">
                                    <button type="button" data-bs-toggle="tooltip" title="Update" class="btn btn-icon btn-update btn-cancel icon-only"><i class="icon-xl fas fa-sync-alt update-icon" onclick="onUpdateClick('@i','@Model.PersonalDetailsList[i].PreEnrollGI')"></i> </button>

                                    <button type="button" data-bs-toggle="tooltip"
                                            title="Cancel"
                                            class="btn btn-icon btn-delete icon-only btn-bg-info " onclick="onCancelClick(@i)">
                                        <i class="icon-xl fas fa-times"></i>
                                    </button>
                                </div>

                                <div class="small-btn-group" id="edit_@i">
                                    <a data-bs-toggle="tooltip" title="Edit" type="button"
                                       class="btn btn-icon btn-edit icon-only" onclick="onEditClick(@i, '@Model.PersonalDetailsList[i].Email')">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>
                                </div>
                            </td>
                            <td data-label="Select">
                                <div class="checkbox-inline justify-content-center">
                                    <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                        @Html.CheckBoxFor(m => m.PersonalDetailsList[i].Applicable)
                                        <span></span>
                                    </label>
                                </div>
                            </td>



                        </tr>

                    }
                }

            }








        </tbody>


    </table>
    <div class="row card-footer-bottom-fixed ProceedClick " id="candidatelink" >

        <div class="col-md-12 align-right">
            <a type="button" class="btn btn-default mobile-full-width" id="HRProceedButton" onclick="SendCandidateLink()" >
                Send mail
            </a>

        </div>


    </div>
</div>
