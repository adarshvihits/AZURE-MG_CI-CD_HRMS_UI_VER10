@model Hrms.Lite.Shared.DataBank.DTO.PersonalDetails
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "BankDetailsSave" }))
{
<div class="row">
    <div class="col-md-3">
        @{
            Model.TabIndex = "BankDetails";
        }
        @Html.HiddenFor(m => m.TabIndex)
        @Html.HiddenFor(m => m.EmployeeGI)
        @Html.HiddenFor(m => m.BankDetailsLogGI)
        @Html.HiddenFor(m => m.ApproveMode)
        <div class="form-group">
            <label class="view-title">
                Bank Name
            </label>
            <div class="view-details">
                @Model.StatutoryClassification.Bank.Name
            </div>

        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <label class="view-title">Account Number</label>
            <div class="view-details">
                @Model.StatutoryClassification.AccountNo
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="form-group">
            <label class="view-title">Bank Branch</label>
            <div class="view-details">
                @Model.StatutoryClassification.BankBranch
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="form-group">
            <label class="view-title">IFSC Code</label>
            <div class="view-details">
                @Model.StatutoryClassification.IFSC
            </div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="form-group">
            <label class="view-title">File</label>
            <div class="view-details">
                <button data-bs-toggle="tooltip" title="View File" type="button" class=" btn btn-icon btn-eye icon-only pr-2" onclick="showDocument('@Model.StatutoryClassification.Passbook.FileName', '@Model.StatutoryClassification.Passbook.AbsoluteUri')" data-bs-original-title="">
                    <i class="icon-xl far fa-eye"></i>
                </button>
            </div>
        </div>
    </div>
</div>
    <div class="row">
        <div class="col-md-12 align-right">
            <button type="button" id="AddressLabel"
                    class="btn btn-default mobile-full-width hide">
                Test
            </button>
            <button type="button" id="AddressRejectbtnId"
                    class="btn btn-danger  mobile-full-width" onclick="PersonalProfileBankDetailsApprove('REJECT')">
                Reject
            </button>
            <button type="button" id="AddressApprovebtnId"
                    class="btn btn-default  mobile-full-width" onclick="PersonalProfileBankDetailsApprove('APPROVE')">
                Approve
            </button>
        </div>
    </div>
}