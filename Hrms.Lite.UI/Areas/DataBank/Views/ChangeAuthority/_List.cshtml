@model Hrms.Lite.Shared.DataBank.ChangeAuthority
    <script src="~/js/settings.js"></script>
    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table Change-Authority-List">
        @Html.HiddenFor(Model => Model.ChangeAuthorityList.Count)
        <table class="common-table">
            <thead>
                <tr class="table-dark">
                    <th scope="col">ID</th>
                    <th scope="col">Employee</th>
                    <th scope="col">Functional Designtion</th>
                    <th scope="col">Designtion</th>
                    <th scope="col">Department</th>
                    <th scope="col">Location</th>
                    <th scope="col">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ChangeAuthorityList != null && Model.ChangeAuthorityList.Count > 0)
                {
                    for (int i = 0; i < Model.ChangeAuthorityList.Count; i++)
                    {
                        <tr>
                            @Html.HiddenFor(Model => Model.ChangeAuthorityList[i].TrnCode)
                            @Html.HiddenFor(Model => Model.ChangeAuthorityList[i].EmployeeGI)
                            @Html.HiddenFor(Model => Model.ChangeAuthorityList[i].EmployeeCode)

                            <td data-label="EmployeeID">@Model.ChangeAuthorityList[i].EmployeeID</td>
                            <td data-label="EmployeeName">
                                <div>
                                    <a onclick="onEmployeeClick(@Model.ChangeAuthorityList[i].TrnCode,'@Model.ChangeAuthorityList[i].EmployeeGI')">@Model.ChangeAuthorityList[i].EmployeeName</a>
                                </div>
                            </td>
                            <td data-label="Functional Designation">@Model.ChangeAuthorityList[i].FuncDesignation</td>
                            <td data-label="Designation">@Model.ChangeAuthorityList[i].Designation</td>
                            <td data-label="Department">@Model.ChangeAuthorityList[i].Department</td>
                            <td data-label="Location">@Model.ChangeAuthorityList[i].Location</td>
                            <td data-label="Status">@Model.ChangeAuthorityList[i].Status</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <!--end::Entry-->

    <div class="modal fade bd-example-modal-lg" id="Auth_Popup" tabindex="-1" aria-labelledby="myLargeModalLabel" aria-hidden="true" style="position:fixed;">
        <div class="modal-dialog modal-lg" style="max-width:800px;">
            <div class="modal-content popup">
                <div class="modal-header">
                    <div>

                    </div>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <i aria-hidden="true" class="ki ki-close"></i>
                    </button>
                </div>

                <div class="modal-body pt-0">


                </div>


            </div>
        </div>
    </div>