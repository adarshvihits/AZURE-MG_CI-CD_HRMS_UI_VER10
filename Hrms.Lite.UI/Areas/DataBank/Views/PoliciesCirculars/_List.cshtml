@model Hrms.Lite.Shared.DataBank.DTO.PoliciesCirculars
<script src="~/js/settings.js"></script>
<div class="ihits-table table-border hover-color  odd-even mobile-responsive-table policies-circular">
    <table class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">Policy Name</th>
                <th scope="col">Description</th>
                <th scope="col">Category</th>
                <th scope="col">Visible From </th>
                <th scope="col">Visible To</th>
                <th scope="col">Acceptance Required</th>
                <th scope="col" data-bs-toggle="tooltip" title=""
                    data-bs-original-title="Acceptance Employee Count">
                    Acc. Emp Count
                </th>
                <th scope="col"> Actions</th>


            </tr>
        </thead>
        <tbody>
            @if (Model.PolicyList != null && Model.PolicyList.Count > 0)
            {

                for (int i = 0; i < Model.PolicyList.Count; i++)
                {
                    <tr>
                        <td data-label="Policy Name">@Model.PolicyList[i].Policyname</td>
                        <td data-label="Description">
                            @Model.PolicyList[i].Description
                        </td>
                        <td data-label="Category">@Model.PolicyList[i].CategoryName</td>
                        <td data-label="Visible From">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.PolicyList[i].VisibleFrom))</td>
                        <td data-label="Visible To">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.PolicyList[i].VisibleTo))</td>
                        <td data-label="Acceptance Required">@Model.PolicyList[i].AccepRequiredTxt</td>
                        <td data-label="Acceptance Employee Count">@Model.PolicyList[i].EmpCount</td>
                        <td data-label="Actions">
                            <a data-bs-toggle="tooltip" title="" id="viewgrievance" type="button" class="btn btn-icon btn-eye icon-only pr-2" data-bs-original-title="" onclick="showPolicyDocument('@Model.PolicyList[i].PolicyGI')">
                                <i class="icon-xl far fa-eye"></i>
                            </a>
                            <a data-bs-toggle="tooltip" title="Edit"
                               class="btn btn-icon btn-edit icon-only" onclick="Edit('@Model.PolicyList[i].PolicyGI')">
                                <i class="icon-xl fas fa-pencil-alt"></i>
                            </a>
                            <a data-bs-toggle="tooltip" title="Delete" id="deleteskilltype"
                               type="button"
                               class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="confirmDelete('@Model.PolicyList[i].PolicyGI')">
                                <i class="icon-xl far fa-trash-alt"></i>
                            </a>
                        </td>


                    </tr>


                }
            }


        </tbody>
    </table>
</div>