@model Hrms.Lite.Shared.DataBank.DTO.Resignation

<script src="~/js/settings.js"></script>

<script>
        $(document).ready(function () {

    $('.tab1Count').html("@Model.Count_InNoticePeriod");
    $('.tab2Count').html("@Model.Count_ResignationAccept");
    $('.tab3Count').html("@Model.Count_ExitChecklistPending");
    $('.tab4Count').html("@Model.Count_RelivingPending");
    $('.tab5Count').html("@Model.Count_RetirementDueList");
    $('.tab6Count').html("@Model.Count_ResignationApproval");
    $('.tab7Count').html("@Model.Count_ResignationAmendment");


    //$('#resignationRetirementTable').DataTable({
    //    "pageLength": 25,
    //    "language": {
    //        searchPlaceholder: "Search"
    //    }
    //    });

    //        $(".dataTables_filter").addClass("dataTables_filter_trn");
    //    $('.ihits-table table').removeClass("dataTable no-footer");
    //    $(".ihits-table table tr th").removeAttr('style')

    });</script>
    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table resignationretirementduelist ">
        @Html.HiddenFor(m => m.ResignationList.Count)
        <table id="resignationRetirementTable" class="common-table">
            <thead>
                <tr class="table-dark">
                    <th scope="col">ID</th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">Fun.Designation</th>
                    <th scope="col">Department</th>
                    <th scope="col">Location</th>
                    <th scope="col">Category</th>
                    <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Years Of Service">Y/S</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ResignationList != null && Model.ResignationList.Count > 0)
                {

                    for (int i = 0; i < Model.ResignationList.Count; i++)
                    {

                        <tr>
                            <td data-label="ID">@Model.ResignationList[i].EmployeeID</td>
                            <td data-label="Candidate Name">@Model.ResignationList[i].EmployeeName</td>
                            <td data-label="Designation">@Model.ResignationList[i].Designation.Name</td>
                            <td data-label="Department">@Model.ResignationList[i].Department.Name </td>
                            <td data-label="Location">@Model.ResignationList[i].Location.Name</td>
                            <td data-label="Category">@Model.ResignationList[i].Category.Name</td>
                            <td data-label="Y/S">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.ResignationList[i].YOS))</td>

                        </tr>
                    }
                }


            </tbody>
        </table>
    </div>