@model Hrms.Lite.Shared.DataBank.DTO.Resignation
@{
    ViewData["Title"] = "ExitCheckList";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/scripts/DataBank/resignation.js"></script>
<script src="~/js/jquery.min.js"></script>
<script>
    const myTimeout = setTimeout(changeFocus, 500);

    function changeFocus() {
        $('#ExitCheck_Communication_0__ExitCheckStatus_Code').focus();
    }
</script>
@using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "resignChecklist" }))
{
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->
            <!--end::Header Menu Wrapper-->

            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Employee Exit Checklist</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>
                        <li class="breadcrumb-item">
                            <a href="@Url.Action("Index", "Resignation", new { Area = "DataBank" })" class="">Resignation List</a>
                        </li>
                        <li class="breadcrumb-item">
                            Employee Exit Checklist
                        </li>

                    </ul>
                </div>
            </div>
            <!--begin::Topbar-->
            
            <!--end::Topbar-->
        </div>
    </div>
    <!--end::Container-->
    <!--end::Header-->

    <!--begin::Content-->
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body ">
                        <!--begin: Search Form-->
                        <div class="profile-header position-relative box-shadow-none mb-2">
                            @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeHeader.cshtml", Model.EmployeeHeader)
                            @Html.HiddenFor(m => m.EmployeeGI)
                            <div class="profile-header-overflow"></div>
                        </div>
                        <!-- Table Section -->
                        <div class="tab-outer accordion-only">
                            <ul class="ulList">
                                <!-- Tab Start -->
                                @{
                                    int i = 0;
                                    @if (Model.ExitCheckList != null)
                                    {
                                    @foreach (var group in Model.ExitCheckList.GroupBy(m => new { m.CheckTypeCode, m.CheckType }))
                                    {

                                        <div class="TabMoving"></div>
                                        <li class="tabOne clickOnTab active">@group.Key.CheckType</li>
                                        <div id="tabOne" class="tab-content active">
                                            <div class="ihits-table table-border  mobile-responsive-table employee-exit-checklist">
                                                <table>
                                                    <thead>
                                                        <tr class="table-light">
                                                            <th scope="col">SlNo</th>
                                                            <th scope="col">Check Item</th>
                                                            <th scope="col">Status</th>
                                                            <th scope="col">Remarks</th>

                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                       @{ int j = 0;}
                                                        @foreach (var item in Model.ExitCheckList.Where(m => m.CheckTypeCode == group.Key.CheckTypeCode))
                                                        {
                                                          
                                                            @Html.Hidden("ExitCheckList[" + i + "].CheckTypeCode", item.CheckTypeCode)
                                                            @Html.Hidden("ExitCheckList[" + i + "].CheckItemCode", item.CheckItemCode)
                                                            @Html.Hidden("ExitCheckList[" + i + "].CheckItem", item.CheckItem)
                                                            @Html.Hidden("ExitCheckList[" + i + "].ResignationGI", item.ResignationGI)
                                                            @Html.Hidden("ExitCheckList[" + i + "].IsMandatory", item.IsMandatory)

                                                            <tr>
                                                                <td data-label="SI">@(j + 1)</td>
                                                                <td data-label="Check Item">
                                                                    @item.CheckItem
                                                                    @if (item.IsMandatory == true)
                                                                    {
                                                                        <span class="Mandatory">*</span>
                                                                    }
                                                                </td>
                                                                <td data-label="Status">
                                                                    <div style="position:relative">

                                                                        @Html.DropDownListFor(modelItem => modelItem.ExitCheckList[i].ExitCheckStatus.Code, (SelectList)ViewBag.Status, "--Select--", new { @class = "form-control form-control-sm ChecklistStatus", @onchange = "onstatuschange(" + i + ",'check_status_span_')" })
                                                                        <span id="check_status_span_@i"></span>
                                                                        </div>
                                                                </td>
                                                                <td data-label="Remarks">
                                                                    @Html.TextBoxFor(modelItem => modelItem.ExitCheckList[i].Remarks, new { @class = "form-control form-control-sm", @placeholder = "Remarks" })
                                                                </td>

                                                            </tr>

                                                            i++;
                                                            j++;

                                                        }


                                                    </tbody>
                                                </table>
                                            </div>

                                        </div>
                                        <!-- Tab End -->

                                    }
                                    }
                                    }
                                    </ul>
                        </div>

                        <!-- Table Setion End -->

                        <div class="row card-footer-bottom-fixed">
                            <div class="col-md-12">
                                <button href="#"
                                        type="button" class="btn btn-default float-right mobile-full-width" onclick="ExitCheckListSave()">
                                    Save
                                </button>
                            </div>

                        </div>
                        <!--end: Datatable-->
                    </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>


    </div>
    <!--end::Content-->
}