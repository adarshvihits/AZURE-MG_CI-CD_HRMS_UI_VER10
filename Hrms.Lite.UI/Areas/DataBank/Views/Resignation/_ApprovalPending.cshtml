@model Hrms.Lite.Shared.DataBank.DTO.Resignation
<script src="~/js/settings.js"></script>
<script src="~/js/tooltip.js"></script>
<script>
$(document).ready(function () {

    $('.tab1Count').html("@Model.Count_InNoticePeriod");
    $('.tab2Count').html("@Model.Count_ResignationAccept");
    $('.tab3Count').html("@Model.Count_ExitChecklistPending");
    $('.tab4Count').html("@Model.Count_RelivingPending");
    $('.tab5Count').html("@Model.Count_RetirementDueList");



    //$('#inNoticePeriodTable').DataTable({
    //    "pageLength": 25,
    //    "language": {
    //        searchPlaceholder: "Search"
    //    }
    //    });


    //$(".dataTables_filter").addClass("dataTables_filter_trn");
    //    $('.ihits-table table').removeClass("dataTable no-footer");
    //    $(".ihits-table table tr th").removeAttr('style')

    });</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Approval-pending_list ">
    @Html.HiddenFor(m => m.ResignationList.Count)
    <table id="inNoticePeriodTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col" data-bs-toggle="tooltip" title="Resignation Date">Res. Date</th>
                <th data-bs-toggle="tooltip" title="Last Working Date" scope="col">LWD</th>
                <th scope="col">Reason</th>
                <th scope="col">Authority</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ResignationList != null && Model.ResignationList.Count > 0)
            {

                for (int i = 0; i < Model.ResignationList.Count; i++)
                {
                    @Html.HiddenFor(m => m.ResignationList[i].EmployeeGI)
                    @Html.HiddenFor(m => m.ResignationList[i].ResignationGI)

                    <tr>
                        <td data-label="ID">@Model.ResignationList[i].EmployeeID</td>
                        <td data-label="Candidate Name">@Model.ResignationList[i].EmployeeName</td>
                        <td data-label="Designation">@Model.ResignationList[i].Designation.Name</td>
                        <td data-label="Department">@Model.ResignationList[i].Department.Name </td>
                        <td data-label="Location">@Model.ResignationList[i].Location.Name</td>
                        <td data-label="DOJ">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.ResignationList[i].ResignationDate))</td>                        
                        <td data-label="LWD">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.ResignationList[i].LWD))</td>
                        <td data-label="Reason">@Model.ResignationList[i].Reason</td>                                                  
                    
                        <td data-label="Resignation Stage"> @Model.ResignationList[i].AuthName </td>
                        
                    </tr>

                }
            }

        </tbody>
    </table>
</div>