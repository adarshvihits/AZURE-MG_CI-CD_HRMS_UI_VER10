
@model Hrms.Lite.Shared.DataBank.Generic.Master.GrievanceAuthority
<script>
    $(document).ready(function () {



        $('#EmployeeInfo_EmployeeID').selectpicker();

    });
</script>
<style>
    .btn.dropdown-toggle{
        border:none !important;
        height:29px !important;
    }
</style>
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "Grievance_Save" }))
{
    <div id="editgrievance" class="slider-forms slider-forms-open EditDiv">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('EditDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>
                Grievance Authority
            </h4>
            @*<div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Reference
                            Number
                        </label>
                        <div class="view-details">
                            @Html.DisplayFor(m => Model.RefNo)
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Requested
                            Date
                        </label>
                        <div class="view-details">

                            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.RequestedDate))

                        </div>
                    </div>
                </div>
            </div>*@


            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Grievance
                            Category
                        </label>
                        <div class="view-details">
                            @Html.HiddenFor(m => Model.CategoryCode)
                            @*@Html.HiddenFor(m => Model.EmployeeInfo.EmployeeID)*@
                            @Html.DisplayFor(model => Model.CategoryName)
                            @Html.HiddenFor(m => Model.EmployeeInfo.EmployeeGI)
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">

                <div class="col-md-12">
                    <label class="">
                        Authority Name

                    </label>
                    <span class="Mandatory">*</span>
                    <div class="form-group mt-1">

                        <div class="slider-search-field">
                            <div class="form-control-sm form-control editAuthority ">
                                @*<input type="text" class="sliderSearchInput" placeholder="ID/Name">*@
                                @Html.DropDownListFor(m => m.EmployeeInfo.EmployeeID, (SelectList)ViewBag.Authority, "Search by Employee name/ID", new
                                {
                                    @class = "selectpicker sliderSearchInput form-control form-control-sm",
                                    @onchange = "validateMultiselect('EmployeeInfo_EmployeeID','authority','editAuthority');OnEmpChange(this)",
                                    data_show_subtext = "true",

                               data_live_search = "true"
                           })

                            </div>
                        </div>
                        

                        <span id="authority"></span>

                    </div>

                </div>

            </div>


            <div class="row card-footer-bottom-fixed border-none">
                <div class="col-md-12 align-right">
                    <button type="button"
                            class="btn btn-default  mobile-full-width" onclick="SaveGrievanceAuthority('Save')">
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}