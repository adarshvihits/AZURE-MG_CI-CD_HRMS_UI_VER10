@model Hrms.Lite.Shared.DataBank.WorkUnitVsAuthoritySettings
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table vertical-scroll-350 workunit_vs_authority">
    <table id="authorityTable">
        <thead>
            <tr class="table-dark">
                <th scope="col">Request Type</th>
                <th scope="col">Level</th>
                <th scope="col">Authority</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.WorkUnitVsAuthority != null && Model.WorkUnitVsAuthority.Count > 0)
            {
                for (int i = 0; i < Model.WorkUnitVsAuthority.Count; i++)
                {
                    @Html.HiddenFor(m => m.WorkUnitCode)
                    <tr>
                        <td>
                            @Html.HiddenFor(m => m.WorkUnitVsAuthority.Count)
                            @Model.WorkUnitVsAuthority[i].RequestTypeName
                            @{
                                string ReqId = "WorkUnitVsAuthority_" + i + "__RequestTypeName";
                                string ReqName = "WorkUnitVsAuthority[" + i + "].RequestTypeName";
                                string ReqCodeId = "WorkUnitVsAuthority_" + i + "__RequestTypeCode";
                                string ReqCodeName = "WorkUnitVsAuthority[" + i + "].RequestTypeCode";
                            }
                            <input type="hidden" id="@ReqId" name="@ReqName" class="form-control form-control-sm" value="@Model.WorkUnitVsAuthority[i].RequestTypeName" />
                            <input type="hidden" id="@ReqCodeId" name="@ReqCodeName" class="form-control form-control-sm" value="@Model.WorkUnitVsAuthority[i].RequestTypeCode" />



                        </td>
                        <td>
                            @{
                                string LevelCodeId = "WorkUnitVsAuthority_" + i + "__LevelCode";
                                string LevelCodeName = "WorkUnitVsAuthority[" + i + "].LevelCode";
                                string LevelId = "WorkUnitVsAuthority_" + i + "__LevelName";
                                string LevelName = "WorkUnitVsAuthority[" + i + "].LevelName";
                            }

                            <input type="hidden" id="@LevelCodeId" name="@LevelCodeName" class="form-control form-control-sm" value="@Model.WorkUnitVsAuthority[i].LevelCode" />
                            <input type="hidden" id="@LevelId" name="@LevelName" class="form-control form-control-sm" value="@Model.WorkUnitVsAuthority[i].LevelName" />
                            @Model.WorkUnitVsAuthority[i].LevelName

                        </td>
                        <td>

                            @{
                                string AuthCodeId = "WorkUnitVsAuthority_" + i + "__AuthorityCode";
                                string AuthCodeName = "WorkUnitVsAuthority[" + i + "].AuthorityCode";
                                string AuthId = "WorkUnitVsAuthority_" + i + "__AuthorityName";
                                string AuthName = "WorkUnitVsAuthority[" + i + "].AuthorityName";
                            }
                            <input type="hidden" id="@AuthCodeId" name="@AuthCodeName" class="form-control form-control-sm" value="@Model.WorkUnitVsAuthority[i].AuthorityCode" />
                            <input type="hidden" id="@AuthId" name="@AuthName" class="form-control form-control-sm" value="@Model.WorkUnitVsAuthority[i].AuthorityName" />
                            @Model.WorkUnitVsAuthority[i].AuthorityName
                        </td>
                        <td>
                            <a data-bs-toggle="tooltip" title="Edit"
                               id="categoryedit"
                               class="btn btn-icon btn-edit icon-only" onclick="GetAuthorityDetails('@Model.WorkUnitVsAuthority[i].RequestTypeCode', '@Model.flag')">
                                <i class="icon-xl fas fa-pencil-alt"></i>
                            </a>
                            @*@Model.WorkUnitVsAuthority[i].AuthorityName
                        @{
                            string AuthCodeId = "WorkUnitVsAuthority_" + i + "__AuthorityCode";
                            string AuthCodeName = "WorkUnitVsAuthority[" + i + "].AuthorityCode";
                            string AuthId = "WorkUnitVsAuthority_" + i + "__AuthorityName";
                            string AuthName = "WorkUnitVsAuthority[" + i + "].AuthorityName";
                        }
                        <input type="hidden" id="@AuthCodeId" name="@AuthCodeName" class="form-control form-control-sm" value="@Model.WorkUnitVsAuthority[i].AuthorityCode" />
                        <input type="hidden" id="@AuthId" name="@AuthName" class="form-control form-control-sm" value="@Model.WorkUnitVsAuthority[i].AuthorityName" />*@

                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>