@model Hrms.Lite.Shared.DataBank.WorkUnitVsAuthoritySettings
@{ ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/DataBank/workUnitVsAuthoritySettings.js"></script>

<div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->


            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Work Unit Vs Authority</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>
                        <li class="breadcrumb-item text-muted">
                            <a href="@Url.Action("Index", "WorkUnitVsAuthoritySettings", new { Area = "DataBank" })">Work Unit Vs Authority Settings</a>
                        </li>
                        <li class="breadcrumb-item text-muted">
                            Work Unit Vs Authority
                        </li>

                    </ul>
                </div>
            </div>

            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">


                @Html.HiddenFor(m => m.WorkUnitCode)
                @Html.HiddenFor(m => m.flag)

                <div class="card card-custom height-100per">

                    <div class="card-body">
                        <div class="row-outer">
                            <label class="view-title">Work Unit</label>
                            <div class="view-details">@Model.WorkUnit</div>
                        </div>

                        <div class="row my-3">
                            <div class="col-md-12">

                                @if (@Model.WorkUnitVsAuthority == null || @Model.WorkUnitVsAuthority.Count == 0)
                                {
                                    <button type="button" data-bs-toggle="modal" data-target=".addAuthorityPopup" class="btn  float-right  add_authority" style="font-weight: 600; display: flex; align-items: center; background-color: transparent; color: #8c9eb9;" onclick="GetAuthorityDetails('@Model.flag')"><i class="fa fa-plus" style="color: #8c9eb9 !important;" aria-hidden="true"></i>Add Authority</button>
                                }

                            </div>
                        </div>
                        <div class="row" id="reqvsAuthListView">
                            @await Html.PartialAsync("_RequestVsAuthorityList", Model)
                        </div>

                        <div class="row card-footer-bottom-fixed">
                            <div class="col-md-12">
                                <button type="button"
                                        class="btn btn-default float-right mobile-full-width" onclick="onSave()">
                                    Save
                                </button>
                            </div>
                        </div>




                    </div>

                </div>
            </div>

            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
</div>
<!--end::Entry-->
<div class="modal fade addAuthorityPopup" tabindex="-1" aria-labelledby="myLargeModalLabel" aria-hidden="true" style="display: none;">
    <div class="modal-dialog" style="max-width: 750px;">
        <div class="modal-content popup ">
            <div class="modal-header" style=" padding: 10px 20px;">
                <h5 class="modal-title">
                    Request Vs Authority
                </h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body" style=" padding: 10px 20px;">
            </div>
            <!-- <end table></end> -->



        </div>
    </div>
</div>
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "authTable", @style = "height:100%" }))
{
    <div id="authorityTableDiv">

    </div>
}