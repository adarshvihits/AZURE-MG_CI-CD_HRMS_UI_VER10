@model Hrms.Lite.Shared.DataBank.WorkUnitVsAuthoritySettings

<div class="row mb-2 ">
    @Html.HiddenFor(m => m.WorkUnitCode)

    <div class="col-md-4">
        <div class="form-group">
            <label>Request Type</label>
            @Html.DropDownListFor(m => m.RequestType.Code, (SelectList)ViewBag.ReqType, new { @class = "form-control form-control-sm", @onchange = "requestTypeDropdnChange(this);onDropdownChange($('#WorkUnitCode').val(),$('#RequestType_Code').val())" })
        </div>                                                                                                                 
    </div>
</div>
<div id="popupListDiv">
    @await Html.PartialAsync("_PopupList", Model)

</div>


<div class="row pt-3">
    <div class="col-md-12 mt-2 mb-5">
        <button id="addNewLevel" type="button" class="btn btn-default float-right mobile-full-width" onclick="AddToList()">
            Add
        </button>
    </div>
</div>

