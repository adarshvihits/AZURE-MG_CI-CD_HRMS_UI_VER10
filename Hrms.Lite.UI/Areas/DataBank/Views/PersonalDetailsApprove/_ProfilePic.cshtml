@model Hrms.Lite.Shared.DataBank.DTO.PersonalDetails
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "per_Photoform" }))
{

 {
 Model.TabIndex = "ProfilePhoto";
 }
            @Html.HiddenFor(m => m.TabIndex)
            @Html.HiddenFor(m => m.EmployeeGI)
            @Html.HiddenFor(m => m.ProfilePhotoLogGI)
            @Html.HiddenFor(m => m.ApproveMode)
<div class="profile-header pb-12">
    <div class="row">
        <div class="col-md-1">
            <div class="image-input image-input-outline image-input-circle  approv_Pic" id="kt_image_4">
                <div class="image-input-wrapper"
                      data-bs-toggle="tooltip" data-bs-original-title="Click to upload photo">
                </div>

            </div>
        </div>

    </div>



    <div class="profile-header-overflow"></div>
</div>



<div class="row">
    <div class="col-md-12 align-right">
        <button type="button" id="PhotoLabel"
                class="btn btn-default mobile-full-width hide">
            Test
        </button>
        <button type="button" id="PhotoRejectbtnId"
                class="btn btn-danger  mobile-full-width" onclick="Profile_PicApprove('REJECT')">
            Reject
        </button>
        <button type="button" id="PhotoApprovebtnId"
                class="btn btn-default  mobile-full-width" onclick="Profile_PicApprove('APPROVE')">
            Approve
        </button>
    </div>
</div>
}