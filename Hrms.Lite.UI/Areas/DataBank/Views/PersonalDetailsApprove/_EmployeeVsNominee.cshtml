@model Hrms.Lite.Shared.DataBank.DTO.PersonalDetails

@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "EmployeeVsNomineeSave" }))
{
<div class="row">
    <div class="col-md-12">
        @{
            Model.TabIndex = "EmployeeVsNominee";
        }
        @Html.HiddenFor(m => m.TabIndex)
        @Html.HiddenFor(m => m.EmployeeGI)
        @Html.HiddenFor(m => m.ApproveMode)
        <div class="ihits-table table-border mobile-responsive-table personal-profile-education-section mb-2">
            <table>
                <thead>
                    <tr class="table-dark">
                        <th scope="col">Catgeory</th>
                        <th scope="col">Relation</th>
                        <th scope="col">Name</th>
                        <th scope="col">Percentage</th>
                        <th scope="col">Comments</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @Html.HiddenFor(m => m.EmployeeGI)

                    @for (int i = 0; i < Model.EmployeeVsNomineeList.Count; i++)
                    {

                        <tr id="row_OI_@i">
                            <td data-label="Catgeory">
                                @Html.HiddenFor(m => m.EmployeeVsNomineeList[i].EmpVsNomLogGI)
                                @Html.HiddenFor(m => m.EmployeeVsNomineeList[i].NominationCategory.Code)
                                @Html.HiddenFor(m => m.EmployeeVsNomineeList[i].flag)
                                @Html.DisplayFor(m => m.EmployeeVsNomineeList[i].NominationCategory.Name)

                            </td>
                            <td data-label="Relation">
                                @Html.HiddenFor(m => m.EmployeeVsNomineeList[i].Relation.Code)
                                @Html.DisplayFor(m => m.EmployeeVsNomineeList[i].Relation.Name)
                            </td>
                            <td data-label="name">
                                @Html.DisplayFor(m => m.EmployeeVsNomineeList[i].Name)
                            </td>
                            <td data-label="percentage">
                                @Html.DisplayFor(m => m.EmployeeVsNomineeList[i].Percentage)
                            </td>
                            <td data-label="comments">
                                @Html.DisplayFor(m => m.EmployeeVsNomineeList[i].Comments)
                            </td>
                            <td data-label="action">
                                <div class="row">
                                    <div class="col-md-12 align-right">
                                        <button type="button" id="SkillLabel_@i"
                                                class="btn btn-default mobile-full-width hide">
                                            Test
                                        </button>

                                        <a data-bs-toggle="tooltip" data-bs-original-title="Reject" id="SkillsRejectbtnId_@i"
                                           class="btn_reject" onclick="PersonalProfileEmpVsNomApprove(@i,'REJECT')">

                                        </a>
                                        <a data-bs-toggle="tooltip" data-bs-original-title="Approve" id="SkillsApprovebtnId_@i"
                                           class="btn_approve" onclick="PersonalProfileEmpVsNomApprove(@i,'APPROVE')">

                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>

                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
}

