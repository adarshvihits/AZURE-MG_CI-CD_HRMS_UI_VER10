
@model Hrms.Lite.Shared.DataBank.DTO.PersonalDetails
<style>
    .btn.btn-icon{
        float:none;
    }
    .btn-tick2 {
        color: #238825 !important;
    }


</style>

    <script src="~/js/settings.js"></script>

    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table personal-details-pending-list">
        @Html.HiddenFor(m => m.PersonalDetailsApprovalList.Count)
        <table id="PersonalDetailsApprovalTable" class="common-table">
            <thead>
                <tr class="table-dark">
                    <th scope="col">ID</th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">Fun.Designation</th>
                    <th scope="col">Department</th>
                    <th scope="col">Location</th>
                    <th scope="col">DOJ</th>
                    <th data-bs-toggle="tooltip" data-bs-original-title="Profile Photo" scope="col">Photo</th>
                    <th data-bs-toggle="tooltip" data-bs-original-title="Address" scope="col">Addr</th>
                    <th data-bs-toggle="tooltip" data-bs-original-title="Contact Details" scope="col">Cont</th>
                    <th data-bs-toggle="tooltip" data-bs-original-title="Personal Info" scope="col">Pers</th>
                    <th data-bs-toggle="tooltip" data-bs-original-title="Family Details" scope="col">Fmly</th>
                    <th data-bs-toggle="tooltip" title="Education" scope="col">Educ</th>
                    <th data-bs-toggle="tooltip" title="Skills" scope="col">Skills</th>
                    <th data-bs-toggle="tooltip" data-bs-original-title="Certifications" scope="col">Cert</th>
                    <th data-bs-toggle="tooltip" data-bs-original-title="Previous Employment" scope="col">Prev</th>
                    <th data-bs-toggle="tooltip" data-bs-original-title="Employee Vs Nominee" scope="col">Nom</th>

                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.PersonalDetailsApprovalList.Count > 0)
                {
                    for (int i = 0; i < Model.PersonalDetailsApprovalList.Count; i++)
                    {

                <tr>
                  
                    <td data-label="ID">@Model.PersonalDetailsApprovalList[i].Employeeid</td>
                    <td data-label="Employee Name">
                        @Html.HiddenFor(m => m.PersonalDetailsApprovalList[i].MakerChecker)
                        <a onclick="OnEmpNameClick('@Model.PersonalDetailsApprovalList[i].EmployeeGI',@i)">@Model.PersonalDetailsApprovalList[i].EmployeeName</a>
                    </td>
                    <td data-label="Designation">@Model.PersonalDetailsApprovalList[i].Designation</td>
                    <td data-label="Department">@Model.PersonalDetailsApprovalList[i].Department</td>

                    <td data-label="Location">@Model.PersonalDetailsApprovalList[i].Location</td>
                    <td data-label="DOJ">@Model.PersonalDetailsApprovalList[i].DOJ.ToString("dd-MMM-yyyy")</td>
                    <td data-label="Photo">
                        @if (Model.PersonalDetailsApprovalList[i].Photo != true)
                        {
                            <button type="button" class="btn btn-icon ">
                                <i class="icon-xl fas fa-check btn-tick2"></i>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-icon">
                                <i class="icon-xl fa fa-times"></i>
                            </button>
                        }

                    </td>
                    <td data-label="Addr">
                        @if (Model.PersonalDetailsApprovalList[i].Addr != true)
                        {
                            <button type="button" class="btn btn-icon ">
                                <i class="icon-xl fas fa-check btn-tick2"></i>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-icon ">
                                <i class="icon-xl fa fa-times"></i>
                            </button>
                        }

                    </td>
                    <td data-label="Cont">
                        @if (Model.PersonalDetailsApprovalList[i].Cont != true)
                        {
                            <button type="button" class="btn btn-icon ">
                                <i class="icon-xl fas fa-check btn-tick2"></i>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-icon ">
                                <i class="icon-xl fa fa-times"></i>
                            </button>
                        }

                    </td>
                    <td data-label="Pers">
                        @if (Model.PersonalDetailsApprovalList[i].Pers != true)
                        {
                            <button type="button" class="btn btn-icon ">
                                <i class="icon-xl fas fa-check btn-tick2"></i>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-icon ">
                                <i class="icon-xl fa fa-times"></i>
                            </button>
                        }

                    </td>
                    <td data-label="Fmly">
                        @if (Model.PersonalDetailsApprovalList[i].Fmly != true)
                        {
                            <button type="button" class="btn btn-icon ">
                                <i class="icon-xl fas fa-check btn-tick2"></i>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-icon ">
                                <i class="icon-xl fa fa-times"></i>
                            </button>
                        }

                    </td>
                    <td data-label="Educ">
                        @if (Model.PersonalDetailsApprovalList[i].Educ != true)
                        {
                            <button type="button" class="btn btn-icon ">
                                <i class="icon-xl fas fa-check btn-tick2"></i>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-icon ">
                                <i class="icon-xl fa fa-times"></i>
                            </button>
                        }

                    </td>
                    <td data-label="Skills">
                        @if (Model.PersonalDetailsApprovalList[i].Skills != true)
                        {
                            <button type="button" class="btn btn-icon ">
                                <i class="icon-xl fas fa-check btn-tick2"></i>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-icon ">
                                <i class="icon-xl fa fa-times"></i>
                            </button>
                        }

                    </td>
                    <td data-label="Certificates">
                        @if (Model.PersonalDetailsApprovalList[i].Cert != true)
                        {
                            <button type="button" class="btn btn-icon ">
                                <i class="icon-xl fas fa-check btn-tick2"></i>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-icon ">
                                <i class="icon-xl fa fa-times"></i>
                            </button>
                        }

                    </td>
                    <td data-label="Prev">
                        @if (Model.PersonalDetailsApprovalList[i].Prev != true)
                        {
                            <button type="button" class="btn btn-icon ">
                                <i class="icon-xl fas fa-check btn-tick2"></i>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-icon ">
                                <i class="icon-xl fa fa-times"></i>
                            </button>
                        }

                    </td>
                    <td data-label="EmpVsNom">
                        @if (Model.PersonalDetailsApprovalList[i].EmployeeVsNominee != true)
                        {
                            <button type="button" class="btn btn-icon ">
                                <i class="icon-xl fas fa-check btn-tick2"></i>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-icon ">
                                <i class="icon-xl fa fa-times"></i>
                            </button>
                        }

                    </td>

                </tr>
                    };
                }
            </tbody>
        </table>
    </div>
<!-- Table Setion End -->