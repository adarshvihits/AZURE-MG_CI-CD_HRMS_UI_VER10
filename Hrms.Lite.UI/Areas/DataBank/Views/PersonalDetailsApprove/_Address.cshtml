@model Hrms.Lite.Shared.DataBank.DTO.PersonalDetails
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "AddressSave" }))
{

    <div class="row">

        <div class="col-md-6 pr-7">
            <h5>Permanent Address</h5>
            @{
                Model.TabIndex = "Address";
            }
            @Html.HiddenFor(m => m.TabIndex)
            @Html.HiddenFor(m => m.EmployeeGI)
            @Html.HiddenFor(m => m.AddressLogGI)
            @Html.HiddenFor(m => m.ApproveMode)
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="view-title">
                            House Number,
                            Building
                        </label>
                        <div class="view-details">
                            @Model.Address.PermanentAddress.House
                        </div>

                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="view-title">Street, Area</label>
                        <div class="view-details">
                            @Model.Address.PermanentAddress.Street
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="view-title">Locality, City</label>
                        <div class="view-details">
                            @Model.Address.PermanentAddress.City
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="view-title">Pin Code</label>
                        <div class="view-details">
                            @Model.Address.PermanentAddress.PinCode
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="view-title">Country</label>
                        <div class="view-details">
                            @Model.Address.PermanentAddress.Country.Name
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="view-title">State</label>
                        <div class="view-details">
                            @Model.Address.PermanentAddress.State.Name
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="view-title">District</label>
                        <div class="view-details">
                            @Model.Address.PermanentAddress.District.Name
                        </div>
                    </div>
                </div>
            </div>


        </div>


        <div class="col-md-6 pl-7">
            <div class="checkbox-inline">
                <h5>Present Address</h5>



            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="view-title">
                            House Number,
                            Building
                        </label>
                        <div class="view-details">
                            @Model.Address.PresentAddress.House
                        </div>

                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="view-title">Street, Area</label>
                        <div class="view-details">
                            @Model.Address.PresentAddress.Street
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="view-title">Locality, City</label>
                        <div class="view-details">
                            @Model.Address.PresentAddress.City
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="view-title">Pin Code</label>
                        <div class="view-details">
                            @Model.Address.PresentAddress.PinCode
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="view-title">Country</label>
                        <div class="view-details">
                            @Model.Address.PresentAddress.Country.Name
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="view-title">State</label>
                        <div class="view-details">
                            @Model.Address.PresentAddress.State.Name
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="view-title">District</label>
                        <div class="view-details">
                            @Model.Address.PresentAddress.District.Name
                        </div>
                    </div>
                </div>
            </div>

        </div>





    </div>





    <div class="row">
        <div class="col-md-12 align-right">
            <button type="button" id="AddressLabel"
                    class="btn btn-default mobile-full-width hide">
                Test
            </button>
            <button type="button" id="AddressRejectbtnId"
                    class="btn btn-danger  mobile-full-width" onclick="PersonalProfileAddressApprove('REJECT')">
                Reject
            </button>
            <button type="button" id="AddressApprovebtnId"
                    class="btn btn-default  mobile-full-width" onclick="PersonalProfileAddressApprove('APPROVE')">
                Approve
            </button>
        </div>
    </div>
    @*<div class="row">
        <label id="AddLabel">Test</label>
    </div>*@
}