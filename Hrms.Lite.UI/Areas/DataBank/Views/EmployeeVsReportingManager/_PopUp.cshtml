@model Hrms.Lite.Shared.DataBank.EmployeeVsReportingManager

<style>
    .profile-header .form-control {
        border: 1px solid #cdc8c8;
    }
</style>
<script>
    $(document).ready(function () {
        debugger
        $('#RequestLevel_Code').selectpicker()
        $('.emp_HeaderPic').css('background-image', `url('/AccessFile/GetEmpThumbnail?EmployeeGI=${'@Model.EmployeeHeader.EmployeeGuid'}')`);

    });

</script>
@using (Html.BeginForm("Save", "EmployeeVsReportingManager", FormMethod.Post, new { id = "EmployeeVsReportingManagerSave" }))
{

    <div>
        <div class="profile-header position-relative pb-12 mb-5" style="padding-bottom: 2px !important; padding-top: 5px !important;">
            <div class="row">
                <div class="col-md-1">
                    <div class="image-input image-input-outline image-input-circle float-right  emp_HeaderPic" id="kt_image_4">
                        <div class="image-input-wrapper">

                        </div>
                    </div>
                </div>
                <div class="col-md-9 d-flex align-items-center">
                    <div class="row">
                        <div class="flex-grow-1">
                            <!--begin::Title-->
                            <div class="d-flex justify-content-between flex-wrap">
                                <div class="d-flex mr-3 header-profile-name align-items-center">
                                    <a class="">@Model.Name</a>
                                    <span>(@Model.EmployeeId)</span>
                                    
                                </div>

                            </div>

                            <!--end::Title-->
                            <!--begin::Content-->

                        </div>
                    </div>
                </div>
                <div class="col-md-2 d-flex align-items-center">
                    <div class="form-group w-100">
                       
                    </div>

                </div>

            </div>
            <div class="profile-header-overflow"></div>
        </div>
        <div class="row mt-20" style="justify-content: center; align-items: center;display:flex ">


            <div class="row-outer">
              
                <div class="view-details">
                    @Html.HiddenFor(Model => Model.code)
                    @Html.HiddenFor(Model => Model.EmployeeName)
                    @Html.HiddenFor(Model => Model.AuthorityId)
                    
                    @Html.HiddenFor(Model => Model.AuthorityCode)
                    @Html.HiddenFor(Model => Model.AuthorityName)

                    <h4>Select Reporting Manager:</h4>
                </div>
            </div>

            <div class="form-group " style="margin: 0; margin-left: 50px; width: 300px; ">


                <span class="" style="padding:5px;">
                    @Html.DropDownListFor(m => m.RequestLevel.Code, (SelectList)ViewBag.Aut, "--Select Authority--", new
               {
                   @class = "selectpicker form-control form-control-sm form-control reqAuth",
                   @onchange = "validateReqAuthority(this,'reqAuth','level')",
                    data_show_subtext = "true",
                   data_live_search = "true"
               })
                </span>

            </div>




          


        </div>
    </div>
}
