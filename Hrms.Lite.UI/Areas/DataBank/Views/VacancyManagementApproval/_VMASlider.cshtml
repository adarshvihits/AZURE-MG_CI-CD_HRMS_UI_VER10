@model Hrms.Lite.Shared.DataBank.DTO.VacancyManagement
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "VacancyMASave" }))
{
    @Html.HiddenFor(m => m.VacancyManagementGI)
    @Html.HiddenFor(m => m.Approvestatus)
    <div id="EmployRewardsRecognition" class="slider-forms slider-forms-open VMA">
        <div class="slider-inner-style">
            <div class="slider-form-close">
                <i class="ki ki-close icon-xs text-muted" onclick="CloseSlider('VMA')"></i>
            </div>
            <h4 class="mb-4">MRF Approval</h4>

            <div class="reward-section border-none">

                <div class="row">


                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">MRF Number</label>
                            <div class="view-details">
                                @Model.Details.JobCode
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Job Title</label>
                            <div class="view-details">
                                @Model.Details.JobTitle
                            </div>
                        </div>
                    </div>


                </div>


                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Deadline</label>
                            <div class="view-details">
                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Details.NeedByDate))
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Initiated by</label>
                            <div class="view-details">
                                @Model.Details.RequestedEmployee
                            </div>
                        </div>
                    </div>
                </div>




                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Designation</label>
                            <div class="view-details">
                                @Model.Details.Designation.Name
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Department</label>
                            <div class="view-details">
                                @Model.Details.Department.Name
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Location</label>
                            <div class="view-details">
                                @Model.Details.Location.Name
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Work Location</label>
                            <div class="view-details">
                                @Model.Details.WorkLocation.Name
                            </div>
                        </div>
                    </div>
                  
                </div>



                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Gender</label>
                            <div class="view-details">
                                @Model.Details.Gender.Name
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Age Group</label>
                            <div class="view-details">
                                @Model.AgeGroup
                            </div>
                        </div>
                    </div>
                
                </div>


                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Y/E</label>
                            <div class="view-details">
                                @Model.Experience
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">No of Requirements</label>
                            <div class="view-details">
                                @Model.Details.NoOfRequirements
                            </div>
                        </div>
                    </div>
                 
                </div>




                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Salary Range</label>
                            <div class="view-details">
                                @Model.Details.ExGrossPay
                            </div>
                        </div>
                    </div>
                </div>


                <div class="row">
                    <div class="col-md-12">
                        <label>Approver Comments</label>
                        @Html.TextAreaFor(m => m.ApproverComments, new { @class = "form-control", @placeholder = "Approver Comments", @onblur = "validate(this,'appcomment')" })
                        <span id="appcomment"></span>
                    </div>
                </div>



                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">

                        <a type="button"
                           class="  mobile-full-width btn btn-danger  mr-3" onclick="VacancyMASave(2)">
                            Reject
                        </a>
                        <a type="button"
                           class="btn btn-default float-right mobile-full-width" onclick="VacancyMASave(1)">
                            Approve
                        </a>
                    </div>


                </div>
            </div>



        </div>
    </div>
}