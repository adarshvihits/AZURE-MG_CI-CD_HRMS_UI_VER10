@model Hrms.Lite.Shared.DataBank.DTO.ResumeDataBank


<style>
    .step-outer .step-item {
       
        left: 0px;
    }
</style>


<div class="step-outer ">

    <a href="#" class="step-item active" onclick="onTabNameClick('Rd_Basic')">
        Basic Details
        <span class="step-circle"></span>
    </a>
    <div class="step-item active">
        Address
        <span class="step-circle"></span>
    </div>
    <div class="step-item">
        Experience
        <span class="step-circle"></span>
    </div>
    <div class="step-item">
        Education
        <span class="step-circle"></span>
    </div>
    <div class="step-item">
        Certifications
        <span class="step-circle"></span>
    </div>
    <div class="step-item">
        Skills
        <span class="step-circle"></span>
    </div>
    <div class="step-item">
        Summary
        <span class="step-circle"></span>
    </div>
</div>
<div class="step-progress-outer row">
    <div class="step-demo col-md-5">
        <img src="~/images/resume_template.png" style="max-width: 100%;" />
    </div>

    <div class="step-left col-md-7">
        <h2>Address</h2>


        <div class="row my-2">
            <div class="col-md-4">
                <div class="form-group">
                    <label>
                        House
                        @*<span class="Mandatory">*</span>*@
                    </label>
                    @Html.TextBoxFor(m => m.Details.House, new { @class = "form-control form-control-sm", @placeholder = "House", @onblur = "validate(this, 'rd_House')" })
                    <span id="rd_House"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label>
                        Street
                        @*<span class="Mandatory">*</span>*@
                    </label>
                    @Html.TextBoxFor(m => m.Details.Street, new { @class = "form-control form-control-sm", @placeholder = "Street", @onblur = "validate(this, 'rd_Street')" })
                    <span id="rd_Street"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label>
                        City
                        @*<span class="Mandatory">*</span>*@
                    </label>
                    @Html.TextBoxFor(m => m.Details.City, new { @class = "form-control form-control-sm", @placeholder = "City", @onblur = "validate(this, 'rd_City')" })
                    <span id="rd_City"></span>
                </div>
            </div>

        </div>

        <div class="row my-2">
            <div class="col-md-4">
                <div class="form-group">
                    <label>
                        Pincode
                        @*<span class="Mandatory">*</span>*@
                    </label>
                    @Html.TextBoxFor(m => m.Details.Pin, new { @class = "form-control form-control-sm", @placeholder = "Pincode", @onblur = "validatePincode(this, 'rd_Pincode')", @maxlength = "6", @onkeypress = "return onlyNumberKey(event)" })
                    <span id="rd_Pincode"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label>
                        Country
                        @*<span class="Mandatory">*</span>*@
                    </label>
                    @Html.DropDownListFor(m => m.Details.Country.Code, (SelectList)ViewBag.Cntry, "Select Country", new { @class = "form-control form-control-sm", @onchange = "onCountryChange(this,'rd_Country');validate(this,'rd_Country')" })
                    <span id="rd_Country"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label>
                        State
                        @*<span class="Mandatory">*</span>*@
                    </label>
                    @Html.DropDownListFor(m => m.Details.State.Code, (SelectList)ViewBag.State, "Select State", new { @class = "form-control form-control-sm", @onchange = "onStateChange(this,'rd_state');validate(this,'rd_State')" })
                    <span id="rd_State"></span>
                </div>
            </div>

        </div>

        <div class="row my-2">
            <div class="col-md-4">
                <div class="form-group">
                    <label>
                        District
                        @*<span class="Mandatory">*</span>*@
                    </label>
                    @Html.DropDownListFor(m => m.Details.District.Code, (SelectList)ViewBag.District, "Select District", new { @class = "form-control form-control-sm", @onchange = "validate(this,'rd_District')" })
                    <span id="rd_District"></span>
                </div>
            </div>

        </div>






    </div>

</div>

<!-- <end table></end> -->
<div class="row card-footer-bottom-fixed">

    <div class="col-md-12 align-right">
        <button type="button" onclick="onNextClick('Rd_Address')"
                class="btn btn-default float-right mobile-full-width">
            Next
        </button>
    </div>

</div>