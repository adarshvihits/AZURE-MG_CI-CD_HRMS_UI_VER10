@model Hrms.Lite.Shared.DataBank.DTO.ResumeDataBank
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>
<script src="~/scripts/DataBank/ResumeDataBank/resumeDataBank.js"></script>

        <!--begin::Header-->
        <div id="kt_header" class="header header-fixed">
            <!--begin::Container-->
            <div class="container-fluid d-flex align-items-stretch justify-content-between">
                <!--begin::Header Menu Wrapper-->

                <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                    <!--begin::Header Menu-->
                    <div class="d-flex align-items-baseline flex-wrap mr-5">
                        <h3 class="main-title">Resume Repository</h3>
                        <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                            <li class="breadcrumb-item ">
                                <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                                    <i class="icon-nm fas fa-home mt-1"></i>
                                </a>
                            </li>

                            <li class="breadcrumb-item text-muted">
                                Resume Repository
                            </li>
                        </ul>
                    </div>
                </div>


            </div>
            <!--end::Container-->
        </div>
        <!--end::Header-->
        <!--begin::Content-->
        <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
            <!--begin::Entry-->
            <div class="d-flex flex-column-fluid">
                <!--begin::Container-->
                <div class="container full-width">
                    <!--begin::Dashboard-->
                    <!--begin::Row-->



                    <div class="card card-custom height-100per footer-row-fixed">

                        <div class="card-body">
                            <!--begin: Search Form-->
                            <!-- TILE STYLE -->
                            <!-- TILE STYLE -->

                            <div class="row tab-style-button">
                                <div class="tab-button-wrap">
                                    <div class="tab-items ">
                                        <a href="#" class="btn-title rdAll active" onclick="onTabClick(@Model.ResumeDataBankListTabs[0].Code,'rdAll',  '@Model.ResumeDataBankListTabs[0].Name')">
                                            @Model.ResumeDataBankListTabs[0].Name
                                            <span class="btn-notification allCount">@Model.AllTabCount</span>
                                        </a>
                                    </div>
                                    <div class="tab-items medium">
                                        <a href="#" class="btn-title rdTab1" onclick="onTabClick(@Model.ResumeDataBankListTabs[1].Code,'rdTab1',  '@Model.ResumeDataBankListTabs[1].Name')">
                                            @Model.ResumeDataBankListTabs[1].Name
                                            <span class="btn-notification tab1Count"> @Model.Tab1Count</span>
                                        </a>
                                    </div>
                                    <div class="tab-items high">
                                        <a href="#" class="btn-title rdTab2" onclick="onTabClick(@Model.ResumeDataBankListTabs[2].Code,'rdTab2',  '@Model.ResumeDataBankListTabs[2].Name')">
                                            @Model.ResumeDataBankListTabs[2].Name
                                            <span class="btn-notification tab2Count"> @Model.Tab2Count</span>
                                        </a>
                                    </div>
                                    <div class="tab-items ">
                                        <span class="btn-title rdTab3" onclick="onTabClick(@Model.ResumeDataBankListTabs[3].Code,'rdTab3',  '@Model.ResumeDataBankListTabs[3].Name')">
                                            @Model.ResumeDataBankListTabs[3].Name
                                            <span class="btn-notification tab3Count">  @Model.Tab3Count</span>
                                        </span>
                                    </div>
                                    <div class="tab-items ">
                                        <span class="btn-title rdTab5" onclick="onTabClick(@Model.ResumeDataBankListTabs[5].Code,'rdTab5',  '@Model.ResumeDataBankListTabs[5].Name')">
                                            @Model.ResumeDataBankListTabs[5].Name
                                            <span class="btn-notification tab5Count">  @Model.Tab5Count</span>
                                        </span>
                                    </div>
                                    @*<div class="tab-items ">
                                        <span class="btn-title rdTab4" onclick="onTabClick(@Model.ResumeDataBankListTabs[4].Code,'rdTab4',  '@Model.ResumeDataBankListTabs[4].Name')">
                                            @Model.ResumeDataBankListTabs[4].Name
                                            <span class="btn-notification tab4Count"> @Model.Tab4Count</span>
                                        </span>
                                    </div>*@
                                    <div class=" d-flex rd_fromTo hide highs" style=" margin-right: -338px !important;">
                                        @*//alert: dont remove this class*@
                                        <div class="tab-items">

                                            <div class="row-outer  " style="width:200px">
                                                <div class="d-flex align-items-center">
                                                    <label class="mr-3">From</label>
                                                    <div class="input-group date">
                                                        @Html.TextBoxFor(Model => Model.From, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "From", @onchange = "onDateChange(this, 'from')" })
                                                        <div class="input-group-append">
                                                            <span class="input-group-text">
                                                                <i class="la la-calendar"></i>
                                                            </span>
                                                        </div>
                                                    </div>

                                                    <span id="rd_From"></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="tab-items">

                                            <div class="row-outer " style="width:200px">
                                                <div class="d-flex align-items-center">
                                                    <label class="mr-3">To</label>
                                                    <div class="input-group date">
                                                        @Html.TextBoxFor(Model => Model.To, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "To", @onchange = "onDateChange(this,'to')" })
                                                        <div class="input-group-append">
                                                            <span class="input-group-text">
                                                                <i class="la la-calendar"></i>
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <span id="rd_To"></span>
                                                    </div>
                                                </div>
                                            </div>
                                    </div>

                                    <div class="tab-items select-option  ">


                                        <div class="sraech-slider">
                                            <div class="search-slider-inner">
                                                <i class="fa fa-search"></i>
                                            </div>
                                            <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                                   placeholder="ID/Name">
                                        </div>

                                        <!-- FILTER SECTION START -->
                                        <div id="filterForm" class="filter-button slider-btn rd_filter" data-bs-toggle="tooltip" title="Filter">
                                            <i class="fas fa-filter"></i>
                                            <i class="fas fa-check"></i>
                                        </div>

                                        <!-- FILTER SECTION END -->
                                        <button data-bs-toggle="tooltip" title="" class="btn btn-excel float-left" onclick="onExportToExcelClick()"
                                                data-bs-original-title="Export to Excel">
                                            <i class="icon-xl far fa-file-excel"onclick="ResumeExportToExcel()"></i>
                                        </button>
                                    </div>

                                </div>
                            </div>

                            <!-- Table Section -->

                            <div id="rdList">
                                @await Html.PartialAsync("_ResumeList")
                            </div>

                            <div id="filterSlider">
                                @await Html.PartialAsync("_Filter",Model.Filter)
                            </div>
                            <!-- Table Setion End -->
                            <div class="row row card-footer-bottom-fixed">
                                <div class="col-md-12">
                                    <a href="@Url.Action("Create", "ResumeDataBank" ,new { Area="DataBank"})" type="button"
                                       class="btn btn-default float-right mobile-full-width ">
                                        Add New
                                        Resume
                                    </a>


                                </div>




                            </div>


                            <!--end: Datatable-->
                        </div>
                    </div>


                    <!--end::Row-->
                    <!--begin::Row-->
                    <!--end::Row-->
                    <!--end::Dashboard-->
                </div>
                <!--end::Container-->
            </div>
            <!--end::Entry-->

        </div>
