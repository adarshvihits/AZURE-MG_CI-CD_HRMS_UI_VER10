            <div class="row card-footer-bottom-fixed border-none">
                <div class="col-md-12 align-right">
                    <a type="button"
                       class="btn btn-secondary  mobile-full-width" onclick="ApplyFilter('reset')">
                        Reset
                    </a>
                    <a type="button"
                       class="btn btn-default  mobile-full-width" onclick="ApplyFilter('apply')">

                        Apply
                    </a>
                </div>

