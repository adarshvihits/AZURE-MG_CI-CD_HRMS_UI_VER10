@model Hrms.Lite.Shared.DataBank.DTO.ResumeDataBank
<style>
    .step-outer .step-item {
        left: 0px;
    }
</style>


    <div class="step-outer ">

        <a href="#" class="step-item active" onclick="onTabNameClick('Rd_Basic')">
            Basic Details
            <span class="step-circle"></span>
        </a>
        <a href="#" class="step-item active" onclick="onTabNameClick('Rd_Address')">
            Address
            <span class="step-circle"></span>
        </a>
        <a href="#" class="step-item active" onclick="onTabNameClick('Rd_Experience')">
            Experience
            <span class="step-circle"></span>
        </a>
        <a href="#" class="step-item active" onclick="onTabNameClick('Rd_Education')">
            Education
            <span class="step-circle"></span>
        </a>
        <a href="#" class="step-item active" onclick="onTabNameClick('Rd_Certification')">
            Certifications
            <span class="step-circle"></span>
        </a>
        <a href="#" class="step-item active" onclick="onTabNameClick('Rd_Skill')">
            Skills
            <span class="step-circle"></span>
        </a>
        <div class="step-item active">
            Summary
            <span class="step-circle"></span>
        </div>
    </div>
    <div class="step-progress-outer row">

        <div class="step-demo col-md-5">
            <img src="~/images/resume_template.png" style="max-width: 100%;" />
        </div>

        <div class="step-left col-md-7">
            <h2>Summary</h2>


            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Suitable Designation   <span class="Mandatory">*</span> </label>
                        @Html.ListBoxFor(Model => Model.Details.SuitedDesignation, (SelectList)ViewBag.Designation,
                       new
                            {
                                @class = "multiselectDropdownField form-control-multiselect form-control-sm",
                                @multiple = "multiple"
                            ,
                                @onblur = "validate(this, 'rd_SuitedDesignation')"
                       })
                    </div>
                    <span id="rd_SuitedDesignation"></span>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Suitable Location<span class="Mandatory">*</span></label>
                        @Html.ListBoxFor(Model => Model.Details.SuitableLocation, (SelectList)ViewBag.Location, new
                        {
                       @class = "multiselectDropdownField form-control-multiselect form-control-sm",
                            @multiple = "multiple"
                       ,
                            onblur = "validate(this, 'rd_SuitableLocation')"
                   })

                    </div>
                    <span id="rd_SuitableLocation"></span>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Referral/Source of Application    <span class="Mandatory">*</span></label>
                        @Html.DropDownListFor(m => m.Details.ResumeSource.Code, (SelectList)ViewBag.ResumeSource, "--Select--", new { @class = "form-control form-control-sm", @onchange = "validate(this, 'rd_ResumeSource')" })
                        <span id="rd_ResumeSource"></span>
                    </div>
                </div>

            </div>

            <div class="row my-2">
                <div class="col-md-12">
                    <div class="form-group">
                        <label>Description</label>

                        @Html.TextBoxFor(m => m.Details.Description, new { @placeholder = "Description", @class = "form-control form-control-sm", @maxlength = "250" })

                    </div>
                </div>


            </div>



        </div>

    </div>

    <!-- <end table></end> -->
    <div class="row card-footer-bottom-fixed">

        <div class="col-md-12 align-right">
            <button type="button" onclick="onResumeDBSaveClick()"
                    class="btn btn-default float-right mobile-full-width">
                Save
            </button>
        </div>

    </div>