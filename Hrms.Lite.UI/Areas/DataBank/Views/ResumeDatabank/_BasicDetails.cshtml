@model Hrms.Lite.Shared.DataBank.DTO.ResumeDataBank



    <script>
    $(document).ready(function () {
        debugger
        $.ajax({

            type: 'GET',
            url: '/AccessFile/GetFileStorageType',

            success: function (data) {

                if (data == 'BLOB') ifAzure();
                else

                    $('.emp_HeaderPic').css('background-image', "url('" + '@Model.Details.CandidatesPhoto.AbsoluteUri' + "')");

            },
            error: function (xhr, textStatus, errorThrown) {
                if ($($.parseHTML(xhr.responseText)).filter(".Login_Session").length > 0) {
                    window.location.reload();
                }
                else {
                    document.body.id = "kt_body";
                    $('body').html(xhr.responseText);
                }
            }
        });
        function ifAzure() {
            $.ajax({
                type: "POST",
                url: "/AccessFile/ViewAsBackGroundImage", // do not hard code your url's
                data: { filename: '@Model.Details.CandidatesPhoto.FileName' },
                success: function (data, jqXHR, response) {

                    if (jqXHR = "success") {
                        var mimeType = getMimeTypeFromFilename('@Model.Details.CandidatesPhoto.FileName');
                        debugger
                        $('.emp_HeaderPic').css('background-image', "url('" + mimeType + data + "')");


                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                }
            });
        }
    });
    </script>
<script>
    $(document).ready(function () {
        debugger;
        var b = document.getElementById('Details_Resume_AbsoluteUri');
        if (b.value == null) {
            fileLabel.innerHTML = "No File Chosen";
        }
        else {
            var b = document.getElementById('Details_Resume_ActualFileName');
            if (b.value != '') {

                let replacemnt = '..';
                theSplit = b.value.slice(0, 6);
                fileLabel.innerHTML = theSplit.substring(0, theSplit.length - 2) + replacemnt;
            }
            else {
                fileLabel.innerHTML = "";

            }
        }
    });


    window.pressed = function () {
        debugger
        var a = document.getElementById('Details_Resume_FileData');
        if (a.value == "") {
            fileLabel.innerHTML = "No File Chosen";
        }
        else {
            debugger
            var theSplit = a.value.split('\\');
            theSplit = theSplit[theSplit.length - 1];
            let replacemnt = '..';
            theSplit = theSplit.slice(0, 6);
            fileLabel.innerHTML = theSplit.substring(0, theSplit.length - 2) + replacemnt;
        }
    };


</script>
<style>

    .Resume_FileData {
        color: white !important;
    }

    .step-progress-outer .btn.btn-icon i::before {
        color: #fff;
    }

    .step-outer .step-item {
        left: 0px;
    }
</style>


<div class="step-outer ">

    <div class="step-item active">
        Basic Details
        <span class="step-circle"></span>
    </div>
    <div class="step-item">
        Address
        <span class="step-circle"></span>
    </div>
    <div class="step-item">
        Experience
        <span class="step-circle"></span>
    </div>
    <div class="step-item">
        Education
        <span class="step-circle"></span>
    </div>
    <div class="step-item">
        Certifications
        <span class="step-circle"></span>
    </div>
    <div class="step-item">
        Skills
        <span class="step-circle"></span>
    </div>
    <div class="step-item">
        Summary
        <span class="step-circle"></span>
    </div>
</div>
<div class="step-progress-outer row">
    <div class="step-demo col-md-5">
        <img src="~/images/resume_template.png" style="max-width: 100%;" />
    </div>


    <div class="step-left col-md-7">
        <h2>Let's Complete your CV Heading</h2>

        <div class="row my-2">

            <div class="col-md-3">

                <div class="profile-header">
                    <div class="image-input image-input-outline image-input-circle  " id="kt_image_4">

                        @Html.HiddenFor(m => m.Mode)
                        @if (Model.Mode == "CREATE" && Model.Details.CandidatesPhoto == null)
                        {
                            <div class="image-input-wrapper " data-bs-toggle="tooltip" title="" data-bs-original-title="Click to upload photo"
                                 style="background-image:url(/images/blank.png)">
                            </div>
                        }
                        else
                        {
                            @*<div class="image-input-wrapper"
                                     style="background-image: url('@Model.Details.CandidatesPhoto.AbsoluteUri')">
                                </div>*@
                            <div class="image-input-wrapper emp_HeaderPic">
                                @*style="background-image: url('@Model.Details.CandidatesPhoto.AbsoluteUri')">*@
                            </div>

                            @Html.HiddenFor(m => m.Details.CandidatesPhoto.AbsoluteUri)
                            @Html.HiddenFor(m => m.Details.CandidatesPhoto.FileName)
                        }


                        <label class="btn btn-icon btn-circle btn-white btn-hover-text-primary btn-shadow" data-action="change" onclick="$('#Details_CandidatesPhoto_FileData').trigger('click')">
                            <i class="fa fa-pen icon-sm text-muted"></i>
                        </label>






                        <span class="btn btn-icon btn-circle btn-white btn-hover-text-primary btn-shadow" data-action="cancel" data-bs-toggle="tooltip" title="" data-bs-original-title="Cancel avatar">
                            <i class="fa fa-times" aria-hidden="true"></i>
                        </span>

                        <span class="btn btn-icon btn-circle btn-white btn-hover-text-primary btn-shadow" data-action="remove" data-bs-toggle="tooltip" title="" data-bs-original-title="Remove photo">
                            <i class="fa fa-times" aria-hidden="true"></i>
                        </span>
                    </div>
                    @Html.HiddenFor(m => m.Details.CandidatesPhoto.FileData, new { @type = "file", @name = "profile_avatar", onchange = "validateProfilePhoto()", @style = "display:none", accept = ".jpg, .jpeg" })
                </div>



            </div>
            <div class="col-md-9">
                <div class="form-group mt-16" style="width:250px;">
                    <label>
                        Applicant ID
                        @*<span class="Mandatory">*</span>*@
                    </label>

                    @Html.TextBoxFor(m => m.Details.RefNo, new { @class = "form-control form-control-sm", @placeholder = "Full Name", @maxlength = 120, @onblur = "validate(this,'rd_refnumber')", @disabled = "true" })
                    @Html.HiddenFor(m => m.Details.RefNo)
                    <span id="rd_refnumber"></span>
                </div>
                <div class="form-group mt-2">
                    <label>
                        Name as per aadhar
                        <span class="Mandatory">*</span>
                    </label>

                    @Html.TextBoxFor(m => m.Details.FullName, new { @class = "form-control form-control-sm", @placeholder = "Full Name", @maxlength = 120, @onblur = "capitalizeFirstLetter(this,'rd_fullname')", @onkeypress = "return onlyLettersKey(event)" })
                    <span id="rd_fullname"></span>
                </div>
            </div>
        </div>



        <div class="row my-2">
            <div class="col-md-4">
                <div class="form-group">
                    <label>
                        Mobile number linked to aadhar
                        <span class="Mandatory">*</span>
                    </label>
                    @Html.TextBoxFor(m => m.Details.Mobile, new { @class = "form-control form-control-sm", @maxlength = 10, @placeholder = "Mobile", @onblur = "validateMobileNumber('Details_Mobile','rd_mobile')", @onkeypress = "return onlyNumberKey(event)" })
                    <span id="rd_mobile"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label>
                        Email
                        <span class="Mandatory">*</span>
                    </label>

                    @Html.TextBoxFor(m => m.Details.Email, new { @class = "form-control form-control-sm", @placeholder = "Email", @onblur = "validateEmailID(this, 'rd_Email')" })
                    <span id="rd_Email"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label>
                        DOB
                        <span class="Mandatory">*</span>
                    </label>
                    <div class="input-group date">
                        @Html.TextBoxFor(m => m.Details.DOB, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "DOB", @onchange = "validateDateOfBirth(this,'rd_dob')" })

                        <div class="input-group-append">
                            <span class="input-group-text">
                                <i class="la la-calendar"></i>
                            </span>
                        </div>
                    </div>
                    <span id="rd_dob"></span>
                </div>
            </div>
        </div>


        <div class="row my-2">

            <div class="col-md-4">
                <div class="form-group">

                    <label>
                        Gender
                        <span class="Mandatory">*</span>
                    </label>
                    @Html.DropDownListFor(m => m.Details.Gender.Code, (SelectList)ViewBag.Gender, "Select Gender", new { @class = "form-control form-control-sm", @onchange = "validate(this,'rd_Gender')" })
                    <span id="rd_Gender"></span>

                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label>
                        Marital Status
                        <span class="Mandatory">*</span>
                    </label>
                    @Html.DropDownListFor(m => m.Details.MaritalStatus.Code, (SelectList)ViewBag.marital, "Select MaritalStatus", new { @class = "form-control form-control-sm", @onchange = "validate(this,'rd_marital')" })

                    <span id="rd_marital"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label>
                        Aadhar Number
                        @*<span class="Mandatory">*</span>*@
                    </label>
                    @Html.TextBoxFor(m => m.Details.Adhar, new { @class = "form-control form-control-sm", @placeholder = "Aadhar Number", @onblur = "validateAadharWithoutMandatory('Details_Adhar', 'rd_Adhar')", @maxlength = "12", @onkeypress = "return onlyNumberKey(event)" })
                    <span id="rd_Adhar"></span>
                </div>
            </div>

        </div>

        <div class="row my-2">

            <div class="col-md-4">
                <div class="form-group">
                    <label>
                        Pan Number
                        @*<span class="Mandatory">*</span>*@
                    </label>
                    @Html.TextBoxFor(m => m.Details.PAN, new { @class = "form-control form-control-sm", @placeholder = "Pan Number", @maxlength = "10", @onblur = "validatePanWithoutMandatory('Details_PAN', 'rd_Pan')" })
                    <span id="rd_Pan"></span>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-group">
                    <label>
                        Driving License Number
                        @*<span class="Mandatory">*</span>*@
                    </label>
                    @Html.TextBoxFor(m => m.Details.DrivingLicenseNo, new { @class = "form-control form-control-sm", @placeholder = "Driving License Number" })
                    <span id="rd_License"></span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="file-upload-form-group">
                    <label for="formFileMultiple" class="form-label">
                        Resume Upload
                        <span class="Mandatory">*</span>
                    </label>

                    <div class="file-upload-form mb-1" data-bs-toggle="tooltip" data-bs-original-title="Only pdf, doc, docx files are
                                            allowed , File size less than 1 MB.">
                        <div class="small-btn-group">

                            <button type="button" data-bs-toggle="tooltip" data-placement="top" data-bs-original-title="View Image" class="btn btn-icon btn-default" onclick="Preview()"><i class="icon-xl far fa-eye"></i></button>

                        </div>

                        @Html.TextBoxFor(m => m.Details.Resume.FileData, new { @type = "file", @name = "profile_avatar", @class = "form-control PreviewImage nofilechosen Resume_FileData", onchange = "pressed();CheckResumeExtensionSize(this)", title = " " })
                        @Html.HiddenFor(m => m.Details.Resume.AbsoluteUri)
                        @Html.HiddenFor(m => m.Details.Resume.ActualFileName)
                        <label id="fileLabel" class="nofilelabel notchlabel"></label>
                    </div>


                </div>
                <span id="resum"></span>
            </div>

        </div>



    </div>

</div>

<!-- <end table></end> -->
<div class="row card-footer-bottom-fixed">

    <div class="col-md-12 align-right">
        <button type="button" onclick="onNextClick('Rd_Basic')"
                class="btn btn-default float-right mobile-full-width">
            Next
        </button>
    </div>

</div>


<div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content popup">
            <div class="modal-header" style="padding:10px">
                <h5 class="modal-title" id="exampleModalLabel">Update Profile Photo</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close" onclick="clearPopUp()">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>


            <div class="modal-body">

            </div>

        </div>
    </div>
</div>