@model Hrms.Lite.Shared.DataBank.DTO.ApprovalMatrix
<link href="~/css/custom.css" rel="stylesheet" />
<script src="~/js/tooltip.js"></script>
<script src="~/js/Multiselectdropdown.js"></script>
<script>
    $(document).ready(function () {
        // Prevent form submission on Enter for NoOfLevels
        $('#NoOfLevels').on('keydown', function (e) {
            if (e.key === "Enter" || e.keyCode === 13) {
                e.preventDefault();
                return false;
            }
        });
    });


</script>
<style>
    .multiselect-native-select .btn.dropdown-toggle {
        border: none !important;
    }
</style>
@using (Html.BeginForm("Create", "ApprovalMatrix", FormMethod.Post, new { id = "ApprovalMatrixSave" }))
{
    @Html.HiddenFor(model => Model.ApprovalMatrixGI)
    <div id="approvalMatrix" class="slider-forms slider-forms-open closeEdit">
        <div class="slider-inner-style  new-inner-style">
            <div class="slider-form-close">
                <i class="ki ki-close icon-xs text-muted" onclick="CloseeSlider('closeEdit')"></i>
            </div>
            <div class="location-slider">

                <h4>
                    Approval Matrix
                </h4>

            </div>
            <div class="add-padding">
                <div class="row">

                    <div class="col-md-12">
                        <div class="form-group">
                            <div class="row-ithems">
                                <label class="view-title">Workflow</label>
                                <div class="view-details">@Model.WorkFlowName</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">

                    <div class="col-md-12">
                        <div class="form-group matrix_location">
                            <div class="row-ithems">
                                <label class="view-title">Level & Role</label>
                                <div class="view-details">@Model.RoleName</div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
} 
