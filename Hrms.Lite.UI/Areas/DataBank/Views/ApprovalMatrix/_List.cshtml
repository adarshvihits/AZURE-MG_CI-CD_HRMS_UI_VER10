@model Hrms.Lite.Shared.DataBank.DTO.ApprovalMatrix
    <script src="~/js/settings.js"></script>
    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table ApprovalMatrix-list">
        @Html.HiddenFor(m => m.ApprovalMatrixList.Count)
        <table class="common-table" id="ApprovalMatrixTable">
            <thead>
                <tr class="table-dark">
                    <th scope="col">Workflow</th>
                    <th scope="col">Level & Role</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>

                @if (Model.ApprovalMatrixList != null && Model.ApprovalMatrixList.Count > 0)
                {
                    for (int i = 0; i < Model.ApprovalMatrixList.Count; i++)
                    {
                <tr>
                    @Html.HiddenFor(model => Model.ApprovalMatrixList[i].ApprovalMatrixGI)
                    <td data-label="Code">@Model.ApprovalMatrixList[i].WorkFlowName</td>
                    <td data-label="Role"> @Model.ApprovalMatrixList[i].RoleName</td>
                   
                    <td data-label="Actions">
                        <div>
                            <a data-bs-toggle="tooltip" title="View" class="view_btn " onclick="getDetails('@Model.ApprovalMatrixList[i].ApprovalMatrixGI')"> </a>

                            <a data-bs-toggle="tooltip" title="Edit"
                               class="btn btn-icon btn-edit icon-only "
                               onclick="onEditClick('@Model.ApprovalMatrixList[i].ApprovalMatrixGI')">
                                <i class="icon-xl fas fa-pencil-alt"></i>
                            </a>
                            <a data-bs-toggle="tooltip" title="Delete"
                               class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="OnDeleteClick('@Model.ApprovalMatrixList[i].ApprovalMatrixGI')">
                                <i class="icon-xl far fa-trash-alt"></i>
                            </a>

                        </div>
                    </td>
                </tr>
                    }
                }


            </tbody>
        </table>

    </div>