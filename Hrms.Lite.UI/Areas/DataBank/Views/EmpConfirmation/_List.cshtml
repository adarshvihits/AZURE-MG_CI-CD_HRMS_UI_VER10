@model Hrms.Lite.Shared.DataBank.EmpConfirmation
<script src="~/js/settings.js"></script>

<div class="ihits-table table-border mobile-responsive-table Employee_Confirmation_list">
    @Html.HiddenFor(m => m.EmpConfirmationList.Count)
    <table id="empConfirmListTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Location </th>
                <th scope="col">Department</th>
                <th scope="col">Functional Designation</th>
                <th scope="col">Designation</th>
                <th scope="col">DOJ</th>
                <th scope="col">Approver</th>
                <th scope="col">Approved Date</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.EmpConfirmationList != null && Model.EmpConfirmationList.Count > 0)
            {
                for (int i = 0; i < Model.EmpConfirmationList.Count; i++)
                {
            <tr>
                @Html.HiddenFor(Model => Model.EmpConfirmationList[i].EmployeeCode)
                <td data-label="ID">@Model.EmpConfirmationList[i].EmployeeID</td>
                <td data-label="Employee Name"><a href="@Url.Action("Create", "JobTransition", new {EmployeeGI=Model.EmpConfirmationList[i].EmployeeGI,BasedOn="EmpConfirmation" , Area = "DataBank" })">@Model.EmpConfirmationList[i].EmployeeName</td>
                <td data-label="Location">@Model.EmpConfirmationList[i].Location</td>
                <td data-label="Department">@Model.EmpConfirmationList[i].Department</td>
                <td data-label="Functional Designaion">@Model.EmpConfirmationList[i].FuncDesignation</td>
                <td data-label="Designaion">@Model.EmpConfirmationList[i].Designation</td>
                <td data-label="DOJ">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.EmpConfirmationList[i].DOJ))</td>
                <td data-label="Approver">@Model.EmpConfirmationList[i].Approver</td>
                <td data-label="Approved Date">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.EmpConfirmationList[i].ApproveDate))</td>
            </tr>

                }
            }


        </tbody>
    </table>
</div>