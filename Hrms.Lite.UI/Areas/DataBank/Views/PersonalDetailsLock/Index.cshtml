@model Hrms.Lite.Shared.DataBank.PersonalDetailsLock
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>

<script src="~/scripts/DataBank/personaldetailsLock.js"></script>
<script>
    $(document).ready(function () {
        fillData('UNLOCKED');
    });
</script>


<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                   Personal Profile Lock

                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" >
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a href="@Url.Action("Index", "PersonalDetails", new { Area = "DataBank" })">Personal Profile List </a>
                    </li>
                    <li class="breadcrumb-item">
                        Personal Profile Lock

                    </li>

                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">

                            <div class="tab-items ">
                                <a class="btn-title active UNLOCKED" onclick="tabClick('UNLOCKED');">
                                    Unlocked
                                   <span class="btn-notification UnlockedCount">@Model.UnlockedCount</span>
                                </a>
                            </div>
                            <div class="tab-items high">
                                <a class="btn-title LOCKED" onclick="tabClick('LOCKED');">
                                    Locked
                                    <span class="btn-notification LockedCount">@Model.LockedCount</span>
                                </a>
                            </div>
                            <div class="tab-items select-option">
                                <div class="button-group float-left mr-10">
                                    <button type="button" class="btn btn-default btn-sm" onclick="BatchUpdate()">
                                        Batch Update
                                    </button>
                                </div>
                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div class="filter-button slider-btn" id="filterForm" data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>

                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                   data-bs-original-title="Export to Excel">
                                    <i class="icon-xl far fa-file-excel" onclick="ExportToexcel()"></i>
                                </a>
                            </div>
                            @using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "LockListsave" }))
                            {

                                <div id="tableCoreteam" class="hide">
                                    <table id="personalDtLocktablehide">
                                        <thead>
                                            <tr class="table-dark">
                                                <th scope="col">ID</th>
                                                <th scope="col">Name</th>
                                                <th scope="col">Designation</th>
                                                <th scope="col">Department</th>
                                                <th scope="col">Location </th>
                                                <th scope="col">Category</th>
                                                <th scope="col">Mobile</th>
                                                <th scope="col">Email</th>
                                                <th scope="col">DOJ</th>
                                                <th scope="col">Applicability</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>

                    </div>
                    <div>

                        @await Html.PartialAsync("~/Areas/DataBank/Views/PersonalDetailsLock/_EmpList.cshtml", Model)
                    </div>


                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
                    </div>
                    <div class="row card-footer-bottom-fixed">
                        <div class="col-md-12 align-right lockbutton">
                            <a type="button"
                               class="btn btn-default mobile-full-width" onclick="LockUnlockSave('Lock')">
                                Lock
                            </a>

                        </div>
                        <div class="col-md-12 align-right unlockbutton hide">
                            <a type="button"
                               class="btn btn-default mobile-full-width" onclick="LockUnlockSave('UnLock')">
                                UnLock
                            </a>

                        </div>

                    </div>
                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>