@model Hrms.Lite.Shared.DataBank.DTO.RequestVsAuthority

    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table request-authority-list 
">
        <table id="pendingTable">
            <thead>
                <tr class="table-dark">
                    <th scope="col">ID</th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">Fun.Designation</th>
                    <th scope="col">Department</th>
                    <th scope="col">Location</th>
                    <th scope="col">DOJ</th>
                    <th data-bs-toggle="tooltip" data-bs-original-title="Reporting Manager" scope="col">RM</th>
                    <th scope="col">Leave</th>
                    <th data-bs-toggle="tooltip" data-bs-original-title="Loan & Salary Advance" scope="col">Loan & SA</th>
                    <th data-bs-toggle="tooltip" data-bs-original-title="HR Letters" scope="col">Letters</th>
                    <th scope="col">Assets</th>
                    <th data-bs-toggle="tooltip" data-bs-original-title="Career Changes" scope="col">Career</th>

                </tr>
            </thead>
            <tbody>
                @if (Model.RequestVsAuthorityList != null && Model.RequestVsAuthorityList.Count > 0)
                {

                    for (int i = 0; i < Model.RequestVsAuthorityList.Count; i++)
                    {
    <tr>
        <td data-label="ID">@Model.RequestVsAuthorityList[i].EmpId</td>
        <td data-label="Name">
            <div class="name-with-img">
                @Html.HiddenFor(m => m.RequestVsAuthorityList[i].EmployeeGI)
                <a id="EditDisciplinaryIncident" class="slider-btn" onclick="onEmployeeClick('@Model.RequestVsAuthorityList[i].EmployeeGI')">@Model.RequestVsAuthorityList[i].EmployeeName</a>


            </div>
        </td>
        <td data-label="Designation">@Model.RequestVsAuthorityList[i].Designation</td>
        <td data-label="Department">@Model.RequestVsAuthorityList[i].Department</td>
        <td data-label="Location">@Model.RequestVsAuthorityList[i].Location</td>
        <td data-label="Incident">@Model.RequestVsAuthorityList[i].DOJ.ToShortDateString()</td>
        <td data-label="Rep">
            @if (Model.RequestVsAuthorityList[i].RM != true)
            {
<button type="button"
        class="btn btn-icon btn-close border-radius">
    <i class="icon-xl fas fa-times"></i>
</button> }
                    else
                    {
<button type="button" class="btn btn-icon btn-tick">
    <i class="icon-xl fas fa-check"></i>
</button>}
        </td>
        <td data-label="Payment">
            @if (Model.RequestVsAuthorityList[i].LEAVE != true)
            {
<button type="button"
        class="btn btn-icon btn-close border-radius">
    <i class="icon-xl fas fa-times"></i>
</button> }
                    else
                    {
<button type="button" class="btn btn-icon btn-tick">
    <i class="icon-xl fas fa-check"></i>
</button>}
        </td>
        <td data-label="Assets">
            @if (Model.RequestVsAuthorityList[i].LOAN != true)
            {
<button type="button"
        class="btn btn-icon btn-close border-radius">
    <i class="icon-xl fas fa-times"></i>
</button> }
                    else
                    {
<button type="button" class="btn btn-icon btn-tick">
    <i class="icon-xl fas fa-check"></i>
</button>}
        </td>
        <td data-label="Letters">
            @if (Model.RequestVsAuthorityList[i].LETTERS != true)
            {
<button type="button"
        class="btn btn-icon btn-close border-radius">
    <i class="icon-xl fas fa-times"></i>
</button> }
                    else
                    {
<button type="button" class="btn btn-icon btn-tick">
    <i class="icon-xl fas fa-check"></i>
</button>}
        </td>
        <td data-label="Reporting M">
            @if (Model.RequestVsAuthorityList[i].ASSETS != true)
            {
<button type="button"
        class="btn btn-icon btn-close border-radius">
    <i class="icon-xl fas fa-times"></i>
</button> }
                    else
                    {
<button type="button" class="btn btn-icon btn-tick">
    <i class="icon-xl fas fa-check"></i>
</button>}
        </td>
        <td data-label="Career Changes">
            @if (Model.RequestVsAuthorityList[i].CARRER != true)
            {
<button type="button"
        class="btn btn-icon btn-close border-radius">
    <i class="icon-xl fas fa-times"></i>
</button> }
                    else
                    {
<button type="button" class="btn btn-icon btn-tick">
    <i class="icon-xl fas fa-check"></i>
</button>}
        </td>
    </tr>                }
                }
            </tbody>
        </table>
    </div>