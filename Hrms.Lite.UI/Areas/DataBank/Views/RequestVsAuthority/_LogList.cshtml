@model Hrms.Lite.Shared.DataBank.DTO.RequestVsAuthority
<div class="row">

    <div class="col-md-12">
        <h3>Log</h3>
        <div class="ihits-table table-border mobile-responsive-table mt-2 request-authority-two">
            <table>
                <thead>
                    <tr class="table-light">
                        <th scope="col">Request Type</th>
                        <th scope="col">Authority Details</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.LogDetails != null && Model.LogDetails.Count > 0)
                    {

                        for (int i = 0; i < Model.LogDetails.Count; i++)
                        {
                            <tr>
                                <td data-label="ID">@Model.LogDetails[i].RequestName</td>
                                <td data-label="Level">@Model.LogDetails[i].AuthorityDetails</td>
                               
                            </tr>

                        }
                    }

                </tbody>
            </table>
        </div>

    </div>
</div>