@model Hrms.Lite.Shared.DataBank.DTO.InductionTraining
<script src="~/js/settings.js"></script>
<div class="ihits-table table-border mobile-responsive-table Loan_Confirmation pt-3">

    <table class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">DOJ</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.InductionTrainingList != null && Model.InductionTrainingList.Count > 0)
            {

                for (int i = 0; i < Model.InductionTrainingList.Count; i++)
                {
                    <tr>
                        <td data-label="ID">@Model.InductionTrainingList[i].EmpId</td>
                        <td data-label="Name"> <a id="InductionTraining" onclick="getInductionDetails('@Model.InductionTrainingList[i].HeadCode','@Model.InductionTrainingList[i].EmployeeCode')">@Model.InductionTrainingList[i].EmployeeName</a></td>
                        <td data-label="Designation">@Model.InductionTrainingList[i].Designation.Name</td>
                        <td data-label="Department">@Model.InductionTrainingList[i].Department.Name</td>
                        <td data-label="Location">@Model.InductionTrainingList[i].Location.Name</td>
                        <td data-label="DOJ">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.InductionTrainingList[i].DOJ))</td>
                    </tr>
                }
            }
        </tbody>

    </table>
</div>