@model Hrms.Lite.Shared.DataBank.DTO.EmployeeVsCustomField
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/DataBank/employeeCustomField.js"></script>
<script>
    $(document).ready(function () {
        fillData();
    });
</script>
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Employee Custom Field
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Employee Custom Field
                    </li>

                </ul>
            </div>
        </div>

    </div>

</div>

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body ">
                            @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "EmpCustField", enctype = "multipart/form-data" }))
                            {
                                <div class="row tab-style-button">
                                    <div class="tab-button-wrap">

                                        <div class="tab-items">
                                            <label>Type</label>
                                            <div class="form-group filter-combobox mt-0">
                                                @Html.DropDownListFor(m => m.CustomField.CustomFieldCode, (SelectList)ViewBag.CustomFieldType,  new { @class = "form-control form-control-sm", @onchange = "fillData()" })
                                            </div>
                                            <span id="esi" style="bottom: -20px;"></span>
                                        </div>
                                          <div class="tab-items d-flex align-items-center">
                                              <div class="radio-inline">
                                                  <label class="radio radio-outline radio-success" style="margin-right:12px;">
                                                      @Html.RadioButtonFor(Model => Model.CustomField.EmployeeStatus, "y",new { @onchange = "fillData()" })
                                                      <span></span>Active
                                                  </label>
                                                  <label class="radio radio-outline radio-success" style="margin-right:12px;">
                                                      @Html.RadioButtonFor(Model => Model.CustomField.EmployeeStatus, "n", new { @onchange = "fillData()" })
                                                      <span></span>Resigned
                                                  </label>
                                              </div>
                                        </div>








                                        <div class="tab-items select-option pt-5">
                                            <div class="sraech-slider">
                                                <div class="search-slider-inner">
                                                    <i class="fa fa-search"></i>
                                                </div>
                                                <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                                       placeholder="ID/Name">
                                            </div>
                                            <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                                <i class="fas fa-filter"></i>
                                                <i class="fas fa-check"></i>
                                            </div>
                                            <a data-bs-toggle="tooltip" title="Export to Excel"
                                               class="btn btn-excel" onclick="ExportToExcel()">
                                                <i class="icon-xl far fa-file-excel"></i>
                                            </a>
                                            <button type="button" data-bs-toggle="tooltip" title="Import From Excel" onclick="ImportFromExcelPopUp()"
                                                    class="btn btn-excel ml-0 import">
                                                <i class="fa fa-upload icon-xls" aria-hidden="true"></i>
                                            </button>
                                        </div>


                                    </div>
                                    <div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
                                        <div class="modal-dialog modal-lg">
                                            <div class="modal-content popup">
                                                <div class="modal-header" style="padding:10px">
                                                    <h5 class="modal-title" id="exampleModalLabel">Upload Format</h5>
                                                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close" onclick="$('#Unmatched').html('');$('#Excel_FileData').val()">
                                                        <i aria-hidden="true" class="ki ki-close"></i>
                                                    </button>
                                                </div>

                                                <div class="modal-body pt-3">

                                                    <div class="colums_list pb-1">
                                                        Please ensure your Excel file contains the following columns with the exact headings. Spelling and case must match precisely for a successful import -

                                                        Employee ID,
                                                        Employee Name,
                                                        <span id="fieldName"></span><br />
                                                        @*Columns Needed :- Employee ID, Employee Name, Amount*@
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-md-4">
                                                            <div class="file-upload-form-group">
                                                                <label for="formFileMultiple" class="form-label">
                                                                    Attach
                                                                    File
                                                                    <span class="Mandatory">*</span>
                                                                </label>

                                                                <div class="file-upload-form mb-1" data-bs-toggle="tooltip" data-bs-original-title=" Only pdf, doc, docx files are
                                            allowed , File size less than 1 MB.">
                                                                    <div class="small-btn-group">

                                                                        <button type="button" data-bs-toggle="tooltip" data-placement="top" data-bs-original-title="View Image" class="btn btn-icon btn-default"><i class="icon-xl far fa-eye"></i></button>

                                                                    </div>
                                                                    <input id="File_AbsoluteUri" name="File.AbsoluteUri" type="hidden" value="">
                                                                    @*<input accept=".png, .jpg, .jpeg, .pdf" id="File_FileData" name="File.FileData" onchange="CheckImageExtensionSize(this)" title="" type="file">*@
                                                                    @Html.HiddenFor(model => model.Excel.FileData, new { type = "file", @class = "input-file PreviewImage form-control h-100", @onchange = "onImportExcelClick()" })

                                                                </div>


                                                            </div>


                                                        </div>

                                                    </div>

                                                    <div id="Unmatched">

                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                                <div class="row card-footer-bottom-fixed">

                                    <div class="col-md-12 align-right">
                                        <a id="addregion" class="btn btn-default float-right mobile-full-width " data-bs-toggle="modal" data-target=".customFieldPopUp" onclick="GetCustomFieldPopUp()">
                                            Add
                                            New
                                        </a>
                                    </div>

                                </div>


                                <div id="ListView">
                                    @await Html.PartialAsync("_List")
                                </div>
                                <div id="editSlider">

                                </div>
                                <div id="filterSlider">

                                    @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
                                </div>

                                <!-- <end table></end> -->
                                <div class="modal fade customFieldPopUp" tabindex="-1"
                                     role="dialog" aria-labelledby="myLargeModalLabel"
                                     aria-hidden="true">
                                    <div class="modal-dialog" style="max-width:800px;">
                                        <div class="modal-content popup " style="height:400px ; ">
                                            <div class="modal-header" style="padding:10px">
                                                <h5 class="modal-title" id="exampleModalLabel">
                                                    Add New
                                                </h5>
                                                <button type="button" class="close"
                                                        data-bs-dismiss="modal" aria-label="Close">
                                                    <i aria-hidden="true" class="ki ki-close"></i>
                                                </button>
                                            </div>
                                            <div class="modal-body"></div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                    </div>
                </div>
            </div>

        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>



