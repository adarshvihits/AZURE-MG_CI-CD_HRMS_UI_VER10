@model Hrms.Lite.Shared.DataBank.DTO.Training
<script>
$(document).ready(function () {
    debugger;
    $('#EmpCode').val("");
    $("#EmpCode").find("option").eq(0).hide();
});
</script>
<div id="addNewAssets" class="slider-forms slider-forms-open">
    <div class="slider-inner-style">
        <div class="slider-form-close"><i class="ki ki-close icon-xs text-muted"></i></div>
        <h4>Training</h4>
        <div class="slider-search-field">
            @*<input type="text" class="sliderSearchInput" placeholder="ID/Name">*@
            @Html.DropDownListFor(m => m.EmpCode, (SelectList)ViewBag.Emp, "Search by Employee name/ID", new
                {
                    @class = "selectpicker sliderSearchInput form-control form-control-sm",
                    @onchange = "OnEmpChange(this)",
                    data_show_subtext = "true",
                    data_live_search = "true"
            })

            @await Html.PartialAsync("~/Areas/DataBank/Views/Training/_EmployeeCard.cshtml", Model.EmployeeHeader)

        </div>








    </div>
</div>