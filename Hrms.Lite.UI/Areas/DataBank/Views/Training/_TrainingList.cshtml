<div class="ihits-table table-border hover-color odd-even mobile-responsive-table training-list-table pt-1">
    @Html.HiddenFor(m => m.TrainingList.Count)
    <table id="trainingTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">Training Name</th>
                <th scope="col">Date</th>

            </tr>
        </thead>
        <tbody>
            @if (Model.TrainingList != null && Model.TrainingList.Count > 0)
            {

                for (int i = 0; i < Model.TrainingList.Count; i++)
                {
                    <tr>
                        <td data-label="ID">@Model.TrainingList[i].EmployeeID</td>
                        <td data-label="Employee Name">
                            @Html.HiddenFor(Model => Model.TrainingList[i].EmployeeTrainingGI)
                            @Html.HiddenFor(Model => Model.TrainingList[i].EmployeeGI)
                            <a id="trainingEmployeeDetails "  onclick="onEmployeeClick('@Model.TrainingList[i].EmployeeTrainingGI','@Model.TrainingList[i].EmployeeGI','All')">@Model.TrainingList[i].EmployeeName</a>

                        </td>
                        <td data-label="Designation">@Model.TrainingList[i].Designation.Name</td>
                        <td data-label="Department">@Model.TrainingList[i].Department.Name </td>
                        <td data-label="Location">@Model.TrainingList[i].Location.Name</td>
                        <td data-label="Attended Trainings">@Model.TrainingList[i].TrainingName</td>
                        <td data-label="Date">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.TrainingList[i].AttendedDate))</td>

                    </tr>

                }
            }

        </tbody>
    </table>
</div>
