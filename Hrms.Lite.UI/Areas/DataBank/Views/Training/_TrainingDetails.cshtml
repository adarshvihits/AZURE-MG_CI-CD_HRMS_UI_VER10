@model Hrms.Lite.Shared.DataBank.DTO.Training
    <script src="~/js/tooltip.js"></script>
<div id="trainingEmployeeDetails" class="slider-forms slider-forms-open trainingDetails">
    <div class="slider-inner-style">
        <div class="slider-form-close" onclick="CloseSlider('trainingDetails')"><i class="ki ki-close icon-xs text-muted"></i></div>
        <h4 class="mb-4">Training</h4>
        <div class="profile-header position-relative pb-12 mb-5" style="padding-bottom: 2px !important; padding-top: 5px !important;">
            <div class="row">
                @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeSliderHeader.cshtml", Model.EmployeeHeader)
            </div>
            <div class="profile-header-overflow"></div>
        </div>
        

        <div class="row">
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Training Name	</label>
                    <div class="view-details">
                        @Html.HiddenFor(m => m.EmployeeTrainingGI)
                        @Model.TrainingName
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Attended Date</label>
                    <div class="view-details">                        
                        @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.TrainingRequest.AttendedDate))
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Duration(in Hours)</label>
                    <div class="view-details">                        
                        @Model.TrainingRequest.Duration
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Training Mode</label>
                    <div class="view-details">
                        @Model.TrainingRequest.Mode.Name

                    </div>
                </div>
            </div>
        </div>





        <div class="row card-footer-bottom-fixed ">

            <div class="col-md-12 align-right">

                <a data-bs-toggle="tooltip" title="Delete" type="button" class="btn btn-icon btn-delete big-btn float-none"  onclick="onDeleteTraining('@Model.EmployeeTrainingGI')"><i class="icon-xl far fa-trash-alt"></i></a>

            </div>


        </div>




    </div>
</div>