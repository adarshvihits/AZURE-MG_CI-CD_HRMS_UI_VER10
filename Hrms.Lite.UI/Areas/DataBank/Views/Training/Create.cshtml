@model Hrms.Lite.Shared.DataBank.DTO.Training
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/scripts/DataBank/training.js"></script>
<script src="~/js/jquery.min.js"></script>
<script>
    //$(document).ready(function () {
    //    $('#TrainingRequest_Duration').val('')
    //});
    window.addEventListener('DOMContentLoaded', function () {
        $('#TrainingRequest_Duration').val('');
        $('#TrainingRequest_PostAssessmentScore').val('');
    }, true);

    const myTimeout = setTimeout(changeFocus, 500);

    function changeFocus() {
        $('#TrainingRequest_TrainingName_Code').focus();
    }
</script>
@using (Html.BeginForm("Create", "Training", FormMethod.Post, new { @class = "display-flex",@id="trainingSave" }))
{

    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->

            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Training</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>
                        <li class="breadcrumb-item text-muted">
                            <a href="@Url.Action("Index", "Training", new { Area = "DataBank" })">Training List</a>
                        </li>
                        <li class="breadcrumb-item text-muted">
                            Training
                        </li>

                    </ul>
                </div>
            </div>
            <!--begin::Topbar-->
           
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
  
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body ">
                        <!--begin: Search Form-->
                        <div class="profile-header position-relative box-shadow-none mb-6 ">
                            @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeHeader.cshtml", Model.EmployeeHeader)
                            @Html.HiddenFor(m => m.EmployeeGI)
                            <div class="profile-header-overflow"></div>
                        </div>
                        <div class="page_white">
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.HiddenFor(m => m.EmployeeGI)
                                        <label>Training Name</label>
                                        <span class="Mandatory">*</span>
                                        @*<select class="form-control form-control-sm " id="exampleSelects">
                        <option value="Training Name">Training Name</option>
                        <option value="Training Name">Training Name</option>
                    </select>*@
                                        @Html.DropDownListFor(m => m.TrainingRequest.TrainingName.Code, (SelectList)ViewBag.TrainingName, "--Select Training Name--", new { @class = "form-control form-control-sm", @onchange = "onTrainingNameChange(this)" })
                                        <span id="Training"></span>
                                    </div>
                                </div>
                                <div class="col-md-3">

                                    <label class="view-title">Type</label>

                                    <div class="view-details">
                                        <span class="trainingType">@Html.DisplayFor(m => m.TrainingRequest.Type)</span>
                                    </div>

                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Attended Date</label>
                                        <span class="Mandatory">*</span>
                                        <div class="input-group date">
                                            @*<input type="text" class="form-control" id="kt_datepicker_2"
                        readonly="readonly" placeholder="Attended Date" />*@
                                            @Html.TextBoxFor(m => m.TrainingRequest.AttendedDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_8", @readonly = "readonly", @placeholder = "Attended Date", @onchange = "validateById('#TrainingRequest_AttendedDate', 'Attended')" })
                                            <div class="input-group-append">
                                                <span class="input-group-text">
                                                    <i class="la la-calendar"></i>
                                                </span>
                                            </div>
                                        </div>
                                        <span id="Attended"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group">
                                        <label>Trainer</label>
                                        <span class="Mandatory">*</span>
                                        @*<input class="form-control form-control-sm" type="text" value="text"
                    placeholder="Trainer">*@
                                        @Html.TextBoxFor(m => m.TrainingRequest.Trainer, new { @class = "form-control form-control-sm", @placeholder = "Trainer", @onblur = "validateById('#TrainingRequest_Trainer', 'Trainer')" })
                                        <span id="Trainer"></span>
                                    </div>
                                </div>
                            </div>





                            <div class="row mb-4">
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Duration(in hours)</label>
                                        <span class="Mandatory">*</span>
                                        <div class="input-group timepicker">
                                            @*<input class="form-control form-control-sm" type="text" value=""
                        placeholder="Time">*@
                                            @Html.TextBoxFor(m => m.TrainingRequest.Duration, new { @class = "form-control form-control-sm", @placeholder = "Duration(in hours)", onblur = "validateDuration(event);validateById('#TrainingRequest_Duration', 'duration');", onkeypress = "return validateDuration(event)", onpaste = "return false" })
                                            <div class="input-group-append">
                                                <span class="input-group-text">
                                                    <i class="la la-clock-o"></i>
                                                </span>
                                            </div>
                                        </div>
                                        <span id="duration"></span>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group">
                                        <label>Training Mode</label>
                                        <span class="Mandatory">*</span>
                                        @*<select class="form-control form-control-sm " id="exampleSelects">
                        <option>Online</option>
                        <option>offline</option>
                    </select>*@
                                        @Html.DropDownListFor(m => m.TrainingRequest.Mode.Code, (SelectList)ViewBag.Mode, "--Select Training Mode--", new { @class = "form-control form-control-sm", @onchange = "validateById('#TrainingRequest_Mode_Code', 'mode')" })
                                        <span id="mode"></span>
                                    </div>
                                </div>
                                <div class="col-md-3 col-xl-2 score">
                                    <div class="form-group ">
                                        <label>Post Assessment Score</label>
                                        <span class="Mandatory">*</span>
                                        @*<input class="form-control form-control-sm" type="text"
                    placeholder="Score">*@
                                        @Html.TextBoxFor(m => m.TrainingRequest.PostAssessmentScore, new { @class = "form-control form-control-sm", @placeholder = "Post Assessment Score", @maxlength = 5, onkeypress = "return onlyNumberKey(event)", @onchange = "validateById('#TrainingRequest_PostAssessmentScore', 'assessmentScore')" })
                                        <span id="assessmentScore"></span>
                                    </div>

                                </div>
                                <div class="col-md-3 col-xl-2 hide rating">
                                    <div class="form-group font-awesome">
                                        <label>Post Assessment Rating</label>
                                        @*<select class="form-control form-control-sm fa" id="exampleSelects">
                        <option>Select</option>
                        <option class="star-icons fas fa-star">1<span>&#xf005</span></option>
                        <option class="fa star-icons">2 <span>&#xf005</span><span>&#xf005</span></option>
                        <option class="fa star-icons">3 <span>&#xf005</span><span>&#xf005</span><span>&#xf005</span></option>
                        <option class="fa star-icons">4 <span>&#xf005</span><span>&#xf005</span><span>&#xf005</span><span>&#xf005</span></option>
                        <option class="fa star-icons">5 <span>&#xf005</span><span>&#xf005</span><span>&#xf005</span><span>&#xf005</span><span>&#xf005</span></option>
                    </select>*@
                                        <div class="star-rating">
                                            <input type="radio" name="stars" id="star-a" value="5" onclick="onStarRatingClick(5)" />
                                            <label for="star-a"></label>
                                            <input type="radio" name="stars" id="star-b" value="4" onclick="onStarRatingClick(4)" />
                                            <label for="star-b"></label>
                                            <input type="radio" name="stars" id="star-c" value="3" onclick="onStarRatingClick(3)" />
                                            <label for="star-c"></label>
                                            <input type="radio" name="stars" id="star-d" value="2" onclick="onStarRatingClick(2)" />
                                            <label for="star-d"></label>
                                            <input type="radio" name="stars" id="star-e" value="1" onclick="onStarRatingClick(1)" />
                                            <label for="star-e"></label>
                                        </div>
                                        @Html.HiddenFor(m => m.TrainingRequest.TrainingAssessmentMode.Code)
                                        @*@Html.DropDownListFor(m => m.TrainingRequest.PostAssessmentScore, (SelectList)ViewBag.Score, "--Select--", new { @class = "form-control form-control-sm" })*@
                                    </div>
                                </div>
                                <div class="col-md-5 col-xl-6">
                                    <div class="form-group">
                                        <label>Remarks</label>
                                        @*<input type="text" class="form-control form-control-sm" placeholder="Remarks">*@
                                        @Html.TextBoxFor(m => m.TrainingRequest.Remarks, new { @class = "form-control form-control-sm", @placeholder = "Remarks" })
                                    </div>
                                </div>

                            </div>
                        </div>

                        <hr>


                        <div id="trainingLog">
                            @await Html.PartialAsync("_TrainingLog", Model)
                        </div>

                        <div class="row card-footer-bottom-fixed">

                            <div class="col-md-12 align-right">
                                @*<a type="button" class="btn btn-default  mobile-full-width">
                </a>*@
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="ValidateTraining()">
                                    Save
                                </button>
                            </div>

                        </div>

                        <!--end: Datatable-->
                    </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>
}