@model Hrms.Lite.Shared.DataBank.DTO.Resignation

    <script src="~/js/tooltip.js"></script>

    <script src="~/scripts/DataBank/ResignationDelete.js?v=1"></script>
    <script>
        $(document).ready(function () {
            debugger;
            //$('#Name').focus();
            moveCursorToEnd('ResignationDeleteDetails_Reason');
        });


    </script>
    @using (Html.BeginForm(null,null , FormMethod.Post, new { @id = "deleteResignation" }))
    {
        <div id="resignationdelete" class="slider-forms slider-forms-open delete">
            <div class="slider-inner-style">
                <div class="slider-form-close" onclick="CloseSlider('delete')"><i class="ki ki-close icon-xs text-muted"></i></div>
                <h4 class="mb-4">Resignation Delete</h4>
                <div class="profile-header position-relative pb-12 mb-5"
                     style="padding-bottom: 2px !important; padding-top: 5px !important;">
                    <div class="row">
                        @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeSliderHeader.cshtml", Model.EmployeeHeader)
                    </div>
                    <div class="profile-header-overflow"></div>
                </div>



                <div class="reward-section border-none">

                    <div class="row">

                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Location</label>
                                <div class="view-details">
                                    @Html.HiddenFor(Model => Model.EmployeeGI)
                                    @Html.HiddenFor(Model => Model.ResignationGI)
                                    @Model.EmployeeHeader.Location.Name
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">DOJ</label>
                                <div class="view-details">
                                    @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.ResignationDeleteDetails.DOJ))
                                    @*@Model.ResignationDeleteDetails.DOJ.ToString()*@
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">


                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Y/S</label>
                                <div class="view-details">
                                    @Model.ResignationDeleteDetails.YOS
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">LWD </label>
                                <div class="view-details">
                                    @*@Model.ResignationDeleteDetails.LWD.ToString()*@
                                    @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.ResignationDeleteDetails.LWD))
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">


                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Reason</label>
                                <div class="view-details">
                                    @Model.ResignationDeleteDetails.Reason
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Stage </label>
                                <div class="view-details">
                                    @Model.ResignationDeleteDetails.Stage
                                </div>
                            </div>
                        </div>
                    </div>




                    <div class="row">

                        <div class="col-md-12">
                            <label>Remarks</label>
                            @*<textarea class="form-control form-control-sm"
                                placeholder="Remarks"></textarea>*@
                            @Html.TextAreaFor(Model => Model.ResignationDeleteDetails.Remarks, new { @class = "form-control form-control-sm", @placeholder = "Remarks", maxlength = "250" })
                            @*@Html.HiddenFor(Model => Model.ResignationDeleteDetails.Reason)*@
                        </div>
                        <span id="DeleteReason"></span>
                    </div>
                    <div class="row card-footer-bottom-fixed border-none">

                        <div class="col-md-12 align-right">

                            <a data-bs-toggle="tooltip" data-bs-original-title="Delete" class="btn btn-icon btn-delete big-btn float-none" onclick="Delete('@Model.ResignationDeleteDetails.ResignationGI','@Model.ResignationDeleteDetails.Reason')">
                            <i class="icon-xl far fa-trash-alt"></i></a>

                        </div>


                    </div>
                </div>




            </div>
        </div>
    }