@model Hrms.Lite.Shared.DataBank.DTO.CompanyDocumentUpload
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/lib/jquery/dist/jquery.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.js"></script>
<script src="~/scripts/DataBank/CompanyDocumentUpload.js"></script>
<script>
    $(document).ready(function () {
        fillData();
    });
</script>

<div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->
            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title"> Company Documents Upload</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>
                        <li class="breadcrumb-item text-muted">
                            Company Documents Upload
                        </li>
                    </ul>
                </div>
            </div>
            <!--begin::Topbar-->
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->
                <div class="card card-custom height-100per footer-row-fixed">
                    <div class="card-body">
                        <!--begin: Search Form-->
                        <div class="row tab-style-button">
                            <div class="tab-button-wrap align-items-center">
                                <div class="tab-items ">
                                    <div class="row-outer  " style="width:200px">
                                        <label></label>
                                        <div class="form-group filter-combobox  mb-0 mt-0">
                                            @Html.DropDownListFor(m => m.DocumentType.Code, (SelectList)ViewBag.docType, new { @class = "form-control form-control-sm", @onchange = "fillData()" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row pt-6 pb-1">
                                    <div class="col-md-12">
                                        <div class="">
                                            <div class="radio-inline">
                                                <label class="radio radio-outline radio-success">
                                                    @Html.RadioButtonFor(m => m.Type, "ACTIVE", new { @onchange = "fillData()", name = "Type" })
                                                    <span></span>Active
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row pt-6 pb-1">
                                    <div class="col-md-12">
                                        <div class="">
                                            <div class="radio-inline">
                                                <label class="radio radio-outline radio-success">
                                                    @Html.RadioButtonFor(m => m.Type, "RESIGNED", new { @onchange = "fillData()", name = "Type" })
                                                    <span></span>Resigned
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="tab-items select-option ">
                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>
                                    <div id="filterForm" class="filter-button slider-btn" data-bs-toggle="tooltip" title="Filter">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div id="DoucuentTableID">
                            @await Html.PartialAsync("~/Areas/DataBank/Views/CompanyDocumentUpload/_List.cshtml", Model)
                        </div>
                        <div id="sliderView">
                        
                        </div>
                        <div id="filterSlider">
                            @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
                        </div>
                        <!--end: Datatable-->
                    </div>
                </div>
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->
    </div>
    <div class="slider-over-flow"></div>
    <!--end::Content-->
</div>

<div class="modal fade compdoc-modal-lg" id="DOC_Popup" tabindex="-1" aria-labelledby="myLargeModalLabel" style="display: none;" aria-hidden="true">
    <div class="modal-dialog modal-lg" style="max-width:580px;">
        <div class="modal-content popup">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Company Document Upload</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body pt-0">
            </div>
        </div>
    </div>
</div>
