@model Hrms.Lite.Shared.DataBank.DTO.WorkUnitTransferRequest
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>
<script src="~/scripts/DataBank/workunitTransferRequestApproval.js"></script>
<div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->


            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Work Unit Transfer Acceptance</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "DashBoard", new { Area = "" })" class="">
                                <i class="icon-nm fas fa-home mt-1"></i>
                            </a>
                        </li>

                        <li class="breadcrumb-item text-muted child-mute">
                            Work Unit Transfer Acceptance
                        </li>

                    </ul>
                </div>
            </div>

            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body">

                        <div class="row tab-style-button">
                            <div class="tab-button-wrap">





                                <div class="tab-items select-option">

                                    <div class="sraech-slider" style="height:28px;">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>

                                    <button data-bs-toggle="tooltip" title="Export to Excel"
                                            class="btn btn-excel hide" onclick="ExportToExcel()">
                                        <i class="icon-xl far fa-file-excel"></i>
                                    </button>
                                </div>


                            </div>
                        </div>

                        <div id="ListView">
                            @await Html.PartialAsync("_List")
                        </div>


                        <div class="row card-footer-bottom-fixed">



                        </div>

                        <!--end: Datatable-->
                    </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->

        </div>
        <!--end::Entry-->
        .
    </div>
    <!--end::Content-->

</div>


<div class="modal fade addAuthorityPopup" tabindex="-1" aria-labelledby="myLargeModalLabel" aria-hidden="true" style="display: none;"   data-backdrop="static">
    <div class="modal-dialog" style="max-width: 750px;">
        <div class="modal-content popup ">
            <div class="modal-header" style=" padding: 5px 20px;">
                <h5 class="modal-title">
                    Work Unit Transfer Acceptance - <span id="empNameAndId"></span>
                </h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body" style=" padding: 10px 20px;">
            </div>



        </div>
    </div>
</div>