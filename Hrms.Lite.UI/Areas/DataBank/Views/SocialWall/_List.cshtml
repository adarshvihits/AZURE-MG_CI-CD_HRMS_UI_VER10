@model Hrms.Lite.Shared.DataBank.DTO.SocialWall

<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {       
        $('.pendingTabCount').html("@Model.PendingCount");
    });
</script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table ">

    <table id="SocialWallTable" class="common-table">
        <thead>
            <tr class="table-dark">

                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">Description</th>
                <th scope="col">Date</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>

            @{
                if (Model.SocialWallList != null && Model.SocialWallList.Count > 0)
                {
                    for (int i = 0; i < Model.SocialWallList.Count; i++)

                    {
                        <tr>

                           
                            <td data-label="ID">                                                                
                                @Model.SocialWallList[i].EmployeeID
                            </td>
                            <td data-label="Employee Name">@Model.SocialWallList[i].EmployeeName </td>
                            <td data-label="Designation">@Model.SocialWallList[i].Designation </td>
                            <td data-label="Department"> @Model.SocialWallList[i].Department</td>
                            <td data-label="Location">@Model.SocialWallList[i].Location </td>
                            <td data-label="Description"> @Model.SocialWallList[i].Description</td>
                            <td data-label="Date">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.SocialWallList[i].UploadDate)) </td>
                            <td data-label="Actions">                                
                                <div class="d-flex">
                                    @if (Model.Tab == "PENDING")
                                    {
                                        @*<a data-bs-toggle="tooltip" title="" class="view_btn " data-bs-original-title="View" onclick="showDocument('@Model.SocialWallList[i].file.FileName','@Model.SocialWallList[i].file.AbsoluteUri')"> </a>*@
                                        @*<a data-bs-toggle="tooltip" title="" class="btn_approve" data-bs-original-title="Approve" onclick="GetDetails('@Model.SocialWallList[i].SocialWallGI')"></a>
            <a data-bs-toggle="tooltip" title="" class="btn_reject" data-bs-original-title="Reject" onclick="ApproveOrReject('@Model.SocialWallList[i].SocialWallGI', 'Reject')"> </a>*@
                                        <a data-bs-toggle="tooltip" title="" id="approve" class="btn btn-icon btn-tick icon-only" data-bs-original-title="Approve" cursorshover="true"  onclick="GetDetails('@Model.SocialWallList[i].SocialWallGI')">
                                            <i class="icon-xl far fa-check-circle" cursorshover="true"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="" class="view_btn " data-bs-original-title="View" onclick="showDocument('@Model.SocialWallList[i].file.FileName','@Model.SocialWallList[i].file.AbsoluteUri')"> </a>
                                        <a data-bs-toggle="tooltip" title="Delete" class="btn btn-icon  icon-only mobile-full-width  float-right btn-delete" onclick="Delete('@Model.SocialWallList[i].SocialWallGI')">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }

            }


        </tbody>
    </table>
</div>