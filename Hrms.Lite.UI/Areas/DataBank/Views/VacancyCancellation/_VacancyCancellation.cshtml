@model Hrms.Lite.Shared.DataBank.DTO.VacancyCancellation


@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "VacancyCancellation" }))
{
    <div id="vacancycancellation" class="slider-forms slider-forms-open cancellationSlider">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('cancellationSlider')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4 class="mb-4"> Vacancy Cancellation</h4>



            <!----- stepper start here --->
            <div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                MRF Number
                            </label>
                            <div class="view-details">
                                @Html.HiddenFor(m => Model.VacancyManagementGI)
                                @Model.JobCode
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Job Title
                            </label>
                            <div class="view-details">
                                @Model.JobTitle
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                               Deadline
                            </label>
                            <div class="view-details">
                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.NeedByDate))
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                               Initiated By
                            </label>
                            <div class="view-details">
                                @Model.RequestedBy
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Designation
                            </label>
                            <div class="view-details">
                                @Model.Designation
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Department
                            </label>
                            <div class="view-details">
                                @Model.Department
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Location
                            </label>
                            <div class="view-details">
                                @Model.Location
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Gender
                            </label>
                            <div class="view-details">
                                @Model.Gender
                            </div>
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Y/E
                            </label>
                            <div class="view-details">
                                @Model.Experience
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                No. Of Requirements
                            </label>
                            <div class="view-details">
                                @Model.NoOfRequirements
                            </div>
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Salary Range
                            </label>
                            <div class="view-details">
                                @Model.ExGrossPay
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Remarks
                            </label>
                            <div class="view-details">
                                @Model.Remarks
                            </div>
                        </div>
                    </div>

                </div>

                <div class="row">


                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Reason For Cancellation
                            </label>
                            <div class="view-details">
                                @Html.DropDownListFor(Model => Model.CancellationReason.Code, (SelectList)ViewBag.ReasonForCancellation, "--Select--", new { @class = "form-control form-control-sm Cname", @onblur = "validate(this,'cancellation')" })
                                <span id="cancellation"></span>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Remarks
                            </label>
                            <div class="view-details">
                                @Html.TextBoxFor(Model => Model.ApproverComments, new { @class = "form-control form-control-sm approver", @placeholder = "Remarks" , @onblur = "validate(this,'approver')" })
                                <span id="approver"></span>
                            </div>
                        </div>
                    </div>

                </div>


                <!-- completed -->




                <div class="row card-footer-bottom-fixed">

                    <div class="col-md-12 align-right">
                        <button type="button" class="btn btn-danger  mobile-full-width" onclick="ClickOnCancelButton()">
                            Cancel
                        </button>

                    </div>


                </div>




            </div>
        </div>

    </div>
}