@model Hrms.Lite.Shared.DataBank.InstantMessaging
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/DataBank/instantMessaging.js"></script>
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Instant Messaging

                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>

                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "InstantMessaging", new { Area = "DataBank" })" class="">
                            Instant Messaging
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Add Employees
                    </li>
                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <div class="row">
                        <div class="col-md-8 mb-2">
                            <div class="d-flex ">
                                <div class="mt-3 border-0 after-none">Title: <span id="Mpers">@Model.Title</span></div>
                            </div>

                            <div class="d-flex ">
                                <div class="mt-3 border-0 after-none">Message: <span id="Mpers">@Model.Message</span></div>
                            </div>
                        </div>

                        <div class="col-md-4">

                            <div class=" tab-style-button">





                                <div class="tab-button-wrap">
                                    <div class="tab-items select-option">

                                        <div class="sraech-slider">
                                            <div class="search-slider-inner">
                                                <i class="fa fa-search" onclick="$('#searchList').focus();"></i>
                                            </div>
                                            <input id="searchList" type="text" class="form-control form-control-sm"
                                                   placeholder="ID/Name" onkeyup="searchRows()">
                                        </div>
                                        <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                            <i class="fas fa-filter"></i>
                                            <i class="fas fa-check"></i>
                                        </div>
                                       
                                    </div>
                                </div>

                            </div>

                        </div>
                    </div>


                    <div id="EmpListDiv">
                        @await Html.PartialAsync("~/Areas/DataBank/Views/InstantMessaging/_EmployeeList.cshtml", Model)
                    </div>

                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.filter)
                    </div>
                    <div class="row row card-footer-bottom-fixed">
                        <div class="col-md-12">
                            <a id="addNewMessage" type="button"
                               class="btn btn-default float-right mobile-full-width slider-btn" onclick="OnEmployeesSaveClick()">
                                Save
                            </a>
                        </div>
                    </div>
                    <!--end: Datatable-->
                </div>
            </div>

            <div id="newRequestSlider">
            </div>
            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
