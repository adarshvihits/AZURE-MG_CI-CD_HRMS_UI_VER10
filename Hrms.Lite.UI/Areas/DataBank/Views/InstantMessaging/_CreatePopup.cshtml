@model Hrms.Lite.Shared.DataBank.InstantMessaging

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "Message-popup" }))
{
    @Html.HiddenFor(m => m.Mode)
    <div class="row" style="padding:5px 16px;">
        <div class="col-md-12">
            <div class="form-group">

                <div class="form-group">
                    <label class="view-title" id="title">Title</label>
                    @Html.TextBoxFor(m => m.Title, new { @class = "form-control form-control-sm", @maxlength = 50, @placeholder = "Title" })
                    @Html.HiddenFor(m => m.MessageCode)

                    <span id="title"></span>
                </div>

            </div>
        </div>

        <div class="col-md-12">
            <div class="form-group">
                <label class="view-title" id="title">Message</label>
                @Html.TextAreaFor(m => m.Message, new { @class = "form-control form-control-sm", @placeholder = "Message" })
                <span id="Message"></span>
            </div>
        </div>
        <div class="col-md-12">
            @if (Model.Mode == "CREATE")
            {
                <button type="button" style="float: right; margin: 6px 0px 0px 7px;" class="btn btn-default  mobile-full-width" onclick="OnSaveClick('Save')">
                    Save
                </button>
            }
            else
            {
                <button type="button" style="float: right; margin: 6px 0px 0px 7px;" class="btn btn-default  mobile-full-width" onclick="OnSaveClick('Modify')">
                    Update
                </button>
            }
        </div>

    </div>
}