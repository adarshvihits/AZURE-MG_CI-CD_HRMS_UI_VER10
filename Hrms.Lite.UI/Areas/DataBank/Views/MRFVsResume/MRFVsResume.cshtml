@model Hrms.Lite.Shared.DataBank.DTO.MRFVsResume
@{
    ViewData["Title"] = "MRFVsResume";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/DataBank/MRFVsResume.js"></script>
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                  Resume Mapping

                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        <a href="@Url.Action("Index", "MRFVsResume", new { Area = "DataBank" })">Resume Mapping</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Resumes Available For Mapping
                    </li>
                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->


<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body">

                            <div class="row tab-style-button">
                                <div class="tab-button-wrap">
                                    <div class="tab-button-wrap align-items-center">
                                        <div class="tab-items pr-10">
                                            <div class="row-outer">

                                                @*<div class="view-details">

                            </div>*@

                                                <label class="view-title">
                                                    Job Title
                                                </label>
                                                <div class="view-details">
                                                    @Model.JobTitle
                                                </div>
                                            </div>
                                        </div>

                                        <div class="tab-items pr-10">
                                            <div class="row-outer">
                                                <label class="view-title">
                                                    MRF No
                                                </label>
                                                <div class="view-details">
                                                    @Model.JobCode
                                                </div>
                                            </div>
                                        </div>
                                        @*<div class="tab-items pr-10">
                    <div class="row-outer">
                        <label class="view-title">
                            Req Date
                        </label>
                        <div class="view-details">
                            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.RequestedDate))
                        </div>

                        </div>
                    </div>*@

                                        <div class="tab-items pr-10">
                                            <div class="row-outer">
                                                <label class="view-title">
                                                    Location
                                                </label>
                                                <div class="view-details">
                                                    @Model.Location
                                                </div>
                                            </div>
                                        </div>
                                        <div class="tab-items pr-10">
                                            <div class="row-outer">
                                                <label class="view-title">
                                                    Deadline
                                                </label>
                                                <div class="view-details">
                                                    @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.NeedByDate))
                                                </div>
                                            </div>
                                        </div>
                                        @*<div class="tab-items pr-10">
                    <div class="row-outer">
                        <label class="view-title">
                            Days Left
                        </label>
                        <div class="view-details">
                            @Model.DaysLeft
                        </div>
                        </div>
                    </div>*@
                                        <div class="tab-items pr-10">
                                            <div class="row-outer">
                                                <label class="view-title">
                                                    No.Req
                                                </label>
                                                <div class="view-details">
                                                    @Model.NoOfRequirements
                                                </div>
                                            </div>
                                        </div>
                                        <div class="tab-items pr-10">
                                            <div class="row-outer">

                                                <label class="view-title">
                                                    Resumes
                                                </label>
                                                <div class="view-details">
                                                    @Model.MappedResumes
                                                </div>



                                            </div>
                                        </div>
                                        <div class="tab-items pl-20">
                                            <div>
                                                <label></label>
                                                <div class="radio-inline">
                                                    <label class="radio radio-outline radio-success mr-5">
                                                        <input data-val="true" data-val-required="The ListCount field is required." id="ListCount" name="ListCount" type="hidden" value="0">
                                                        <input checked="checked" data-val="true" data-val-required="The BasedOn field is required." id="BasedOn" name="BasedOn" onchange="fillData()" type="radio" value="2">
                                                        <span></span>Matching Resumes
                                                    </label>
                                                    <label class="radio radio-outline radio-success">
                                                        @*<input id="BasedOn" name="BasedOn" type="radio" value="1" onchange="onTypeChange(1)">*@
                                                        <input id="BasedOn" name="BasedOn" type="radio" value="1" onchange="fillData()">
                                                        <span></span>All
                                                    </label>
                                                    <label class="radio radio-outline radio-success">
                                                        @*<input id="BasedOn" name="BasedOn" type="radio" value="1" onchange="onTypeChange(2)">*@
                                                        <input id="BasedOn" name="BasedOn" type="radio" value="3" onchange="fillData()">
                                                        <span></span>Rejected Resumes
                                                    </label>

                                                </div>
                                            </div>
                                            <!-- <label></label> -->

                                        </div>



                                        <div class="tab-items select-option">

                                            <div class="sraech-slider">
                                                <div class="search-slider-inner">
                                                    <i class="fa fa-search"></i>
                                                </div>
                                                <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                                       placeholder="ID/Name">
                                            </div>
                                            <div id="filterForm" class="filter-button slider-btn" data-bs-toggle="tooltip" title="Filter">
                                                <i class="fas fa-filter"></i>
                                                <i class="fas fa-check"></i>
                                            </div>
                                            @*<div data-bs-toggle="tooltip" data-bs-original-title="Filter"
                             class="filter-button">
                            <i class="fas fa-filter"></i>
                        </div>*@

                                        </div>


                                    </div>
                                </div>
                            </div>




                            @using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "Resume_Mapping_form" }))
                            {
                                @Html.HiddenFor(m => m.VacancyManagementGI)
                                <div id="testOT" class="hide">
                                    <table id="ResumeData_ListTwo">
                                        <thead>
                                            <tr class="table-dark">
                                                <th cope="col" data-bs-toggle="tooltip" title=""
                                                    data-bs-original-title="Applicant ID">Applicant ID</th>
                                                <th scope="col">
                                                    Candidate Name

                                                </th>

                                                <th scope="col">
                                                    Applied Designation
                                                </th>

                                                <th scope="col">
                                                    Applied Location
                                                </th>
                                                <th scope="col">
                                                    Age
                                                </th>
                                                <th scope="col" data-bs-toggle="tooltip"
                                                    title="Years Of experience">
                                                    Y / E
                                                </th>
                                                <th scope="col" data-bs-toggle="tooltip">

                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>

                            }


                            <div id="MRFVsResumeList">

                                @await Html.PartialAsync("_MRFVsResumeList")
                            </div>
                            @*@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "mapRes" }))*@
                            <!--{
    <div id="MRFVsResumeList">-->
                            @*@await Html.PartialAsync("_MRFVsResumeList")*@
                            <!--</div>-->
                            <!-- <end table></end> -->
                            <!--}-->
                        </div>
                        <div id="filterSlider">
                            @await Html.PartialAsync("_Filter", Model.Filter)
                        </div>
                        <div class="row card-footer-bottom-fixed">

                            <div class="col-md-12 align-right">
                                <a type="button" class="btn btn-default  mobile-full-width" onclick="MapResumes()">
                                    Map Resumes
                                </a>
                            </div>

                        </div>
                    </div>

                </div>
            </div>




            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>
<!--end::Content-->
