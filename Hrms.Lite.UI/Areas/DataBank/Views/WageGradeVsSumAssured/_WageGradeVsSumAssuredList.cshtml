@model Hrms.Lite.Shared.DataBank.WageGradeVsSumAssured
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;

<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table WageGrade-VsSum-Assured-list pt-1">
    @Html.HiddenFor(m => m.WageGradeVsSumAssuredList.Count)
    <table id="WageGradeVsSumAssuredtable" class="common-table">
        <thead>
            <tr class="table-dark">

                <th scope="col">Wage Grade</th>
                <th scope="col">Mediclaim</th>
                <th scope="col">Personal Accident</th>
                <th scope="col">GTLI </th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>


            @{
                if (Model.WageGradeVsSumAssuredList != null && Model.WageGradeVsSumAssuredList.Count > 0)
                {
                    for (int i = 0; i < Model.WageGradeVsSumAssuredList.Count; i++)

                    {


                        <tr>

                            @Html.HiddenFor(model => Model.WageGradeVsSumAssuredList[i].WageGradeCode)

                            <td data-label="WageGrade">@Model.WageGradeVsSumAssuredList[i].WageGrade</td>
                           
                            <td data-label="MediClaim">


                                <div class="form-group">

                                    <span id="amtLabel1_@i">@Model.WageGradeVsSumAssuredList[i].MediClaim</span>
                                    <span id="amtTxtbox1_@i" class="hide">
                                        @Html.TextBoxFor(Model => Model.WageGradeVsSumAssuredList[i].MediClaim, new { @class = "form-control form-control-sm DeptShtName", @placeholder = "Amount", @onblur = "validate(this,'MediClaim')", maxlength = "10", oninput = "this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\\..*)\\./g, '$1');" })

                                        <span id="MediClaim"></span>
                                    </span>

                                </div>



                            </td>
                            <td data-label="PersonalAccident">


                                <div class="form-group">

                                    <span id="amtLabel2_@i">@Model.WageGradeVsSumAssuredList[i].PersonalAccident</span>
                                    <span id="amtTxtbox2_@i" class="hide">
                                        @Html.TextBoxFor(Model => Model.WageGradeVsSumAssuredList[i].PersonalAccident, new { @class = "form-control form-control-sm DeptShtName", @placeholder = "Amount", @onblur = "validate(this,'PersonalAccident')", maxlength = "10", oninput = "this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\\..*)\\./g, '$1');" })

                                        <span id="PersonalAccident"></span>
                                    </span>

                                </div>



                            </td>
                            <td data-label="GTLI">


                                <div class="form-group">

                                    <span id="amtLabel3_@i">@Model.WageGradeVsSumAssuredList[i].GTLI</span>
                                    <span id="amtTxtbox3_@i" class="hide">
                                        @Html.TextBoxFor(Model => Model.WageGradeVsSumAssuredList[i].GTLI, new { @class = "form-control form-control-sm DeptShtName", @placeholder = "Amount", @onblur = "validate(this,'WageGradeVsSumAssured')", maxlength = "10" , oninput = "this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\\..*)\\./g, '$1');" })

                                        <span id="GTLI"></span>
                                    </span>

                                </div>



                            </td>
                            <td data-label="Edit">
                                <span id="editbt2_@i">
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="ceedit"
                                       class="btn btn-icon btn-edit icon-only" onclick="onEditClick(@i)">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>
                                </span>


                                <span id="updateCancel2_@i" class="hide">
                                    <a data-bs-toggle="tooltip" title="Update"
                                       id="cupdate"
                                       class="btn btn-icon btn-edit icon-only" onclick="onUpdateClick(@i,@Model.WageGradeVsSumAssuredList[i].WageGradeCode)">
                                        <i class="icon-xl fas fa-sync-alt"></i>
                                    </a>
                                    <a data-bs-toggle="tooltip" title="Cancel"
                                       id="ccancel"
                                       class="btn btn-icon btn-cancel icon-only" onclick="onCancelClick(@i)">
                                        <i class="icon-xl fas fa-times"></i>
                                    </a>
                                </span>

                            </td>
                        </tr>
                    }
                }
            }


        </tbody>
    </table>
</div>
