@model Hrms.Lite.Shared.DataBank.DTO.PositionManagement

<script src="~/js/jquery.min.js"></script>
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Position-new-tble-list pt-5 vertical-scroll-400">
   
        <table class="common-table">
            <thead>
                <tr class="table-dark">
                    <th scope="col">Position</th>
                    <th scope="col">Short Name</th>
                    <th scope="col">Description</th>

                </tr>
            </thead>
            <tbody>

                @if (Model != null && Model.PositionDetailedList != null && Model.PositionDetailedList.Count > 0)
                {
                    for (int i = 0; i < Model.PositionDetailedList.Count; i++)
                    {
                <tr>
                    @Html.HiddenFor(Model => Model.PositionDetailedList[i].Code)
                    @Html.HiddenFor(Model => Model.PositionDetailedList[i].Name)
                    <td data-label="Position">@Model.PositionDetailedList[i].Name</td>
                    <td data-label="Short Name">
                        @Html.TextBoxFor(Model => Model.PositionDetailedList[i].ShortName, new { @class = "form-control form-control-sm" })
                    </td>
                    <td data-label="Description">
                        @Html.TextBoxFor(Model => Model.PositionDetailedList[i].Description, new { @class = "form-control form-control-sm" })
                    </td>

                </tr>
                    }
                }
            </tbody>
        </table>
    </div>
