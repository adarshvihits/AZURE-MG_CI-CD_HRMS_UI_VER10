@model Hrms.Lite.Shared.DataBank.DTO.PositionManagement
    <script src="~/scripts/DataBank/PositionManagement.js"></script>


@{
    ViewData["Title"] = "AddNew";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "Positionsave" }))
{
    <div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
        <!--begin::Header-->
        <div id="kt_header" class="header header-fixed">
            <!--begin::Container-->
            <div class="container-fluid d-flex align-items-stretch justify-content-between">
                <!--begin::Header Menu Wrapper-->
                <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                    <!--begin::Header Menu-->
                    <div class="d-flex align-items-baseline flex-wrap mr-5">
                        <h3 class="main-title">
                            Position
                        </h3>
                        <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                            <li class="breadcrumb-item ">
                                <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                            </li>
                            <li class="breadcrumb-item text-muted">
                                <a href="@Url.Action("Index", "PositionManagement", new { Area = "DataBank" })" class="">
                                    @*<i class="icon-nm fas fa-home mt-1"></i>*@
                                    Position Management
                                </a>
                            </li>
                        <li class="breadcrumb-item text-muted">
                            Position

                        </li>

                        </ul>
                    </div>
                </div>
              
            </div>
            <!--end::Container-->
        </div>
        <!--end::Header-->
        <!--begin::Content-->


        <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
            <!--begin::Entry-->
            <div class="d-flex flex-column-fluid">
                <!--begin::Container-->
                <div class="container full-width">
                    <!--begin::Dashboard-->
                    <!--begin::Row-->

                    <div class="row height-100per">

                        
                        <div class="col-md-12">
                            <div class="card card-custom height-100per">

                                <div class="card-body  ">
                                    <div class="page_white">

                                        <div class="row tab-style-button">

                                        </div>

                                        <div class="row">
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Location</label>
                                                    <span class="Mandatory">*</span>
                                                    @Html.DropDownListFor(m => m.Location.Code, (SelectList)ViewBag.Location, "--Select--", new { @class = "form-control form-control-sm" })
                                                    <span id="Location"></span>
                                                </div>
                                            </div>

                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label>Department</label>
                                                    <span class="Mandatory">*</span>
                                                    @Html.DropDownListFor(m => m.Department.Code, (SelectList)ViewBag.Department, "--Select--", new { @class = "form-control form-control-sm" })
                                                    <span id="Department"></span>
                                                </div>
                                            </div>


                                        </div>
                                        <div class="row my-2">
                                            <div class="col-md-3">
                                                <label>Fun.Designation</label>
                                                <span class="Mandatory">*</span>
                                                <div class="input-group date">
                                                    @Html.DropDownListFor(m => m.Designation.Code, (SelectList)ViewBag.Designation, "--Select--", new { @class = "form-control form-control-sm" })
                                                    <span id="Designation"></span>
                                                  
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <label>No.Of Position</label>
                                                <span class="Mandatory">*</span>
                                                <div class="input-group date">
                                                     @Html.TextBoxFor(m => m.NoofPosition, new { @class = "form-control form-control-sm", @maxlength = 3, @placeholder = "No. of Position", @onkeypress = "return onlyNumberKey(event)" })

                                                    <span id="Position"></span>
                                                </div>
                                            </div>
                                            <div class="col-md-3 d-flex align-items-end">
                                                <div>
                                                    <button type="button" id="addPosition" class="btn btn-default  mobile-full-width " onclick="CheckIfAlreadyExist()">
                                                        Proceed

                                                    </button>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                    <div id="AddPositionList">
            
                                    </div>
                                    <!-- <end table></end> -->

                                    <div class="row card-footer-bottom-fixed border-none">

                                        <div class="col-md-12 align-right">
                                       
                                                <button class="btn btn-default mobile-full-width" type="button" onclick="OnSaveClick('Save')">
                                                    Save
                                                </button>
                                      
                                       </div>

                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>




                    <!--end::Row-->
                    <!--begin::Row-->
                    <!--end::Row-->
                    <!--end::Dashboard-->
                </div>
                <!--end::Container-->
            </div>
            <!--end::Entry-->
        </div>
    </div>
}
