@model Hrms.Lite.Shared.DataBank.DTO.PositionManagement
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>
<link href="~/css/New-Payroll-dashboard.css" rel="stylesheet" />
<link href="~/css/kendo/2023.1.117/kendo.bootstrap-main.min.css" rel="stylesheet" />
<script src="~/js/kendo/kendo.all.min.js"></script>
<script src="~/js/kendo/kendo.aspnetmvc.min.js"></script>
<script src="~/scripts/DataBank/PositionManagement.js"></script>


<style>

    .new-tile-count a:not([href]):not([class]) {
        color: white;
    }

    .tile-value-count h1 {
        padding-top: 10px;
    }

    .tile-value-count {
        padding-left: 14px;
    }

        .tile-value-count h4 {
            padding-top: 15px;
        }

    .new-tile-box {
        padding: 20px 5px;
    }

    .new-tile-box-2 {
        padding: 20px 5px;
    }

    .new-tile-box-3 {
        padding: 20px 5px;
    }
</style>




<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Position Management
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home" , new { Area="" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Position Management

                    </li>

                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>




<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->


            <div class="row height-100per">

                @Html.HiddenFor(m => m.type)



                <div class="col-md-12">

                    <div class="card card-custom height-100per">
                        <div class="card-body h-100 ">




                            <div class=" common_space row">

                                <div class="col-md-12">

                                    <div class="row">


                                        <div class="col-md-3 ">
                                            <a class="step-item" onclick="onLabelClick('Total Position')">
                                                <div class="new-tile-box">
                                                    <div style="display:flex; align-items:center; padding-bottom:10px;">
                                                        <div class="new-tile-iconz">
                                                            <div class="icon-with-set">
                                                                <img class="icon-withz" src="~/images/icons/f & f pending.svg" />
                                                            </div>

                                                        </div>
                                                        <div>


                                                            <h1 class="new-tile-headz">Total Position </h1>
                                                            <div class="tile-value-count">
                                                                <h1 class="new-tile-count">@Model.TotalPosition</h1>
                                                            </div>
                                                        </div>
                                                    </div>


                                                    <div class="wave-box">

                                                    </div>

                                                </div>
                                            </a>
                                        </div>




                                        <div class="col-md-3 ">
                                            <a class="step-item" onclick="onLabelClick('Active Position')">
                                                <div class="new-tile-box-2">
                                                    <div style="display:flex; align-items:center; padding-bottom:10px;">
                                                        <div class="new-tile-iconz">
                                                            <div class="icon-with-set">
                                                                <img class="icon-withz" src="~/images/icons/Increment.svg" />
                                                            </div>
                                                        </div>
                                                        <div>
                                                            <h1 class="new-tile-headz">Active Position</h1>
                                                            <div class="tile-value-count">
                                                                <h1 class="new-tile-count">@Model.ActivePosition</h1>
                                                            </div>
                                                        </div>
                                                    </div>



                                                </div>
                                            </a>
                                        </div>






                                        <div class="col-md-2 ">
                                            <a class="step-item" onclick="onLabelClick('Vacant Position')">
                                                <div class="new-tile-box-3">
                                                    <div style="display:flex; align-items:center; padding-bottom:10px;">
                                                        <div class="new-tile-iconz">
                                                            <img class="icon-withz" src="~/images/icons/loannn.svg" />
                                                        </div>
                                                        <div>
                                                            <h1 class="new-tile-headz">Vacant Position</h1>
                                                            <div class="tile-value-count">
                                                                <h1 class="new-tile-count">@Model.VacantPosition</h1>
                                                            </div>
                                                        </div>

                                                    </div>



                                                </div>
                                            </a>
                                        </div>

                                        <div class="col-md-2 ">
                                            <a class="step-item" onclick="onLabelClick('Temporary Position')">
                                                <div class="new-tile-box-3      tile-color-10">
                                                    <div style="display:flex; align-items:center; padding-bottom:10px;">
                                                        <div class="new-tile-iconz">
                                                            <img class="icon-withz" src="~/images/icons/whf icon.svg" />
                                                        </div>
                                                        <div>
                                                            <h1 class="new-tile-headz">Temporary Position</h1>
                                                            <div class="tile-value-count">
                                                                <h1 class="new-tile-count">@Model.TemporaryPosition</h1>
                                                            </div>
                                                        </div>


                                                    </div>


                                                </div>
                                            </a>
                                        </div>

                                        <div class="col-md-2 ">
                                            <a class="step-item" href="@Url.Action("AddNew","PositionManagement",new { Area = "DataBank"})">
                                                <div class="new-tile-box-3      tile-color-10">
                                                    <div style="display:flex; align-items:center; padding-bottom:10px;">
                                                        <div class="new-tile-iconz">
                                                            <img class="icon-withz" src="~/images/icons/whf icon.svg" />
                                                        </div>
                                                        <div>
                                                            <h1 class="new-tile-headz">Add New</h1>
                                                            <div class="tile-value-count">
                                                                <h1 class="new-tile-count"></h1>
                                                            </div>
                                                        </div>


                                                    </div>


                                                </div>
                                            </a>
                                        </div>
                                    </div>

                                </div>


                            </div>


                            <div class="row second-full-tile-pad" style="padding-left:6px;">


                                <div class="col-md-12 col-lg-12">
                               

                                    <div class="row tab-style-button">
                                        <div class="tab-button-wrap">
                                            <h1 class="Attedance-tble-headingz pl-0 pt-3"> Position Details</h1>
                                            <div class="tab-items select-option">
                                                <div class="sraech-slider">
                                                    <div class="search-slider-inner">
                                                        <i class="fa fa-search"></i>
                                                    </div>
                                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm" placeholder="ID/Name">
                                                </div>
                                                <div id="filterForm" class="filter-button slider-btn" data-bs-toggle="tooltip" title="Filter">
                                                    <i class="fas fa-filter"></i>
                                                    <i class="fas fa-check"></i>
                                                </div>
                                                <button data-bs-toggle="tooltip" title="" class="btn btn-excel float-left" data-bs-original-title="Export to Excel" onclick="onExportToExcelClick()">
                                                    <i class="icon-xl far fa-file-excel"></i>
                                                </button>


                                            </div>



                                        </div>

                                    </div>





                                    @*<div class="tab-items float-right select-option">

            <div class="sraech-slider">
                <div class="search-slider-inner">
                    <i class="fa fa-search"></i>
                </div>
                <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                       placeholder="ID/Name">
            </div>
            <div data-bs-toggle="tooltip" title="Filter" onclick="OnFilterClick()">
                <i class="fas fa-filter"></i>
                <i class="fas fa-check"></i>
            </div>
            <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left" data-bs-original-title="Export to Excel" onclick="ExportToExcel()">
                <i class="icon-xl far fa-file-excel"></i>
            </a>

        </div>*@

                                    <div id="positionDetailList">
                                        @await Html.PartialAsync("_PositionDetails", Model)
                                    </div>


                                </div>

                            </div>
                            <div id="DeleteSlider">
                            </div>
                        </div>
                    </div>
                </div>



            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->
    </div>
    <!--end::Content-->
    <div class="modal fade bd-example-modal-lg" id="Task_Popup" tabindex="-1" aria-labelledby="myLargeModalLabel" aria-hidden="true" style="position:fixed;">
        <div class="modal-dialog modal-lg" style="max-width:720px">
            <div class="modal-content popup">
                <div class="modal-header">
                    <div>
                        Filter By
                    </div>
                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                        <i aria-hidden="true" class="ki ki-close"></i>
                    </button>
                </div>

                <div class="modal-body pt-0">
                        @await Html.PartialAsync("_FilterPopup", Model)

                </div>


            </div>
        </div>
    </div>