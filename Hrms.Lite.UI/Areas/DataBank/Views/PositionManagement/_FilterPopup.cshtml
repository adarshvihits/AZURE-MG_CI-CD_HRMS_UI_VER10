@model Hrms.Lite.Shared.DataBank.DTO.PositionManagement
@*@model Hrms.Lite.Shared.General.Filter*@
@*<script src="~/scripts/filter.js"></script>*@
<script src="~/scripts/DataBank/PositionManagement.js"></script>


@using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "popupFilter" }))
{
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label>Location</label>
                @Html.HiddenFor(m => m.Filter.Basic_Filter.Location.Name)
                @Html.DropDownListFor(m => m.Filter.Basic_Filter.Location.Code, (SelectList)Model.Filter.Basic_Filter.Location.DropdownData, "All", new { @class = "form-control form-control-sm reset", onchange = "onLocationChange()" })
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label>Department</label>
                @Html.HiddenFor(m => m.Filter.Basic_Filter.Department.Name)
                @Html.DropDownListFor(m => m.Filter.Basic_Filter.Department.Code, (SelectList)Model.Filter.Basic_Filter.Department.DropdownData, "All", new { @class = "form-control form-control-sm reset", onchange = "onDepartmentChange()" })
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label>Functional Designation</label>
                @Html.HiddenFor(m => m.Filter.Tabindex)
                @Html.HiddenFor(m => m.Filter.SearchId)
                @Html.HiddenFor(m => m.Filter.Basic_Filter.Designation.Name)
                @Html.DropDownListFor(m => m.Filter.Basic_Filter.Designation.Code, (SelectList)Model.Filter.Basic_Filter.Designation.DropdownData, "All", new { @class = "form-control form-control-sm reset", onchange = "onDesignationChange()" })
            </div>
        </div>
    </div>
    @Html.HiddenFor(m => m.Filter.Basic_Filter.Category.Name)
    @Html.HiddenFor(m => m.Filter.Basic_Filter.Grade.Name)
    @Html.HiddenFor(m => m.Filter.Basic_Filter.PayrollGroup.Name)
    @Html.HiddenFor(m => m.Filter.Basic_Filter.Region.Name)
    @Html.HiddenFor(m => m.Filter.Basic_Filter.State.Name)
    <div class="col-md-12 align-right">
        <button type="button" class="btn btn-default" onclick="onResetFilter()">
            Reset
        </button>
        <button type="button" class="btn btn-default" onclick="onApplyFilter()">
            Filter
        </button>
    </div>


}