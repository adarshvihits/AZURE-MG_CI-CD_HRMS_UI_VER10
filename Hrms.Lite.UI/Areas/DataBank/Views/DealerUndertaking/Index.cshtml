@model Hrms.Lite.Shared.DataBank.DealerUndertaking
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/scripts/DataBank/DealerUndertaking.js"></script>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Dealer Undertaking</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "DashBoard", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted child-mute">
                        Dealer Undertaking
                    </li>
                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                    <!--begin: Search Form-->

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items">
                                <span class="btn-title active ApvTab1" onclick="OnTabClick('General','ApvTab1')">
                                    General
                                    <span class="btn-notification general_Count">@Model.GeneralCount</span>
                                </span>
                            </div>
                            <div class="tab-items medium">
                                <span class="btn-title ApvTab2" onclick="OnTabClick('Closed','ApvTab2')">
                                    Closed
                                    <span class="btn-notification closed_Count">@Model.ClosedCount</span>
                                </span>
                            </div>
                            <div class="tab-items medium">
                                <span class="btn-title ApvTab3" onclick="OnTabClick('Open','ApvTab3')">
                                    Open
                                    <span class="btn-notification open_Count">@Model.OpenCount</span>
                                </span>
                            </div>

                            <div class="tab-items select-option">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>

                                <button data-bs-toggle="tooltip" title="Export to Excel"
                                        class="btn btn-excel" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </button>
                            </div>

                        </div>
                    </div>


                    <div id="DealerUndertakingList">
                        @await Html.PartialAsync("_GeneralList")

                    </div>

                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>