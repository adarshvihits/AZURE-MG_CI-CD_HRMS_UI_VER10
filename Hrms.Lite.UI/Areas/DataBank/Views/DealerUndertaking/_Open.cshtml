@model Hrms.Lite.Shared.DataBank.DealerUndertaking
    <script src="~/js/bootstrap-datepicker.js"></script>
<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label class="view-title">Effective Date</label>

            <div class="view-details">
                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.EffectiveDate))
            </div>


        </div>
    </div>
    <div class="col-md-6 d-flex align-items-center">
       
        <div class="view-details">
            <label> </label>
            <label class="checkbox checkbox-outline checkbox-success    ">
                @Html.CheckBoxFor(m => m.DullyDealerUndertaking, new { @disabled = "disabled" })
                <span class="spanlabel mr-3"></span>Has he/she given a dully filled Dealer Undertaking
            </label>
        </div>
    </div>
</div>

<div class="row my-2">
    <div class="col-md-6">
        <div class="view-details">
            <label> </label>
            <label class="checkbox checkbox-outline checkbox-success    ">
                @Html.CheckBoxFor(m => m.DealingRights, new { @disabled = "disabled" })
                <span class="spanlabel mr-3"></span>Can he/she be given the Dealing rights thru HRMS :
            </label>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            <label class="view-title">Remarks</label>
            <div class="view-details">
                @Model.Remark
            </div>
            @*<span id="purpose"></span>*@
        </div>
    </div>
</div>

<div class="row my-2">
    <div class="col-md-6">
        <div class="form-group mb-0">
            <label>Closing Date</label><span class="Mandatory">*</span>
            <div class="input-group date">
                @Html.TextBoxFor(m => m.ClosingDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2",  @placeholder = "Closing Date" })

                <div class="input-group-append">
                    <span class="input-group-text">
                        <i class="la la-calendar"></i>
                    </span>
                </div>
            </div>
            <span id="closingDate"></span>
        </div>
    </div>
</div>
  
    <div class="row my-4">
        <div class="col-md-8">
            <div class="form-group">
                <label>Closing Remarks</label>
                @Html.TextAreaFor(Model => Model.ClosingRemark, new { @class = "form-control form-control-sm", maxlength = "250" })

                @*<span id="purpose"></span>*@
            </div>
        </div>
        <div class="col-md-2 align-right d-flex align-items-center">
            <button type="button" onclick="SaveDealerUndertaking('@Model.RequestCode', 'Close')"
                    class="btn btn-default mt-4 mobile-full-width ">
                Save
            </button>

        </div>


    </div>