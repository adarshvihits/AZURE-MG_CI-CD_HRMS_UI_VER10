@model Hrms.Lite.Shared.DataBank.DealerUndertaking
<div class="row">
    <div class="col-md-6">
        <div class="form-group mb-0">
            <label>Effective Date</label><span class="Mandatory">*</span>
            <div class="input-group date">
                @Html.TextBoxFor(m => m.EffectiveDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "Effective Date" })

                <div class="input-group-append">
                    <span class="input-group-text">
                        <i class="la la-calendar"></i>
                    </span>
                </div>
            </div>
            <span id="effectiveDate"></span>
        </div>
    </div>
    <div class="col-md-6 d-flex align-items-center">
        <div class="form-group">
            <label> </label>
            <label class="checkbox checkbox-outline checkbox-success      ">
                @Html.CheckBoxFor(m => m.DullyDealerUndertaking)
                <span class="spanlabel mr-2"></span>Has he/she given a dully filled Dealer Undertaking
            </label>
            @*<span id="purpose"></span>*@
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="form-group">
            <label> </label>
            <label class="checkbox checkbox-outline checkbox-success      ">
                @Html.CheckBoxFor(m => m.DealingRights)
                <span class="spanlabel mr-2"></span>Can he/she be given the Dealing rights thru HRMS :
            </label>
            @*<span id="purpose"></span>*@
        </div>
    </div>
</div>
<div class="row my-4">
    <div class="col-md-8">
        <div class="form-group">
            <label>Remarks</label>
            @Html.TextAreaFor(Model => Model.Remark, new { @class = "form-control form-control-sm", maxlength = "250" })

            @*<span id="purpose"></span>*@
        </div>
    </div>

    <div class="col-md-2 align-right d-flex align-items-center">
        <button type="button" onclick="SaveDealerUndertaking('@Model.RequestCode','Open')"
                class="btn btn-default mt-4 mobile-full-width ">
            Reopen
        </button>

    </div>


</div>