@model Hrms.Lite.Shared.DataBank.DTO.HRPlanningBudget
  
    <script src="~/js/settings.js"></script>
    <!-- Table Section -->

    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table budget-upload-list">
        <table id="BudgetUpload" class="common-table">
            <thead>
                <tr class="table-dark">
                    <th scope="col">Location </th>
                    <th scope="col"> Region</th>
                    <th scope="col">
                        Budgeted Number
                    </th>

                </tr>
            </thead>
            <tbody>
                @if (Model.Details != null && Model.Details.Count > 0)
                {

                    for (int i = 0; i < Model.Details.Count; i++)
                    {

                        <tr>
                            <td data-label="Location">@Model.Details[i].Location.Name</td>
                            <td data-label="Region">@Model.Details[i].Region.Name</td>
                            <td data-label="Budgeted Nos">@Model.Details[i].BudgetedNo</td>

                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <!-- Table Setion End -->