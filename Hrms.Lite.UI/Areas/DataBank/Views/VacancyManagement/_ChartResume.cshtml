    @(Html.Kendo().Chart<Hrms.Lite.Shared.DataBank.DTO.VacancyManagement>()
    .Name("resume")
    .ChartArea(area => area.Height(150).Width(350))
    .Title(" ")
    .Legend(legend => legend
        .Position(ChartLegendPosition.Bottom)
    )
    .Series(series =>
    {
        series.Column(Model.GraphResume.Select(SkillGraph => new
        {
            category = SkillGraph.JobCode,
            value = SkillGraph.MappedResumes,
        }).ToArray())
        .Name("No of Resume")
        .Color("#295F98");
    })
    .CategoryAxis(axis => axis
        .Categories(model => model.JobCode)
        .Labels(labels => labels.Padding(10, 15, 0, 0))
        .MajorGridLines(lines => lines.Visible(false))
        .Line(line => line.Visible(false))
    )
    .ValueAxis(axis => axis
        .Numeric()
        .Line(line => line.Visible(false))
        .Visible(true)
        .Max(100)
        .MajorUnit(25)
    )
     .Tooltip(tooltip => tooltip
        .Template("#= dataItem.category # - #= dataItem.value #")
        .Visible(true)
    )
)



</div>
