@model Hrms.Lite.Shared.DataBank.DTO.VacancyManagement
<script src="~/js/tooltip.js"></script>
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "FilledVacanySave" }))
{
    <div id="applicantshortlisted" class="slider-forms slider-forms-open activevacancy">
        <div class="slider-inner-style">
            <div class="slider-form-close">
                <i class="ki ki-close icon-xs text-muted" onclick="CloseSlider('activevacancy')"></i>
            </div>
            <h4 id="sliderHeading">
                Vacancy List Active
            </h4>
            <div class="row my-3">
                @Html.HiddenFor(m => m.VacancyManagementGI)
                <div class="col-md-6">
                    <div class="form-group">
                        <div class="row-ithems">
                            <label class="view-title">MRF Number</label>
                            <div class="view-details">@Model.Details.JobCode</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <div class="row-ithems">
                            <label class="view-title">Job Title</label>
                            <div class="view-details">@Model.Details.JobTitle</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row my-3">

                <div class="col-md-6">
                    <div class="form-group">
                        <div class="row-ithems">
                            <label class="view-title">Deadline</label>
                            <div class="view-details">
                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Details.NeedByDate))
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">

                    <div class="form-group">
                        <div class="row-ithems">
                            <label class="view-title">Initiated By</label>
                            <div class="view-details">@Model.Details.FullName</div>
                        </div>
                    </div>


                </div>
            </div>
            <div class="row my-3">

                <div class="col-md-6">

                    <div class="form-group">
                        <div class="row-ithems">
                            <label class="view-title">Designation</label>
                            <div class="view-details">@Model.Details.Designation.Name</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <div class="row-ithems">
                            <label class="view-title">Department</label>
                            <div class="view-details">@Model.Details.Department.Name</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row my-3">

                <div class="col-md-6">
                    <div class="form-group">
                        <div class="row-ithems">
                            <label class="view-title">Location</label>
                            <div class="view-details">@Model.Details.Location.Name</div>
                        </div>
                    </div>


                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <div class="row-ithems">
                            <label class="view-title">Gender</label>
                            <div class="view-details">@Model.Details.Gender.Name</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row my-3">

                <div class="col-md-6">
                    <div class="form-group">
                        <div class="row-ithems">
                            <label class="view-title">Y/E</label>
                            <div class="view-details">@Model.Experience</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <div class="row-ithems">
                            <label class="view-title">No of Requirements</label>
                            <div class="view-details">@Model.Details.NoOfRequirements</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row my-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <div class="row-ithems">
                            <label class="view-title">Salary Range</label>
                            <div class="view-details">@Model.Details.ExGrossPay</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <div class="row-ithems">
                            <label class="view-title">MRF Created Date</label>
                            <div class="view-details">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Details.CreatedOn))</div>
                        </div>
                        @*<div class="d-flex">
                        <div class="checkbox-inline justify-content-center">

                            <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                @Html.CheckBoxFor(m => m.FilledVacancy)
                                <span></span>
                            </label>
                        </div>
                        <span class="pl-2">Filled Vacancy</span>
                    </div>*@
                        @*<div class="checkbox-inline ">
                        <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">

                            <span class="">Filled Vacancy</span>
                            @Html.CheckBoxFor(m => m.FilledVacancy)
                        </label>
                    </div>*@
                    </div>
                </div>
            </div>
            <div class="row my-3">              
                <div class="col-md-6">
                    <div class="form-group">
                        <div class="row-ithems">
                            <label class="view-title">MRF Approved Date</label>
                            <div class="view-details">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Details.ApprovedOn))</div>
                        </div>
                       
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group closeOrCancelDiv">
                        <div class="row-ithems">
                            <label class="view-title closeOrCancel">MRF Cancelled Date</label>
                            <div class="view-details">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Details.ClosedOrCancelledDate))</div>
                        </div>
                       
                    </div>
                </div>
            </div>
            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    @*<a type="button" data-bs-toggle="tooltip" title="" data-bs-original-title="Delete" class="btn btn-icon btn-delete big-btn float-right" onclick="VacancyDelete()"><i class="icon-xl far fa-trash-alt"></i></a>*@



                    @*<a type="button"
                   class="btn btn-default  mobile-full-width" onclick="VacancyDelete()">
                    Delete
                </a>*@
                    @*<a type="button"
                   class="btn btn-default  mobile-full-width" onclick="FilledVacancySave()">
                    Save
                </a>*@
                </div>

            </div>
        </div>
    </div>
}