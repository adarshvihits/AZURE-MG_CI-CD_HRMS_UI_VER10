@model Hrms.Lite.Shared.DataBank.DTO.VacancyManagement
    <script src="~/js/settings.js"></script>
    <script src="~/js/tooltip.js"></script>
    <div class="ihits-table table-border odd-even mobile-responsive-table employee-notice-list new-tble-pad-tp">
        @Html.HiddenFor(m => m.EmployeeDtList.Count)
        <table id="EmployeesInNoticeTbl" class="common-table">
            <thead>
                <tr class="table-dark">
                    <th scope="col">ID</th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">Designation</th>
                    <th scope="col">Department</th>
                    <th scope="col">Location</th>
                    <th scope="col">Gender</th>
                    <th data-bs-toggle="tooltip" title="Last Working day" scope="col">LWD</th>
                    <th scope="col">Reason</th>
                    @*<th scope="col">Replacement</th>*@
                </tr>
            </thead>
            <tbody>

                @if (Model.EmployeeDtList != null && Model.EmployeeDtList.Count > 0)
                {


                    for (int i = 0; i < Model.EmployeeDtList.Count; i++)

                    {
                        @Html.HiddenFor(model => Model.EmployeeDtList[i].EmployeeCode)
                        <tr>


                            <td data-label="EmployeeID">@Model.EmployeeDtList[i].EmployeeID</td>
                            <td data-label="Name"> @Model.EmployeeDtList[i].FullName</td>
                            <td data-label="Designation">@Model.EmployeeDtList[i].Designation.Name</td>
                            <td data-label="Department">@Model.EmployeeDtList[i].Department.Name</td>
                            <td data-label="Location">@Model.EmployeeDtList[i].Location.Name</td>
                            <td data-label="Gender">@Model.EmployeeDtList[i].Gender.Name</td>
                            <td data-label="LWD"> @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.EmployeeDtList[i].LWD))</td>
                            <td data-label="Name"> @Model.EmployeeDtList[i].Reason</td>


                            @*@if (Model.EmployeeDtList[i].Replacement == "True")
                            {
                                <td data-label="Replacement">Yes</td>
                            }
                            else
                            {
                                <td data-label="Replacement">No</td>
                            }*@


                        </tr>
                    }
                }


            </tbody>
        </table>
    </div>