@model Hrms.Lite.Shared.DataBank.DTO.VacancyManagement
<link href="~/css/custom.css" rel="stylesheet" />
<script src="~/js/multiselect.js"></script>
<div class="row my-3">

    <div class="col-md-6">
        <div class="form-group">
            <label>Location</label>
            @Html.DropDownListFor(m => m.Details.Location.Code, (SelectList)ViewBag.Location, "--Select--", new { @class = "form-control form-control-sm", @onchange = "validate(this, 'location')" })
            <span id="location"></span>
        </div>


    </div>
    <div class="col-md-6">
        <div class="form-group">
            <label>Gender</label>
            @Html.ListBoxFor(m => m.Details.GenderArray, (SelectList)ViewBag.Gender, new { @class = "multiselectDropdownField1 form-control-multiselect form-control-sm ", @multiple = "multiple", data_placeholder = "All" })

            @*@Html.DropDownListFor(m => m.Details.Gender.Code, (SelectList)ViewBag.Gender, "--Select--", new { @class = "form-control form-control-sm", @onchange = "validate(this, 'gender')" })*@
            <span id="gender"></span>

        </div>
    </div>
</div>
<div class="row my-3">
    <div class="col-md-6">
        <div class="form-group">
            <label>Age Group</label>
            @Html.TextBoxFor(m => m.AgeGroup, new { @class = "form-control form-control-sm", @maxlength = 50, @placeholder = "Age Group", @onblur = "validate(this, 'age')" })
            <span id="age"></span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            <label>Y/E</label>
            @Html.TextBoxFor(m => m.Details.YOS, new { @class = "form-control form-control-sm", @maxlength = 50, @placeholder = "Year of Experience", @onblur = "validate(this, 'age')" })

            @*@Html.DropDownListFor(model => model.Experience,
                            new List<SelectListItem> {
                new SelectListItem {  Value= "0" , Text = "--Select--"},
                new SelectListItem {  Value= "1" , Text = "0" },
                new SelectListItem { Value = "2" , Text = "1-2" },
                 new SelectListItem { Value = "3" , Text = "2-3" },
                  new SelectListItem { Value = "4" , Text = "3-4" },
                   new SelectListItem { Value = "5" , Text = "5+" }
                                      },
                          new { @class = "form-control form-control-sm", @onchange = "validate(this, 'experience')" })*@
        </div>
        <span id="experience"></span>
    </div>

</div>
<div class="row my-3">
    <div class="col-md-6">
        <div class="form-group">
            <label>No of Requirements</label>
            @Html.TextBoxFor(m => m.Details.NoOfRequirements, new { @class = "form-control form-control-sm", @placeholder = "No of Requirements", @onblur = "validate(this, 'nofreq')" })
            <span id="nofreq"></span>

        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            <label>Salary Range</label>
            @Html.TextBoxFor(m => m.Details.ExGrossPay, new { @class = "form-control form-control-sm", @placeholder = "Salary Range", @onblur = "validate(this, 'exgrosspay')" })
            <span id="exgrosspay"></span>
        </div>
    </div>

</div>