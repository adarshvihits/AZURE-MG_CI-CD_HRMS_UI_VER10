@model Hrms.Lite.Shared.DataBank.DTO.VacancyManagement
@using Kendo.Mvc.UI


<div id="chartStatus" @*style="height: 100px; width: 200px;"*@>





    @(Html.Kendo().Chart<Hrms.Lite.Shared.DataBank.DTO.VacancyManagement>()
    .Name("status")
    .ChartArea(area => area.Height(200).Width(800))
     .Title(title => title
      .Text("Vacancy VS Requirement")
        .Font("bold 16px Arial, Helvetica, sans-serif")
         .Align(ChartTextAlignment.Center)
        //.Margin(m => m.Left(30))
        .Visible(true)
    )
    .Legend(legend => legend
        .Position(ChartLegendPosition.Bottom)
    )
    .Series(series =>
    {
        series.Column(Model.GraphRequrements.Select(SkillGraph => new
        {
            category = SkillGraph.JobCode,
            value = SkillGraph.NoOfRequirements,
        }).ToArray())
        .Name("No of Requirements")
        .Color("#C96868");
    })
    .CategoryAxis(axis => axis
        .Categories(model => model.JobCode)
        .Labels(labels => labels.Padding(10, 15, 0, 0))
        .MajorGridLines(lines => lines.Visible(false))
        .Line(line => line.Visible(false))
    )
    .ValueAxis(axis => axis
        .Numeric()
        .Line(line => line.Visible(false))
        .Visible(true)
        .Max(100)
        .MajorUnit(25)
    )
     .Tooltip(tooltip => tooltip
        .Template("#= dataItem.category # - #= dataItem.value #")
        .Visible(true)
    )
)
    </div>
    <div class="mt-5">
    @(Html.Kendo().Chart<Hrms.Lite.Shared.DataBank.DTO.VacancyManagement>
    ()
    .Name("resume")
    .ChartArea(area => area.Height(200).Width(800))
    .Title(title => title
    .Text("Vacancy VS Resume")
    .Font("bold 16px Arial, Helvetica, sans-serif")
    .Align(ChartTextAlignment.Center)
    //.Margin(m => m.Left(30))
    .Visible(true)
        )
    .Legend(legend => legend
    .Position(ChartLegendPosition.Bottom)
    )
    .Series(series =>
    {
    series.Column(Model.GraphResume.Select(SkillGraph => new
    {
    category = SkillGraph.JobCode,
    value = SkillGraph.MappedResumes,
    }).ToArray())
    .Name("No of Resume")
    .Color("#295F98");
    })
    .CategoryAxis(axis => axis
    .Categories(model => model.JobCode)
    .Labels(labels => labels.Padding(10, 15, 0, 0))
    .MajorGridLines(lines => lines.Visible(false))
    .Line(line => line.Visible(false))
    )
    .ValueAxis(axis => axis
    .Numeric()
    .Line(line => line.Visible(false))
    .Visible(true)
    .Max(100)
    .MajorUnit(25)
    )
    .Tooltip(tooltip => tooltip
    .Template("#= dataItem.category # - #= dataItem.value #")
    .Visible(true)
    )
    )

</div>

