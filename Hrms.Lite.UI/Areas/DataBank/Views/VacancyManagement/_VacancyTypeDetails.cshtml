<div  class="ihits-table table-border hover-color odd-even mobile-responsive-table vacancy-type-popup vertical-scroll-250">

    <table id="PopUpTable">
        <thead>
            <tr class="table-light">
                <th scope="col"> ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Location</th>
                <th scope="col">Designation</th>
                <th scope="col" data-bs-toggle="tooltip"
                    data-bs-original-title="Last Working Day">LWD</th>
                <th scope="col" data-bs-toggle="tooltip"
                    data-bs-original-title="Year of Experience">Y/S</th>
                <th scope="col">Age</th>
                <th scope="col">Gender</th>
                <th scope="col">GrossPay</th>
            </tr>
        </thead>
        <tbody>
           
            <tr>
                <td data-label="Location">
                    @Model.EmployeeID
                </td>
                <td data-label="Location">
                    @Model.FullName
                </td>
                <td data-label="Location">
                    @Model.Location.Name
                </td>
                <td data-label="Designation">
                    @Model.Designation.Name

                </td>
                <td data-label="LWD">
                    @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.LWD))



                </td>
                <td data-label="Y/S">
                    @Model.YOS
                </td>
                <td data-label="Age">@Model.Age</td>
                <td data-label="Gender">@Model.Gender.Name</td>
                <td data-label="GrossPay">@Model.GrossPay</td>



            </tr>


        </tbody>


    </table>
</div>