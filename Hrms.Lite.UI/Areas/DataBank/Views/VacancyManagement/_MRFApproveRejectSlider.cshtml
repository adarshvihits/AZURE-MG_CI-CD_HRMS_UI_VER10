@model Hrms.Lite.Shared.DataBank.DTO.VacancyManagement
    <script src="~/js/tooltip.js"></script>
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "VacancyApproveReject" }))
{
@Html.HiddenFor(m => m.VacancyManagementGI)
@Html.HiddenFor(m => m.Approvestatus)
                <div id="applicantshortlisted" class="slider-forms slider-forms-open MRFAccept">
                    <div class="slider-inner-style">
                        <div class="slider-form-close">
                            <i class="ki ki-close icon-xs text-muted" onclick="CloseSlider('MRFAccept')"></i>
                        </div>
                        <h4>
                            Vacancy Register
                        </h4>
                        <div class="row my-3">

                            <div class="col-md-6">
                                <div class="form-group">
                                    <div class="row-ithems">
                                        <label class="view-title">MRF Number</label>
                                        <div class="view-details">@Model.Details.JobCode</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <div class="row-ithems">
                                        <label class="view-title">Job Title</label>
                                        <div class="view-details">@Model.Details.JobTitle</div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row my-3">

                            <div class="col-md-6">
                                <div class="form-group">
                                    <div class="row-ithems">
                                        <label class="view-title">Deadline</label>
                                        <div class="view-details"> @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Details.NeedByDate))</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">

                                <div class="form-group">
                                    <div class="row-ithems">
                                        <label class="view-title">Requested By</label>
                                        <div class="view-details">@Model.Details.FullName</div>
                                    </div>
                                </div>


                            </div>
                        </div>
                        <div class="row my-3">

                            <div class="col-md-6">

                                <div class="form-group">
                                    <div class="row-ithems">
                                        <label class="view-title">Designation</label>
                                        <div class="view-details">@Model.Details.Designation.Name</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <div class="row-ithems">
                                        <label class="view-title">Department</label>
                                        <div class="view-details">@Model.Details.Department.Name</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row my-3">

                            <div class="col-md-6">
                                <div class="form-group">
                                    <div class="row-ithems">
                                        <label class="view-title">Location</label>
                                        <div class="view-details">@Model.Details.Location.Name</div>
                                    </div>
                                </div>


                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <div class="row-ithems">
                                        <label class="view-title">Gender</label>
                                        <div class="view-details">@Model.Details.Gender.Name</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row my-3">

                            <div class="col-md-6">
                                <div class="form-group">
                                    <div class="row-ithems">
                                        <label class="view-title">Y/E</label>
                                        <div class="view-details">@Model.Experience</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <div class="row-ithems">
                                        <label class="view-title">No of Requirements</label>
                                        <div class="view-details">@Model.Details.NoOfRequirements</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row my-3">

                            <div class="form-group col-md-6">
                                <div class="row-ithems">
                                    <label class="view-title">Salary Range</label>
                                    <div class="view-details">@Model.Details.ExGrossPay</div>
                                </div>
                            </div>
                            <div class="form-group col-md-6">
                                <div class="row-ithems">
                                    <label class="view-title">Remarks</label>
                                    <div class="view-details">@Model.Details.Description</div>
                                </div>
                            </div>
                        </div>
                      
                        @*<div class="row my-3">

                            <div class="form-group col-md-12">
                                
                                    <label class="view-title">Comments</label>
                                    @Html.TextAreaFor(m => m.ApproverComments, new { @class = "form-control form-control-sm", @placeholder = "Approver Comments", @onchange = "validate(this, 'comments')" })
                                    <span id="comments"></span>
                               
                            </div>
                        </div>
                        <div class="row card-footer-bottom-fixed border-none">

                            <div class="col-md-12 align-right">
                                <a type="button" data-bs-toggle="tooltip" title="" data-bs-original-title="Delete"
                                   class="btn  btn-danger  mobile-full-width" onclick="VacancyApproveReject(2)">
                                    Reject
                                </a>
                                <a type="button"
                                   class="btn btn-default  mobile-full-width" onclick="VacancyApproveReject(1)">
                                    Approve
                                </a>
                            </div>

                        </div>*@
                    </div>
                </div>}