@model Hrms.Lite.Shared.DataBank.DTO.VacancyManagement
@using Kendo.Mvc.UI

<div id="chartSS" @*style="height: 100px; width: 200px;"*@>




    @(Html.Kendo().Chart<Hrms.Lite.Shared.DataBank.DTO.VacancyManagement>()
    .Name("chartSs")
    .Title(title => title
      .Text("Status")
        .Font("bold 16px Arial, Helvetica, sans-serif")
         .Align(ChartTextAlignment.Center)
        //.Margin(m => m.Left(30))
        .Visible(true)
    )
    .Legend(legend => legend
        .Visible(false)
    )
    .ChartArea(chart => chart
        .Background("transparent")
        .Height(400) // Adjusted height
        .Width(300)  // Adjusted width

    )
    .Series(series =>
    {
        series.Donut(new dynamic[] {
            new {category = "Active",value = Model.Tab1Count},
            new {category = "Acceptance Pending",value = Model.Tab2Count},
            new {category = "Vaccancy OverDue",value = Model.Tab3Count},
            new {category = "Resignation Acc. Pending ",value = Model.Tab4Count},
            //new {category = "Tennis",value = Model.Tab5Count}
        });
    })
    .SeriesColors(new string[] { "#624E88", "#8967B3", "#CB80AB", "#E6D9A2", "#606676", "#FF8343" })
    .Tooltip(tooltip => tooltip
        .Template("${ category } - ${ value }")
        .Visible(true)
    )
)


</div>
