@model Hrms.Lite.Shared.DataBank.DTO.VacancyManagement
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/DataBank/vacancymanagement.js"></script>
<link href="~/css/kendo/2023.1.117/kendo.bootstrap-main.min.css" rel="stylesheet" />
<script src="~/js/kendo/kendo.all.min.js"></script>
<script src="~/js/kendo/kendo.aspnetmvc.min.js"></script>

<script>

    $(document).ready(function () {
        debugger
        if ('@ViewBag.RedirctFrom' == 'FromRecruitmentDashBoard') {
            $(".tab3").addClass('active');
            $(".tab1").removeClass('active');
             prevTab = 'tab3';
            currentTab = 3;

        }

        });

</script>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Vacancy Register</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot p-0 mt-1 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Vacancy Register
                    </li>

                </ul>
            </div>
        </div>
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <!--<div class="row">

                        <div class="col-md-4">-->
                          @*@await Html.PartialAsync("_ChartStatus")*@
                        <!--</div>
                        <div class="col-md-8">-->
                            @*@await Html.PartialAsync("_ChartRequirements")*@
                        <!--</div>

                        <div class="col-md-4">-->

                            @*@await Html.PartialAsync("_ChartResume")*@
                        <!--</div>-->




                    <!--</div>-->
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">


                            <div class="tab-items high">
                                <span class="btn-title tab1 active" onclick="Tab('tab1',1)">
                                    Active Vacancies
                                    <span id="tb1" class="btn-notification">@Model.Tab1Count</span>
                                </span>
                            </div>

                            <div class="tab-items high">
                                <span class="btn-title tab2" onclick="Tab('tab2',2)">
                                    Acceptance Pending
                                    @*Pending for Accept*@
                                    <span id="tb2" class="btn-notification">@Model.Tab2Count</span>
                                </span>
                            </div>
                            @*<div class="tab-items high">
                                    <span class="btn-title tab3" onclick="Tab('tab3',3)">
                                        Filled Vacancies
                                        <span id="tb3" class="btn-notification">@Model.Tab3Count</span>
                                    </span>
                                </div>*@


                            <div class="tab-items high">
                                <span class="btn-title tab3" onclick="Tab('tab3',3)">
                                    @*Shortlisted Aged MRF*@
                                    @*Overdue Vacancies*@

                                    @*Positions Overdue*@
                                    Vacancy Overdue
                                    <span id="tb3" class="btn-notification">
                                        @Model.Tab3Count
                                    </span>
                                </span>
                            </div>

                            <div class="tab-items medium">
                                <span class="btn-title tab4" onclick="Tab('tab4',4)">
                                    @*Employees In Notice*@ Resignation Acc. Pending
                                    <span id="tb4" class="btn-notification">@Model.Tab4Count</span>
                                </span>
                            </div>
                            <div class="tab-items medium">
                                <span class="btn-title tab5" onclick="Tab('tab5',5)">
                                    @*Employees In Notice*@ Cancelled
                                    <span id="tb4" class="btn-notification">@Model.Tab5Count</span>
                                </span>
                            </div>
                            <div class="tab-items medium">
                                <span class="btn-title tab6" onclick="Tab('tab6',6)">
                                    @*Employees In Notice*@ Closed
                                    <span id="tb4" class="btn-notification">@Model.Tab6Count</span>
                                </span>
                            </div>



                            <div class="tab-items select-option">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                @*<div id="filterForm" class="filter-button slider-btn" data-bs-toggle="tooltip" title="Filter">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>*@
                                <a data-bs-toggle="tooltip" title="Export to Excel"
                                   class="btn btn-excel" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>
                            </div>


                        </div>
                    </div>

                    <div id="VacancyList">
                        @if (ViewBag.RedirctFrom == "FromRecruitmentDashBoard")
                            @await Html.PartialAsync("_ShortlistedAgedMRFList")
                            else

                                @await Html.PartialAsync("_ActiveVacancyList")
                    </div>

                    <div id="CreateMRFSlider">

                    </div>
                    <div id="VacancySlider">

                    </div>
                    <div class="row card-footer-bottom-fixed">

                        @*<div class="col-md-12 align-right">
                                <a id="wageGradeMasterAdd" type="button"
                                   class="btn btn-default float-right mobile-full-width slider-btn" onclick="getMRFCreate()">
                                    New Manpower Request
                                </a>
                            </div>*@


                    </div>
                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
<!--end::Content-->