</style>
































<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->

        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Moments</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index","Home",new { Area=""})"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Moments
                    </li>
                </ul>
            </div>
        </div>


    </div>
    <!--end::Container-->
</div>


<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->
            <div class="card card-custom height-100per footer-row-fixed">
                <div class="card-body">
                    @*<content></content>*@

                    <!--begin::Brithady scroll start-->

                    <div class="row">
                        <div class="col-md-12">
                            <div class="full-backgrnd">


                                <div class="row">


                                    <div id="" class="col-md-4">
                                        <div class="Upcoming-birthCele">
                                            <h2 class="birthdaycele">Upcoming Celebrations</h2>
                                            <div class="navbr-all-today">
                                                <div class="all-drop d-flex">

                                                    <div class="dropdown ">
                                                        <select name="languages " class="all-changes " id="celebType" onchange="GetUpcomingCelebrations()">

                                                            <option value="0">All</option>
                                                            <option value="1">Birthday</option>
                                                            <option value="3">Wedding Anniversary</option>
                                                            <option value="2">Joining anniversary</option>

                                                        </select>
                                                    </div>
                                                    <div class="dropdown">
                                                        <select name="languages" class="all-changes " id="classifications" onchange="GetUpcomingCelebrations()">
                                                            <option value="Today">Today</option>
                                                            <option value="Upcoming">Upcoming</option>
                                                            <option value="This Month">This Month</option>
                                                            <option value="Next Month">Next Month</option>
                                                            <option value="Previous Month">Previous Month</option>

                                                        </select>
                                                    </div>
                                                </div>


                                            </div>
                                            <div id="upcomingCelebs">
                                                @await Html.PartialAsync("_UpcomingCelebrations")
                                            </div>
                                            <div class="d-flex justify-content-end p-3">
                                                <a href="@Url.Action("Celebrations","CelebrityList",new { Area = "DataBank"})"> <h2 class="upcomig-evnt">View All</h2></a>

                                            </div>
                                        </div>

                                    </div>

                                    <div class="col-md-8">

                                        <div id="" class="carousel slide" data-ride="carousel">
                                           
                                            <div class="carousel-inner">
                                                <div class="carousel-item active">
                                                    <div class="row">
                                                        @{
                                                            decimal totCount = 0;
                                                            if (Model.LifeEventsCelebrityList != null)
                                                                totCount = Model.LifeEventsCelebrityList.Count;

                                                            int itemsPerScroll = 4;
                                                            int index = itemsPerScroll;
                                                            decimal noOfDivs = Math.Ceiling(totCount / itemsPerScroll);
                                                            int itemPerScroll2 = 0;
                                                            if (Model.LifeEventsCelebrityList != null && Model.LifeEventsCelebrityList.Count < itemsPerScroll)
                                                            {
                                                                itemPerScroll2 = Model.LifeEventsCelebrityList.Count;
                                                            }
                                                            else
                                                            {
                                                                itemPerScroll2 = itemsPerScroll;
                                                            }
                                                        }
                                                        @for (int i = 0; i < itemPerScroll2; i++)
                                                        {

                                                            @if (Model.LifeEventsCelebrityList != null && Model.LifeEventsCelebrityList[i].CelebrityType == "BirthDay")
                                                            {

                                                                <div class="col-md-3">

                                                                    <div class="card-border-0 shadow">
                                                                        <div class="wish-boad-pad">

                                                                            <div class="wish-img ">
                                                                                @if (Model.LifeEventsCelebrityList[i].FileName != "")
                                                                                {
                                                                                    <img class="brithday-wishes" src="/AccessFile/GetEmpThumbnail?EmployeeGI=@(Model.LifeEventsCelebrityList[i].EmployeeGuid)" />
                                                                                   
                                                                                }
                                                                                else
                                                                                {
                                                                                    <div class="employee-profile-img profile_text  upcoming_border_cls" style=" background-color: #989ca9; color: #fff; display: flex; text-align: center; justify-content: center; align-items: center;">
                                                                                        <span class="profile-name-leter-chg" style="font-size:23px;">
                                                                                            @Model.LifeEventsCelebrityList[i].EmployeeName.Substring(0, 1)
                                                                                        </span>

                                                                                    </div>
                                                                                }
                                                                            </div>
                                                                            <div class="card-body text-center p-0">
                                                                                <h4 class="name-one">@Model.LifeEventsCelebrityList[i].EmployeeName</h4>
                                                                                <p class="birthday_Txt">@Model.LifeEventsCelebrityList[i].CelebrityType</p>
                                                                                <p><button class="wish-btn">WISH</button></p>
                                                                            </div>

                                                                        </div>
                                                                    </div>

                                                                </div>

                                                            }

                                                            @if (Model.LifeEventsCelebrityList != null && Model.LifeEventsCelebrityList[i].CelebrityType == "Wedding")
                                                            {
                                                                <div class="col-md-3">

                                                                    <div class="card-border-0 shadow">
                                                                        <div class="wish-boad-pad">
                                                                            <div class="wish-img ">
                                                                                @if (Model.LifeEventsCelebrityList[i].FileName != "")
                                                                                {
                                                                                    <img class="brithday-wishes" src="/AccessFile/GetEmpThumbnail?EmployeeGI=@(Model.LifeEventsCelebrityList[i].EmployeeGuid)"  />
                                                                                   
                                                                                }
                                                                                else
                                                                                {
                                                                                    <div class="employee-profile-img profile_text upcoming_border_cls" style=" background-color: #989ca9; color: #fff; display: flex; text-align: center; justify-content: center; align-items: center;">
                                                                                        <span class="profile-name-leter-chg" style="font-size:23px;">
                                                                                            @Model.LifeEventsCelebrityList[i].EmployeeName.Substring(0, 1)
                                                                                        </span>

                                                                                    </div>
                                                                                }
                                                                            </div>
                                                                            <div class="card-body text-center p-0">
                                                                                <h4 class="name-one">@Model.LifeEventsCelebrityList[i].EmployeeName</h4>
                                                                                <p class="wedd_Txt">@Model.LifeEventsCelebrityList[i].CelebrityType</p>
                                                                                <p><button class="wish-btn">WISH</button></p>
                                                                            </div>


                                                                        </div>

                                                                    </div>

                                                                </div>


                                                            }


                                                            @if (Model.LifeEventsCelebrityList != null && Model.LifeEventsCelebrityList[i].CelebrityType == "Joining")
                                                            {
                                                                <div class="col-md-3">

                                                                    <div class="card-border-0 shadow">
                                                                        <div class="wish-boad-pad">
                                                                            <div class="wish-img ">
                                                                                @if (Model.LifeEventsCelebrityList[i].FileName != "")
                                                                                {
                                                                                    <img class="brithday-wishes" src="/AccessFile/GetEmpThumbnail?EmployeeGI=@(Model.LifeEventsCelebrityList[i].EmployeeGuid)" alt="1stimg" />
                                                                                    
                                                                                }
                                                                                else
                                                                                {
                                                                                    <div class="employee-profile-img profile_text upcoming_border_cls" style=" background-color: #989ca9; color: #fff; display: flex; text-align: center; justify-content: center; align-items: center;">
                                                                                        <span class="profile-name-leter-chg" style="font-size:23px;">
                                                                                            @Model.LifeEventsCelebrityList[i].EmployeeName.Substring(0, 1)
                                                                                        </span>

                                                                                    </div>
                                                                                }
                                                                            </div>
                                                                            <div class="card-body text-center p-0">
                                                                                <h4 class="name-one">@Model.LifeEventsCelebrityList[i].EmployeeName</h4>
                                                                                <p class="joining_Txt">@Model.LifeEventsCelebrityList[i].CelebrityType</p>
                                                                                <p><button class="wish-btn">WISH</button></p>
                                                                            </div>


                                                                        </div>

                                                                    </div>
                                                                </div>

                                                            }

                                                        }

                                                    </div>
                                                </div>
                                                @for (int j = 0; j < (noOfDivs - 1); j++)
                                                {

                                                    <div class="carousel-item">
                                                        <div class="row">
                                                            @for (int i = 0; i < itemsPerScroll; i++)
                                                            {
                                                                if (index != totCount)
                                                                {
                                                                    @if (Model.LifeEventsCelebrityList != null && Model.LifeEventsCelebrityList[index].CelebrityType == "BirthDay")
                                                                    {

                                                                        <div class="col-md-3">

                                                                            <div class="card-border-0 shadow">
                                                                                <div class="wish-boad-pad">

                                                                                    <div class="wish-img ">
                                                                                        @if (Model.LifeEventsCelebrityList[i].FileName != "")
                                                                                        {
                                                                                            <img class="brithday-wishes" src="/AccessFile/GetEmpThumbnail?EmployeeGI=@(Model.LifeEventsCelebrityList[i].EmployeeGuid)" alt="1stimg" />
                                                                                            
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            <div class="employee-profile-img profile_text upcoming_border_cls" style=" background-color: #989ca9; color: #fff; display: flex; text-align: center; justify-content: center; align-items: center;">
                                                                                                <span class="profile-name-leter-chg" style="font-size:23px;">
                                                                                                    @Model.LifeEventsCelebrityList[i].EmployeeName.Substring(0, 1)
                                                                                                </span>

                                                                                            </div>
                                                                                        }
                                                                                    </div>
                                                                                    <div class="card-body text-center p-0">
                                                                                        <h4 class="name-one">@Model.LifeEventsCelebrityList[index].EmployeeName</h4>
                                                                                        <p class="birthday_Txt">@Model.LifeEventsCelebrityList[index].CelebrityType</p>
                                                                                        <p><button class="wish-btn">WISH</button></p>
                                                                                    </div>

                                                                                </div>
                                                                            </div>

                                                                        </div>
                                                                    }

                                                                    @if (Model.LifeEventsCelebrityList != null && Model.LifeEventsCelebrityList[index].CelebrityType == "Wedding")
                                                                    {
                                                                        <div class="col-md-3">

                                                                            <div class="card-border-0 shadow">
                                                                                <div class="wish-boad-pad">
                                                                                    <div class="wish-img ">
                                                                                        @if (Model.LifeEventsCelebrityList[i].FileName != "")
                                                                                        {
                                                                                            <img class="brithday-wishes" src="/AccessFile/GetEmpThumbnail?EmployeeGI=@(Model.LifeEventsCelebrityList[i].EmployeeGuid)" />
                                                                                           
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            <div class="employee-profile-img profile_text upcoming_border_cls " style=" background-color: #989ca9; color: #fff; display: flex; text-align: center; justify-content: center; align-items: center;">
                                                                                                <span class="profile-name-leter-chg" style="font-size:23px;">
                                                                                                    @Model.LifeEventsCelebrityList[i].EmployeeName.Substring(0, 1)
                                                                                                </span>

                                                                                            </div>
                                                                                        }
                                                                                    </div>
                                                                                    <div class="card-body text-center p-0">
                                                                                        <h4 class="name-one">@Model.LifeEventsCelebrityList[index].EmployeeName</h4>
                                                                                        <p class="wedd_Txt">@Model.LifeEventsCelebrityList[index].CelebrityType</p>
                                                                                        <p><button class="wish-btn">WISH</button></p>
                                                                                    </div>


                                                                                </div>

                                                                            </div>

                                                                        </div>

                                                                    }


                                                                    @if (Model.LifeEventsCelebrityList != null && Model.LifeEventsCelebrityList[index].CelebrityType == "Joining")
                                                                    {
                                                                        <div class="col-md-3">

                                                                            <div class="card-border-0 shadow">
                                                                                <div class="wish-boad-pad">
                                                                                    <div class="wish-img ">
                                                                                        @if (Model.LifeEventsCelebrityList[i].FileName != "")
                                                                                        {
                                                                                            <img class="brithday-wishes" src="/AccessFile/GetEmpThumbnail?EmployeeGI=@(Model.LifeEventsCelebrityList[i].EmployeeGuid)"/>
                                                                                          
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            <div class="employee-profile-img profile_text upcoming_border_cls" style=" background-color: #989ca9; color: #fff; display: flex; text-align: center; justify-content: center; align-items: center;">
                                                                                                <span class="profile-name-leter-chg" style="font-size:23px;">
                                                                                                    @Model.LifeEventsCelebrityList[i].EmployeeName.Substring(0, 1)
                                                                                                </span>

                                                                                            </div>
                                                                                        }
                                                                                    </div>
                                                                                    <div class="card-body text-center p-0">
                                                                                        <h4 class="name-one">@Model.LifeEventsCelebrityList[index].EmployeeName</h4>
                                                                                        <p class="joining_Txt">@Model.LifeEventsCelebrityList[index].CelebrityType</p>
                                                                                        <p><button class="wish-btn">WISH</button></p>
                                                                                    </div>


                                                                                </div>

                                                                            </div>
                                                                        </div>
                                                                    }
                                                                    index++;
                                                                }
                                                            }




                                                        </div>
                                                    </div>



                                                }


                                            </div>

                                        </div>



                                   


                                        <div class="snd-team-marg">
                                            <div class="d-flex justify-content-between">
                                                <h2 class="upcomig-evnt">Upcoming Events</h2>



                                                <div class="add-event-btm d-flex align-items-center"> 
                                                    <a><i class="fa fa-plus-circle  add-btn-newz   slider-btn   " id="addexitchecklist" aria-hidden="true"></i></a>
                                         

                                                    <a href="@Url.Action("UpcomingEvents","LifeEvents",new { Area="DataBank"})"> <h2 class="upcomig-evnt m-0">View All</h2></a>
                                                </div>
                                               
                                            </div>

                                            <div id="" class="carousel slide" data-ride="carousel">
                                                <div class="carousel-inner">
                                                    <div class="carousel-item active">


                                                        <div class="row">

                                                            @{
                                                                decimal totCnt = 0;
                                                                int itemPerScroll = 0;
                                                                int EventsIndex = 0;
                                                                decimal noOfDiv = 0;
                                                                if (Model != null && Model.LifeEventsEventList != null)
                                                                {
                                                                    totCnt = Model.LifeEventsEventList.Count;
                                                                    itemPerScroll = 3;
                                                                    EventsIndex = itemPerScroll;
                                                                    noOfDiv = Math.Ceiling(totCnt / itemPerScroll);
                                                                }

                                                            }
                                                            @if (Model != null && Model.LifeEventsEventList != null)
                                                            {
                                                                if (Model.LifeEventsEventList.Count < 3)
                                                                    itemPerScroll = Model.LifeEventsEventList.Count;
                                                                @for (int i = 0; i < itemPerScroll; i++)
                                                                {
                                                                    if (i != totCnt)
                                                                    {
                                                                        <div class="col-md-4">

                                                                            <div class="card  upevnt-main ">
                                                                                <div class="slide-img">
                                                                                    <img src="@Model.LifeEventsEventList[i].Base64string"  class="cloud-img">
                                                                                </div>
                                                                                <div class="card-body changebg-colo ">
                                                                                    <h5 class="card-title mb-0 team-metingcloud">@Model.LifeEventsEventList[i].EventName</h5>
                                                                              
                                                                                    <div class="event-time-datez">
                                                                                        <p class="date-evntz">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.LifeEventsEventList[i].EventDate)) </p>
                                                                                        <span class="time-cele">@Model.LifeEventsEventList[i].EventTime</span>
                                                                                    </div>
                                                                                </div>
                                                                            </div>



                                                                        </div>
                                                                    }


                                                                  

                                                                }

                                                            }





                                                        </div>

                                                    </div>
                                                    @if (Model != null && Model.LifeEventsEventList != null)
                                                    {
                                                        @for (int j = 0; j < (noOfDiv - 1); j++)
                                                        {
                                                            <div class="carousel-item ">


                                                                <div class="row">
                                                                    @for (int i = 0; i < itemPerScroll; i++)
                                                                    {
                                                                        if (EventsIndex != totCnt)
