    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="~/js/jquery.min.js"></script>
<script src="~/scripts/DataBank/LifeEvents.js"></script>
<script>
    $(document).ready(function () {
        $('.kt_timepicker_2, .kt_timepicker_2_modal').timepicker({
            minuteStep: 1,
            defaultTime: '',
            showSeconds: false,
            showMeridian: false,
            autoclose: true
        });
    });
</script>


