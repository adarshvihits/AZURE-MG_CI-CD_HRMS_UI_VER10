                                        </div>
                                        <div class="col-md-3">
                                            <div class="text-center">
                                                <div class="brith-icon">
                                                    <img class="icon-wedd" src="~/images/icons8-anniversary-64 (1).png" alt="iconsvg" />
                                                </div>

                                                <div class="brith-datez">
                                                    <h6 class="datezz">@Html.Encode(String.Format("{0:MMM dd}", Model.LifeEventsCelebrityList[i].CelibrityDate))</h6>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div> 
                                </div>


                            

                        }

                        if (Model.LifeEventsCelebrityList[i].CelebrityType == "Joining")
                        {

                            <div class=" name-lign">
                                @*Joining anniversary*@
                                <div class=" total-item">
                                    <div class="row">
                                        <div class="col-md-3">
