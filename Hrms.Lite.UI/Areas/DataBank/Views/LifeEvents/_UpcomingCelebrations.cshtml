@model Hrms.Lite.Shared.DataBank.DTO.LifeEvents


        <div class="scrollbar" id="style-2">
            <div class="force-overflow">
               

                @if (Model != null && Model.LifeEventsCelebrityList != null && Model.LifeEventsCelebrityList.Count > 0)
                {

                    for (int i = 0; i < Model.LifeEventsCelebrityList.Count; i++)
                    {
                        if (Model.LifeEventsCelebrityList[i].CelebrityType == "BirthDay")
                        {



                    <div class=" name-lign">
                        @*birthday*@
                        <div class=" total-item">
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="lifeventimg ">
                                        @if (Model.LifeEventsCelebrityList[i].FileName != "")
                                        {
                                        <img class="iststbithday" src="/AccessFile/GetEmpThumbnail?EmployeeGI=@(Model.LifeEventsCelebrityList[i].EmployeeGuid)" style="border:none"/>
   
                                        }
                                        else
                                        { 
                                            <div class="employee-profile-img profile_text upcoming_border_cls" style=" background-color: #989ca9; color: #fff; display: flex; text-align: center; justify-content: center; align-items: center;">
                                                <span class="profile-name-leter-chg" style="font-size:23px;">
                                                    @Model.LifeEventsCelebrityList[i].EmployeeName.Substring(0, 1)
                                                </span>

                                            </div>
                                        }
                                    </div>

                                </div>
                                <div class="col-md-6">
                                    <div class="brith-id-name">
                                        <h6 class="celekuriakose">@Model.LifeEventsCelebrityList[i].EmployeeName</h6>
                                        <h6 class="destinationz">@Model.LifeEventsCelebrityList[i].EmpId</h6>
                                        <h6 class="destinationz">@Model.LifeEventsCelebrityList[i].Designation</h6>
                                        <h6 class="brithdayzz">@Model.LifeEventsCelebrityList[i].CelebrityType</h6>
                                    </div>
                                </div>

                                <div class="col-md-3">
                                    <div class=" text-center">
                                        <div class="brith-icon">
                                            <img class="iconbrith" src="~/images/birthday-cake-svgrepo-com (1).svg" alt="iconsvg" />
                                        </div>

                                        <div class="brith-datez">
                                            <h6 class="datezz">@Html.Encode(String.Format("{0:MMM dd}", Model.LifeEventsCelebrityList[i].CelibrityDate))</h6>
                                        </div>
                                    </div>
                                </div>
                             
                            </div>
                        </div> @*birthday*@

                </div>



                        }
                        if (Model.LifeEventsCelebrityList[i].CelebrityType == "Wedding")
                        {

                            <div class=" name-lign">
                                @*Wedding Anniversary*@
                                <div class=" total-item">
                                    <div class="row">
                                        <div class="col-md-3">
                                            <div class="lifeventimg ">
                                                @if (Model.LifeEventsCelebrityList[i].FileName != "")
                                                {
                                                    <img class="iststbithday" src="/AccessFile/GetEmpThumbnail?EmployeeGI=@(Model.LifeEventsCelebrityList[i].EmployeeGuid)"style="border:none" />
                                                }
                                                else
                                                {
                                                    <div class="employee-profile-img profile_text upcoming_border_cls" style=" background-color: #989ca9; color: #fff; display: flex; text-align: center; justify-content: center; align-items: center;">
                                                        <span class="profile-name-leter-chg" style="font-size:23px;">
                                                            @Model.LifeEventsCelebrityList[i].EmployeeName.Substring(0, 1)
                                                        </span>

                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="brith-id-name">
                                                <h6 class="celekuriakose">@Model.LifeEventsCelebrityList[i].EmployeeName</h6>
                                                <h6 class="destinationz">@Model.LifeEventsCelebrityList[i].EmpId</h6>
                                                <h6 class="destinationz">@Model.LifeEventsCelebrityList[i].Designation</h6>
                                                <h6 class="wedd-anniversary">@Model.LifeEventsCelebrityList[i].CelebrityType</h6>
