@model Hrms.Lite.Shared.DataBank.DTO.LifeEvents

<script src="~/js/bootstrap-datepicker.js"></script>
<script src="~/js/bootstrap-timepicker.js"></script>
<script>
        $(document).ready(function () {
            debugger;
            var b = document.getElementById('Attachment_AbsoluteUri');
            if (b.value == null) {
                fileLabel.innerHTML = "No File Chosen";
            }
            else {
                var b = document.getElementById('Attachment_ActualFileName');
                if (b.value != '') {

                    let replacemnt = '..';
                    theSplit = b.value.slice(0, 6);
                    fileLabel.innerHTML = theSplit.substring(0, theSplit.length - 2) + replacemnt + '@Model.Attachment.FileExtension';
                }
                else {
                    fileLabel.innerHTML = "";

                }
            }

          
        });


        window.pressed = function () {
            debugger
            var a = document.getElementById('Attachment_FileData');
            if (a.value == "") {
                fileLabel.innerHTML = "No File Chosen";
            }
            else {
                debugger
                var theSplit = a.value.split('\\');
                theSplit = theSplit[theSplit.length - 1];
                let replacemnt = '..';
                theSplit = theSplit.slice(0, 6);
                fileLabel.innerHTML = theSplit.substring(0, theSplit.length - 2) + replacemnt;
            }
        };

      

</script>

<style>

    .event_FileData {
        color: white !important;
    }
