@model Hrms.Lite.Shared.DataBank.DTO.LifeEvents
@{
    ViewData["Title"] = "UpcomingEvents";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/DataBank/LifeEvents.js"></script>
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->

        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Life Events</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a href="@Url.Action("Index", "LifeEvents", new { Area = "DataBank" })">Moments</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Moments
                    </li>

                </ul>
            </div>
        </div>


    </div>
    <!--end::Container-->
</div>
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body ">

                            <div class="row tab-style-button">
                                <div class="tab-button-wrap">


                                    <div class="form-group mt-7 d-flex">

                                        <div class="ml-4">
                                            <label>
                                                <input checked="checked" id="eventType" name="eventType" type="radio" value="0" onclick="GetEventList('Upcoming')">
                                                <label>Upcoming</label>
                                            </label>
                                            <label>
                                                <input id="eventType" name="eventType" type="radio" value="1" onclick="GetEventList('Previous')">
                                                <label>Previous</label>
                                            </label>


                                        </div>



                                    </div>







                                    <div class="tab-items select-option">

                                        <div class="sraech-slider">
                                            <div class="search-slider-inner">
                                                <i class="fa fa-search"></i>
                                            </div>
                                            <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                                   placeholder="ID/Name">
                                        </div>
                                      
                                        <a data-bs-toggle="tooltip" title="Export to Excel" class="btn btn-excel" onclick="ExportToExcel()">
                                            <i class="icon-xl far fa-file-excel"></i>
                                        </a>
                                    </div>


                                </div>
                            </div>



                         

                            <div id="listDiv">

                                @await Html.PartialAsync("_EventsList")
                            </div>
                            <div id="sliderDiv"></div>
                            <!-- <end table></end> -->
                            <div class="row card-footer-bottom-fixed">

                           

                            </div>
                        </div>

                    </div>
                </div>
            </div>




            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>