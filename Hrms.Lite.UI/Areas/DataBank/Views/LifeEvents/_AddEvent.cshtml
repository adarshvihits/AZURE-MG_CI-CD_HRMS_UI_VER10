@model Hrms.Lite.Shared.DataBank.DTO.LifeEvents

@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "addEvnts" }))
{
<div id="addexitchecklist" class="slider-forms addEvts">
    <div class="slider-inner-style">
        <div class="slider-form-close">
            <i class="ki ki-close icon-xs text-muted"></i>
        </div>
        <h4>
            Events
        </h4>
        <div class="row">

            <div class="col-md-12">
                <div class="form-group">
                    <label>Event Name</label>       
                    @Html.HiddenFor(m => m.Mode)
                    @Html.TextBoxFor(m => m.EventName, new { @class = "form-control form-control-sm", @placeholder = "Event Name" })
                </div>
            </div>



        </div>
    

        <div class="row my-3">

            <div class="col-md-12">
                <label>Description</label>                
                @Html.TextAreaFor(m => m.Description, new { @class = "form-control form-control-sm", @placeholder = "Description" })
            </div>
        </div>

        <div class="row my-3">
            <div class="col-sm-6">


                <div class="row-outer ">
                    <label>Date</label>
                    <div class="input-group date">                        
                        @Html.TextBoxFor(m => m.EventDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "Date"})

                        <div class="input-group-append">
                            <span class="input-group-text">
                                <i class="la la-calendar"></i>
                            </span>
                        </div>
                    </div>

                </div>

            </div>
            <div class="col-sm-6">
                <label>Time</label>
                <div class="input-group timepicker">
                    @*<input class="form-control form-control-sm kt_timepicker_2" placeholder="OUT Time" readonly="" type="text" value="00:00">*@
                    @Html.TextBoxFor(m => m.EventTime, new { @class = "form-control form-control-sm kt_timepicker_2", @placeholder = "Time" })
                    <div class="input-group-append">
                        <span class="input-group-text">
                            <i class="la la-clock-o"></i>
                        </span>
                    </div>
                </div>
            </div>

        </div>

        <div class="row my-3">
            <div class="col-md-6">
                <div class="file-upload-form-group">
                    <label for="formFileMultiple" class="form-label">
                        Poster Upload
                    </label>

                    <div class="file-upload-form mb-1">
                        <div class="small-btn-group">
                            <button type="button" data-bs-toggle="tooltip" data-placement="top" data-bs-original-title="View Image" class="btn btn-icon btn-default" onclick="Preview('resume')">
                                <i class="icon-xl far fa-eye"></i>
                            </button>
                        </div>
                        <div data-bs-toggle="tooltip" data-bs-original-title=" Only pdf, doc, docx files
                                            are
                                            allowed , File size less than 1 MB.">
                            @*<input class="form-control resume" id="CandidateDetails_Resume_FileData" name="CandidateDetails.Resume.FileData" type="file">*@
                            @Html.TextBoxFor(m => m.Attachment.FileData, new { @type = "file",@class= "form-control resume" ,title="" })
                        </div>
                    </div>
                </div>
            </div>
        </div>











        <div class="row card-footer-bottom-fixed border-none">

            <div class="col-md-12 align-right">
                <a type="button"
                   class="btn btn-default  mobile-full-width" onclick="SaveEvent('Save','CREATE')">
                    Save
                </a>
            </div>

        </div>
    </div>
</div>
}