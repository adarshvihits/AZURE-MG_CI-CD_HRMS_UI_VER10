@model Hrms.Lite.Shared.DataBank.DTO.LifeEvents
    <script src="~/js/settings.js"></script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table skilltype- upcoming-events-list ">
    <table class="common-table">
        <thead>
            <tr class="table-dark">

                <th scope="col">Event Name</th>
                <th scope="col">Description</th>
                <th scope="col">Date</th>
                <th scope="col">Time</th>
                <th scope="col">Poster</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.LifeEventsEventList != null && Model.LifeEventsEventList.Count > 0)
            {
                for (int i = 0; i < Model.LifeEventsEventList.Count; i++)
                {
                    <tr>

                        @Html.HiddenFor(m => m.LifeEventsEventList.Count)
                        <td data-label="Name">@Html.HiddenFor(m => m.EventGI)@Model.LifeEventsEventList[i].EventName </td>
                        <td data-label="Short Name">@Model.LifeEventsEventList[i].Description</td>
                        <td data-label="Short Name">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.LifeEventsEventList[i].EventDate))</td>
                        <td data-label="Short Name">@Model.LifeEventsEventList[i].EventTime</td>
                        <td data-label="Short Name"><a id="trainingEmployeeDetails" data-bs-toggle="tooltip" title="" data-bs-original-title="View" class="view_btn" onclick="showDocument('@Model.LifeEventsEventList[i].FileName', '@Model.LifeEventsEventList[i].AbsoluteUri')"> </a></td>
                        <td data-label="Actions">

                            <a data-bs-toggle="tooltip" title="Edit"
                               id="editskilltype" type="button"
                               class="btn btn-icon btn-edit icon-only" onclick="GetEventDetails('@Model.LifeEventsEventList[i].EventGI')">
                                <i class="icon-xl fas fa-pencil-alt"></i>
                            </a>
                            <!-- Edit Slider start-->                          
                            <!-- Edit Slider  end-->
                            <!-- delete Slider  start-->
                            <a data-bs-toggle="tooltip" title="Delete"
                               id="deleteskilltype" type="button"
                               class="btn btn-icon  icon-only mobile-full-width slider-btn btn-delete" onclick="GetEventDetailsDelete('@Model.LifeEventsEventList[i].EventGI')">
                                <i class="icon-xl far fa-trash-alt"></i>
                            </a>


                            <!-- <end delete section></end> -->
                        </td>
                    </tr>
                }
            }


        </tbody>
    </table>
</div>