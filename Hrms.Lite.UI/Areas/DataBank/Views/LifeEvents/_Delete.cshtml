@model Hrms.Lite.Shared.DataBank.DTO.LifeEvents
<script src="~/js/tooltip.js"></script>

<div id="addexitchecklist" class="slider-forms slider-forms-open delEvts">
    <div class="slider-inner-style">
        <div class="slider-form-close" onclick="CloseSlider('delEvts')">
            <i class="ki ki-close icon-xs text-muted"></i>
        </div>
        <h4>
            Delete Event
        </h4>
        <div class="row">

            <div class="col-md-12">
                <div class="form-group">
                    <label class="view-title">Event Name</label>
                    <div class="view-details">
                        @Html.HiddenFor(m => m.EventGI)
                        @Html.DisplayFor(m => m.EventName)
                    </div>
                  
                </div>
            </div>



          
        </div>
       

        <div class="row my-3">

            <div class="col-md-12">
                <label class="view-title">Description</label>
                <div class="view-details">
                    @Html.DisplayFor(m => m.Description)
                    </div>
                </div>
            </div>

        <div class="row my-3">
            <div class="col-sm-6">


                <div class="row-outer ">
                    <label class="view-title">Date</label>
                    <div class="input-group date">                        
                        @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.EventDate))
                       
                    </div>

                </div>

            </div>
            <div class="col-sm-6">
                <label class="view-title">Time</label>
                <div class="input-group timepicker">
                    @*<input class="form-control form-control-sm kt_timepicker_2" placeholder="OUT Time" readonly="" type="text" value="00:00">*@
                    @Html.DisplayFor(m => m.EventTime)                   
                </div>
            </div>

        </div>

