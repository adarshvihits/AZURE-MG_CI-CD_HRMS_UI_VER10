@model Hrms.Lite.Shared.DataBank.DTO.RewardsAndRecognition


<script src="~/js/tooltip.js"></script>

@using (Html.BeginForm("Delete", "RewardsAndRecognition", FormMethod.Post))
{
    <div id="EmployRewardsRecognition" class="slider-forms slider-forms-open rewardDT">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('rewardDT')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>

            <h4>Rewards & Recognition</h4>
            <div class="profile-header position-relative pb-12 mb-5"
                 style="padding-bottom: 2px !important; padding-top: 5px !important;">
                <div class="row">
                    @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeSliderHeader.cshtml", Model.EmployeeHeader)
                </div>
                <div class="profile-header-overflow"></div>
            </div>

            <h5><i class="fas fa-briefcase icon-md mr-2"></i> @Model.RewardsRequest.Rewards.Name</h5>



            <div class="row">

                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Points </label>
                        <div class="view-details">
                            @Model.RewardsRequest.PointCriteria.Points
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Reward Date</label>
                        <div class="view-details">
                            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.RewardsRequest.RewardDate))
                        </div>
                    </div>
                </div>

            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Recommended by</label>
                        <div class="view-details">
                            @Model.RewardsRequest.RecommendedEmpName
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Recommended For</label>
                        <div class="view-details">
                            @Model.RewardsRequest.RecommendedFor
                        </div>
                    </div>
                </div>

            </div>


            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Attach File</label>
                        @Html.HiddenFor(model => Model.RewardsRequest.File.AbsoluteUri)
                        <div class="view-details">
                            <a  class="btn btn-secondary mobile-full-width" data-bs-toggle="tooltip" title=""  data-bs-original-title="View File"
                              onclick="showDocument('@Model.RewardsRequest.File.FileName','@Model.RewardsRequest.File.AbsoluteUri')">
                                <i class="icon-xl far fa-eye"></i>View File
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Remarks</label>
                        <div class="view-details">
                            @Model.RewardsRequest.Remarks
                        </div>
                    </div>
                </div>

            </div>




            <div class="row card-footer-bottom-fixed border-none mt-2">
                <div class="col-md-12 pr-4 float-right-btn">
                    <a type="button" title="Delete" data-bs-toggle="tooltip" 
                       class="btn btn-icon btn-delete big-btn"
                       onclick="Delete('@Model.RewardsRequest.RewardsAndRecognitionGI')">
                        <i class="icon-xl far fa-trash-alt"></i>
                    </a>
                    

                </div>
            </div>






        </div>
    </div>
}
