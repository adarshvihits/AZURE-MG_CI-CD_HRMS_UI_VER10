@model Hrms.Lite.Shared.DataBank.DTO.RewardsAndRecognition

<div  class="slider-forms slider-forms-open rewrd_Rec_Approve">
    <div class="slider-inner-style">
        <div class="slider-form-close" onclick="CloseSlider('rewrd_Rec_Approve')"><i class="ki ki-close icon-xs text-muted"></i></div>
        <h4>Rewards & Recognition</h4>

        <div class="profile-header position-relative pb-12 mb-5"
             style="padding-bottom: 2px !important; padding-top: 5px !important;">
            <div class="row">
                @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeSliderHeader.cshtml", Model.EmployeeHeader)
            </div>
            <div class="profile-header-overflow"></div>
        </div>


        <div class="row">
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Reward</label>
                    <div class="view-details">
                        @Html.DisplayFor(m=>m.RewardsRequest.Rewards.Name)
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Reward Date</label>
                    <div class="view-details">
                        @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.RewardsRequest.RewardDate))
                    </div>
                </div>
            </div>

        </div>


        <div class="row">
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Point Criteria</label>
                    @*<select class="col-md-10 form-control form-control-sm " id="exampleSelects">
            <option>Point Criteria</option>
            <option>Point Criteria</option>
        </select>*@
                    @Html.DropDownListFor(m => m.RewardsRequest.PointCriteria.Code, (SelectList)ViewBag.PointCriteria, "Select Point Criteria", new { @class = "form-control form-control-sm" , @onchange = "onPointCriteriaChange(this,'pointCriteria')" })

                </div>
            </div>
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Points Achieved</label>
                    <div class="view-details">
                     <span class="Points" > @Html.DisplayFor(m=>m.RewardsRequest.PointCriteria.Points)</span>
                    </div>
                </div>
            </div>

        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Recommended by</label>
                    <div class="view-details">
                        @Html.DisplayFor(m => m.RewardsRequest.RecommendedEmpName)
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Recommended For</label>
                    <div class="view-details">
                        @Html.DisplayFor(m => m.RewardsRequest.RecommendedFor)
                    </div>
                </div>
            </div>

        </div>

        <div class="row card-footer-bottom-fixed">

            <div class="col-md-12 align-right">

                <a type="button" class="btn btn-danger mobile-full-width">
                    Reject
                </a>
                <a type="button" class="btn btn-default  mobile-full-width">
                    Approve
                </a>
            </div>

        </div>

    </div>
</div>
