
@model Hrms.Lite.Shared.DataBank.DTO.RewardsAndRecognition
<script src="~/js/settings.js"></script>
<script>
     $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.AllTabCount");
        $('.Tab1Count').html("@Model.Tab1Count");
        $('.Tab2Count').html("@Model.Tab2Count");
        $('.PointSummaryCount').html("@Model.PointSummaryCount");
        $('.MoreTabCount').html("@Model.MoreTabCount");
         $('.PendingTabCount').html("@Model.PendingTabCount");


         //$('#rewAndRecPointSumTable').DataTable({
         //    "pageLength": 25,
         //    pagingType: "full_numbers",
         //    "language": {
         //        searchPlaceholder: "Search"
         //    }
         //});

         //$(".dataTables_filter").addClass("dataTables_filter_trn");
         //$('.ihits-table table').removeClass("dataTable no-footer");
         //$(".ihits-table table tr th").removeAttr('style')


        });
</script>
 
        <div class="ihits-table table-border hover-color odd-even mobile-responsive-table ">
            @Html.HiddenFor(m=>m.RewardsAndRecognitionList.Count)
            <table id="rewAndRecPointSumTable" class="common-table" >
                <thead>
                    <tr class="table-dark">
                        <th scope="col">ID</th>
                        <th scope="col">Employee Name</th>
                        <th scope="col">Fun.Designation</th>
                        <th scope="col">Department</th>
                        <th scope="col">Location</th>
                        <th scope="col">Total Points</th>
                    </tr>
                </thead>
        
                <tbody>
                    @if (Model.RewardsAndRecognitionList != null && Model.RewardsAndRecognitionList.Count > 0)
                    {
                        for (int i = 0; i < Model.RewardsAndRecognitionList.Count; i++)
                        {
                            <tr>
                                <td data-label="ID">@Model.RewardsAndRecognitionList[i].EmpId</td>
                                <td data-label="Employee Name">
                                    <a id="PointRewardsRecognition " class="slider-btn"
                                       onclick="onEmployeeSummaryClick('@Model.RewardsAndRecognitionList[i].EmployeeGI')">
                                        @Model.RewardsAndRecognitionList[i].EmployeeName
                                    </a>
                                </td>
                                <td data-label="Designation">@Model.RewardsAndRecognitionList[i].Designation.Name</td>
                                <td data-label="Department">@Model.RewardsAndRecognitionList[i].Department.Name</td>
                                <td data-label="Location">@Model.RewardsAndRecognitionList[i].Location.Name</td>
                                <td data-label="Total Points">@Model.RewardsAndRecognitionList[i].RewardsRequest.TotalPoints</td>


                            </tr>


                        }
                    }
                 
                </tbody>



            </table>
        </div>