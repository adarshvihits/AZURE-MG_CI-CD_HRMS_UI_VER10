@model IList<Hrms.Lite.Shared.DataBank.DTO.RewardsLog>

        <div class="ihits-table table-border hover-color odd-even mobile-responsive-table reward-recognition-entry">
            <table>
                <thead>
                    <tr class="table-dark">
                        <th scope="col">Reward</th>
                        <th scope="col">Reward Date</th>
                        <th scope="col">Recommended by</th>
                        <th scope="col">Point Criteria</th>
                        <th scope="col">Points</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        for (int i = 0; i < Model.Count; i++)
                        {
                            <tr>
                                <td data-label="Reward"> <a id="EditRewardsRecognition" class="slider-btn" onclick="onRewardLogClick('@Model[i].RewardsRequest.RewardsAndRecognitionGI')">@Model[i].RewardsRequest.Rewards.Name</a></td>
                                <td data-label="Reward Date"> @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model[i].RewardsRequest.RewardDate))         </td>
                                <td data-label="Recommended by">@Model[i].RewardsRequest.RecommendedEmpName</td>
                                <td data-label="Point Criteria">@Model[i].RewardsRequest.PointCriteria.Name</td>
                                <td data-label="Points">@Html.DisplayFor(Model => Model[i].RewardsRequest.PointCriteria.Points)</td>



                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5"> No Data Found</td></tr>
                    }
                </tbody>
            </table>
        </div>