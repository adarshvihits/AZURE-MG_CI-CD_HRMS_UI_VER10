@model Hrms.Lite.Shared.DataBank.DTO.RewardsRequest
    <script src="~/js/tooltip.js"></script>
<div id="EditRewardsRecognition"  class="slider-forms slider-forms-open rewardHistory">
    <div class="slider-inner-style">
        <div class="slider-form-close" onclick="CloseSlider('rewardHistory')"><i class="ki ki-close icon-xs text-muted"></i></div>

         <h4>Rewards & Recognition</h4>
             <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Reward</label>
                        <div class="view-details">
                        @Model.Rewards.Name
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Point Criteria</label>
                        <div class="view-details">
                            @Model.PointCriteria.Name
                        </div>
                    </div>
                </div>

            </div>
            <div class="row">

                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Points</label>
                        <div class="view-details">
                            @Model.PointCriteria.Points
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Reward Date</label>
                        <div class="view-details">
                            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.RewardDate))
                        </div>
                    </div>
                </div>

            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Recommended by</label>
                        <div class="view-details">
                            @Model.RecommendedEmpName
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Recommended For</label>
                        <div class="view-details">
                            @Model.RecommendedFor
                        </div>
                    </div>
                </div>

            </div>


            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Attach File</label>
                        @Html.HiddenFor(model => Model.File.AbsoluteUri)
                        <div class="view-details">
                            <a type="button" class="btn btn-secondary mobile-full-width"
                               onclick="showDocument('@Model.File.FileName')" data-bs-toggle="tooltip" title="" data-bs-original-title="View File">
                                <i class="icon-xl far fa-eye" data-bs-toggle="tooltip" data-bs-original-title=" View File"></i>View File
                            </a>
                        </div>
                    </div>
                </div>



              
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Remarks</label>
                        <div class="view-details">
                            @Model.Remarks
                        </div>
                    </div>
                </div>

            </div>
 
     </div>
  </div>
