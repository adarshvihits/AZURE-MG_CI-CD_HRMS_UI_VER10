@model Hrms.Lite.Shared.DataBank.DTO.RewardsAndRecognition
    <script src="~/js/tooltip.js"></script>
<div id="PointRewardsRecognition" class="slider-forms slider-forms-open  pointSummaryDT">
    <div class="slider-inner-style">
        <div class="slider-form-close" onclick="CloseSlider('pointSummaryDT')"><i class="ki ki-close icon-xs text-muted"></i></div>
        <h4 class="mb-4">Rewards & Recognition</h4>
        <div class="profile-header position-relative pb-12 mb-5"
             style="padding-bottom: 2px !important; padding-top: 5px !important;">
            <div class="row">
                @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeSliderHeader.cshtml", Model.EmployeeHeader)
            </div>
            <div class="profile-header-overflow"></div>
        </div>

        @if (Model.PointSummaryDT != null)
        {

            @for (int i = 0; i < Model.PointSummaryDT.Count; i++)
            {

                <div class="reward-section">
                    <h5><i class="fas fa-briefcase icon-md mr-2"></i>@Model.PointSummaryDT[i].Rewards.Name</h5>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Point Criteria</label>
                                <div class="view-details">
                                    @Model.PointSummaryDT[i].PointCriteria.Name
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Points</label>
                                <div class="view-details">
                                    @Model.PointSummaryDT[i].PointCriteria.Points
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Reward Date</label>
                                <div class="view-details">
                                    @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.PointSummaryDT[i].RewardDate))
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Recommended by</label>
                                <div class="view-details">
                                    @Model.PointSummaryDT[i].RecommendedEmpName
                                </div>
                            </div>
                        </div>
                    </div>



                    <div class="row">

                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Recommended For</label>
                                <div class="view-details">
                                    @Model.PointSummaryDT[i].RecommendedFor
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Attach File</label>
                                @Html.HiddenFor(Model => Model.PointSummaryDT[i].File.AbsoluteUri)
                                @Html.HiddenFor(Model => Model.PointSummaryDT[i].File.FileName)
                                <div class="view-details">
                                    <a class="btn btn-secondary mobile-full-width" onclick="showDocument('@Model.PointSummaryDT[i].File.FileName')" data-bs-toggle="tooltip" title="View File">
                                        <i class="icon-xl far fa-eye"></i>View File
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>


                    <div class="row">

                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Remarks</label>
                                <div class="view-details">
                                    @Model.PointSummaryDT[i].Remarks
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            }

        }
    </div>
</div>

