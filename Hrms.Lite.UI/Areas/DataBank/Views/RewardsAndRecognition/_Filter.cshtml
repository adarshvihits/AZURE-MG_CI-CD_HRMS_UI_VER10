                <div class="col-md-4">
                    <div class="form-group">
                        <label>Type</label>
                        <select class="form-control form-control-sm " id="exampleSelects">
                            <option>DOJ</option>
                            <option>Retirement</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4 pr-1">
                    <div class="form-group">
                        <label>From</label>
