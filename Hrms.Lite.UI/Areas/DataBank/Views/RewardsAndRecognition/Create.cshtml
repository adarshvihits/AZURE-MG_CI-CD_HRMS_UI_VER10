@model Hrms.Lite.Shared.DataBank.DTO.RewardsRequest
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/scripts/DataBank/rewardsAndRecognition.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.6.4/js/bootstrap-datepicker.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.6.4/css/bootstrap-datepicker.css" rel="stylesheet" />

<script>
    const myTimeout = setTimeout(changeFocus, 500);

    function changeFocus() {
        $('#Rewards_Code').focus();
    }

   
        $("#datepicker").datepicker({
            format: "yyyy",
        viewMode: "years",
        minViewMode: "years",
        autoclose: true
        });
</script>


@using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", enctype = "multipart/form-data", @id = "RewardsAndRecogSave" }))
{
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->
            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <h3 class="main-title">
                    Rewards & Recognition
                </h3>
                <!--end::Header Menu-->
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>
                    @*<li class="breadcrumb-item text-muted">
                            <a href="pre-enrollment.html" class="">Onboarding List</a>
                        </li>*@
                    <li class="breadcrumb-item text-muted">
                        <a href="@Url.Action("Index", "RewardsAndRecognition", new { Area = "DataBank" })" class="">
                            Rewards & Recognition List
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Rewards & Recognition

                    </li>
                </ul>
            </div>
            <!--end::Header Menu Wrapper-->

        </div>
        <!--end::Container-->
    </div>
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->
                @{
                    int tabindex = 0;
                }
                <div class="row height-100per">

                    <div class="col-md-12">
                        <div class="card card-custom height-100per">

                            <div class="card-body">
                                <div class="profile-header position-relative box-shadow-none">

                                    @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeHeader.cshtml", Model.EmployeeHeader)
                                    @Html.HiddenFor(Model => Model.EmployeeGI)



                                    <div class="profile-header-overflow"></div>
                                </div>
                                <div class="page_white mt-5">
                                    <div class="row mb-2">

                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>Reward</label><span class="Mandatory">*</span>

                                                @Html.DropDownListFor(m => m.Rewards.Code, (SelectList)ViewBag.Rewards, "Select Reward", new { @class = "form-control form-control-sm", @onchange = "onRewardChange(this,'reward')", tabindex = "@(++tabindex)" })
                                                <span id="reward"></span>
                                            </div>
                                        </div>

                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>Point Criteria</label><span class="Mandatory">*</span>
                                                @Html.DropDownListFor(m => m.PointCriteria.Code, (SelectList)ViewBag.PointCriteria, "Select Point Criteria", new { @class = "form-control form-control-sm", @onchange = "onPointCriteriaChange(this,'pointCriteria')", tabindex = "@(++tabindex)" })
                                                <span id="pointCriteria"></span>
                                            </div>
                                        </div>

                                        <div class="col-md-2">
                                            <div class="row-outer">
                                                <label class="view-title">Points</label>
                                                <div class="view-details">

                                                    <span class="Points">@Html.DisplayFor(model => Model.PointCriteria.Points)</span>
                                                </div>
                                            </div>
                                        </div>


                                        <div class="col-md-2">
                                            <label>Reward Date</label><span class="Mandatory">*</span>
                                            <div class="input-group date">

                                                @Html.TextBoxFor(m => m.RewardDate, "{0:dd/MMM/yyyy}", new { @class = "form-control kt_datepicker_8", @placeholder = "Reward Date", @readonly = "readonly", @onchange = "validate(this, 'rewardDate')", tabindex = "@(++tabindex)" })

                                                <div class="input-group-append">
                                                    <span class="input-group-text">
                                                        <i class="la la-calendar"></i>
                                                    </span>
                                                </div>

                                            </div>
                                            <span id="rewardDate"></span>
                                        </div>






                                        <div class="col-md-3">

                                            <div class="form-group">
                                                <label>Recommended By</label><span class="Mandatory">*</span>

                                                @Html.DropDownListFor(m => m.RewardRecommendedBy, (SelectList)ViewBag.RecommendedBy, "Select Recommended By", new
                                           {
                                               @class = "selectpicker sliderSearchInput form-control form-control-sm",

                                               data_show_subtext = "true",
                                               data_live_search = "true",
                                               @onchange = "validate(this,'recommendedBy')",
                                               tabindex = "@(++tabindex)"
                                           })

                                            </div>
                                            <span id="recommendedBy"></span>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>Recommended For</label><span class="Mandatory">*</span>
                                                @*<input type="text" class="form-control form-control-sm" placeholder="From Where">*@
                                                @Html.TextBoxFor(m => m.RecommendedFor, new { @class = "form-control form-control-sm", @placeholder = "Recommended For", @maxlength = "120", @onchange = "validate(this,'recommendedFor')", tabindex = "@(++tabindex)" })
                                                <span id="recommendedFor"></span>
                                            </div>
                                        </div>

                                        <div class="col-md-4">
                                            <div class="file-upload-form-group">
                                                <label for="formFileMultiple" class="form-label">Attach File</label>

                                                <div class="file-upload-form mb-1">
                                                    <div class="small-btn-group">
                                                        <button type="button" data-bs-toggle="tooltip" data-placement="top" data-bs-original-title="View Image" class="btn btn-icon btn-default" onclick="Preview()" tabindex="@(++tabindex)"><i class="icon-xl far fa-eye"></i></button>
                                                    </div>
                                                    <div data-bs-toggle="tooltip" data-bs-original-title=" Only pdf, doc, docx files
                                            are
                                            allowed , File size less than 1 MB.">
                                                        @*<input class="form-control" type="file" id="formFileMultiple" multiple>*@
                                                        @Html.TextBoxFor(model => model.File.FileData, null, new { type = "file", @class = "form-control PreviewImage", @onchange = "return CheckExtensionAndSize(this)", tabindex = "@(++tabindex)" ,title=""})
                                                    </div>
                                                </div>
                                                   
                                                </div>
                                        </div>
                                        <div class="col-md-5">
                                            <div class="form-group">
                                                <label>Remarks</label>
                                                @Html.TextBoxFor(m => m.Remarks, new { @class = "form-control form-control-sm", @placeholder = "Remarks", @maxlength = "250", tabindex = "@(++tabindex)" })
                                            </div>
                                        </div>




                                    </div>
                                    <div class="card-header flex-wrap border-0 p-0">
                                        <div class="card-title">
                                            <h6 class="mt-4">Rewards Log</h6>
                                        </div>

                                        <div class="card-toolbar">
                                            <!--begin::Dropdown-->

                                            <p class="pt-3 mb-0">
                                                Employee Achieved Points:&nbsp;&nbsp;@Model.TotalPoints<span class="EmployeeAchievedPoints"></span>
                                            </p>
                                            <!--end::Button-->
                                        </div>

                                    </div>
                                    @await Html.PartialAsync("_RewardLogList", Model.RewardsLog)

                                    <div id="RewardLogDetailsSlider">

                                    </div>

                                    <div class="row card-footer-bottom-fixed">
                                        <div class="col-md-12 align-right">
                                            <button type="button" class="btn btn-default mobile-full-width" onclick="validateRewardsRecognition()">Save</button>
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>
                    </div>
                </div>

                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->
    </div>
}