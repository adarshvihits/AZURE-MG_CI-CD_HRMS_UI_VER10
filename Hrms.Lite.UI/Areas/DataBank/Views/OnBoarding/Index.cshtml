<!-- <link href="~/css/DataTables-1.11.3/css/jquery.dataTables.min.css" rel="stylesheet" />-->
<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>
<script src="~/scripts/DataBank/onBoarding.js"></script>


<script>

    $(document).ready(function () {
        debugger
        if ('@ViewBag.RedirectigFRom'== 'FromDashBoardPre') {
            $(".tab1").addClass('active');
            $(".all").removeClass('active');
            prevTab = "tab1";
            currentTabName = 'Preenrollment Approval';
            currentTab = 1;

        }
        else if ('@ViewBag.RedirectigFRom'== 'FromDashBoardJoining')
        {
            $(".tab4").addClass('active');
            $(".all").removeClass('active');
            prevTab = "tab4";
            currentTabName = 'Joining Confirmation';
            currentTab = 4;

        }

        if ('@Model.FirstTab' == 'EmployeeActivation') {
        Tab('@Model.OnBoardingListTabs[3].Code', '@Model.OnBoardingListTabs[3].Name', 'tab3');
        $(".tab3").addClass("active");
    }
    else if ('@Model.FirstTab' == 'PreEnrollmentApproval') {
        Tab('@Model.OnBoardingListTabs[2].Code', '@Model.OnBoardingListTabs[2].Name', 'tab2');
        $(".tab2").addClass("active");
    }
    else if ('@Model.FirstTab' == 'JoiningConfirmation') {
        Tab('@Model.OnBoardingListTabs[5].Code', '@Model.OnBoardingListTabs[5].Name', 'tab5');
        $(".tab5").addClass("active");
        }
        @*else if ('@Model.FirstTab' == 'Offerletter') {

            Tab('@Model.OnBoardingListTabs[9].Code', '@Model.OnBoardingListTabs[9].Name','tab9')
        $(".tab9").addClass("active");
    }*@



        });



</script>


<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <!--begin::Header Menu-->
                <h3 class="main-title">Onboarding List</h3>
                <!--end::Header Menu-->
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot p-0 mt-1 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>


                    <li class="breadcrumb-item text-muted">
                        Onboarding List
                    </li>
                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <div class="mobile-tab-section">
                        <div class="row mb-2">
                            <div class="col-6">
                                <div class="form-group">
                                    <label>Select Type</label>
                                  
                                    @Html.DropDownListFor(m => m.TabCode, (SelectList)ViewBag.Tabs, new { @class = "form-control form-control-sm", @onchange = "Tab($('#TabCode').val(),$('#TabCode option:selected').text())" })
                                </div>
                            </div>
                        </div>
                    </div>


                    <!--begin: Search Form-->
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items">
                                <span class="btn-title all active" onclick="Tab('@Model.OnBoardingListTabs[0].Code','@Model.OnBoardingListTabs[0].Name')">
                                    @Model.OnBoardingListTabs[0].Name
                                    <span class="btn-notification AllCount">@Model.AllCount</span>
                                </span>
                            </div>
                            @if (@Model.OnBoardingListTabs[7].Name != null)
                            {
                                <div class="tab-items high">
                                    <span class="btn-title tab7" onclick="Tab('@Model.OnBoardingListTabs[7].Code','@Model.OnBoardingListTabs[7].Name')">
                                        @Model.OnBoardingListTabs[7].Name
                                        <span class="btn-notification ActiveVacancyCount">@Model.ActiveVacancyCount</span>
                                    </span>
                                </div>
                            }
                            @if (@Model.OnBoardingListTabs[1].Name != null)
                            {
                                <div class="tab-items high">
                                    <span class="btn-title tab1" onclick="Tab('@Model.OnBoardingListTabs[1].Code','@Model.OnBoardingListTabs[1].Name')">
                                        @Model.OnBoardingListTabs[1].Name
                                        <span class="btn-notification PreenrollmentPendingCount">@Model.PreenrollmentPendingCount</span>
                                    </span>
                                </div>
                            }
                            @if (@Model.OnBoardingListTabs[2].Name != null)
                            {
                                <div class="tab-items medium">
                                    <span class="btn-title tab2" onclick="Tab('@Model.OnBoardingListTabs[2].Code','@Model.OnBoardingListTabs[2].Name')">
                                        @Model.OnBoardingListTabs[2].Name
                                        <span class="btn-notification PreenrollmentAppCount">@Model.PreenrollmentAppCount</span>
                                    </span>
                                </div>
                            }
                            @if (@Model.OnBoardingListTabs[3].Name != null)
                            {
                                <div class="tab-items low">
                                    <span class="btn-title tab3" onclick="Tab('@Model.OnBoardingListTabs[3].Code','@Model.OnBoardingListTabs[3].Name')">
                                        @Model.OnBoardingListTabs[3].Name
                                        <span class="btn-notification EnrollmentCount">@Model.EnrollmentCount</span>
                                    </span>
                                </div>
                            }
                            @if (@Model.OnBoardingListTabs[4].Name != null)
                            {
                                <div class="tab-items medium">
                                    <span class="btn-title tab4" onclick="Tab('@Model.OnBoardingListTabs[4].Code','@Model.OnBoardingListTabs[4].Name')">
                                        @Model.OnBoardingListTabs[4].Name
                                        <span class="btn-notification CheckListCount">@Model.CheckListCount</span>
                                    </span>
                                </div>
                            }
                            @if (@Model.OnBoardingListTabs[5].Name != null)
                            {
                                <div class="tab-items medium">
                                    <span class="btn-title tab5" onclick="Tab('@Model.OnBoardingListTabs[5].Code','@Model.OnBoardingListTabs[5].Name')">
                                        @Model.OnBoardingListTabs[5].Name
                                        <span class="btn-notification JoiningConfCount">@Model.JoiningConfCount</span>
                                    </span>
                                </div>
                            }
                            @if (@Model.OnBoardingListTabs[6].Name != null)
                            {
                                <div class="tab-items high">
                                    <span class="btn-title tab6" onclick="Tab('@Model.OnBoardingListTabs[6].Code','@Model.OnBoardingListTabs[6].Name')">
                                        @Model.OnBoardingListTabs[6].Name
                                        <span class="btn-notification OverDueCount">@Model.OverDueCount</span>
                                    </span>
                                </div>
                            }

                            @if (@Model.OnBoardingListTabs[8].Name != null)
                            {
                                <div class="tab-items high">
                                    <span class="btn-title tab8" onclick="Tab('@Model.OnBoardingListTabs[8].Code','@Model.OnBoardingListTabs[8].Name')">
                                        @Model.OnBoardingListTabs[8].Name
                                        <span class="btn-notification documentsCount">@Model.JoiningConfCount</span>
                                    </span>
                                </div>
                            }



                            <div class="tab-items select-option">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>



                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>




                                <a class="btn btn-excel float-left export hide" data-bs-toggle="tooltip" title="Export To Excel" onclick="onExportToExcelClick()">
                                    <i class="icon-xl far fa-file-excel"></i>

                                </a>


                            </div>


                        </div>
                    </div>
                    <!-- Table Section -->
                    <div id="OnBoardingList">
                        @await Html.PartialAsync("~/Areas/DataBank/Views/OnBoarding/_OnBoardingList.cshtml", Model)
                    </div>

                    @*<div class="row row card-footer-bottom-fixed">
                        <div class="col-md-12">
                            @if (Model.UserVsMenuTab[0].Applicable == true)
                            {
                            <a href="@Url.Action("Create", "PreEnrollmentTest", new { Area = "DataBank" })" class="btn add-profile float-right">
                                <span><i class="icon-xl fas fa-user-plus"></i></span>
                                Direct Offer
                            </a>
                            }
                            else
                            { 
                                <a onclick="swal.fire(MasterPersmissionMsg)" class="btn add-profile float-right">
                                    <span><i class="icon-xl fas fa-user-plus"></i></span>
                                    Direct Offer
                                </a>
                            }
                        </div>

                    </div>*@

                    <!--end: Datatable-->
                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
                    </div>
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>

</div>
<!--end::Content-->
<!--end::Entry-->
