@model Hrms.Lite.Shared.DataBank.DTO.DocumentUpload
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/scripts/DataBank/documentUpload.js"></script>

<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>


<script>
    $(document).ready(function () {
        debugger;
        
    });
</script>
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->

        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Employee Document Folder</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Employee Document Folder
                    </li>
                </ul>
            </div>
        </div>

     
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid " id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per">

                <div class="card-body">
                    @*<div class="mobile-tab-section">
            <div class="row mb-2">
                <div class="col-6">
                    <div class="form-group">
                        <label>Select Type</label>
                        <select class="form-control form-control-sm "
                                id="TabCode"
                                onchange="TabsDropdown($('#TabCode').val(),$('#TabCode option:selected').text())">
                            <option value="0">All</option>
                            <option value="1">Update</option>
                            <option value="2">Not Update</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>*@

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items">
                                <sapn class="btn-title tab1 active" onclick="tabClick('tab1',0)">
                                    All
                                    <span class="btn-notification AllTabCount">@Model.AllTabCount</span>
                                </sapn>
                            </div>
                            <div class="tab-items high">
                                <span class="btn-title tab2" onclick="tabClick('tab2',1)">
                                    Completed
                                    @*Update*@
                                    <span class="btn-notification Tab1Count">@Model.Update</span>
                                </span>
                            </div>



                            <div class="tab-items medium">
                                <span class="btn-title tab3" onclick="tabClick('tab3',2)">
                                    Pending
                                    @*Not Update*@
                                    <span class="btn-notification Tab2Count">@Model.NotUpdate</span>
                                </span>
                            </div>




                            <div class="tab-items select-option">
                                <div class="form-group filter-combobox filterList hide">

                                    @Html.DropDownListFor(m => m.FilterCombo.Code, (SelectList)ViewBag.DocumentFilter, new { @class = "form-control form-control-sm", @onchange = "fillData()" })
                                </div>
                                <div class="sraech-slider">
                                    <div class="search-slider-inner" onclick="CursorFocusOnSearch()">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm" placeholder="ID/Name">

                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel" data-bs-original-title="Export to Excel" onclick="onExportToExcelClick()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>
                            </div>


                        </div>
                    </div>
                    <div id="docUploadList">
                        @await Html.PartialAsync("_DocumentUploadList", Model)
                    </div>



                    <!--end: Datatable-->
                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
                    </div>

                    <div class="row card-footer-bottom-fixed">

                        <div class="col-md-12 align-right">

                            <button id="dwnloadpan" type="button" onclick="DownloadPan()"
                                    class="btn btn-default float-right mobile-full-width ">
                                Download PAN
                            </button>




                        </div>

                    </div>
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
<div class="slider-over-flow"></div>
<!--end::Content-->