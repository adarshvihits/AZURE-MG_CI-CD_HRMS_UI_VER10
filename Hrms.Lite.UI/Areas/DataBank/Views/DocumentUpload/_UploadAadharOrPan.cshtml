@model Hrms.Lite.Shared.DataBank.DTO.DocumentUpload
<script src="~/js/bootstrap-datepicker.js"></script>
<script src="~/js/tooltip.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        if ('@Model.SliderTitle' != "Pan Card")
            moveCursorToEnd('NameInAadhar');
        else
            moveCursorToEnd('NameInPAN');

        maskAadhar(document.getElementById('AadharNumber'));
    });
</script>
<div id="AadharFileEdit" class="slider-forms slider-forms-open uploadAadharOrPan">
    <div class="slider-inner-style">
        <div class="slider-form-close" onclick="CloseSlider('uploadAadharOrPan')"><i class="ki ki-close icon-xs text-muted"></i></div>
        <h4>@Model.SliderTitle</h4>
        @Html.HiddenFor(m => m.EmployeeGI)
        @Html.HiddenFor(m => m.SliderTitle)
        @Html.HiddenFor(m => m.Mode)
        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <label>Name in Document</label>
                    @*<input type="text" class="form-control form-control-sm" placeholder="Name in Document">*@
                    @if (Model.SliderTitle != "Pan Card")
                    {
                        @Html.TextBoxFor(m => m.NameInAadhar, new { @class = "form-control form-control-sm", @placeholder = "Name in Document", @maxlength = 120, @onblur = "validateById('#NameInAadhar', 'NameValidation')" })

                    }
                    else
                    {
                        @Html.TextBoxFor(m => m.NameInPAN, new { @class = "form-control form-control-sm", @placeholder = "Name in Document", @maxlength = 120, @onblur = "validateById('#NameInPAN', 'NameValidation')" })

                    }
                    <span id="NameValidation"></span>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <label>Number</label>
                    @*<input type="text" class="form-control form-control-sm" placeholder="Number">*@
                    @if (Model.SliderTitle != "Pan Card")
                    {
                        @Html.HiddenFor(m => m.AadharNumber, new { id = "hdnAadhar" })
                        @Html.TextBoxFor(m => m.AadharNumber, new { @class = "form-control form-control-sm", @maxlength = 12, @placeholder = "Number", oninput = "validateAadharNew('AadharNumber','aadhar',this);", onkeypress = "return onlyNumberKey(event)", autocomplete = "off", onblur = "maskAadhar(this)" })
                        @*@Html.TextBoxFor(m => m.AadharNumber, new { @class = "form-control form-control-sm", @placeholder = "Number", @onblur = "validateAadhar(this,'aadhar')", @onkeypress = "return onlyNumberKey(event)", @maxlength = 12, @oninput = "RestrictCharacters(this)" })*@
                        <span id="aadhar"></span>
                    }
                    else
                    {
                        @Html.TextBoxFor(m => m.PANNumber, new { @class = "form-control form-control-sm", @placeholder = "Number", @onblur = "validatePan(this,'pan')", @maxlength = 10, @oninput = "validatePan(this,'pan')" })
                        <span id="pan"></span>
                    }
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label>Date Of Issue</label>
                    <div class="input-group date">
                        @*<input type="text" class="form-control" id="kt_datepicker_2" readonly="readonly"
                            placeholder="Date Of Issue">*@
                        @if (Model.SliderTitle != "Pan Card")
                        {
                            @Html.TextBoxFor(m => m.AadharIssueDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_8", @readonly = "true", @placeholder = "Date Of Issue", @onchange = "validateById('#AadharIssueDate', 'IssueDateValidation')" })
                        }
                        else
                        {
                            @Html.TextBoxFor(m => m.PANIssueDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_8", @readonly = "true", @placeholder = "Date Of Issue", @onchange = "validateById('#PANIssueDate', 'IssueDateValidation')" })
                        }
                        <div class="input-group-append">
                            <span class="input-group-text">
                                <i class="la la-calendar"></i>
                            </span>
                        </div>
                    </div>
                    <span id="IssueDateValidation"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="file-upload-form-group">
                    <label for="formFileMultiple" class="form-label">
                        Attach
                        File
                        <span class="Mandatory">*</span>
                    </label>

                    <div class="file-upload-form mb-1" data-bs-toggle="tooltip" data-bs-original-title=" Only pdf, jpg, jpeg, png and bmp formats are allowed , File size less than 1 MB.">
                        <div class="small-btn-group">

                            <button type="button" data-bs-toggle="tooltip" data-placement="top" data-bs-original-title="View Image" class="btn btn-icon btn-default"><i class="icon-xl far fa-eye"></i></button>

                        </div>
                        @Html.HiddenFor(m => m.File.fdata)
                        @Html.TextBoxFor(m => m.File.FileData, new { @type = "file", @name = "profile_avatar", @accept = ".png, .jpg, .jpeg, .pdf", @onchange = "CheckImageExtensionSize(this)", @title = "" })

                    </div>


                </div>
            </div>

        </div>


        <div class="row card-footer-bottom-fixed border-none">

            <div class="col-md-12 float-right-btn">
                @if (Model.SliderTitle == "Pan Card")
                {
                    <a data-bs-toggle="tooltip" title="" data-bs-original-title="View" class="btn btn-icon btn-view" onclick="displayDoc('IDENTITY','Pan')"><i class="icon-xl far fa-eye"></i></a>

                }
                else
                { <a data-bs-toggle="tooltip" title="" data-bs-original-title="View" class="btn btn-icon btn-view" onclick="displayDoc('IDENTITY','Aadhar')"><i class="icon-xl far fa-eye"></i></a>

                }
                <a data-bs-toggle="tooltip" data-bs-original-title="Delete" class="btn btn-icon btn-delete" onclick="DeleteIdentityDocuments()"><i class="icon-xl far fa-trash-alt"></i></a>
                <button type="button" class="btn btn-default " onclick="validateAadharOrPan()">Modify</button>
            </div>
        </div>
    </div>
</div>
}