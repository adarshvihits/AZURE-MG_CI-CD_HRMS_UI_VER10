@model Hrms.Lite.Shared.DataBank.DTO.HRPlanningBudget
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/scripts/DataBank/hrPlanningBudget.js"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>
<script src="~/js/settings.js"></script>
@using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "budgetApprove" }))
{

    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->
            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">
                        Budget Approval
                    </h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>
                        <li class="breadcrumb-item text-muted">
                            <a href="@Url.Action("Index", "HRPlanningBudgetApproval", new { Area = "Databank" })"> Budget Approval Pending List</a>
                        </li>
                        <li class="breadcrumb-item text-muted">
                            Budget Approval

                        </li>

                    </ul>
                </div>
            </div>
            <!--end::Header Menu Wrapper-->
            <!--begin::Topbar-->
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->


    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        @Html.HiddenFor(m => m.HRPlanning.Code)
        @Html.HiddenFor(m => m.Designation.Code)
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->

                <div class="row height-100per">

                    <div class="col-md-12">
                        <div class="card card-custom height-100per">
                            <div class="card-body">
                                <div class="row tab-style-button">
                                    <div class="tab-button-wrap">
                                        <div class="tab-items">

                                            <div class="row-outer pb-2">
                                                <label class="view-title">
                                                    Planning Period
                                                </label>
                                                <div class="view-details">@Html.DisplayFor(m => m.HRPlanning.Name)</div>

                                            </div>
                                        </div>
                                        <div class="tab-items">

                                            <div class="row-outer pb-2">
                                                <label class="view-title">
                                                    Designation

                                                </label>
                                                <div class="view-details">@Html.DisplayFor(m => m.Designation.Name)</div>

                                            </div>
                                        </div>
                                        <div class="tab-items select-option pb-2">
                                            <div class="sraech-slider">
                                                <div class="search-slider-inner">
                                                    <i class="fa fa-search"></i>
                                                </div>
                                                <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                                       placeholder="ID/Name">
                                            </div>
                                            <button data-bs-toggle="tooltip" title="Export to Excel"
                                                    class="btn btn-excel">
                                                <i class="icon-xl far fa-file-excel"></i>
                                            </button>
                                        </div>


                                    </div>
                                </div>



                                <div class="ihits-table table-border hover-color odd-even mobile-responsive-table Approval-screen">
                                    <table class="common-table">
                                        <thead>
                                            <tr class="table-dark">
                                                <th scope="col">
                                                    Location
                                                </th>
                                                <th scope="col">
                                                    Region
                                                </th>
                                                <th scope="col" data-bs-toggle="tooltip" title="Budgeted  Numbers">
                                                    Budgtd Nos
                                                </th>
                                                <th scope="col" data-bs-toggle="tooltip" title="Current  Numbers">
                                                    Cur. Nos
                                                </th>
                                                <th scope="col" data-bs-toggle="tooltip" title="Variance  ">
                                                    Var.
                                                </th>
                                                <th scope="col" data-bs-toggle="tooltip" title="Variance Percentage  ">
                                                    Var. %
                                                </th>
                                                <th scope="col">
                                                    Filled %
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.Details != null && Model.Details.Count > 0)
                                            {

                                                for (int i = 0; i < Model.Details.Count; i++)
                                                {
                                                    <tr>
                                                        <td data-label="Location">@Html.DisplayFor(m => m.Details[i].Location.Name)</td>
                                                        <td data-label="Region">@Html.DisplayFor(m => m.Details[i].Region.Name)</td>
                                                        <td data-label="Budgeted Nos">@Html.DisplayFor(m => m.Details[i].BudgetedNo)</td>
                                                        <td data-label="Current Nos.">@Html.DisplayFor(m => m.Details[i].CurrentNo)</td>
                                                        <td data-label="Variance Nos.">@Html.DisplayFor(m => m.Details[i].VarianceNo)</td>
                                                        <td data-label="Variance %">@Html.DisplayFor(m => m.Details[i].VariancePerce)</td>
                                                        <td data-label="Filled  %">@Html.DisplayFor(m => m.Details[i].FilledPerce)</td>
                                                    </tr>
                                                }
                                            }

                                        </tbody>
                                    </table>
                                </div>

                                <div class="row card-footer-bottom-fixed">

                                    <div class="col-md-12 align-right">
                                        <button type="button"
                                                class="btn btn-danger mobile-full-width mr-3" onclick="onApproveClick('REJECT')">
                                            Reject
                                        </button>
                                        <button type="button"
                                                class="btn btn-default float-right mobile-full-width" onclick="onApproveClick('APPROVE')">
                                            Approve
                                        </button>

                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>
                </div>




                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->
    </div>
    <!--end::Content-->
}
