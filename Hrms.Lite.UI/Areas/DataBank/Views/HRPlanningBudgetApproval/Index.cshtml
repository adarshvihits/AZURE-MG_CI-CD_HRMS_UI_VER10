@model Hrms.Lite.Shared.DataBank.DTO.HRPlanningBudget
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>
<script src="~/js/settings.js"></script>
<script src="~/scripts/DataBank/hrPlanningBudget.js"></script>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Budget Approval Pending List
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Budget Approval Pending List

                    </li>

                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->


<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body">

                            <div class="row tab-style-button mb-2">
                                <div class="tab-button-wrap">

                                    <div class="tab-items select-option mb-2">

                                        <div class="sraech-slider">
                                            <div class="search-slider-inner">
                                                <i class="fa fa-search"></i>
                                            </div>
                                            <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                                   placeholder="ID/Name">
                                        </div>
                                        <button data-bs-toggle="tooltip" title="Export to Excel"
                                                class="btn btn-excel">
                                            <i class="icon-xl far fa-file-excel"></i>
                                        </button>

                                    </div>


                                </div>
                            </div>



                            <div class="ihits-table table-border hover-color odd-even mobile-responsive-table budget-approval">
                                <table class="common-table">
                                    <thead>
                                        <tr class="table-dark">

                                            <th scope="col">
                                                Planning Period
                                            </th>
                                            <th scope="col">
                                                Designation
                                            </th>
                                            <th scope="col" data-bs-toggle="tooltip" title="Total Budgeted Numbers">
                                                Budgtd Nos.
                                            </th>
                                            <th scope="col" data-bs-toggle="tooltip" title="Current  Numbers">
                                                Cur. Nos
                                            </th>
                                            <th scope="col" data-bs-toggle="tooltip" title="Variance">
                                                Var.
                                            </th>
                                            <th scope="col">
                                                Approve
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.MainList != null && Model.MainList.Count > 0)
                                        {

                                            for (int i = 0; i < Model.MainList.Count; i++)
                                            {
                                        <tr>
                                            <td data-label="Planning Period">@Model.MainList[i].HRPlanning.Name</td>
                                            <td data-label="Designation">@Model.MainList[i].Designation.Name</td>
                                            <td data-label="Budgtd Nos">@Model.MainList[i].TotalBudgetedNo</td>
                                            <td data-label="Cur. Nos">@Model.MainList[i].TotalCurrentNo</td>
                                            <td data-label="Var.">@Model.MainList[i].TotalVariance</td>
                                            <td data-label="Approve">
                                                <a data-bs-toggle="tooltip" title="Approve" href="@Url.Action("GetApprovalDetails", "HRPlanningBudgetApproval" ,
                                                      new { Area="DataBank", HRPlanningCode=Model.MainList[i].HRPlanning.Code,DesignationCode=Model.MainList[i].Designation.Code})"
                                                   type="button"
                                                   class="btn btn-icon btn-tick icon-only">
                                                    <i class="icon-xl far fa-check-circle"></i>
                                                </a>
                                            </td>
                                        </tr>
                                            }
                                        }


                                    </tbody>
                                </table>
                            </div>
                            <!-- <end table></end> -->

                        </div>

                    </div>
                </div>
            </div>




            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>
<!--end::Content-->
