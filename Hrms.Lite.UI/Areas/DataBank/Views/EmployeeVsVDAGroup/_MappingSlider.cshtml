@model Hrms.Lite.Shared.Master.VDAGroup
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "VDABatchSave" }))
{
    <div id="EditAssetAllocation" class="slider-forms slider-forms-open batch-save">
        <div class="slider-inner-style  new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('batch-save')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>
                    Employee V/s VDA Group
                </h4>
               
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-12">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Employee Vs VDA Group</label>
                                    @Html.DropDownListFor(m => m.VDAGroupCode, (SelectList)ViewBag.VDAGroup, "--Select VDA Group--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'vdagroup')" })
                                    <span id="vdagroup"></span>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <div class="row card-footer-bottom-fixed">

                <div class="view-details align-right col-md-12">

                    <a type="button" onclick="onUpdateClick('batchupdate')"
                       class="btn btn-default  mobile-full-width">
                        Update
                    </a>
                </div>



            </div>
        </div>

    </div>
  
}
