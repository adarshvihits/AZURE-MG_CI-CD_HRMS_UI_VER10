@model Hrms.Lite.Shared.DataBank.DTO.EmployeeProfile
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Account.Login CurrentUser = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Account.Login>(Context.Session.GetString("User"));
}
<h5><i class="fas fa-briefcase icon-md mr-2"></i>Attendance</h5>

<div class="row">
    <div class="col-md-12">
        <div class="ihits-table table-border mobile-responsive-table attendance-tab-table mb-5">
            <table>
                <thead>
                    <tr class="table-light">
                        <th scope="col">Month</th>
                        <th scope="col">Total Days</th>
                        <th scope="col">Present Days</th>
                        <th scope="col">Holidays</th>
                        <th scope="col">LOP Days</th>
                        <th scope="col">Leave</th>
                        <th scope="col">Attendance %</th>
                        @*<th scope="col">View</th>*@

                    </tr>
                </thead>
                <tbody>
                    @if (Model.Attendance != null && Model.Attendance.Count > 0)
                    {

                        for (int i = 0; i < Model.Attendance.Count; i++)
                        {
                            <tr>
                                <td data-label="Month">
                                    <label>@Model.Attendance[i].Month</label>

                                </td>
                                <td data-label="Total Days">
                                    <label>@Model.Attendance[i].TOTALDAYS</label>

                                </td>
                                <td data-label="Present Days">
                                    <label>@Model.Attendance[i].PRESENTDAYS</label>

                                </td>
                                <td data-label="Holidays">
                                    <label>@Model.Attendance[i].HOLIDAYS</label>
                                </td>
                                <td data-label="LOP Days">
                                    <label>@Model.Attendance[i].LOP</label>
                                </td>
                                <td data-label="Leave">
                                    <label>@Model.Attendance[i].LEAVE</label>
                                </td>
                                <td data-label="Attendance %">
                                    <label>@Model.Attendance[i].ATT_PERCENTAGE</label>
                                </td>
                                @*<td data-label="View">
                                    <div class="small-btn-group">
                                        <button type="button" data-bs-toggle="tooltip" data-placement="top" data-bs-original-title="View Attendance Card" class="btn btn-icon "><i class="icon-xl far fa-eye black"></i></button>
                                    </div>
                                </td>*@



                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5"> No Data Found</td></tr>
                    }





                </tbody>
            </table>
        </div>
    </div>
</div>



@if (CurrentUser.authUser.SalaryVisibility != 0)
{
    <h5><i class="fas fa-briefcase icon-md mr-2"></i>Salary</h5>
    <div class="row">
        <div class="col-md-12">
            <div class="ihits-table table-border mobile-responsive-table personal-details-previous-employment ">
                <table>
                    <thead>
                        <tr class="table-light">
                            <th scope="col">Salary Period</th>
                            <th scope="col">Gross Pay</th>
                            <th scope="col">Gross Deduction</th>
                            <th scope="col">Net Pay</th>
                            <th scope="col">LOP Amount</th>
                            @*<th scope="col">View</th>*@
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Salary != null && Model.Salary.Count > 0)
                        {

                            for (int i = 0; i < Model.Salary.Count; i++)
                            {
                                <tr>
                                    <td data-label="Salary Period">
                                        <label>@Model.Salary[i].SalaryPeriod</label>
                                    </td>
                                    <td data-label="Gross Pay">
                                        <label>@Model.Salary[i].GrossPay</label>

                                    </td>
                                    <td data-label="Gross Deduction">
                                        <label>@Model.Salary[i].GrossDeduction</label>

                                    </td>
                                    <td data-label="Net Pay">
                                        <label>@Model.Salary[i].NetPay</label>

                                    </td>
                                    <td data-label="LOP Amount">
                                        <label>@Model.Salary[i].LOPAmount</label>

                                    </td>
                                    @*<td data-label="View">
                                        <button type="button" data-bs-toggle="tooltip" data-placement="top" data-bs-original-title="View Payslip" class="btn btn-icon"><i class="icon-xl far fa-eye black"></i></button>

                                    </td>*@


                                </tr>


                            }
                        }
                        else
                        {
                            <tr><td colspan="5"> No Data Found</td></tr>
                        }



                    </tbody>
                </table>
            </div>
        </div>
    </div>
}