<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        @Html.HiddenFor(Model => Model.DocumentUpload.AadharNumber)
        @Html.HiddenFor(Model => Model.DocumentUpload.PANNumber)
        @Html.HiddenFor(Model => Model.Statutory_Payment_Details.AccountNo)
        @Html.HiddenFor(Model => Model.Job_Details.CategoryTypeCode)
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Employee Profile</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item">
                        @*<a href="Index.html"> Employee Profile List</a>*@
                        @if (Model.Breadcrumb == "EmployeeProfile")
                        {
                            <a href="@Url.Action("Index", Model.Breadcrumb, new { Area = "DataBank" })" class="">@Model.BreadcrumbName</a>
                        }
                        @*else if(Model.Breadcrumb=="BloodBankReport")
                            {
                                <a href="@Url.Action("GetBloodBankReportList", Model.Breadcrumb, new { Area = "DataBank" })" class="">@Model.BreadcrumbName</a>
                            }*@
                        else
                        {
                            <a href="@Url.Action(Model.Breadcrumb+"List", Model.Breadcrumb, new { Area = "DataBank" })" class="">@Model.BreadcrumbName</a>
                        }

                    </li>
                    <li class="breadcrumb-item">
                        Employee Profile
                    </li>

                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
