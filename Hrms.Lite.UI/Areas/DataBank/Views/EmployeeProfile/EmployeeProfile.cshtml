                                        <div class="employee-manager-detils-content">

                                            <span><b>@Model.SkipLevelMGR.Name</b></span>
                                            <span data-bs-toggle="tooltip" data-bs-original-title="Fun.Designation">@Model.SkipLevelMGR.FunDesignation</span>
                                        </div>

                                    </div>
                                </div>

                            </div>


                        </div>


                    </div>




