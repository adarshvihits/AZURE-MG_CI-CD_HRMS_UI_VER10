                                        <div class="col-lg-12 col-xl-6">
                                            <span><img src="~/images/icons/icon_five.svg" class="tab_icons" /><div data-bs-toggle="tooltip" data-bs-original-title="Renewal Date">@Model.Job_Details.RenewalDate</div></span>
                                        </div>
                                    }

                                    <div class="col-lg-12 col-xl-6">
