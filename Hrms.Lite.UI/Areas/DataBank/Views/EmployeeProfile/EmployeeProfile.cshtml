                                                    </div>
                                                    @*@if (Model.EmployeeHeader.LWD != "")
                                                        {
                                                            <a data-bs-toggle="tooltip" data-bs-original-title="Last Working Day" class="header-profile-email mr-4 mb-lg-0 mb-2">
                                                                <i class="fas fa-network-wired icon-nm mr-2"></i>@Model.EmployeeHeader.LWD
                                                            </a>
                                                        }*@
                                                    @*@if (Model.EmployeeHeader.ReportingManager != null)
                                                        {*@
                                                    <!--<a data-bs-toggle="tooltip" data-bs-original-title="Reporting Manager" class="header-profile-email mr-4 mb-lg-0 mb-2">
                                                    <i class="fas fa-user-tie icon-nm mr-2"></i>
                                                    @Model.ReportingManeger-->
                                                    @*@Model.EmployeeHeader.ReportingManager*@
                                                    <!--</a>-->
                                                    @*}*@


                                                </div>



                                            </div>


                                        </div>

                                    </div>

                                </div>







                            </div>
                        </div>



                        @*<div class="profile-header-overflow"></div>*@
                    </div>
                    <div class="card card-custom mb-5 height-100per " style="background-color: transparent !important; height: 100%; ">

                        <div class="card-body new_employe_cls p-5" style="border-radius:5px;">

                            <div class="">

                                <div class="row employee-outer-detils ">
                                    <div class="col-lg-12 col-xl-6">


                                        <span><img src="~/images/icons/icon_one.svg" class="tab_icons" /><div data-bs-toggle="tooltip" data-bs-original-title="Official Mobile"> @Model.Address.PresentAddress.MobileNo</div> </span>
                                    </div>
                                    <div class="col-lg-12 col-xl-6">
                                        <span><img src="~/images/icons/icon_six.svg" class="tab_icons" /><div data-bs-toggle="tooltip" data-bs-original-title="Employee ID">@Model.EmployeeHeader.EmployeeId</div></span>
                                    </div>
                                </div>
                                <div class="row employee-outer-detils ">
                                    <div class="col-lg-12 col-xl-6">


                                        <span><img src="~/images/icons/icon_three.svg" class="tab_icons" /><div data-bs-toggle="tooltip" data-bs-original-title="Date Of Joining">  @Model.DOJ</div></span>
                                    </div>
                                    <div class="col-lg-12 col-xl-6">
