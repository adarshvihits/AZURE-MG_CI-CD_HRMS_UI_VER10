                                    </div>

                                </div>

                                <div class="row employee-outer-detils ">
                                    <div class="col-lg-12 col-xl-6">
                                        <span><img src="~/images/icons/icon_five.svg" class="tab_icons" /><div data-bs-toggle="tooltip" data-bs-original-title="Designation">@Model.Job_Details.Grade.Name</div></span>
                                    </div>

                                    <div class="col-lg-12 col-xl-6">
                                        <span><img src="~/images/icons/icon_eight.svg" class="tab_icons" /><div data-bs-toggle="tooltip" data-bs-original-title="Fun.Designation">@Model.EmployeeHeader.Designation.Name</div></span>
                                    </div>

                                </div>

                                <div class="row employee-outer-detils ">
                                    <div class="col-lg-12 col-xl-6">

                                        <span><img src="~/images/icons/icon_nine.svg" class="tab_icons" /><div data-bs-toggle="tooltip" data-bs-original-title="Department">@Model.EmployeeHeader.Department.Name</div></span>
                                    </div>

                                    <div class="col-lg-12 col-xl-6">
                                        <span><img src="~/images/icons/icon_ten.svg" class="tab_icons" /><div data-bs-toggle="tooltip" data-bs-original-title="Location">@Model.EmployeeHeader.Location.Name</div></span>
                                    </div>




                                </div>

                                <div class="row employee-outer-detils ">

