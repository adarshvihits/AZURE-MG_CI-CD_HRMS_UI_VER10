@model Hrms.Lite.Shared.DataBank.DTO.EmployeeProfile

    <script src="~/js/tooltip.js"></script>
    <!-- Table Section -->

    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table employee-profile-resigned-list">
        @Html.HiddenFor(m =>m.EmployeeProfileList.Count)
        <table id="Resignedtable" class="common-table">
            <thead>
                <tr class="table-dark">
                    <th scope="col">ID / Name</th>
                    <th scope="col">Fun.Designation</th>
                    <th scope="col">Department</th>
                    <th scope="col">Location</th>
                    <th scope="col">Category</th>
                    <th scope="col">DOB</th>
                    <th data-bs-toggle="tooltip" data-bs-original-title="Age" scope="col">Age</th>
                    <th scope="col">DOJ</th>
                    <th data-bs-toggle="tooltip" data-bs-original-title="Last Working Day" scope="col">LWD</th>
                    <th data-bs-toggle="tooltip" data-bs-original-title="Years of Experience" scope="col">Y/S</th>
                    <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Gross Pay">GP</th>
                    <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Cost To Company">CTC</th>
                </tr>
            </thead>
            <tbody>
              
            </tbody>
        </table>
    </div>
    <!-- Table Setion End -->