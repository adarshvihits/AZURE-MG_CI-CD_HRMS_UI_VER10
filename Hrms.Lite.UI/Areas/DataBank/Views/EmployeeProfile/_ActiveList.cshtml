@model Hrms.Lite.Shared.DataBank.DTO.EmployeeProfile
@*  <script src="~/js/settings.js"></script>*@

@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Account.Login CurrentUser = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Account.Login>(Context.Session.GetString("User"));
}
<script>
    $(document).ready(function () {

        $('.ActiveCount').html("@Model.ActiveCount");
        $('.ResignedCount').html("@Model.ResignedCount");
    });
</script>

<script>
    $(document).ready(function () {
        salVisible = @CurrentUser.authUser.SalaryVisibility;
        fillData();
    });
</script>



<div class="ihits-table table-border hover-color odd-even mobile-responsive-table employee-profile-activelist">
    @Html.HiddenFor(m => m.EmployeeProfileList.Count)
    <table id="ActiveListtable" class="common-table">
        <thead>
            <tr class="table-dark">

                <th scope="col">ID / Name</th>
                <th scope="col">Designation</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">Category</th>
                <th scope="col" data-bs-toggle="tooltip" title="    Date Of Birth">DOB</th>
                <th data-bs-toggle="tooltip" data-bs-original-title="Age" scope="col">Age</th>
                <th scope="col" data-bs-toggle="tooltip" title="Date Of Join">DOJ</th>

                <th data-bs-toggle="tooltip" data-bs-original-title="Years of Experience" scope="col">Y/S</th>

                <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Gross Pay">GP</th>

                <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Cost To Company">CTC</th>

            </tr>

            
        </thead>

    </table>
</div>
<!-- Table Setion End -->