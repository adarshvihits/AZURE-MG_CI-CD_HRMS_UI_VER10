@model Hrms.Lite.Shared.DataBank.DTO.UHID
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/DataBank/UHID.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        $('#Type').prop('checked', true)
       // GetEmpList();
    });
</script>
<style>
    .popup {
        margin: 6% auto;
        /* padding: 10px; */
    }
</style>
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->

        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">UHID</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        UHID
                    </li>
                </ul>
            </div>
        </div>


    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid " id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per">

                <div class="card-body">
                    @*<div class="mobile-tab-section">
                            <div class="row mb-2">
                                <div class="col-6">
                                    <div class="form-group">
                                        <label>Select Type</label>
                                        <select class="form-control form-control-sm "
                                                id="TabCode"
                                                onchange="TabsDropdown($('#TabCode').val(),$('#TabCode option:selected').text())">
                                            <option value="0">All</option>
                                            <option value="1">Update</option>
                                            <option value="2">Not Update</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>*@

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">

                            <div class="tab-items d-flex align-items-center">


                                <!-- Radio Buttons -->
                                <div class="radio-inline d-flex align-items-center">
                                    <label class="radio radio-outline radio-success me-3">
                                        @Html.RadioButtonFor(m => m.Type, "ACTIVE", new { @onchange = "GetEmpList()" })
                                        <span></span>Active
                                    </label>
                                    <label class="radio radio-outline radio-success">
                                        @Html.RadioButtonFor(m => m.Type, "RESIGNED", new { @onchange = "GetEmpList()" })
                                        <span></span>Resigned
                                    </label>
                                </div>

                            </div>



                            <div class="tab-items select-option">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner" onclick="CursorFocusOnSearch()">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm" placeholder="ID/Name">

                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel" data-bs-original-title="Export to Excel" onclick="onExportToExcelClick()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>
                            </div>


                        </div>
                    </div>
                    <div id="docUploadList">
                        @await Html.PartialAsync("_List", Model)
                    </div>
                    <div id="filterSlider">
                            @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.filter)
                        </div>


                    <!--end: Datatable-->

                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>


<div class="modal fade bd-example-modal-lg" id="UHID_Popup" tabindex="-1" aria-labelledby="myLargeModalLabel" style="display: none;" aria-hidden="true">
    <div class="modal-dialog modal-lg" style="max-width:1000px;">
        <div class="modal-content popup">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">UHID Details</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body pt-0">


            </div>

            <div class="modal-footer border-0 p-0">
                <div class="row">

                    <div class="col-md-12 align-right">
                        <button type="button" class="btn btn-default  mobile-full-width" onclick="UHIDSave()">
                            Save
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

