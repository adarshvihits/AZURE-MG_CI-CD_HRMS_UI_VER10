@model Hrms.Lite.Shared.DataBank.DTO.PositionManager

@using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "popupFilter" }))
{
    <div id="filterForm" class="slider-forms basicFilter">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close"><i class="ki ki-close icon-xs text-muted" onclick="CloseSlider('basicFilter')"></i></div>

            <div class="location-slider">
                <h4>Basic Filter</h4>
            </div>

            <div class="add-padding">
                <div class="filter-slider-item-box">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Branch</label>
                                @Html.DropDownListFor(m => m.Filter.Basic_Filter.Location.Code, (SelectList)Model.Filter.Basic_Filter.Location.DropdownData, "All", new { @class = "form-control form-control-sm reset" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Department</label>
                                @Html.DropDownListFor(m => m.Filter.Basic_Filter.Department.Code, (SelectList)Model.Filter.Basic_Filter.Department.DropdownData, "All", new { @class = "form-control form-control-sm reset" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Section</label>
                                @Html.DropDownListFor(m => m.Filter.Optional_Filter.Section.Code, (SelectList)Model.Filter.Optional_Filter.Section.DropdownData, "All", new { @class = "form-control form-control-sm reset" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Grade</label>
                                @Html.DropDownListFor(m => m.Filter.Basic_Filter.Grade.Code, (SelectList)Model.Filter.Basic_Filter.Grade.DropdownData, "All", new { @class = "form-control form-control-sm reset" })
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12 align-right">
                        <button type="button" class="btn btn-secondary  mobile-full-width" onclick="onResetFilter()">
                            Reset
                        </button>
                        <button type="button" class="btn btn-default  mobile-full-width" onclick="onApplyFilter()">
                            Apply
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
