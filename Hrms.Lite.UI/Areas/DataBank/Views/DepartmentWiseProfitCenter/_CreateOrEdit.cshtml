@model Hrms.Lite.Shared.DataBank.DepartmentWiseProfitCenter


<script>

    $(document).ready(function () {
        debugger;
        var count = $('#ProfitCenterTable').val();
        var tableData = document.getElementById("ProfitCenterTable");
        var Tablerows = tableData.getElementsByTagName("tr");

        for (var k = 0; k < (Tablerows.length); k++) {

            if ($('#DepartmentWiseProfitCenterList_' + k + '__Applicability').is(':checked') == false) {
                $('#DepartmentWiseProfitCenterList_' + k + '__Percentage').attr("disabled", true);
            }
            else {
                $('#DepartmentWiseProfitCenterList_' + k + '__Percentage').attr("disabled", false);
            }
        }
    });


</script>>

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "ProfitCenterSave" }))
{

    <div id="" class="slider-forms slider-forms-open AddNewOrEdit">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddNewOrEdit')"><i class="ki ki-close icon-xs text-muted"></i></div>
            <div class="location-slider">

                <h4 class="mb-4">Employee Wise Profit Center</h4>
            </div>




            <div class="add-padding">

                <div class="row">

                    <div class="ihits-table tab=le-border w-100 hover-color odd-even vertical-scroll-150">
                        @Html.HiddenFor(m => Model.DepartmentCode)
                        <table id="ProfitCenterTable">
                            <thead>
                                <tr class="table-light">
                                    <th scope="col" style="width:50%;">Profit Center</th>
                                    <th scope="col">Applicability</th>
                                    <th scope="col">%</th>

                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.DepartmentWiseProfitCenterList != null && Model.DepartmentWiseProfitCenterList.Count > 0)
                                {

                                    for (int i = 0; i < Model.DepartmentWiseProfitCenterList.Count; i++)
                                    {
                                        <tr>
                                            <td data-label="Particular" style="width:50%;">
                                                @Html.HiddenFor(m => m.DepartmentWiseProfitCenterList[i].ProfitCenterCode)

                                                @Model.DepartmentWiseProfitCenterList[i].ProfitCenter
                                            </td>
                                            <td data-label="Applicability">
                                                <div class="checkbox-inline justify-content-center">
                                                    <label class="checkbox checkbox-outline checkbox-success">

                                                        @Html.CheckBoxFor(m => m.DepartmentWiseProfitCenterList[i].Applicability, new { @class = "applCheckbox", @onclick = "checkBoxChange(" + i + ")" })
                                                        <span></span>
                                                    </label>
                                                </div>
                                            </td>
                                            <td data-label="%">

                                                @Html.TextBoxFor(m => m.DepartmentWiseProfitCenterList[i].Percentage, new
                                                {
                                                    @class = "form-control form-control-sm",
                                                    @placeholder = "",
                                               onkeypress = "return isNumberKey(event)"
                                                })
                                            </td>
                                        </tr>
                                    }
                                }


                            </tbody>

                        </table>
                    </div>
                </div>
            </div>





            <div class="row card-footer-bottom-fixed ">

                <div class="col-md-12 align-right">

                    <button type="button" class="btn btn-default mobile-full-width" onclick="Save('Save')">
                        Save
                    </button>


                </div>


            </div>




        </div>
    </div>

}


<style>

    .ihits-table.vertical-scroll-150 tbody {
        height: 300px !important;
    }

    .table-light > th {
        padding: 6px !important;
    }

    #CostCenterTable td .form-control {
        height: 25px !important;
    }
</style>
