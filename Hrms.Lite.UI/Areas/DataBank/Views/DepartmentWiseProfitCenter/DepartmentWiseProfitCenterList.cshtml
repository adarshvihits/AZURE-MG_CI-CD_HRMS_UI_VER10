
@model Hrms.Lite.Shared.DataBank.DepartmentWiseProfitCenter
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>




<div class="ihits-table table-border hover-color odd-even mobile-responsive-table departmentvshead_list ">
    @Html.HiddenFor(m => m.DepartmentWiseProfitCenterList.Count)
    <table id="GrievanceTable" class="common-table">
        <thead>
            <tr class="table-dark">

                <th scope="col">Sl. No</th>
                <th scope="col">Department Name</th>
                <th scope="col">Profit Center</th>
                <th scope="col">Edit</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.DepartmentWiseProfitCenterList != null && Model.DepartmentWiseProfitCenterList.Count > 0)
            {

                for (int i = 0; i < Model.DepartmentWiseProfitCenterList.Count; i++)
                {
            <tr>
                @Html.HiddenFor(m => Model.DepartmentWiseProfitCenterList[i].DepartmentCode)

                <td data-label="Sl. No">@Model.DepartmentWiseProfitCenterList[i].SlNo</td>
                <td data-label="Department Name">@Model.DepartmentWiseProfitCenterList[i].DepartmentName</td>

                <td data-label="Profit Center">@Model.DepartmentWiseProfitCenterList[i].ProfitCenter</td>


                <td>
                    <span id="edit_@i" class="">
                        <a data-bs-toggle="tooltip" title="" type="button" class="btn btn-icon btn-edit icon-only" data-bs-original-title="Edit" onclick="onEditClk(@i,'@Model.DepartmentWiseProfitCenterList[i].DepartmentCode')">
                            <i class="icon-xl fas fa-pencil-alt"></i>
                        </a>
                    </span>
                
                </td>
            </tr>
                }
            }

        </tbody>
    </table>
</div>

