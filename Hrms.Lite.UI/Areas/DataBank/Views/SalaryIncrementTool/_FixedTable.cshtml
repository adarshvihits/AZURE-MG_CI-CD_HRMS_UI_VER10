<script src="~/js/custom.js"></script>

@model Hrms.Lite.Shared.DataBank.Generic.SalaryIncrementTool
    <script>
        $(document).ready(function () {
        
            $(".FixedAppl").attr('checked', 'true');
      
        });
    </script>
    <div class="ihits-table table-border hover-color odd-even vertical-scroll-130 mobile-responsive-table SalaryIncrementTool-table-allowance ">
        @Html.HiddenFor(m => m.FixedList.Count)
        <table class="common-table ">


            <thead>
                <tr class="table-dark">
                    <th class="Header">
                        Name
                    </th>
                    <th class="Header">
                        Applicability
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (Model.FixedList != null && Model.FixedList.Count > 0)
                {

                    for (int i = 0; i < Model.FixedList.Count; i++)
                    {
                        <tr>
                            @Html.HiddenFor(model => Model.FixedList[i].Code)

                            <td class="">@Model.FixedList[i].Heading</td>

                            <td class="">@Html.CheckBoxFor(modelItem => Model.FixedList[i].Applicable, new { @onclick = "onApplicabilityClick()" , @class="FixedAppl",@disabled=true})</td>

                        </tr>
                    }
                }
            </tbody>

        </table>
    </div>