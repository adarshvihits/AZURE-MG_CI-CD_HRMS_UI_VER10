<script src="~/js/custom.js"></script>

@model Hrms.Lite.Shared.DataBank.Generic.SalaryIncrementTool
<div class="ihits-table table-border hover-color  odd-even mobile-responsive-table  SalaryIncrementTool-table-allowance vertical-scroll-200">

    @Html.HiddenFor(m => m.AllowanceList.Count)
    <table class="common-table ">
        <thead>
            <tr class="table-dark">
                <th class="Header">
                    Name
                </th>
                <th class="Header">
                    Applicability
                </th>
            </tr>
        </thead>
        <tbody>

            @if (Model.AllowanceList != null && Model.AllowanceList.Count > 0)
            {

                for (int i = 0; i < Model.AllowanceList.Count; i++)
                {

            <tr>
              
                <td class="">
                    @Model.AllowanceList[i].Heading
                                @Html.HiddenFor(model => Model.AllowanceList[i].AllowanceCode)
                                @Html.HiddenFor(model => Model.AllowanceList[i].Heading)
                                @Html.HiddenFor(model => Model.AllowanceList[i].Order)
                                @Html.HiddenFor(model => Model.AllowanceList[i].Type)
                            </td>

                <td class=""> @Html.CheckBoxFor(modelItem => Model.AllowanceList[i].Applicable, new { @onclick = "onClassificationApplicabilityClick(" + i + ",'ALW')" })</td>

            </tr>
                }
            }

        </tbody>

    </table>
</div>
