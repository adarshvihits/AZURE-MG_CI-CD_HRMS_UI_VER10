@model Hrms.Lite.Shared.DataBank.Generic.SalaryIncrementTool

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table SalaryIncrementTool-table-allowance vertical-scroll-150">

    @Html.HiddenFor(m => m.ClassificationList.Count)
    <table class="common-table " id="ClassificationTable">

        <thead>
            <tr class="table-dark">

                <th class="Header"> Name </th>
                <th class="Header"> Applicability</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ClassificationList != null && Model.ClassificationList.Count > 0)
            {

                for (int i = 0; i < Model.ClassificationList.Count; i++)
                {
                    <tr>
                       
                        <td class="">
                            @Model.ClassificationList[i].Heading
                                                @Html.HiddenFor(model => Model.ClassificationList[i].ClassificationCode)
                                                @Html.HiddenFor(model => Model.ClassificationList[i].Heading)
                                                @Html.HiddenFor(model => Model.ClassificationList[i].Order)
                                                @Html.HiddenFor(model => Model.ClassificationList[i].Type)

                                            </td>

                        <td class="">@Html.CheckBoxFor(modelItem => Model.ClassificationList[i].Applicable, new { @onclick = "onClassificationApplicabilityClick(" + i + ",'CLSFCTN')" })</td>

                    </tr>
                }
            }
          

        </tbody>

    </table>
</div>
