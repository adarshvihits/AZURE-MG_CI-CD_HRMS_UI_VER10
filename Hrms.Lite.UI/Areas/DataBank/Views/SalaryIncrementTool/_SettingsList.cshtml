@model Hrms.Lite.Shared.DataBank.Generic.SalaryIncrementTool
<script>
    $(document).ready(function ()
    {
         ArrangeOrder = $('#SettingsList_Count').val();
       
    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table SalaryIncrementTool-settingslist-table vertical-scroll-500">
    @Html.HiddenFor(m => m.SettingsList.Count)
    <table class="common-table" id="SettingsList">


        <thead>
            <tr class="table-dark">

                <th class="Header"> Sl.No</th>
                <th class="Header"> Column</th>
                <th class="Header">Heading</th>
            </tr>
        </thead>
        <tbody>

            @if (Model.SettingsList != null && Model.SettingsList.Count > 0)
            {

                for (int i = 0; i < Model.SettingsList.Count; i++)
                {
            <tr>
            
                @if (Model.SettingsList[i].Index != 0)
                {
                    <td class="">@Model.SettingsList[i].Index</td>
                }
                else
                {
                   
                    <td class="">@(i+1) @{Model.SettingsList[i].Index = (i + 1);}</td>
                }
             
                @if (Model.SettingsList[i].Columns != null)
                {
                    <td class="">@Model.SettingsList[i].Columns</td>
                }
                else
                {
                    <td class="">COLUMN-@(i+1)</td>
                }
            <td class="">
                @Model.SettingsList[i].Heading
                @Html.HiddenFor(model => Model.SettingsList[i].Index)
                @Html.HiddenFor(model => Model.SettingsList[i].Order)
                @Html.HiddenFor(model => Model.SettingsList[i].Type)
                @Html.HiddenFor(model => Model.SettingsList[i].AllowanceCode)
                @Html.HiddenFor(model => Model.SettingsList[i].ClassificationCode)
                @Html.HiddenFor(model => Model.SettingsList[i].Heading)
            </td>

            </tr>
                }
            }

        </tbody>

    </table>
</div>
