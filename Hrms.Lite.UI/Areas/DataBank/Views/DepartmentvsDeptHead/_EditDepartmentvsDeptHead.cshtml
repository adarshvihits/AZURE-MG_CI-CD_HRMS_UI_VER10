
@model Hrms.Lite.Shared.DataBank.DepartmentvsDeptHead
<script>
    $(document).ready(function () {



        $('#EmployeeInfo_Code').selectpicker();

    });

 
</script>
<style>
    .btn.dropdown-toggle {
        border: none !important;
        height: 29px !important;
    }
</style>
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "DepartmentvsDeptHead_Save" }))
{
    <div id="editgrievance" class="slider-forms slider-forms-open EditDiv">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('EditDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>
                Department vs Department Head
            </h4>
           


            <div class="row my-3">
                <div class="col-md-12">
                    <div class="row-outer">
                        <label class="view-title">
                            Department Name
                        </label>
                        <div class="view-details">
                            @Html.HiddenFor(m => Model.DepartmentCode)
                            
                            @Html.DisplayFor(model => Model.DepartmentName)
                            
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">

                <div class="col-md-12">
                    <label class="">
                        Authority Name

                    </label>
                    <span class="Mandatory">*</span>
                    <div class="form-group mt-1">

                        <div class="slider-search-field">
                            <div class="form-control-sm form-control editAuthority ">
                               
                                @Html.DropDownListFor(model => Model.EmployeeInfo.Code, (SelectList)ViewBag.Authority, "Search by Employee name/ID", new { @class = "selectpicker sliderSearchInput form-control form-control-sm", data_show_subtext = "true", data_live_search = "true" })

                            </div>
                        </div>

                        <span id="authority"></span>

                    </div>

                </div>

            </div>


            <div class="row card-footer-bottom-fixed border-none">
                <div class="col-md-12 align-right">
                    <button type="button"
                            class="btn btn-default  mobile-full-width" onclick="SaveDepartmentvsDeptHead();">
                        Save
                    </button>
                </div>
            </div>
        </div>
    </div>
}

