
@model Hrms.Lite.Shared.DataBank.DepartmentvsDeptHead
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>




<div class="ihits-table table-border hover-color odd-even mobile-responsive-table departmentvshead_list  ">
    @Html.HiddenFor(m => m.DepartmentvsDeptHeadList.Count)
    <table id="GrievanceTable" class="common-table">
        <thead>
            <tr class="table-dark">

                <th scope="col">Sl. No</th>
                <th scope="col">Department Name</th>
                <th scope="col">Authority</th>
                <th scope="col">Edit</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.DepartmentvsDeptHeadList != null && Model.DepartmentvsDeptHeadList.Count > 0)
            {

                for (int i = 0; i < Model.DepartmentvsDeptHeadList.Count; i++)
                {
                    <tr>
                        @Html.HiddenFor(m => Model.DepartmentvsDeptHeadList[i].DepartmentCode)

                        <td data-label="Sl. No">@Model.DepartmentvsDeptHeadList[i].SlNo</td>
                        <td data-label="Department Name">@Model.DepartmentvsDeptHeadList[i].DepartmentName</td>
                        <td data-label="Authority Name">@Model.DepartmentvsDeptHeadList[i].Authority</td>


                        <td data-label="Edit">

                            <a data-bs-toggle="tooltip" title="Edit" id="editgrievance"
                               type="button"
                               class="btn btn-icon btn-edit icon-only " onclick="OnEditClick('@Model.DepartmentvsDeptHeadList[i].DepartmentCode')">
                                <i class="icon-xl fas fa-pencil-alt"></i>
                            </a>
                            <!-- Edit Slider start-->
                            <!-- Edit Slider  end-->
                        </td>
                    </tr>
                }
            }

        </tbody>
    </table>
</div>
