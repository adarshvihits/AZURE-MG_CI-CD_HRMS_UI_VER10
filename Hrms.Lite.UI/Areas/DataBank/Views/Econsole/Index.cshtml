@model Hrms.Lite.Shared.DataBank.Econsole
@{ ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/DataBank/econsole.js"asp-append-version="true"></script>


<script>
    $(document).ready(function () {
        debugger;
        $('.activeTabCount').html("@Model.ActiveCount");
        $('.inactiveTabCount').html("@Model.InactiveCount");
    });

</script>

<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">E Console</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        E Console
                    </li>
                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                    <!--begin: Search Form-->

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap align-items-center">
                            <div class="tab-items">
                                <sapn class="btn-title activeTab active" onclick="tabClick('activeTab',0)">
                                    Active
                                    <span class="btn-notification activeTabCount">@Model.ActiveCount</span>
                                </sapn>
                            </div>
                            <div class="tab-items high">
                                <span class="btn-title inactiveTab" onclick="tabClick('inactiveTab',1)">
                                    Inactive
                                    <span class="btn-notification inactiveTabCount">@Model.InactiveCount</span>
                                </span>
                            </div>


                            <div class="tab-items select-option mb-2">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="Search">
                                </div>

                            </div>


                        </div>
                    </div>



                    <div id="ActiveList">
                        @await Html.PartialAsync("_List", Model)
                    </div>
                    <div class="row card-footer-bottom-fixed">
                        <div class="col-md-12">
                            <a type="button" onclick="OnAddNewClick()" class="btn btn-default float-right mobile-full-width">
                                Add New
                            </a>
                        </div>
                    </div>

                    <!--end: Datatable-->

                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>