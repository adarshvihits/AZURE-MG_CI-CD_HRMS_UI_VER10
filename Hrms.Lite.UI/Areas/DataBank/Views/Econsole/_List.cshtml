@model Hrms.Lite.Shared.DataBank.Econsole
    <script src="~/js/settings.js"></script>


<div id="one" class="ihits-table table-border hover-color odd-even mobile-responsive-table Econsole-List ">
    @Html.HiddenFor(m => m.ConsoleList.Count)
    <table id="econsoleTable" class="common-table layout-ihits">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Type</th>
                <th scope="col">Category</th>
                <th scope="col">Assignment Date</th>
                <th scope="col">First Completion Date</th>
                <th scope="col">Second Completion Date</th>
                <th scope="col">Assignment Day</th>
                <th scope="col">First Completion Day</th>
                <th scope="col">Second Completion Day</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ConsoleList != null && Model.ConsoleList.Count > 0)
            {

                for (int i = 0; i < Model.ConsoleList.Count; i++)
                {
            <tr>
                <td data-label="Name">
                    @Html.HiddenFor(m => m.ConsoleList[i].consoleCode)
                    @Model.ConsoleList[i].Name
                </td>
                <td data-label="Type">@Model.ConsoleList[i].Type</td>
                <td data-label="Category">@Model.ConsoleList[i].Category</td>
                <td data-label="Assignment Date">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.ConsoleList[i].AssignmentDate))</td>
                <td data-label="First Completion Date">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.ConsoleList[i].FirstCompletionDate))</td>
                <td data-label="Second Completion Date">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.ConsoleList[i].SecondCompletionDate))</td>
                <td data-label="Assignment Day">@Model.ConsoleList[i].AssignmentDay</td>
                <td data-label="First Completion Day">@Model.ConsoleList[i].FirstCompletionDay</td>
                <td data-label="Second Completion Day">@Model.ConsoleList[i].SecondCompletionDay</td>
                <td data-label="Actions">
                    <a data-bs-toggle="tooltip" title="View" id="viewfileupload" type="button" class="btn btn-icon btn-eye icon-only pr-2" data-bs-original-title="" onclick="ViewDocument('@Model.ConsoleList[i].consoleCode')">
                        <i class="icon-xl far fa-eye"></i>
                    </a>
                    <a data-bs-toggle="tooltip" title="Edit"
                       class="btn btn-icon btn-edit icon-only" onclick="Edit('@Model.ConsoleList[i].consoleCode')">
                        <i class="icon-xl fas fa-pencil-alt"></i>
                    </a>
                    <a data-bs-toggle="tooltip" title="Delete" id="deleteskilltype"
                       type="button"
                       class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="confirmDelete('@Model.ConsoleList[i].consoleCode')">
                        <i class="icon-xl far fa-trash-alt"></i>
                    </a>
                </td>
            </tr>

                }
            }

        </tbody>
    </table>
</div>