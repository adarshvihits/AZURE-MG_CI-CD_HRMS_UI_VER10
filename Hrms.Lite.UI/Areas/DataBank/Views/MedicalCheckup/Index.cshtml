@model Hrms.Lite.Shared.DataBank.MedicalCheckup
<script src="~/scripts/DataBank/MedicalCheckup.js"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->

            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Medical Checkup</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })" class=""><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            Medical Checkup
                        </li>
                    </ul>
                </div>
            </div>
            <!--begin::Topbar-->
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body">
                        <!--begin: Search Form-->
                        <!-- TILE STYLE -->
                        <!-- TILE STYLE -->

                        <div class="row tab-style-button">
                            <div class="tab-button-wrap">
                                <div class="tab-items high">
                                    <span class="btn-title active CheckupNotdone" onclick="OnTabClick('CheckupNotdone','Not_Done')">
                                        Checkup Not Done
                                        @*<span class="btn-notification NotDoneCount"></span>*@
                                    </span>
                                </div>
                                <div class="tab-items medium">
                                    <span class="btn-title Checkupdone" onclick="OnTabClick('Checkupdone','Done')">
                                        Checkup Done
                                        @*<span class="btn-notification DoneList"></span>*@
                                    </span>
                                </div>




                                <div class="tab-items highs">
                                    <div class="form-group filter-combobox">
                                        <!-- <label>Checkup Type</label> -->
                                        @Html.DropDownListFor(m => m.CheckupType.Code, (SelectList)ViewBag.MedCheckup, new { @class = "form-control form-control-sm", @onchange = "GetList()" })

                                    </div>
                                </div>


                                <div class="tab-items select-option lows">

                                    @*<div class="sraech-slider">
                <div class="search-slider-inner">
                    <i class="fa fa-search"></i>
                </div>
                <input type="text" class="form-control form-control-sm"
                       placeholder="ID/Name">
            </div>*@

                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>

                                    <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>
                                    <button data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                            data-bs-original-title="Export to Excel" onclick="ExportToExcel()">
                                        <i class="icon-xl far fa-file-excel"></i>
                                    </button>
                                </div>

                            </div>
                        </div>

                        <!-- Table Section -->

                        <div id="MedicalCheckupListID">
                            @await Html.PartialAsync("_CheckUpNotDoneList", Model)
                        </div>
                        <!-- Table Setion End -->
                        <div id="AddNewSlider">

                        </div>
                        <div id="DeleteSlider">

                        </div>
                        <div id="filterSlider">

                            @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
                        </div>
                        <!--end: Datatable-->
                    </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>
    <!--end::Content-->

</div>