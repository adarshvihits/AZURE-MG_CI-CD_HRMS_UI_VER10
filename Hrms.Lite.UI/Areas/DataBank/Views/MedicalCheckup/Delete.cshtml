@model Hrms.Lite.Shared.DataBank.MedicalCheckup
<script src="~/scripts/DataBank/MedicalCheckup.js"></script>
@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/tooltip.js"></script>
@using (Html.BeginForm("Delete", "MedicalCheckup", FormMethod.Post, new { id = "Medical_CheckUpDelete" }))
{

    <div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
        <!--begin::Header-->
        <div id="kt_header" class="header header-fixed">
            <!--begin::Container-->
            <div class="container-fluid d-flex align-items-stretch justify-content-between">
                <!--begin::Header Menu Wrapper-->


                <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                    <!--begin::Header Menu-->
                    <div class="d-flex align-items-baseline flex-wrap mr-5">
                        <h3 class="main-title">Medical Checkup</h3>
                        <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                            <li class="breadcrumb-item ">
                                <a href="@Url.Action("Index", "Home", new { Area = "" })" class=""><i class="icon-nm fas fa-home"></i></a>
                            </li>

                            <li class="breadcrumb-item text-muted">
                                <a href="@Url.Action("Index", "MedicalCheckup", new { Area = "DataBank" })">Medical Checkup List</a>
                            </li>
                            <li class="breadcrumb-item text-muted">
                                Medical Checkup
                            </li>
                        </ul>
                    </div>
                </div>
                <!--begin::Topbar-->
                <!--end::Topbar-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Header-->
        <!--begin::Content-->


        <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
            <!--begin::Entry-->
            <div class="d-flex flex-column-fluid">
                <!--begin::Container-->
                <div class="container full-width">
                    <!--begin::Dashboard-->
                    <!--begin::Row-->

                    <div class="row height-100per">

                        <div class="col-md-12">
                            <div class="card card-custom height-100per">

                                <div class="card-body ">
                                    <div class="profile-header position-relative box-shadow-none">
                                        @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeHeader.cshtml", Model.EmployeeHeader)




                                        <div class="profile-header-overflow"></div>
                                    </div>
                                    <div class="row my-4">
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label class="view-title">Checkup Type</label>
                                                <div class="view-details">
                                                    @Html.HiddenFor(model => Model.MedicalCheckupGI)
                                                    @Html.DisplayFor(model => Model.CheckupType.Name)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <label class="view-title">Date Of Checkup</label>
                                          
                                                <div class="view-details">
                                                    @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.CheckupDate))
                                                   
                                                    </div>
                                               
                                            </div>
                                        <div class="col-md-5">
                                            <div class="form-group">
                                                <label>Hospital/ Clinic Details</label>
                                                <div class="view-details">
                                                    @Html.DisplayFor(model => Model.HospitalDetails)
                                                    </div>
                                                </div>
                                            </div>

                                        <div class="col-md-3">
                                            <label class="view-title">Checkup Validity</label>
                                            <div class="view-details">

                                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.CheckupValidity))

                                            </div>
                                        </div>






                                    </div>
                                    <div class="row my-7">
                                        <div class="col-md-4">
                                            <div class="form-group">
                                                <label class="view-title">Health Card Number</label>
                                                <div class="view-details">
                                                    @Html.DisplayFor(model => Model.HealthCardNumber)
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-5">
                                            <div class="form-group">
                                                <label class="view-title">Checkup Details</label>
                                                <div class="view-details">
                                                    @Html.DisplayFor(model => Model.CheckupDetails)
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            @*<div class="file-upload-form-group">
                <label for="formFileMultiple" class="form-label">Attach File</label>

                <div class="file-upload-form mb-1">
                    <div class="small-btn-group">
                        <button type="button" data-bs-toggle="tooltip" data-placement="top" data-bs-original-title="View Image" class="btn btn-icon btn-default"><i class="icon-xl far fa-eye"></i></button>
                    </div>
                    <input class="form-control" type="file" id="formFileMultiple" multiple>
                </div>
                <label class="font-size-xs">Only pdf, doc, docx files are allowed , File size should be less than 1 MB.</label>
            </div>*@
                                            <div class="view-details  ">
                                                <a data-bs-toggle="tooltip" data-bs-original-title="View File" type="button" class="btn btn-small btn-secondary mobile-full-width">
                                                    <i class="icon-xl far fa-eye"></i>View File
                                                </a>
                                            </div>
                                        </div>

                                    </div>
                                     







                                    <div class="row card-footer-bottom-fixed">

                                        <div class="col-md-12 align-right">
                                            <a type="button"
                                               data-bs-toggle="tooltip" title=""
                                               data-bs-original-title="Delete"
                                               class="btn btn-icon btn-delete big-btn float-none" onclick="confirmDelete('@Model.MedicalCheckupGI')">
                                                <i class="icon-xl far fa-trash-alt"></i>
                                            </a>
                                        </div>

                                    </div>

                                </div>

                            </div>
                        </div>
                    </div>




                    <!--end::Row-->
                    <!--begin::Row-->
                    <!--end::Row-->
                    <!--end::Dashboard-->
                </div>
                <!--end::Container-->
            </div>
            <!--end::Entry-->
        </div>
        <!--end::Content-->


    </div>
}