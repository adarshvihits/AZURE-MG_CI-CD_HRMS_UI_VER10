@model Hrms.Lite.Shared.DataBank.MedicalCheckup
<script src="~/scripts/DataBank/MedicalCheckup.js"></script>
<script src="~/js/tooltip.js"></script>

@using (Html.BeginForm("Delete", "MedicalCheckup", FormMethod.Post, new { id = "Medical_CheckUpDelete" }))
{

    <div>
        <div id="MedicalCheckupdelete" class="slider-forms slider-forms-open Delete">
            <div class="slider-inner-style new-inner-style">
                <div class="slider-form-close" onclick="CloseSlider('Delete')">
                    <i class="ki ki-close icon-xs text-muted"></i>
                </div>
                <div class="location-slider">
                    <h4> Medical Checkup </h4>
                    <div class="profile-header position-relative pb-12 mb-5"
                         style="padding-bottom: 2px !important; padding-top: 5px !important;">
                        <div class="row">
                            @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeSliderHeader.cshtml", Model.EmployeeHeader)
                        </div>
                        <div class="profile-header-overflow"></div>
                    </div>
                </div>
                <div class="add-padding">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Checkup Type</label>
                                <div class="view-details">
                                    @Html.HiddenFor(model => Model.MedicalCheckupGI)
                                    @Html.DisplayFor(model => Model.CheckupType.Name)
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">
                                    Date Of Checkup
                                </label>
                                <div class="view-details">
                                    @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.CheckupDate))
                                </div>
                            </div>
                        </div>

                    </div>
                    <div class="row ">

                        <div class="col-md-6">
                            <label class="view-title">Hospital/ Clinic Details</label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.HospitalDetails)
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="view-title">Checkup Validity</label>
                            <div class="view-details">
                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.CheckupValidity))
                            </div>
                        </div>
                    </div>

                    <div class="row my-3">
                        <div class="col-md-6">
                            <label class="view-title">Health Card Number</label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.HealthCardNumber)
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="view-title">Checkup Details</label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.CheckupDetails)
                            </div>
                        </div>
                    </div>
                    <div class="row my-3">
                        <div class="col-md-6">
                            <label class="view-title">Checkup By</label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.CheckupBy)
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="view-title">Remarks</label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.Remarks)
                            </div>
                        </div>
                    </div>

                    <div class="row my-3">
                        <div class="col-md-6">
                            <label class="view-title">Attach File</label>
                            <div class="view-details  ">
                                <a data-bs-toggle="tooltip" data-bs-original-title="View File" type="button" class="btn btn-small btn-secondary mobile-full-width" onclick="showDocument('@Model.Attachment.FileName', '@Model.Attachment.AbsoluteUri')">
                                    <i class="icon-xl far fa-eye"></i>View File
                                </a>
                            </div>
                        </div>

                    </div>

                    <div class="row card-footer-bottom-fixed border-none">

                        <div class="col-md-12 align-right">

                            <a type="button"
                               data-bs-toggle="tooltip" title=""
                               data-bs-original-title="Delete"
                               class="btn btn-icon btn-delete big-btn float-none" onclick="confirmDelete('@Model.MedicalCheckupGI')">
                                <i class="icon-xl far fa-trash-alt"></i>
                            </a>
                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>
}