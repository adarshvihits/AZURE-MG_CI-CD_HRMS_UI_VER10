@model Hrms.Lite.Shared.DataBank.DTO.AssetAllocation
<div id="EditAssetAllocation" class="slider-forms slider-forms-open issueHistory">
    <div class="slider-inner-style new-inner-style">
        <div class="slider-form-close " onclick="CloseSlider('issueHistory')">
            <i class="ki ki-close icon-xs text-muted"></i>
        </div>
        <div class="location-slider">
          

            <div class="profile-header position-relative pb-12 mb-5 mt-7"
                 style="padding-bottom: 2px !important; padding-top: 5px !important;">
                <div class="row">
                    @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeSliderHeader.cshtml", Model.EmployeeHeader)
                </div>
                <div class="profile-header-overflow"></div>
            </div>
        </div>

        <div class="add-padding">


            <div class="row">
                <div class="col-md-12">


                    <div class="row">
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Code</label>
                                <div class="view-details">
                                    @Model.AssetRequest.Asset.AssetCode
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Category</label>
                                <div class="view-details">
                                    @Model.AssetRequest.Asset.AssetCategory.Name
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Asset Name</label>
                                <div class="view-details">
                                    @Model.AssetRequest.Asset.AssetName
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Issuing Department</label>
                                <div class="view-details">
                                    @Model.AssetRequest.Asset.IssuingDepartment.Name
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Date of Purchase</label>
                                <div class="view-details">
                                    @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.AssetRequest.Asset.DateOfPurchase))
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Cost</label>
                                <div class="view-details">
                                    @Model.AssetRequest.Asset.Cost
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Model No/Serial No</label>
                                <div class="view-details">
                                    @Model.AssetRequest.Asset.ModelNo
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Condition</label>
                                <div class="view-details">
                                    @Model.AssetRequest.Asset.Condition.Name
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Brand</label>
                                <div class="view-details">
                                    @Model.AssetRequest.Asset.Brand
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Specification</label>
                                <div class="view-details">
                                    @Model.AssetRequest.Asset.Specification
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Issued Date</label>
                                <div class="view-details">
                                    @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.AssetRequest.AssetIssueDate))
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Due Date</label>
                                <div class="view-details">
                                    @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.AssetRequest.AssetDueDate))
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Return Date</label>
                                <div class="view-details">
                                    @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.AssetRequest.AssetReturnDate == DateTime.Parse("01/Jan/0001 12:00:00 AM") ? null : Model.AssetRequest.AssetReturnDate))
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Deduction</label>
                                <div class="view-details">
                                    @Model.AssetRequest.Deduction
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Reson for Return</label>
                                <div class="view-details">
                                    @Model.AssetRequest.ReasonForReturn
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="row-outer">
                                <label class="view-title">Status</label>
                                <div class="view-details">
                                    @Model.AssetRequest.Asset.Status
                                </div>
                            </div>
                        </div>

                    </div>



                </div>
            </div>

        </div>








    </div>
</div>