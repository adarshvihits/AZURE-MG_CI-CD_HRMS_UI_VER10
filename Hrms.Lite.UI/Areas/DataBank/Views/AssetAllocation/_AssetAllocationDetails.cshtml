@*<script src="~/js/bootstrap-multiselect.js"></script>*@

@using (Html.BeginForm(null, null, FormMethod.Post, new { @id="assetAllocReturn"}))
{

    <div id="EditAssetAllocation" class="slider-forms slider-forms-open edit-assets">
        <div class="slider-inner-style  new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('edit-assets')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>
                    Asset Register
                </h4>
                <div class="profile-header position-relative pb-12 mb-5"
                     style="padding-bottom: 2px !important; padding-top: 5px !important;">              
                    <div class="row">
                        @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeSliderHeader.cshtml", Model.EmployeeHeader)
                    </div>
                    <div class="profile-header-overflow"></div>
                </div>
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-12">

                        @Html.HiddenFor(m => m.AssetRequest.AssetIssueDate)
                        <div class="row">
                            <div class="col-md-6">
                                <div class="row-outer">
                                    <label class="view-title">Asset Code</label>
                                    <div class="view-details">
                                        @Html.HiddenFor(m => m.AssetAllocationGI)
                                        @Model.AssetRequest.Asset.AssetCode
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row-outer">
                                    <label class="view-title">Asset Category</label>
                                    <div class="view-details">
                                        @Model.AssetRequest.Asset.AssetCategory.Name
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="row-outer">
                                    <label class="view-title">Asset Name</label>
                                    <div class="view-details">
                                        @Model.AssetRequest.Asset.AssetName
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row-outer">
                                    <label class="view-title">Issuing Department</label>
                                    <div class="view-details">
                                        @Model.AssetRequest.Asset.IssuingDepartment.Name
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="row-outer">
                                    <label class="view-title">Date of Purchase</label>
                                    <div class="view-details">
                                        @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.AssetRequest.Asset.DateOfPurchase))
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row-outer">
                                    <label class="view-title">Asset Cost</label>
                                    <div class="view-details">
                                        @Model.AssetRequest.Asset.Cost
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="row-outer">
                                    <label class="view-title">Model No/Serial No</label>
                                    <div class="view-details">
                                        @Model.AssetRequest.Asset.ModelNo
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row-outer">
                                    <label class="view-title">Brand</label>
                                    <div class="view-details">
                                        @Model.AssetRequest.Asset.Brand
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="row-outer">
                                    <label class="view-title">Specification</label>
                                    <div class="view-details">
                                        @Model.AssetRequest.Asset.Specification
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="row-outer">
                                    <label class="view-title">Issued Date</label>
                                    <div class="view-details">
                                        @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.AssetRequest.AssetIssueDate))
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="row-outer">
                                    <label class="view-title">Due Date</label>
                                    <div class="view-details">
                                        @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.AssetRequest.AssetDueDate))
                                    </div>
                                </div>
                            </div>

                        </div>



                    </div>
                </div>

                <div class="row mt-2">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Condition</label>
                            @*<select class="form-control form-control-sm "
                                id="exampleSelects">
                            <option>Good</option>
                            <option>Partially</option>
                            <option>Damaged</option>

                        </select>*@
                            @Html.DropDownListFor(m => m.AssetRequest.Asset.Condition.Code, (SelectList)ViewBag.ReturnCondition, "--Select--", new { @class = "form-control form-control-sm", @onchange = "onAssetCategoryChange(this)" })
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label>Deduction</label>
                        <div class="form-group">
                            @*<input type="email"
                        class="form-control form-control-sm"
                        placeholder="Deduction">*@
                            @Html.TextBoxFor(m => m.AssetRequest.Deduction, new { @class = "form-control form-control-sm", @maxlength = 8, @placeholder = "Deduction", @onkeypress = "return onlyNumberKey(event)" })
                        </div>
                    </div>
                </div>


                <div class="row">
                    <div class="col-md-6">
                        <label>Return Date</label><span class="Mandatory">*</span>
                        <div class="input-group date">
                            @*<input type="text"
                        class="form-control kt_datepicker_2"

                        readonly="readonly"
                        placeholder="Return Date">*@
                            @Html.TextBoxFor(m => m.AssetRequest.AssetReturnDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_8", @readonly = "true", @placeholder = "Return Date", onchange = "validateReturnDate(this,'assetReturnDte')" })

                            <div class="input-group-append">
                                <span class="input-group-text">
                                    <i class="la la-calendar"></i>
                                </span>
                            </div>
                        </div>
                        <span id="assetReturnDte"></span>
                    </div>

                </div>

                <div class="row mt-2">
                    <div class="col-md-12">
                        <label>Reson for Return</label>
                        <div class="form-group">
                            @*<input type="email"
                        class="form-control form-control-sm"
                        placeholder="Reson for Return">*@
                            @Html.TextBoxFor(m => m.AssetRequest.ReasonForReturn, new { @class = "form-control form-control-sm", @placeholder = "Reson for Return" })
                        </div>
                    </div>
                </div>


                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12 align-right">
                        <a data-bs-toggle="tooltip" title="Delete" type="button"
                           class="btn btn-icon btn-delete big-btn float-none" onclick="onDeleteAssetAllocation('@Model.AssetAllocationGI')">
                            <i class="icon-xl far fa-trash-alt"></i>
                        </a>
                        <button type="button"
                                class="btn btn-default" onclick="validateAllOnReturn()">
                            Update
                        </button>
                    </div>
                </div>
            </div>
        </div>
        </div>
}





