                    </span>

                </div>
                }
            }
        }*@
                        <div class="tab-items select-option">
                            <div class="form-group filter-combobox filterList">
                          
                                @Html.DropDownListFor(m => m.AssetCategoryCode, (SelectList)ViewBag.AssetCat, "All", new { @class = "form-control form-control-sm asstCat", @onchange = "Tab($('#Tabindex').val(),prevTab,$('#AssetCategoryCode option:selected').text(),'apply',this);$('#AssetCategoryCode').val($('.asstCat').val())" })
                            </div>
                          

                            @if (Model.Tabindex == 0)
                            {

                                <div class="form-group filter-combobox filterList">

                                    @Html.DropDownListFor(m => m.AssetAllocationFilter.Code, (SelectList)ViewBag.AssetAllocationFilterCom, new { @class = "form-control form-control-sm filterDropDown", @onchange = "onFilterDropdownChange(this)" })
                                </div>
                            }
                            
                            <div class="sraech-slider" onclick="CursorFocusOnSearch()">
                                <div class="search-slider-inner">
                                    <i class="fa fa-search"></i>
                                </div>
                                <input type="text" id="dataTableSearch" class="form-control form-control-sm"
