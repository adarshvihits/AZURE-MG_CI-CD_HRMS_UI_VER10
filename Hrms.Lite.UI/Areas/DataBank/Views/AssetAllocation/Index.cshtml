            <div class="card card-custom height-100per footer-row-fixed">
                <div class="card-body">
                   
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items">


                                <span class="btn-title all active" onclick="Tab(0,'all','@Model.AssetAllocationTabs[0].Name','apply')">

                                    @Model.AssetAllocationTabs[0].Name
                                    <span class="btn-notification AllTabCount">@Model.AllTabCount</span>
                                </span>

                            </div>

                            <div class="tab-items low">
                                @for (int i = 0; i < Model.AssetAllocationTabs.Count; i++)
                                {
                                    if (Model.AssetAllocationTabs[i].Code == -2)
                                    {
                                        <span class="btn-title pendingreq" onclick="Tab(1,'pendingreq','@Model.AssetAllocationTabs[i].Name','apply')">

                                            @Model.AssetAllocationTabs[i].Name
                                            <span class="btn-notification PendingTabCount">@Model.PendingTabCount</span>
                                        </span>
                                    }
                                }

                            </div>
                            <div class="tab-items low">
                                @for (int i = 0; i < Model.AssetAllocationTabs.Count; i++)
                                {
                                    if (Model.AssetAllocationTabs[i].Code == -3)
                                    {
                                        <span class="btn-title emppendingreq" onclick="Tab(2,'emppendingreq','@Model.AssetAllocationTabs[i].Name','apply')">

                                            @Model.AssetAllocationTabs[i].Name
                                            <span class="btn-notification EmpReqTabCount">@Model.EmpReqTabCount</span>
                                        </span>
                                    }
                                }

                            </div>

                            @*@if (Model != null && Model.AssetAllocationTabs.Count > 0)
        {

            for (int i = 0; i < Model.AssetAllocationTabs.Count; i++)
            {
                if (Model.AssetAllocationTabs[i].Name == "All")
                {

                    <div class="tab-items">

                        <span class="btn-title @Model.AssetAllocationTabs[i].Name active" onclick="AllTab()">

                            @Model.AssetAllocationTabs[i].Name
