@model Hrms.Lite.Shared.DataBank.DTO.AssetAllocation
    <script src="~/js/settings.js"></script>
    <script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.AllTabCount");
        $('.Tab1Count').html("@Model.Tab1Count");
        $('.Tab2Count').html("@Model.Tab2Count");
        $('.Tab3Count').html("@Model.Tab3Count");
        $('.MoreTabCount').html("@Model.MoreTabCount");
        $('.PendingTabCount').html("@Model.PendingTabCount");

        //$('#pendingTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});

        //$(".dataTables_filter").addClass("dataTables_filter_trn");
        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style')

    });
    </script>
    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table assetallocationpendingrequest">
        @Html.HiddenFor(m => m.AssetAllocationList.Count)
        <table id="pendingTable" class="common-table">
            <thead>
                <tr class="table-dark">
                    <th scope="col">ID</th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">Fun.Designation</th>
                    <th scope="col">Department</th>
                    <th scope="col">Location</th>
                    <th scope="col">Category</th>
                    <th scope="col">Request Date</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.AssetAllocationList != null && Model.AssetAllocationList.Count > 0)
                {

                    for (int i = 0; i < Model.AssetAllocationList.Count; i++)
                    {
                        <tr>
                            <td data-label="ID">@Model.AssetAllocationList[i].EmpId</td>
                            <td data-label="Name">
                                <div class="name-with-img">
                                    @Html.HiddenFor(m => m.AssetAllocationList[i].EmployeeGI)
                                    <a id="AssetNotAllocationsIssuePending" class="slider-btn" onclick="onEmployeeClick('@Model.AssetAllocationList[i].AssetAllocationGI','@Model.AssetAllocationList[i].EmployeeGI','Pending')">@Model.AssetAllocationList[i].EmployeeName</a>

                                </div>
                            </td>
                            <td data-label="Designation">@Model.AssetAllocationList[i].Designation.Name</td>
                            <td data-label="Department">@Model.AssetAllocationList[i].Department.Name</td>
                            <td data-label="Location">@Model.AssetAllocationList[i].Location.Name</td>
                            <td data-label="Category">@Model.AssetAllocationList[i].Category.Name</td>
                            <td data-label="Issued Date">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.AssetAllocationList[i].IssuedDate))</td>

                        </tr>
                    }
                }



            </tbody>
        </table>
    </div>
