<div id="one" class="ihits-table table-border hover-color odd-even mobile-responsive-table assetallocation assetlist ">
    @Html.HiddenFor(m => m.AssetAllocationList.Count)
    <table id="assetAllocationTable" class="common-table layout-ihits">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">Category</th>
                <th scope="col">Required Date</th>
               
            </tr>
        </thead>
        <tbody>
            @if (Model.AssetAllocationList != null && Model.AssetAllocationList.Count > 0)
            {

                for (int i = 0; i < Model.AssetAllocationList.Count; i++)
                {
                    <tr>
                        <td data-label="ID">@Model.AssetAllocationList[i].EmpId</td>
                        <td data-label="Name">
                            <div class="name-with-img">
                                @Html.HiddenFor(m => m.AssetAllocationList[i].AssetAllocationGI)
                                @Html.HiddenFor(m => m.AssetAllocationList[i].EmployeeGI)
                                @Html.HiddenFor(m => m.AssetAllocationList[i].TrnCode)
                                @Html.HiddenFor(m => m.AssetAllocationList[i].Category.Code)
                                <a id="EditAssetAllocation" class="" onclick="onEmployeeAssetReqClick('@Model.AssetAllocationList[i].EmployeeGI',@Model.AssetAllocationList[i].Category.Code,@Model.AssetAllocationList[i].TrnCode)">@Model.AssetAllocationList[i].EmployeeName</a>


                            </div>
                        </td>
                        <td data-label="Designation">@Model.AssetAllocationList[i].Designation.Name</td>
                        <td data-label="Department">@Model.AssetAllocationList[i].Department.Name</td>
                        <td data-label="Location">@Model.AssetAllocationList[i].Location.Name</td>
                        <td data-label="Category">@Model.AssetAllocationList[i].Category.Name</td>
                        <td data-label="Required Date">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.AssetAllocationList[i].RequiredDate))</td>
                        
                    </tr>

                }
            }

        </tbody>
    </table>
</div>