@model Hrms.Lite.Shared.DataBank.DTO.AssetAllocation
@{
    ViewData["Title"] = "Assest Allocation Approve";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <h3 class="main-title">Asset Register - Approve</h3>
            <!--end::Header Menu-->
            <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                <li class="breadcrumb-item ">
                    <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                        <i class="icon-nm fas fa-home mt-1"></i>
                    </a>
                </li>
                <li class="breadcrumb-item text-muted">
                    <a href="@Url.Action("Index", "AssetAllocation", new { Area = "DataBank" })" class="">Asset Allocation</a>
                </li>
                <li class="breadcrumb-item text-muted">
                    Asset Register Approve
                </li>
            </ul>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--begin::Topbar-->
        <div class="topbar">
            <!--begin::Search-->
            <!--end::Cart-->
            <!--begin::Quick panel-->
            <div class="topbar-item" data-bs-toggle="dropdown">
                <div class="btn btn-icon btn-clean btn-lg mr-1" id="kt_quick_panel_toggle">
                    <i class="icon-xl fas fa-bars"></i>
                </div>
            </div>

            <div class="dropdown-menu dropdown-menu-right ">
            </div>
            <!--end::Quick panel-->
            <!--begin::User-->
            <div class="topbar-item">
                <div class="btn btn-icon btn-icon-mobile w-auto btn-clean d-flex align-items-center btn-lg px-2"
                     id="kt_quick_user_toggle">
                    <span class="text-muted font-weight-bold font-size-base d-none d-md-inline mr-1">Hi,</span>
                    <span class="text-dark-50 font-weight-bolder font-size-base d-none d-md-inline mr-3">Sean</span>

                </div>
            </div>
            <!--end::User-->
        </div>
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <div class="container full-width">
            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body p-5 pb-13">
                    <div class="profile-header position-relative box-shadow-none mb-2">
                        

                        @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeHeader.cshtml", Model.EmployeeHeader)

                        <div class="profile-header-overflow"></div>
                    </div>



                    <div class="row my-7">
                        <div class="col-md-3">
                            <div class="row-outer">
                                <label class="view-title">Asset Category</label>
                                <div class="view-details">@Model.AssetRequest.Asset.AssetCategory.Name</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="row-outer">
                                <label class="view-title">Asset Name</label>
                                <div class="view-details">@Model.AssetRequest.Asset.AssetName</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="row-outer">
                                <label class="view-title">Asset Code</label>
                                <div class="view-details">@Model.AssetRequest.Asset.AssetCode</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="row-outer">
                                <label class="view-title">Date of Purchase</label>
                                <div class="view-details">@Model.AssetRequest.Asset.DateOfPurchase</div>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-7">
                        <div class="col-md-3">
                            <div class="row-outer">
                                <label class="view-title">Brand</label>
                                <div class="view-details">@Model.AssetRequest.Asset.Brand</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="row-outer">
                                <label class="view-title">Model No/Serial No</label>
                                <div class="view-details">@Model.AssetRequest.Asset.ModelNo</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="row-outer">
                                <label class="view-title">Asset Cost</label>
                                <div class="view-details">@Model.AssetRequest.Asset.Cost</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="row-outer">
                                <label class="view-title">Issuing Department</label>
                                <div class="view-details">@Model.AssetRequest.Asset.IssuingDepartment.Name</div>
                            </div>
                        </div>
                    </div>

                    <div class="row ">
                        <div class="col-md-3">
                            <div class="row-outer">
                                <label class="view-title">Condition</label>
                                <div class="view-details">@Model.AssetRequest.Asset.Condition</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="row-outer">
                                <label class="view-title">Specification</label>
                                <div class="view-details">@Model.AssetRequest.Asset.Specification</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="row-outer">
                                <label class="view-title">Asset Given Date</label>
                                <div class="view-details">@Model.AssetRequest.AssetIssueDate</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="row-outer">
                                <label class="view-title">Asset Return Date</label>
                                <div class="view-details">@Model.AssetRequest.AssetReturnDate</div>
                            </div>
                        </div>
                    </div>







                </div>
                <div class="row card-footer-bottom-fixed">

                    <div class="col-md-12 align-right">
                        <a type="button"
                           class="btn btn-danger  mobile-full-width">
                            Reject
                        </a>
                        <a type="button"
                           class="btn btn-default  mobile-full-width">
                            Approve
                        </a>
                    </div>

                </div>

            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>
</div>