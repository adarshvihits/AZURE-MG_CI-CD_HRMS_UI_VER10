                                        <div class="col-md-3">
                                            <div class="form-group">
                                                @*<input type="text" class="form-control form-control-sm"
                                placeholder="Offered Salary" onchange="trim(this)">*@
                                                @Html.TextBoxFor(m => m.Compensation.OfferedSalary, new { @class = "form-control form-control-sm", @maxlength = 8, @placeholder = "Offered Salary", @onblur = "validate(this,'salary')", @onkeypress = "return onlyNumberKey(event)" })
                                                <span id="salary"></span>
                                            </div>
                                        </div>

