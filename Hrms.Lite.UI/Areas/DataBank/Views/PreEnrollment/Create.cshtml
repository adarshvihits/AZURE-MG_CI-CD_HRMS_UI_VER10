                                </select>*@
                                                @Html.DropDownListFor(m => m.JobDetails.Department.Code, (SelectList)ViewBag.Dep, "--Select Department--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'department')" })
                                                <span id="department"></span>
                                            </div>
                                        </div>







                                    </div>


