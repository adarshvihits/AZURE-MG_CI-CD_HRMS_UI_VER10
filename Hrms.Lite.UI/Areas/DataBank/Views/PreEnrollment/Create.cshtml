                                                @Html.TextBoxFor(m => m.PermanentAddress.House, new { @class = "form-control form-control-sm", @maxlength = 120, @placeholder = "House", @onblur = "validate(this,'house')", @onkeypress = "return onlyLettersKey(event)" })
