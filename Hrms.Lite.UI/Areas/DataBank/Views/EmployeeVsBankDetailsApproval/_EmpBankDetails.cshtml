@model Hrms.Lite.Shared.DataBank.EmployeeVsBankDetailsApproval
<script>
        $(document).ready(function () {
            debugger;
            var b = document.getElementById('File_AbsoluteUri');
            if (b.value == null) {
                fileLabel.innerHTML = "No File Chosen";
            }
            else {
                var b = document.getElementById('File_ActualFileName');
                if (b.value != '') {

                    let replacemnt = '..';
                    theSplit = b.value.slice(0, 6);
                    fileLabel.innerHTML = theSplit.substring(0, theSplit.length - 2) + replacemnt;
                }
                else {
                    fileLabel.innerHTML = "";

                }
            }
        });
    $(document).ready(function () {
    debugger;

    var payMode = "@Html.Raw(Model.PayMode?.Trim() ?? "")";

        if (payMode === "Cash" || payMode === "Cheque") {
        $('.bankDiv').hide();
    } else {
        $('.bankDiv').show();
    }
});


        window.pressed = function () {
            debugger
            var a = document.getElementById('File_FileData');
            if (a.value == "") {
                fileLabel.innerHTML = "No File Chosen";
            }
            else {
                debugger
                var theSplit = a.value.split('\\');
                theSplit = theSplit[theSplit.length - 1];
                let replacemnt = '..';
                theSplit = theSplit.slice(0, 6);
                fileLabel.innerHTML = theSplit.substring(0, theSplit.length - 2) + replacemnt;
            }
        };


</script>

<div id="addbankname" class="slider-forms slider-forms-open EditBankdiv">
