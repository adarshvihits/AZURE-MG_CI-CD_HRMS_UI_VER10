@model Hrms.Lite.Shared.DataBank.DTO.ResumeDataBank
    <script src="~/js/tooltip.js"></script>
<div class="ihits-table table-border hover-color  odd-even mobile-responsive-table databank-list vertical-scroll-300" style="padding:10px;">
    <table id="ResumeDBTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th cope="col" data-bs-toggle="tooltip" title=""
                    data-bs-original-title="Applicant ID">Appli. ID</th>
                <th scope="col">Candidate Name</th>
                <th scope="col" data-bs-toggle="tooltip" title=""
                    data-bs-original-title="Suitable Designation"> Designation </th>
                <th scope="col" data-bs-toggle="tooltip" title=""
                    data-bs-original-title="Suitable Location"> Location</th>
                <th scope="col" data-bs-toggle="tooltip" title=""
                    data-bs-original-title="Years Of Experience">Y/E</th>
                <th scope="col">Age</th>
    
                <th scope="col">View</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.ResumeDataBank_List != null && Model.ResumeDataBank_List.Count > 0)
            {
                for (int i = 0; i < Model.ResumeDataBank_List.Count; i++)
                {
                    <tr>
                        <td data-label="Ref.No">@Model.ResumeDataBank_List[i].RefNo</td>
                        <td data-label="Candidate Name">
                            @Model.ResumeDataBank_List[i].CandidateName
                        </td>
                        <td data-label="Designation">@Model.ResumeDataBank_List[i].SuitableDesignation</td>
                        <td data-label="Location">@Model.ResumeDataBank_List[i].SuitedLocation</td>
                        <td data-label="Y/S">@Model.ResumeDataBank_List[i].YOS</td>
                        <td data-label="Age">@Model.ResumeDataBank_List[i].Age</td>
                     
                        <td data-label="View"><i class="icon-xl far fa-eye" data-bs-toggle="tooltip" title="System Generated Resume" onclick="viewResume('@Model.ResumeDataBank_List[i].ResumeDataBankGI')"></i></td>

                    </tr>
                }
            }
        </tbody>
    </table>
</div>
