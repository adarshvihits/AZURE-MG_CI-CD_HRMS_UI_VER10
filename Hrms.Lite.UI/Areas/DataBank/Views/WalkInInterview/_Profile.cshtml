
@using Kendo.Mvc.UI


<link href="~/css/kendo/2023.1.117/kendo.bootstrap-main.min.css" rel="stylesheet" />
<script src="~/js/kendo/kendo.all.min.js"></script>
<script src="~/js/kendo/kendo.aspnetmvc.min.js"></script>



@(Html.Kendo().ImageEditor().Name("imageEditor"))


<script>
              $(document).ready(function () {
                var imageEditor = $("#imageEditor").data("kendoImageEditor");
                $.get("@Url.Action("LoadProfilePic_In_KendoUI", new {fileName = ViewBag.fileName })").then(function (data) {

                    imageEditor.drawImage(data).done(function (image) {
                        debugger
                        imageEditor.drawCanvas(image);
                        $('.rotate_icon').attr('disabled', false);
                        $('.rotate_icon').removeClass('hide')
                        $("[data-options*='crop']").trigger("click");
                        $('.k-resize-handle').removeAttr('class');
                        //$('.k-imageeditor-pane-button').hide();
                        $('.k-imageeditor-action-pane').hide();
                        //$('.k-imageeditor-toolbar').hide();

                        var chartTypeDropdown = $("#aspectRatio").data("kendoDropDownList");
                        chartTypeDropdown.select(1);
                        chartTypeDropdown.trigger("change");




                        //$("[data-action*='confirm']").click(function () {
                        //    $("[data-command*='SaveImageEditorCommand']").trigger("click");
                        //});
                    }).fail(function (ev) {
                        alert("Something went wrong!");
                    });
                });
                $('.k-imageeditor-toolbar').hide();

                setTimeout(fitToScreen, 200);

                //$("[data-command*='ZoomImageEditorCommand']").hide();
                //$("[data-command*='UndoImageEditorCommand']").hide();
                //$("[data-command*='RedoImageEditorCommand']").hide();
                //$("[data-command*='OpenImageEditorCommand']").hide();
                //$("[data-command*='OpenPaneImageEditorCommand']").hide();

                $(".k-separator").hide();

                $("[data-options*='crop']").click(function () {
                    $('.k-resize-handle').removeAttr('class');
                });

                $('#uploadBtn').click(function () {

                    swal.fire({
                        text: "Do you want to Upload?",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#3085d6',
                        cancelButtonColor: '#d33',
                        confirmButtonText: 'Ok'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            $("[data-action*='confirm']").trigger("click");

                            //$("[data-command*='SaveImageEditorCommand']").trigger("click");

                            const myTimeout = setTimeout(SaveProfilePicFromKendo, 500);


                        }
                        else
                            return false;
                    })
                });
            });

    function myFunction() {
        alert("hiiiiii");
    }

    function fitToScreen() {
        var zoomDropdown = $("[data-command*='ZoomImageEditorCommand'] input").data("kendoDropDownList");
        zoomDropdown.select(2);
        zoomDropdown.trigger("change");
    }

    function SaveProfilePicFromKendo() {
        var ie = $("#imageEditor").data("kendoImageEditor");
        var ImgElement = ie.getCurrentImage();
        var base64String = ImgElement.getAttribute('src').replace('data:image/png;base64,', '').replace('">', '');
        debugger
        $.ajax({
            url: "/DataBank/WalkInInterview/SaveProfilePicFromKendo",
            type: "POST",
            data: { base64: base64String, contentType: 'image/jpeg', fileName: '@ViewBag.fileName'},
            success: function (response) {
                debugger
                swal.fire('Uploaded Successfully').then(function () {
                    showImageUploaded(response.absoluteUri, response.fileName);
                    //$('.image-input-wrapper').css('background-image', 'url("' + response.absoluteUri + '")');
                    //console.log(response);
                    $('#CandidateDetails_CandidatePhoto_AbsoluteUri').val(response.absoluteUri);
                    $('#CandidateDetails_CandidatePhoto_FileName').val(response.fileName);
                    $('.close').trigger('click');
                });

            },
            error: function (xhr, status, error) {
                debugger
                alert("Error saving image: " + error + status);
            }
        });
    }

    function showImageUploaded(absoluteUri, filename) {
        $.ajax({

            type: 'GET',
            url: '/AccessFile/GetFileStorageType',

            success: function (data) {

                if (data == 'BLOB') fetchFromAzure(filename);
                else

                    $('.image-input-wrapper').css('background-image', "url('" + absoluteUri + "')");

            },
            error: function (xhr, textStatus, errorThrown) {
                if ($($.parseHTML(xhr.responseText)).filter(".Login_Session").length > 0) {
                    window.location.reload();
                }
                else {
                    document.body.id = "kt_body";
                    $('body').html(xhr.responseText);
                }
            }
        });
    }

    function fetchFromAzure(filename) {
        $.ajax({
            type: "POST",
            url: "/AccessFile/ViewAsBackGroundImage", // do not hard code your url's
            data: { filename: filename },
            success: function (data, jqXHR, response) {

                if (jqXHR = "success") {
                    var mimeType = getMimeTypeFromFilename(filename);
                    debugger
                    $('.image-input-wrapper').css('background-image', "url('" + mimeType + data + "')");


                }
            },
            error: function (xhr, textStatus, errorThrown) {
            }
        });
    }
</script>
<div class="row " style=" padding: 10px 5px;">

    <div class="col-md-12 align-right">
        <a id="uploadBtn" type="button" class="btn btn-default float-right mobile-full-width">
            Upload

        </a>

    </div>

</div>
<style>
    .k-widget {
        height: 335px !important;
    }

    .k-imageeditor-content {
        height: 317px !important;
    }

    .k-imageeditor-toolbar .k-toolbar-zoomIn,
    .k-imageeditor-toolbar .k-toolbar-zoomOut {
        display: none;
    }

    .k-imageeditor {
        border: none !important;
    }
</style>


