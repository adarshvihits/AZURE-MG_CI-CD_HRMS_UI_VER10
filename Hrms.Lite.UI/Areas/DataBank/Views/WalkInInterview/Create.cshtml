@model Hrms.Lite.Shared.DataBank.DTO.WalkInInterView
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/scripts/DataBank/walkInInterview.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $("#CandidateDetails_InterviewSelection_Code").find("option").eq(1).hide();
        $("#CandidateDetails_InterviewSelection_Code").find("option").eq(3).hide();
        $('#CandidateDetails_Experience').val('');
    });

    $(document).ready(function () {
        debugger
          $.ajax({

            type: 'GET',
            url: '/AccessFile/GetFileStorageType',

            success: function (data) {

                if (data == 'BLOB') ifAzure();
                else

                    $('.walk_img').css('background-image', "url('" + '@Model.CandidateDetails.CandidatePhoto.AbsoluteUri' + "')");

            },
            error: function (xhr, textStatus, errorThrown) {
                if ($($.parseHTML(xhr.responseText)).filter(".Login_Session").length > 0) {
                    window.location.reload();
                }
                else {
                    document.body.id = "kt_body";
                    $('body').html(xhr.responseText);
                }
            }
        });
        function ifAzure() {
            $.ajax({
                type: "POST",
                url: "/AccessFile/ViewAsBackGroundImage", // do not hard code your url's
                data: { filename: '@Model.CandidateDetails.CandidatePhoto.FileName' },
                success: function (data, jqXHR, response) {

                    if (jqXHR = "success") {
                        var mimeType = getMimeTypeFromFilename('@Model.CandidateDetails.CandidatePhoto.FileName');
                        debugger
                        $('.walk_img').css('background-image', "url('" + mimeType + data + "')");


                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                }
            });
        }
    });


</script>

