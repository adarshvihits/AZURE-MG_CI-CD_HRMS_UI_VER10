@model Hrms.Lite.Shared.DataBank.DTO.JobTransition
    <script src="~/js/settings.js"></script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Job_Transition table">

    <table id="jobTransitionTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col" data-bs-toggle="tooltip" title="Functional Designation">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">Type</th>
                <th scope="col">Order Date</th>
                <th data-bs-toggle="tooltip" title="Effective Date" scope="col">Eff-Date</th>

            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.JobTransitionConfirmList != null && Model.JobTransitionConfirmList.Count > 0)
            {
                for (int i = 0; i < Model.JobTransitionConfirmList.Count; i++)
                {
                    <tr>

                        <td>@Model.JobTransitionConfirmList[i].EmployeeID</td>
                        <td>
                            @Html.ActionLink(Model.JobTransitionConfirmList[i].EmployeeName, "Edit", "JobTransition", new { EmployeeGI = Model.JobTransitionConfirmList[i].EmployeeGI, HistoryGI = Model.JobTransitionConfirmList[i].HistoryGI }, null)
                        </td>
                        <td>@Model.JobTransitionConfirmList[i].Designation</td>
                        <td>@Model.JobTransitionConfirmList[i].Department</td>
                        <td>@Model.JobTransitionConfirmList[i].Location</td>
                        <td>@Model.JobTransitionConfirmList[i].TransitionType</td>
                        <td>@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.JobTransitionConfirmList[i].OrderDate))</td>
                        <td>@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.JobTransitionConfirmList[i].EffectiveDate))</td>


                    </tr>
                }
            }


        </tbody>
    </table>
</div>