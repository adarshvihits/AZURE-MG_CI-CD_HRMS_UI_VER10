<div style="padding:10px;" class="ihits-table table-border hover-color odd-even mobile-responsive-table JobTransitionmodal  vertical-scroll-200">



    <div id="GroupSummaryListDiv">
        <table id="GroupsummaryTable">
            <thead>
                <tr class="table-dark">
                    <th scope="col">Salary Breakup</th>
                    <th scope="col">Per Month Old</th>
                    <th scope="col">Per Annum Old</th>
                    <th scope="col">Per Month New</th>
                    <th scope="col">Per Annum New</th>

                </tr>
            </thead>
            <tbody style="height:480px;">
                @if (Model.JobTransition_FixedAllowance != null && Model.JobTransition_FixedAllowance.Count > 0)
                {

                    for (int i = 0; i < Model.JobTransition_FixedAllowance.Count; i++)
                    {


                        @if (Model.JobTransition_FixedAllowance[i].AllowanceType == "GS" || Model.JobTransition_FixedAllowance[i].AllowanceType == "NS" || Model.JobTransition_FixedAllowance[i].AllowanceType == "CTC" || Model.JobTransition_FixedAllowance[i].AllowanceType == "THS")
                        {
                <tr style="background-color: #01877c1f; ">
                    <td style="font-weight:bold" data-label="FixedAllowance">@Model.JobTransition_FixedAllowance[i].Name</td>

                    <td style="font-weight:bold" data-label="FixedAllowance">
                        @Model.JobTransition_FixedAllowance[i].AmountOld
                    </td>
                    <td style="font-weight:bold" data-label="PerAnnum">@Model.JobTransition_FixedAllowance[i].PerAnnumOld</td>
                    <td style="font-weight:bold" data-label="PerAnnum">@Model.JobTransition_FixedAllowance[i].Amount</td>
                    <td style="font-weight:bold;"  data-label="PerAnnum">@Model.JobTransition_FixedAllowance[i].PerAnnum</td>

                </tr>
                        }
                        else @if (Model.JobTransition_FixedAllowance[i].AllowanceType == "A")
                        {
            <tr>
                <td style="color:green" data-label="FixedAllowance">@Model.JobTransition_FixedAllowance[i].Name</td>

                <td style="color:green" data-label="FixedAllowance">
                    @Model.JobTransition_FixedAllowance[i].AmountOld
                </td>
                <td style="color:green" data-label="PerAnnum">@Model.JobTransition_FixedAllowance[i].PerAnnumOld</td>
                <td style="color:green" data-label="PerAnnum">@Model.JobTransition_FixedAllowance[i].Amount</td>
                <td style="color:green" data-label="PerAnnum">@Model.JobTransition_FixedAllowance[i].PerAnnum</td>

            </tr>
                        }
                        else @if (Model.JobTransition_FixedAllowance[i].AllowanceType == "D")
                        {
            <tr>
                <td style="color:red" data-label="FixedAllowance">@Model.JobTransition_FixedAllowance[i].Name</td>

                <td style="color:red" data-label="FixedAllowance">
                    @Model.JobTransition_FixedAllowance[i].AmountOld
                </td>
                <td style="color:red" data-label="PerAnnum">@Model.JobTransition_FixedAllowance[i].PerAnnumOld</td>
                <td style="color:red" data-label="FixedAllowance">
                    @Model.JobTransition_FixedAllowance[i].Amount
                </td>
                <td style="color:red" data-label="PerAnnum">@Model.JobTransition_FixedAllowance[i].PerAnnum</td>

            </tr>
                        }
                        else
                        {
            <tr>
                <td data-label="FixedAllowance">@Model.JobTransition_FixedAllowance[i].Name</td>

                <td data-label="FixedAllowance">
                    @Model.JobTransition_FixedAllowance[i].AmountOld
                </td>
                <td data-label="PerAnnum">@Model.JobTransition_FixedAllowance[i].PerAnnumOld</td>
                <td data-label="FixedAllowance">
                    @Model.JobTransition_FixedAllowance[i].Amount
                </td>
                <td data-label="PerAnnum">@Model.JobTransition_FixedAllowance[i].PerAnnum</td>
            </tr>
                        }

                    }
                }



            </tbody>


        </table>

    </div>

</div>










