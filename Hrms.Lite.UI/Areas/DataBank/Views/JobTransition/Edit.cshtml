@model Hrms.Lite.Shared.DataBank.DTO.JobTransition
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>
<script src="~/scripts/DataBank/jobTransition.js"></script>
<style>
    .datepicker.datepicker-orient-top {
        z-index: 20 !important;
    }
</style>

@using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "job-tran-Save-form" }))
{
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->

            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title"> Job Transition Edit</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>
                        <li class="breadcrumb-item text-muted">
                            <a href="@Url.Action("EditList", "JobTransition", new { Area = "DataBank" })">Job Transition Edit list</a>
                        </li>
                        <li class="breadcrumb-item text-muted">
                            Job Transition Edit
                        </li>

                    </ul>
                </div>
            </div>
            <!--begin::Topbar-->
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>



    <!--begin::Content-->


    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->

                <div class="row height-100per">

                    <div class="col-md-12">
                        <div class="card card-custom height-100per">


                            <div class="card-body">
                                <!--begin: Search Form-->
                                <div class="profile-header position-relative box-shadow-none mb-2">
                                    @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeHeader.cshtml", Model.EmployeeHeader)
                                    @Html.HiddenFor(m => m.EmployeeGI)
                                    @Html.HiddenFor(m => m.HistoryGI)
                                    @Html.HiddenFor(m => m.EmployeeHeader.EmployeeCode)
                                    <div class="profile-header-overflow"></div>
                                </div>
                                <div id="growth-history" class="">
                                    @await Html.PartialAsync("_GrowthHistory", Model)

                                </div>




                                <div id="transition-type" class="hide">
                                    @await Html.PartialAsync("_TransitionType", Model)
                                </div>
                                <div id="job-details" class="hide">
                                    @await Html.PartialAsync("_JobDetails", Model)
                                </div>
                                <div id="add-authority" class="hide">
                                    @await Html.PartialAsync("_AddAuthority", Model)
                                </div>

                                <div id="compensation-benefits" class="hide">
                                    @await Html.PartialAsync("_CompensationBenefits", Model)

                                </div>




                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

}

