<script>
    $(document).ready(function () {
        debugger;
        var b = document.getElementById('Confidential_AbsoluteUri');
        if (b.value == null || b.value == '') {
            fileLabel.innerHTML = "No File Chosen";
        }
        else {
            var b = document.getElementById('Confidential_ActualFileName');
            if (b.value != '') {

                let replacemnt = '..';
                theSplit = b.value.slice(0, 18);
                fileLabel.innerHTML = theSplit.substring(0, theSplit.length - 2) + replacemnt;
            }
            else {
                fileLabel.innerHTML = "";

            }
        }
    });


    window.pressed = function () {
        debugger
        var a = document.getElementById('Confidential_FileData');
        if (a.value == "") {
            fileLabel.innerHTML = "No File Chosen";
        }
        else {
            debugger
            var theSplit = a.value.split('\\');
            theSplit = theSplit[theSplit.length - 1];
            let replacemnt = '..';
            theSplit = theSplit.slice(0, 18);
            fileLabel.innerHTML = theSplit.substring(0, theSplit.length - 2) + replacemnt;
        }
    };


</script>
