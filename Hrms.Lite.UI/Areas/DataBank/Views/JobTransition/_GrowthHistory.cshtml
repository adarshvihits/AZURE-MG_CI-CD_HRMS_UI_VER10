@model Hrms.Lite.Shared.DataBank.DTO.JobTransition

<div class="step-outer step_row">

    <div class="step-item active">
        Growth History
        <span class="step-circle focused"></span>
    </div>
    <div class="step-item">
        Effective From
        <span class="step-circle"></span>
    </div>
    <div class="step-item">
        Job Details
        <span class="step-circle"></span>
    </div>
    <div class="step-item">
        Compensation & Benifits
        <span class="step-circle"></span>
    </div>
    <div class="step-item">
        Add Authority
        <span class="step-circle"></span>
    </div>
    <div class="step-item">
        Subordinates
        <span class="step-circle"></span>
    </div>
    <div class="step-item">
        Document/Summary
        <span class="step-circle"></span>
    </div>
</div>
@*<script>
    $(document).ready(function () {
       
        jobTransitionReason();

    });
</script>*@
<div class="job-transition-outer">

    <div class="ihits-table table-border table-head-small mobile-responsive-table job_growth_history vertical-scroll-500">
        <table>
            <thead>
                <tr class="table-dark">
                    <th scope="col">Transition Type</th>
                    <!--<th scope="col">-->@*Entry Date*@<!--</th>-->
                    <th scope="col">Order Date</th>
                    <th data-bs-toggle="tooltip" title="Effective Date" scope="col">Eff.Date</th>
                    <th scope="col">Designation</th>
                    <th scope="col" data-bs-toggle="tooltip" title="Functional Designation">Fun.Designation</th>
                    <th scope="col">Department</th>
                    <th scope="col">Location</th>
                    <th scope="col">Category</th>
                    <th scope="col">
                       Monthly CTC
                    </th>
                </tr>
            </thead>

            <tbody>
                @if (Model.GrowthHistory != null && Model.GrowthHistory.Count > 0)
                {
                    for (int i = 0; i < Model.GrowthHistory.Count; i++)
                    {
                <tr>
                    <td data-label="Transition Type ">@Model.GrowthHistory[i].TransitionType</td>
                    @*<td data-label="Entry Date">
            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Convert.ToDateTime(Model.GrowthHistory[i].EntryDate)))
        </td>*@
                    <td data-label="Order Date">
                        @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Convert.ToDateTime(Model.GrowthHistory[i].OrderDate)))
                    </td>
                    <td data-label="Effective Date">
                        @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.GrowthHistory[i].EffectiveDate))
                    </td>
                    <td data-label="Designation"> @Model.GrowthHistory[i].Grade</td>
                    <td data-label="Fun.Designation"> @Model.GrowthHistory[i].Designation</td>
                    <td data-label="Department">@Model.GrowthHistory[i].Department</td>
                    <td data-label="Location">@Model.GrowthHistory[i].Location</td>
                    <td data-label="Category">@Model.GrowthHistory[i].Category</td>
                    <td data-label="Gross Pay">
                        @Model.GrowthHistory[i].CTC
                    </td>
                </tr>

                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" style="text-align:center;"> Not found</td>


                    </tr>
                }



            </tbody>

        </table>
    </div>
 
</div>






<div class="row card-footer-bottom-fixed">
    <div class="col-md-6 align-left">

    </div>
    <div class="col-md-6 align-right">
        <button type="button" onclick="onNextClick('growth-history')"
                class="btn btn-default float-right mobile-full-width">
            Next
        </button>
    </div>

</div>






























