@model Hrms.Lite.Shared.DataBank.DTO.JobTransition

<script>
    $(document).ready(function () {
        debugger
        $.getJSON("/DataBank/JobTransition/GetTransitionReasonDrpDwn", { TypeCode: $('#JobTransition_JobDetail_JobTransitionsType_Code').val() }, function (data) {
            $('#JobTransition_JobDetail_JobTransitionReason_Code option').remove();
            $('#JobTransition_JobDetail_JobTransitionReason_Code').append('<option value="">Select Reason</option');
            debugger;
            for (var i = 0; i < data.length; i++) {
                $('#JobTransition_JobDetail_JobTransitionReason_Code').append('<option value="' + data[i].code + '">' + data[i].name + '</option');
            }
            $('#JobTransition_JobDetail_JobTransitionReason_Code').val(@Model.JobTransition_JobDetail.JobTransitionReason.Code);

        });
    });
   /* jobTransitionReason();*/
</script>

