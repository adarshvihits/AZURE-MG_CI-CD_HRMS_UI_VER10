
@model Hrms.Lite.Shared.DataBank.DTO.JobTransition
    <script>
        $(document).ready(function () {
           
            jobTransitionReason();
        });
    </script>

    <div class="step-outer step_row">

        <a href="#" onclick="onProgressTabClick('growth-history')" class="step-item active">
            Growth History
            <span class="step-circle"></span>
        </a>
        <a href="#" onclick="onProgressTabClick('transition-type')" class="step-item active ">
            Effective From
            <span class="step-circle "></span>
        </a>
        <a href="#" onclick="onProgressTabClick('job-details')" class="step-item active">
            Job Details
            <span class="step-circle "></span>
        </a>
        <a href="#" onclick="onProgressTabClick('compensation-benefits')" class="step-item active">
            Compensation & Benifits
            <span class="step-circle"></span>
        </a>
        <a href="#" onclick="onProgressTabClick('add-authority')" class="step-item active">
            Add Authority
            <span class="step-circle"></span>
        </a>
        <div class="step-item active">
            Subordinates
            <span class="step-circle focused"></span>
        </div>
        <div class="step-item">
            Document/Summary
            <span class="step-circle"></span>
        </div>
    </div>

<div class="job-transition-outer">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-12">

                <div class="row">
                    <div class="col-md-12">
                        <div class="personal-details-left mt-0">

                            <div class="row">
                                <div class="col-md-6">

                                    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table salary-structure-tab vertical-scroll-150 comp-width">
                                        @Html.HiddenFor(m => m.Subordinates_C.Count)
                                        <table class="subordinatesJobTransitionTables">
                                            <thead>
                                                <tr class="table-dark">
                                                    <th scope="col">Current Subordinates</th>

                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model.Subordinates_C != null && Model.Subordinates_C.Count > 0)
                                                {

                                                    for (int i = 0; i < Model.Subordinates_C.Count; i++)
                                                    {
                                                        <tr>
                                                            <td data-label="Subordinates">
                                                                @Model.Subordinates_C[i].SubordinatesName
                                                            </td>
                                                        </tr>
                                                    }
                                                }

                                            </tbody>
                                        </table>
                                    </div>

                                </div>
                                <!-- <end></end> -->
                                <div class="col-md-6">
                                    <div class="ihits-table table-border  mobile-responsive-table salary-structure-tab vertical-scroll-150 comp-width">
                                        @Html.HiddenFor(m => m.Subordinates_N.Count)
                                        <table class="subordinatesJobTransitionTables">
                                            <thead>
                                                <tr class="table-dark">
                                                    <th scope="col">New Subordinates </th>

                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model.Subordinates_N != null && Model.Subordinates_N.Count > 0)
                                                {

                                                    for (int i = 0; i < Model.Subordinates_N.Count; i++)
                                                    {
                                                        <tr>
                                                            <td data-label="Subordinates">
                                                                @Model.Subordinates_N[i].SubordinatesName
                                                            </td>
                                                        </tr>
                                                    }
                                                }

                                            </tbody>
                                        </table>
                                    </div>

                                </div>
                            </div>

                        </div>

                    </div>
                </div>
            </div>
        </div>


    </div>

</div>

<!-- <end table></end> -->

<div class="row card-footer-bottom-fixed">
    <div class="col-md-6 align-left">


    </div>
    <div class="col-md-6 align-right">
        <button type="button" onclick="onNextClick('subordinates')"
                class="btn btn-default float-right mobile-full-width">
            Next
        </button>
    </div>

</div>
