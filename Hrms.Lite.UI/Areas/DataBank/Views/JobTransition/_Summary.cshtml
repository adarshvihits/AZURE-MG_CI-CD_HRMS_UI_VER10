<!-- <end table></end> -->
<div class="row card-footer-bottom-fixed" style="padding-bottom:35px;">
    <div class="col-md-6 align-left ">

        @Html.TextBoxFor(m => m.JobTransition_JobDetail.Remarks, new { @class = "form-control form-control-sm", @placeholder = "Remarks", @maxlength = "250", @onchange = "validate(this, 'JTRemarks')" })
        <span id="JTRemarks"> </span>
    </div>
    <div class="col-md-2 align-center ">
        <label>Confidential Document :</label>

        <div class="file-upload-form-group">
            <div class="file-upload-form mb-1" data-bs-toggle="tooltip" data-bs-original-title=" Only pdf, doc, docx files are allowed , File size less than 1 MB.">
                <div class="small-btn-group">
                    <button type="button" data-bs-toggle="tooltip" data-placement="top" data-bs-original-title="View Image" class="btn btn-icon btn-default" onclick="Preview()"><i class="icon-xl far fa-eye"></i></button>
                </div>
                @Html.TextBoxFor(m => m.Confidential.FileData, new
                {
                    @type = "file",
                    @name = "profile_avatar",
                    @class = "form-control PreviewImage nofilechosen ",
               onchange = "pressed()",
                    @accept = ".png, .jpg, .jpeg, .pdf",
                    @title = ""
                })
                @Html.HiddenFor(m => m.Confidential.AbsoluteUri)
                @Html.HiddenFor(m => m.Confidential.FileName)
                @Html.HiddenFor(m => m.Confidential.ActualFileName)
                <label id="fileLabel" class="nofilelabel notchlabel"></label>
            </div>
        </div>
    </div>
    <div class="col-md-12 align-right">
        <button type="button" onclick="onJobTranstionSubmit()" class="btn btn-default float-right mobile-full-width">
            Save
        </button>
    </div>

</div>