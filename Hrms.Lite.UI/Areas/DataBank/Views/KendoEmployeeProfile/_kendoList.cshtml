@model Hrms.Lite.Shared.DataBank.DTO.EmployeeProfile

<script>
    $(document).ready(function () {
      
        $('.ActiveCount').html("@Model.ActiveCount");
        $('.ResignedCount').html("@Model.ResignedCount");

        $("#dataTableSearch").on("keyup search paste cut", function () {

          

        $('#ActiveListtable').data('kendoGrid').dataSource.read();

        
        $('#ActiveListtable').data('kendoGrid').refresh();


            // dataTable.search(this.value).draw();

        });

        $('.search-slider-inner').click(function () {
            // dataTable.search('').draw();
            $('#ActiveListtable').data('kendoGrid').dataSource.read({ page: 1 });
            $('#ActiveListtable').data('kendoGrid').pager.page(1);
            $('#ActiveListtable').data('kendoGrid').refresh();
            $('#dataTableSearch').val('');
            $('#dataTableSearch').focus();
        });
       


        });

    function ApplyFilter(mode) {

        if (mode == 'apply') {

            if (filterApplicable >= 1) {

        $('#ActiveListtable').data('kendoGrid').dataSource.read();

        //refresh will re-render items in grid from the current datasource
        $('#ActiveListtable').data('kendoGrid').refresh();

        CloseSlider('basicFilter');
            $('#filterForm').removeClass('filter-apply');
            }
            else {
              $('#ActiveListtable').data('kendoGrid').dataSource.read();

        
        $('#ActiveListtable').data('kendoGrid').refresh();
            CloseSlider('basicFilter');
            $('#filterForm').addClass('filter-apply');
        }


        }

        else {
        filterApplicable = 1;
        $('.reset').val('');
        $('#Optional_Filter_EmploymentStatus_Code').val(0);
        $('#filterForm').removeClass('filter-apply');

            $('#ActiveListtable').data('kendoGrid').dataSource.read();

          
            $('#ActiveListtable').data('kendoGrid').refresh();

    }


    }
</script>


<script>
    $(document).on("kendoReady", function () {
        $(".download").click(function () {
            var grid = $("#Grid").data("kendoGrid");
            var options = {
                format: $(this).data("format"),
                title: "DemoSheet"
            }
            $("#export-data").val(encodeURIComponent(JSON.stringify(options)));
            $("#export-model").val(encodeURIComponent(JSON.stringify(grid.columns)));
        });
    });
</script>

