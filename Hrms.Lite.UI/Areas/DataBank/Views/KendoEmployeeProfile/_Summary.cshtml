
@model Hrms.Lite.Shared.DataBank.DTO.EmployeeProfile
<script src="~/scripts/DataBank/employeeProfile.js"></script>

@*<script src="~/js/jquery.min.js"></script>*@
<script src="~/js/tooltip.js"></script>
<div style="padding:10px;" class="ihits-table table-border hover-color odd-even mobile-responsive-table emp_profile-list-table vertical-scroll-250">

    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                <label>Select Classification</label>
                @Html.DropDownListFor(m => m.GroupByFill.Code, (SelectList)ViewBag.Gpy, new { @class = "form-control form-control-sm", @onchange = "groupbyChange(this)" })

            </div>
        </div>

        <div class="col-md-8 d-flex justify-content-end">

            <a data-bs-toggle="tooltip" title="" class="btn btn-excel" data-bs-original-title="Export to Excel" onclick="summaryExportToExcel()">
                <i class="icon-xl far fa-file-excel"></i>
            </a>

        </div>

    </div>

    <br>
    <div id="Smrylist">
        @await Html.PartialAsync("_SummaryList", Model)
    </div>
</div>