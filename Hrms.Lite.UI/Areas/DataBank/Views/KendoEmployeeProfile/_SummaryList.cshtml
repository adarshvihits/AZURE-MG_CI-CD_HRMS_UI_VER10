@*<script src="~/js/datatables.min.js"></script>*@
@model Hrms.Lite.Shared.DataBank.DTO.EmployeeProfile

<table id="summarylist">
    <thead>
        <tr class="table-light">
            <th scope="col">@Model.groupbyname</th>
            <th scope="col">Count</th>
            <th scope="col">%</th>
            <th scope="col">CTC</th>
            <th scope="col">%</th>

        </tr>
    </thead>
    <tbody>

        @if (Model.EmployeeProfileSummary != null && Model.EmployeeProfileSummary.Count > 0)
        {

            for (int i = 0; i < Model.EmployeeProfileSummary.Count; i++)
            {
                //{ int a = 0;
                //    a = a + @Model.EmployeeProfileSummary[i].Count}
                <tr>
                    <td data-label="Department">@Model.EmployeeProfileSummary[i].Name</td>
                   
                    <td data-label="Count">
                        @Model.EmployeeProfileSummary[i].Count
                    </td>
                    <td data-label="%">@Model.EmployeeProfileSummary[i].Count_Perc</td>
                    <td data-label="CTC">@Convert.ToInt32(@Model.EmployeeProfileSummary[i].CTC)</td>
                    <td data-label="%">@Model.EmployeeProfileSummary[i].CTC_Perc</td>
                </tr>
            }
        }




        <tr style=" position: sticky; bottom: 0;" class="table-light">
            <td data-label="ID"><strong></strong></td>

            <td data-label="No of days">
                <strong>@ViewBag.TotalCount</strong>
            </td>


            <td data-label="No of days">
               
            </td>

            <td data-label="No of days">
                <strong>@ViewBag.TotalCTC</strong>
            </td>


            <td data-label="No of days">
               
            </td>

        </tr>



    </tbody>


</table>