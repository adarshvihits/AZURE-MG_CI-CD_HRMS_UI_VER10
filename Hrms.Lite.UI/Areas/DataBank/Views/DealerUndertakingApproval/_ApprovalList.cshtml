@model Hrms.Lite.Shared.DataBank.DealerUndertakingApproval

<script src="~/js/settings.js"></script>
<script src="~/scripts/DataBank/DealerUndertakingApproval.js"></script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table loan-request-approval-list">
    @Html.HiddenFor(Model => Model.DealerUndertakingApprovalList.Count)
    <table class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">Employee ID</th>
                <th scope="col">Employee</th>
                <th scope="col">Fun.Designtion</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">Status</th>
                <th scope="col"></th>
            </tr>

        </thead>
        <tbody>
            @if (Model.DealerUndertakingApprovalList != null && Model.DealerUndertakingApprovalList.Count > 0)
            {

                for (int i = 0; i < Model.DealerUndertakingApprovalList.Count; i++)
                {
                    <tr>
                        <td data-label="EmployeeID">@Model.DealerUndertakingApprovalList[i].EmployeeID</td>
                        <td data-label="EmployeeName">@Model.DealerUndertakingApprovalList[i].EmployeeName</td>
                        <td data-label="Designation">@Model.DealerUndertakingApprovalList[i].Designation</td>
                        <td data-label="Department">@Model.DealerUndertakingApprovalList[i].Department</td>
                        <td data-label="Location">@Model.DealerUndertakingApprovalList[i].Location</td>
                        <td data-label="Status">@Model.DealerUndertakingApprovalList[i].ApprovalStatus</td>


                        <td data-label="">
                            <a data-bs-toggle="tooltip" title="" class="view_btn m-0" onclick="GetDealerUndertakingApprovalList('@Model.DealerUndertakingApprovalList[i].EmployeeGI');" data-bs-original-title="Approve"> </a>
                        </td>


                    </tr>
                }
            }




        </tbody>
    </table>
</div>

