@model Hrms.Lite.Shared.DataBank.DTO.SuccessionPlanning
<script src="~/scripts/DataBank/SuccessionPlanning.js"></script>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->

            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Succession Planning</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            Succession Planning
                        </li>

                    </ul>
                </div>
            </div>
            <!--begin::Topbar-->

        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per">

                    <div class="card-body">
                        <!--begin: Search Form-->
                        <div class="row tab-style-button">
                            <div class="tab-button-wrap">
                                <div class="tab-items">
                                    <span class="btn-title active ActiveTab" onclick="OnTabClick('ActiveTab','ALL')">
                                        All

                                    </span>
                                </div>

                                <div class="tab-items low">
                                    <span class="btn-title PendingTab" onclick="OnTabClick('PendingTab','PENDING')">
                                        Planning
                                        Pending
                                        <span class="btn-notification pendingTabCount">@Model.PendingCount</span>
                                    </span>
                                </div>





                                <div class="tab-items select-option">

                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>
                                    <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>
                                    <button data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                            data-bs-original-title="Export to Excel" onclick="ExportToExcel()">
                                        <i class="icon-xl far fa-file-excel"></i>
                                    </button>
                                </div>


                            </div>
                        </div>
                        <div id="SuccessionPlanningListID">
                            @await Html.PartialAsync("_SuccessionPlanningList")
                        </div>
                        <div id="filterSlider">
                      
                            @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
                        </div>

                        <!--end: Datatable-->
                    </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>
    <div class="slider-over-flow"></div>
    <!--end::Content-->


</div>

