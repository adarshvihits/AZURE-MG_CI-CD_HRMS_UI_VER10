@model Hrms.Lite.Shared.DataBank.DTO.SuccessionPlanning
<script src="~/scripts/DataBank/SuccessionPlanning.js"></script>

@{
    ViewData["Title"] = "SuccessionPlanning";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>

@*@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "SuccessionPlanning_delete" }))
{*@
    <div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
        <!--begin::Header-->
        <div id="kt_header" class="header header-fixed">
            <!--begin::Container-->
            <div class="container-fluid d-flex align-items-stretch justify-content-between">
                <!--begin::Header Menu Wrapper-->


                <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                    <!--begin::Header Menu-->
                    <div class="d-flex align-items-baseline flex-wrap mr-5">
                        <h3 class="main-title">Succession Planning</h3>
                        <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                            <li class="breadcrumb-item ">
                                <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                            </li>

                            <li class="breadcrumb-item text-muted">
                                <a href="@Url.Action("Index", "SuccessionPlanning", new { Area = "DataBank" })">Succession Planning List</a>
                            </li>
                            <li class="breadcrumb-item text-muted">
                                Succession Planning
                            </li>

                        </ul>
                    </div>
                </div>
                <!--begin::Topbar-->
                <!--end::Topbar-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Header-->
        <!--begin::Wrapper-->
        <!--begin::Content-->
        <div class="content d-flex flex-column flex-column-fluid " id="kt_content">
            <!--begin::Entry-->
            <div class="d-flex flex-column-fluid">
                <!--begin::Container-->
                <div class="container full-width">
                    <!--begin::Dashboard-->
                    <!--begin::Row-->



                    <div class="card card-custom height-100per">

                        <div class="card-body">
                            <div id="EmpHead" class="profile-header position-relative box-shadow-none mb-2">
                                <div id="employeeHeaderSuccession">
                                    @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeHeader.cshtml", Model.EmployeeHeader)

                                </div>
                            </div>

                            <div class="page_white mt-5">
                            <div class="row pt-3">
                                <div class="col-md-3">
                                    <!-- <div class="other-content-row mb-0"> -->
                                    <div class="row-ithems">
                                        <label class="view-title">Key Position Code</label>
                                        @Html.HiddenFor(Model => Model.EmployeeGI)
                                        @Html.HiddenFor(Model => Model.KeyPositionGI)
                                        <div class="view-details">@Model.KeyPositionDesc</div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="row-ithems">
                                        <label class="view-title">Key Position</label>
                                        <div class="view-details">@Model.KeyPosition</div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="row-ithems">
                                        <label class="view-title">Gender</label>
                                        <div class="view-details">@Model.Gender</div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="row-ithems">
                                        <label class="view-title">Y/S</label>
                                        <div class="view-details">@Model.YOS</div>
                                    </div>
                                </div>
                                <!--
        </div> -->



                            </div>
                            <div class="row pt-2">

                                <div class="col-md-3">
                                    <div class="row-ithems">
                                        <label class="view-title">Highest Qualification</label>
                                        <div class="view-details">@Model.Qualification</div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="row-ithems">
                                        <label class="view-title">Skill</label>
                                        <div class="view-details">@Model.Skill</div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="row-ithems">
                                        <label class="view-title">Language</label>
                                        <div class="view-details">@Model.Language</div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="row-ithems">
                                        <label class="view-title">Matching</label>
                                        <div class="view-details">
                                            <div class="profile-matching-line">
                                                <div class="progress-bar" style="width:100px ;">

                                                    @if (Model.Matching > 75)
                                                    {
                                                        <div class="high" data-bs-toggle="tooltip" title="" data-bs-original-title="@Model.Matching"> @*<span class="progress-value">@Model.Matching</span>*@</div>
                                                    }
                                                    else if (Model.Matching >= 50)
                                                    {
                                                        <div class="medium" data-bs-toggle="tooltip" title="" data-bs-original-title="@Model.Matching">@*<span class="progress-value">@Model.Matching</span>*@</div>
                                                    }
                                                    else if (Model.Matching < 50)
                                                    {
                                                        <div class="low" data-bs-toggle="tooltip" title="" data-bs-original-title="@Model.Matching">@*<span class="progress-value">@Model.Matching</span>*@</div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                            <div class="row mt-7">

                                <div class="col-md-12">
                                    <h6 style="font-size: 20px; font-weight: 600;  padding-top: 10px; ">Successors</h6>
                                    @*border-top: 1px solid #a3acc6;*@
                                </div>
                            </div>

                            <div id="successors_List">
                                @await Html.PartialAsync("_SuccessorList", Model)
                            </div>
                            <div class="row card-footer-bottom-fixed">

                                <div class="col-md-12 align-right">
                                    <button id="addskilltype" type="button"
                                            class="btn btn-default float-right mobile-full-width" onclick="onAddNewSuccessorClick('@Model.KeyPositionGI', '@Model.EmployeeGI')">
                                        Add
                                        New Successor
                                    </button>

                                </div>

                            </div>
                            <!--end: Datatable-->
                            <div id="AddNewSlider">

                            </div>
                        </div>
                    </div>


                    <!--end::Row-->
                    <!--begin::Row-->
                    <!--end::Row-->
                    <!--end::Dashboard-->
                </div>
                <!--end::Container-->
            </div>
            <!--end::Entry-->

        </div>
        <!--end::Content-->

    </div>
   @*}*@