@model Hrms.Lite.Shared.DataBank.DTO.SuccessionPlanning
    <script src="~/js/settings.js"></script>



    <script>
    $(document).ready(function () {
        debugger;
     
        $('.pendingTabCount').html("@Model.PendingCount");

    });
    </script>



    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table succession-planning-list">
        @Html.HiddenFor(m => m.SuccessionPlanningList.Count)
        <table id="PendingSuccessorTable" class="layout-fixed common-table">
            <thead>
                <tr class="table-dark">
                    <th scope="col">SlNo</th>
                    <th data-bs-toggle="tooltip" data-bs-original-title="Key Position Code" scope="col">KP.Code</th>

                    <th scope="col">Key Position</th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">Fun.Designation</th>
                    <th scope="col">Department</th>
                    <th scope="col">Location</th>



                </tr>
            </thead>
            <tbody>
                @{
                    if (Model.SuccessionPlanningList != null && Model.SuccessionPlanningList.Count > 0)
                    {
                        for (int i = 0; i < Model.SuccessionPlanningList.Count; i++)

                        {
                            <tr>
                                <td data-label="SlNo">@Model.SuccessionPlanningList[i].SlNo</td>
                                <td data-label="Key Position Code">@Model.SuccessionPlanningList[i].KeyPositionDesc</td>

                                <td data-label="Key Position">
                                    <a class="" onclick="OnKeyPositionClick('@Model.SuccessionPlanningList[i].KeyPositionGI', '@Model.SuccessionPlanningList[i].EmployeeGI')">@Model.SuccessionPlanningList[i].KeyPosition</a>

                                    @*<a class="" onclick="OnKeyPositionClick('@Model.SuccessionPlanningList[i].KeyPositionGI', '@Model.SuccessionPlanningList[i].EmployeeGI')">@Model.SuccessionPlanningList[i].KeyPosition</a>*@
                                </td>

                                <td data-label="Current Employee">
                                    <div class="tooltip-outer">
                                        @Model.SuccessionPlanningList[i].EmployeeName

                                    </div>
                                </td>
                                <td data-label="Designation">@Model.SuccessionPlanningList[i].Designation</td>
                                <td data-label="Department">@Model.SuccessionPlanningList[i].Department</td>

                                <td data-label="Location">@Model.SuccessionPlanningList[i].Location</td>



                            </tr>



                        }
                    }
                }



            </tbody>
        </table>
    </div>