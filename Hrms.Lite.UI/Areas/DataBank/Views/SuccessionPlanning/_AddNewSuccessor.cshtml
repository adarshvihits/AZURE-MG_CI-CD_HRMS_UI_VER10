                                @Html.HiddenFor(Model => Model.KeyPositionGI)
                                @Html.HiddenFor(Model => Model.EmployeeGI)
                                @*@Html.RadioButtonFor(Model => Model.EmployeesType, "1", new { onchange = "fillData(1,'" + Model.KeyPositionGI + "','" + Model.EmployeeGI + "')" })*@
                                @Html.RadioButtonFor(Model => Model.EmployeesType, "1", new { onchange = "SelectEmployees(1,'" + Model.KeyPositionGI + "','" + Model.EmployeeGI + "')" })

