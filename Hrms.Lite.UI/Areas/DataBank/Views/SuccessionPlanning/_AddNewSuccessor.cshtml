                <div class="col-md-12">


                    <div id="EmployeeListID">
                        @await Html.PartialAsync("_EmployeeList", Model)
                    </div>




                </div>
            </div>



            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    <button class="btn btn-default" type="button" onclick="OnProceedClick('@Model.KeyPositionGI','@Model.EmployeeGI')">
