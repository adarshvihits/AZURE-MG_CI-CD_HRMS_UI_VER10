        onchange="showMonthCalender(this)"
        type="radio" value="1">*@


                                @*@Html.RadioButtonFor(Model => Model.EmployeesType, "2", new { onchange = "fillData(2,'" + Model.KeyPositionGI + "','" + Model.EmployeeGI + "')" })*@


                                @Html.RadioButtonFor(Model => Model.EmployeesType, "2", new { onchange = "SelectEmployees(2,'" + Model.KeyPositionGI + "','" + Model.EmployeeGI + "')" })

