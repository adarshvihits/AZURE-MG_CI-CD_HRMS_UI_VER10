<!-- Table Section -->
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table job-transition-due-list ">
    @Html.HiddenFor(m => m.JobTransitionDueList.Count)
    <table id="jobTransitionDueListTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th data-bs-toggle="tooltip" title="" scope="col" data-bs-original-title="Date of Join">DOJ</th>

                <th scope="col">Renewal Date</th>
                <th scope="col">Aging</th>
                <th scope="col">Type</th>

            </tr>
        </thead>
        <tbody>
            @if (Model.JobTransitionDueList != null && Model.JobTransitionDueList.Count > 0)
            {
                for (int i = 0; i < Model.JobTransitionDueList.Count; i++)
                {
                    <tr>

                        <td>@Model.JobTransitionDueList[i].EmployeeID</td>
                        <td>
                            @Model.JobTransitionDueList[i].EmployeeName

                        </td>
                        <td>@Model.JobTransitionDueList[i].Designation</td>
                        <td>@Model.JobTransitionDueList[i].Department</td>
                        <td>@Model.JobTransitionDueList[i].Location</td>
                        <td>@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.JobTransitionDueList[i].DOJ))</td>
                        <td>@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.JobTransitionDueList[i].RenewalDate))</td>
                        <td>@Model.JobTransitionDueList[i].Ageing</td>

                        <td>@Model.JobTransitionDueList[i].TransitionType</td>




                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<!-- Table Setion End -->