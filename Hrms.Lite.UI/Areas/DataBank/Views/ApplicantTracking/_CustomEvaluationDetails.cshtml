@model Hrms.Lite.Shared.DataBank.DTO.ApplicantTracking
<script src="~/js/bootstrap-datepicker.js"></script>

<script src="~/js/tooltip.js"></script>
<script>
        var noOfInterviews = 1;
     $(document).ready(function () {
        noOfInterviews = @Model.ApplicantTrackingDT.NoInterviewLevel;
         for (let index = 0; index < (noOfInterviews-1); index++) {
             AddMore();
         }
         $("#InterviewSelection_Code").find("option").eq(1).hide();
         $("#InterviewSelection_Code").find("option").eq(3).hide();
         $('.interName').selectpicker();
        });

    $(document).ready(function () {
        debugger
        $.ajax({

            type: 'GET',
            url: '/AccessFile/GetFileStorageType',

            success: function (data) {

                if (data == 'BLOB') ifAzure();
                else

                    $('.emp_HeaderPic').css('background-image', "url('" + '@Model.ApplicantTrackingDT.Interviewer.EmployeeAbsoluteUri' + "')");

            },
            error: function (xhr, textStatus, errorThrown) {
                if ($($.parseHTML(xhr.responseText)).filter(".Login_Session").length > 0) {
                    window.location.reload();
                }
                else {
                    document.body.id = "kt_body";
                    $('body').html(xhr.responseText);
                }
            }
        });
        function ifAzure() {
            $.ajax({
                type: "POST",
                url: "/AccessFile/ViewAsBackGroundImage", // do not hard code your url's
                data: { filename: '@Model.ApplicantTrackingDT.Interviewer.FileName' },
                success: function (data, jqXHR, response) {

                    if (jqXHR = "success") {
                        var mimeType = getMimeTypeFromFilename('@Model.ApplicantTrackingDT.Interviewer.FileName');
                        debugger
                        $('.emp_HeaderPic').css('background-image', "url('" + mimeType + data + "')");


                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                }
            });
        }
    });


</script>
<style>
    .dropdown-menu.show .inner.show {
        transform: translate3d(0px, 0px, 0px) !important;
        height: 200px;
    }
    .form-control .btn.dropdown-toggle {
     
        border: none;
    
      
    }
    .was-validated .form-control:invalid, .form-control.is-invalided {
        background-position: right calc(0.550em + 1.55rem) center;
    }
</style>
