@model Hrms.Lite.Shared.DataBank.DTO.ApplicantTracking
<script>
    $(document).ready(function () {
        debugger
        $.ajax({

            type: 'GET',
            url: '/AccessFile/GetFileStorageType',

            success: function (data) {

                if (data == 'BLOB') ifAzure();
                else

                $('.emp_HeaderPic').css('background-image', "url('" + '@Model.ApplicantTrackingDT.Interviewer.EmployeeAbsoluteUri' + "')");

            },
            error: function (xhr, textStatus, errorThrown) {
                if ($($.parseHTML(xhr.responseText)).filter(".Login_Session").length > 0) {
                    window.location.reload();
                }
                else {
                    document.body.id = "kt_body";
                    $('body').html(xhr.responseText);
                }
            }
        });
        function ifAzure() {
            $.ajax({
                type: "POST",
                url: "/AccessFile/ViewAsBackGroundImage", // do not hard code your url's
                data: { filename: '@Model.ApplicantTrackingDT.Interviewer.FileName' },
                success: function (data, jqXHR, response) {

                    if (jqXHR = "success") {
                        var mimeType = getMimeTypeFromFilename('@Model.ApplicantTrackingDT.Interviewer.FileName');
                        debugger
                        $('.emp_HeaderPic').css('background-image', "url('" + mimeType + data + "')");


                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                }
            });
        }
    });


</script>
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "interviewSchedule" }))
{
<div id="interviewevaluation" class="slider-forms slider-forms-open evaluationSlider">
    <div class="slider-inner-style">
        <div class="slider-form-close" onclick="CloseSlider('evaluationSlider')">
            <i class="ki ki-close icon-xs text-muted"></i>
        </div>
        <h4 class="mb-4">Interview & Evaluation</h4>
        <div class="profile-header position-relative pb-12 mb-5"
             style="padding-bottom: 2px !important; padding-top: 5px !important;">
            <div class="row">
                <div class="col-md-2">
                    <div class="image-input image-input-outline image-input-circle float-right emp_HeaderPic"
                         id="kt_image_4">
                        <div class="image-input-wrapper">
                        </div>
                    </div>
                </div>
                <div class="col-md-10 pl-7">
                    <div class="row">

                        <div class="flex-grow-1">
                            <!--begin::Title-->
                            <div class="d-flex justify-content-between flex-wrap">
                                <div class="d-flex mr-3 header-profile-name app-track">
                                    <span class="">
                                        @Html.HiddenFor(m => m.ApplicantTrackingDT.ResumeDataBankCode)
                                        @Html.HiddenFor(m => m.ApplicantTrackingDT.InterviewStatusType)
                                        @Model.ApplicantTrackingDT.EmployeeName
                                    </span>
                                    <span>
                                        ( @Model.ApplicantTrackingDT.EmployeeId
                                        )
                                    </span>

                                </div>

                            </div>

                            <!--end::Title-->
                            <!--begin::Content-->
                            <div class="d-flex flex-wrap justify-content-between">
                                <div class="d-flex flex-column flex-grow-1 pr-8">
                                    <div class="d-flex flex-wrap mb-1">
                                        <span data-bs-toggle="tooltip"
                                              data-bs-original-title="Designation"
                                              class="header-profile-email mr-5 mb-lg-0 mb-2">
                                            <i class="fas fa-briefcase icon-nm mr-2"></i>@Model.ApplicantTrackingDT.Designation.Name
                                        </span>
                                        <span data-bs-toggle="tooltip"
                                              data-bs-original-title="Department"
                                              class="header-profile-email mr-5 mb-lg-0 mb-2">
                                            <i class="fas fa-network-wired icon-nm mr-2"></i>@Model.ApplicantTrackingDT.Location.Name
                                        </span>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="profile-header-overflow"></div>
        </div>




        <!----- stepper start here --->
        <div>

            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Email
                            ID
                        </label>
                        <div class="view-details">
                            @Model.ApplicantTrackingDT.Email
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Phone Number
                        </label>
                        <div class="view-details">
                            @Model.ApplicantTrackingDT.MobileNo
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Level</label>
                        <div class="view-details">
                            @*@Model.ApplicantTrackingDT.InterviewLevel.Name*@
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="view-title">
                            Interview
                            Type
                        </label>
                        <div class="view-details">
                            @Model.ApplicantTrackingDT.InterviewType.Name
                        </div>
                    </div>
                </div>
            </div>
            <!-- completed -->

            <div class="row">
                <div class="col-md-6">
                    <label class="view-title">
                        Interview
                        Date
                    </label>
                    <div class="view-details">
                        @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.ApplicantTrackingDT.InterviewDate))
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="form-group">
                        <label class="view-title">
                            Interview
                            Time
                        </label>
                        <div class="view-details">
                            @Model.ApplicantTrackingDT.InterviewTime
                        </div>
                    </div>
                </div>

            </div>
            <div class="row my-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label class="view-title">
                            Interview
                            Mode
                        </label>
                        <div class="view-details">
                            @Model.ApplicantTrackingDT.InterviewMode.Name
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group ">
                        <label class="view-title">
                            Interviewer
                        </label>
                        <div class="view-details">
                            @Model.ApplicantTrackingDT.Interviewer.EmployeeName
                        </div>

                        <!-- <div data-field="email" data-validator="notEmpty" class="error-message">This Field is required</div> -->
                    </div>
                </div>

            </div>
            <div class="row my-3">

                <div class="col-md-6">
                    <div class="form-group ">
                        <label>Evaluation Status </label>
                        @Html.DropDownListFor(m => m.ApplicantTracking_Evaluation.EvaluationStatus.Code, (SelectList)ViewBag.selection, "--Select--", new { @class = "form-control form-control-sm" ,@onchange="onEvaluationStatusChange(this)"})
                        <!-- <div data-field="email" data-validator="notEmpty" class="error-message">This Field is required</div> -->
                    </div>
                </div>
                <div class="col-md-6" id="scr">
                    <label>Score </label>                    
                    @Html.TextBoxFor(m => m.ApplicantTracking_Evaluation.Score,new { @class= "form-control", @placeholder = "Score" })
                </div>
            </div>
            <div class="row ">

                <div class="col-md-6  ">
                    <a data-bs-toggle="tooltip "
                       data-bs-original-title="View File"
                       type="button"
                       class="btn btn-small btn-secondary mobile-full-width" onclick="window.open('@Model.ApplicantTrackingDT.Resume')">
                        <i class="icon-xl far fa-eye"></i>View
                        Resume
                    </a>
                </div>
            </div>
            <div class="row my-3">

                <div class="col-md-12">
                    <label>Remarks</label>
                    @Html.TextAreaFor(m => m.ApplicantTrackingDT.Remarks, new
               {
                   @class = "form-control form-control-sm",
                   @placeholder = "Remarks"
               })
                </div>
            </div>














            <div class="row card-footer-bottom-fixed">

                <div class="view-details align-right col-md-12">
                    <a type="button"
                       class="btn btn-default  mobile-full-width" onclick="Schedule('Save')">
                        Save
                    </a>
                </div>



            </div>




        </div>
    </div>
</div>
}