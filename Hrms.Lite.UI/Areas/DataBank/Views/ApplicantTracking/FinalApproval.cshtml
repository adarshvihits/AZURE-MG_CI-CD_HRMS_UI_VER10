@model Hrms.Lite.Shared.DataBank.DTO.ApplicantTracking
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/DataBank/applicantTracking.js"></script>
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">RA Approval</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        RA Approval List
                    </li>

                </ul>
            </div>
        </div>

        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">


                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            @if (Model.ApplicantTrackingListTabs != null)
                            {
                                @if (Model.ApplicantTrackingListTabs[0].Name != null)
                                {
                                    <div class="tab-items low">
                                        <span class="btn-title active tab1" onclick="onRAtabClick(@Model.ApplicantTrackingListTabs[0].Code,'tab1', '@Model.ApplicantTrackingListTabs[0].Name')">
                                            @Model.ApplicantTrackingListTabs[0].Name
                                            <span class="btn-notification Tab3Count">@Model.Tab3Count</span>
                                        </span>
                                    </div>
                                }
                                @if (Model.ApplicantTrackingListTabs[1].Name != null)
                                {
                                    <div class="tab-items medium">
                                        <span class="btn-title tab2" onclick="onRAtabClick(@Model.ApplicantTrackingListTabs[1].Code, 'tab2','@Model.ApplicantTrackingListTabs[1].Name')">
                                            @Model.ApplicantTrackingListTabs[1].Name
                                            <span class="btn-notification Tab6Count">@Model.Tab6Count</span>
                                        </span>
                                    </div>
                                }
                            }
                            <div class="tab-items medium">
                                <span class="btn-title tab3" onclick="onRAtabClick(7, 'tab3','Offer Rejected List')">
                                    Offer Rejected List
                                    <span class="btn-notification Tab7Count">@Model.Tab7Count</span>
                                </span>
                            </div>
                            <div class="tab-items select-option">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <button data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                        data-bs-original-title="Export to Excel" onclick="RAapprovalExportExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </button>

                            </div>


                        </div>
                    </div>
                    <div id="ApplicantTrackingList">
                        @await Html.PartialAsync("_RAApprovalPendingList")
                    </div>
                    <div id="ApplicantTrackingSlider">

                    </div>


                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
<!--end::Content-->

<div class="modal fade interviewDetailsPopup" tabindex="-1" aria-labelledby="myLargeModalLabel" aria-hidden="true" style="display: none;">
    <div class="modal-dialog" style="max-width:900px;">
        <div class="modal-content popup " style="height:392px ;">
            <div class="modal-header" style="padding:10px">
                <h5 class="modal-title">
                    Interview Details
                </h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">
            </div>
            <!-- <end table></end> -->



        </div>
    </div>
</div>