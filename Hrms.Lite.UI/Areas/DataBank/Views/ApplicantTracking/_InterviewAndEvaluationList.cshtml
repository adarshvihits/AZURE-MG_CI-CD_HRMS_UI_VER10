@model Hrms.Lite.Shared.DataBank.DTO.ApplicantTracking
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;

        $('.Tab1Count').html("@Model.Tab1Count");
        $('.Tab2Count').html("@Model.Tab2Count");
        $('.Tab3Count').html("@Model.Tab3Count");

    });

</script>
<div class="ihits-table table-border odd-even mobile-responsive-table applicant-interview-evaluation">
    <table class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">
                    MRF No.
                </th>
                <th scope="col">Job Title</th>
                <th scope="col">Deadline</th>
                <th scope="col" data-bs-toggle="tooltip" title=""
                    data-bs-original-title=" Days Left">
                    D.L.
                </th>
                <th scope="col">
                    Required Location
                </th>
                <th scope="col">Applicant Name</th>
                <th scope="col">
                    Age
                </th>

                <th scope="col" data-bs-toggle="tooltip" title=""
                    data-bs-original-title="Years Of Experience">
                    Y/E
                </th>
                <th scope="col">
                    Interview Status

                </th>
                @*<th scope="col">

                </th>*@
            </tr>
        </thead>
        <tbody>
            @if (Model.ApplicantTrackingList != null && Model.ApplicantTrackingList.Count > 0)
            {

                for (int i = 0; i < Model.ApplicantTrackingList.Count; i++)
                {
<tr>
    <td data-label="MRF No.">
        @Html.HiddenFor(m => m.ApplicantTrackingList[i].ResumeDataBankGI)
        @Html.HiddenFor(m => m.ApplicantTrackingList[i].InterviewStatusType)
        @Model.ApplicantTrackingList[i].JobCode
    </td>
    <td data-label="Job Title">@Model.ApplicantTrackingList[i].JobTitle</td>
    <td data-label="Need by Date">
        @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.ApplicantTrackingList[i].NeededByDate))
    </td>
    <td data-label="Days Left">
        @Model.ApplicantTrackingList[i].DaysLeft
    </td>
    <td data-label="Smart City">
        @Model.ApplicantTrackingList[i].Location
    </td>
    <td data-label="Applicant Name">@Model.ApplicantTrackingList[i].ApplicantName</td>

    <td data-label="Age">
        @Model.ApplicantTrackingList[i].Age
    </td>
    <td data-label="Years Of Experience">
        @Model.ApplicantTrackingList[i].YOS
    </td>

    <td data-label="Interview Status">

        <a id="Scheduledinterview " class="slider-btn" onclick="GetInterviewScheduleDetails('@Model.ApplicantTrackingList[i].ResumeDataBankGI','@Model.ApplicantTrackingList[i].InterviewStatusType')">
            @Model.ApplicantTrackingList[i].InterviewStatus

        </a>
    </td>

    @*<td data-label="Tracker">
        <a data-bs-toggle="tooltip" title="View" id="viewschedule"
           type="button" class=" mobile-full-width slider-btn " onclick="GetInterviewEvaluationView('@Model.ApplicantTrackingList[i].ResumeDataBankGI','@Model.ApplicantTrackingList[i].InterviewStatusType')">
            <i class="icon-xl far fa-eye common-icon pr-2"></i>
        </a>*@



        <!-- <a data-bs-toggle="tooltip" title="Delete"
                                        id="" type="button"
                                        class=" mobile-full-width  ">
                                        <i class="icon-xl far fa-trash-alt common-icon "></i></a> -->
        <!-- <end delete section></end> -->
        @*<a href="#" id="applicant " class="slider-btn">
                <i class="icon-xl la la-arrow-circle-right"></i>
            </a>*@

    @*</td>*@
</tr>                }
            }


        </tbody>
    </table>

</div>