@model Hrms.Lite.Shared.DataBank.DTO.ApplicantTracking
    <script src="~/js/tooltip.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $("#InterviewSelection_Code").find("option").eq(2).hide();
        $("#InterviewSelection_Code").find("option").eq(3).hide();
    });
</script>
<script>

    $(document).ready(function () {
        debugger;


        $.ajax({
            type: "POST",
            url: "/AccessFile/ViewAsBackGroundImage",
            data: { filename: '@Model.CandidatesPhotoFileName' },
            success: function (data, jqXHR, response) {
                if (jqXHR === "success") {
                    var mimeType = getMimeTypeFromFilename('@Model.CandidatesPhotoFileName');
                    debugger;
                    $('.emp_HeaderPic').css('background-image', "url('" + mimeType + data + "')");
                }
            },
            error: function (xhr, textStatus, errorThrown) {
                // Handle the error if needed
            }
        });

});


</script>
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "RaReject_form" }))
{
    <div class="slider-forms slider-forms-open RaRejectSlider">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('RaRejectSlider')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4 class="mb-4">RA Approval Reject</h4>
            <div class="profile-header position-relative pb-12 mb-5"
                 style="padding-bottom: 2px !important; padding-top: 5px !important;">
                <div class="row">
                    <div class="col-md-2">
                        <div class="image-input image-input-outline image-input-circle float-right emp_HeaderPic"
                             id="kt_image_4"
                             @*style="background-image: url('@Model.CandidatesPhoto')"*@>
                            <div class="image-input-wrapper">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-10 pl-7">
                        <div class="row">

                            <div class="flex-grow-1">
                                <!--begin::Title-->
                                <div class="d-flex justify-content-between flex-wrap">
                                    <div class="d-flex mr-3 header-profile-name app-track">
                                        <span class="">
                                            @Html.HiddenFor(m => m.ResumeDataBankCode)
                                            @Html.HiddenFor(m => m.ResumeDataBankGI)
                                            @Html.HiddenFor(m => m.ApplicantTrackingCode)
                                            @Model.ApplicantName
                                        </span>
                                        <span>
                                            ( @Model.ApplicantRefNo
                                            )
                                        </span>

                                    </div>

                                </div>

                                <!--end::Title-->
                                <!--begin::Content-->
                                <div class="d-flex flex-wrap justify-content-between">
                                    <div class="d-flex flex-column flex-grow-1 pr-8">
                                        <div class="d-flex flex-wrap mb-1">
                                            <span data-bs-toggle="tooltip"
                                                  data-bs-original-title="Designation"
                                                  class="header-profile-email mr-5 mb-lg-0 mb-2">
                                                <i class="fas fa-briefcase icon-nm mr-2"></i>@Model.ApplicantDesignation
                                            </span>
                                            <span data-bs-toggle="tooltip"
                                                  data-bs-original-title="Location"
                                                  class="header-profile-email mr-5 mb-lg-0 mb-2">
                                                <i class="fas fa-map-marker-alt icon-nm mr-1"></i>@Model.ApplicantLocation
                                            </span>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="profile-header-overflow"></div>
            </div>




            <!----- stepper start here --->
            <div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Email
                                ID
                            </label>
                            <div class="view-details">
                                @Model.Email
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Phone Number
                            </label>
                            <div class="view-details">
                                @Model.Phone
                            </div>
                        </div>
                    </div>
                </div>
                <!-- completed -->

                <div class="row">                  
                
                    <div id="rejectReason" class="col-md-6">
                        <div class="form-group">
                            <label>Reason For Reject</label>
                            @Html.DropDownListFor(m => m.RejectReasonCode, (SelectList)ViewBag.RejectReason, "--Select--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'rejectreason')" })
                            <span id="rejectreason"></span>
                        </div>
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed">                   
                    <div class="view-details align-right col-md-12">
                        <a type="button"
                           class="btn btn-default  mobile-full-width" onclick="RARejectSave()">
                            Reject
                        </a>
                    </div>



                </div>




            </div>
        </div>
    </div>
}