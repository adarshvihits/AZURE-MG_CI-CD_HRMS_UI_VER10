@model Hrms.Lite.Shared.DataBank.DTO.ApplicantTracking
<script src="~/js/bootstrap-datepicker.js"></script>

@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "interviewSchedule" }))
{
<div id="Scheduledinterview" class="slider-forms slider-forms-open scheduleSlider">
    <div class="slider-inner-style">
        <div class="slider-form-close" onclick="CloseSlider('scheduleSlider')">
            <i class="ki ki-close icon-xs text-muted"></i>
        </div>
        <h4 class="mb-4">Interview & Evaluation</h4>
        <div class="profile-header position-relative pb-12 mb-5"
             style="padding-bottom: 2px !important; padding-top: 5px !important;">
            <div class="row">
                <div class="col-md-2">
                    <div class="image-input image-input-outline image-input-circle float-right"
                         id="kt_image_4"
                         style="background-image: url('@Model.ApplicantTrackingDT.Interviewer.EmployeeAbsoluteUri')">
                        <div class="image-input-wrapper">
                        </div>
                    </div>
                </div>
                <div class="col-md-10 pl-7">
                    <div class="row">

                        <div class="flex-grow-1">
                            <!--begin::Title-->
                            <div class="d-flex justify-content-between flex-wrap">
                                <div class="d-flex mr-3 header-profile-name app-track">
                                    <span class="">
                                        @Html.HiddenFor(m => m.ApplicantTrackingDT.ResumeDataBankCode)
                                        @Html.HiddenFor(m => m.ApplicantTrackingDT.InterviewStatusType)
                                        @Model.ApplicantTrackingDT.EmployeeName
                                    </span>
                                    <span>
                                        ( @Model.ApplicantTrackingDT.EmployeeId
                                        )
                                    </span>

                                </div>

                            </div>

                            <!--end::Title-->
                            <!--begin::Content-->
                            <div class="d-flex flex-wrap justify-content-between">
                                <div class="d-flex flex-column flex-grow-1 pr-8">
                                    <div class="d-flex flex-wrap mb-1">
                                        <span data-bs-toggle="tooltip"
                                              data-bs-original-title="Designation"
                                              class="header-profile-email mr-5 mb-lg-0 mb-2">
                                            <i class="fas fa-briefcase icon-nm mr-2"></i>@Model.ApplicantTrackingDT.Designation.Name
                                        </span>
                                        <span data-bs-toggle="tooltip"
                                              data-bs-original-title="Department"
                                              class="header-profile-email mr-5 mb-lg-0 mb-2">
                                            <i class="fas fa-network-wired icon-nm mr-2"></i>@Model.ApplicantTrackingDT.Location.Name
                                        </span>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="profile-header-overflow"></div>
        </div>




        <!----- stepper start here --->
        <div>

            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Email
                            ID
                        </label>
                        <div class="view-details">
                            @Model.ApplicantTrackingDT.Email
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Phone Number
                        </label>
                        <div class="view-details">
                            @Model.ApplicantTrackingDT.MobileNo
                        </div>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Level</label>
                        <div class="view-details">
                            @*@Model.ApplicantTrackingDT.InterviewLevel.Name*@
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Interview Type</label>
                        @Html.DropDownListFor(m => m.ApplicantTrackingDT.InterviewType.Code, (SelectList)ViewBag.interviewTyp, "--Select--", new { @class = "form-control form-control-sm" })
                    </div>
                </div>
            </div>
            <!-- completed -->

            <div class="row">
                <div class="col-md-6">
                    <label>Interview Date</label>
                    <div class="input-group date">
                        @Html.TextBoxFor(m => m.ApplicantTrackingDT.InterviewDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "Interview Date" })
                        <div class="input-group-append">
                            <span class="input-group-text">
                                <i class="la la-calendar"></i>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="form-group">
                        <label class="mr-2">
                            Interview
                            Time
                        </label>
                        <div class="input-group timepicker">
                            @Html.TextBoxFor(m => m.ApplicantTrackingDT.InterviewTime, new { @class = "form-control form-control-sm", @maxlength = 8, @placeholder = "Interview Time", @onkeypress = "return onlyNumberKey(event)" })

                            @*<input class="form-control"
                                       id="kt_timepicker_2"
                                       readonly="readonly"
                                       placeholder="Interview Time"
                                       type="text">
                                <div class="input-group-append">
                                    <span class="input-group-text">
                                        <i class="la la-clock-o"></i>
                                    </span>
                                </div>*@
                        </div>
                    </div>
                </div>

            </div>
            <div class="row my-3">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Interview Mode</label>
                        @Html.DropDownListFor(m => m.ApplicantTrackingDT.InterviewMode.Code, (SelectList)ViewBag.interviewMod, "--Select--", new { @class = "form-control form-control-sm" })
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group ">
                        <label>Interviewer </label>
                        @Html.DropDownListFor(m => m.ApplicantTrackingDT.Interviewer.EmployeeCode, (SelectList)ViewBag.interviewer, "--Select--", new { @class = "form-control form-control-sm" })
                        <!-- <div data-field="email" data-validator="notEmpty" class="error-message">This Field is required</div> -->
                    </div>
                </div>

            </div>
            <div class="row my-3">

                <div class="col-md-6 ">
                    <a data-bs-toggle="tooltip"
                       data-bs-original-title="View File"
                       type="button"
                       class="btn btn-small btn-secondary mobile-full-width" onclick="window.open('@Model.ApplicantTrackingDT.Resume','_blank')">
                        <i class="icon-xl far fa-eye"></i>View
                        Resume
                    </a>
                </div>
            </div>
            <div class="row my-3">

                <div class="col-md-12">
                    <label>Remarks</label>
                    @Html.TextAreaFor(m => m.ApplicantTrackingDT.Remarks, new { @class = "form-control form-control-sm", @placeholder = "Remarks" })
                </div>
            </div>














            <div class="row card-footer-bottom-fixed">
                <div class="col-md-6 d-flex align-items-center ">
                    <div class="d-flex align-items-center">
                        <a type="button"
                           class="btn btn-default btn-hold  mobile-full-width mr-3" onclick="HoldOrReject('@Model.ApplicantTrackingDT.ResumeDataBankCode','Hold')">
                            Hold
                        </a>
                        @*<div class="hold mr-3 d-flex  align-items-center"
                             data-bs-toggle="tooltip"
                             data-bs-original-title="Hold" onclick="HoldOrReject('@Model.ApplicantTrackingDT.ResumeDataBankCode','Hold')">
                            <img src="images/pause (1).png">
                            <div class="pl-2">Hold</div>
                        </div>*@
                        <!-- <div class="hold ml-3 d-flex  align-items-center" data-bs-toggle="tooltip"
                data-bs-original-title="Hold">
                    <img src="images/pause (1).png" >
                    <div class="pl-2">Reject</div>
                </div>  -->
                        <a type="button"
                           class="btn btn-default btn-hold  mobile-full-width"  onclick="HoldOrReject('@Model.ApplicantTrackingDT.ResumeDataBankCode','Reject')">
                            Reject
                        </a>
                        @*<div class="cancelicon d-flex  align-items-center ml-10"
                             data-bs-toggle="tooltip"
                             data-bs-original-title="Reject" onclick="HoldOrReject('@Model.ApplicantTrackingDT.ResumeDataBankCode','Reject')">
                            <img src="images/close-button.png">
                            <div class="pl-2">Reject</div>
                        </div>*@
                    </div>

                </div>
                <div class="view-details align-right col-md-6">

                    <a type="button"
                       class="btn btn-default  mobile-full-width" onclick="Schedule('Schedule')">
                        Schedule
                    </a>
                </div>



            </div>




        </div>
    </div>
</div>
}