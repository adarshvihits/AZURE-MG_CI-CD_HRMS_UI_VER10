@model Hrms.Lite.Shared.DataBank.DTO.ApplicantTracking

<script src="~/js/tooltip.js"></script>
<script src="~/js/jquery.min.js"></script>
<script>

    $(document).ready(function () {
        debugger;


      $.ajax({

            type: 'GET',
            url: '/AccessFile/GetFileStorageType',

            success: function (data) {

                if (data == 'BLOB') ifAzure();
                else

                    $('.emp_HeaderPic').css('background-image', "url('" + '@Model.CandidatesPhoto' + "')");

            },
            error: function (xhr, textStatus, errorThrown) {
                if ($($.parseHTML(xhr.responseText)).filter(".Login_Session").length > 0) {
                    window.location.reload();
                }
                else {
                    document.body.id = "kt_body";
                    $('body').html(xhr.responseText);
                }
            }
        });
        function ifAzure() {
            $.ajax({
                type: "POST",
                url: "/AccessFile/ViewAsBackGroundImage", // do not hard code your url's
                data: { filename: '@Model.CandidatesPhotoFileName' },
                success: function (data, jqXHR, response) {

                    if (jqXHR = "success") {
                        var mimeType = getMimeTypeFromFilename('@Model.CandidatesPhotoFileName');
                        debugger
                        $('.emp_HeaderPic').css('background-image', "url('" + mimeType + data + "')");


                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                }
            });
        }
    

});


</script>







<div id="applicant" class="slider-forms slider-forms-open applTracker">
    <div class="slider-inner-style new-inner-style">
        <div class="slider-form-close" onclick="CloseSlider('applTracker')">
            <i class="ki ki-close icon-xs text-muted"></i>
        </div>
        <div class="location-slider">
            <h4 class="mb-4">Applicant Tracking</h4>
            <div class="profile-header position-relative pb-12 mb-5"
                 style="padding-bottom: 2px !important; padding-top: 5px !important;">
                <div class="row">
                    <div class="col-md-2">
                        <div class="image-input image-input-outline image-input-circle float-right emp_HeaderPic"
                             id="kt_image_4"
                             @*style="background-image: url(@Model.CandidatesPhoto)"*@>
                            <div class="image-input-wrapper">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-10 pl-7">
                        <div class="row">

                            <div class="flex-grow-1">
                                <!--begin::Title-->
                                <div class="d-flex justify-content-between flex-wrap">
                                    <div class="d-flex mr-3 header-profile-name app-track">
                                        <span class="">
                                            @Model.ApplicantName
                                        </span>
                                        <span>
                                            ( @Model.ApplicantRefNo
                                            )
                                        </span>

                                    </div>

                                </div>

                                <!--end::Title-->
                                <!--begin::Content-->
                                <div class="d-flex flex-wrap justify-content-between">
                                    <div class="d-flex flex-column flex-grow-1 pr-8">
                                        <div class="d-flex flex-wrap mb-1">
                                            <span data-bs-toggle="tooltip"
                                                  data-bs-original-title="Designation"
                                                  class="header-profile-email mr-5 mb-lg-0 mb-2">
                                                <i class="fas fa-briefcase icon-nm mr-2"></i>@Model.ApplicantDesignation
                                            </span>
                                            <span data-bs-toggle="tooltip"
                                                  data-bs-original-title="Department"
                                                  class="header-profile-email mr-5 mb-lg-0 mb-2">
                                                <i class="fas fa-map-marker-alt icon-nm mr-2"></i>@Model.ApplicantLocation
                                            </span>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="profile-header-overflow"></div>
            </div>

        </div>


        <!----- stepper start here --->
        <div class="add-padding">
            <div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Email
                                ID
                            </label>
                            <div class="view-details">
                                @Model.Email
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Phone Number
                            </label>
                            <div class="view-details">
                                @Model.Phone
                            </div>
                        </div>
                    </div>
                </div>



                @if (Model.Applicant_Tracker != null && Model.Applicant_Tracker.Count > 0)
                {
                    for (int i = Model.Applicant_Tracker.Count - 1; i >= 0; i--)
                    {
                        if (Model.Applicant_Tracker[i].InterviewDate != null || Model.Applicant_Tracker[i].InterviewLevel == "Job Posting")
                        {
                            <div class="step active completed">
                                <div class="v-stepper">
                                    <div class="circle">
                                        <i class="fa fa-check"></i>
                                    </div>
                                    <div class="line"></div>
                                </div>

                                <div class="stepper-content ">
                                    <div class="row-outer">

                                        <label class="view-title">
                                            @Model.Applicant_Tracker[i].InterviewLevel
                                        </label>
                                        <div class="view-details">
                                            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Applicant_Tracker[i].InterviewDate)),@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Applicant_Tracker[i].EmpIdName))
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="step ">
                                <div class="v-stepper">
                                    <div class="circle">
                                        <i class="fa fa-check"></i>
                                    </div>
                                    <div class="line"></div>
                                </div>

                                <div class="stepper-content">
                                    <div class="row-outer">
                                        <label class="view-title">
                                            @Model.Applicant_Tracker[i].InterviewLevel

                                        </label>
                                        <div class="view-details">
                                            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Applicant_Tracker[i].InterviewDate)),@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Applicant_Tracker[i].EmpIdName))
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
            </div>

            <!----- stepper end here --->
            @*<div class="row card-footer-bottom-fixed">

                    <div class="view-details align-right col-md-12">
                        <a data-bs-toggle="tooltip"
                           data-bs-original-title="View File"
                           type="button"
                           class="btn btn-small btn-secondary mobile-full-width" onclick="window.open('@Model.Resume')">
                            <i class="icon-xl far fa-eye"></i>View
                            Resume
                        </a>
                    </div>



                </div>*@


        </div>

    </div>
</div>