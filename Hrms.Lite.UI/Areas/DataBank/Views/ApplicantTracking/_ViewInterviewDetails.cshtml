@model Hrms.Lite.Shared.DataBank.DTO.ApplicantTracking
<div class="ihits-table table-border odd-even mobile-responsive-table pt-3 interview_details_view vertical-scroll-200">
    <table>
        <thead>
            @Html.HiddenFor(m => Model.ApplicantTrackingDTList.Count)
            <tr class="table-dark">    
                <th scope="col">Level</th>
                <th scope="col">Interviewer</th>
                <th scope="col">Date</th>
                <th scope="col">Feedback</th>
                <th scope="col">File</th>                             
            </tr>
        </thead>
        <tbody>
            @if (Model.ApplicantTrackingDTList != null && Model.ApplicantTrackingDTList.Count > 0)
            {

                for (int i = 0; i < Model.ApplicantTrackingDTList.Count; i++)
                {
                    <tr>
                        <td>@Model.ApplicantTrackingDTList[i].InterviewLevel</td>
                        <td>@Model.ApplicantTrackingDTList[i].EmployeeName</td>
                        <td>@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.ApplicantTrackingDTList[i].InterviewDate))</td>
                        <td>@Model.ApplicantTrackingDTList[i].Remarks</td>
                        <td><a data-bs-toggle="tooltip" title="" class="view_btn_appli" cursorshover="true" data-bs-original-title="" onclick="showDocument('@Model.ApplicantTrackingDTList[i].File.FileName', '@Model.ApplicantTrackingDTList[i].File.AbsoluteUri')"></a></td>
                    </tr>
                }
            }

        </tbody>
    </table>

</div>