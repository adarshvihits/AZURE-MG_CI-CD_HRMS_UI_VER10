@model Hrms.Lite.Shared.DataBank.DTO.ApplicantTracking
<div id="viewschedule" class="slider-forms slider-forms-open scheduleViewSlider">
    <div class="slider-inner-style">
        <div class="slider-form-close" onclick="CloseSlider('scheduleViewSlider')">
            <i class="ki ki-close icon-xs text-muted"></i>
        </div>
        <h4>Recruitment Details</h4>
        <div class="profile-header position-relative pb-12 mb-5"
             style="padding-bottom: 2px !important; padding-top: 5px !important;">
            <div class="row">
                <div class="col-md-2">
                    <div class="image-input image-input-outline image-input-circle float-right"
                         id="kt_image_4"
                         style="background-image: url('@Model.CandidatesPhoto')">
                        <div class="image-input-wrapper">
                        </div>
                    </div>
                </div>
                <div class="col-md-10 pl-7">
                    <div class="row">

                        <div class="flex-grow-1">
                            <!--begin::Title-->
                            <div class="d-flex justify-content-between flex-wrap">
                                <div class="d-flex mr-3 header-profile-name app-track">
                                    <span class="">
                                        @Model.ApplicantTrackingDT.EmployeeName
                                    </span>
                                    <span>
                                        ( @Model.ApplicantTrackingDT.EmployeeId
                                        )
                                    </span>

                                </div>

                            </div>

                            <!--end::Title-->
                            <!--begin::Content-->
                            <div class="d-flex flex-wrap justify-content-between">
                                <div class="d-flex flex-column flex-grow-1 pr-8">
                                    <div class="d-flex flex-wrap mb-1">
                                        <span data-bs-toggle="tooltip"
                                              data-bs-original-title="Designation"
                                              class="header-profile-email mr-5 mb-lg-0 mb-2">
                                            <i class="fas fa-briefcase icon-nm mr-2"></i>@Model.ApplicantTrackingDT.Designation.Name
                                        </span>
                                        <span data-bs-toggle="tooltip"
                                              data-bs-original-title="Department"
                                              class="header-profile-email mr-5 mb-lg-0 mb-2">
                                            <i class="fas fa-network-wired icon-nm mr-2"></i>@Model.ApplicantTrackingDT.Location.Name
                                        </span>

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="profile-header-overflow"></div>
        </div>
        @if (Model.ApplicantTracking_Details != null && Model.ApplicantTracking_Details.Count > 0)
        {

            for (int i = 0; i < Model.ApplicantTracking_Details.Count; i++)
            {
    <div class="reward-section border-none">
        <h5>
            <i class="fas fa-briefcase icon-md mr-2"></i>
            @*@Model.ApplicantTracking_Details[i].InterviewLevel.Name*@
        </h5>
        <div class="row">

            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">
                        Interview
                        Type
                    </label>
                    <div class="view-details">
                        @Model.ApplicantTracking_Details[i].InterviewType.Name
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">
                        Interview
                        Date
                    </label>
                    <div class="view-details">
                        @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.ApplicantTracking_Details[i].InterviewDate))
                    </div>
                </div>
            </div>
        </div>
        <div class="row">


            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">
                        Interview
                        Time
                    </label>
                    <div class="view-details">
                        @Model.ApplicantTracking_Details[i].InterviewTime
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">
                        Interview
                        Mode
                    </label>
                    <div class="view-details">
                        @Model.ApplicantTracking_Details[i].InterviewMode.Name
                    </div>
                </div>
            </div>
        </div>
        <div class="row">


            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Interviewer</label>
                    <div class="view-details">
                        @Model.ApplicantTracking_Details[i].Interviewer.EmployeeName
                    </div>
                </div>
            </div>

        </div>




        <div class="row">

            <div class="col-md-12">
                <div class="row-outer ">
                    <label class="view-title">Remarks</label>
                    <div class="view-details">
                        @Model.ApplicantTracking_Details[i].Remarks
                    </div>
                </div>
            </div>

        </div>

    </div>
            }
        }
                        





                                        </div>
</div>