@model Hrms.Lite.Shared.DataBank.LocationMarkingApplicability
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>

<script src="~/scripts/DataBank/locationMarkingApplicability.js"></script>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Location Marking Applicability

                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Location Marking Applicability

                    </li>

                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">


                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">

                            <div class="tab-items ">
                                <a class="btn-title active All" onclick="tabClick('All', '0');">
                                    All
                                    <span class="btn-notification AllCount">@Model.AllCount</span>
                                </a>
                            </div>
                            <div class="tab-items high">
                                <a class="btn-title Applicable_Emp" onclick="tabClick('Applicable_Emp','1');">
                                    Applicable Employees
                                    <span class="btn-notification CoreTeamCount">@Model.ApplicableEmpCount</span>
                                </a>
                            </div>


                            <div class="tab-items select-option">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search" onclick="$('#searchList').focus();"></i>
                                    </div>
                                    <input id="searchList" type="text" class="form-control form-control-sm"
                                           placeholder="Search Here" onkeyup="searchRows()">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>

                                
                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left" data-bs-original-title="Export to Excel" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>


                            </div>
                        </div>

                    </div>
                    <div id="AllListDiv">

                        @await Html.PartialAsync("~/Areas/DataBank/Views/LocationmarkingApplicability/_AllList.cshtml", Model)
                    </div>





                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_AdvancedEmployeeFilter.cshtml", Model.filter)
                    </div>







                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>