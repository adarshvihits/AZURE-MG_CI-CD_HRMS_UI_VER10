@model Hrms.Lite.Shared.Master.CostCenter
   
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "CostCenterSave" }))

{

    <div id="EditAssetAllocation" class="slider-forms slider-forms-open cost-save">
        <div class="slider-inner-style  new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('cost-save')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>
                    Employee V/s Cost Center
                </h4>
               
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-12">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Cost Center</label>
                                    @Html.DropDownListFor(m => m.CostCenterCode, (SelectList)ViewBag.CostCenter, "--Select--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'costcenter')" })
                                    <span id="costcenter"></span>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <div class="row card-footer-bottom-fixed">

                <div class="view-details align-right col-md-12">

                    <a type="button" onclick="onUpdateClick('batchupdate')"
                       class="btn btn-default  mobile-full-width">
                        Update
                    </a>
                </div>



            </div>
        </div>

    </div>
  
}
