@model Hrms.Lite.Shared.DataBank.CertificatePolicy


<script src="~/js/tooltip.js"></script>
<script>
    $('[data-bs-toggle="tooltip"]').tooltip({
        trigger: 'hover'
    })
</script>
@using (Html.BeginForm("", "", FormMethod.Post, new { @class = "display-flex", enctype = "multipart/form-data", @id = "Certificate_Entry" }))
{

    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table exitpopup-questionaire-list vertical-scroll-200 p-3">
        <div class="col-md-11">
            <div class="row-ithems">
                <div class="file-upload-form-group">
                    <label for="formFileMultiple" class="form-label">
                        Upload
                        File
                    </label><span class="Mandatory">*</span>

                    <div class="file-upload-form mb-1">
                        <div class="small-btn-group">
                            <button type="button" data-bs-toggle="tooltip" data-placement="top" data-bs-original-title="View Image" class="btn btn-icon btn-default" onclick="Preview()"><i class="icon-xl far fa-eye"></i></button>
                        </div>
                        <div data-bs-toggle="tooltip" data-bs-original-title=" Only pdf, doc, docx files
                                            are
                                            allowed , File size less than 1 MB.">
                            @Html.HiddenFor(m => m.Attachment.AbsoluteUri)
                            @Html.HiddenFor(m => m.Attachment.ActualFileName)
                            @Html.TextBoxFor(m => m.Attachment.FileData, new { @type = "file", @class = "form-control PreviewImage", @name = "profile_avatar", onchange = "CheckImageExtensionSize(this)", title = "" })
                            @*@Html.TextBoxFor(model => model.File.FileData, null, new { @type = "file", @class = "form-control PreviewImage", @onchange = "CheckExtensionAndSize(this)", title = "" })*@
                        </div>
                    </div>

                </div>
            </div>
            @if (Model.HasData == 1)
            {
                <div class="row-ithems">
                    <div class="row-outer">
                        <label class="view-title">View Last Uploaded</label>
                        <div class="view-details">
                            <a data-bs-toggle="tooltip" data-bs-original-title="View File"
                               class="btn btn-small btn-secondary mobile-full-width"
                               onclick="showDecompressedDocument()">
                                <i class="icon-xl far fa-eye"></i> View File
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="col-md-11" style=" display: flex; justify-content: right;">
            <button type="button" onclick="SaveCertificate()"
                    class="btn btn-default mobile-full-width " style=" margin: 0px; margin-top: 10px;">
                Save
            </button>

        </div>
    </div>


}

