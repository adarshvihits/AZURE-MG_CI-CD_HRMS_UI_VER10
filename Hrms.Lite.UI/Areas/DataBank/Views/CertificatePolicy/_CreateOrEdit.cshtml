@model Hrms.Lite.Shared.DataBank.CertificatePolicy
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script>
    $(document).ready(function () {
        debugger;
        var year = $('#Years').prop('checked');
        if (year) {
            $('.yeartxtbox').show();
        } else {
            $('.yeartxtbox').hide(); 
        }
    });




</script>
@using (Html.BeginForm("Save", "CertificatePolicySave", FormMethod.Post, new { id = "CertificatePolicySave" }))

{
    <div id="FunctionalStateedit" class="slider-forms slider-forms-open AddNewDiv">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddNewDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>Certificate Policy</h4>
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Certificate Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.Code)
                            @Html.HiddenFor(m => m.CertificateCode)

                            @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm dName", @placeholder = "Name", @onblur = "validate(this,'CertificateName')", maxlength = "120" })
                            <span id="CertificateName"></span>

                            @*<input type="text"
                    class="form-control form-control-sm"
                    placeholder="Name">*@
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Short Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm dShortName", @placeholder = "Short Name", @onblur = "validate(this,'CertificateShortName')", maxlength = "5" })
                            <span id="CertificateShortName"></span>
                            @*<input type="text"
                    class="form-control form-control-sm"
                    placeholder="Short Name">*@
                        </div>
                    </div>



                    <div class="col-md-12">
                        <div class="form-group">
                            <label>
                                Category

                                <span class="Mandatory">*</span>
                            </label>
                            @Html.DropDownListFor(model => model.CertificateCategory.Code, (SelectList)ViewBag.CertificateCategory, "--Select Category--", new { @class = "form-control form-control-sm LocArea", @onblur = "validate(this,'Category')" })

                            <span id="Category"></span>

                        </div>
                    </div>


                </div>





                <div class="row my-2">
                    <div class="col-md-12 d-flex align-items-center">
                        <h6>Validity :</h6>
                    </div>
                    <div class="col-md-6 d-flex align-items-center justify-content-between">
                        <div class="d-flex justify-content-between">
                            <label>Life Time </label>
                            <div class="checkbox-inline"
                                 style="padding-left: 15px;">
                                <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">

                                    @Html.CheckBoxFor(m => m.LifeTime, new { @onchange = "LifeTimeClick();" })
                                    <span></span>
                                </label>
                            </div>
                        </div>
                        <div class="d-flex justify-content-between">
                            <label>Years</label>
                            <div class="checkbox-inline"
                                 style="padding-left: 15px;">
                                <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">

                                    @Html.CheckBoxFor(m => m.Years, new { @onchange = "YearClick();" })
                                    <span></span>
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 ">
                        <div class="form-group yeartxtbox">

                            @Html.TextBoxFor(Model => Model.YearsValue, new { @class = "form-control form-control-sm dShortName", @placeholder = "Value", maxlength = "5" })



                        </div>

                    </div>

                </div>
                <div class="row">





                   



                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Maximum Reimbursement
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.TextBoxFor(Model => Model.MaximumReimbursement, new { @class = "form-control form-control-sm dShortName", @placeholder = "Maximum Reimbursement", @onblur = "validate(this,'CertificateShortName')", maxlength = "10" })
                            <span id="MaximumReimbursement"></span>

                        </div>
                    </div>

                </div>

                <div class="row my-3">

                    <div class="col-md-12">
                        @*<label class="view-title">Description</label>*@
                        <div class="view-details">
                            @if (Model.Mode == "CREATE")
                            {
                                <label>Description</label>
                                @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm dDescription", @placeholder = "Description", maxlength = "250", })
                                @Html.HiddenFor(model => Model.Description)
                                <span id="FunctionalStateDescription"></span>
                            }
                            @if (Model.Mode == "MODIFY")
                            {
                                <label class="view-title">Description</label>
                                @*<div class="view-details">*@

                                @Html.DisplayFor(Model => Model.Description, new { })
                                @Html.HiddenFor(model => Model.Description)
                                <span id="FunctionalStateDescription" class="text-danger"></span>

                            }
                        </div>
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12 align-right">
                        @if (Model.Mode == "CREATE")
                        {
                            @if (CurrentUserRoleActions.Create == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="Save('Save')">
                                    Save
                                </button>
                            }
                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            @if (CurrentUserRoleActions.Modify == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="Save('Modify','@Model.CertificateCode')">
                                    Modify
                                </button>

                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
