@model Hrms.Lite.Shared.DataBank.DTO.EditEmployeeInfo

<script>
    $(document).ready(function () {
        debugger;
        $('#EmployeeId').val("");
        //$('select > option:first').hide();
        $("#EmployeeId").find("option").eq(0).hide();
    });
</script>
<div id="addNewAssets" class="slider-forms slider-forms-open editEmployeeSlider">
    <div class="slider-inner-style">
        <div class="slider-form-close" onclick="CloseSlider('editEmployeeSlider')"><i class="ki ki-close icon-xs text-muted"></i></div>
        <h4>
            Edit Employee Info
        </h4>
        <div class="row pt-6 pb-1">
            <div class="col-md-12">
                <div class="">
                    <div class="radio-inline">
                        <label class="radio radio-outline radio-success">
                            @Html.RadioButtonFor(m => m.Type, "ACTIVE", new { @onchange = "GetEmployeeDropdown()" })
                            <span></span>Active
                        </label>
                        <label class="radio radio-outline radio-success">
                            @*<input type="radio" name="radios15">*@
                            @Html.RadioButtonFor(m => m.Type, "RESIGNED", new { @onchange = "GetEmployeeDropdown()" })
                            <span></span>Resigned
                        </label>

                    </div>
                </div>
            </div>

        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="row-outer">
                    @Html.DropDownListFor(m => m.EmployeeId, (SelectList)ViewBag.Empl, "Search by Employee name/ID", new
          {
              @class = "selectpicker sliderSearchInput form-control form-control-sm",
              @onchange = "OnEmpChange(this)",
              data_show_subtext = "true",
              data_live_search = "true"
      })
                </div>
            </div>

        </div>
        <div>

        </div>


     
        <div class="slider-search-field">
            @*<input type="text" class="sliderSearchInput" placeholder="ID/Name">*@
            @*@Html.DropDownListFor(m => m.EmployeeId, (SelectList)ViewBag.Empl, "--select--", new
                {
                    @class = "selectpicker sliderSearchInput form-control form-control-sm",
                    @onchange = "OnEmpChange(this)",
                    data_show_subtext = "true",
                    data_live_search = "true"
            })*@

            @await Html.PartialAsync("~/Areas/DataBank/Views/EditEmployeeInfo/_EmployeeCard.cshtml", Model.EmployeeHeader)

        </div>








    </div>
</div>