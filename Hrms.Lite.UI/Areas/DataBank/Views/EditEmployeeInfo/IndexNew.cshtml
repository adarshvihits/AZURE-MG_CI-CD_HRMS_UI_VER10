@model Hrms.Lite.Shared.DataBank.DTO.EditEmployeeInfo
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/scripts/DataBank/editEmployeeInfo.js?v=1"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Edit Employee Info</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>
                    <li class="breadcrumb-item">
                        Edit Employee Info
                    </li>
                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->
            <div class="card card-custom height-100per footer-row-fixed">
                <div class="card-body">
                    <!--begin: Search Form-->
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="radio-inline">
                                <label class="radio radio-outline radio-success">
                                    @Html.RadioButtonFor(m => m.Type, "ACTIVE", new { @onchange = "GetEmployeeDropdown()" })
                                    <span></span>Active
                                </label>
                                <label class="radio radio-outline radio-success">
                                    @Html.RadioButtonFor(m => m.Type, "RESIGNED", new { @onchange = "GetEmployeeDropdown()" })
                                    <span></span>Resigned
                                </label>
                            </div>
                            <div class="tab-items select-option">
                                <div class="form-group filter-combobox">
                                    @Html.DropDownListFor(m => m.FilterCombo.Code, (SelectList)ViewBag.Filter, "--Select--", new { @class = "form-control form-control-sm filterDropDown", @onchange = "onFilterComboChange(this)" })
                                </div>
                                <div class="sraech-slider" onclick="CursorFocusOnSearch()">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="Export to Excel" class="btn btn-excel" onclick="onExportToExcelClick()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
                    </div>
                    <!-- Table Section End -->
                    <!--<div id="editEmployeeList" class="hide">
                        @await Html.PartialAsync("_EditSummaryList", Model)
                    </div>-->
                    <!-- Table Section End -->
                    <!--<div id="editEmployeePendingList" class="hide">
                        @await Html.PartialAsync("_ApproveList", Model)
                    </div>
                    <div id="editEmployee" class="hide">
                        @await Html.PartialAsync("_EditEmployee", Model)
                    </div>-->
                    <!--end: Datatable-->
                    <div class="row row card-footer-bottom-fixed">
                        <div>
                            <a id="wageGradeMasterAdd" type="button" class="btn btn-default  mobile-full-width" onclick="TransactionHistory()">
                                Transaction History
                            </a>
                        </div>
                        <div class="col-md-12">
                            <button id="addNewAssets" type="button"
                                    class="btn btn-default float-right mobile-full-width slider-btn" onclick="onEditEmployeeClick()">
                                Edit Employee
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
</div>
<!--end::Content-->
<!--end::Entry-->
