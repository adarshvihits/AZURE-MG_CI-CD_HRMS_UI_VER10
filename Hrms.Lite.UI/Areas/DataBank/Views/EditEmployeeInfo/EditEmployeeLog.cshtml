@model Hrms.Lite.Shared.DataBank.DTO.EditEmployeeInfo
@{
    ViewData["Title"] = "EditEmployeeLog";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <!--end::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Edit Employee Log</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "EditEmployeeInfo", new { Area = "DataBank" })">Edit Employee info</a>
                    </li>

                    <li class="breadcrumb-item">
                        <a href="@Url.Action("TransactionHistory", "EditEmployeeInfo", new { Area = "DataBank" })">Transaction History</a>
                    </li>

                    <li class="breadcrumb-item">
                        Edit Employee Log
                    </li>

                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                    <!--begin: Search Form-->
                    <div class="profile-header position-relative box-shadow-none mb-2">
                        @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeHeader.cshtml", Model.EmployeeHeader)
                        @Html.HiddenFor(m => m.EmployeeGI)
                        <div class="profile-header-overflow"></div>
                    </div>

                    <div class="row pt-5">
                        <div class="col-md-6">
                            <div class="ihits-table table-border  mobile-responsive-table ">
                                <table>
                                    <thead>
                                        <tr class="table-light">
                                            <th scope="col">Name</th>
                                            <th scope="col">Old</th>
                                            <th scope="col">New</th>

                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.EditInfoDetailsList != null && Model.EditInfoDetailsList.Count > 0)
                                        {
                                            for (int i = 0; i < Model.EditInfoDetailsList.Count / 2; i++)
                                            {
                                                <tr>
                                                    <td data-label="Name">@Model.EditInfoDetailsList[i].Name</td>
                                                    <td data-label="Old">
                                                        @if ((Model.EditInfoDetailsList[i].Name == "DOB" || Model.EditInfoDetailsList[i].Name == "DOJ" || Model.EditInfoDetailsList[i].Name == "Date of Confirmation" ||

                                                         Model.EditInfoDetailsList[i].Name == "PF Enroll Date" || Model.EditInfoDetailsList[i].Name == "ESI Enroll Date") && Model.EditInfoDetailsList[i].Old != "")
                                                        {
                                                            <span class="gray-bg">
                                                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", DateTime.Parse(Model.EditInfoDetailsList[i].Old)))
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="gray-bg">@Model.EditInfoDetailsList[i].Old</span>
                                                        }

                                                    </td>
                                                    <td data-label="New">
                                                        @if ((Model.EditInfoDetailsList[i].Name == "DOB" || Model.EditInfoDetailsList[i].Name == "DOJ" || Model.EditInfoDetailsList[i].Name == "Date of Confirmation" ||

                                                       Model.EditInfoDetailsList[i].Name == "PF Enroll Date" || Model.EditInfoDetailsList[i].Name == "ESI Enroll Date") && Model.EditInfoDetailsList[i].New != "")
                                                        {
                                                            <span class="gray-bg">
                                                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", DateTime.Parse(Model.EditInfoDetailsList[i].New)))
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="gray-bg">
                                                                @Model.EditInfoDetailsList[i].New
                                                            </span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }




                                    </tbody>
                                </table>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group approve_cls">
                                    <label class="approve_date view-title">
                                        Entry user,Date and time
                                    </label>
                                    <div class="view-details">
                                        @Model.EntryUserName,@Model.EntryDateAndTime
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="ihits-table table-border  mobile-responsive-table ">
                                <table>
                                    <thead>
                                        <tr class="table-light">
                                            <th scope="col">Name</th>
                                            <th scope="col">Old</th>
                                            <th scope="col">New</th>

                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.EditInfoDetailsList != null && Model.EditInfoDetailsList.Count > 0)
                                        {

                                            for (int i = Model.EditInfoDetailsList.Count / 2; i < Model.EditInfoDetailsList.Count; i++)
                                            {
                                                <tr>
                                                    <td data-label="Name">@Model.EditInfoDetailsList[i].Name</td>
                                                    <td data-label="Old">
                                                        @if ((Model.EditInfoDetailsList[i].Name == "DOB" || Model.EditInfoDetailsList[i].Name == "DOJ" || Model.EditInfoDetailsList[i].Name == "Date of Confirmation" ||

                                                       Model.EditInfoDetailsList[i].Name == "PF Enroll Date" || Model.EditInfoDetailsList[i].Name == "ESI Enroll Date") && Model.EditInfoDetailsList[i].Old != "")
                                                        {
                                                            <span class="gray-bg">
                                                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", DateTime.Parse(Model.EditInfoDetailsList[i].Old)))
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="gray-bg">@Model.EditInfoDetailsList[i].Old</span>
                                                        }
                                                    </td>
                                                    <td data-label="New">
                                                        @if ((Model.EditInfoDetailsList[i].Name == "DOB" || Model.EditInfoDetailsList[i].Name == "DOJ" || Model.EditInfoDetailsList[i].Name == "Date of Confirmation" ||

                                                         Model.EditInfoDetailsList[i].Name == "PF Enroll Date" || Model.EditInfoDetailsList[i].Name == "ESI Enroll Date") && Model.EditInfoDetailsList[i].New != "")
                                                        {
                                                            <span class="gray-bg">
                                                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", DateTime.Parse(Model.EditInfoDetailsList[i].New)))
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="gray-bg">@Model.EditInfoDetailsList[i].New</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }


                                    </tbody>
                                </table>

                                <div class="col-md-6">
                                    <div class="form-group approve_cls">
                                        <label class="approve_date view-title">
                                            Approved user,Date and time
                                        </label>
                                        <div class="view-details">
                                            @Model.ApproveUserName,@Model.ApproveDateAndTime
                                        </div>
                                    </div>
                                </div>


                            </div>
                        </div>

                    </div>

                   


                    <!--begin: Datatable-->
                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->

    </div>
    <!--end::Entry-->

</div>
<!--end::Content-->
