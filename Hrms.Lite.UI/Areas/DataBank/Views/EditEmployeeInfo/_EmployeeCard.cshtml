@model Hrms.Lite.Shared.General.EmployeeHeader


<div class="search-profile-details">

    <div class="search-profile-img-outer">
        <div class="search-profile-img">
          
            <img src="/AccessFile/GetEmpThumbnail?EmployeeGI=@(Model.EmployeeGuid)" />
        </div>
        <div class="search-frofile-content">
            <span class="search-profile-title">@Model.EmployeeName</span>

            <span class="search-profile-designation">@Model.EmployeeId</span>

        </div>

    </div>
    <div class="d-flex align-items-center justify-content-between mb-2">
        <span class="text-muted text-hover-primary">Fun.Designation:</span>
        <span class="font-weight-bold mr-2">@Model.Designation.Name</span>
    </div>
    <div class="d-flex align-items-center justify-content-between mb-2">
        <span class="text-muted text-hover-primary">Department:</span>
        <span class="font-weight-bold mr-2">
            @Model.Department.Name
        </span>
    </div>
    <div class="d-flex align-items-center justify-content-between mb-2">
        <span class="text-muted text-hover-primary">Location:</span>
        <span class="font-weight-bold mr-2">
            @Model.Location.Name
        </span>
    </div>
    <div class="d-flex align-items-center justify-content-between mb-2">
        <span class="text-muted text-hover-primary">Category:</span>
        <span class="font-weight-bold mr-2">
            @Model.Category.Name
        </span>
    </div>

    <div class="button-group mt-4">
        <a href="@Url.Action("Create", "EditEmployeeInfo", new { Area = "Databank", EmployeeGI=Model.EmployeeGuid })" type="button" class="btn btn-default mr-2 float-right">
            Proceed
        </a>
        <button type="button" class="btn btn-secondary searchProfileSliderClose" onclick="CloseCard()">
            Cancel
        </button>
    </div>
</div>
