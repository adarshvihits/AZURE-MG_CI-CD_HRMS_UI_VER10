<div class="ihits-table table-border hover-color odd-even mobile-responsive-table job-transition-delete-list">
    @Html.HiddenFor(m => m.JobTransitionList.Count)
    <table id="JobTransitionDeleteTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">Type</th>
                <th scope="col">Approval Status</th>
                <th data-bs-toggle="tooltip" title="Effective Date" scope="col">Eff.date</th>
                <th scope="col">Order Date</th>
                <th scope="col" data-bs-toggle="tooltip" title=" Salary Revised" scope="col">Sal Rev</th>
                <th scope="col">Action</th>

            </tr>
        </thead>
        <tbody>
            @if (Model.JobTransitionList != null && Model.JobTransitionList.Count > 0)
            {
                for (int i = 0; i < Model.JobTransitionList.Count; i++)
                {
                    <tr>
                        <td data-label="ID">@Model.JobTransitionList[i].EmployeeID</td>
                        <td data-label="Employee Name">
                            @Model.JobTransitionList[i].EmployeeName
                        </td>
                        <td data-label="Designation">@Model.JobTransitionList[i].Designation</td>
                        <td data-label="Department">@Model.JobTransitionList[i].Department </td>
                        <td data-label="Location">@Model.JobTransitionList[i].Location</td>
                        <td data-label="Progression Type">@Model.JobTransitionList[i].TransitionType</td>
                        <td data-label="Approvel Status">@Model.JobTransitionList[i].ApprovalStatus</td>
                        <td data-label="Eff.date">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.JobTransitionList[i].EffectiveDate))</td>
                        <td data-label="Order Date">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.JobTransitionList[i].OrderDate))</td>
                        <td data-label="Salary Revised">@Model.JobTransitionList[i].PRApplicable</td>
                        <td data-label="Action">
                            <a data-bs-toggle="tooltip" title="" id="banknamedelete" type="button" class="btn btn-icon  icon-only mobile-full-width  btn-delete" data-bs-original-title="Delete" onclick="onDeleteClick('@Model.JobTransitionList[i].EmployeeGI','@Model.JobTransitionList[i].HistoryGI')">
                                <i class="icon-xl far fa-trash-alt"></i>
                            </a>
                        </td>

                    </tr>
                }
            }


        </tbody>
    </table>
</div>