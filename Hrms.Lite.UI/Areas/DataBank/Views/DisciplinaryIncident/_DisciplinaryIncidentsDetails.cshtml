            <div class="row">
                @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeSliderHeader.cshtml", Model.EmployeeHeader)
            </div>
            <div class="profile-header-overflow"></div>
        </div>


        <div class="row">
            <div class="col-md-12">

                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Incident</label>
                            <div class="view-details">
                                @Model.IncidentsAction.Incidents.Incident
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Category
                                
                            </label>
                            <div class="view-details">
                                @Model.IncidentsAction.Incidents.IncidentType
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Occured
                                Date
                            </label>
                            <div class="view-details">
                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.IncidentsAction.Incidents.Incidentdate))
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Reported By
                            </label>
                            <div class="view-details">
                                @Model.IncidentsAction.Incidents.ReportedBy
                            </div>
                        </div>
                    </div>

                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Reported
                                Date
                            </label>
                            <div class="view-details">
                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.IncidentsAction.Incidents.Reporteddate))
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Attach File</label>
                            @Html.HiddenFor(model => Model.IncidentsAction.Incidents.File.AbsoluteUri)
                            @Html.HiddenFor(model => Model.IncidentsAction.Incidents.File.FileName)
                            <div class="view-details">
                                <a type="button" class="btn btn-secondary mobile-full-width" data-bs-toggle="tooltip" title="" data-bs-original-title="View File"
                                   @*onclick="ViewFile('@Model.RewardsLog[i].RewardsRequest.File.AbsoluteUri')"*@ onclick="showDocument('@Model.IncidentsAction.Incidents.File.FileName','@Model.IncidentsAction.Incidents.File.AbsoluteUri')">
                                    <i class="icon-xl far fa-eye"></i>View File
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">

                    <div class="col-md-12">
                        <div class="row-outer">
                            <label class="view-title">Action Taken</label>
                            <div class="view-details">
                                @Model.IncidentsAction.Incidents.ActionTaken
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">

                    <div class="col-md-12">
                        <div class="row-outer">
                            <label class="view-title">
                                Incident
                                Narration
                            </label>
                            <div class="view-details">
                                @Model.IncidentsAction.Incidents.Narration
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>



        <div class="row card-footer-bottom-fixed border-none mt-2">
            <div class="col-md-12 pr-4 float-right-btn">
                <a data-bs-toggle="tooltip" title="Delete" type="button"
                        class="btn btn-icon btn-delete big-btn"
                        onclick="onDeleteDisciplinaryIncidents('@Model.DisciplinaryIncidentGI')">
                    <i class="icon-xl far fa-trash-alt"></i>
                </a>

            </div>
        </div>




    </div>
</div>
