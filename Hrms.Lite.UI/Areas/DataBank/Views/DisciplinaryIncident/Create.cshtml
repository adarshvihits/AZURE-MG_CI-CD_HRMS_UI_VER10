@model Hrms.Lite.Shared.DataBank.DTO.DisciplinaryIncidents
@{
    ViewData["Title"] = "Incidents";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/scripts/DataBank/disciplinaryIncidents.js"></script>

<script>
    const myTimeout = setTimeout(changeFocus, 500);

    function changeFocus() {
        $('#IncidentsAction_Incident_Code').focus();
    }
</script>
<!--begin::Header-->
@using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", enctype = "multipart/form-data", @id="DisplinaryIncSave" }))
{
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->
            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Incident Management</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot p-0 mt-1 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                                <i class="icon-nm fas fa-home mt-1"></i>
                            </a>
                        </li>
                        <li class="breadcrumb-item text-muted">
                            <a href="@Url.Action("Index", "DisciplinaryIncident", new { Area = "DataBank" })" class="">Incident Management List</a>
                        </li>
                        <li class="breadcrumb-item text-muted">
                           Incident Management
                        </li>
                    </ul>
                </div>
            </div>
            <!--end::Header Menu Wrapper-->
            <!--begin::Topbar-->
           
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->


    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->
                @{
                    int tabindex = 0;
                }
                <div class="row height-100per">

                    <div class="col-md-12">
                        <div class="card card-custom height-100per">

                            <div class="card-body">
                                <div class="profile-header position-relative box-shadow-none mb-2">
                                    @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeHeader.cshtml", Model.EmployeeHeader)
                                    @Html.HiddenFor(Model => Model.EmployeeGI)
                                    <div class="profile-header-overflow"></div>
                                </div>
                                <div class="page_white mt-5">
                                    <div class="row">
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>Incident</label>

                                                @Html.DropDownListFor(m => m.IncidentsAction.Incident.Code, (SelectList)ViewBag.Inc, "--Select Incident--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'incident')", tabindex = "@(++tabindex)" })
                                                <span id="incident"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label>Category</label>

                                                @Html.DropDownListFor(m => m.IncidentsAction.IncidentType.Code, (SelectList)ViewBag.Ity, "--Select Category--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'incidenttype')", tabindex = "@(++tabindex)" })
                                                <span id="incidenttype"></span>
                                            </div>
                                        </div>


                                        <div class="col-md-2">
                                            <label>Occured Date</label>
                                            <div class="input-group date">
                                                @Html.TextBoxFor(m => m.IncidentsAction.Incidentdate, "{0:dd/MMM/yyyy}", new { @class = "form-control kt_datepicker_8", @placeholder = "Occured Date", @readonly = "readonly", @onchange = "validate(this,'incidentdate')", tabindex = "@(++tabindex)" })

                                                <div class="input-group-append">
                                                    <span class="input-group-text">
                                                        <i class="la la-calendar"></i>
                                                    </span>
                                                </div>
                                            </div>
                                            <span id="incidentdate"></span>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>Reported By</label>
                                                @Html.TextBoxFor(m => m.IncidentsAction.ReportedBy, new { @class = "form-control form-control-sm", @placeholder = "Reported By", @onblur = "capitalizeFirstLetter(this,'reportedby')", @maxlength = 120, tabindex = "@(++tabindex)" })
                                                <span id="reportedby"></span>
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <label>Reported Date</label>
                                            <div class="input-group date">
                                                @Html.TextBoxFor(m => m.IncidentsAction.Reportedtdate, "{0:dd/MMM/yyyy}", new { @class = "form-control kt_datepicker_8", @placeholder = "Reported Date", @onchange = "validateReportedDate(this,'reporteddate')", tabindex = "@(++tabindex)" })

                                                <div class="input-group-append">
                                                    <span class="input-group-text">
                                                        <i class="la la-calendar"></i>
                                                    </span>
                                                </div>
                                            </div>
                                            <span id="reporteddate"></span>
                                        </div>
                                    </div>






                                    <div class="row">


                                        <div class="col-md-4">
                                            <div class="file-upload-form-group">
                                                <label for="formFileMultiple" class="form-label">Attach File</label>

                                                <div class="file-upload-form mb-1">
                                                    <div class="small-btn-group">
                                                        <button type="button" data-bs-toggle="tooltip" data-placement="top" data-bs-original-title="View Image" class="btn btn-icon btn-default" onclick="Preview()" , tabindex="@(++tabindex)"><i class="icon-xl far fa-eye"></i></button>
                                                    </div>
                                                    @*<input class="form-control" type="file" id="formFileMultiple" multiple>*@
                                                <div  data-bs-toggle="tooltip" data-bs-original-title=" Only pdf, doc, docx files
                                            are
                                            allowed , File size less than 1 MB.">
                                                    @Html.TextBoxFor(model => model.IncidentsAction.File.FileData, null, new { type = "file", @class = "form-control PreviewImage", id = "formFileMultiple", onchange = "CheckFIleExtensionSize(this)", tabindex = "@(++tabindex)",title="" })
                                                </div>
                                                </div>
                                                @*<label class="font-size-xs">Only pdf, Jpeg,Jpg,Png and bmp files are allowed , File size should be less than 1 MB</label>*@
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label>Action Taken</label>

                                                @Html.DropDownListFor(m => m.IncidentsAction.ActionTaken.Code, (SelectList)ViewBag.Atk, "--Select Action taken--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'actiontaken')", tabindex = "@(++tabindex)" })
                                                <span id="actiontaken"></span>
                                            </div>
                                        </div>


                                    </div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label>Narration</label>
                                                @Html.TextAreaFor(m => m.IncidentsAction.Narration, new { @class = "form-control form-control-sm", @placeholder = "Incident Narration", @onblur = "validate(this,'narration')", @maxlength = 250, tabindex = "@(++tabindex)" })
                                                <span id="narration"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <h6 class="main-title mt-3 mb-3">LogList</h6>
                                @await Html.PartialAsync("_DisciplinaryIncidentsLogList", Model.IncidentsAction.IncidentLog)
                                <div id="DisciplinaryIncidentsLog" class="hide">
                                    @await Html.PartialAsync("_DisciplinaryIncidentsLog", Model)
                                </div>
                                <div class="row card-footer-bottom-fixed">

                                    <div class="col-md-12 align-right">
                                        <button type="button" class="btn btn-default  mobile-full-width" onclick="validateAllDisciplinaryIncidents()">
                                            Save
                                        </button>
                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>
                </div>




                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->
    </div>
    <!--end::Content-->
}