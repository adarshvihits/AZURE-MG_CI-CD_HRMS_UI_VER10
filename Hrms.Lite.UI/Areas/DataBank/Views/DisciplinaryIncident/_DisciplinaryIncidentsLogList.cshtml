@model IList<Hrms.Lite.Shared.DataBank.DTO.IncidentLog>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table disciplinary-incidents-entry">
    <table>
        <thead>
            <tr class="table-dark">
                <th scope="col">SlNo</th>
                <th scope="col">
                    Incident

                </th>
                <th scope="col">Category</th>
                <th scope="col">Occured Date</th>
                <th scope="col">Action Taken</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {

                for (int i = 0; i < Model.Count; i++)
                {
                    <tr>
                        <td data-label="SlNo">@(i + 1)</td>
                        <td data-label="Code">
                            @Html.HiddenFor(Model => Model[i].DisciplinaryIncidentGI)
                            <a id="EditDisciplinaryIncidentsEntryDetails" class="slider-btn" onclick="onDisciplinaryLogClick('@Model[i].DisciplinaryIncidentGI')">@Model[i].Incidents.Incident</a>
                            @*<div id="assetlog" class="hide">
                                    @await Html.PartialAsync("_AssetLog", Model)
                                </div>*@

                        </td>
                        <td data-label="Incident Type">@Model[i].Incidents.IncidentType</td>
                        <td data-label="Incident Date">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model[i].Incidents.Incidentdate))</td>
                        <td data-label="Action Taken">@Model[i].Incidents.ActionTaken</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>