@model Hrms.Lite.Shared.DataBank.DTO.DisciplinaryIncidents
<div id="EditDisciplinaryIncidentsEntryDetails"
     class="slider-forms slider-forms-open disciplinaryclose">
    <div class="slider-inner-style">
        <div class="slider-form-close" onclick="CloseSlider('disciplinaryclose')">
            <i class="ki ki-close icon-xs text-muted"></i>
        </div>


        <h4>Log</h4>
        <div class="row">
            <div class="col-md-12">

                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Incident</label>
                            <div class="view-details">
                                @Model.IncidentsAction.Incidents.Incident
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Incident
                                Type
                            </label>
                            <div class="view-details">
                                @Model.IncidentsAction.Incidents.IncidentType
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Incident
                                Date
                            </label>
                            <div class="view-details">
                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.IncidentsAction.Incidents.Incidentdate))
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Reported
                                By
                            </label>
                            <div class="view-details">
                                @Model.IncidentsAction.Incidents.ReportedBy
                            </div>
                        </div>
                    </div>

                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Reported
                                Date
                            </label>
                            <div class="view-details">
                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.IncidentsAction.Incidents.Reporteddate))
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Attach
                                File
                            </label>
                            @Html.HiddenFor(model => Model.IncidentsAction.Incidents.FileUri)
                            <div class="view-details">
                                <a type="button"
                                   class="btn btn-secondary mobile-full-width" onclick="viewFileFromDT()">
                                    <i class="icon-xl far fa-eye"></i>View
                                    File
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">

                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Action
                                Taken
                            </label>
                            <div class="view-details">
                                @Model.IncidentsAction.Incidents.ActionTaken
                            </div>
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="row-outer">
                            <label class="view-title">
                                Incident
                                Narration
                            </label>
                            <div class="view-details">
                                @Model.IncidentsAction.Incidents.Narration
                            </div>
                        </div>
                    </div>
                </div>


            </div>
        </div>


    </div>
</div>