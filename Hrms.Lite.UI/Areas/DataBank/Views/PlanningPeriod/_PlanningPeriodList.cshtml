@model Hrms.Lite.Shared.Master.PlanningPeriod
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");

        //$('#EvaluationMasterTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');

    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table PlanningPeriodr-list pt-1">
    @Html.HiddenFor(m => m.PlanningPeriodList.Count)
    <table id="EvaluationMasterTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">From Date</th>
                <th scope="col">To Date</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.PlanningPeriodList != null && Model.PlanningPeriodList.Count > 0)
                {
                    for (int i = 0; i < Model.PlanningPeriodList.Count; i++)

                    {
                        <tr>
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(m => m.PlanningPeriodList[i].EditActive)
                            <td data-label="Name">@Model.PlanningPeriodList[i].Name</td>
                            <td data-label="Short Name">@Convert.ToDateTime(Model.PlanningPeriodList[i].From).ToString("dd-MMM-yyyy")</td>
                            <td data-label="Short Name">@Convert.ToDateTime(Model.PlanningPeriodList[i].To).ToString("dd-MMM-yyyy")</td>
                            <td data-label="Actions">
                                <div>
                                    @if (CurrentUserRoleActions.Modify == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="addNewEvaluationMaster"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddOrEditClick('MODIFY', '@Model.PlanningPeriodList[i].GI', '@Model.PlanningPeriodList[i].LogGI',@i)">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="addNewEvaluationMaster"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddOrEditClick('MODIFY', '@Model.PlanningPeriodList[i].GI', '@Model.PlanningPeriodList[i].LogGI',@i);
                                           swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#newRequestSlider');});">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    <!-- delete Slider  start-->
                                    @if (CurrentUserRoleActions.Delete == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="id=PlanningPerioddelete"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.PlanningPeriodList[i].GI', '@Model.PlanningPeriodList[i].LogGI', 'DELETE',@i)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                    else
                                    { 
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="id=PlanningPerioddelete"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.PlanningPeriodList[i].GI', '@Model.PlanningPeriodList[i].LogGI', 'DELETE',@i);
                                           swal.fire(MasterPersmissionMsg);">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                    </div>
                                <!-- <end delete section></end> -->
                            </td>
                        </tr>
                    }
                }


            }
        </tbody>
    </table>
</div>