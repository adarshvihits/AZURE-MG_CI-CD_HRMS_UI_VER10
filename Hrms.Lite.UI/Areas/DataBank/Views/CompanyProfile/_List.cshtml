<script src="~/js/settings.js"></script>
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Account.Login CurrentUser = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Account.Login>(Context.Session.GetString("User"));
    int count = Model.CompanyProfileDetailedView?.Count ?? 0;
}
<script>
    $(document).ready(function () {
        salVisible = @CurrentUser.authUser.SalaryVisibility;
        //fillData();
    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table group-profile-report ">
     @Html.Hidden("CompanyProfileCount", count)
    <table class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col" data-bs-toggle="tooltip" title="Date Of Join">DOJ</th>
                @if (CurrentUser.authUser.SalaryVisibility != 0)
                {
                    <th scope="col">Gross Pay</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model.CompanyProfileDetailedView != null && Model.CompanyProfileDetailedView.Count > 0)
            {

                for (int i = 0; i < Model.CompanyProfileDetailedView.Count; i++)
                {
                    <tr>
                        <td data-label="ID">@Model.CompanyProfileDetailedView[i].EmployeeID</td>
                        <td data-label="Employee Name">
                            <a href="@Url.Action("GetEmployeeProfileDetails", "CompanyProfile", new {EmployeeGI =Model.CompanyProfileDetailedView[i].EmployeeGI,FinancialYear=0,Breadcrumb="CompanyProfile",BreadcrumbName=" Company Profile List",  Area = "DataBank" })">@Model.CompanyProfileDetailedView[i].EmployeeName</a>
                        </td>
                        <td data-label="Designation">@Model.CompanyProfileDetailedView[i].Designation</td>
                        <td data-label="Department">@Model.CompanyProfileDetailedView[i].Department</td>
                        <td data-label="Location">@Model.CompanyProfileDetailedView[i].Location</td>
                        <td data-label="DOJ">@Model.CompanyProfileDetailedView[i].DOJ</td>
                        @if (CurrentUser.authUser.SalaryVisibility != 0)
                        {
                            <td data-label="Gross Pay">@Model.CompanyProfileDetailedView[i].GP</td>
                        }
                    </tr>
                }
            }

        </tbody>
    </table>
</div>