@model Hrms.Lite.Shared.DataBank.DTO.CompanyProfile
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Account.Login CurrentUser = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Account.Login>(Context.Session.GetString("User"));
}
<div class="row mb-5">
    <div class="col-md-4">
        <div class="inner-pro">
            <div class="ihits-table table-border  mobile-responsive-table employee-profile-report-list company-list  vertical-scroll-180
                                            ">
                <table>
                    <thead>
                        <tr class="table-light">
                            <th scope="col">Group Company</th>
                            <th scope="col">Count</th>
                            @if (CurrentUser.authUser.SalaryVisibility != 0)
                            {
                                <th scope="col">GP</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.GroupCompanyDetails != null && Model.GroupCompanyDetails.Count > 0)
                        {

                            for (int i = 0; i < Model.GroupCompanyDetails.Count; i++)
                            {
                                <tr>
                                    <td data-label="Designation">
                                        <a href="@Url.Action("GetCompanyProfileDetails", "CompanyProfile", new {CODE =Model.GroupCompanyDetails[i].Code,NAME=Model.GroupCompanyDetails[i].Name,Type="Group Company",GroupCompanyCode=Model.GrpCmpCode , Area = "DataBank" })">@Model.GroupCompanyDetails[i].Name</a>
                                    </td>
                                    <td data-label="Count">@Model.GroupCompanyDetails[i].Count</td>
                                    @if (CurrentUser.authUser.SalaryVisibility != 0)
                                    {
                                        <td data-label="Department">@Model.GroupCompanyDetails[i].GP</td>
                                    }
                                </tr>
                            }
                        }



                    </tbody>
                </table>
                <div style="height:40px;">
                    <table>
                        <tbody style="height:40px;">
                            <tr class="table-secondary" style="position:sticky; bottom:0;">
                                <td data-label="Designation">
                                    Total
                                </td>
                                <td data-label="Count">@ViewBag.GroupCompanyCount</td>
                                @if (CurrentUser.authUser.SalaryVisibility != 0)
                                {
                                    <td data-label="Department">@ViewBag.GroupCompanyGP</td>
                                }
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
