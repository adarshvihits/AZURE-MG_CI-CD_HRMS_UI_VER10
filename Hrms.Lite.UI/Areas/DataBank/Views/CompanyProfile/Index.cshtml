@model Hrms.Lite.Shared.DataBank.DTO.CompanyProfile
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Account.Login CurrentUser = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Account.Login>(Context.Session.GetString("User"));
}
<script src="~/scripts/DataBank/Reports/growthHistory.js"></script>
<script>
    $(document).ready(function () {
          salVisible = @CurrentUser.authUser.SalaryVisibility;
      
    });
</script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>


<script src="~/scripts/DataBank/companyprofile.js"></script>

<script>
    $(document).ready(function () {
        checkFilterApplied();
        window.history.replaceState(null, '', window.location.pathname);
    });
    function ApplyFilter(mode) {
        debugger
        if (mode == 'apply') {
            if (filterApplicable >= 1) {
                onGroupCompanyChange();
                CloseSlider('basicFilter');
                $('#filterForm').removeClass('filter-apply');
            }
            else {
                showSpinner();
                onGroupCompanyChange();
                CloseSlider('basicFilter');
                $('#filterForm').addClass('filter-apply');
            }

        }
        else {
            showSpinner();
            filterApplicable = 1;
            $('.reset').val('');
            $('#Optional_Filter_EmploymentStatus_Code').val(0);
            $('#filterForm').removeClass('filter-apply');
            onGroupCompanyChange();
        }
    }

</script>

<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Company Profile</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>

                    <li class="breadcrumb-item">
                        Company Profile

                    </li>

                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per">

                <div class="card-body " style="padding:25px 50px;">





                    <!-- Table Section -->
                    <div class="company-pro">
                        <div class="row tab-style-button">
                            <div class="tab-button-wrap ">
                                <div class="tab-items mt-2">
                                    <!-- <label>Group By</label> -->
                                    <div class="form-group filter-combobox mt-0 " style="width:280px;">

                                        @Html.DropDownListFor(m => m.GrpCmpCode, (SelectList)ViewBag.GrpCmpny, "All",new { @class = "form-control form-control-sm", @onchange = "onGroupCompanyChange()" })
                                    </div>
                                </div>
                                <div class="tab-items select-option ">



                                    <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="" data-bs-original-title="Filter" cursorshover="true">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>
                                    <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left" data-bs-original-title="Export to Excel">
                                        <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                    </a>
                                </div>

                            </div>
                        </div>
                        <div id="cProfile">
                            @await Html.PartialAsync("_CompanyProfile")
                        </div>


                        <!-- Table Setion End -->
                    </div>

                    <!--end: Datatable-->
                </div>
            </div>

            <div id="filterSlider">
                @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
            </div>
            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
