            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Company Profile</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>

                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index", "CompanyProfile", new { Area = "DataBank",GroupCompanyCode=Model.GrpCmpCode })" class="">
                        Company Profile</a>
                    </li>
                    <li class="breadcrumb-item">
                        Company Profile List
                    </li>

                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
      
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
