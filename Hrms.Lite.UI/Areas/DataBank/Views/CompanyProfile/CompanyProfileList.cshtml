
@model Hrms.Lite.Shared.DataBank.DTO.CompanyProfile
@{ ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>

<script src="~/scripts/DataBank/companyprofile.js?v=1"></script>

<script>
    $(document).ready(function () {
        debugger;

        //$('#CompanyProfileListTable').DataTable({
        //    "pageLength": 25,
        //    "language":
        //    {
        //        searchPlaceholder: "Search",
        //    }
        //});

        //$(".dataTables_filter").addClass("dataTables_filter_trn");
        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style')


    });
    function ApplyFilter(mode) {
        debugger
        if (mode == 'apply') {
            if (filterApplicable >= 1) {
                $.ajax({

                    type: 'POST',
                    url: '/DataBank/CompanyProfile/ApplyFilter',
                    dataType: 'html',
                    data: $('#BasicFilter').serialize(),
                    success: function (result) {
                        debugger
                        CloseSlider('basicFilter');
                        if ($($.parseHTML(result)).filter(".Login_Session").length > 0) {
                            window.location.reload();
                        }
                        else {

                            $('#cmpProfList').html("");
                            $('#cmpProfList').html(result);
                            $('#cmpProfList').removeClass('hide');
                            hideSpinner();
                        }


                    },


                    error: function (xhr, textStatus, errorThrown) {
                        $('body').html(xhr.responseText);
                    }
                });
                $('#filterForm').removeClass('filter-apply');
            }
            else {
                showSpinner();
                $.ajax({

                    type: 'POST',
                    url: '/DataBank/CompanyProfile/ApplyFilter',
                    dataType: 'html',
                    data: $('#BasicFilter').serialize(),
                    success: function (result) {
                        debugger
                        CloseSlider('basicFilter');
                        if ($($.parseHTML(result)).filter(".Login_Session").length > 0) {
                            window.location.reload();
                        }
                        else {
                            $('#cmpProfList').html("");
                            $('#cmpProfList').html(result);

                            $('#cmpProfList').removeClass('hide');
                            hideSpinner();
                        }

                    },


                    error: function (xhr, textStatus, errorThrown) {
                        $('body').html(xhr.responseText);
                    }
                });
                $('#filterForm').addClass('filter-apply');
            }

        }
        else {
            showSpinner();
            filterApplicable = 1;
            $('.reset').val('');
            $('#Optional_Filter_EmploymentStatus_Code').val(0);
            $('#filterForm').removeClass('filter-apply');
            $.ajax({

                type: 'POST',
                url: '/DataBank/CompanyProfile/ApplyFilter',
                dataType: 'html',
                data: $('#BasicFilter').serialize(),
                success: function (result) {
                    debugger
                    if ($($.parseHTML(result)).filter(".Login_Session").length > 0) {
                        window.location.reload();
                    }
                    else {
                        $('#cmpProfList').html("");
                        $('#cmpProfList').html(result);
                        $('#cmpProfList').removeClass('hide');
                        hideSpinner();
                    }


                },


                error: function (xhr, textStatus, errorThrown) {
                    $('body').html(xhr.responseText);
                }
            });
        }
    }
</script>
<!--begin::Header-->
