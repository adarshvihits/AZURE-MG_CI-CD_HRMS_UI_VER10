@model Hrms.Lite.Shared.DataBank.DTO.JobPosting
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/DataBank/jobPosting.js"></script>

<script>

    $(document).ready(function () {
        debugger
        if ('@ViewBag.RedirectigFRom'== 'FromRecruitDashBoard') {
            $(".tab2").addClass('active');
            $(".tab1").removeClass('active');
             prevTab = 'tab2';
            currentTab = 2;

        }
    
        });

</script>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Job Posting</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Job Posting
                    </li>

                </ul>
            </div>
        </div>
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items high">
                                <span class="btn-title tab1 active" onclick="Tab('tab1',1)">
                                    Pending To Post
                                    <span id="tb1" class="btn-notification">@Model.Tab1Count</span>
                                </span>
                            </div>
                            <div class="tab-items high">
                                <span class="btn-title tab2" onclick="Tab('tab2',2)">
                                    Posted
                                    <span id="tb2" class="btn-notification">@Model.Tab2Count</span>
                                </span>
                            </div>

                            <div class="tab-items select-option">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>

                                <button data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                        data-bs-original-title="Export to Excel"onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </button>
                            </div>


                        </div>
                    </div>


                    <div id="JobPostingList">

                        @if (ViewBag.RedirectigFRom != "FromRecruitDashBoard")
                        {
                        @await Html.PartialAsync("_PendingPostList.cshtml", Model)
                        }
                        else
                        {
                            @await Html.PartialAsync("_PostedList.cshtml", Model)
                        }

                    </div>


                    <!--end: Datatable-->
                </div>
            </div>
            <div id="JobPostingSlider">

            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>

</div>
<!--end::Wrapper-->