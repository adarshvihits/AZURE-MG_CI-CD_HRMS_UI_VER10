@model Hrms.Lite.Shared.DataBank.DTO.IndustryBenchmarkSalary
@*<script src="~/js/settings.js"></script>*@
<script>
    $(document).ready(function () {

         $('.AllTabCount').html("@Model.AllCount");
        $('.Tab1Count').html("@Model.GreaterBenchmarkSalaryCount");
        $('.Tab2Count').html("@Model.LessBenchmarkSalaryCount");
        $('.Tab3Count').html("@Model.SameBenchmarkSalaryCount");

        fillData();
    });
</script>


<div class="ihits-table table-border odd-even mobile-responsive-table industry-benchmark-salary-list ">
    @Html.HiddenFor(m => m.IndustryBenchmarkSalaryList.Count)
    <table id="industryBenchmarkSalaryTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">Wage Grade</th>
                <th data-bs-toggle="tooltip" title="Current Gross Pay" scope="col">Cur.GP</th>
                <th data-bs-toggle="tooltip" title="Benchmark Gross Pay" scope="col">BM GP</th>
                <th scope="col">Variation</th>
            </tr>
        </thead>
        @*<tbody>
                @if (Model.IndustryBenchmarkSalaryList != null && Model.IndustryBenchmarkSalaryList.Count > 0)
