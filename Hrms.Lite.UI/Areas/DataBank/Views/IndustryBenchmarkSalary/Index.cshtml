@model Hrms.Lite.Shared.DataBank.DTO.IndustryBenchmarkSalary
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Index";
}
<script src="~/scripts/DataBank/industryBenchmarkSalary.js"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Industry Benchmark Salary</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Industry Benchmark Salary
                    </li>

                </ul>
            </div>
        </div>
   

    </div>
    <!--end::Container-->
</div>
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                    <div class="mobile-tab-section">
                        <div class="row mb-2">
                            <div class="col-6">
                                <div class="form-group">
                                    <label>Select Type</label>
                                    <select class="form-control form-control-sm "
                                            id="TabCode"
                                            onchange="TabsDropdown($('#TabCode').val(),$('#TabCode option:selected').text())">
                                        <option value="0">All</option>
                                        <option value="1">Higher</option>
                                        <option value="2">
                                            Lower
                                        </option>
                                        <option value="3">
                                       Similar
                                        </option>

                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items">
                                <a class="btn-title all active" onclick="tabClick('all','All',0)">
                                    All
                                    <span class="btn-notification AllTabCount">@Model.AllCount</span>
                                </a>
                            </div>
                            <div class="tab-items medium">
                                <span class="btn-title tab1" onclick="tabClick('tab1','GREATER',1,'Greater than Benchmark Salary')">
                                    Higher
                                    <span class="btn-notification Tab1Count">@Model.GreaterBenchmarkSalaryCount</span>
                                </span>
                            </div>
                            <div class="tab-items high">
                                <span class="btn-title tab2" onclick="tabClick('tab2','LESS',2,'Less than Benchmark Salary')">
                                    Lower
                                    <span class="btn-notification Tab2Count">@Model.LessBenchmarkSalaryCount</span>
                                </span>
                            </div>
                            <div class="tab-items low">
                                <span class="btn-title tab3" onclick="tabClick('tab3','SAME',3,'Same as Benchmark Salary')">
                                    Similar
                                    <span class="btn-notification Tab3Count">@Model.SameBenchmarkSalaryCount</span>
                                </span>
                            </div>



                            <div class="tab-items select-option">


                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left" data-bs-original-title="Export to Excel" onclick="onExportToExcelClick()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>
                            </div>


                        </div>
                    </div>

                    <div id="IndustryBenchmarkSalaryList">
                        @await Html.PartialAsync("_IndustryBenchmarkSalaryList", Model)
                    </div>
                    <div id="addBenchmarkSalary" class="hide">
                        @await Html.PartialAsync("_Create", Model)
                    </div>
                    <div class="row card-footer-bottom-fixed">
                        <div class="col-md-12">



                            <a id="addBenchmark" class="btn btn-default float-right mobile-full-width slider-btn" onclick="onAddBenchmarkSalaryClick()">Add Benchmark Salary</a>



                        </div>

                    </div>
                    <!--end: Datatable-->
                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
                    </div>

                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>


