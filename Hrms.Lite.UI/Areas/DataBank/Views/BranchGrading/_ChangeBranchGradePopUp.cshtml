@model Hrms.Lite.Shared.DataBank.DTO.BranchGrading

@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "Save_branchpopUpdetails" }))
{

    <div class="pop-grade">
        <div class="row my-3">
            <div class="col-md-4">
                <div class="row-outer d-flex justify-content-between">
                    <label class="">
                        Branch Code
                    </label>
                    <label>:</label>

                </div>
            </div>
            <div class="col-md-4">
                <div class="row-outer">
                    <label class="">
                        @Html.HiddenFor(m => Model.Designation.Code)
                        @*@Html.HiddenFor(m => Model.Location.Code)*@
                        @Html.HiddenFor(m => Model.Change_BranchGrade.Location.Code)
                        @Html.HiddenFor(m => Model.Change_BranchGrade.OldGrade.Code)
                        @Html.HiddenFor(m => Model.Change_BranchGrade.OldGrade.Name)
                        @Model.Change_BranchGrade.Location.UserCode

                    </label>

                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="row-outer d-flex justify-content-between">
                    <label class="">
                        Branch Name
                    </label>
                    <label>:</label>

                </div>
            </div>
            <div class="col-md-4">
                <div class="row-outer">
                    <label class="">
                        @Model.Change_BranchGrade.Location.Name
                    </label>

                </div>
            </div>
        </div>
        <div class="row my-3">
            <div class="col-md-4">
                <div class="row-outer d-flex justify-content-between">
                    <label class="">
                        Current Grade
                    </label>
                    <label>:</label>

                </div>
            </div>
            <div class="col-md-4">
                <div class="row-outer">
                    <label class="">
                
                        @Model.Change_BranchGrade.OldGrade.Name
                    </label>

                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="row-outer d-flex justify-content-between">
                    <label class="">
                        New Grade
                    </label>
                    <label>:</label>

                </div>
            </div>
            <div class="col-md-4">
                <div class="row-outer">
                    <label class="">
                        <div class="row-outer">

                            <div class="form-group filter-combobox mt-0">

                                @Html.DropDownListFor(Model => Model.Change_BranchGrade.NewGrade.Code, (SelectList)ViewBag.Grade,"--select--", new { @class = "form-control form-control-sm Cname" })
                            </div>
                        </div>
                    </label>

                </div>
            </div>
        </div>



        <div class="row     pt-5 ">

            <div class="col-md-12 align-right">
                <button type="button" class="btn btn-default  mobile-full-width" onclick="PopUpDetailsSave()">
                    Save
                </button>
            </div>
        </div>
    </div>
}
