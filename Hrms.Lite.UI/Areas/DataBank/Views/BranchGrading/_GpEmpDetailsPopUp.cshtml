@model Hrms.Lite.Shared.DataBank.DTO.BranchGrading

<div style="padding:10px;" class="ihits-table table-border hover-color odd-even mobile-responsive-table gpplus-popup-details vertical-scroll-250">

    <table id="PopUpTable">
        <thead>
            <tr class="table-light">
                <th scope="col">ID</th>
                <th scope="col">Emp Name</th>
                <th scope="col">Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Years Of Service">Y/S</th>
                <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Standard Gross Pay">Std GP</th>
                <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Current Gross Pay">Cur Gp</th>
                <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Variance" >Var</th>





            </tr>
        </thead>
        <tbody>


            @if (Model != null && Model.EmpDetails != null && Model.EmpDetails.Count > 0)
            {

                for (int i = 0; i < Model.EmpDetails.Count; i++)
                {


            <tr>
                <td data-label="ID">
                    @Model.EmpDetails[i].EmployeeID
                </td>
                <td data-label="Employee Name">
                    @Model.EmpDetails[i].FullName
                </td>
                <td data-label="Designation">
                    @Model.EmpDetails[i].Designation
                </td>
                <td data-label="Department">
                    @Model.EmpDetails[i].Department
                </td>
                <td data-label="Location">
                    @Model.EmpDetails[i].Location
                </td>

                <td data-label="Y/S">
                    @Model.EmpDetails[i].YearOfService
                </td>

                <td data-label="Std GP"> @Model.EmpDetails[i].StdGrossPay</td>
                <td data-label="Cur GP"> @Model.EmpDetails[i].GrossPay</td>

                <td data-label="Var"> @Model.EmpDetails[i].Variance</td>



            </tr>

                }
            }
                </tbody>


    </table>
</div>