@model Hrms.Lite.Shared.DataBank.DTO.BranchGrading
@using (Html.BeginForm(null, null, FormMethod.Post, new {@id = "save_BrachGrading" }))
{
    <div id="addinterview" class="slider-forms slider-forms-open BranchGradingSlider">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('BranchGradingSlider')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>
                Grade List
            </h4>
            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Grade
                        </label>
                       
                        @Html.DropDownListFor(Model => Model.Grade.Code, (SelectList)ViewBag.Grade, "--select--", new { @class = "form-control form-control-sm", @onchange = "GetListOnChange(this)" })
                    </div>
                </div>

            </div>

            <div class="row pt-2">
                <div class="col-md-12">

                    <div id="SliderList">
                        @await Html.PartialAsync("_GradingSliderList", Model)
                    </div>

                </div>
            </div>






            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    <button type="button"
                            class="btn btn-default  mobile-full-width" onclick="OnSaveClick()">
                        Save
                    </button>
                </div>

            </div>
        </div>
    </div>
}