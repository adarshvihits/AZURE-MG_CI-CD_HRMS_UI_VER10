@model Hrms.Lite.Shared.DataBank.DTO.BranchGrading

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table grade-slider-grid vertical-scroll-400">


    <table>
        <thead>
            <tr class="table-light">
                <th scope="col">Designation</th>
                <th scope="col">Numbers </th>
                <th scope="col">Grosspay</th>



            </tr>
        </thead>
        <tbody>
            



                @if (Model != null && Model.GradeList != null && Model.GradeList.Count > 0)
                {

                    for (int i = 0; i < Model.GradeList.Count; i++)
                    {
            <tr>
                <td data-label="Designation">@Model.GradeList[i].Designation.Name</td>
                <td data-label="Numbers">
                    <div class="form-group">

                        @Html.HiddenFor(m => Model.GradeList[i].Designation.Code)
                
                        @Html.TextBoxFor(Model => Model.GradeList[i].Numbers, new { @class = "form-control form-control-sm dName", @placeholder = "Numbers" })

                    </div>
                </td>
                <td data-label="Grosspay">
                    <div class="form-group">

                        @Html.TextBoxFor(Model => Model.GradeList[i].GrossPay, new { @class = "form-control form-control-sm dName", @placeholder = "Grosspay" })
                    </div>
                </td>


            </tr>
            

                    }
                }




        </tbody>


    </table>
</div>