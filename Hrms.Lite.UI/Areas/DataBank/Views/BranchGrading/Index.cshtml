@model Hrms.Lite.Shared.DataBank.DTO.BranchGrading


@{ ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .tab-button-wrap .tab-items .form-group {
         margin-top: 0px !important; 
     
    }
</style>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/DataBank/BranchGrading.js"></script>
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Branch Grading</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Branch Grading
                    </li>
                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                    <!--begin: Search Form-->

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap ">

                            <div class="tab-items ">


                                <div class="form-group ">
                                    <label>Designation </label>
                                    <div class="form-group filter-combobox " style="width: 260px;">

                                        @Html.DropDownListFor(Model => Model.Designation.Code, (SelectList)ViewBag.Designation, new { @class = "form-control form-control-sm Cname", @onchange = "GetList()" })

                                    </div>

                                </div>
                            </div>

                            <div class="tab-items">


                                <div class="form-group  ">
                                    <label>Region </label>
                                    <div class="form-group filter-combobox " style="width: 200px;">
                                        @Html.DropDownListFor(Model => Model.Region.Code, (SelectList)ViewBag.Region, "ALL", new { @class = "form-control form-control-sm Cname", @onchange = "GetList()" })

                                    </div>


                                </div>
                            </div>
                            <div class="tab-items">


                                <div class="form-group  ">
                                    <label>Branch Grade </label>
                                    <div class="form-group filter-combobox " style="width: 200px;">
                                        @Html.DropDownListFor(Model => Model.Grade.Code, (SelectList)ViewBag.Grade, "ALL", new { @class = "form-control form-control-sm Cname", @onchange = "GetList()" })
                                    </div>


                                </div>
                            </div>


                            <div class="tab-items select-option d-flex align-items-center">



                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <button data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                        data-bs-original-title="Export to Excel" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </button>


                            </div>


                        </div>
                    </div>


                    <div id="BranchGradinglist">
                        @await Html.PartialAsync("_BranchGradingList")
                    </div>

                    <div id="gradelistSlider"></div>
                    <div class="row card-footer-bottom-fixed">

                        <div class="col-md-12 align-left">
                            <button id="addinterview" type="button" class="btn btn-default  mobile-full-width slider-btn" onclick="GetSlider()">
                                Grade List
                            </button>




                        </div>

                    </div>




                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>