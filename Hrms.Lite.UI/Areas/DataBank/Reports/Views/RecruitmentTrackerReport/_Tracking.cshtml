@model Hrms.Lite.Shared.DataBank.Reports.RecruitmentTrackerReport
<script src="~/js/tooltip.js"></script>
<script>
    const myTimeout = setTimeout(changeFocus, 500);

    function changeFocus() {
        debugger
        $('#AcceptedLastWorkingDate').focus();
        $('#AcceptedLastWorkingDate').datepicker('hide');
    }


</script>

<div class="slider-forms slider-forms-open applntrackerlistslider">
    <div class="slider-inner-style  new-inner-style">
        <div class="slider-form-close" onclick="CloseSlider('applntrackerlistslider')">
            <i class="ki ki-close icon-xs text-muted"></i>
        </div>
        <div class="location-slider">
            <h4 class="mb-4">Application Tracker</h4>
        </div>
        
        <!----- stepper start here --->
        <div class="add-padding">



            <div class="profile-header"
                >
                <div class="row">

                    <div class="flex-grow-1" >
                        <!--begin::Title-->
                        <div class="d-flex justify-content-between flex-wrap">
                            <div class="d-flex mr-3 header-profile-name">
                                <a href="#" class="header-profile-name " style="font-size: 24px;">@Model.ApplicantHeader.ApplicantName</a>


                            </div>
                        </div>

                        <!--end::Title-->
                        <!--begin::Content-->
                        <div class="d-flex flex-wrap justify-content-between">
                            <div class="d-flex flex-column flex-grow-1 pr-8">
                                <div class="d-flex flex-wrap mb-1">
                                    <a href="#" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                        <i class="fas fa-envelope icon-nm mr-2"></i>@Model.ApplicantHeader.Email
                                    </a>
                                    <a data-bs-toggle="tooltip" data-bs-original-title="Gender" class="header-profile-email mr-4 mb-lg-0 mb-2">
                                        <i class="fas fa-user-alt icon-nm mr-2"></i>@Model.ApplicantHeader.Gender.Name
                                    </a>
                                    <a data-bs-toggle="tooltip" data-bs-original-title="Date of Birth" class="header-profile-email mr-4 mb-lg-0 mb-2">
                                        <i class="fas fa-calendar-alt icon-nm mr-2"></i>@Model.ApplicantHeader.DateOfBirth
                                    </a>
                                    <a data-bs-toggle="tooltip" data-bs-original-title="Mobile" class="header-profile-email mr-4 mb-lg-0 mb-2">
                                        <i class="fas fa-phone-alt icon-nm mr-2"></i>@Model.ApplicantHeader.Mobile
                                    </a>
                                </div>
                            </div>


                        </div>

                        <!--end::Content-->
                    </div>

                </div>


                <div class="profile-header-overflow"></div>
            </div>










            <div>

                @if (Model.Tracker != null && Model.Tracker.Count > 0)
                {
                    for (int i = Model.Tracker.Count - 1; i >= 0; i--)
                    {
                        if (@Model.Tracker[i].ApprovalStatus == "Pending")

                        {

                            <!-- completed -->
                <div class="step">
                    <div class="v-stepper">
                        <div class="circle"><i class="fa fa-check"></i></div>
                        <div class="line"></div>
                    </div>
                    <div class="stepper-content">
                        <div class="row-outer">
                            <label class="view-title">@Model.Tracker[i].Stage</label>
                            @if (Model.Tracker[i].Stage != "Offer Send")
                            {
                                <div class="view-details">
                                    @Model.Tracker[i].ApprovalStatus, @Model.Tracker[i].Approver
                                </div>
                            }
                            else
                            {
                                <div class="view-details">
                                    @Model.Tracker[i].ApprovalStatus
                                </div>
                            }
                        </div>



                    </div>
                </div>
                        }
                        else if (@Model.Tracker[i].ApprovalStatus == "Rejected")
                        {
            <div class="step active rejected">
                <div class="v-stepper">
                    <div class="circle"><i class="icon-xl fas fa-times"></i></div>
                    <div class="line"></div>
                </div>

                <div class="stepper-content">
                    <div class="row-outer">
                        <label class="view-title">@Model.Tracker[i].Stage</label>
                        @if (Model.Tracker[i].Stage != "Offer Send")
                        {
                            <div class="view-details">
                                @Model.Tracker[i].ApprovalStatus, @Model.Tracker[i].Approver, @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.Tracker[i].Date))
                            </div>
                        }
                        else
                        {
                            <div class="view-details">
                                @Model.Tracker[i].ApprovalStatus
                            </div>
                        }

                    </div>



                </div>
            </div>
                        }
                        else
                        {
            <div class="step active completed">
                <div class="v-stepper">
                    <div class="circle"><i class="fa fa-check"></i></div>
                    <div class="line"></div>
                </div>
                <div class="stepper-content">
                    <div class="row-outer">
                        <label class="view-title">@Model.Tracker[i].Stage</label>
                        @if (Model.Tracker[i].Stage != "Offer Send")
                        {
                            <div class="view-details">
                                @Model.Tracker[i].ApprovalStatus, @Model.Tracker[i].Approver, @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.Tracker[i].Date))
                            </div>
                        }
                        else
                        {
                            <div class="view-details">
                                @Model.Tracker[i].ApprovalStatus
                            </div>
                        }


                    </div>



                </div>
            </div>
                        }


                    }
                }
            </div>

            <!----- stepper end here --->

        </div>

    </div>
</div>