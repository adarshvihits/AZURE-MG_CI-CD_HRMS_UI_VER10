@model Hrms.Lite.Shared.DataBank.Reports.RecruitmentTrackerReport
@{
    Model.TabIndex = "Documents";
}

@using (Html.BeginForm("UploadDocuments", "RecruitmentTrackerReport", FormMethod.Post, new { id = "documentsForm", enctype = "multipart/form-data" }))
{
    @Html.HiddenFor(m => m.TabIndex)
    @Html.HiddenFor(m => m.ApplicantGI)

    @*<div class="row">*@
    <!-- Photo -->
    <div class="col-md-6">
        <div class="file-upload-form-group">
            <label class="form-label">Photo :</label>
            @if (@Model.Photo.FileName != null || @Model.Photo.FileName != "")
            {
                <a href="/ESSP/ApplicantVerification/DownloadDoc?DocType=Photo&ApplicantGI=@Model.ApplicantGI"
                   class="btn btn-link">
                    @Model.Photo.FileName
                </a>}
            <div class="file-upload-form mb-1" data-bs-toggle="tooltip" data-bs-original-title=" Only .png, .jpg, .jpeg files are
                                                allowed , File size less than 2 MB.">
                <div>

                    <input class="file-upload-form mb-1" type="file" name="PhotoFile" accept=".png, .jpg, .jpeg" onchange="CheckImageExtensionSize(this)" class="form-control" />
                </div>

            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="file-upload-form-group">
            <label class="form-label">Aadhar :</label>
            @if (@Model.Aadhar.FileName != null || @Model.Aadhar.FileName != "")
            {
                <a href="/ESSP/ApplicantVerification/DownloadDoc?DocType=Aadhar&ApplicantGI=@Model.ApplicantGI"
                   class="btn btn-link">
                    @Model.Aadhar.FileName
                </a>}
            <div class="file-upload-form mb-1" data-bs-toggle="tooltip" data-bs-original-title=" Only .png, .jpg, .jpeg files are
                                                allowed , File size less than 2 MB.">
                <div>

                    <input class="file-upload-form mb-1" type="file" name="AadharFile" accept=".png, .jpg, .jpeg" onchange="CheckImageExtensionSize(this)" class="form-control" />
                </div>

            </div>

        </div>
    </div>
    <div class="row">
        <!-- Pan -->
        <div class="col-md-6">
            <div class="file-upload-form-group">
                <label class="form-label">PAN :</label>
                @if (@Model.Pan.FileName != null || @Model.Pan.FileName != "")
                {
                    <a href="/ESSP/ApplicantVerification/DownloadDoc?DocType=Pan&ApplicantGI=@Model.ApplicantGI"
                       class="btn btn-link">
                        @Model.Pan.FileName
                    </a>}
                @*<div class="file-upload-form mb-1" data-bs-toggle="tooltip" data-bs-original-title=" Only .png, .jpg, .jpeg files are
                                                allowed , File size less than 2 MB.">
                        <div>

                            <input class="file-upload-form mb-1" type="file" name="PanFile" accept=".png, .jpg, .jpeg" onchange="CheckImageExtensionSize(this)" class="form-control" />
                        </div>

                    </div>*@
            </div>
        </div>


        <!-- Resume -->
        <div class="col-md-6">
            <div class="file-upload-form-group">
                <label class="form-label">Resume :</label>
                @if (@Model.Resume.FileName != null || @Model.Resume.FileName != "")
                {
                    <a href="/ESSP/ApplicantVerification/DownloadDoc?DocType=Resume&ApplicantGI=@Model.ApplicantGI"
                       class="btn btn-link">
                        @Model.Resume.FileName
                    </a>}
                @*<div class="file-upload-form mb-1" data-bs-toggle="tooltip" data-bs-original-title=" Only .pdf files are
                                                allowed , File size less than 2 MB.">
                        <div>

                            <input class="file-upload-form mb-1" type="file" name="ResumeFile" accept=".pdf" onchange="CheckImageExtensionSize(this)" class="form-control" />
                        </div>

                    </div>*@
            </div>
        </div>
    </div>
    @if (@Model.Varify == false)
    {
        @*<div class="row">

                <div class="col-md-12">
                    <button type="button" onclick="SaveDocuments()" class="btn btn-primary float-right">
                        Save
                    </button>
                </div>
            </div>*@
    }
}
