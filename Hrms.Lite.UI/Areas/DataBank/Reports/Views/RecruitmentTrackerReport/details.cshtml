@model Hrms.Lite.Shared.DataBank.Reports.RecruitmentTrackerReport
@{
    ViewData["Title"] = "View";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link rel="stylesheet" type="text/css" href="~/css/fonts/flaticon_mycollection.css">
<script src="~/js/jquery.min.js"></script>
<script src="~/scripts/DataBank/Reports/RecruitmentTrackerReport.js"></script>
<script>
$(document).ready(function () {
        debugger;
        $('.emp_HeaderPic').css('background-image', "url('@Html.Raw(@ViewBag.dataUri)')");

});
</script>
<style>
    .profile-header a , .profile-header i {
        color: #fff !important;
    }




    .profile-header {
        background-color: #01877c !important;
        border-radius: 10px;
    }



    .card.card-custom > .card-body {
        padding: 5px 30px 60px 20px !important;
    }

    .tab-content-scroller-tab {
        height: 240px;
        overflow-y: scroll;
        overflow-x: hidden;
    }

    .page_white-edit .inner-padding {
        padding: 0px 15px;
    }

    .page_white-edit h5 {
        background-color: #06867b00;
        color: #02685f !important;
        padding: 10px 15px 0px 15px;
        font-size: 16px;
        font-weight: 600;
        border-radius: 10px 10px 0px 0px;
    }

    .page_white-edit {
        background-color: white;
        padding: 0px 0px 10px;
        margin-bottom: 30px;
        border-radius: 10px;
        border: 1px solid #dddddd9e;
    }

    .page_white h5 {
        background-color: #06867b14;
        color: #02685f !important;
        padding: 10px 15px 10px 15px;
        border-radius: 10px 10px 0px 0px;
    }

    .page_white {
        background-color: white;
        padding: 0px 0px 10px;
        margin-bottom: 30px;
        border-radius: 10px;
        border: 1px solid #06867b9e;
    }

        .page_white .inner-padding {
            padding: 0px 15px;
        }

    .four-col {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-gap: 45px;
        padding: 0px 10px;
    }



    .photostyle-bg {
        background-color: #eef7ff;
        border-radius: 20px;
    }


    .photostyle {
        background: linear-gradient(218deg, rgb(197 222 244) 0%, rgb(201 225 250) 75%);
        border-radius: 20px 20px 0px 0px;
        padding-left: 20px !important;
    }




    .adarstyle-bg {
        background-color: #f0faef;
        border-radius: 20px;
    }


    .adarstyle {
        background: linear-gradient(168deg, rgba(247, 190, 153, 1) 0%, rgba(255, 255, 255, 1) 47%, rgba(174, 230, 168, 1) 100%);
        border-radius: 20px 20px 0px 0px;
        padding-left: 20px !important;
    }


    .panstyle-bg {
        background-color: #fff7fe;
        border-radius: 20px;
    }

    .panstyle {
        background: linear-gradient(218deg, rgba(47, 202, 240, 1) 0%, rgba(215, 169, 211, 1) 75%);
        border-radius: 20px 20px 0px 0px;
        padding-left: 20px !important;
    }


    .resumestyle-bg {
        background-color: #e7faf9;
        border-radius: 20px;
    }

    .resumestyle {
        background: linear-gradient(218deg, rgb(215 255 255) 0%, rgb(83 226 214) 75%);
        border-radius: 20px 20px 0px 0px;
        padding-left: 20px !important;
    }


    .page_white h4 {
        font-size: 14px;
        color: #06867b;
    }

    .ihits-table table tr:first-child th:last-child {
        border-top-right-radius: 10px !important;
    }

    .ihits-table table tr:first-child th:first-child {
        border-top-left-radius: 10px !important;
    }
</style>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->

        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Applicant Details</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "DashBoard", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a href="@Url.Action("Index", "RecruitmentTrackerReport", new { Area = "DataBank" })" class="">Recruitment Tracker Report</a>
                    </li>
                    <li class="breadcrumb-item">
                        Applicant Details
                    </li>


                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<div class="card card-custom  height-100per">



    <div class="card-body ">
        <div class="profile-header newpro-head mb-3">
            <div class="row">

                <div class="col-md-12 pl-10">


                    <div class="row">
                        <div class="col-md-1">
                            <div class="image-input image-input-outline image-input-circle" id="kt_image_4"
                                 style="background-image: url(/images/blank.png)">


                                @if (Model.ApplicantHeader != null)
                                {
                                    <div class="image-input-wrapper emp_HeaderPic">

                                    </div>
                                    @Html.HiddenFor(m => m.ApplicantHeader.ProfilePhoto.fdata)
                                    @Html.HiddenFor(m => m.ApplicantHeader.ProfilePhoto.FileName)
                                }
                                else
                                {
                                    <div class="image-input-wrapper">
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="flex-grow-1">
                            <!--begin::Title-->
                            <div class="d-flex justify-content-between flex-wrap ">
                                <div class="d-flex mr-3 mb-5 header-profile-name">

                                    <a href="#" class="">@Model.ApplicantHeader.ApplicantName</a>
                                </div>

                            </div>

                            <!--end::Title-->
                            <!--begin::Content-->
                            <div class="d-flex flex-wrap justify-content-between">
                                <div class="d-flex flex-column flex-grow-1 pr-8">
                                    <div class="d-flex flex-wrap mb-1">
                                        <a data-bs-toggle="tooltip" data-bs-original-title="Gender" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                            <i class="fas fa-user-alt icon-nm mr-2"></i>@Model.ApplicantHeader.Gender.Name
                                        </a>
                                        <a data-bs-toggle="tooltip" data-bs-original-title="DOB" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                            <i class="fas fa-calendar-alt icon-nm mr-2"></i>@Model.ApplicantHeader.DateOfBirth
                                        </a>
                                        <a data-bs-toggle="tooltip" data-bs-original-title="Email" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                            <i class="fa fa-envelope  icon-nm mr-2" aria-hidden="true"></i>@Model.ApplicantHeader.Email
                                        </a>
                                        <a data-bs-toggle="tooltip" data-bs-original-title="Mobile" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                            <i class="fas fa-phone-alt icon-nm mr-2"></i>@Model.ApplicantHeader.Mobile
                                        </a>



                                    </div>



                                </div>



                            </div>

                            <!--end::Content-->
                        </div>

                    </div>
                </div>
            </div>
            <div class="profile-header-overflow"></div>
        </div>

        <div class="page_white mb-2">
            <h5 class="h5-style">Basic Info</h5>
            <div class="inner-padding">
                <div class="row">
                    <div class="col-md-1">
                        <div class="row-outer">
                            <label class="view-title">Applicant ID</label>
                            <div class="view-details">@Model.ApplicantHeader.ApplicantID</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="row-outer">
                            <label class="view-title">Aadhar No.</label>
                            <div class="view-details">
                                @{ var aadhar = Model.CandidateBasicInfo.AdharNo;
                                    if (!string.IsNullOrEmpty(aadhar) && aadhar.Length == 12)
                                    { @("********" + aadhar.Substring(8)) }
                                }
                            </div>
                            @*<div class="view-details">@Model.CandidateBasicInfo.AdharNo</div>*@
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="row-outer">
                            <label class="view-title">Name as per Aadhar</label>
                            <div class="view-details">@Model.CandidateBasicInfo.NameInAdhar</div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="row-outer">
                            <label class="view-title">Pan</label>
                            <div class="view-details">@Model.CandidateBasicInfo.PanNo</div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="row-outer">
                            <label class="view-title">Whatsapp No</label>
                            <div class="view-details">@Model.CandidateBasicInfo.WhatsappNo</div>
                        </div>
                    </div>
                    <div class="col-md-1">
                        <div class="row-outer">
                            <label class="view-title">Fresher</label>
                            <div class="view-details">
                                @(Model.Fresher ? "Yes" : "No")
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
        <div class="page_white mb-2">
            <h5 class="h5-style">Address</h5>
            <div class="inner-padding">
                <div class="row">
                    <div class="col-md-6 pr-7">
                        <h4>Permanent Address</h4>
                        <div class="row-outer">
                            <label class="view-title">House Number, Building</label>
                            <div class="view-details">@Model.PermanentAddress.House</div>
                        </div>
                        <div class="row-outer">
                            <label class="view-title">Street, Area</label>
                            <div class="view-details">@Model.PermanentAddress.Street</div>
                        </div>
                        <div class="row">
                            <div class="col-md-8">
                                <div class="row-outer">
                                    <label class="view-title">Locality, City</label>
                                    <div class="view-details">@Model.PermanentAddress.City</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="row-outer">
                                    <label class="view-title">Pin Code</label>
                                    <div class="view-details">@Model.PermanentAddress.PinCode</div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="row-outer">
                                    <label class="view-title">Country</label>
                                    <div class="view-details">@Model.PermanentAddress.Country.Name</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="row-outer">
                                    <label class="view-title">State</label>
                                    <div class="view-details">@Model.PermanentAddress.State.Name</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="row-outer">
                                    <label class="view-title">District</label>
                                    <div class="view-details">@Model.PermanentAddress.District.Name</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 pl-7">
                        <h4>Present Address</h4>

                        <div class="row-outer">
                            <label class="view-title">House Number, Building</label>
                            <div class="view-details">@Model.PresentAddress.House</div>
                        </div>
                        <div class="row-outer">
                            <label class="view-title">Street, Area</label>
                            <div class="view-details">@Model.PresentAddress.Street</div>
                        </div>
                        <div class="row">
                            <div class="col-md-8">
                                <div class="row-outer">
                                    <label class="view-title">Locality, City</label>
                                    <div class="view-details">@Model.PresentAddress.City</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="row-outer">
                                    <label class="view-title">Pin Code</label>
                                    <div class="view-details">@Model.PresentAddress.PinCode</div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4">
                                <div class="row-outer">
                                    <label class="view-title">Country</label>
                                    <div class="view-details">@Model.PresentAddress.Country.Name</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="row-outer">
                                    <label class="view-title">State</label>
                                    <div class="view-details">@Model.PresentAddress.State.Name</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="row-outer">
                                    <label class="view-title">District</label>
                                    <div class="view-details">@Model.PresentAddress.District.Name</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="page_white mb-2">
            <h5 class="h5-style border-none">Qualification</h5>
            <div class="inner-padding">
                <div class="row">
                    <div class="col-md-12">
                        <div class="ihits-table table-border mobile-responsive-table">
                            <table id="education_preview">
                                <thead>
                                    <tr class="table-dark">
                                        <th scope="col">Qualification</th>
                                        <th scope="col">Institute Name</th>
                                        <th scope="col">Specialisation</th>
                                        <th scope="col">Duration</th>
                                        <th scope="col">Passing Year</th>
                                        <th scope="col">Mark/Grade Obtained</th>
                                        <th scope="col">Highest</th>
                                        <th scope="col">View Document</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Education != null && Model.Education.Count > 0)
                                    {
                                        @for (int i = 0; i < Model.Education.Count; i++)
                                        {
                                    <tr>
                                        <td data-label="Qualification">
                                            @Html.DisplayFor(m => m.Education[i].QualificationName)
                                        </td>
                                        <td data-label="Institute Name">
                                            @Html.DisplayFor(m => m.Education[i].Institution)
                                        </td>
                                        <td data-label="Specialisation">
                                            @Html.DisplayFor(m => m.Education[i].SpecialisationName)
                                        </td>
                                        <td data-label="Duration">
                                            @Html.DisplayFor(m => m.Education[i].CourseDuration)
                                        </td>
                                        <td data-label="Passing Year">
                                            @Html.DisplayFor(m => m.Education[i].YearOfCompletion)
                                        </td>
                                        <td data-label="Mark/Grade Obtained">
                                            @Html.DisplayFor(m => m.Education[i].Aggregate)
                                        </td>
                                        <td data-label="Highest">
                                            <input type="checkbox" class="HighestQual" @(Model.Education[i].HighestQual ? "checked" : "") disabled />
                                        </td>
                                        <td data-label="View Document">
                                            <div class="view-details  ">
                                                <a data-bs-toggle="tooltip" data-bs-original-title="View File" type="button" class="btn btn-small btn-secondary mobile-full-width" onclick="showDocumentPopup('@Model.ApplicantGI', 'Qualification', '@Model.Education[i].RowId')">
                                                    <i class="icon-xl far fa-eye"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                        }

                                    }
                                    else
                                    {
                                        <tr>
                                            <td>No table data</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="page_white mb-2">
            <h5 class="h5-style border-none">Certifications</h5>
            <div class="inner-padding">
                <div class="row">
                    <div class="col-md-12">
                        <div class="ihits-table table-border mobile-responsive-table candidate-certification-list-tab mb-2">
                            <table id="certifications_preview">
                                <thead>
                                    <tr class="table-dark">
                                        <th scope="col">Certificate</th>
                                        <th scope="col">Registration Number</th>
                                        <th scope="col">Valid From</th>
                                        <th scope="col">Valid To</th>
                                        <th scope="col">Date of Updation</th>
                                        <th scope="col">View Document</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Certifications != null && Model.Certifications.Count > 0)
                                    {
                                        for (int i = 0; i < Model.Certifications.Count; i++)
                                        {
                                    <tr>
                                        <td data-label="Certificate">
                                            <label>@Model.Certifications[i].CertificateName</label>
                                        </td>
                                        <td data-label="Registration Number">
                                            <label>@Model.Certifications[i].RegistrationNo</label>
                                        </td>
                                        <td data-label="Valid From">
                                            <label>@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Certifications[i].ValidFrom))</label>
                                        </td>
                                        <td data-label="Valid To">
                                            <label>@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Certifications[i].ValidTo))</label>
                                        </td>
                                        <td data-label="Date of Updation">
                                            <label>@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Certifications[i].UpdationDate))</label>
                                        </td>
                                        <td data-label="View Document">
                                            <div class="view-details  ">
                                                <a data-bs-toggle="tooltip" data-bs-original-title="View File" type="button" class="btn btn-small btn-secondary mobile-full-width" onclick="showDocumentPopup('@Model.ApplicantGI', 'Certification', '@Model.Certifications[i].RowID')">
                                                    <i class="icon-xl far fa-eye"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td>No table data</td>
                                        </tr>
                                    }
                                </tbody>

                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="page_white mb-2">
            <h5 class="h5-style border-none">Employment History</h5>
            <div class="inner-padding">
                <div class="row">
                    <div class="col-md-12">
                        <div class="ihits-table table-border mobile-responsive-table candidate-details-previous-employment">
                            <table id="previousEmployment_preview">
                                <thead>
                                    <tr class="table-dark">
                                        <th scope="col">Organisation</th>
                                        <th scope="col">Designation</th>
                                        <th scope="col">From</th>
                                        <th scope="col">To</th>
                                        <th scope="col">Experience</th>
                                        <th scope="col">Monthly CTC</th>
                                        <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Contact Person Name">Cont.Per.Name</th>
                                        <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Contact Person Mobile">Cont.Per.Mob</th>
                                        <th scope="col">View Document</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.PreviousEmployment != null && Model.PreviousEmployment.Count > 0)
                                    {
                                        @for (int i = 0; i < Model.PreviousEmployment.Count; i++)
                                        {

                                    <tr>
                                        <td data-label="Company Name & Address">
                                            @Html.DisplayFor(m => m.PreviousEmployment[i].CompanyName)
                                        </td>
                                        <td data-label="Designation">
                                            @Html.DisplayFor(m => m.PreviousEmployment[i].Designation)
                                        </td>
                                        <td data-label="From">
                                            <div class="input-group date">
                                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.PreviousEmployment[i].Fromdate))
                                            </div>
                                        </td>
                                        <td data-label="To">
                                            <div class="input-group date">
                                                @(
            Model.PreviousEmployment[i].Todate != DateTime.MinValue
                ? @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.PreviousEmployment[i].Todate))
                : ""
        )
                                            </div>
                                        </td>
                                        <td data-label="Experience">    @Html.DisplayFor(m => m.PreviousEmployment[i].Experience)  </td>
                                        <td data-label="Annual CTC">
                                            @String.Format(
System.Globalization.CultureInfo.GetCultureInfo("en-IN"),
"{0:N0}",
Model.PreviousEmployment[i].AnualCTC
)  @*@Html.DisplayFor(m => m.PreviousEmployment[i].AnualCTC)*@
                                        </td>
                                        <td data-label="ContanctPersonName"> @Html.DisplayFor(m => m.PreviousEmployment[i].ContanctPersonName)</td>
                                        <td data-label="ContanctPersonNumber"> @Html.DisplayFor(m => m.PreviousEmployment[i].ContanctPersonNumber)</td>
                                        <td data-label="View Document">
                                            <div class="view-details  ">
                                                <a data-bs-toggle="tooltip" data-bs-original-title="View File" type="button" class="btn btn-small btn-secondary mobile-full-width" onclick="showDocumentPopup('@Model.ApplicantGI', 'PrevEmployment', '@Model.PreviousEmployment[i].RowID')">
                                                    <i class="icon-xl far fa-eye"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td>No table data</td>
                                        </tr>
                                    }

                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="page_white mb-2">
            <h5 class="h5-style ">Records</h5>
            <div class="inner-padding">
                @*<div class="two-col p-0 pb-4">*@
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Have you been ARRESTED or been CONVICTED by any court of law or are there any
                                PENDING CASES against your name
                            </label>
                        </div>
                    </div> <div class="col-md-1" style=" text-align: center;">
                        <label>
                            :
                        </label>
                    </div>
                    <div class="col-md-5">
                        <div class="view-details">@(Model.CandidateBasicInfo.IsPoliceRecord ? "Yes" : "No")</div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                If yes, give details
                            </label>
                        </div>
                    </div>
                    <div class="col-md-1" style=" text-align: center;">
                        <label>
                            :
                        </label>
                    </div>
                    <div class="col-md-5">
                        <div class="view-details">@Model.CandidateBasicInfo.PoliceRecordDetails</div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Do you have any Medical Allergies
                            </label>
                        </div>
                    </div>
                    <div class="col-md-1" style=" text-align: center;">
                        <label>
                            :
                        </label>
                    </div>
                    <div class="col-md-5">
                        <div class="view-details">@(Model.CandidateBasicInfo.IsMedicalAllergies ? "Yes" : "No")</div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                If yes, please specify
                            </label>
                        </div>
                    </div>
                    <div class="col-md-1" style=" text-align: center;">
                        <label>
                            :
                        </label>
                    </div>

                    <div class="col-md-5">
                        <div class="view-details">@Model.CandidateBasicInfo.MedicalAllergiesDetails</div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
