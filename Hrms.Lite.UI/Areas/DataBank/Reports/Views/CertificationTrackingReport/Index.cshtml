@model Hrms.Lite.Shared.DataBank.Reports.CertificationTrackingReport
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/DataBank/Reports/CertificationTrackingReport.js"></script>

<script>
    $(document).ready(function () {
        fillData();
    });
</script>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Certification Tracking</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Certification Tracking
                    </li>

                </ul>
            </div>
        </div>

        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items">

                                <div class="row-outer pb-2">
                                    <label>From</label>
                                    <div class="input-group date">
                                        @Html.TextBoxFor(m => Model.From, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2 RFromDate", @readonly = "true", @placeholder = "From", @onchange = "fillData();validate(this,'fromdate')" })
                                        <div class="input-group-append ">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <span id="fromdate"></span>
                                </div>
                            </div>
                            <div class="tab-items pl-3">

                                <div class="row-outer pb-2">
                                    <label>To</label>
                                    <div class="input-group date">
                                        @Html.TextBoxFor(m => Model.To, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2 RToDate", @readonly = "true", @placeholder = "To", @onchange = "fillData();validate(this,'todate')" })
                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <span id="todate"></span>
                                </div>
                            </div>

                            <div class="tab-items select-option pt-5">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>

                                <div id="filterForm" class="filter-button slider-btn" data-bs-toggle="tooltip" title="" data-bs-original-title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                   data-bs-original-title="Export to Excel" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>

                            </div>


                        </div>
                    </div>
                    <div id="trackingList">
                        @await Html.PartialAsync("~/Areas/DataBank/Reports/Views/CertificationTrackingReport/_CertificationReportList.cshtml")
                    </div>
                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
                    </div>


                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
<!--end::Content-->

<div class="modal fade trackerPopup" tabindex="-1" aria-labelledby="myLargeModalLabel" aria-hidden="true" style="display: none;">
    <div class="modal-dialog" style="max-width: 1100px; max-height:600px;">
        <div class="modal-content popup " style=" ">
            <div class="modal-header" style=" padding: 4px 20px;">
                <h5 class="modal-title">
                    Certification Reimbursement Tracking
                </h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body" style="padding: 10px 20px;">
            </div>
        </div>
    </div>
</div>
