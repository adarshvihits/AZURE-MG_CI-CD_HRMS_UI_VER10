

@model Hrms.Lite.Shared.DataBank.Reports.EmployeeGroupSummaryReport
<script src="~/scripts/DataBank/Reports/EmployeeGroupSummaryReport.js?v=1"></script>

<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>


@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script>
    $(document).ready(function () {
        fillData();
    });
</script>


    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->


            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Employee Group Summary</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            Employee Group Summary
                        </li>
                    </ul>
                </div>
            </div>
            <!--begin::Topbar-->
           
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body">
                        <!--begin: Search Form-->

                        <div class="row tab-style-button">
                            <div class="tab-button-wrap ">

                                <div class="tab-items ">


                                    <div class="form-group d-flex align-items-center">
                                        <label>Group By </label>
                                        <div class="form-group filter-combobox ml-3" style="width: 150px;">
                                            @Html.DropDownListFor(m => m.GroupByX, (SelectList)ViewBag.Groupby, "--Select--", new { @class = "form-control form-control-sm", onchange = "GetList()" })


                                        </div>

                                    </div>
                                </div>

                                <div class="tab-items">


                                    <div class="form-group d-flex align-items-center">
                                        <label>VS </label>
                                        <div class="form-group filter-combobox ml-3" style="width: 150px;">
                                            @Html.DropDownListFor(m => m.GroupByY, (SelectList)ViewBag.Groupby, "---Select---", new { @class = "form-control form-control-sm", onchange = "ChangeButtonName();GetList()" })


                                        </div>


                                    </div>
                                </div>









                                <div class="tab-items select-option d-flex align-items-center">


                                    <div class="button-group float-left mr-8 pt-2">
                                        @*<button data-bs-toggle="modal" data-target=".bd-example-modal-lg" type="button" class="btn btn-default btn-sm float-left" id="buttonID" value="bbb" onclick="OnSelectButtonClick()">
            Select
             </button>*@
                                        <input data-bs-toggle="modal" data-target=".bd-example-modal-lg" type="button" style="visibility:hidden" class="btn btn-default btn-sm float-left" value="Select" onclick="OnSelectButtonClick()" id="buttonID" />

                                        <div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true" style="display: none;">
                                            <div class="modal-dialog modal-lg
                                             ">
                                                <div id="myDiv" class="modal-content popup">
                                                    <div class="modal-header">
                                                        <h5 class="modal-title Name" id="exampleModalLabel"></h5>
                                                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                                            <i aria-hidden="true" class="ki ki-close"></i>
                                                        </button>
                                                    </div>
                                                    <div class="modal-body">

                                                    </div>
                                                </div>
                                            </div>
                                        </div>



                                    </div>

                                    <div class="sraech-slider mt-0">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>


                                    <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                       data-bs-original-title="Export to Excel">
                                        <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                    </a>
                                </div>


                            </div>
                        </div>





                        <div id="Employeegroupsummaryreportlist">
                            @await Html.PartialAsync("~/Areas/DataBank/Reports/Views/EmployeeGroupSummaryReport/EmployeeGroupSummaryReportList.cshtml", Model)
                        </div>

                        <div id="PopUpList">

                        </div>
                       
                        <!--end: Datatable-->
                    </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>
  