@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Account.Login CurrentUser = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Account.Login>(Context.Session.GetString("User"));
}


<script>
    $(document).ready(function () {
        salVisible = @CurrentUser.authUser.SalaryVisibility;
        fillData();
    });
</script>




<div class="ihits-table table-border hover-color odd-even mobile-responsive-table renewal-information-table">
    @Html.HiddenFor(m => m.RenewalInformationList.Count)

    <table id="RenewalTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">Category</th>
                <th scope="col" data-bs-toggle="tooltip" title="Date Of Join">DOJ</th>
                <th scope="col" data-bs-toggle="tooltip"
                    data-bs-original-title="Years of Experience">Y/S</th>
                <th scope="col">Date Of Expiry</th>
                <th scope="col" data-bs-toggle="tooltip"
                    data-bs-original-title="Gross Pay">GP</th>

            </tr>
        </thead>
