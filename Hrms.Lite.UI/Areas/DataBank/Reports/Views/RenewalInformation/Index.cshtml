@model Hrms.Lite.Shared.DataBank.Reports.RenewalInformation
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Account.Login CurrentUser = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Account.Login>(Context.Session.GetString("User"));
}


<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>
<script src="~/scripts/DataBank/Reports/renewalInformation.js?v=1"></script>


<script>
    $(document).ready(function () {
         salVisible = @CurrentUser.authUser.SalaryVisibility;
        fillData();
    });
</script>






<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Renewal Information</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>


                    <li class="breadcrumb-item">
                        Renewal Information
                    </li>

                </ul>
            </div>
        </div>
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                    <!--begin: Search Form-->

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap align-items-center">
                            <!-- <div class="tab-items high">
                                <span class="btn-title">All
                                    <span class="btn-notification">025</span>
                                </span>
                            </div>

                            <div class="tab-items medium">
                                <span class="btn-title">Training Completion
                                    <span class="btn-notification">025</span>
                                </span>
                            </div>
                            <div class="tab-items high">
                                <span class="btn-title">Probation Completion
                                    <span class="btn-notification">025</span>
                                </span>
                            </div>

                            <div class="tab-items low">
                                <span class="btn-title">More
                                    <span class="btn-notification">025</span>
                                </span>
                            </div> -->



                            <div class="tab-items">

                                <div class="row-outer pb-2 " style="width:150px">
                                    <label>From</label>
                                    <div class="input-group date">
                                        @Html.TextBoxFor(Model => Model.From, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "From", onchange = "fillData();validate(this,'fromdate')" })
                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <span id="fromdate"></span>
                                </div>
                            </div>
                            <div class="tab-items">

                                <div class="row-outer pb-2" style="width:150px">
                                    <label>To</label>
                                    <div class="input-group date">
                                        @Html.TextBoxFor(Model => Model.To, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "To", onchange = "fillData();validate(this,'todate')" })
                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <span id="todate"></span>
                                </div>
                            </div>

                            <div class="form-group filter-combobox mr-10 highs mb-0 mt-2">
                                @Html.DropDownListFor(Model => Model.RenewalInfoTab, (SelectList)ViewBag.Rit, new { @class = "form-control form-control-sm", onchange = "fillData()" })
                            </div>

                            <div class="button-group float-left mr-8 mb-0">
                                <button data-bs-toggle="modal" data-target=".bd-example-modal-lg"
                                        type="button" class="btn btn-default btn-sm float-left" onclick="OnSummaryClick()">
                                    Summary
                                </button>
                            </div>

                            <div class="tab-items select-option lows">


                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn" data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                   data-bs-original-title="Export to Excel">
                                    <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                </a>


                            </div>


                        </div>
                    </div>
                    <div id="renewalInfoList">
                        @await Html.PartialAsync("~/Areas/DataBank/Reports/Views/RenewalInformation/_RenewalInfoList.cshtml", Model)
                    </div>
                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
                    </div>


                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
<div class="slider-over-flow"></div>
<!--end::Content-->




<div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog"
     aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div id="myDiv" class="modal-content popup">
            <div class="modal-header" style="padding:10px">
                <h5 class="modal-title" id="exampleModalLabel">
                    Summary
                </h5>
                <button type="button" class="close" data-bs-dismiss="modal"
                        aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">

            </div>


        </div>
    </div>
</div>