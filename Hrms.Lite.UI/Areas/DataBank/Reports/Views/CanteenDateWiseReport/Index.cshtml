@model Hrms.Lite.Shared.DataBank.Reports.CanteenDateWiseReport

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="~/js/jquery.min.js"></script>

<script src="~/js/datatables.min.js"></script>

<script src="~/scripts/DataBank/Reports/CanteenDateWiseReport.js"></script>


<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Canteen DateWise Report</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Canteen DateWise Report
                    </li>

                </ul>
            </div>
        </div>

        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <!--begin: Search Form-->

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items ml-5 pr-0 border-none select-option">
                                <div class="">
                                    <label>
                                        Date
                                        <span class=""></span>
                                    </label>

                                    <div class="input-group date">
                                        @Html.TextBoxFor(Model => Model.Date, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "From", onchange = "fillData();validate(this,'fromdate')" })
                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <span id="date"></span>
                                </div>

                            </div>
                            <div class="tab-items ml-5 pr-0 border-none ">
                                <div class="form-group filter-combobox mr-2" style="width: 163px;">
                                    <label>
                                        Meal Time
                                        <span class="Mandatory">*</span>
                                    </label>
                                    @Html.DropDownListFor(m => m.MealTime, (SelectList)ViewBag.Mealtime, new { @class = "form-control form-control-sm", @onchange = "fillData()" })
                                    <span id="Time_Meal"></span>
                                </div>



                            </div>
                            <div class="tab-items ml-5 pr-0 border-none ">
                                <div class="form-group filter-combobox mr-2" style="width: 163px;">
                                    <label>
                                        Meal Type
                                        <span class="Mandatory">*</span>
                                    </label>
                                    @Html.DropDownListFor(m => m.MealType, (SelectList)ViewBag.MealType, "All", new { @class = "form-control form-control-sm", @onchange = "fillData()" })
                                    <span id="type_Meal"></span>
                                </div>


                            </div>

                            <div class="tab-items ml-5 pr-0 border-none "id="vegID" style="display:none">
                                <div class="form-group filter-combobox mr-2 h-100" >
                                    <div class="d-flex align-items-center h-100">


                                        <label>
                                           Veg Count:

                                        </label>
                                        <div class="pl-2">
                                            <span id="vegSpanID"></span>
                                        </div>
                                    </div>
                                </div>


                            </div>
                            <div class="tab-items ml-5 pr-0 border-none "id="NonID"style="display:none">
                                <div class="form-group filter-combobox mr-2 h-100">
                                    <div class="d-flex align-items-center h-100">


                                        <label>
                                           Non Veg Count:

                                        </label>
                                        <div class="pl-2">
                                            <span id="NonvegSpanID"></span>
                                        </div>
                                    </div>
                                </div>


                            </div>
                          
                            <div class="tab-items select-option pt-5">


                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="Export to Excel"
                                   class="btn btn-excel mr-0" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>



                            </div>


                        </div>
                    </div>







                    <div id="CanteenListID">
                        @await Html.PartialAsync("~/Areas/DataBank/Reports/Views/CanteenDateWiseReport/_List.cshtml")
                    </div>

                    <!-- Table Section -->
                    <!-- Table Setion End -->
                    <!--end: Datatable-->
                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.filter)
                    </div>
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>



