@model Hrms.Lite.Shared.DataBank.Reports.EmployeeMood
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    <script src="~/scripts/DataBank/Reports/EmployeeMood.js"></script>
    <script src="~/js/jquery.min.js"></script>

    <script src="~/js/datatables.min.js"></script>
    <script>
        $(document).ready(function () {
            debugger;

            fillData();

        });

    </script>
}
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Mood Meter</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>


                    <li class="breadcrumb-item">
                        Mood Meter Report
                    </li>

                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per">

                <div class="card-body">
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap align-items-center">

                            <div class="tab-items">

                                <div class="row-outer pb-2 " style="width:150px">
                                    <label>Date</label>
                                    <div class="input-group date">
                                        @Html.TextBoxFor(Model => Model.Date, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "From", @onchange = "fillData(),validateDate(this,'from')" })
                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <span id="from"></span>
                                </div>

                            </div>

                            <div class="tab-items">
                                <label>Mood</label>
                                <div class="form-group filter-combobox mt-0">
                                    @Html.DropDownListFor(m => m.MoodCode, (SelectList)ViewBag.EmployeeMood, "ALL", new { @class = "form-control form-control-sm", @onchange = "fillData()" })
                                    <span id="classification"></span>
                                </div>
                            </div>

                            <div class="tab-items select-option">



                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left" data-bs-original-title="Export to Excel">
                                    <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                </a>
                            </div>


                        </div>
                    </div>

                    <div id="EmployeeMoodlist">
                        @await Html.PartialAsync("~/Areas/DataBank/Reports/Views/EmployeeMood/EmployeeMoodlist.cshtml")
                    </div>

                    <div id="groupSummary">

                    </div>

                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.filter)
                    </div>

                    <!-- Table Section -->
                    <!-- Table Setion End -->
                    <!--end: Datatable-->
                </div>
            </div>

        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>


