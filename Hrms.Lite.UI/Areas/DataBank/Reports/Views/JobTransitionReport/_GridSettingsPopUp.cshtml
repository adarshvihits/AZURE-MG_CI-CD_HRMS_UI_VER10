@model Hrms.Lite.Shared.DataBank.Reports.JobTransitionReport



@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "Emp-popup" }))
{

<div style="padding:10px;"
     class="ihits-table table-border hover-color odd-even mobile-responsive-table emp-group-list-table vertical-scroll-250">



    <br>
    <table id="jobTran">
        <thead>
            <tr class="table-light">
                <th scope="col"> Classification</th>
                <th scope="col">
                    <div class="checkbox-inline justify-content-center">
                        <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                            <input type="checkbox"
                                   name="Checkboxes16"id="Job_Checkbox" onchange="OnCheckBoxAllClick('Job_Checkbox','jobTran')">
                            <span></span>
                        </label>
                    </div>
                </th>


            </tr>
        </thead>
        <tbody>
            @if (Model.GridSettings != null && Model.GridSettings.Count > 0)
            {

                for (int i = 0; i < Model.GridSettings.Count; i++)
                {
                    @Html.HiddenFor(model => Model.GridSettings[i].Code)
                    <tr>
                        <td data-label="Classification">@Model.GridSettings[i].Name</td>
                        <td data-label="Count">
                            <div class="checkbox-inline justify-content-center">
                                <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                    @*<input type="checkbox"
        name="Checkboxes16">*@
                                    @Html.HiddenFor(model => Model.GridSettings[i].Applicability)
                                    @Html.CheckBoxFor(m => m.GridSettings[i].Applicability)
                                    <span></span>
                                </label>
                            </div>

                        </td>




                    </tr>





                }


            }

                </tbody>


            </table>
            <div class="mt-3 mb-2">
                <button type="button" style="float:right" class="btn btn-default  mobile-full-width" onclick="OnApplyClick()">
                    Apply
                </button>
            </div>
        </div>
}