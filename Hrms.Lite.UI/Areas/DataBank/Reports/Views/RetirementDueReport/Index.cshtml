@model Hrms.Lite.Shared.DataBank.DTO.JobTransition
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Account.Login CurrentUser = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Account.Login>(Context.Session.GetString("User"));
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>

<script src="~/scripts/DataBank/Reports/retirementDueReport.js"></script>




<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Retirement Due Report</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>


                    <li class="breadcrumb-item">
                        Retirement Due Report
                    </li>

                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per">

                <div class="card-body">
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap align-items-center">
                            <div class="tab-items border-none d-flex align-items-center">
                                <div>
                                   
                                    <div class="radio-inline">
                                        <label class="radio radio-outline radio-success">
                                           
                                            @Html.RadioButtonFor(m => m.BasedOn, "1", new { @onchange = "GetList()" })
                                            <span></span>All
                                        </label>
                                        <label class="radio radio-outline radio-success">
                                            @*<input type="radio" name="radios15">*@
                                            @Html.RadioButtonFor(m => m.BasedOn, "2", new { @onchange = "GetList()" })
                                            <span></span>Date Wise
                                        </label>

                                    </div>
                                </div>
                            </div>
                            <div class=" dteDiv hide d-flex ">

                                <div class="row-outer pb-2 mr-5">


                                    <div class="input-group date">
                                        @Html.TextBoxFor(Model => Model.FromDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "From", onchange = "GetList()" })
                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <span id="fromdate"></span>
                                </div>
                                <div class="row-outer pb-2">


                                    <div class="input-group date">
                                        @Html.TextBoxFor(Model => Model.ToDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "To", onchange = "GetList()" })

                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <span id="todate"></span>
                                </div>
                            </div>
                            @*<div class="tab-items pl-3 dteDiv hide">

                                <div class="row-outer pb-2">
                          

                                    <div class="input-group date">
                                        @Html.TextBoxFor(Model => Model.ToDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "To", onchange = "GetList()" })

                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <span id="todate"></span>
                                </div>
                            </div>*@



                            <div class="tab-items select-option">




                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left" data-bs-original-title="Export to Excel">
                                    <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                </a>




                            </div>


                        </div>
                    </div>

                    <div id="ListView">
                        @await Html.PartialAsync("~/Areas/DataBank/Reports/Views/RetirementDueReport/_List.cshtml")
                    </div>
                  

                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.SliderFilter)
                    </div>

                    <!-- Table Section -->
                    <!-- Table Setion End -->
                    <!--end: Datatable-->
                </div>
            </div>

        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>


