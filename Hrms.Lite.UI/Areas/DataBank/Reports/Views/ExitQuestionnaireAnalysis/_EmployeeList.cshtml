@model Hrms.Lite.Shared.DataBank.Reports.ExitQuestionnaireAnalysis
<script src="~/js/settings.js"></script>
<div style="padding:10px;" class="ihits-table table-border hover-color odd-even mobile-responsive-table Exit-Questionnaire-poup-list ">
    @Html.HiddenFor(m => m.ExitQuestionnaireAnalysisList.Count)
    <table class="common-table">
        <thead>
            <tr class="table-light">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Last working Days">LWD</th>
                <th scope="col">Remarks</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.ExitQuestionnaireAnalysisList != null && Model.ExitQuestionnaireAnalysisList.Count > 0)
            {

                for (int i = 0; i < Model.ExitQuestionnaireAnalysisList.Count; i++)
                {
                    <tr>
                        @Html.HiddenFor(m => m.ExitQuestionnaireAnalysisList.Count)
                        <td data-label="ID">@Model.ExitQuestionnaireAnalysisList[i].EmployeeID</td>
                        <td data-label="Emoloyee Name">
                            @Model.ExitQuestionnaireAnalysisList[i].EmployeeName
                        </td>
                        <td data-label="Designation">@Model.ExitQuestionnaireAnalysisList[i].Designation</td>
                        <td data-label="Department">@Model.ExitQuestionnaireAnalysisList[i].Department</td>
                        <td data-label="Location">@Model.ExitQuestionnaireAnalysisList[i].Location</td>
                        <td data-label="LWD">
                            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.ExitQuestionnaireAnalysisList[i].LWD))
                        </td>
                        <td data-label="Remarks">@Model.ExitQuestionnaireAnalysisList[i].Remarks</td>

                    </tr>
                }
            }



        </tbody>


    </table>
</div>