@model Hrms.Lite.Shared.DataBank.Reports.EmployeeTaskReport
<script src="~/js/tooltip.js"></script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Employee-Task-Report_List">

    @Html.HiddenFor(m => m.EmployeeTaskReportList.Count)
    <table id="TaskReportTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Task Assigned To</th>
                <th scope="col">Department</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Task</th>
                <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Expected Completetion Date" scope="col">EDC</th>
                <th scope="col">Task Given By</th>
                <th scope="col">Action Count</th>
                <th scope="col">Status</th>
            </tr>
        </thead>
       
    </table>
</div>