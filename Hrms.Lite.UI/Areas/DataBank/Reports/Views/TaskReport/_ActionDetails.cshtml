@model Hrms.Lite.Shared.DataBank.Reports.EmployeeTaskReport
  <style>
      .actiondetails-list table thead tr th:nth-child(1),
      .actiondetails-list table tbody tr td:nth-child(1) {
          width: 10% !important;
      }

      .actiondetails-list table thead tr th:nth-child(2),
      .actiondetails-list table tbody tr td:nth-child(2) {
          width: 60% !important;
      }


      .actiondetails-list table thead tr th:nth-child(3),
      .actiondetails-list table tbody tr td:nth-child(3) {
          width: 30% !important;
      }

  </style>
<div style="padding:10px;" class="ihits-table table-border hover-color odd-even mobile-responsive-table  actiondetails-list  vertical-scroll-200">
    @*@Html.HiddenFor(m => m.ParticipantDetails.Count)*@

    <table id="ParticipantsCompleted">
        <thead>
            <tr class="table-dark">
                <th scope="col">Sl No</th>
                <th scope="col">Description</th>
                <th scope="col">Entry Date</th>
             


            </tr>
        </thead>
        <tbody>

            @if (Model.EmployeeTaskReportList != null && Model.EmployeeTaskReportList.Count > 0)
            {
                for (int i = 0; i < Model.EmployeeTaskReportList.Count; i++)

                {
            <tr>


                <td data-label="Sl No">@(@i + 1)</td>

                <td data-label="Employee Name">@Model.EmployeeTaskReportList[i].Description</td>
                <td data-label="Designation">@Model.EmployeeTaskReportList[i].EntryDate</td>

            </tr>
                }
            }
           

        </tbody>



    </table>
</div>


