@model Hrms.Lite.Shared.DataBank.Reports.EmployeeTaskReport
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Account.Login CurrentUser = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Account.Login>(Context.Session.GetString("User"));
}
<script src="~/js/jquery.min.js"></script>
<link href="~/css/tablestyle.css" rel="stylesheet" />
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/DataBank/Reports/TaskRep.js"></script>

<script>
    $(document).ready(function () {

        fillTaskReport();
    });
</script>
<!--begin::Header-->


<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Task Report</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>


                    <li class="breadcrumb-item">
                        Task Report
                    </li>

                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per">

                <div class="card-body">

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap align-items-center">

                            <div class="tab-items">

                                <div class="tab-items  pr-0 border-none select-option" style="width:160px!important;">
                                    <label>Status</label>
                                    @Html.DropDownListFor(Model => Model.Status.Code, (SelectList)ViewBag.Status, "All", new { @class = "form-control form-control-sm", @onchange = "fillTaskReport()" })

                                </div>
                                <span id="fromdate"></span>

                            </div>



                            <div class="tab-items select-option">


                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>


                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                   data-bs-original-title="Export to Excel" onclick="TaskReportExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>
                            </div>


                        </div>
                    </div>


                    <!-- Table Section -->

                    <div id="SeparationReportList">
                        @await Html.PartialAsync("~/Areas/DataBank/Reports/Views/TaskReport/_TaskReportList.cshtml", Model)
                    </div>
                    <!-- Table Setion End -->
                    <!--end: Datatable-->
                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
                    </div>
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
<!--end::Content-->
<div class="modal fade participantcompleteddetails" tabindex="-1" role="dialog" aria-labelledby="participantCompletedLabel" style="display: none;" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content popup">
            <div class="modal-header">
                <h5 class="modal-title" id="participantCompletedLabel">Action Details</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">
                <!-- Your content here -->
            </div>
        </div>
    </div>
</div>
