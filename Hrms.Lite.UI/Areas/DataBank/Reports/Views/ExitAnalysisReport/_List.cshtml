@model Hrms.Lite.Shared.DataBank.Reports.ExitAnalysisReport
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table ">

    @Html.HiddenFor(m => m.ExitAnalysisReportList.Count)
    @Html.HiddenFor(m => m.GI)

    <table id="ExitCheckListReportTable">
        <thead>
            <tr class="table-dark">
                <th scope="col">Classification</th>
                <th scope="col">Count</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.ExitAnalysisReportList != null && Model.ExitAnalysisReportList.Count > 0)
                {
                    for (int i = 0; i < Model.ExitAnalysisReportList.Count; i++)
                    {
                        <tr>
                            @Html.HiddenFor(Model => Model.ExitAnalysisReportList[i].GI)

                            <td data-label="Classification">@Model.ExitAnalysisReportList[i].Classification</td>
                            @*<td data-label="Count">@Model.ExitAnalysisReportList[i].ClassCount</td>*@
                            <td data-label="Count">
                                <a data-bs-toggle="modal" data-target=".exitAnalysislistreport" onclick="GetExitAnalysisPopUp('@Model.ExitAnalysisReportList[i].GI')">
                                    @Model.ExitAnalysisReportList[i].ClassCount
                                </a>
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>

    </table>
</div>

