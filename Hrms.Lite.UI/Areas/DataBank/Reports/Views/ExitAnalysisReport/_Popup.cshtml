@model Hrms.Lite.Shared.DataBank.Reports.ExitAnalysisReport
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Exit-CheckList-poup-list vertical-scroll-200">
    @Html.HiddenFor(m => m.ExitAnalysisReportList.Count)
    @Html.HiddenFor(m => m.EmployeeCode)
    <table id="exitAnalysispopup">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">DOJ</th>
                <th scope="col">LWD</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.ExitAnalysisReportList != null && Model.ExitAnalysisReportList.Count > 0)
                {
                    for (int i = 0; i < Model.ExitAnalysisReportList.Count; i++)
                    {
                        <tr>
                            <td data-label="ID">@Model.ExitAnalysisReportList[i].EmployeeID</td>
                            <td data-label="EmployeeName">@Model.ExitAnalysisReportList[i].EmployeeName</td>
                            <td data-label="Designation">@Model.ExitAnalysisReportList[i].Designation</td>
                            <td data-label="Department">@Model.ExitAnalysisReportList[i].Department</td>
                            <td data-label="Location">@Model.ExitAnalysisReportList[i].Location</td>
                            <td data-label="DOJ"> @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.ExitAnalysisReportList[i].DOJ))</td>
                            <td data-label="LWD"> @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.ExitAnalysisReportList[i].LWD))</td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div> 