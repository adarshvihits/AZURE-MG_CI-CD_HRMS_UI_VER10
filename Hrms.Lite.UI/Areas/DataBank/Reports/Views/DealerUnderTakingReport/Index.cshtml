@model Hrms.Lite.Shared.DataBank.Reports.DealerUnderTakingReport
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/DataBank/Reports/dealerUnderTakingReport.js"></script>


<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">

        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title"> Dealer Undertaking Report</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Dealer Undertaking Report
                    </li>

                </ul>
            </div>
        </div>

    </div>
</div>



<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">


            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items ml-5 pr-0 border-none ">
                                <div>
                                    @*<label>Based On</label>*@
                                    <div class="radio-inline">
                                        <label class="radio radio-outline radio-success">

                                            @Html.RadioButtonFor(m => m.TabIndex, "0", new { @onchange = "fillData()" })
                                            <span></span><div>All</div>
                                        </label>
                                        <label class="radio radio-outline radio-success">

                                            @Html.RadioButtonFor(m => m.TabIndex, "1", new { @onchange = "fillData()" })
                                            <span></span><div>Existing</div>
                                        </label>
                                        <label class="radio radio-outline radio-success">
                                            @*<input type="radio" name="radios15">*@
                                            @Html.RadioButtonFor(m => m.TabIndex, "2", new { @onchange = "fillData()" })
                                            <span></span><div>Seprated</div>
                                        </label>

                                    </div>
                                </div>

                            </div>


                            <div class="tab-items select-option">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="Export to Excel"
                                   class="btn btn-excel mr-0" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>

                            </div>
                        </div>
                    </div>


                    <div id="EmployeeVsNpsList">
                        @await Html.PartialAsync("~/Areas/DataBank/Reports/Views/DealerUnderTakingReport/_DealerUnderTakingReportList.cshtml", Model)
                    </div>
                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.filter)
                    </div>

                    @*<div id="filterSlider">
            @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.filter)
        </div>*@
                    <div id="AddNewOrEditSlider">


                    </div>

                </div>
            </div>

        </div>

    </div>

</div>


<div class="modal fade bd-example-modal-lg" id="UHID_Popup" tabindex="-1" aria-labelledby="myLargeModalLabel" style="display: none;" aria-hidden="true">
    <div class="modal-dialog modal-lg" style="max-width:1000px;">
        <div class="modal-content popup">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Dealer Undertaking Report</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body pt-0">


            </div>

            <div class="modal-footer border-0 p-0">
                
            </div>
        </div>
    </div>
</div>


