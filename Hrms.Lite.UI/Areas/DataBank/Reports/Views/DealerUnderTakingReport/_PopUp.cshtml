    <div>
        <div class="profile-header position-relative pb-12 mb-5" style="padding-bottom: 2px !important; padding-top: 5px !important;">
            <div class="row">
                <div class="col-md-1">
                    <div class="image-input image-input-outline image-input-circle float-right  emp_HeaderPic" id="kt_image_4">
                        <div class="image-input-wrapper">
                        </div>
                    </div>
                </div>
                <div class="col-md-9 d-flex align-items-center">
                    <div class="row">
                        <div class="flex-grow-1">
                            <!--begin::Title-->
                            <div class="d-flex justify-content-between flex-wrap">
                                <div class="d-flex mr-3 header-profile-name align-items-center">
                                    <a class="">@Model.Name</a>
                                    <span>(@Model.EmployeeId)</span>

                                </div>

                            </div>

                            <!--end::Title-->
                            <!--begin::Content-->

                        </div>
                    </div>
                </div>
                <div class="col-md-2 d-flex align-items-center">
                    <div class="form-group w-100">
                        @*@Html.HiddenFor(model => model.EmployeeCode)
                        @Html.TextBoxFor(m => m.UHIDNumber, new { @class = "form-control form-control-sm", placeholder = "UHID No", @maxlength = "120" })*@
                    </div>

                </div>

            </div>
            <div class="profile-header-overflow"></div>
        </div>
        <div style="padding:10px;" class="ihits-table table-border hover-color odd-even mobile-responsive-table  vertical-scroll-200">
            <table id="">
                <thead>
                    <tr class="table-light">
                        <th scope="col">Effective Date</th>
                        <th scope="col">Remarks</th>
                        <th scope="col">Status</th>
                        <th scope="col">Closing Date</th>
                        <th scope="col">Created By </th>
                        <th scope="col">Approved By</th>


                    </tr>
                </thead>
                <tbody>

                    @{
                        if (Model.DealerUnderTakingList != null && Model.DealerUnderTakingList.Count > 0)
                        {
                            for (int i = 0; i < Model.DealerUnderTakingList.Count; i++)

                            {
                                        <tr>

                                            <td data-label="Employee Name">
                                                @Model.DealerUnderTakingList[i].EffectiveDate.ToString("dd/MM/yyyy")
                                               
                                            </td>
                                            <td data-label="Relation">  @Model.DealerUnderTakingList[i].Remarks</td>
                                            <td data-label="Relation">  @Model.DealerUnderTakingList[i].Status</td>
                                            <td data-label="Employee Name">
                                                @Model.DealerUnderTakingList[i].CloseDate.ToString("dd/MM/yyyy")
                                               
                                            </td>

                                            <td data-label="Occupation">
                                                @Model.DealerUnderTakingList[i].CreatedBy
                                            </td>
                                            <td data-label=">UHID No">
                                                @Model.DealerUnderTakingList[i].ApprovedBy
                                            </td>




                                        </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" style="text-align:center; font-weight:600;">
                                    No data available
                                </td>
                            </tr>
                        }
                    }


                </tbody>


            </table>
        </div>
    </div>

