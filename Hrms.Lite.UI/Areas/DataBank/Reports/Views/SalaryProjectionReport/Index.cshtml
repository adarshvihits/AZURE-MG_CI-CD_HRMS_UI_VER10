@model Hrms.Lite.Shared.DataBank.Reports.SalaryProjectionReport
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/js/settings.js"></script>
<script src="~/scripts/DataBank/Reports/SalaryProjectionReport.js"></script>

<script>
    $(document).ready(function () {
        getProjPopup();
    });
</script>

<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Salary Projection Report</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Salary Projection Report
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <!--end::Container-->
</div>

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->
            <div class="card card-custom height-100per footer-row-fixed">
                <div class="card-body">
                    <!--begin: Search Form-->
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items">
                            </div>
                            <div class="tab-items select-option d-flex">
                                <div class="tab-items" style=" padding-right: 140px;">
                                    <a id="wageGradeMasterAdd" type="button" class="btn btn-default  mobile-full-width" data-bs-toggle="modal" data-target=".salaryprojection" onclick="getProjPopup()">
                                       Add Projection
                                    </a>
                                    </div>
                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search" onclick="$('#searchList').focus();"></i>
                                        </div>
                                        <input id="searchList" type="text" class="form-control form-control-sm"
                                               placeholder="Search Here" onkeyup="searchRows()">
                                    </div>
                                    <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left" data-bs-original-title="Export to Excel">
                                        <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                    </a>
                                </div>
                            </div>
                    </div>
                    <div id="SalaryProjectionReportList">
                        @await Html.PartialAsync("_List.cshtml", Model.ds)
                    </div>
                    <!--end: Datatable-->
                    <div id="filterSlider">
                        @*@await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.filter)*@
                    </div>
                </div>
                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->
    </div>
</div>


<div class="modal fade salaryprojection" tabindex="-1" role="dialog"
     aria-labelledby="salaryprojectionreport" aria-hidden="true">
    <div class="modal-dialog modal-lg " style="max-width: 1000px;">
        <div class="modal-content popup">
            <div class="modal-header pb-4">
                <h5 class="modal-title" id="salaryprojectionreport">Add Projection</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body pt-3">
            </div>
            </div>
        </div>
</div>