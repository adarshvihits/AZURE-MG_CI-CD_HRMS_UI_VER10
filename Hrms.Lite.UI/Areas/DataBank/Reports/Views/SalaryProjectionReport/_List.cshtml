@*@model Hrms.Lite.Shared.DataBank.Reports.SalaryProjectionReport*@
@model System.Data.DataSet
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>

@if (Model != null)
{
    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table salary_projection_report">

        <table id="salaryproj" class="common-table">
            <thead>
                <tr class="table-dark">
                    @foreach (System.Data.DataColumn col in Model.Tables[0].Columns)
                    {

                        <th>@col.ColumnName</th>

                    }
                </tr>
            </thead>
            <tbody>
                @foreach (System.Data.DataRow row in Model.Tables[0].Rows)
                {

                    <tr>
                        @foreach (var item in row.ItemArray)
                        {


                            <td>@item.ToString()</td>

                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

}


