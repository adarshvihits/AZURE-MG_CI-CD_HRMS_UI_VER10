<div class="ihits-table table-border hover-color odd-even mobile-responsive-table ConfirmationTracking_list">
   @Html.HiddenFor(m => m.ConfirmationTrackingReportList.Count)
    <table id="ConfirmationTable" >
        <thead>
            <tr class="table-dark">

                <th scope="col">ID</th>
                <th scope="col">Name</th>
                <th scope="col">Designation</th>
                <th scope="col">Functional Designation</th>
                <th scope="col">Region</th>
                <th scope="col">Present Salary</th>
                <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Reporting Manager Status">RM Status</th>
                <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Reporting Manager Reason">RM Reason</th>
                <th scope="col">Reporting Manager</th>
                <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="HR Executive Status">HR Status</th>
                <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="HR Executive Reason">HR Reason</th>
                <th scope="col">HR Executive</th>
