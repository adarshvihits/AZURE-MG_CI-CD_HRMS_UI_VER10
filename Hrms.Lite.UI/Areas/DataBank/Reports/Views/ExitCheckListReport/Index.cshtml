@model Hrms.Lite.Shared.DataBank.Reports.ExitCheckListReport

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/DataBank/Reports/exitCheckListReport.js"></script>

<script>
    $(document).ready(function () {
        debugger;

        fillData();

    });

</script>

<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Exit CheckList Report</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>


                    <li class="breadcrumb-item">
                        Exit CheckList Report
                    </li>

                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per">

                <div class="card-body">
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap align-items-center">

                            <div class="tab-items">

                                <div class="row-outer pb-2">
                                    <label>From</label>
                                    @*<span class="Mandatroy">*</span>*@
                                    <div class="input-group date">
                                        @Html.TextBoxFor(Model => Model.FromDate, "{0:dd-MMM-yyyy}", new
                                        {
                                            @class = "form-control kt_datepicker_2",
                                            @readonly = "true",
                                            @placeholder = "From",
                                       onchange = "fillData('fromdate');validate(this,'fromdate')"
                                        })
                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <span id="fromdate"></span>
                                </div>
                            </div>
                            <div class="tab-items pl-3">

                                <div class="row-outer pb-2">
                                    <label>To</label>
                                    @*<span class="Mandatroy">*</span>*@
                                    <div class="input-group date">
                                        @Html.TextBoxFor(Model => Model.ToDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "To", onchange = "fillData('todate');validate(this,'todate')" })

                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <span id="todate"></span>
                                </div>
                            </div>



                            <div class="tab-items select-option">


                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left" data-bs-original-title="Export to Excel">
                                    <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                </a>



                                @*<div class="filter-button" data-bs-toggle="tooltip" title="" data-bs-original-title="Filter">
                                        <i class="fas fa-filter"></i>
                                    </div>*@

                            </div>


                        </div>
                    </div>

                    <div id="ExitCheckListReport">
                        @await Html.PartialAsync("~/Areas/DataBank/Reports/Views/ExitCheckListReport/_ExitCheckListReportList.cshtml")
                    </div>



                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.filter)
                    </div>

                    <!-- Table Section -->
                    <!-- Table Setion End -->
                    <!--end: Datatable-->
                </div>
            </div>

        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>


<div class="modal fade exitchecklistreport" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" style="max-width: 1000px;">
        <div class="modal-content popup">
            <div class="modal-header" style="padding:10px">
                <h5 class="modal-title" id="exampleModalLabel">Exit CheckList Details</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close" onclick="$('#filterSlider').addClass('hide')"></i>
                </button>
            </div>

            <div class="modal-body"></div>



        </div>
    </div>
</div>
