@model Hrms.Lite.Shared.DataBank.Reports.ExitCheckListReport   

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Exit-CheckList-poup-list vertical-scroll-200">
    @Html.HiddenFor(m => m.ExitCheckListDetails.Count)
    @Html.HiddenFor(m => m.EmployeeCode)
    <table id="exitpopup">
        <thead>
            <tr class="table-dark">
                <th scope="col">SlNo</th>
                <th scope="col">Item</th>
                <th scope="col">Type</th>
                <th scope="col">Status</th>
                <th scope="col">Remarks</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.ExitCheckListDetails != null && Model.ExitCheckListDetails.Count > 0)
            {

                for (int i = 0; i < Model.ExitCheckListDetails.Count; i++)
                {
                    <tr>
                        @Html.HiddenFor(m => m.ExitCheckListDetails.Count)
                        <td data-label="SlNo">@Model.ExitCheckListDetails[i].SlNo</td>
                        <td data-label="Item">
                            @Model.ExitCheckListDetails[i].Item
                        </td>
                        <td data-label="Type">@Model.ExitCheckListDetails[i].Type</td>
                        <td data-label="Status">@Model.ExitCheckListDetails[i].Status</td>
                        <td data-label="Remarks">@Model.ExitCheckListDetails[i].Remarks</td>

                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8">
                        <div style="text-align: center;display: flex;align-items: center;justify-content: center;height: 60vh;"><img src="/images/nodata.png" /></div>
                    </td>
                </tr>
            }



        </tbody>


    </table>
</div>
