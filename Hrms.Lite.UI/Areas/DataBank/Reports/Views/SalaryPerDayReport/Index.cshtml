
@model Hrms.Lite.Shared.DataBank.Reports.SalaryPerDayReport
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>

<script src="~/scripts/DataBank/Reports/SalaryPerDayReport.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.allwMultiselect').multiselect({
            includeSelectAllOption: true,
            nonSelectedText: 'None selected',
            enableCaseInsensitiveFiltering: true,
            includeFilterClearBtn: false,



        });

        $('#Allowance')
        /*            .multiselect('selectAll', false);*/
        $('#SalaryDays').val('1');
        $('#DividingFactor').val('26');
        fillData();
    });
</script>
<style>
    .btn-multi-selection {
        border: 1px solid #999999 !important;
    }
</style>
@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "salaryperday_form" }))
{

    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->

            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Salary Per Day Report</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            Salary Per Day Report
                        </li>
                    </ul>
                </div>
            </div>
            <!--begin::Topbar-->
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->

                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body">

                        <!--begin: Search Form-->
                        <div class="row tab-style-button">
                            <div class="tab-button-wrap">

                                <div class="tab-items">
                                    <label>Salary Days</label>
                                    <div class="form-group" style="width: 190px;">
                                        @Html.TextBoxFor(m => m.SalaryDays, new { @class = "form-control form-control-sm", @placeholder = "Salary No of Days", @onkeypress = "return onlyNumberKey(event)", @maxlength = 5, @onblur = "validateSalaryDays(this);" })

                                        @*@Html.TextBoxFor(m => m.SalaryDays, new { @class = "form-control form-control-sm", @placeholder = "Salary No of Days", @onkeypress = "return onlyNumberKey(event)", @maxlength = 5, @onchange = "validate(this,'spSalaryDays')" })*@
                                        <span id="spSalaryDays" style="bottom: -20px;"></span>
                                    </div>

                                </div>



                                <div class="tab-items">
                                    <label>Dividing Factor</label>
                                    <div class="form-group" style="width: 190px;">

                                        @Html.TextBoxFor(m => m.DividingFactor, new { @class = "form-control form-control-sm", @placeholder = "Dividing Factor", @onkeypress = "return onlyNumberKey(event)", @maxlength = 5, @onchange = "validateDividingFactor(this)" })

                                    </div>
                                    <span id="spDividingFactor"></span>
                                </div>

                                <div class="tab-items">
                                    <div class="row-outer ">
                                        <label>
                                            <label>Allowance Type</label>
                                        </label>
                                        <div class="form-group Allowdiv" style="width: 200px;">
                                            @Html.ListBoxFor(Model => Model.Allowance, (SelectList)ViewBag.AllowanceType, new
                                       {
                                           @class = "allwMultiselect form-control-multiselect form-control-sm",
                                           @multiple = "multiple",
                                           @onchange = "validateMultiselect('Allowance', 'spAllowance','Allowdiv')"


                                       })

                                        </div>
                                        <span id="spAllowance"></span>
                                    </div>

                                </div>


                                <div class="tab-items pt-4 d-flex align-items-center">
                                    <button type="button" class="btn btn-default btn-sm float-left" onclick="ValidateRequiredData();fillData();">
                                        Proceed
                                    </button>
                                </div>

                                <div class="tab-items select-option pt-6 align-items-center">

                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>

                                    <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>

                                    <a data-bs-toggle="tooltip" title="" class="btn btn-excel" data-bs-original-title="Export to Excel" onclick="ExportToExcel()">
                                        <i class="icon-xl far fa-file-excel"></i>
                                    </a>

                                </div>

                            </div>
                        </div>
                        <div id="salaryperdaylist">
                            @await Html.PartialAsync("_List.cshtml", Model)
                        </div>

                        <!-- Table Section -->
                        <!-- Table Setion End -->
                        <div class="row card-footer-bottom-fixed">
                        </div>

                        <!--end: Datatable-->
                    </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>

    </div>
    <!--end::Content-->
    <!--end::Entry-->
}
<div id="filterSlider">
    @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.filter)

    @*@await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.filter)*@
</div>
