@model Hrms.Lite.Shared.DataBank.Reports.NightAllowanceTracking

    <style>

            .popup {
                margin: 2% auto;
                padding: 10px;
            }

            .pro_ph {
                padding: 6px !important;
                border-radius: 10px;
            }

            .image-input .image-input-wrapper {
                width: 50px;
                height: 50px;
            }


            .scond-divsprate {
                border-radius: 10px;
                border: 1px solid lightgrey;
                padding: 10px;
            }

    </style>


    <!--begin::Dashboard-->
    <!--begin::Row-->

    <div class="page-scroll-new popup_header  ">

        <div class="profile-header position-relative pb-12 mb-5" style=" padding: 3px 20px !important;">
            <!--begin: Search Form-->
            @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeHeader.cshtml", Model.EmployeeHeader)

            <div class="profile-header-overflow"></div>
        </div>
        <div class="scond-divsprate">
            <div class="row">
                <div class="col-md-2">
                    <div class="row-outer">
                        <label class="view-title">Request ID:</label>
                        <div class="view-details">@Model.RequestID</div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="row-outer">
                        <label class="view-title">Purpose:</label>
                        <div class="view-details">@Model.Purpose</div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="row-outer">
                        <label class="view-title">Apply Date:</label>
                        <div class="view-details">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.ApplyDate))</div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="row-outer">
                        <label class="view-title">Status:</label>
                        <div class="view-details">@Model.Status</div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="row-outer">
                        <label class="view-title">Hours Worked:</label>
                        <div class="view-details">@Model.TotalHours</div>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="row-outer">
                        <label class="view-title">Amount:</label>
                        <div class="view-details">@Model.Amount</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="scond-divsprate mt-3">

            <div class="ihits-table table-border odd-even mobile-responsive-table vertical-scroll-100">
                <table id="RequestDetTable" class="common-table">
                    <thead>
                        <tr class="table-dark">
                            <th scope="col">Sl.No.</th>
                            <th scope="col">From Date</th>
                            <th scope="col">From Time</th>
                            <th scope="col">To Date</th>
                            <th scope="col">To Time</th>
                            <th scope="col">Total Hours</th>
                            <th scope="col">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RequestDetailsList != null && Model.RequestDetailsList.Count > 0)
                        {

                            for (int i = 0; i < Model.RequestDetailsList.Count; i++)
                            {
                                @Html.HiddenFor(m => m.RequestDetailsList.Count)
                        <tr>
                            <td data-label="SlNo">@Model.RequestDetailsList[i].SlNo</td>
                            <td data-label="FromDate">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.RequestDetailsList[i].From))</td>
                            <td data-label="FromTime">@Model.RequestDetailsList[i].StartTime</td>
                            <td data-label="ToDate">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.RequestDetailsList[i].To))</td>
                            <td data-label="ToTime">@Model.RequestDetailsList[i].EndTime</td>
                            <td data-label="TotalHours">@Model.RequestDetailsList[i].TotalTime</td>
                            <td data-label="Amount">@Model.RequestDetailsList[i].Amount</td>
                        </tr>

                            }
                        }
                        else
                        {
                            <tr>
                                <td>

                                    <div id="noDataFound" style="text-align: center;display: flex;align-items: center;justify-content: center;height: 30vh;"><img src="/images/nodata.png" style="width:130px;" /></div>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>

            </div>
        </div>
        <div class="scond-divsprate mt-3">

            <div class="ihits-table table-border odd-even mobile-responsive-table vertical-scroll-120">
                <table id="ApprovalDetTable" class="common-table">
                    <thead>
                        <tr class="table-dark">
                            <th scope="col">ID</th>
                            <th scope="col">Authority</th>
                            <th scope="col">Designation</th>
                            <th scope="col">Action</th>
                            <th scope="col">Action Time</th>
                            <th scope="col">Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.AuthorityDetailsList != null && Model.AuthorityDetailsList.Count > 0)
                        {

                            for (int i = 0; i < Model.AuthorityDetailsList.Count; i++)
                            {
                                @Html.HiddenFor(m => m.AuthorityDetailsList.Count)
                        <tr>
                            <td data-label="ID">@Model.AuthorityDetailsList[i].EmployeeID</td>
                            <td data-label="Authority">@Model.AuthorityDetailsList[i].Authority</td>
                            <td data-label="Designation">@Model.AuthorityDetailsList[i].Designation</td>
                            <td data-label="Action">@Model.AuthorityDetailsList[i].Action</td>
                            <td data-label="Action Time"> @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.AuthorityDetailsList[i].ActionTime))</td>
                            <td data-label="Remarks">@Model.AuthorityDetailsList[i].Remarks</td>
                        </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td>

                                    <div id="noDataFound" style="text-align: center;display: flex;align-items: center;justify-content: center;height: 30vh;"><img src="/images/nodata.png" style="width:130px;" /></div>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>

            </div>
        </div>

    </div>