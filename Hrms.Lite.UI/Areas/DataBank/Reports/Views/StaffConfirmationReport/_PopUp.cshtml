@model Hrms.Lite.Shared.DataBank.Reports.StaffConfirmationReport

<script src="~/scripts/DataBank/Reports/StaffConfirmationReport.js"></script>
@*<script src="~/js/settings.js"></script>*@
<style>

    search-slider-inner1 .select-option .fa-search::before {
        content: '';
        display: block;
        width: 20px;
        background: url(../images/icons/Search_icon.svg);
        border: none;
        height: 20px;
        background-repeat: no-repeat;
        z-index: 100 !important;
        position: absolute !important;
    }
</style>
<script>
    searchClick = 0;
    function onSearchClick() {
        debugger;
        if (searchClick == 0) {
            searchClick = 1;
            $('.dataTableSearchPopup').addClass('field-width-big');
            /*CursorFocusOnSearch();*/
        }
        else {
            searchClick = 0;
            $('.dataTableSearchPopup').removeClass('field-width-big');
        }
    }


    $(document).ready(function () {

        $(".search-slider-inner2").click(function () {
            $("#searchList").toggleClass('field-width-big')
        });

        //$('.search-slider-inner').click(function () {

        //    $('.pop-up').val('');
        //    $('.pop-up').focus();
        //    dataTable.search('').draw();
        //});
    });


</script>

<div class="row" style="padding:5px 16px;">


    @*<div class="col-md-3 d-flex justify-content-end">

            <div class="tab-items select-option">



                <div class="sraech-slider" style=" margin-top: 0px;">
                    <div class="search-slider-inner">
                        <i class="fa fa-search" onclick="onSearchClick()"></i>
                    </div>
                    <input type="text" id="searchList" class="form-control form-control-sm pop-up dataTableSearchPopup"
                           placeholder="Search by Item" onkeyup="searchRows()">
                </div>



                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                   data-bs-original-title="Export to Excel" onclick="ItemDetailsExportToExcel()">
                    <i class="icon-xl far fa-file-excel"></i>
                </a>
            </div>
        </div>*@





    <div class="popup_header  ">
        <div class="profile-header position-relative pb-12 mb-5">
            <div class="">

                <div class="col-md-12 pl-10">
                    <div class="row">
                        <div class="d-flex">
                            <div class="image-input-wrapper">
                                <div class="image-input image-input-outline image-input-circle  mr-5 emp_HeaderPic" id="kt_image_4">
                                    <div class="image-input-wrapper">
                                    </div>
                                </div>
                            </div>
                            <div class="flex-grow-1">

                                <!--begin::Title-->
                                <div class="d-flex justify-content-between flex-wrap ">
                                    <div class="d-flex mr-3 header-profile-name">
                                        <a class="header-profile-name">@Model.EmployeeHeader.EmployeeName</a>

                                    </div>

                                </div>
                                <!--end::Title-->
                                <!--begin::Content-->
                                <div class="d-flex flex-wrap justify-content-between">
                                    <div class="d-flex flex-column flex-grow-1 pr-8">
                                        <div class="d-flex flex-wrap mb-1">
                                            <a data-bs-toggle="tooltip" data-bs-original-title="Functional Designation" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                <i class="fas fa-network-wired icon-nm mr-2"></i>@Model.EmployeeHeader.FunctionalDesignation
                                            </a>
                                            <a data-bs-toggle="tooltip" data-bs-original-title="Designation" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                <i class="fas fa-briefcase icon-nm mr-2"></i>@Model.EmployeeHeader.Designation.Name
                                            </a>
                                            <a data-bs-toggle="tooltip" data-bs-original-title="Department" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                <i class="fas fa-building icon-nm mr-2"></i>@Model.EmployeeHeader.Department.Name

                                            </a>
                                            <a data-bs-toggle="tooltip" data-bs-original-title="Location" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                <i class="fas fa-map-marker-alt icon-nm mr-2"></i>@Model.EmployeeHeader.Location.Name

                                            </a>

                                            <a data-bs-toggle="tooltip" data-bs-original-title="Location Code" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                <i class="fas fa-map-marker-alt icon-nm mr-2"></i>@Model.EmployeeHeader.LocationCode
                                            </a>
                                            <a data-bs-toggle="tooltip" data-bs-original-title="DOJ" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                <i class="fas fa-calendar-alt icon-nm mr-2"></i>@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.EmployeeHeader.DOJ))
                                            </a>
                                            <a data-bs-toggle="tooltip" data-bs-original-title="Category" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                <i class="fas fa-check-square icon-nm mr-2"></i>@Model.EmployeeHeader.Category.Name
                                            </a>




                                        </div>



                                    </div>



                                </div>

                                <!--end::Content-->
                            </div>

                        </div>
                    </div>

                </div>
            </div>







            <div class="profile-header-overflow"></div>
        </div>


    </div>


    <div class="row tab-style-button w-100">
        <div class="tab-button-wrap align-items-center">

            <div class="tab-items">

                <div class="form-group">
                    <label>Entry Remarks</label>
                    <div style="width: 580px; overflow-y: scroll; height: 40px; display: block;">@Model.Remarks</div>
                   
                </div>

            </div>


            <div class="tab-items select-option pt-3 mb-3">


                <div class="sraech-slider mt-3 ml-5">
                    <div class="search-slider-inner2">
                        <i class="fa fa-search" onclick="$('#searchList').focus();"></i>
                    </div>
                    <input id="searchList" type="text" class="form-control form-control-sm"
                           placeholder="Search Here..." onkeyup="combination1searchRows()">
                </div>

                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                   data-bs-original-title="Export to Excel" onclick="ItemDetailsExportToExcel('@Model.EmployeeGI')">
                    <i class="icon-xl far fa-file-excel"></i>
                </a>


            </div>



        </div>
    </div>







    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table staff_confirmationDetails  vertical-scroll-200">
        @Html.HiddenFor(m => m.StaffConfirmationReportDetails.Count)

        <table id="combination1tblID">

            <thead>
                <tr class="table-dark">

                    <th scope="col">Employee ID</th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">Designation</th>
                    <th scope="col">Status</th>
                    <th scope="col">Submitted Date</th>
                </tr>
            </thead>
            <tbody>

                @if (Model.StaffConfirmationReportDetails != null && Model.StaffConfirmationReportDetails.Count > 0)
                {

                    for (int i = 0; i < Model.StaffConfirmationReportDetails.Count; i++)
                    {
                        <tr>
                            <td data-label="Sl.No.">@Model.StaffConfirmationReportDetails[i].EmployeeID</td>
                            <td data-label="Item">@Model.StaffConfirmationReportDetails[i].EmployeeName</td>
                            <td data-label="Type">@Model.StaffConfirmationReportDetails[i].Designation</td>
                            <td data-label="Status">@Model.StaffConfirmationReportDetails[i].EmployeeStatus</td>
                            <td data-label="Remarks">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.StaffConfirmationReportDetails[i].SubmittedDate))</td>
                        </tr>


                    }
                }
                else
                {
                    <tr>
                        <td colspan="8">
                            <div style="text-align: center;display: flex;align-items: center;justify-content: center;height: 60vh;"><img src="/images/nodata.png" /></div>
                        </td>
                    </tr>
                }

            </tbody>


        </table>
    </div>
</div>

