@model Hrms.Lite.Shared.DataBank.Reports.StaffConfirmationReport

<script src="~/js/settings.js"></script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table StaffConfirmationReport">
    @Html.HiddenFor(Model => Model.StaffConfirmationReportList.Count)
    <table id="ArearProcessingTable" class="common-table">
        <thead>
            <tr class="table-dark">

                <th scope="col">ID </th>
                <th scope="col">Employee Name </th>
                <th scope="col">Designation</th>
                <th scope="col">Functional Designation</th>
                <th scope="col">Region</th>
                <th scope="col">Submitted Date</th>
                <th scope="col">Employee Count</th>
                <th scope="col">View</th>




            </tr>
        </thead>
        <tbody>
            @if (Model.StaffConfirmationReportList != null && Model.StaffConfirmationReportList.Count > 0)
            {

                for (int i = 0; i < Model.StaffConfirmationReportList.Count; i++)
                {
            <tr>
                <td data-label="Applicant ID">
                    @Html.HiddenFor(m => m.StaffConfirmationReportList[i].EmployeeCode)
                    @Html.HiddenFor(m => m.StaffConfirmationReportList[i].EmployeeGI)
                    @Model.StaffConfirmationReportList[i].EmployeeID
                </td>
                <td data-label="DOB">@Model.StaffConfirmationReportList[i].EmployeeName</td>
                <td data-label="Mobile">@Model.StaffConfirmationReportList[i].Designation</td>
                <td data-label="Mobile">@Model.StaffConfirmationReportList[i].FunctionalDesignation</td>
                <td data-label="Mobile">@Model.StaffConfirmationReportList[i].Region</td>
                <td data-label="Email">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.StaffConfirmationReportList[i].SubmittedDate))</td>
                <td data-label="DOB">@Model.StaffConfirmationReportList[i].Count</td>
                <td data-label="">
                    <a data-bs-toggle="tooltip" title="" class="icon-xl la la-arrow-circle-right" onclick="GetDetails('@Model.StaffConfirmationReportList[i].EmployeeGI');" data-bs-original-title="View"> </a>

                </td>







            </tr>

                }
            }
        </tbody>
    </table>
</div>







