@model Hrms.Lite.Shared.DataBank.Reports.SeparationReport
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Account.Login CurrentUser = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Account.Login>(Context.Session.GetString("User"));
}
<script>
    $(document).ready(function () {
         salVisible = @CurrentUser.authUser.SalaryVisibility;
        fillData();
    });
</script>


<div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog"
     aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content popup">
            <div class="modal-header" style="padding:10px">
                <h5 class="modal-title" id="exampleModalLabel">
                    Group Summary
                </h5>
                <button type="button" class="close" data-bs-dismiss="modal"
                        aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div style="padding:10px;"
                 class="ihits-table table-border hover-color odd-even mobile-responsive-table emp_profile-list-table vertical-scroll-250">

                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label>Group By</label>

                            @Html.DropDownListFor(m => m.GroupBy.Code, (SelectList)ViewBag.GrpBy, new { @class = "form-control form-control-sm", @onchange = "onGroupByChange(this)" })
                        </div>
                    </div>

                    <div class="col-md-8 d-flex justify-content-end">

                        <a data-bs-toggle="tooltip" title=""
                           class="btn btn-excel"
                           data-bs-original-title="Export to Excel" onclick="GroupSummaryExportToExcel()">
                            <i class="icon-xl far fa-file-excel"></i>
                        </a>
                    </div>

                </div>

                <br>
                <div id="GroupSummaryListDiv">
                    @await Html.PartialAsync("~/Areas/DataBank/Reports/Views/SeparationReport/_GroupSummaryList.cshtml", Model)
                </div>

            </div>


        </div>
    </div>
</div>
