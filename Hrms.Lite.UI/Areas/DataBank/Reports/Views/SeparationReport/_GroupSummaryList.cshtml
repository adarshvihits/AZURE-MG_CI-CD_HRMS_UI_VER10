@model Hrms.Lite.Shared.DataBank.Reports.SeparationReport

@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Account.Login CurrentUser = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Account.Login>(Context.Session.GetString("User"));
}

<script>
    $(document).ready(function () {
        salVisible = @CurrentUser.authUser.SalaryVisibility;

    });
</script>


<table id="GroupsummaryTable">
    <thead>
        <tr class="table-light">
            <th scope="col">@Model.GroupByName</th>
            <th scope="col">Count</th>
            <th scope="col">%</th>

            @if (CurrentUser.authUser.SalaryVisibility != 0)
            {
                <th scope="col">CTC</th>

                <th scope="col">%</th>
            }
            </tr>
    </thead>
    <tbody>
        @{ var TotalCount = 0;
            decimal TotalCTC = 0;
        }

        @if (Model != null && Model.EmployeeProfileSummary != null && Model.EmployeeProfileSummary.Count > 0)
        {

            for (int i = 0; i < Model.EmployeeProfileSummary.Count; i++)
            {
        <tr>
            <td data-label="Department">@Model.EmployeeProfileSummary[i].Name</td>
            <td data-label="Count">
                @Model.EmployeeProfileSummary[i].Count

            </td>
            <td data-label="%">@Model.EmployeeProfileSummary[i].Count_Perc </td>

            @if (CurrentUser.authUser.SalaryVisibility != 0)
            {
                <td data-label="CTC">@Convert.ToInt32(Model.EmployeeProfileSummary[i].CTC)</td>
                <td data-label="%">@Model.EmployeeProfileSummary[i].CTC_Perc</td>
            }
                @{

                    TotalCount += Model.EmployeeProfileSummary[i].Count;
                    TotalCTC += Model.EmployeeProfileSummary[i].CTC;
                }


            </tr>

            }
        }
    <tr style=" position: sticky; bottom: 0;" class="table-light">
        <td data-label="ID"><strong></strong></td>

        <td data-label="No of days">
            <strong>@TotalCount</strong>
        </td>


        <td data-label="No of days">
        </td>

        @if (CurrentUser.authUser.SalaryVisibility != 0)
        {
            <td data-label="No of days">
                <strong>@Convert.ToInt32(TotalCTC)</strong>
            </td>
        }

            <td data-label="No of days">
            </td>

        </tr>

    </tbody>


</table>