<div id="separationReportGroupSummary">
    @await Html.PartialAsync("~/Areas/DataBank/Reports/Views/SeparationReport/_GroupSummary.cshtml", Model)
</div>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table separation-report-list">
   
        @Html.HiddenFor(m => m.SeparationReportList.Count)
    <table id="SeparationTable" >
        <thead>
            <tr class="table-dark">

                <th scope="col">ID / Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">Category</th>
                <th scope="col" data-bs-toggle="tooltip"
                    data-bs-original-title="Date Of Joining" scope="col">DOJ</th>
                <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Resignation Date" scope="col">Resignation Date</th>
                <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Last Working Date" scope="col">LWD</th>
                <th data-bs-toggle="tooltip" data-bs-original-title="Years of Experience"
                    scope="col">Y/S</th>
                <th scope="col">Gross Pay</th>
                <th scope="col">Separation Type</th>
                <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Resignation Entry Remarks">Res. Entry Rmks.</th>
                <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Resignation Acceptance Remarks">Res. Acc. Rmks.</th>
                <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Resignation Relieving Remarks">Res. Rel. Rmks.</th>
                <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Resignation Relieving Remarks">Work Handover Details</th>
                <th scope="col">Reason</th>
            </tr>
        </thead>
