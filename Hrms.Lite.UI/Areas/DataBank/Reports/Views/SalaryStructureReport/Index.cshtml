@model Tuple<Hrms.Lite.Shared.DataBank.Reports.SalaryStructureReport, System.Data.DataTable>
<script src="~/scripts/DataBank/Reports/SalaryStructureReport.js?v=1"></script>

<script src="~/js/jquery.min.js"></script>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->
            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Salary Band Report</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>
                        <li class="breadcrumb-item text-muted">
                            Salary Band Report
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->
                <div class="card card-custom height-100per footer-row-fixed">
                    <div class="card-body">
                        <!--begin: Search Form-->
                        <div class="row tab-style-button">
                            <div class="tab-button-wrap align-items-center">
                                <div class="tab-items high ">
                                    <a class="btn-title active ActiveTab" onclick="OnTabClick('ActiveTab',0)">
                                        Active
                                        <span id="active" class="btn-notification AllTabCount">@Model.Item1.ActiveCount</span>
                                    </a>
                                </div>
                                <div class="tab-items medium">
                                    <a class="btn-title ResignedTab" onclick="OnTabClick('ResignedTab',1)">
                                        Resigned
                                        <span id="resigned" class="btn-notification ResignedTabCount">@Model.Item1.ResignedCount</span>
                                    </a>
                                </div>
                                <input type="hidden" id="TabCode" name="TabCode" value="0" />
                                <input type="hidden" id="SalaryStructureReportDetails_Count" name="SalaryStructureReportDetails_Count" value=@Model.Item1.ActiveCount />

                                <div class="tab-items select-option">
                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>
                                    <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>
                                    <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                       data-bs-original-title="Export to Excel">
                                        <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div id="SalaryList">
                            @await Html.PartialAsync("~/Areas/DataBank/Reports/Views/SalaryStructureReport/_ActiveList.cshtml", Model)
                        </div>
                        <div id="filterSlider">
                            @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Item1.SliderFilter)
                        </div>
                        <!--end: Datatable-->
                    </div>
                </div>
                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->
    </div>
    <div class="slider-over-flow"></div>
    <!--end::Content-->
</div>