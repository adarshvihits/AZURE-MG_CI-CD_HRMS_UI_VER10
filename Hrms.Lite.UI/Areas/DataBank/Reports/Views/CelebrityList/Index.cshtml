@model Hrms.Lite.Shared.DataBank.Reports.CelebrityList
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>

<script src="~/scripts/DataBank/Reports/CelebrityList.js"></script>

<script>
    $(document).ready(function () {

        //fillData();
        if ('@Model.FirstTab' == 'Joining') {
            OnTabClick('JoiningTab', 'Joining');
        }
        else if ('@Model.FirstTab' == 'Work') {
            OnTabClick('JoiningTab', 'Joining')
        }
        else if ('@Model.FirstTab' == 'Wedding') {
            OnTabClick('weddingTab', 'Wedding')
        }
        else if ('@Model.FirstTab' == 'Birthday')
        {
            OnTabClick('BirthdayTab', 'Birthday')
        }
    });
</script>


<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            @if (Model.Breadscrumb == "Life Events")
            {

            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Moments</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a href="@Url.Action("Index", "LifeEvents", new { Area = "DataBank" })">Moments</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Celebrity List
                    </li>

                </ul>
            </div>
            }
            else
            {                       
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Celebrity List </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>


                    <li class="breadcrumb-item">
                        Celebrity List
                    </li>

                </ul>
            </div>
            }
        </div>
        <!--begin::Topbar-->
        
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>


<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per">
                @Html.Hidden("empfileStorage", (string)ViewBag.Storage)
                <div class="card-body">
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap align-items-center">
                            <div class="tab-items  ">
                                <a class="btn-title active All" onclick="OnTabClick('All','All')">

                                    All
                                    <span class="btn-notification allCount">@Model.AllCount</span>

                                </a>



                            </div>
                            <div class="tab-items high">
                                <a class="btn-title BirthdayTab" onclick="OnTabClick('BirthdayTab','Birthday')">

                                    Birthday
                                    <span class="btn-notification BdayTab">@Model.BirthdayCount</span>

                                </a>
                            </div>
                            <div class="tab-items medium">
                                <a class="btn-title WeddingTab" onclick="OnTabClick('weddingTab','Wedding')">

                                    Wedding
                                    <span class="btn-notification weddingtab">@Model.WeddingCount</span>
                                </a>
                            </div>
                            <div class="tab-items high">
                                <a class="btn-title JoiningTab" onclick="OnTabClick('JoiningTab','Joining')">

                                    Joining
                                    <span class="btn-notification joiningTab">@Model.JoiningCount</span>
                                </a>
                            </div>


                            <div class="tab-items pl-20">

                                <div class="row-outer pb-2">
                                    <label>From</label>


                                    <div class="input-group date">
                                        @*<input type="text" class="form-control" id="kt_datepicker_2"
                                readonly="readonly" placeholder="From" style="width:140px ;">*@

                                        @Html.TextBoxFor(Model => Model.FromDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "From", @onchange = "fillData();validate(this,'frmDte')" })
                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <span id="frmDte"></span>


                                </div>
                            </div>
                            <div class="tab-items pl-3">

                                <div class="row-outer pb-2">
                                    <label>To</label>
                                    <div class="input-group date">
                                        @*<input type="text" class="form-control" id="kt_datepicker_2"
                                readonly="readonly" placeholder="To" style="width:140px ;">*@
                                        @Html.TextBoxFor(Model => Model.ToDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "To", @onchange = "fillData();validate(this,'toDte')" })
                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <span id="toDte"></span>
                                </div>
                            </div>




                            <div class="tab-items select-option pt-3">


                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn" data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                   data-bs-original-title="Export to Excel" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>


                            </div>





                        </div>
                    </div>

                    <div id="CelebritylistId">
                        @await Html.PartialAsync("_AllCelebrityList.cshtml", Model)

                    </div>
                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
                    </div>

                </div>
            </div>
            

            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>