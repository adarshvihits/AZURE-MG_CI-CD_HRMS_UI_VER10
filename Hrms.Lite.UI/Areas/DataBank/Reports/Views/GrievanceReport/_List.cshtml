@model Hrms.Lite.Shared.DataBank.Reports.Grievance

<script src="~/js/settings.js"></script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table    Grievance-report-tble-list">
    @Html.HiddenFor(m => m.GrievanceList.Count)
    <div class="">
        <div class="">
            <table style="table-layout:auto;" class="common-table">
                <thead>
                    <tr class="table-dark">
                        <th scope="col" class="sticky-col  groupsummary-cols">ID</th>
                        <th scope="col" class="sticky-col totals-col">Employee Name</th>
                        <th scope="col" class="basic-cols">Fun.Designation</th>


                        <th scope="col" class="basic-cols">Department</th>
                        <th scope="col" class="basic-cols">Location</th>
                        <th scope="col" class=" basic-cols">Grievance Category </th>
                        <th scope="col" class=" basic-cols">Reference Number</th>
                        <th scope="col" class=" basic-cols">Requested Date</th>
                        <th scope="col" class=" basic-cols">Grievance</th>
                        <th scope="col" class=" basic-cols">Suggestion</th>
                        <th scope="col" class=" basic-cols">Grievance Authority</th>
                        <th scope="col" class=" basic-cols">Current Status</th>
                        <th scope="col" class=" basic-cols">Accepted Date</th>
                        <th scope="col" class=" basic-cols">Action Taken Date</th>
                        <th scope="col" class=" basic-cols">Action</th>
                        <th scope="col" class=" basic-cols">View</th>



                    </tr>
                </thead>
                <tbody>

                    @if (Model.GrievanceList != null && Model.GrievanceList.Count > 0)
                        {
                            for (int i = 0; i < Model.GrievanceList.Count; i++)
                            {
                    <tr>
                        <td data-label="ID" class="sticky-col groupsummary-cols">@Model.GrievanceList[i].Employee.EmployeeID</td>
                        <td data-label="Employee Name" class="sticky-col totals-col">
                            @Model.GrievanceList[i].Employee.FullName

                        </td>
                        <td data-label="Designation" class=""> @Model.GrievanceList[i].Designation</td>

                        <td data-label="Department" class="basic-cols"> @Model.GrievanceList[i].Department</td>
                        <td data-label="Location" class=" basic-cols"> @Model.GrievanceList[i].Location</td>
                        <td data-label="Present Days" class=" basic-cols">@Model.GrievanceList[i].Category.CategoryName</td>
                        <td data-label="PF No" class=" basic-cols"> @Model.GrievanceList[i].RefNo</td>
                        <td data-label="Payment type" class=" basic-cols">
                            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.GrievanceList[i].RequestedDate))

                        </td>
                        <td data-label="Present Days" class=" basic-cols">@Model.GrievanceList[i].Gievance</td>
                        <td data-label="LOP" class=" basic-cols">@Model.GrievanceList[i].Suggestion</td>
                        <td data-label="Basic" class=" basic-cols">@Model.GrievanceList[i].AuthName</td>
                        <td data-label="House Rent Allowance" class=" basic-cols">@Model.GrievanceList[i].Status</td>
                        <td data-label="Other Allowance" class=" basic-cols">
                            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.GrievanceList[i].AcceptedDate))



                        <td data-label="Gross pay" class=" basic-cols">
                            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.GrievanceList[i].ActionTakenDate))

                        </td>
                        <td data-label="PF" class=" basic-cols">@Model.GrievanceList[i].ActionTaken</td>
                        @*<td data-label="ESI" class=" basic-cols">Suspension</td>*@
                        <td data-label="other Ded" class=" basic-cols">
                            <a data-bs-toggle="tooltip" title="" id="viewgrievance" type="button" class="btn btn-icon btn-eye icon-only pr-2" data-bs-original-title="" onclick="showDocument('@Model.GrievanceList[i].File.FileName','@Model.GrievanceList[i].AbsoluteUri')">
                                <i class="icon-xl far fa-eye"></i>
                            </a>
                        </td>


                    </tr>



                            }
                        }


                </tbody>
            </table>
        </div>
    </div>
</div>
