
@model Hrms.Lite.Shared.DataBank.Reports.Grievance


@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="~/scripts/DataBank/Reports/GrievanceReport.js"></script>


<script src="~/js/jquery.min.js"></script>


<script src="~/js/datatables.min.js"></script>

<div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->


            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title"> Grievance Report</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            Grievance Report
                        </li>
                    </ul>
                </div>
            </div>
            <!--begin::Topbar-->
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body">


                        <div class="row tab-style-button">
                            <div class="tab-button-wrap align-items-center">

                                <div class="tab-items">

                                    <div class="row-outer pb-2">
                                        <label>From</label>
                                        <div class="input-group date">
                                            @Html.TextBoxFor(Model => Model.From, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "From", @onchange = "onDateClick();getList();ValidateDate()" })
                                            <span id="frodate"></span>
                                            <div class="input-group-append">
                                                <span class="input-group-text">
                                                    <i class="la la-calendar"></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>




                                <div class="tab-items pl-3">

                                    <div class="row-outer pb-2">
                                        <label>To</label>
                                        <div class="input-group date">
                                            @Html.TextBoxFor(Model => Model.To, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "From",@onchange = "onDateClick();getList();ValidateDate()" })
                                            <span id="todate"></span>
                                            <div class="input-group-append">
                                                <span class="input-group-text">
                                                    <i class="la la-calendar"></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>


                                <div class="tab-items">

                                    <div class="row-outer pb-2 " style="width:150px">
                                        <label>Grievance Category</label>

                                        <div class="form-group ">
                                            @Html.DropDownListFor(m => m.Category.Code, (SelectList)ViewBag.Category, "--Select--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'cat');getList()" })
                                            <span id="cat"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="tab-items">

                                </div>

                                <div class="form-group filter-combobox mr-10 highs mb-0 mt-2">

                                </div>


                                <div class="tab-items select-option lows">


                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>
                                    <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>





                                    <button data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                            data-bs-original-title="Export to Excel">
                                        <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                    </button>


                                </div>


                            </div>
                        </div>
                        <div id="listIDgrievance">
                            @await Html.PartialAsync("~/Areas/DataBank/Reports/Views/GrievanceReport/_List.cshtml")
                        </div>
                        <div id="filterSlider">
                            @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
                        </div>


                        <!--end: Datatable-->
                        <!--end: Datatable-->
                    </div>

                    <div class="row card-footer-bottom-fixed">



                    </div>



                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>
    <div class="slider-over-flow"></div>
    <!--end::Content-->


</div>