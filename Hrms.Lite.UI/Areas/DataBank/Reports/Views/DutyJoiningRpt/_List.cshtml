@model Hrms.Lite.Shared.DataBank.Reports.DutyJoiningRpt

<script src="~/js/settings.js"></script>
<script src="~/js/tooltip.js"></script>
<style>

    /*RecruitmentTrackerReportnewnew*/
    .DutyJoiningRpt-list table thead tr th:nth-child(1),
    .DutyJoiningRpt-list table tbody tr td:nth-child(1) {
        width: 5% !important;
    }

    .DutyJoiningRpt-list table thead tr th:nth-child(2),
    .DutyJoiningRpt-list table tbody tr td:nth-child(2) {
        width: 20% !important;
    }

    .DutyJoiningRpt-list table thead tr th:nth-child(3),
    .DutyJoiningRpt-list table tbody tr td:nth-child(3) {
        width: 20% !important;
    }

    .DutyJoiningRpt-list table thead tr th:nth-child(4),
    .DutyJoiningRpt-list table tbody tr td:nth-child(4) {
        width: 25% !important;
    }

    .DutyJoiningRpt-list table thead tr th:nth-child(5),
    .DutyJoiningRpt-list table tbody tr td:nth-child(5) {
        width: 15% !important;
        text-align: center;
    }

    .DutyJoiningRpt-list table thead tr th:nth-child(6),
    .DutyJoiningRpt-list table tbody tr td:nth-child(6) {
        width: 15% !important;
        text-align: center;
    }




</style>

<div class="ihits-table table-border hover-color odd-even DutyJoiningRpt-list">
    @Html.HiddenFor(m => m.DutyJoiningRptList.Count)
    @*@Html.HiddenFor(m => m.ConsoleCode)*@

    <table id="FormIVReport_Table" class="common-table">

        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                @*<th scope="col">SubmittedDate</th>*@
                <th scope="col">Duty Joining Report</th>
                <th scope="col">Employee Information Sheet</th>



            </tr>
        </thead>
        <tbody>

            @if (Model != null && Model.DutyJoiningRptList != null && Model.DutyJoiningRptList.Count > 0)
            {

                for (int i = 0; i < Model.DutyJoiningRptList.Count; i++)
                {

                    @Html.HiddenFor(m => m.DutyJoiningRptList[i].EmployeeCode)
                    <tr>


                        <td data-label="ID">@Model.DutyJoiningRptList[i].ID</td>
                        <td data-label="Employee Name">@Model.DutyJoiningRptList[i].EmployeeName</td>
                        <td data-label="Department">@Model.DutyJoiningRptList[i].Department</td>
                        <td data-label="Location">@Model.DutyJoiningRptList[i].Location</td>
                        @*<td data-label="SubmittedDate"> @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.DutyJoiningRptList[i].SubmittedDate))</td>*@
                        <td data-label="Duty Joining Report">
                            <a onmouseenter="tooltipHover()" onclick="onDownloadClick( '@Model.DutyJoiningRptList[i].EmployeeCode')" data-bs-toggle="tooltip" title="Download" type="button" class="btn   icon-only"><i class="fa fa-download" aria-hidden="true" style="    font-size: 22px !important;"></i></a>
                        </td>

                        <td data-label="Employee Information Sheet">
                            <a onmouseenter="tooltipHover()" onclick="onEmpInfoDownloadClick( '@Model.DutyJoiningRptList[i].EmployeeCode')" data-bs-toggle="tooltip" title="Download" type="button" class="btn   icon-only"><i class="fa fa-download" aria-hidden="true" style="    font-size: 22px !important;"></i></a>
                        </td>
                    </tr>
                }
            }

        </tbody>
    </table>
</div>



