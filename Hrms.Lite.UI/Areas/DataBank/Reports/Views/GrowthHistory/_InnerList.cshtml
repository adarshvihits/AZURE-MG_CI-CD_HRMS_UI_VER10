                        @Html.HiddenFor(m => m.JobTransition_FixedProvision[i].NewAmount, new { @class = "ProvisionsAmount" })
                    </td>


                </tr>
                        }
                    }

                    @if (Model.JobTransition_VariableProvision != null && Model.JobTransition_VariableProvision.Count > 0)
