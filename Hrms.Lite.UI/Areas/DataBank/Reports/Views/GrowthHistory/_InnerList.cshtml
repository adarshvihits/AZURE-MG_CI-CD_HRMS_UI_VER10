                                        <button type="button" class="btn btn-icon btn-close">
                                            <i class="icon-xl fas fa-times"></i>

                                        </button>
                                    }


                                </td>



                            </tr>
                        }
                    }


                    @if (Model.JobTransition_FixedProvision != null && Model.JobTransition_FixedProvision.Count > 0)
