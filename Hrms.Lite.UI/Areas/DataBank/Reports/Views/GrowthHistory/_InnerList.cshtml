                        <td data-label="Classifition">Salary Band</td>
                        <td data-label="Current">
                            @Model.JobTransition_JobDetail.CurrentSalaryStructure.Name
                        </td>
                        <td data-label="New">
                            @Model.JobTransition_JobDetail.NewSalaryStructure.Name

                        </td>

                    </tr>
                    @if (Model != null && Model.JobTransition_Authority != null && Model.JobTransition_Authority.Count > 0)
                    {
                        for (int i = 0; i < Model.JobTransition_Authority.Count; i++)
                        {
                            <tr>
                                @if (@Model.JobTransition_Authority[i].RequestTypeName == "Reporting Manager")
                                {
                                    <td data-label="Classifition">@Model.JobTransition_Authority[i].RequestTypeName</td>
                                }
                                else
                                {
                                    <td data-label="Classifition">@Model.JobTransition_Authority[i].RequestTypeName Authority</td>
                                }
                                <td data-label="Current">
                                    @Model.JobTransition_Authority[i].AuthorityName_Old
                                </td>
                                <td data-label="New">
                                    @Model.JobTransition_Authority[i].AuthorityName_New
                                </td>
                            </tr>
