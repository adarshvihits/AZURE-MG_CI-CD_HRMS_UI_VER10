                            <tr>
                                <td data-label="Variable Allowance">@Html.HiddenFor(m => m.JobTransition_VaiableAllowance[i].Code)@Model.JobTransition_VaiableAllowance[i].Name</td>
                                <td>@Model.JobTransition_VaiableAllowance[i].AllowanceType</td>
                                <td data-label="Check Item">

                                    @if (Model.JobTransition_VaiableAllowance[i].OldApplicable == true)
                                    {

                                        <button type="button" class="btn btn-icon btn-tick">
                                            <i class="icon-xl fas fa-check"></i>
                                        </button>

                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-icon btn-close">
                                            <i class="icon-xl fas fa-times"></i>

                                        </button>
                                    }



                                </td>
                                <td data-label="Check Item">
                                    @if (Model.JobTransition_VaiableAllowance[i].Applicable == true)
                                    {

                                        <button type="button" class="btn btn-icon btn-tick">
                                            <i class="icon-xl fas fa-check"></i>
                                        </button>

                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-icon btn-close">
                                            <i class="icon-xl fas fa-times"></i>

                                        </button>
                                    }


                                </td>



                            </tr>
                        }
                    }

