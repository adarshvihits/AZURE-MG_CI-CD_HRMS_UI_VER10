                    <tr class="table-light">
                        <th scope="col">Classification</th>
                        <th scope="col">Type</th>
                        <th scope="col">Current</th>
                        <th scope="col">New</th>

                    </tr>
                </thead>
                <tbody>


                    @if (Model.JobTransition_FixedAllowance != null && Model.JobTransition_FixedAllowance.Count > 0)
                    {

                        for (int i = 0; i < Model.JobTransition_FixedAllowance.Count; i++)
                        {
                            <tr>
                                <td data-label="Fixed Allowance">
                                    @Model.JobTransition_FixedAllowance[i].Name
                                    @Html.HiddenFor(m => m.JobTransition_FixedAllowance[i].Code)
                                </td>
                                <td>
                                    @Model.JobTransition_FixedAllowance[i].AllowanceType
                                </td>
                                <td data-label="Amount">
                                    @Html.DisplayFor(m => m.JobTransition_FixedAllowance[i].CurrentAmount)
                                    @Html.HiddenFor(m => m.JobTransition_FixedAllowance[i].CurrentAmount)
                                </td>
                                <td data-label="Amount">
                                    @Html.DisplayFor(m => m.JobTransition_FixedAllowance[i].NewAmount)
                                    @Html.HiddenFor(m => m.JobTransition_FixedAllowance[i].NewAmount, new { @class = "AllowanceAmount" })
                                </td>

                            </tr>
                        }
                    }

                    @if (Model.JobTransition_VaiableAllowance != null && Model.JobTransition_VaiableAllowance.Count > 0)
                    {

                        for (int i = 0; i < Model.JobTransition_VaiableAllowance.Count; i++)
