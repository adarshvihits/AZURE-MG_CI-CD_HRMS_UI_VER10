@model Hrms.Lite.Shared.DataBank.DTO.JobTransition

<div class="row">

    <div class="col-md-6">

        <div class="ihits-table table-border  mobile-responsive-table vertical-scroll-250 career_history_inner_list">
            <table>
                <thead>
                    <tr class="table-light">
                        <th scope="col">Classification</th>
                        <th scope="col">Current</th>
                        <th scope="col">New</th>

                    </tr>
                </thead>
                <tbody>

                    <tr>
                        <td data-label="Classifition">Designation</td>
                        <td data-label="Current">@Model.JobTransition_JobDetail.CurrentDesignation.Name</td>
                        <td data-label="New">
                            @Model.JobTransition_JobDetail.NewDesignation.Name

                        </td>
                    <tr>
                        <td data-label="Classifition">Department</td>
                        <td data-label="Current">@Model.JobTransition_JobDetail.CurrentDepartment.Name</td>
                        <td data-label="New">
                            @Model.JobTransition_JobDetail.NewDepartment.Name

                        </td>

                    </tr>

                    <tr>
                        <td data-label="Classifition">Location</td>
                        <td data-label="Current">
                            @Model.JobTransition_JobDetail.CurrentLocation.Name
                        </td>
                        <td data-label="New">
                            @Model.JobTransition_JobDetail.NewLocation.Name
                        </td>

                    </tr>

                    <tr>
                        <td data-label="Classifition">Category</td>
                        <td data-label="Current"> @Model.JobTransition_JobDetail.CurrentCategory.Name</td>
                        <td data-label="New">
