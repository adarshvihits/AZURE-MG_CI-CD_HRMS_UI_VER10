@model Hrms.Lite.Shared.DataBank.DTO.EmployeeProfile
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>
<link href="~/css/kendo/2023.1.117/kendo.bootstrap-main.min.css" rel="stylesheet" />
<script src="~/js/kendo/kendo.all.min.js"></script>
<script src="~/js/kendo/kendo.aspnetmvc.min.js"></script>
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->

        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Career History</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a href="@Url.Action("Index", "GrowthHistory", new { Area = "DataBank" })" class="">Career History</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Career History
                    </li>
                </ul>
            </div>
        </div>


    </div>
    <!--end::Container-->
</div>
<!--end::Header-->



<div class="card card-custom height-100per footer-row-fixed">

    <div class="card-body">

        <div class="row">

            <div class="col-xl-6 col-md-6">
                <!---- profile section----->

                <div class="profile-header position-relative box-shadow-none mb-2 gutter-b">


                    @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeHeader.cshtml", Model.EmployeeHeader)
                    <input data-val="true" data-val-required="The EmployeeGI field is required." id="EmployeeGI" name="EmployeeGI" type="hidden" value="6e3333d8-44be-4d35-b39b-51208a42c961">
                    <div class="profile-header-overflow"></div>
                </div>

                <!---- profile section----->
                <!---- Timeline section----->
                <div class="timeline timeline-3 mt-13 vertical-scroll-500">
                    <div class="timeline-items">
                        @if (Model.GrowthHistory != null && Model.GrowthHistory.Count > 0)
                        {

                            for (int i = 0; i < Model.GrowthHistory.Count; i++)
                            {
                                <div class="timeline-item">
                                    <div class="timeline-media">
                                        <a href="#"><img src="~/images/icons/Promotion.png" /> </a>
                                    </div>

                                    <div class="timeline-content card">
                                        <div class="d-flex align-items-center justify-content-between mb-3">
                                            <div class="mr-2">
                                                <a href="#" class="text-dark-75 text-hover-primary font-weight-bold promotion">@Model.GrowthHistory[i].TransitionType</a>


                                            </div>

                                            <div class="dropdown ml-2" data-bs-toggle="tooltip" title="" data-placement="left" data-bs-original-title="">
                                                <span class="promotion ml-2">@Model.GrowthHistory[i].GrossPay</span>

                                            </div>

                                        </div>
                                        <div class="d-flex flex-wrap justify-content-between">
                                            <div class="">
                                                <div class="d-flex flex-wrap mb-1">

                                                    <a data-bs-toggle="tooltip" data-bs-original-title="" class="header-profile-email mr-4 mb-lg-0 mb-2">
                                                        <i class="fas fa-calendar-alt icon-nm mr-2"></i>@Model.GrowthHistory[i].EffectiveDate_
                                                    </a>

                                                    <a data-bs-toggle="tooltip" data-bs-original-title="" class="header-profile-email mr-4 mb-lg-0 mb-2">
                                                        <i class="fas fa-user-tie icon-nm mr-2"></i>

                                                        @Model.GrowthHistory[i].Designation
                                                    </a>
                                                    <a data-bs-toggle="tooltip" data-bs-original-title="" class="header-profile-email mr-4 mb-lg-0 mb-2">
                                                        <i class="fas fa-map-marker-alt icon-nm mr-2"></i>@Model.GrowthHistory[i].Location
                                                    </a>
                                                    <a data-bs-toggle="tooltip" data-bs-original-title="" class="header-profile-email mr-4 mb-lg-0 mb-2">
                                                        <i class="fas fa-network-wired icon-nm mr-2"></i>@Model.GrowthHistory[i].Category
                                                    </a>



                                                </div>



                                            </div>



                                        </div>
                                    </div>
                                </div>
                            }
                        }

                    </div>
                </div>

                <!-----Timeline section----->

            </div>




            <div class="col-xl-6 col-md-6" id="graphPartial">
                @await Html.PartialAsync("~/Areas/DataBank/Reports/Views/GrowthHistory/_GrowthHistoryGraph.cshtml", Model.GrowthHistory)
            </div>

        </div>




    </div>

</div>