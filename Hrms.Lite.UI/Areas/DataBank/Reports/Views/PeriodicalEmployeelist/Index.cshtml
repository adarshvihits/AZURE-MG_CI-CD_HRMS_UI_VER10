@model Hrms.Lite.Shared.DataBank.Reports.PeriodicalEmployeelist
@{ ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Account.Login CurrentUser = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Account.Login>(Context.Session.GetString("User"));
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/DataBank/Reports/PeriodicalEmployeelist.js"></script>

<script>
    $(document).ready(function () {
        salVisible = @CurrentUser.authUser.SalaryVisibility;
        fillData();
    });
</script>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Period wise Employee List</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" <i class="icon-nm fas fa-home"></i></a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Period wise Employee List
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->
            <div class="card card-custom height-100per footer-row-fixed">
                <div class="card-body">
                    <!--begin: Search Form-->
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap align-items-center">
                            <div class="tab-items">
                                <div class="row-outer pb-2 " style="width:150px">
                                    <label>From</label>
                                    <div class="input-group date">
                                        @Html.TextBoxFor(Model => Model.FromDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "From", onchange = "fillData()" })
                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <span id="Fromdate"></span>
                                </div>
                            </div>
                            <div class="tab-items">
                                <div class="row-outer pb-2" style="width:150px">
                                    <label>To</label>
                                    <div class="input-group date">
                                        @Html.TextBoxFor(Model => Model.ToDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "To", onchange = "fillData()" })
                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <span id="Todate"></span>
                                </div>
                            </div>
                            <div class="tab-items select-option ">
                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <button data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                        data-bs-original-title="Export to Excel">
                                    <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!--end: Datatable-->
                    <!--end: Datatable-->

                    <div id="PeriodicalEmployeelist">
                        @await Html.PartialAsync("~/Areas/DataBank/Reports/Views/PeriodicalEmployeelist/_PeriodicalEmployeelistDetails.cshtml", Model)
                    </div>
                    <div id="popUp">
                    </div>
                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.filter)
                    </div>
                </div>
            </div>
            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>
<!--end::Content-->
