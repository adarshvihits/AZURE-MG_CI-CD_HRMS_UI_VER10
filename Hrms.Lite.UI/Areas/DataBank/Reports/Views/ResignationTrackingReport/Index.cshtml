@model Hrms.Lite.Shared.DataBank.Reports.ResignationTracker
    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/datatables.min.js"></script>
    <script src="~/scripts/DataBank/Reports/ResignationTracker.js"></script>

    @{
        ViewData["Title"] = "Index";
        Layout = "~/Views/Shared/_Layout.cshtml";
    }

    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->


            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Resignation Tracker</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            Resignation Tracker
                        </li>

                    </ul>
                </div>
            </div>

            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body">

                        <div class="row tab-style-button">
                            <div class="tab-button-wrap">



                                <!-- <div class="tab-items high">
        <a href="applicant-tracking-list-background-verification.html" class="btn-title">Background Verification
            <span class="btn-notification">025</span>
        </a>
    </div> -->

                                <div class="tab-items pl-3 d-flex align-items-end">
                                    <div class="row-outer pb-2 d-flex align-items-center">
                                        <label>From</label>
                                        <div class="input-group date pl-3">

                                            @Html.TextBoxFor(m => Model.FromDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2 RFromDate", @readonly = "true", @placeholder = "From", @onchange = "onDateChange()" })
                                            <div class="input-group-append ">
                                                <span class="input-group-text">
                                                    <i class="la la-calendar"></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>


                                <div class="tab-items pl-3 d-flex align-items-end">
                                    <div class="row-outer pb-2 d-flex align-items-center">
                                        <label>To</label>
                                        <div class="input-group date pl-3">

                                            @Html.TextBoxFor(m => Model.ToDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2 RToDate", @readonly = "true", @placeholder = "To", @onchange = "onDateChange()" })
                                            <div class="input-group-append">
                                                <span class="input-group-text">
                                                    <i class="la la-calendar"></i>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="tab-items pl-3">

                                    <div class="">
                                     

                                        @Html.DropDownListFor(m => m.Status, (SelectList)ViewBag.ResignationStatus, new { @class = "form-control form-control-sm", @onchange = "onDateChange()" })
                                    </div>

                                </div>

                                <div class="tab-items select-option ">








                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>



                                    <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>
                                    <button data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                            data-bs-original-title="Export to Excel">
                                        <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                    </button>
                                </div>


                            </div>
                            </div>


                        <div id="ResignationTrackerList">
                            @await Html.PartialAsync("~/Areas/DataBank/Reports/Views/ResignationTrackingReport/_List.cshtml", Model)
                        </div>

                        <div id="ResignationTrackerSlider">

                        </div>

                        <div id="filterSlider">
                            @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
                        </div>

                        <!--end: Datatable-->
                    </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>
    <!--end::Content-->
