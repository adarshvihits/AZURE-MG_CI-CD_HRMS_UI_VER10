@model Hrms.Lite.Shared.DataBank.Reports.ResignationTracker

<script>
    $(document).ready(function () {
        if ($('#Breadcrumb').val() == "Employee Rejoin")
            onEditClick();

        $.ajax({
            type: "POST",
            url: "/AccessFile/ViewAsBackGroundImage", // do not hard code your url's
            data: { filename: '@Model.EmployeeHeader.FileName' },
            success: function (data, jqXHR, response) {

                if (jqXHR = "success") {
                    var mimeType = getMimeTypeFromFilename('@Model.EmployeeHeader.FileName');
                    debugger
                    $('.emp_HeaderPic').css('background-image', "url('" + mimeType + data + "')");


                }
            },
            error: function (xhr, textStatus, errorThrown) {
            }
        });

    });

</script>
<div id="applicant" class="slider-forms slider-forms-open TrackerSlider">
    <div class="slider-inner-style new-inner-style">
        <div class="slider-form-close" onclick="CloseSlider('TrackerSlider')">
            <i class="ki ki-close icon-xs text-muted"></i>
        </div>
        <div class="location-slider">
            <h4 class="mb-4">Resignation Tracker</h4>


            <div class="profile-header position-relative pb-12 mb-5"
                 style="padding-bottom: 2px !important; padding-top: 5px !important;">
                <div class="row">
                    <div class="col-md-2">
                        <div class="image-input image-input-outline image-input-circle float-right emp_HeaderPic"
                             id="kt_image_4">
                            <div class="image-input-wrapper">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-10 pl-7">
                        <div class="row">

                            <div class="flex-grow-1">
                                <!--begin::Title-->
                                <div class="d-flex justify-content-between flex-wrap">
                                    <div class="d-flex mr-3 header-profile-name">
                                        <span class="">
                                            @Model.EmployeeHeader.EmployeeName
                                        </span>
                                        @*<span>
                                            (  @Model.Details.EmployeeID
                                            )
                                        </span>*@

                                    </div>

                                </div>

                                <!--end::Title-->
                                <!--begin::Content-->
                                <div class="d-flex flex-wrap justify-content-between">
                                    <div class="d-flex flex-column flex-grow-1 pr-8">
                                        <div class="d-flex flex-wrap mb-1">
                                            <span data-bs-toggle="tooltip"
                                                  data-bs-original-title="Designation"
                                                  class="header-profile-email mr-5 mb-lg-0 mb-2">
                                                <i class="fas fa-briefcase icon-nm mr-2"></i>@Model.EmployeeHeader.Designation.Name
                                            </span>
                                            <span data-bs-toggle="tooltip"
                                                  data-bs-original-title="Department"
                                                  class="header-profile-email mr-5 mb-lg-0 mb-2">
                                                <i class="fas fa-network-wired icon-nm mr-2"></i>@Model.EmployeeHeader.Department.Name
                                            </span>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="profile-header-overflow"></div>
            </div>
        </div>

       

        <div class="add-padding">
            <div>

                @if (Model.TrackerDetails != null && Model.TrackerDetails.Count > 0)
                {
                    for (int i = Model.TrackerDetails.Count - 1; i >= 0; i--)
                    {
                        if (@Model.TrackerDetails[i].ApprovalStatus == "Pending")

                        {

                            <!-- completed -->
                            <div class="step">
                                <div class="v-stepper">
                                    <div class="circle"><i class="fa fa-check"></i></div>
                                    <div class="line"></div>
                                </div>

                                <div class="stepper-content">
                                    <div class="row-outer">
                                        <label class="view-title">@Model.TrackerDetails[i].Stage</label>
                                        <div class="view-details">
                                            @Model.TrackerDetails[i].ApprovalStatus, @Model.TrackerDetails[i].Approver
                                        </div>
                                    </div>



                                </div>
                            </div>
                        }
                        else if (@Model.TrackerDetails[i].ApprovalStatus == "Rejected")
                        {
                            <div class="step active rejected">
                                <div class="v-stepper">
                                    <div class="circle"><i class="icon-xl fas fa-times"></i></div>
                                    <div class="line"></div>
                                </div>

                                <div class="stepper-content">
                                    <div class="row-outer">
                                        <label class="view-title">@Model.TrackerDetails[i].Stage</label>

                                        <div class="view-details">
                                            @Model.TrackerDetails[i].ApprovalStatus, @Model.TrackerDetails[i].Approver, @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.TrackerDetails[i].Date))
                                        </div>

                                    </div>



                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="step active completed">
                                <div class="v-stepper">
                                    <div class="circle"><i class="fa fa-check"></i></div>
                                    <div class="line"></div>
                                </div>

                                <div class="stepper-content">
                                    <div class="row-outer">
                                        <label class="view-title">@Model.TrackerDetails[i].Stage</label>
                                        @if (Model.TrackerDetails[i].ApprovalStatus == "Applied")
                                        {
                                            <div class="view-details">
                                                @Model.TrackerDetails[i].ApprovalStatus, @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.TrackerDetails[i].Date))
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="view-details">
                                                @Model.TrackerDetails[i].ApprovalStatus, @Model.TrackerDetails[i].Approver, @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.TrackerDetails[i].Date))
                                            </div>
                                        }
                                    </div>



                                </div>
                            </div>
                        }


                    }
                }
            </div>





            @if (Model.AcceptanceList != null && Model.AcceptanceList.Count > 0)
            {



                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Resignation Reason</label>
                            <div class="view-details">
                                @Model.AcceptanceList[0].Reason
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Entry Date</label>
                            <div class="view-details">
                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.AcceptanceList[0].ResignationDate))
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Last Working Date As per Policy</label>
                            <div class="view-details">
                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.AcceptanceList[0].LastWorkingDateAsperPolicy))
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12">
                            <div class="row-outer">
                                <label class="view-title">Description</label>
                                <div class="view-details">
                                    @Model.AcceptanceList[0].Remarks
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            }








            <div class="row card-footer-bottom-fixed">

                @*<div class="view-details align-right col-md-12">
                    <a data-bs-toggle="tooltip" data-bs-original-title="View File" onclick="showDocument('@Model.Attachment.FileName', '@Model.Attachment.AbsoluteUri')" class="btn btn-small btn-secondary mobile-full-width">

                        <i class="icon-xl far fa-eye"></i>View File
                    </a>
                </div>*@



            </div>


        </div>
    </div>
</div>