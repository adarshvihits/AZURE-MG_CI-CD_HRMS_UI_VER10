                                                    </div>

                                                </div>
                                            </div>
                                        <div class="card-body">
                                            <!--begin: Search Form-->
                                            <div id="orgChart" class="card card-custom height-100per">

                                                
                                                    @(Html.Kendo().OrgChart<OrganizationalChart_List>()
                                                    .Name("orgCharts")
                                                   // .HtmlAttributes(new { style = "width:100%;height:100%;" })
                                                    .Template("<div class='custom'>" +
                                                    "<div><img src=' #: Avatar #'/></div>" +
                                                    "<span style='text-align: center;'><strong> #: Name # </strong></span>" +
                                                    "<div><i>  #: Title # </i></div>" +
                                                    "</div>")
                                                    .GroupHeaderTemplate("<strong>#: value # </strong>")
                                                    //.GroupField("Title")
                                                        .Editable(false)
                                                        //  .GroupField("ParentID")
                                                        //   .GroupHeaderTemplateId("groupHeaderTemplate")
                                                           
                                                           
                                                        .DataSource(dataSource => dataSource
                                                    .Read(read => read.Action("GetOrgChart", "OrganizationalChart"))
                                                        .Model(m =>
                                                        {
                                                            m.Id(f => f.ID);
                                                            m.ParentId(f => f.ParentID);
                                                            m.Name(f => f.Name);
                                                            m.Title(f => f.Title);
                                                            m.Avatar(f => f.Avatar);
                                                            m.Expanded(f => f.Expanded);
                                                        })
                                                        )
                                                        )
                                             
