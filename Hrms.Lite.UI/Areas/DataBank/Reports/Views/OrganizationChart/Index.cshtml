            function GetEmployee(sender) {

     

    var parameterValue = $(sender).val();

    // Get a reference to the OrgChart data source
    var orgChartDataSource = $("#orgCharts").data("kendoOrgChart").dataSource;

    // Set the transport configuration option of the data source to a function
    orgChartDataSource.transport.read = function (options) {
        // Modify the URL of the data source dynamically based on the parameter
            options.url = "/DataBank/OrganizationalChart/GetOrgChart?empCode=" + parameterValue;
        // Call the original read method of the transport
        kendo.data.RemoteTransport.prototype.read.call(this, options);
    };

    // Refresh the data of the data source by calling its read method
    orgChartDataSource.read();


  
}

