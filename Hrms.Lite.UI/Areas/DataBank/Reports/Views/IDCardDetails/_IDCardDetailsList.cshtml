@model Hrms.Lite.Shared.DataBank.Reports.IDCardDetails
<script src="~/js/settings.js"></script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table ID-Card-Details">

    @Html.HiddenFor(m => m.IDCardDetailsList.Count)
    <table class="common-table">
        <thead>
            <tr class="table-dark">

                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Blood Group</th>
                <th scope="col">Contact Number</th>
                <th scope="col">Emergency Contact Number</th>
                <th scope="col">Photo</th>

            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.IDCardDetailsList != null && Model.IDCardDetailsList.Count > 0)
            {

                for (int i = 0; i < Model.IDCardDetailsList.Count; i++)
                {

                    <tr>
                        <td data-label="Id">
                            @Model.IDCardDetailsList[i].ID
                        </td>
                        <td data-label="Employee name">
                            @Model.IDCardDetailsList[i].EmployeeName



                        </td>
                        <td data-label="Designation">
                            @Model.IDCardDetailsList[i].Designation
                        </td>
                        <td data-label="Blood Group">
                            @Model.IDCardDetailsList[i].BloodGroup.Name
                        </td>
                        <td data-label="Contact Number">
                            @Model.IDCardDetailsList[i].ContactNumber
                        </td>
                        <td data-label="Emergency Contact Number">
                            @Model.IDCardDetailsList[i].EmergencyContactNumber
                        </td>
                        <td data-label="Photo">
                            <button type="button" data-bs-toggle="tooltip" data-placement="top" class="btn" onclick="showDecompressedDocument('@Model.IDCardDetailsList[i].ID')"><i class="fa fa-download"></i></button>
                            @*<button class="btn"><i class="fa fa-download"></i> </button>*@
                        </td>
                    </tr>

                }
            }






        </tbody>
    </table>
</div>
