@model Hrms.Lite.Shared.DataBank.Reports.EmployeeInformationReport
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Account.Login CurrentUser = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Account.Login>(Context.Session.GetString("User"));
}
<script src="~/scripts/DataBank/Reports/growthHistory.js"></script>
<script>
    $(document).ready(function () {
          salVisible = @CurrentUser.authUser.SalaryVisibility;
       
    });
</script>
<script src="~/scripts/DataBank/Reports/employeeInformationReport.js"></script>
<script src="~/js/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        debugger;


        $('#EmploymentTypes')
            .multiselect('selectAll', false);
        $('#Designations')
            .multiselect('selectAll', false);
        $('#Departments')
            .multiselect('selectAll', false);
        $('#Locations')
            .multiselect('selectAll', false);
        $('#Categories')
            .multiselect('selectAll', false);
        $('#Grades')
            .multiselect('selectAll', false);
        $('#PayrollGroups')
            .multiselect('selectAll', false);
        $('#Divisions')
            .multiselect('selectAll', false);
        $('#Sections')
            .multiselect('selectAll', false);
        $('#Regions')
            .multiselect('selectAll', false);
        $('#WageGrades')
            .multiselect('selectAll', false);
        $('#GroupCompany')
            .multiselect('selectAll', false);
        $('#FunctionalStates')
            .multiselect('selectAll', false);
        $('#States')
            .multiselect('selectAll', false);
    });



</script>
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Employee Information Report
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Employee Information Report
                    </li>

                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--begin::Topbar-->
        <div class="topbar">

            <!--begin::User-->
           
            <!--end::User-->
        </div>
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->


<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body">
                            @using (Html.BeginForm("ExportToexcel", "EmployeeInformationReport", FormMethod.Post, new
                            {
                                @id = "employeeInformationSave" }))
                            {
                          
                                <div class="row tab-style-button">
                                    <div class="col-md-6">
                                        <div class="page_white">
                                            <div class="empstatus-new pr-2 pb-3">
                                                <h3>Employee Filter :</h3>
                                            </div>
                                          

                                            <div>

                                                <div class="row my-2">
                                                    <div class="col-md-5">
                                                      
                                                            <div class="form-group">
                                                                <label>Division</label>
                                                                @Html.ListBoxFor(m => m.Divisions, (SelectList)ViewBag.division,
                                                                new
                                                                {
                                                                    @class = "multiselectDropdownFields",
                                                                    @multiple = "multiple"
                                                                })
                                                            </div>
                                                    </div>
                                                    <div class="col-md-5">
                                                        <div class="form-group">
                                                            <label>Region</label>
                                                            @Html.DropDownListFor(Model => Model.Regions, (SelectList)ViewBag.Region, new
                                                         {
                                                        @class = "multiselectDropdownFields",
                                                        @multiple = "multiple"
                                                    })
                                                        </div>

                                                    </div>
                                                </div>
                                                <div class="row my-2">
                                                    <div class="col-md-5">
                                                        <div class="form-group">
                                                            <label>Location</label>
                                                            @Html.ListBoxFor(m => m.Locations, (SelectList)ViewBag.Loc,
                                                            new
                                                            {
                                                                @class = "multiselectDropdownFields",
                                                                @multiple = "multiple"
                                                            })
                                                        </div>
                                                    </div>
                                                    <div class="col-md-5">
                                                        <div class="form-group">
                                                            <label>Category</label>
                                                            @Html.ListBoxFor(m => m.Categories, (SelectList)ViewBag.Cat,
                                                            new
                                                            {
                                                                @class = "multiselectDropdownFields",
                                                                @multiple = "multiple"
                                                            })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row my-2">
                                                    <div class="col-md-5">
                                                        <div class="form-group">
                                                            <label>Designation</label>
                                                            @Html.ListBoxFor(m => m.Grades, (SelectList)ViewBag.Grd,
                                                            new
                                                            {
                                                                @class = "multiselectDropdownFields",
                                                                @multiple = "multiple"
                                                            })
                                                        </div>
                                                    </div>
                                                    <div class="col-md-5">
                                                        <div class="form-group">
                                                            <label>Wage Grade</label>
                                                            @Html.DropDownListFor(m => m.WageGrades, (SelectList)ViewBag.WageGrade, new
                                                            {
                                                            @class = "multiselectDropdownFields",
                                                            @multiple = "multiple"
                                                            })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row my-2">
                                                    <div class="col-md-5">
                                                        <div class="form-group">
                                                            <label>Department</label>
                                                            @Html.ListBoxFor(m => m.Departments, (SelectList)ViewBag.Dept,
                                                            new
                                                            {
                                                            @class = "multiselectDropdownFields",
                                                            @multiple = "multiple"
                                                            })
                                                        </div>
                                                    </div>
                                                    <div class="col-md-5">
                                                        <div class="form-group">
                                                            <label>Fun.Designation</label>
                                                            @Html.ListBoxFor(m => m.Designations, (SelectList)ViewBag.Dsg,
                                                            new
                                                            {
                                                            @class = "multiselectDropdownFields",
                                                            @multiple = "multiple"
                                                            })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row my-2">
                                                    <div class="col-md-5">
                                                    <div class="form-group">
                                                    <label>Section</label>
                                                    @Html.ListBoxFor(m => m.Sections, (SelectList)ViewBag.section,
                                                    new
                                                    {
                                                    @class = "multiselectDropdownFields",
                                                    @multiple = "multiple"
                                                    })
                                                    </div>
                                                    </div>
                                                    <div class="col-md-5">
                                                    <div class="form-group">
                                                    <label>Payroll Group</label>
                                                    @Html.ListBoxFor(m => m.PayrollGroups, (SelectList)ViewBag.PayrollGrp,
                                                    new
                                                    {
                                                    @class = "multiselectDropdownFields",
                                                    @multiple = "multiple"
                                                    })
                                                    </div>
                                                    </div>
                                                </div>
                                                <div class="row my-2">
                                                    <div class="col-md-5">
                                                        <div class="form-group">
                                                            <label>Fun.State</label>
                                                            @Html.DropDownListFor(Model => Model.FunctionalStates, (SelectList)ViewBag.FunState, new
                                                         {
                                                        @class = "multiselectDropdownFields",
                                                        @multiple = "multiple"
                                                    })

                                                        </div>
                                                    </div>
                                                    <div class="col-md-5">
                                                        <div class="form-group">
                                                            <label>State</label>
                                                            @Html.ListBoxFor(m => m.States, (SelectList)ViewBag.State,
                                                            new
                                                            {
                                                                @class = "multiselectDropdownFields",
                                                                @multiple = "multiple"
                                                            })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row my-2">
                                                    <div class="col-md-5">
                                                    <div class="form-group">
                                                    <label>Employment Type</label>
                                                    @Html.ListBoxFor(m => m.EmploymentTypes, (SelectList)ViewBag.EmploymentType,
                                                    new
                                                    {
                                                    @class = "multiselectDropdownFields",
                                                    @multiple = "multiple"
                                                    })
                                                    </div>
                                                    </div>
                                                    <div class="col-md-5">
                                                        <div class="form-group">
                                                            <label>Group Company</label>
                                                            @Html.DropDownListFor(m => m.GroupCompany, (SelectList)ViewBag.GroupCompany, new
                                                            {
                                                           @class = "multiselectDropdownFields",
                                                           @multiple = "multiple"
                                                       })
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-8">
                                                        <label style=" font-weight: 600; padding-right: 5px; padding-bottom: 4px;">Employee Status :</label>
                                                        <div class="d-flex ">

                                                            <div class="radio-inline">

                                                                <label class="radio radio-outline radio-success">
                                                                    @Html.RadioButtonFor(m => m.Tab, "1")
                                                                    <span></span>Active
                                                                </label>
                                                                <label class="radio radio-outline radio-success">

                                                                    @Html.RadioButtonFor(m => m.Tab, "2")
                                                                    <span></span>Resigned
                                                                </label>
                                                                <label class="radio radio-outline radio-success">

                                                                    @Html.RadioButtonFor(m => m.Tab, "3")
                                                                    <span></span>All
                                                                </label>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <!-- <end table></end> -->
                                            </div>
                                            <div class="row pt-23">
                                                <div class="col-md-12">
                                                    <button type="button"
                                                            class="btn btn-default float-right mobile-full-width " onclick="ExportToExcel()">
                                                        Export To Excel
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                       
                                    </div>
                                    <!-- <end col-6></end> -->
                                 
                                </div>
                            }
                        </div>

                    </div>
                </div>

                <!--
                <end col-12></end> -->



            </div>




            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>
<!--end::Content-->
