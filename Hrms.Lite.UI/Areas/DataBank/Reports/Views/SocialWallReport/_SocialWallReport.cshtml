@model Hrms.Lite.Shared.DataBank.Reports.SocialWallReport


<div class="ihits-table table-border hover-color odd-even mobile-responsive-table social_addswallreport_list vertical-scroll-500">

    @Html.HiddenFor(m => m.SocialWallReportList.Count)


    <table id="SocialwallTable">
        <thead>
            <tr class="table-dark">
                 <th scope="col">Content</th>
                 <th scope="col">Entry User</th>
                 <th scope="col">Entry Date</th>
                <th scope="col">Likes Count</th>
                <th scope="col">Comments Count</th>
               
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.SocialWallReportList != null && Model.SocialWallReportList.Count > 0)
                {
                    for (int i = 0; i < Model.SocialWallReportList.Count; i++)

                    {
                        <tr>

                            <td data-label="Name">
                                @Model.SocialWallReportList[i].Name
                            @Html.HiddenFor(model => Model.SocialWallReportList[i].SocialWallCode)
                            @Html.HiddenFor(model => Model.SocialWallReportList[i].Name)
                        </td>
                        <td data-label="EntryUser">
                            @Model.SocialWallReportList[i].EntryUser
                        </td>
                        <td data-label="EntryUser">
                            @Model.SocialWallReportList[i].EntryDate
                        </td>

                        <td data-label="Likes">
                            <a data-bs-toggle="modal" data-target=".LikesEmployeedetails" onclick="OnLikesClick(@Model.SocialWallReportList[i].SocialWallCode,@i)">
                                @Model.SocialWallReportList[i].Likes

                            </a>
                        </td>
                        <td data-label="Comments">
                            <a data-bs-toggle="modal" data-target=".CommentEmployeedetails" onclick="OnCommentsClick(@Model.SocialWallReportList[i].SocialWallCode,@i)">
                                @Model.SocialWallReportList[i].Comment
                            </a>
                        </td>

                        </tr>
                    }
                }
            }

        </tbody>





    </table>





</div>
