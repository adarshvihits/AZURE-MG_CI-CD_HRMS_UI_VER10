<div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->


            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Service Record</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })" class=""><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <!-- <li class="breadcrumb-item text-muted">
                            <a href="policies-circulars.html">Policies & Circulars List</a>
                        </li> -->
                        <li class="breadcrumb-item text-muted">
                            Service Record
                        </li>
                    </ul>
                </div>
            </div>
            <!--begin::Topbar-->
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->


    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->

                <div class="row height-100per">

                    <div class="col-md-12">
                        <div class="card card-custom height-100per">

                            <div class="card-body ">
                                <div class="row">

                                    <div class="col-md-5">


                                        <div class="row tab-style-button">
                                            <div class="tab-button-wrap">






                                                <div class="tab-items select-option ">

                                                    <div class="sraech-slider">
                                                        <div class="search-slider-inner">
                                                            <i class="fa fa-search"></i>
                                                        </div>
                                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                                               placeholder="ID/Name">
                                                    </div>

                                                    <div class="filter-button" data-bs-toggle="tooltip"
                                                         title="" data-bs-original-title="Filter">
                                                        <i class="fas fa-filter"></i>
                                                    </div>

                                                </div>

                                            </div>
                                        </div>

                                        <!--begin: Search Form-->


                                        <div class="ihits-table table-border   service-record ">
                                            <table class="common-table">
                                                <thead>
                                                    <tr class="table-dark">
                                                        <th scope="col">ID</th>
                                                        <th scope="col">Employee Name</th>

                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @Html.HiddenFor(m => Model.Url.Urllink)
                                                    @if (Model != null && Model.EmployeeList != null && Model.EmployeeList.Count > 0)
                                                    {

                                                        for (int i = 0; i < Model.EmployeeList.Count; i++)
                                                        {
                                                            <tr>
                                                                <td data-label="ID">@Model.EmployeeList[i].Employeeid</td>
                                                                @Html.HiddenFor(m => Model.EmployeeList[i].EmployeeCode)
                                                                <td data-label="Employee Name"><a onclick="GetServiceRecordPdf('@Model.EmployeeList[i].EmployeeCode', '@Model.Url.Urllink')">@Model.EmployeeList[i].EmployeeName</a></td>
                                                            </tr>


                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                        </div>

                                    </div>
                                    <div class="col-md-7">
                                        <div class="row tab-style-button">
                                            <div class="tab-button-wrap">






                                                @*<div class="tab-items select-option mb-1">

                                                    <button data-bs-toggle="tooltip" title="" class="btn btn-excel float-left btn-pdf" data-bs-original-title="Export to Pdf">
                                                        <i class="fa fa-file mb-0" aria-hidden="true"></i>
                                                    </button>

                                                </div>*@

                                            </div>
                                        </div>

                                        <!--begin: Search Form-->
                                        <div id="servivceRecord" class="pdf-img hide">

                                        </div>


                                    </div>
                                </div>






                            </div>

                        </div>
                    </div>
                </div>




                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->
    </div>
    <!--end::Content-->



</div>



@section scripts
    {
    <script src="/api/reports/resources/js/telerikReportViewer"></script>

    <script type="text/javascript">
        function onReady(e, args) {
            var kendoTouch = $(".trv-pages-area").data("kendoTouch");

            if (kendoTouch) {
                kendoTouch.unbind("doubletap");
            }
        }



        $(document).ready(function () {



            // code=parseInt(code);

            $("#servivceRecord").telerik_ReportViewer({
               
                    // The URL of the service which will serve reports.
                    // The URL corresponds to the name of the controller class (ReportsController).
                    // For more information on how to configure the service please check http://www.telerik.com/help/reporting/telerik-reporting-rest-conception.html.
                    serviceUrl: "/api/reports/",
                pageReady: onReady,
                    ready: function () {
                        $("[data-command*='telerik_ReportViewer_historyBack']").parent().hide();
                        $("[data-command*='telerik_ReportViewer_historyForward']").parent().hide();
                        $("[data-command*='telerik_ReportViewer_refresh']").parent().hide();
                        $("[data-command*='telerik_ReportViewer_stopRendering']").parent().hide();
                        $("[data-command*='telerik_ReportViewer_togglePrintPreview']").parent().hide();
                        $("[data-command*='telerik_ReportViewer_toggleSendEmailDialog']").parent().hide();
                        $("[data-command*='telerik_ReportViewer_toggleDocumentMap']").parent().hide();
                        $("[data-command*='telerik_ReportViewer_toggleParametersArea']").parent().hide();
                        $("[data-command*='telerik_ReportViewer_toggleZoomMode']").parent().hide();
                        $("[data-command*='telerik_ReportViewer_toggleSearchDialog']").parent().hide();
                        //$("[data-command*='telerik_ReportViewer_goToFirstPage']").parent().hide();
                        //$("[data-command*='telerik_ReportViewer_goToPrevPage']").parent().hide();
                    },
                    reportSource: {

                        // The report can be set to a report file name (.trdx or .trdp report definition)
                        // or CLR type name (report class definition).

                        report: "TestServiceRecord.trdp",

                        parameters: {


                            Url: "",
                        }


                    },

                    viewMode: telerikReportViewer.ViewModes.PRINT_PREVIEW,

                    scaleMode: telerikReportViewer.ScaleModes.SPECIFIC,


                    scale: 1.0,

                 
                    enableAccessibility: false,

                    ////If set to true shows the Send Mail Message toolbar button
                    sendEmail: { enabled: true }
            });







        });
    </script>
}
