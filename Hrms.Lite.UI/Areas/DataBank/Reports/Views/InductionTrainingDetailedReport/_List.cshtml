
@model Hrms.Lite.Shared.DataBank.DTO.InductionTraining

<script src="~/js/tooltip.js"></script>


<div class="ihits-table table-border hover-color odd-even mobile-responsive-table timesheet-report-table">
    @Html.HiddenFor(m => m.InductionReportList.Count)
    <table id="InductionTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col" data-bs-toggle="tooltip" title="Employee Accepted Date">E.A.Date</th>
                <th scope="col" data-bs-toggle="tooltip" title="Approval Date">App.Date</th>
                <th scope="col" data-bs-toggle="tooltip" title="Initiate Date">Ini.Date</th>
                <th scope="col" data-bs-toggle="tooltip" title="scheduled Date">Sch.Date</th>
                <th scope="col" data-bs-toggle="tooltip" title="Initiate By">Init.By</th>
                <th scope="col" data-bs-toggle="tooltip" title="Approval Status">appr.St</th>
                <th scope="col" data-bs-toggle="tooltip" title="Employee Accepted Status">EAS</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>
