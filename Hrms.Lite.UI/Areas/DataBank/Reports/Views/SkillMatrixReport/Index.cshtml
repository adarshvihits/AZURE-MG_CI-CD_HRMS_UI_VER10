@model Tuple<Hrms.Lite.Shared.DataBank.Reports.SkillMatrix, System.Data.DataTable,System.Data.DataTable,System.Data.DataTable>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@using Kendo.Mvc.UI
@using Hrms.Lite.Shared.DataBank.Reports;
<script src="~/js/jquery.min.js"></script>
<link href="https://kendo.cdn.telerik.com/2023.1.117/styles/kendo.bootstrap-main.min.css" rel="stylesheet" type="text/css" />
<script src="https://kendo.cdn.telerik.com/2023.1.117/js/kendo.all.min.js"></script>
<script src="https://kendo.cdn.telerik.com/2023.1.117/js/kendo.aspnetmvc.min.js"></script>
<script>
    function onDataBound(e) {
        var grid = this;
        if ($('#selectedSkillCodes').val() != '0') {
            var selectedSkillCodes = $('#selectedSkillCodes').val().split(',');
           

        grid.tbody.find('tr').each(function myfunction() {
            var row = $(this);
            var dataItem = grid.dataItem(row);

                for (var i = 0; i < selectedSkillCodes.length; i++) {
                    if (selectedSkillCodes[i] == dataItem.SkillCode) {
                        row.addClass("k-selected")
                        row.find("input").attr("aria-label", "Deselect row");
                        row.find("input").attr("aria-checked", true);
                        row.find(".k-checkbox").prop("checked", true);

                        break;
                    }
                }
                
                
        });
        }

       
    }

    function showDetails(e) {
       // var dataItem = this.dataItem($(e.currentTarget).closest("tr"));
        var wnd = $("#Skills").data("kendoWindow");
       // empID = dataItem.EmployeeID;
       // wnd.center().open();
        wnd.content("loading user info...").refresh({
            url: "@Url.Action("ChildGrid", "SkillMatrixReport")"
        }).center().open();

      

    }

    function saveSelectedSkills() {
        var grid = $("#skillGrid").data("kendoGrid");
        var selectedItems = grid.select(); // Get the selected rows
        var count=0;
        var skillCodes = [];
        selectedItems.each(function () {
            count++;
            var dataItem = grid.dataItem(this);
            skillCodes.push(dataItem.SkillCode);
        });
       
        // Save the selected skill codes to the hidden field
        if(count!=0)
        {
        $("#selectedSkillCodes").val(skillCodes.join(","));
        }
        else
        {
            $("#selectedSkillCodes").val("0");
        }
        $('#Type').val(1);
        GetList();

        var wnd = $("#Skills").data("kendoWindow");
        wnd.close();

    }
    function clearSelection() {
        var grid = $("#skillGrid").data("kendoGrid");

        grid.tbody.find('tr').each(function myfunction() {
            var row = $(this);
            var dataItem = grid.dataItem(row);
                    row.find(".k-checkbox").prop("checked", false);

        });

       // grid.clearSelection();
        $("#selectedSkillCodes").val("0");
    }

</script>

<style>
    .k-auto-scrollable table {
        width:100% !important;

    }
    .k-auto-scrollable  {
       overflow-x:hidden !important;
    }
</style>




@(
Html.Kendo().Window().Name("Skills")
                .Title("Skills")
                .LoadContentFrom("ChildGrid", "SkillMatrixReport")
                .Visible(false)
                .Modal(true)
                .Draggable(true)
                .Width(600)
                .Height(490)
)
