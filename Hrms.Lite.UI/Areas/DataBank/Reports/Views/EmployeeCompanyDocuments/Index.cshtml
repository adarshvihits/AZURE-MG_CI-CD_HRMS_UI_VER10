<script>
    $(document).ready(function () {
        debugger
       
        var docVal = $("#DocumentType_Code option:selected").text();
        docVal= docVal.trim().toUpperCase();
        var Type = docVal.includes("EXPERIENCE") ? 'RESIGNED' : 'ACTIVE';
        if (Type == 'ACTIVE') {
            $('input[id="Type"][value="ACTIVE"]').prop('checked', true);
        }
        else {
            $('input[id="Type"][value="RESIGNED"]').prop('checked', true);
        }
        fillData();
        $("#DocumentType_Code").change(function () {
            var docVal = $("#DocumentType_Code option:selected").text().trim().toUpperCase();
            var Type = docVal.includes("EXPERIENCE") ? 'RESIGNED' : 'ACTIVE';

            // Ensure the radio button reflects the correct Type after the document type is changed
            if (Type == 'ACTIVE') {
                $('input[id="Type"][value="ACTIVE"]').prop('checked', true);
            } else {
                $('input[id="Type"][value="RESIGNED"]').prop('checked', true);
            }

            // Optionally call the fillData() function again if needed after the type changes
            fillData();
        });
    });
</script>
