@model Hrms.Lite.Shared.DataBank.Reports.JoiningReport
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Account.Login CurrentUser = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Account.Login>(Context.Session.GetString("User"));
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/DataBank/Reports/JoiningReport.js?v=1"></script>
@{
        ViewData["Title"] = "Index";
        Layout = "~/Views/Shared/_Layout.cshtml";
}


<script>
    $(document).ready(function () {
       salVisible = @CurrentUser.authUser.SalaryVisibility;
        fillData();
    });
</script>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Joining Report</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>


                    <li class="breadcrumb-item">
                        Joining Report
                    </li>

                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per">

                <div class="card-body">
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap align-items-center">

                            <div class="tab-items">

                                <div class="row-outer pb-2">
                                    <label>From</label>
                                    @*<span class="Mandatroy">*</span>*@
                                    <div class="input-group date">
                                        @Html.TextBoxFor(Model => Model.From, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "From", onchange = "ValidateDate();fillData();validate(this,'fromdate')" })
                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <span id="fromdate"></span>
                                </div>
                            </div>
                            <div class="tab-items pl-3">

                                <div class="row-outer pb-2">
                                    <label>To</label>
                                    @*<span class="Mandatroy">*</span>*@
                                    <div class="input-group date">
                                        @Html.TextBoxFor(Model => Model.To, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "To", onchange = "ValidateDate();fillData();validate(this,'todate')" })

                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <span id="todate"></span>
                                </div>
                            </div>



                            <div class="tab-items select-option">
                                <div class="button-group float-left mr-15">
                                    <button data-bs-toggle="modal" data-target=".bd-example-modal-lg"
                                            type="button" class="btn btn-default btn-sm float-left" onclick="OnGroupSummaryClick()">
                                        Group Summary
                                    </button>



                                    <div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog"
                                         aria-labelledby="myLargeModalLabel" aria-hidden="true" style="display: none;">
                                        <div class="modal-dialog modal-lg">
                                            <div id="myDiv" class="modal-content popup">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="exampleModalLabel"> Group Summary</h5>
                                                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                                        <i aria-hidden="true" class="ki ki-close"></i>
                                                    </button>
                                                </div>
                                                <div class="modal-body">

                                                </div>
                                            </div>
                                        </div>
                                    </div>



                                </div>



                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left" data-bs-original-title="Export to Excel">
                                    <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                </a>



                                @*<div class="filter-button" data-bs-toggle="tooltip" title="" data-bs-original-title="Filter">
                                        <i class="fas fa-filter"></i>
                                    </div>*@

                            </div>


                        </div>
                    </div>

                    <div id="joiningReportList">
                        @await Html.PartialAsync("~/Areas/DataBank/Reports/Views/JoiningReport/_JoiningReportList.cshtml")
                    </div>

                    <div id="groupSummary">

                    </div>

                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.SliderFilter)
                    </div>

                    <!-- Table Section -->
                    <!-- Table Setion End -->
                    <!--end: Datatable-->
                </div>
            </div>

        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>


