@model Hrms.Lite.Shared.DataBank.Reports.JoiningReport

<script src="~/scripts/DataBank/Reports/JoiningReport.js"></script>
<script src="~/js/tooltip.js"></script>


<div style="padding:10px;" 
class="ihits-table table-border hover-color odd-even mobile-responsive-table emp_profile-list-table vertical-scroll-250">

    <div class="row">
        <div class="col-md-4">
            <div class="form-group">
                <label>Group By</label>



                @Html.DropDownListFor(m => Model.GroupByFill.Code, (SelectList)ViewBag.groupBy, new { @class = "form-control form-control-sm", @onchange = "groupbyChange(this)" })


            </div>
        </div>

        <div class="col-md-8 d-flex justify-content-end">

            <button data-bs-toggle="tooltip" title="" class="btn btn-excel" data-bs-original-title="Export to Excel" onclick="GroupSummaryExportToExcel()">
                <i class="icon-xl far fa-file-excel"></i>
            </button>
        </div>

    </div>

    <br>
    <div id="listsummary">
        @await Html.PartialAsync("~/Areas/DataBank/Reports/Views/JoiningReport/_SummaryList.cshtml", Model)
    </div>

</div>

