@model Hrms.Lite.Shared.TimeOffice.Report.DailyPerformance

<script src="~/js/tooltip.js"></script>
<script>
    $(document).ready(function () {
        fillData();

    });
</script>

<div class="ihits-table table-border odd-even  mobile-responsive-table">
    @Html.HiddenFor(m => m.DailyPerformanceList.Count)
    <table id="DailyPerformanceTable">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Department </th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Location</th>
                <th scope="col">Division</th>
                <th scope="col">First In P</th>
                <th scope="col">Last Out P</th>
                <th scope="col">Total In Time</th>
                <th scope="col">Total Out Time</th>
                <th scope="col">Total Time</th>
                <th scope="col">Punch</th>
                @*<th scope="col"></th>*@
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>