@model Hrms.Lite.Shared.TimeOffice.Report.DailyPerformance

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>

<script src="~/scripts/TimeOffice/Report/DailyPerformance.js"></script>

<div id="kt_header" class="header header-fixed">
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Daily Performance</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "DashBoard", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Daily Performance
                    </li>

                </ul>
            </div>
        </div>
    </div>
</div>



<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items">
                                <div class=" select-option ">
                                    <label>Date</label>
                                    <div class="input-group date" style="width: 145px;">

                                        @Html.TextBoxFor(m => m.Date, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @placeholder = "Date", @onchange = "fillData()" })
                                        <span id="confirmdate"></span>
                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>


                                </div>
                            </div>
                            <div class="tab-items">
                                <label>No Of Punch</label>
                                <div class="form-group filter-combobox mt-0">

                                    @Html.DropDownListFor(model => model.NoOfPunchCode,
                                             new List<SelectListItem> {
                                            new SelectListItem {  Value= "" , Text = "ALL"},
                                            new SelectListItem {  Value= "1" , Text = "Non-Punching" },
                                            new SelectListItem { Value = "2" , Text = "1 punch" },
                                            new SelectListItem { Value = "3" , Text = "2 punch" },
                                            new SelectListItem { Value = "4" , Text = "3 punch" },
                                            new SelectListItem { Value = "5" , Text = "4 punch" },
                                            new SelectListItem { Value = "6" , Text = "more than 4 punch" },
                                            new SelectListItem { Value = "7" , Text = "Employees On Leave "}
                                              },
                                            new { @class = "form-control form-control-sm", @onchange = "fillData()" })

                                </div>
                            </div>

                            <div class="tab-items select-option">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div class="filter-button slider-btn" id="filterForm" data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>

                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                   data-bs-original-title="Export to Excel">
                                    <i class="icon-xl far fa-file-excel" onclick="ExportToexcel()"></i>
                                </a>
                            </div>



                        </div>
                    </div>

                    <div id="listID">
                        @await Html.PartialAsync("~/Areas/TimeOffice/Report/Views/DailyPerformance/_List.cshtml", Model)
                    </div>

                    @*<div class="row card-footer-bottom-fixed">


                            <div class="col-md-12">
                                <a type="button" class="btn btn-default float-right mobile-full-width" onclick="OnConfirmClick()">
                                    Confirm
                                </a>

                            </div>


                        </div>*@


                </div>
            </div>
        </div>
    </div>


</div>


<div id="filterSlider">
    @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
</div>
<!--end::Content-->
<div class="modal fade bd-example-modal-lg" id="DetailsPOPUP" tabindex="-1" aria-labelledby="myLargeModalLabel" style="display: none;" aria-hidden="true">
    <div class="modal-dialog modal-lg" style="max-width:1000px;">
        <div class="modal-content popup">
            <div class="modal-header" style=" justify-content: end; padding: 8px;">
                @*\*<h5 class="modal-title" id="exampleModalLabel">Daily Performance</h5>*\*@
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body">

            </div>


        </div>
    </div>
</div>

