@model Hrms.Lite.Shared.TimeOffice.Report.ReaderLogReport
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/TimeOffice/Report/MobilePunchingLogReport.js"></script>


<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Mobile Punching Log Report</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Mobile Punching Log Report
                    </li>

                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                    <!--begin: Search Form-->

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap align-items-center">



                            <div class="tab-items">

                                <div class="row-outer pb-2 " style="width:150px">
                                    <label>From</label>
                                    <div class="input-group date">
                                        @Html.TextBoxFor(Model => Model.From, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "From", @onchange = "fillData()" })
                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-items">

                                <div class="row-outer pb-2" style="width:150px">
                                    <label>To</label>
                                    <div class="input-group date">
                                        @Html.TextBoxFor(Model => Model.To, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "To", @onchange = "fillData()" })
                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="tab-items">
                                <label>Classification</label>
                                <div class="form-group filter-combobox mt-0">
                                    @Html.DropDownListFor(model => model.Classification,
                                                                        new List<SelectListItem> {
                                                                             new SelectListItem {  Value= "0" , Text = "All" },
                                                                             new SelectListItem { Value = "1" , Text = "In" },
                                                                             new SelectListItem { Value = "2" , Text = "Out" }

                                                                          },
                                                                        new { @class = "form-control form-control-sm", @onchange = "fillData()" })                                    <span id="classification"></span>
                                </div>
                            </div>



                            <div class="tab-items select-option high">



                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left" onclick="ExportToExcel()"
                                   data-bs-original-title="Export to Excel">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>
                            </div>


                        </div>
                    </div>
                    <div id="ReaderLogListPartial">
                        @await Html.PartialAsync("/Areas/TimeOffice/Report/Views/MobilePunchingLogReport/_List.cshtml")

                    </div>
                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.filter)
                    </div>


                    <!--end: Datatable-->
                    <div class="row card-footer-bottom-fixed border-none">

                        <div class="col-md-12 align-left">
                            <!-- <a type="button"
                                class="btn btn-default  mobile-full-width">
                                Save
                            </a> -->

                        </div>

                    </div>
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
<div class="slider-over-flow"></div>
<!--end::Content-->