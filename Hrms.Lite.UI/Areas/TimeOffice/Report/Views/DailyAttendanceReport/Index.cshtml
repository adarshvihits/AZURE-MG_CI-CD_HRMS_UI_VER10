@model Hrms.Lite.Shared.TimeOffice.DailyAttendanceEntry

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>

<script src="~/scripts/TimeOffice/Report/DailyAttendanceReport.js"></script>


<script>
    $(document).ready(function () {
        debugger;


        $('#Attendancestatus')
            .multiselect('selectAll', false);
    });



</script>

<style>
    .multiselect-filter {
        position: sticky;
        top: 0;
        z-index: 10;
        background-color: white;
    }

        .multiselect-filter .input-group {
            padding: 5px;
            margin: 0px;
            border-radius: 2px;
        }

    .multiselect-search {
        border-radius: 5px !important;
        height: 26px;
    }
</style>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Daily Attendance Report</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Daily Attendance Report
                    </li>

                </ul>
            </div>
        </div>

        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">

                            <div class="tab-items">

                                <div class="row-outer pb-2">
                                    <label>From</label>
                                    @*<span class="Mandatroy">*</span>*@
                                    <div class="input-group date">
                                        @Html.TextBoxFor(Model => Model.From, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "From", @onchange = "fillData()" })
                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <span id="fromdate"></span>
                                </div>

                            </div>
                            <div class="tab-items">


                                <label>To</label>
                                @*<span class="Mandatroy">*</span>*@
                                <div class="input-group date">
                                    @Html.TextBoxFor(Model => Model.To, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "To", @onchange = "fillData()" })
                                    <div class="input-group-append">
                                        <span class="input-group-text">
                                            <i class="la la-calendar"></i>
                                        </span>
                                    </div>
                                </div>
                                <span id="fromdate"></span>


                            </div>
                            <div class="tab-items">
                                <label></label>
                                <div class="form-group filter-combobox mt-0" style="width:200px;">

                                    @*@Html.DropDownListFor(Model => Model.Attendancestatus, (SelectList)ViewBag.AttnStatus, "All", new { @class = "form-control form-control-sm status", @style = "width:200px;", @onchange = "fillData()" })*@


                                    @Html.ListBoxFor(Model => Model.Attendancestatus, (SelectList)ViewBag.AttnStatus, new
                               {
                                   @class = "multiselectDropdownFields form-control-multiselect form-control-sm",
                                   @multiple = "multiple",
                                   onchange = "fillData()",
                                   data_db_filter = "true",


                               })

                                    <span id="status"></span>

                                </div>
                            </div>
                            <div class="tab-items">
                                <label></label>
                                <div class="form-group filter-combobox mt-0">

                                    @Html.DropDownListFor(Model => Model.AttendanceType, (SelectList)ViewBag.AttnStatusReport, new { @class = "form-control form-control-sm type", @style = "width:200px;", @onchange = "fillData()" })
                                    <span id="type"></span>

                                </div>
                            </div>










                            <div class="tab-items select-option">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div class="filter-button slider-btn" id="filterForm" data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>

                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                   data-bs-original-title="Export to Excel">
                                    <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                </a>
                            </div>



                        </div>
                    </div>

                    <div id="listID">
                        @await Html.PartialAsync("~/Areas/TimeOffice/Report/Views/DailyAttendanceReport/_List.cshtml", Model)
                    </div>









                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>

<div id="filterSlider">
    @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
</div>
<!--end::Content-->
