@model Hrms.Lite.Shared.TimeOffice.Report.LessHourReport

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/TimeOffice/Report/lessHourReport.js"></script>
<style>
</style>
<script>
    $(document).ready(function () {
        fillData();
    });
</script>

<div id="kt_header" class="header header-fixed">
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Less Hour Report</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>
                    <li class="breadcrumb-item">
                        Less Hour Report
                    </li>

                </ul>
            </div>
        </div>
    </div>
</div>

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <div class="d-flex flex-column-fluid">
        <div class="container full-width">
            <div class="card card-custom height-100per">
                <div class="card-body">

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap align-items-center">
                            <div class="tab-items">

                                <div class="row-outer pb-2">
                                    <label>From</label>
                                    <div class="input-group date">
                                        @Html.TextBoxFor(Model => Model.FromDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "From", onchange = "ValidateDate();fillData();validate(this,'Fromdate')" })
                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <span id="Fromdate"></span>
                                </div>
                            </div>
                            <div class="tab-items pl-3">

                                <div class="row-outer pb-2">
                                    <label>To</label>
                                    <div class="input-group date">
                                        @Html.TextBoxFor(Model => Model.ToDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "To", onchange = "ValidateDate();fillData();validate(this,'Todate')" })

                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <span id="Todate"></span>
                                </div>
                            </div>

                            <div class="tab-items select-option">
                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left" data-bs-original-title="Export to Excel">
                                    <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                </a>
                            </div>


                        </div>
                    </div>


                    <div id="lessHourReportList">
                        @await Html.PartialAsync("~/Areas/TimeOffice/Report/Views/LessHourReport/_LessHourReportlist.cshtml")
                    </div>


                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
                    </div>

                </div>
            </div>

        </div>

    </div>

</div>