@model Hrms.Lite.Shared.TimeOffice.Report.LessHourReport

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table lesshourreport_list_lists">

    @Html.HiddenFor(m => m.LessHourReportList.Count)
    <table id="LessHourReportListTable">
        <thead>
            <tr class="table-dark">

                <th data-bs-toggle="tooltip" title="Employee ID" scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th data-bs-toggle="tooltip" title="Punch Date" scope="col">Date</th>
                <th data-bs-toggle="tooltip" title="Attendance Status" scope="col">Status</th>
                <th data-bs-toggle="tooltip" title="Shift Time" scope="col">Shift</th>
                <th scope="col">IN</th>
                <th scope="col">OUT</th>
                <th data-bs-toggle="tooltip" title="Total Time" scope="col">Tot Time</th>
                <th data-bs-toggle="tooltip" title="Total Time In Shift" scope="col">Time SH</th>
                <th scope="col">Early In</th>
                <th scope="col">Late In</th>
                <th scope="col">Early Out</th>
                <th scope="col">Late Out</th>
                <th data-bs-toggle="tooltip" title="Total Less Hours(Late In + Early Out)" scope="col">Tot.Les Hr</th>
            </tr>
        </thead>

        <tbody>
        </tbody>

    </table>
</div>

