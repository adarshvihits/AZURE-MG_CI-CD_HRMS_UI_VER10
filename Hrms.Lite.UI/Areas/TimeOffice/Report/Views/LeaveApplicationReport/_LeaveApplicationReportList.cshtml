@model Hrms.Lite.Shared.TimeOffice.Report.LeaveApplicationReport



    <div class="ihits-table table-border odd-even mobile-responsive-table leaveapplication-report-table">
        @Html.HiddenFor(m => m.LeaveApplicationReportList.Count)
        <table class="common-table" id="LeaveApplicationTable">
            <thead>
                <tr class="table-dark">
                    <th scope="col">ID</th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">Applied On</th>
                    <th scope="col">Type</th>
                    <th scope="col">From</th>
                    <th scope="col">To</th>
                    <th scope="col">Leave On</th>
                    <th scope="col">Entitle Date</th>
                    <th scope="col">No.Of Days</th>
                    <th scope="col">Reason</th>
                    <th scope="col">Current Status</th>
                    <th scope="col">Approved By</th>
                    <th scope="col">Approver Fun.Designation</th>
                    <th scope="col">Approved Date</th>
                    <th scope="col">Entry From</th>
                    <th scope="col">Remarks</th>
                    <th scope="col">Tracker</th>

                </tr>
            </thead>
          
        </table>
    </div>
