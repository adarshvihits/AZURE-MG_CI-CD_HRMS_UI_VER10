@model Hrms.Lite.Shared.TimeOffice.Report.PunchingRegularizationReport

<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>
<script src="~/scripts/TimeOffice/Report/PunchingRegularizationReport.js"></script>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



