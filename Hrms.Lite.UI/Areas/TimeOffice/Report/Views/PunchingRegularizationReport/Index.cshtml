    $(document).ready(function () {
        debugger;
        $('.AllCount').html("@Model.TotalCount");
        $('.RejectedCount').html("@Model.RejectedCount");
        $('.ApprovedCount').html("@Model.ApproveCount");
        $('.PendingCount').html("@Model.PendingCount");
    });
</script>*@





<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Punching Regularization Report</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Punching Regularization Report
                    </li>



                    @*<li class="breadcrumb-item text-muted">*@

                    @*<a href="@Url.Action("Index", "_List")"> Punching Regularization</a>*@
                    <!--</li>-->
                    <li class="breadcrumb-item text-muted child-mute">

                    </li>

                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">

                            <div class="tab-items ">
                                @*<span class="btn-title">
                    Pending
                    <span class="btn-notification">10</span>
                </span>*@
                                <span class="btn-title active PendingTab" onclick="tabClick('PendingTab', 'PENDING')">
                                    Pending
                                    <span class="btn-notification PendingCount">@*@Model.PendingCount*@</span>
                                </span>
                            </div>
                            <div class="tab-items high">
                                @*<span class="btn-title active">
                    Approved
                    <span class="btn-notification">07</span>
                </span>*@
                                <span class="btn-title  ApprovedTab" onclick="tabClick('ApprovedTab', 'APPROVED')">
                                    Approved
                                    <span class="btn-notification ApprovedCount">@*@Model.ApproveCount*@</span>
                                </span>
                            </div>
                            <div class="tab-items high">
                                @*<span class="btn-title">
                    Rejected
                    <span class="btn-notification">4</span>
                </span>*@
                                <span class="btn-title RejectedTab" onclick="tabClick('RejectedTab', 'REJECTED')">
                                    Rejected
                                    <span class="btn-notification RejectedCount" id="rej">@*@Model.RejectedCount*@</span>
                                </span>
                            </div>
                            <div class="tab-items medium">
                                @*<span class="btn-title">
                    All
                    <span class="btn-notification">21</span>
                </span>*@
                                <span class="btn-title AllTab" onclick="tabClick('AllTab', 'ALL')">
                                    All
                                    <span class="btn-notification AllCount">@*@Model.TotalCount*@</span>
                                </span>
                            </div>


                            <div class="tab-items select-option">


                                <div class="form-group filter-combobox" style="width: 120px; margin-right: 10px;">


                                    @Html.DropDownListFor(m => m.LeavePeriod.Code, (SelectList)ViewBag.LeavePeriod, "--select Leave Period--", new { @class = "form-control form-control-sm", @onchange = "onLeavePeriodChange(this,'levPeriod');fillData()" })
                                    <span id="levPeriod"></span>
                                </div>
                                <div class="form-group filter-combobox" style="width: 120px; margin-right: 10px;">


                                    @Html.DropDownListFor(m => m.Month.Code, (SelectList)ViewBag.Month, "--select Month--", new { @class = "form-control form-control-sm", @onchange = "fillData()" })
                                    <span id="month"></span>
                                </div>
                                <div class="form-group filter-combobox" style="width: 220px; margin-right: 10px;">

                                    @*@Html.DropDownListFor(m => m.LeaveType.Code, (SelectList)ViewBag.WFHLeaveType, "Work From Home", new { @class = "form-control form-control-sm", @onchange = "onFilterDropdownChange(this)" })*@
                                    @*@Html.DropDownListFor(m => m.LeaveType.Code, (SelectList)ViewBag.Reason, "Work From Home", new { @class = "form-control form-control-sm", @onchange = "onFilterDropdownChange(this)" })*@
                                    @Html.DropDownListFor(m => m.Reason, (SelectList)ViewBag.reason, "ALL", new { @class = "form-control form-control-sm", @onchange = "fillData()" })

                                </div>












                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="Search Here">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>

                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                   data-bs-original-title="Export to Excel">
                                    <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                </a>
                                @*<a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left" data-bs-original-title="Export to Excel" onclick="onExportToExcelClick()">
            <i class="icon-xl far fa-file-excel"></i>
        </a>*@
                            </div>




                        </div>
                        <div id="List">
                            @await Html.PartialAsync("~/Areas/TimeOffice/Report/Views/PunchingRegularizationReport/_RegularizationList.cshtml")

                        </div>
                        <div id="filterSlider">
                            @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
                        </div>




                    </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>
    <!--end::Content-->
    @*}*@
