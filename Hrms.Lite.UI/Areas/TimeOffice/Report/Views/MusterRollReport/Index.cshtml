@model Tuple<Hrms.Lite.Shared.TimeOffice.Report.MusterRollReport, System.Data.DataTable>



@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/scripts/TimeOffice/Report/MusterRollReport.js"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>


<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Muster Roll</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Muster Roll
                    </li>
                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
        <div class="topbar">


        </div>
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                    <!--begin: Search Form-->

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap ">

                            <div class="tab-items ">


                                <div class="form-group d-flex align-items-center">
                                    <label>Month </label>
                                    <div class="form-group filter-combobox ml-3" style="width: 150px;">
                                        @Html.DropDownListFor(m => m.Item1.Month, (SelectList)ViewBag.Month, new { @class = "form-control form-control-sm", @onchange = "GetList()" })
                                    </div>

                                </div>
                            </div>



                            <div class="tab-items select-option pt-5">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm" placeholder="ID/Name">
                                </div>



                                <div id="filterForm" class="filter-button slider-btn" data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                   data-bs-original-title="Export to Excel">
                                    <i class="icon-xl far fa-file-excel"onclick="ExportToExcel()"></i>
                                </a>
                            </div>


                        </div>
                    </div>
                    <div id="MusterRollList">
                        @await Html.PartialAsync("~/Areas/TimeOffice/Report/Views/MusterRollReport/_MusterRollReportList.cshtml", Model)

                    </div>
                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Item1.filter)
                    </div>

                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>