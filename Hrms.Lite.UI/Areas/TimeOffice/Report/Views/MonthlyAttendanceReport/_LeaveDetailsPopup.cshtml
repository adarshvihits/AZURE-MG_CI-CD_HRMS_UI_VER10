@model Hrms.Lite.Shared.TimeOffice.DailyAttendanceEntry
<div class="row">
    <div class="col-md-6">
        @Html.HiddenFor(m => m.DailyAttendanceEditDetails.FullName)
        <div class="right-card">
            <div class=" card-custom mb-5">
                <div class="card-body">
                    <h5>Leave Balance</h5>
                    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table">
                        <table>
                            <thead>
                                <tr class="table-light">
                                    <th scope="col">Leave</th>
                                    <th scope="col">Balance</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.LeaveBalance != null && Model.LeaveBalance.Count > 0)
                                {
                                    for (int i = 0; i < Model.LeaveBalance.Count; i++)
                                    {
                                        <tr>
                                            <td data-label="Leave">@Model.LeaveBalance[i].Leave</td>
                                            <td data-label="Balance">@Model.LeaveBalance[i].Balance</td>
                                        </tr>
                                    }
                                }
                                else
                                {

                                    <tr>
                                        <td colspan="2">No data</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                    </div>
                    <!--end: Datatable-->
                </div>
            </div>
        </div>

    </div>
    <div class="col-md-6">

        <div class="right-card">
            <div class=" card-custom mb-5">
                <div class="card-body">
                    <h5>Coff Details</h5>

                    <!-- Table Setion End -->
                    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table">
                        <table>
                            <thead>
                                <tr class="table-light">
                                    <th scope="col">E.Date</th>
                                    <th scope="col">Expire On</th>
                                </tr>
                            </thead>
                            <tbody>

                                @if (Model.CoffDetails != null && Model.CoffDetails.Count > 0)
                                {
                                    for (int i = 0; i < Model.CoffDetails.Count; i++)
                                    {
                                        <tr>
                                            <td data-label="E.Date">@Model.CoffDetails[i].EDate.ToString("dd-MMM-yyyy")</td>
                                            <td data-label="Expire On">@Model.CoffDetails[i].ExpireOn.ToString("dd-MMM-yyyy")</td>
                                        </tr>
                                    }
                                }
                                else
                                {

                                    <tr>
                                        <td colspan="2">No data</td>
                                    </tr>
                                }




                            </tbody>
                        </table>

                    </div>
                    <!--end: Datatable-->
                </div>
            </div>
        </div>
    </div>
</div>