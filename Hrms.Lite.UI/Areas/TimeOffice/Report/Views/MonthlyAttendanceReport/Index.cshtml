@model Hrms.Lite.Shared.TimeOffice.DailyAttendanceEntryPaging
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>
    <script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>




@*<script src="https://cdn.datatables.net/1.10.10/js/dataTables.bootstrap.min.js" type="text/javascript"></script>*@

<script src="~/scripts/TimeOffice/Report/MonthlyAttendanceReport.js"></script>
@*<script src="~/scripts/TimeOffice/Test.js"></script>*@


@*<script>
        $(document).ready(function () {
            debugger;
            fillData();
        });
    </script>*@




<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Monthly Attendance Report</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class=""><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Monthly Attendance Report
                    </li>

                </ul>
            </div>
        </div>
        <div class="topbar">

            <!--begin::User-->
            <!--end::User-->
        </div>
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                    @*<div class="mobile-tab-section">
                            <div class="row mb-2">
                                <div class="col-6">
                                    <div class="form-group">
                                        <label>Select Type</label>

                                        <select class="form-control form-control-sm "
                                                id="TabCode"
                                                onchange="TabsDropdown($('#TabCode').val())">
                                            <option value="0">All</option>
                                            <option value="1">Absenteeism</option>
                                            <option value="2">Leave</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-6" id="assetFilter">
                                    <div class="form-group">
                                        <label>Select Month</label>
                                        @Html.DropDownListFor(m => Model.Month.Code, (SelectList)ViewBag.Month, "--Select Month--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'dailyMonth')" })
                                    </div>
                                </div>

                                <div class="col-6" id="assetFilter">

                                    <div class="form-group">
                                        <label>Select Payroll Group</label>
                                        @Html.DropDownListFor(m => Model.PayrollGroup.Code, (SelectList)ViewBag.PayRollGroup, "PayrollGroup", new { @class = "form-control form-control-sm", @onchange = "validate(this,'dailyPayRoll')" })
                                    </div>
                                </div>
                            </div>
                        </div>*@
                    <!--begin: Search Form-->
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">


                            <div class="tab-items">
                                <a class="btn-title all active" onclick="onTabClick('all',0)">
                                    All
                                    <span class="btn-notification AllCount">@Model.AllCount</span>
                                </a>
                            </div>
                            <div class="tab-items medium">
                                <a class="btn-title Absenteeism" onclick="onTabClick('Absenteeism',1)">
                                    Absenteeism
                                    <span class="btn-notification AbsenteesamCount">@Model.AbsenteesamCount</span>
                                </a>
                            </div>
                            <div class="tab-items high">
                                <a class="btn-title Leave" onclick="onTabClick('Leave',2)">
                                    Leave
                                    <span class="btn-notification LeaveCount">@Model.LeaveCount</span>
                                </a>
                            </div>


                            <div class="tab-items pr-0 border-none">

                                <div class="form-group filter-combobox" style="width: 200px;">

                                    @Html.DropDownListFor(m => Model.PayrollGroup.Code, (SelectList)ViewBag.PayRollGroup, "--Select PayrollGroup--", new { @class = "form-control form-control-sm filterDropDownPG", @onchange = "fillData()" })
                                    <span id="dailyPayRoll"></span>
                                </div>

                            </div>


                            <div class="tab-items ml-10 pr-0 border-none">


                                <div class="form-group filter-combobox mr-2" style="width: 150px;">
                                    @Html.DropDownListFor(m => Model.Month.Code, (SelectList)ViewBag.Month, "--Select Month--", new { @class = "form-control form-control-sm filterDropDownMonth", @onchange = "fillData()" })
                                    <span id="dailyMonth"></span>
                                </div>


                            </div>


                            @if (Model.TabIndex == 1)
                            {

                                <div class="tab-items border-none AbsentismPerceantageDiv">
                                    <div class="profile-completion-percentage medium mt-1 border-0 after-none">
                                        Absenteeism Percentage - <span>@Model.Percentage</span>
                                        <div class="progress-bar">

                                            <div class="medium"><span class="progress-value">@Model.Percentage</span></div>

                                        </div>
                                    </div>
                                </div>
                            }


                            else if (Model.TabIndex == 2)
                            {

                                <div class="tab-items border-none  LeavePercentageDiv">
                                    <div class="profile-completion-percentage medium mt-1 border-0 after-none">
                                        Leave Percentage - <span>@Model.Percentage</span>
                                        <div class="progress-bar">

                                            <div class="medium"><span class="progress-value">@Model.Percentage</span></div>

                                        </div>
                                    </div>
                                </div>
                            }

                            else
                            { <div class="tab-items border-none AbsentismPerceantageDiv hide">
                                    <div class="profile-completion-percentage medium mt-1 border-0 after-none">
                                        Absenteeism Percentage - <span>@Model.Percentage</span>
                                        <div class="progress-bar">

                                            <div class="medium"><span class="progress-value">@Model.Percentage</span></div>

                                        </div>
                                    </div>
                                </div>

                                <div class="tab-items border-none  LeavePercentageDiv hide">
                                    <div class="profile-completion-percentage medium mt-1 border-0 after-none">
                                        Leave Percentage - <span>@Model.Percentage</span>
                                        <div class="progress-bar">

                                            <div class="medium"><span class="progress-value">@Model.Percentage</span></div>

                                        </div>
                                    </div>
                                </div>

                            }


                        <div class="tab-items select-option">

                            <div class="sraech-slider">
                                <div class="search-slider-inner">
                                    <i class="fa fa-search"></i>
                                </div>
                                <input type="text" id="dataTableSearch" class="form-control form-control-sm" placeholder="ID/Name">
                            </div>

                            <div id="filterForm" class="filter-button  btn1" data-bs-toggle="tooltip" title="Filter" onclick="onFilterClick('outerList')">
                                <i class="fas fa-filter"></i>
                                <i class="fas fa-check"></i>
                            </div>
                       
                            <a data-bs-toggle="tooltip" title="Export to Excel"
                               class="btn btn-excel" onclick="exportToexcel_DailyAttendanceEntry()">
                                <i class="icon-xl far fa-file-excel"></i>
                            </a>
                        </div>


                        </div>
                    </div>
                    <div class="AttendanceEntryList">

                        @await Html.PartialAsync("~/Areas/TimeOffice/Report/Views/MonthlyAttendanceReport/_DailyAttendanceEntryList.cshtml")

                        @*@await Html.PartialAsync("_Test", Model)*@


                    </div>

                    <div id="DailyEntryFilter">

                    </div>

                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
<!--end::Content-->
