
@model Hrms.Lite.Shared.TimeOffice.Report.LivePunchReport

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="~/js/jquery.min.js"></script>



<script src="~/scripts/TimeOffice/Report/LivePunchReport.js"></script>



<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Live Punch Report</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Live Punch Report
                    </li>

                </ul>
            </div>
        </div>

        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <!--begin: Search Form-->
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">





                            <div class="tab-items">

                                <div class="row-outer pb-2 " style="width:200px">
                                    <label>Date</label>
                                    <div class="input-group date">
                                        @Html.TextBoxFor(Model => Model.Date, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "Date", @onchange = "GetList()" })
                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>


                                    </div>
                                </div>
                            </div>

                            <div class="tab-items">
                                <label>Group By</label>
                                <select id="grpType" onchange="onGrpChange()" class="form-control form-control-sm " style="width:200px">
                           
                                    <option selected="selected" value="1">Department</option>
                                    <option value="2">Section</option>
                                    <option value="3">Location</option>
                                    <option value="4">Division</option>
                                    <option value="5">Shift</option>
                                    <option value="6">PunchStatus</option>


                                </select>
                            </div>                      


                            <div class="tab-items select-option">


                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div class="filter-button slider-btn" id="filterForm" data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left" data-bs-original-title="Export to Excel">
                                    <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                </a>

                                @*<button id="test" onclick="onClick()">test</button>*@



                            </div>


                        </div>
                    </div>

                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.filter)
                    </div>


                    <!-- Table Section -->
                    <div id="PunchingList">
                        @await Html.PartialAsync("~/Areas/TimeOffice/Report/Views/LivePunchReport/_LivePunchReportList.cshtml",Model)
                    </div>
                    <!-- Table Setion End -->


                </div>
            </div>
        </div>
    </div>
</div>

