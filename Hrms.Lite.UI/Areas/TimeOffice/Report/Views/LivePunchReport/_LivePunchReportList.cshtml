@model Hrms.Lite.Shared.TimeOffice.Report.LivePunchReport

<link href="https://kendo.cdn.telerik.com/2023.1.117/styles/kendo.bootstrap-main.min.css" rel="stylesheet" type="text/css" />
<script src="https://kendo.cdn.telerik.com/2023.2.829/js/kendo.all.min.js"></script>
<script src="https://unpkg.com/jszip/dist/jszip.min.js"></script>
<script src="https://kendo.cdn.telerik.com/2023.2.829/js/kendo.aspnetmvc.min.js"></script>

@using Kendo.Mvc.UI

@(Html.Kendo().Grid<Hrms.Lite.Shared.TimeOffice.Report.LivePunchReport>()
    .Name("grid")
    .Columns(columns =>
    {
        columns.Bound(p => p.EmployeeID).Filterable(false).Width(100);
        columns.Bound(p => p.FullName).Width(100);
        columns.Bound(p => p.DEPARTMENT);//.Format("{0:MM/dd/yyyy}").Width(140);
        columns.Bound(p => p.LOCATION);
        columns.Bound(p => p.DIVISION);
        columns.Bound(p => p.SECTION);//.Width(150);
        columns.Bound(p => p.PAYROLLGROUP);
        columns.Bound(p => p.SHIFT);
        columns.Bound(p => p.Time);
        columns.Bound(p => p.PunchStatus);
    })
    .Pageable(pager => pager.Numeric(true).PreviousNext(true).Info(true).PageSizes(new[] { 10, 25 }).ButtonCount(5))

 .Excel(excel => excel.AllPages(true)

        .FileName("Kendo UI Grid Export.xlsx")

        .ProxyURL(Url.Action("Excel_Export_Save", "LivePunchReport"))
    )

    .Scrollable()

    .HtmlAttributes(new { style = "height:430px;" })
    .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(10)
        .Read(read => read.Action("GetReport", "LivePunchReport").Data("getParam"))
     .Group(g=>g.Add(x=>x.DEPARTMENT))
     )
)



