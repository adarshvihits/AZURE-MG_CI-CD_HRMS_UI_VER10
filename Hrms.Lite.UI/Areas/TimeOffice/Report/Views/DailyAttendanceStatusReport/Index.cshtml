@model Hrms.Lite.Shared.TimeOffice.Report.DailyAttendanceStatusReport
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>
<script src="~/scripts/TimeOffice/Report/dailyAttendanceStatusReport.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('#EmploymentTypes')
            .multiselect('selectAll', false);
        $('#Designations')
            .multiselect('selectAll', false);
        $('#Departments')
            .multiselect('selectAll', false);
        $('#Locations')
            .multiselect('selectAll', false);
        $('#Categories')
            .multiselect('selectAll', false);
        $('#Grades')
            .multiselect('selectAll', false);
        $('#PayrollGroups')
            .multiselect('selectAll', false);
        $('#Divisions')
            .multiselect('selectAll', false);
        $('#Sections')
            .multiselect('selectAll', false);
        $('#Regions')
            .multiselect('selectAll', false);
        $('#States')
            .multiselect('selectAll', false);
        $('#Shifts')
            .multiselect('selectAll', false);
    });
</script>
<style>
    .multiselect-filter {
        position: sticky;
        top: 0;
        z-index: 10;
        background-color: white;
    }

        .multiselect-filter .input-group {
            padding: 5px;
            margin: 0px;
            border-radius: 2px;
        }

    .multiselect-search {
        border-radius: 5px !important;
        height: 26px;
    }
</style>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Daily Attendance Status Report
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Daily Attendance Status Report
                    </li>
                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->


<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->
            <div class="row ">
                <div class="col-md-12">
                    <div class="card card-custom height-100per">
                        <div class="card-body">
                            @using (Html.BeginForm("ExportToExcel", "DailyAttendanceStatusReport", FormMethod.Post, new { @id = "dailyAttendanceStatusReport" }))
                            {
                                <div class="row tab-style-button">
                                    <div class="col-md-6">

                                        <div class="page_white">
                                            <div class="row my-2">
                                                <div class="col-md-6">
                                                    <label>From</label><span class="Mandatory">*</span>
                                                    <div class="input-group date">
                                                        @*<input type="text" class="form-control" id="kt_datepicker_2"
                                                            readonly="readonly" placeholder="From"
                                                            style="width:140px ;">*@
                                                        @Html.TextBoxFor(m => m.FromDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_8", @readonly = "true", @placeholder = "From", @onchange = "validate(this,'fromDte');ValidateFromAndToDate(this,'#fromDte')" })
                                                        <div class="input-group-append">
                                                            <span class="input-group-text">
                                                                <i class="la la-calendar"></i>
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <span id="fromDte"></span>
                                                </div>
                                                <div class="col-md-6">
                                                    <label>To</label><span class="Mandatory">*</span>
                                                    <div class="input-group date">
                                                        @*<input type="text" class="form-control" id="kt_datepicker_2"
                                                            readonly="readonly" placeholder="To" style="width:140px ;">*@
                                                        @Html.TextBoxFor(m => m.ToDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_8", @readonly = "true", @placeholder = "To", @onchange = "validate(this,'toDte');ValidateFromAndToDate(this,'#toDte');" })
                                                        <div class="input-group-append">
                                                            <span class="input-group-text">
                                                                <i class="la la-calendar"></i>
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <span id="toDte"></span>
                                                </div>


                                            </div>
                                            <div class="row my-2">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Fun.Designation</label>
                                                        @Html.ListBoxFor(m => m.Designations, (SelectList)ViewBag.Dsg,
                                                        new
                                                             {
                                                           @class = "multiselectDropdownFields",
                                                           @multiple = "multiple"
                                                        })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Department</label>
                                                        @Html.ListBoxFor(m => m.Departments, (SelectList)ViewBag.Dept,
                                                         new
                                                              {
                                                            @class = "multiselectDropdownFields",
                                                            @multiple = "multiple"
                                                         })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row my-2">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Location</label>
                                                        @Html.ListBoxFor(m => m.Locations, (SelectList)ViewBag.Loc,
                                                         new
                                                              {
                                                            @class = "multiselectDropdownFields",
                                                            @multiple = "multiple"
                                                         })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Category</label>
                                                        @Html.ListBoxFor(m => m.Categories, (SelectList)ViewBag.Cat,
                                                         new
                                                              {
                                                            @class = "multiselectDropdownFields",
                                                            @multiple = "multiple"
                                                         })

                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row my-2">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Designation</label>
                                                        @Html.ListBoxFor(m => m.Grades, (SelectList)ViewBag.Grd,
                                                         new
                                                              {
                                                            @class = "multiselectDropdownFields",
                                                            @multiple = "multiple"
                                                         })

                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Payroll Group</label>
                                                        @Html.ListBoxFor(m => m.PayrollGroups, (SelectList)ViewBag.PayrollGrp,
                                                         new
                                                              {
                                                            @class = "multiselectDropdownFields",
                                                            @multiple = "multiple"
                                                         })

                                                    </div>
                                                </div>






                                            </div>
                                            <div class="row my-2">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Region</label>
                                                        <span class="multiselect-native-select">
                                                            @Html.ListBoxFor(m => m.Regions, (SelectList)ViewBag.Reg, new
                                                       {
                                                           @class = "multiselectDropdownFields form-control-multiselect form-control-sm reset",
                                                           @multiple = "multiple",
                                                          // @onchange = "onGradeChange()"
                                                       })
                                                        </span>

                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>State</label>
                                                        <span class="multiselect-native-select">
                                                            @Html.ListBoxFor(m => m.States, (SelectList)ViewBag.St, new
                                                       {
                                                           @class = "multiselectDropdownFields form-control-multiselect form-control-sm reset",
                                                           @multiple = "multiple",
                                                          // @onchange = "onPayrollGroupChange()"
                                                       })
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row my-2">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Division</label>
                                                        @Html.ListBoxFor(m => m.Divisions, (SelectList)ViewBag.division,
                                                         new
                                                              {
                                                            @class = "multiselectDropdownFields",
                                                            @multiple = "multiple"
                                                         })

                                                    </div>
                                                </div>

                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Section</label>
                                                        @Html.ListBoxFor(m => m.Sections, (SelectList)ViewBag.section,
                                                         new
                                                              {
                                                            @class = "multiselectDropdownFields",
                                                            @multiple = "multiple"
                                                         })

                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row my-2">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Employment Type</label>
                                                        @*@Html.ListBoxFor(Model => Model .EmploymentTypes, (SelectList)ViewBag.EmploymentType,
                                                            new
                                                            {
                                                                @class = "multiselectDropdownFields form-control-multiselect form-control-sm",
                                                                @multiple = "multiple",
                                                                data_db_filter = "true",
                                                            })*@
                                                        @Html.ListBoxFor(Model => Model.EmploymentTypes, (SelectList)ViewBag.EmploymentType, new
                                                         {
                                                             @class = "multiselectDropdownFields form-control-multiselect form-control-sm",
                                                             @multiple = "multiple",

                                                             data_db_filter = "true",


                                                         })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Work Location</label>
                                                        @*@Html.ListBoxFor(m => m.WorkLocations, (SelectList)ViewBag.WorkLocation,
                                                            new
                                                                    {
                                                                @class = "multiselectDropdownFields",
                                                                @multiple = "multiple"
                                                            })*@
                                                        @Html.DropDownListFor(Model => Model.WorkLocations, (SelectList)ViewBag.WorkLocation, new { @class = "multiselectDropdownField form-control-multiselect form-control-sm", @multiple = "multiple", data_db_filter = "true" })


                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row my-2">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Wage Grade</label>
                                                        @*@Html.ListBoxFor(m => m.WageGrades, (SelectList)ViewBag.WageGrade,
                                                            new
                                                                 {
                                                               @class = "multiselectDropdownFields",
                                                               @multiple = "multiple"
                                                            })*@
                                                        @Html.DropDownListFor(Model => Model.WageGrades, (SelectList)ViewBag.WageGrade, new { @class = "multiselectDropdownField form-control-multiselect form-control-sm", @multiple = "multiple", data_db_filter = "true" })
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Shift Type</label>
                                                        @Html.ListBoxFor(m => m.Shifts, (SelectList)ViewBag.ShiftType,
                                                         new
                                                              {
                                                            @class = "multiselectDropdownFields",
                                                            @multiple = "multiple"
                                                         })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row my-2">
                                                <div class="col-md-6">
                                                    <div class="form-group">
                                                        <label>Attendance Status</label>
                                                        @*@Html.ListBoxFor(m => m.AttendanceStatuses, (SelectList)ViewBag.AttendanceStatus,
                                                            new
                                                                    {
                                                                @class = "multiselectDropdownFields",
                                                                @multiple = "multiple"
                                                            })*@
                                                        @Html.DropDownListFor(Model => Model.AttendanceStatuses, (SelectList)ViewBag.AttendanceStatus, new { @class = "multiselectDropdownField form-control-multiselect form-control-sm", @multiple = "multiple", data_db_filter = "true" })
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row pt-16">
                                                <div class="col-md-12">
                                                    <button type="button"
                                                            class="btn btn-default float-right mobile-full-width" onclick="getDataSetCountAJAX()">
                                                        Export To Excel
                                                    </button>
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </div>
                                <!-- <end table></end> -->
                            }
                        </div>

                    </div>
                </div>
            </div>
            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>
<!--end::Content-->
