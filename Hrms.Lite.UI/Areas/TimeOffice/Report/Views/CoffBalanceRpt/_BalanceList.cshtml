@model Hrms.Lite.Shared.TimeOffice.Report.CoffBalance
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table c_balance vertical-scroll-375">
    <table>
        <thead>
            <tr class="table-dark">
                <th scope="col">Entitle Date</th>
                <th scope="col">Day</th>
                <th scope="col">Session</th>
                @if (ViewBag.CoffBalType == "Availed")
                {
                    <th scope="col"> Availed On </th>
                }
                else
                {
                    <th scope="col">Expires On</th>
                }
                <th scope="col">Credited For</th>



            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.CoffBalanceList != null && Model.CoffBalanceList.Count > 0)
            {

                for (int i = 0; i < Model.CoffBalanceList.Count; i++)
                {
                    <tr>
                        <td data-label="Entitle Date">@Model.CoffBalanceList[i].EntitleDate.ToString("dd-MMM-yyyy")</td>
                        <td data-label="Credited For">@Model.CoffBalanceList[i].Day</td>
                        <td data-label="Credited For">@Model.CoffBalanceList[i].Session</td>
                        @if (ViewBag.CoffBalType == "Availed")
                        {
                            <td data-label="Expires On">@Model.CoffBalanceList[i].AvailedDate.ToString("dd-MMM-yyyy")  </td>

                        }
                        else
                        {
                            <td data-label="Expires On">@Model.CoffBalanceList[i].ExpiresOn.ToString("dd-MMM-yyyy")  </td>
                        }
                        <td data-label="Credited For">@Model.CoffBalanceList[i].CreditedFor</td>


                    </tr>
                }
            }

            else
            {
                <tr>
                    <td colspan="3">No data</td>
                </tr>

            }

        </tbody>
    </table>
</div>