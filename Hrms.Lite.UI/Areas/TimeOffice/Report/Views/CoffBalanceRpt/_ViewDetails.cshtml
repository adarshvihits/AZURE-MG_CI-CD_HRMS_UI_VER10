@model Hrms.Lite.Shared.TimeOffice.Report.CoffBalanceReport
<script src="~/js/tooltip.js"></script>



<div id="editloanissue" class="slider-forms slider-forms-open EditLoanIssueSlider">
    <div class="slider-inner-style">
        <div class="slider-form-close mb-4" onclick="CloseSlider('EditLoanIssueSlider')">

            <i class="ki ki-close icon-xs text-muted"></i>
        </div>
        <h4>COFF Balance</h4>
        <div class="profile-header position-relative pb-12 mb-5"
             style="padding-bottom: 2px !important; padding-top: 5px !important;">
            <div class="row">
                @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeSliderHeader.cshtml", Model.EmployeeHeader)
            </div>
            <div class="profile-header-overflow"></div>
        </div>





        <div class="ihits-table table-border hover-color odd-even mobile-responsive-table loan-History-Table">

            <table id="" class="">
                <thead>
                    <tr class="table-light">
                        <th scope="col">Entitled Date</th>
                        <th scope="col">Balance</th>
                        <th scope="col">Expiry Date</th>
                        <!--<th scope="col">-->@*Disbursement Date*@<!--</th>-->

                    </tr>
                </thead>
                <tbody>
                    @if (Model.Details != null && Model.Details.Count > 0)
                    {

                        for (int i = 0; i < Model.Details.Count; i++)
                        {
                    <tr>
                        <td>@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Details[i].Date))</td>
                        <td data-label="Name">
                            @Model.Details[i].Balance
                        </td>
                        <!--<td data-label="Designation">-->@*@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.info[i].DisbursementDate))*@<!--</td>-->
                        <td>@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Details[i].Expiry))</td>
                    </tr>
                        }
                    }



                </tbody>
            </table>
        </div>



    </div>
</div>




