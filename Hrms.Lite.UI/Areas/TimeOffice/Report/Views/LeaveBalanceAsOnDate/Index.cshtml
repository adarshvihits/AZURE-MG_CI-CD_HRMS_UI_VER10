@model Hrms.Lite.Shared.TimeOffice.Report.LeaveBalanceAsOnDate
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/TimeOffice/Report/LeaveBalanceAsOnDate.js"></script>

<script>
    $(document).ready(function () {
        fillData();
    });
</script>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Leave Balance As On Date</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index","Home",new { Area=""})"><i class="icon-nm fas fa-home"></i></a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Leave Balance As On Date
                    </li>
                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->
            <div class="card card-custom height-100per footer-row-fixed">
                <div class="card-body">
                    <!--begin: Search Form-->
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">

                            <div class="tab-items">
                                <div class="row-outer pb-2 " style="width:150px">
                                    <label>Date</label>
                                    <div class="input-group date">
                                        @Html.TextBoxFor(Model => Model.Date, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "From", onchange = "fillData()" })
                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                    <span id="Date"></span>
                                </div>
                            </div>
                            <div class="tab-items d-flex">
                                <div class="radio-inline pt-3">
                                    <label class="radio radio-outline radio-success">
                                        @Html.RadioButtonFor(m => m.Type, "ACTIVE", new { id = "r1", @onchange = "fillData()" })
                                        <span></span>Active
                                    </label>
                                    <label class="radio radio-outline radio-success">
                                        @Html.RadioButtonFor(m => m.Type, "RESIGNED", new { id = "r2", @onchange = "fillData()" })
                                        <span></span>Resigned
                                    </label>
                                </div>
                            </div>
                                <div class="tab-items pl-2 pt-4">
                                   
                                    <div class="form-group filter-combobox mr-2" style="width: 200px;">
                                        @Html.DropDownListFor(m => m.Leave.Code, (SelectList)ViewBag.Leave,
                            new { @class = "form-control form-control-sm Ltype", @onchange = "fillData()" })
                                        <span id="lev"></span>
                                    </div>
                                </div>

                                <div class="tab-items select-option  align-items-center pt-6">
                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>
                                    <div id="filterForm" class="filter-button slider-btn" data-bs-toggle="tooltip" title="Filter">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>
                                    <button data-bs-toggle="tooltip" title="" class="btn btn-excel" data-bs-original-title="Export to Excel" onclick="ExportToExcel()">
                                        <i class="icon-xl far fa-file-excel"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    <!-- Table Section -->
                    <div id="LOPListID">
                        @await Html.PartialAsync("~/Areas/TimeOffice/Report/Views/LeaveBalanceAsOnDate/List.cshtml")
                    </div>
                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.filter)
                    </div>
                    @*Table section*@
                    <!-- Table Setion End -->
                    <div class="row card-footer-bottom-fixed">
                    </div>
                    <!--end: Datatable-->
                </div>
            </div>
            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
</div>
<!--end::Content-->
<!--end::Entry-->
