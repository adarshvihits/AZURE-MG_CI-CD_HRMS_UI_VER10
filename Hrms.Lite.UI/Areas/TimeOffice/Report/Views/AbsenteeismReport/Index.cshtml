@model Hrms.Lite.Shared.TimeOffice.Report.AbsenteeismReport
<script src="~/scripts/TimeOffice/Report/AbsenteeismReport.js"></script>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>

<script>
    $(document).ready(function () {
        debugger;
        GetFillData();
    });
</script>




<div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->


            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Absenteeism Report</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })" class=""><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            Absenteeism Report
                        </li>
                    </ul>
                </div>
            </div>
            <!--begin::Topbar-->
            <!--<div class="topbar">-->
            <!--begin::User-->
            <!--<div class="topbar-item">
                <div class="btn btn-icon btn-icon-mobile w-auto btn-clean d-flex align-items-center btn-lg px-2">
                    <span class="text-muted font-weight-bold font-size-base d-none d-md-inline mr-1">Hi,</span>
                    <span class="text-dark-50 font-weight-bolder font-size-base d-none d-md-inline mr-3">Sean</span>

                </div>
            </div>-->
            <!--end::User-->
            <!--</div>-->
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body">
                        <!--begin: Search Form-->

                        <div class="row tab-style-button">
                            <div class="tab-button-wrap align-items-center">




                                <div class="tab-items">

                                    <div class="row-outer pb-2 " style="width:150px">
                                        <label>From</label>
                                        <div class="input-group date">
                                            @Html.TextBoxFor(Model => Model.FromDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2 dop", @readonly = "true", @placeholder = "From Date", @onchange = "onDateClick();validate(this,'fromdate')" })

                                            <div class="input-group-append">
                                                <span class="input-group-text">
                                                    <i class="la la-calendar"></i>
                                                </span>
                                            </div>

                                        </div>
                                        <span id="fromdate"></span>
                                    </div>
                                </div>
                                <div class="tab-items">

                                    <div class="row-outer pb-2" style="width:150px">
                                        <label>To</label>
                                        <div class="input-group date">
                                            @Html.TextBoxFor(Model => Model.ToDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2 dop", @readonly = "true", @placeholder = "From Date", @onchange = "onDateClick();validate(this,'todate')" })

                                            <div class="input-group-append">
                                                <span class="input-group-text">
                                                    <i class="la la-calendar"></i>
                                                </span>
                                            </div>

                                        </div>
                                        <span id="todate"></span>
                                    </div>
                                </div>
                                <div class="tab-items ">

                                    <div class="row-outer pb-2 " style="width:250px">
                                        <label></label>
                                        <div class="form-group filter-combobox  mb-0 mt-0">
                                            @Html.DropDownListFor(Model => Model.Type.Code, (SelectList)ViewBag.Type, "--Select--", new { @class = "form-control form-control-sm ", @onblur = "validate(this,'type')" })
                                            <span id="type"></span>
                                        </div>

                                    </div>
                                </div>


                                <div class="tab-items ">

                                    <div class="row-outer pb-2 ">
                                        <div class="button-group float-left mr-8 mb-0">
                                            <button type="button" class="btn btn-default btn-sm float-left" onclick="GetFillData();validateDates()">
                                                Proceed
                                            </button>
                                        </div>
                                    </div>
                                </div>



                                <div class="tab-items select-option ">


                                    <div class="sraech-slider" id="searchID">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>
                                    <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>

                                    <button data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                            data-bs-original-title="Export to Excel" onclick="ExportToExcel()">
                                        <i class="icon-xl far fa-file-excel"></i>
                                    </button>


                                </div>


                            </div>
                        </div>

                        <div id="ListID">
                            @await Html.PartialAsync("~/Areas/TimeOffice/Report/Views/AbsenteeismReport/_DateWiseStatusList.cshtml", Model)
                        </div>
                        <div id="filterSlider">

                            @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
                        </div>


                        <div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog"
                             aria-labelledby="myLargeModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-lg" style="max-width:940px ;">
                                <div id="myDiv" class="modal-content popup">

                                    <div class="modal-body new-salary">
                                        @await Html.PartialAsync("~/Areas/TimeOffice/Report/Views/AbsenteeismReport/_EmpWisePopUp.cshtml")
                                    </div>

                                </div>
                            </div>
                        </div>



                        <div class="modal fade bd-example-modal-lg1" tabindex="-1" role="dialog"
                             aria-labelledby="myLargeModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-lg" style="max-width:940px ;">
                                <div id="myDiv1" class="modal-content popup">

                                    <div class="modal-body new-salary">
                                        @await Html.PartialAsync("~/Areas/TimeOffice/Report/Views/AbsenteeismReport/_DateWisePopUp.cshtml")
                                    </div>
                                </div>
                            </div>
                        </div>



                    </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>
    <div class="slider-over-flow"></div>
    <!--end::Content-->


</div>


 