




@model Hrms.Lite.Shared.TimeOffice.Report.AbsenteeismReport
<script src="~/scripts/TimeOffice/Report/AbsenteeismReport.js"></script>

<script src="~/js/tooltip.js"></script>
@*<script src="~/js/settings.js"></script>*@
<style>
    .dataTables_scrollBody {
        height: 30vh !important;
    }
</style>
<div class="modal-header" style="padding:10px">
    <div class="d-flex">
        <h5 class="modal-title" id="popupHeading">

            @*@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.PopPupHead))*@
        </h5>

        <div class="d-flex ml-5 pt-1 ">
            @*<h4 class="pr-1 reason-popup">Reason: </h4>

      

            <span class="DatePopUpHead"> </span>*@
        </div>

    </div>
    <div>
        <button data-bs-toggle="tooltip" title="" class="btn btn-excel mr-6"
                data-bs-original-title="Export to Excel">
            <i class="icon-xl far fa-file-excel" onclick="ExportToexcelPopUP()"></i>
        </button>
        <button type="button" class="close mt-2" data-bs-dismiss="modal"
                aria-label="Close">
            <i aria-hidden="true" class="ki ki-close"></i>
        </button>
    </div>
</div>

<div style="padding:10px;"
     class="ihits-table table-border hover-color odd-even mobile-responsive-table  absenteesim-popup-one">
    @Html.HiddenFor(m => m.Details.Count)

    <div class="row">


        <div class="col-md-12 d-flex justify-content-end">


        </div>

    </div>

    <br>
    <table id="ReasonTable" class="common-table">
        <thead>
            <tr class="table-light">
                <th scope="col">Sl.No</th>
                <th scope="col">Date</th>
                <th scope="col">Shift</th>
                <th scope="col">IN</th>
                <th scope="col">OUT</th>
                <th scope="col" data-bs-toggle="tooltip" title=""
                    data-bs-original-title="Attendance Status">Att. Status</th>
                <th scope="col">
                    <span id="reasonDate"> Reason</span>
               </th>


            </tr>
        </thead>
     


    </table>
</div>
