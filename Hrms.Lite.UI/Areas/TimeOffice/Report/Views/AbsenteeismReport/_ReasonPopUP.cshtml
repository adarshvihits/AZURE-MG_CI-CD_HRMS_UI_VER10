                <th scope="col">Shift</th>
                <th scope="col">IN</th>
                <th scope="col">OUT</th>
                <th scope="col" data-bs-toggle="tooltip" title=""
                    data-bs-original-title="Attendance Status">Att. Status</th>
                <th scope="col">Reason</th>


            </tr>
        </thead>
