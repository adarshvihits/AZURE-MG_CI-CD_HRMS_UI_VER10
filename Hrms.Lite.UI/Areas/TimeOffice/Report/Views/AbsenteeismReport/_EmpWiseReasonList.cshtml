




@model Hrms.Lite.Shared.TimeOffice.Report.AbsenteeismReport
<script src="~/js/tooltip.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        fillDataList();
    });
</script>
<style>
    .abent_tble .dataTables_scrollBody {
        height: 60vh !important;
    }
</style>




<div class="ihits-table table-border hover-color odd-even mobile-responsive-table absenteeism-reason-table abent_tble">
    @Html.HiddenFor(m => m.ReasonWise.Count)
    <table id="EmpReasonTable" class="common-table">
        <thead>
            <tr class="table-dark">

                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Late In</th>
                <th scope="col">Early Out</th>
                <th scope="col" data-bs-toggle="tooltip"
                    data-bs-original-title="Missing Punch In">Miss.Pun.In</th>
                <th scope="col" data-bs-toggle="tooltip"
                    data-bs-original-title="Missing Punch Out">Miss.Pun.Out</th>
                <th scope="col" data-bs-toggle="tooltip"
                    data-bs-original-title="Missing Punch In-Out">Miss.Pun.In-Out</th>
                <th scope="col" data-bs-toggle="tooltip"
                    data-bs-original-title="Company ID Missing">Com.ID Miss</th>
                <th scope="col" data-bs-toggle="tooltip"
                    data-bs-original-title="Shift Mismatch">Shift Mismatch</th>
                <th scope="col" data-bs-toggle="tooltip"
                    data-bs-original-title="Shift Not Allocated">Shift Not Alloc.</th>
                <th scope="col" data-bs-toggle="tooltip"
                    data-bs-original-title="Total Hours In Shift Not Achieved Or Shift Mismatch">
                    Tot.Hrs In Shft.Not Ach.Or Shft.Miss
                </th>
                <th scope="col" data-bs-toggle="tooltip"
                    data-bs-original-title="Leave Approval Pending">Leave Appr.Pen</th>

            </tr>
        </thead>

    </table>
</div>