


@model Hrms.Lite.Shared.TimeOffice.Report.AbsenteeismReport
<script src="~/js/tooltip.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        fillDataList();
    });
</script>


<style>
    .abent_tble .dataTables_scrollBody {
        height: 60vh !important;
    }
</style>


<div class="ihits-table table-border hover-color odd-even mobile-responsive-table absenteeism-report-table abent_tble">
    @Html.HiddenFor(m => m.AttendanceStatus.Count)
    <table id="EmpStatusTable" class="common-table">
        <thead>
            <tr class="table-dark">

                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col" data-bs-toggle="tooltip"
                    data-bs-original-title="Actual Manpower">Act.Man</th>
                <th scope="col" data-bs-toggle="tooltip"
                    data-bs-original-title="Physical PR">Phy. PR</th>
                <th scope="col" data-bs-toggle="tooltip"
                    data-bs-original-title="ON Duty">OD</th>
                <th scope="col" data-bs-toggle="tooltip"
                    data-bs-original-title="Attendance Regularization">RA</th>
                <th scope="col">Leave</th>
                <th scope="col" data-bs-toggle="tooltip"
                    data-bs-original-title="Maternity Leave">ML</th>
                <th scope="col" data-bs-toggle="tooltip"
                    data-bs-original-title="ESI">ESI</th>
                <th scope="col">OffDay</th>
                <th scope="col">Holiday</th>
                <th scope="col" data-bs-toggle="tooltip"
                    data-bs-original-title="Years of Experience">LOP</th>
                <th scope="col">AB</th>
                <th scope="col">AB %</th>

            </tr>
        </thead>

    </table>
</div>