@model Hrms.Lite.Shared.TimeOffice.Report.LeaveRegister
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    .empdropdown {
        height: 35px;
        padding: 8px;
        width: 280px;
    }

        .empdropdown .filter-option-inner {
            padding: 4px;
        }
</style>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/TimeOffice/Report/EmployeeVsLeaveDetailsReport.js"></script>


<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->

        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Employee Vs Leave Details Report</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home" , new { Area="" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Employee Vs Leave Details Report
                    </li>
                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
@using (Html.BeginForm("ExportToExcelDetails", "empVsleaveDetails", FormMethod.Post, new { id = "empVsleaveDetails" }))
{
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body">

                        <!--begin: Search Form-->
                        <div class="row tab-style-button">
                            <div class="tab-button-wrap">

                                <div class="tab-items">

                                    <div class="form-group filter-combobox pt-2 pl-2" style="width: 180px;">
                                        <!-- <label>Leave Period</label> -->
                                        @Html.DropDownListFor(m => m.LeavePeriod.Code, (SelectList)ViewBag.LeavePeriod, new { @class = "form-control form-control-sm", @onchange = "GetEmployeeList()" @*@onchange = "onLeavePeriodChange('#LeavePeriod_Code','LR_LeavePeriod' )"*@})


                                        <span id="LR_LeavePeriod"></span>
                                    </div>
                                </div>
                                <!-- Radio Buttons -->
                                <div class="radio-inline d-flex align-items-center">
                                    <label class="radio radio-outline radio-success me-3">
                                        @Html.RadioButtonFor(m => m.Type, "ACTIVE", new { @onchange = "GetEmployeeList()" })
                                        <span></span>Active
                                    </label>
                                    <label class="radio radio-outline radio-success">
                                        @Html.RadioButtonFor(m => m.Type, "RESIGNED", new { @onchange = "GetEmployeeList()" })
                                        <span></span>Resigned
                                    </label>
                                </div>
                                <div class="tab-items">
                                    <div class="position pl-5 pt-4 empdropdown">
                                        <div>


                                            @Html.DropDownListFor(m => m.EmployeeCode, (SelectList)ViewBag.Emp,  new

                                       {
                                           @class = "selectpicker sliderSearchInput form-control form-control-sm em",
                                           @onchange = "GetList()",
                                           data_show_subtext = "true",
                                           data_live_search = "true",
                                       })

                                        </div>
                                        <span id="empC"></span>
                                    </div>
                                </div>



                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12">
                                <div id="leaveList">
                                    @await Html.PartialAsync("~/Areas/TimeOffice/Report/Views/EmployeeVsLeaveDetailsReport/_LeaveList.cshtml", Model)
                                </div>
                            </div>
                            @*<div class="col-md-4" id="leaveDetailsList">
                                    @await Html.PartialAsync("~/Areas/TimeOffice/Report/Views/EmployeeVsLeaveDetailsReport/_LeaveDetailsList.cshtml", Model)

                                </div>*@


                        </div>


                        <!-- Table Setion End -->
                        <!--end: Datatable-->
                    </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>

    </div>
}
    <!--end::Content-->
    <!--end::Entry-->
