@model Hrms.Lite.Shared.TimeOffice.Report.LeaveRegister
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table pt-1 leave_details_list vertical-scroll-325">
    @Html.HiddenFor(model => Model.LeaveDetails.Count)
    <table id="leaveDetailsTable">
        <thead>
            <tr class="table-dark">

                <th scope="col">Leave</th>
                <th scope="col">Date</th>
                <th scope="col">Day</th>                
            </tr>
        </thead>
        <tbody>

            @{
            if (Model.LeaveDetails != null && Model.LeaveDetails.Count > 0)
            {

            for (int i = 0; i < Model.LeaveDetails.Count; i++)
            {
            <tr>


                <td data-label="Name">
                    @Model.LeaveDetails[i].Leave
                </td>
                <td data-label="Short Name"> @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.LeaveDetails[i].LeaveDate))</td>
                <td data-label="Allowance Type"> @Model.LeaveDetails[i].DayStatus</td>               

            </tr>
            }
            }
            }

        </tbody>
    </table>
</div>