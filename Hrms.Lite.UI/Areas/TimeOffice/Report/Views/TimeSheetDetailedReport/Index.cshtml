@model Hrms.Lite.Shared.TimeOffice.Report.TimeSheetEntry
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>

<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/TimeOffice/Report/timeSheetDetailedReport.js"></script>
<script>
    $(document).ready(function () {
        fillData();
    });
</script>
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">TimeSheet Detailed Report</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        TimeSheet Detailed Report
                    </li>

                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <!--begin: Search Form-->
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items ml-2 pr-0 border-none select-option">
                                <div class="form-group filter-combobox mr-2" style="width: 150px;">
                                    <label>From</label><span class="Mandatory">*</span>
                                    <div class="input-group date">
                                        @Html.TextBoxFor(Model => Model.From, "{0:dd-MMM-yyyy}", new { @class = "form-control form-control-sm kt_datepicker_2", @Wplaceholder = "Attended Date", @onchange = "validate(this,'From');fillData()", @readonly = "true" })
                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>

                                    </div>
                                    <span id="From"></span>
                                </div>

                            </div>
                            <div class="tab-items pr-0 border-none ">
                                <div class="form-group filter-combobox mr-2" style="width: 200px;">
                                    <label>To</label><span class="Mandatory">*</span>
                                    <div class="input-group date">
                                        @Html.TextBoxFor(Model => Model.To, "{0:dd-MMM-yyyy}", new { @class = "form-control form-control-sm kt_datepicker_2", @Wplaceholder = "Attended Date", @onchange = "validate(this,'To');fillData()", @readonly = "true" })
                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>

                                    </div>
                                    <span id="To"></span>
                                </div>

                            </div>
                            <div class="tab-items select-option">
                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="Export to Excel" onclick="ExportToExcel()"
                                   class="btn btn-excel mr-0">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>
                            </div>
                        </div>
                        
                    </div>
                   
                        <!-- Table Section -->
                        <div id="LeaveCreditDebitList">
                            @await Html.PartialAsync("~/Areas/TimeOffice/Report/Views/TimeSheetDetailedReport/_List.cshtml")
                        </div>
                        <div id="editLeaveCreditDebit"></div>
                        <div id="bupdate1">

                        </div>

                        <div class="row card-footer-bottom-fixed">


                        </div>

                        <div id="filterSlider">
                            @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.SliderFilter)
                        </div>
                    </div>
                </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
<!--end::Content-->