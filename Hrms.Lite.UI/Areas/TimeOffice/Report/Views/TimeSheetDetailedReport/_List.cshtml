
@model Hrms.Lite.Shared.TimeOffice.Report.TimeSheetEntry
<script src="~/js/tooltip.js"></script>


<div class="ihits-table table-border hover-color odd-even mobile-responsive-table timesheet-report-table">
    @Html.HiddenFor(m => m.TimeSheetEntryList.Count)
    <table id="TimeSheetTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">Employee ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col" data-bs-toggle="tooltip" title="Work Date">Wk.Dt</th>
                <th scope="col" data-bs-toggle="tooltip" title="Project Name">Pro.Name</th>
                <th scope="col" data-bs-toggle="tooltip" title="Activity Name">Act.Name</th>
                <th scope="col" data-bs-toggle="tooltip" title="Approval By">App.By</th>
                <th scope="col" data-bs-toggle="tooltip" title="Approval Date">App.Date</th>
                <th scope="col" data-bs-toggle="tooltip" title="Status">Status</th>
                <th scope="col" data-bs-toggle="tooltip" title="Total Hours">Tot.Hs</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>
