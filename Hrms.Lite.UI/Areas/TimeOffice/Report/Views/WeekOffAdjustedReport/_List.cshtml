@model Hrms.Lite.Shared.TimeOffice.Report.WeekOffAdjustedReport

    <script src="~/js/settings.js"></script>
    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table Weekoff-adjusted-report">
        @Html.HiddenFor(m => m.WeekOffAdjustedReportList.Count)
        <table id="WeekOffAdjustedReportTable" class="common-table">
            <thead>
                <tr class="table-dark">


                    <th scope="col">ID</th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">Fun.Designation</th>
                    <th scope="col">Department</th>
                    <th scope="col">Location</th>
                    <th scope="col">Marked OFFDAYS</th>
                    <th scope="col">Actual PR Days </th>
                    <th scope="col">Allocated OffDays</th>
                    <th scope="col"> Lapse </th>


                </tr>
            </thead>
            <tbody>


                @{
                    if (Model.WeekOffAdjustedReportList != null && Model.WeekOffAdjustedReportList.Count > 0)
                    {
                        for (int i = 0; i < Model.WeekOffAdjustedReportList.Count; i++)
                        {
                                <tr>
                                    <td data-label="ID">@Model.WeekOffAdjustedReportList[i].EmployeeID</td>
                                    <td data-label="Employee Name">@Model.WeekOffAdjustedReportList[i].EmployeeName </td>
                                    <td data-label="Designation">@Model.WeekOffAdjustedReportList[i].Designation</td>
                                    <td data-label="Department">@Model.WeekOffAdjustedReportList[i].Department </td>
                                    <td data-label="Location">@Model.WeekOffAdjustedReportList[i].Location</td>
                                    <td data-label="Marked OFFDAYS">@Model.WeekOffAdjustedReportList[i].OFFDAYS</td>
                                    <td data-label="Actual PR Days">@Model.WeekOffAdjustedReportList[i].ActualPRDays</td>
                                    <td data-label="Allocated OffDays">@Model.WeekOffAdjustedReportList[i].AllocatedOffDays</td>
                                    <td data-label="Lapse">@Model.WeekOffAdjustedReportList[i].AdjOffday</td>



                                </tr>
                        }
                    }

                }
            </tbody>
        </table>
    </div>