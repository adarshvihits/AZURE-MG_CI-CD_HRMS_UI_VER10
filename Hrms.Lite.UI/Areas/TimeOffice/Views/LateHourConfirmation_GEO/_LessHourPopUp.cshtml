            <h3> Late In</h3>
            <div class="ihits-table table-border odd-even mobile-responsive-table vertical-scroll-250">

                <table id="PopUptable">

                    <thead>


                        <tr class="table-dark">
                            <th scope="col">Date</th>
                            <th scope="col">Shift</th>
                            <th scope="col">IN</th>
                            <th scope="col">OUT</th>
                            <th scope="col">Late Time</th>



                        </tr>

                    </thead>
                    <tbody>

                        @if (Model.AttDetails != null && Model.AttDetails.Count > 0)
                        {

                            for (int i = 0; i < Model.AttDetails.Count; i++)
                            {
                                <tr>
                                    <td data-label="Date">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Convert.ToDateTime(Model.AttDetails[i].Date)))</td>
                                    <td data-label="Shift">@(Model.AttDetails[i].ShiftName)</td>
                                    <td data-label="In">@Model.AttDetails[i].IN</td>
                                    <td data-label="Out">@Model.AttDetails[i].Out</td>
                                    <td data-label="Late In/Early Out">@Model.AttDetails[i].LateIn</td>

                                </tr>

                            }
                        }

                    </tbody>
                </table>

            </div>
            <h3> Early Out</h3>
            <div class="ihits-table table-border odd-even mobile-responsive-table vertical-scroll-250">

                <table id="PopUptable">

                    <thead>


                        <tr class="table-dark">
                            <th scope="col">Date</th>
                            <th scope="col">Shift</th>
                            <th scope="col">IN</th>
                            <th scope="col">OUT</th>
                            <th scope="col">Early Out</th>



                        </tr>

                    </thead>
                    <tbody>

                        @if (Model.EarlyDetails != null && Model.EarlyDetails.Count > 0)
                        {

                            for (int i = 0; i < Model.EarlyDetails.Count; i++)
                            {
                                <tr>
