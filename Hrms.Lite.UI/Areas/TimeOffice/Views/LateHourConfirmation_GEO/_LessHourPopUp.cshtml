                                    <td data-label="In">@Model.EarlyDetails[i].IN</td>
                                    <td data-label="Out">@Model.EarlyDetails[i].Out</td>
                                    <td data-label="Late In/Early Out">@Model.EarlyDetails[i].EarlyOut</td>

                                </tr>

                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" style="text-align:center; color: red;">
                                    No Early Out records found
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>




            </div>*@

