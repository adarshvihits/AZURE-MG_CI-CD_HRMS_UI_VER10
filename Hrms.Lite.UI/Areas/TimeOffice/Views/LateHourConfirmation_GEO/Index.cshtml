@model Hrms.Lite.Shared.TimeOffice.AttendanceWagesConfirmation
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="~/scripts/TimeOffice/LateHourConfirmation_GEO.js" asp-append-version="true"></script>
<script>
    function ApplyFilter(mode) {
        debugger;


        if (mode == 'apply') {
            if (filterApplicable >= 1) {
                getList();
                CloseSlider('basicFilter');
                $('#filterForm').removeClass('filter-apply');
            }
            else {
                getList();
                CloseSlider('basicFilter');
                $('#filterForm').addClass('filter-apply');
            }

        }
        else {
            filterApplicable = 1;
            $('.reset').val('');
            $('#filterForm').removeClass('filter-apply');
            getList();


        }
    }
</script>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Late Hour Confirmation</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Late Hour Confirmation 
                    </li>

                </ul>
            </div>
        </div>

        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->


<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">



                            <div class="tab-items ">
                                <span class="btn-title active tab1" onclick="tabClick('tab1','Pending')">
                                    @*<a class="btn-title " onclick="tabClick('tab1','Pending')">*@
                                    Pending
                                    <span class="btn-notification PendingCount">@Model.PendingCount</span>
                                </span>
                                @*</a>*@
                            </div>


                            <div class="tab-items ">
                                <span class="btn-title  tab2" onclick="tabClick('tab2', 'Confirmed')">
                                    @*<a class="btn-title" onclick="tabClick('Confirmed',2)">*@
                                    Confirmed

                                    <span class="btn-notification ConfirmedCount">@Model.ConfirmedCount</span>
                                </span>
                                @*</a>*@
                            </div>
                            @*<div class="tab-items ">
                                <div class="form-group filter-combobox mt-0">
                                    @Html.DropDownListFor(Model => Model.PayrollGroup.Code, (SelectList)ViewBag.PayrollGroup, "--Select Payroll Group--", new { @class = "form-control form-control-sm month", @style = "120px;", @onblur = "validate(this,'month')", @onchange = "Getmonth()" })
                                    <span id="PayrollGroups"></span>


                                </div>
                            </div>*@
                            <div class="tab-items ">
                                @*<label>Month</label>*@
                                <div class="form-group filter-combobox mt-0">
                                    @Html.DropDownListFor(Model => Model.MonthCode, (SelectList)ViewBag.month, "--Select Month--", new { @class = "form-control form-control-sm month", @style = "120px;", @onblur = "validate(this,'month')" })
                                    <span id="month"></span>

                                </div>
                            </div>
                            <div class="tab-items">

                                <div class="row-outer ">
                                    <div class="form-group">

                                        <button type="button"
                                                class="btn btn-default float-right mobile-full-width" onclick="getList()">
                                            Proceed
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="tab-items select-option">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div class="filter-button slider-btn" id="filterForm" data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>

                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                   data-bs-original-title="Export to Excel">
                                    <i class="icon-xl far fa-file-excel" onclick="ExportToexcel()"></i>
                                </a>
                            </div>



                        </div>
                    </div>
                    <div id="editLateHour">

                    </div>
                    <div id="listID">
                        @await Html.PartialAsync("_List", Model)
                    </div>

                    <div class="row card-footer-bottom-fixed">
                        <div class="col-md-6 align-left">



                            <div class="responsive-center hide">
                                <a href="@Url.Action("History", "LateHourConfirmation_AVG", new { Area = "Custom" })">
                                    <div class="application-btn d-flex align-items-center  pr-3 ">
                                        <div>
                                            <img class="leave_appli_img">

                                        </div>
                                        <div class="application-icon"> <h3 class="pt-2 pl-3"> Transaction History </h3></div>
                                    </div>
                                </a>


                            </div>

                        </div>

                        <div class="col-md-12">
                            <a type="button" id="confirmlhbtn" class="btn btn-default float-right mobile-full-width" onclick="OnConfirmClick()">
                                Confirm
                            </a>

                        </div>
                    </div>

                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>

<div id="filterSlider">
    @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
</div>
<!--end::Content-->
<div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog"
     aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" style="max-width:940px ;">
        <div class="modal-content popup">
            <div class="modal-header" style="padding:10px">
                <h5 class="modal-title" id="exampleModalLabel">
                </h5>
                <button type="button" class="close mt-2" data-bs-dismiss="modal"
                        aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">
                @await Html.PartialAsync("_Details", Model)
            </div>


        </div>
    </div>
</div>

