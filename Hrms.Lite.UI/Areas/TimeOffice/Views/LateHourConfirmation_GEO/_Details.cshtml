@model Hrms.Lite.Shared.TimeOffice.AttendanceWagesConfirmation
<script>
        $(document).ready(function () {
            debugger;
            $(".modal-title").html('@Model.EmployeeName');
        });
</script>

<style>

    .wid3 {
        width: 170%;
    }
</style>
@if (Model.LHCDetails != null && Model.LHCDetails.Count > 0)
{

    <div class="row">


        <div class="d-flex align-items-center">
            <label class="mr-5 ml-5">ID</label>
            <div class="form-group">



                @Html.TextBoxFor(Model => Model.EmployeeId, new { @class = "form-control form-control-sm", @maxlength = 8, @placeholder = "Employee ID", @readonly = "readonly" })
            </div>

        </div>


        <div class="d-flex align-items-center">
            <label class="mr-5 ml-5">Name</label>
            <div class="form-group">


                @Html.TextBoxFor(Model => Model.EmployeeName, new { @class = "form-control form-control-sm wid3", @maxlength = 8, @placeholder = "Employee Name", @readonly = "readonly" })
            </div>

        </div>



    </div>
}



<div class="ihits-table table-border odd-even mobile-responsive-table LHC-popup-Details vertical-scroll-250">

    <table id="PopUptable">

        <thead>

        		

            <tr class="table-dark">
                <th scope="col">Date</th>
                <th scope="col">Day</th>
                <th scope="col">Type</th>

                <th scope="col">Shift IN/OUT</th>
                <th scope="col">Time IN/OUT</th>
                <th scope="col">Late BY/Early Out</th>
                <th scope="col">Total Hrs.</th>
                <th scope="col">Deduction Days</th>



            </tr>

        </thead>
        <tbody>

            @if (Model.LHCDetails != null && Model.LHCDetails.Count > 0)
            {

                for (int i = 0; i < Model.LHCDetails.Count; i++)
                {
                    <tr>
                        <td data-label="Date">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Convert.ToDateTime(Model.LHCDetails[i].Date)))</td>
                        <td data-label="Shift">@(Model.LHCDetails[i].Day_Name)</td>
                        <td data-label="Shift">@(Model.LHCDetails[i].Type)</td>
                        <td data-label="In">@Model.LHCDetails[i].StartTime</td>
                        <td data-label="Out">@Model.LHCDetails[i].IN</td>
                        <td data-label="Late In/Early Out">@Model.LHCDetails[i].LateIn</td>
                        <td data-label="Late In/Early Out">@Model.LHCDetails[i].indays</td>
                        <td data-label="Late In/Early Out">@Model.LHCDetails[i].CUTTING_TIME</td>

                    </tr>

                }
            }

        </tbody>
    </table>

</div>
