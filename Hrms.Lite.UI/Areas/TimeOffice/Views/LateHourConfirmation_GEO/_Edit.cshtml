@model Hrms.Lite.Shared.TimeOffice.AttendanceWagesConfirmation
<script src="~/js/bootstrap-datepicker.js"></script>
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "lesshoursave" }))
{
    <div id="AppraisalView" class="slider-forms slider-forms-open closureEdit">
        <div class="slider-inner-style">
            <div class="slider-form-close">
                <i class="ki ki-close icon-xs text-muted" onclick="CloseSlider('closureEdit')"></i>
            </div>
            <h4>Late Hour Confirmation</h4>

            <div class="row">
                @Html.HiddenFor(m => m.EmployeeGI)

                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Name
                        </label>
                        <div class="view-details">
                            @Model.EmployeeName
                        </div>
                    </div>
                </div>


            </div>
            <div class="row">


                <div class="col-md-6">
                    <div class="form-group">
                        <label>Deduction Days</label>
                        @Html.HiddenFor(m => m.EmployeeCode)

                        @Html.TextBoxFor(m => m.DeductionDays, new { @class = "form-control form-control-sm", @maxlength = 8, @placeholder = "Confirmed Value" })
                    </div>
                </div>

            </div>


            <div class="row">

                <div class="col-md-12">
                    <label>Remarks</label>
                    @Html.TextAreaFor(m => m.Remarks, new { @class = "form-control form-control-sm", @placeholder = "Remarks" })
                </div>

            </div>
            <div class="row card-footer-bottom-fixed border-none">
                <div class="col-md-12 align-right">

                    <a class="btn btn-default  mobile-full-width" onclick="onListWiseSaveClick('Save')">
                        Save
                    </a>
                </div>

            </div>



        </div>
    </div>
}
