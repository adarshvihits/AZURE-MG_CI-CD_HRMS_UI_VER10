@model Hrms.Lite.Shared.TimeOffice.LeaveOpening
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>

<script src="~/scripts/TimeOffice/leaveOpeningDelete.js"></script>


<script>
    $(document).ready(function () {
        debugger;
        fillData();

    });
</script>








<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Leave Opening Delete</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Leave Opening Delete
                    </li>

                </ul>
            </div>
        </div>

        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                    <div class="mobile-tab-section">
                        <div class="row mb-2">



                            <div class="col-6">
                                <div class="form-group">
                                    <label>Select Leave Period</label>
                                    @Html.DropDownListFor(m => m.LeavePeriod.Code, (SelectList)ViewBag.LeavePeriod, "--Leave Period--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'MlevPeriod');$('.Lperiod').val($('#LeavePeriod_Code').val());fillData();" })
                                    <span id="MlevPeriod"></span>
                                </div>
                            </div>
                            <div class="col-6" id="assetFilter">
                                <div class="form-group">
                                    <label>Select Leave Group</label>
                                    @Html.DropDownListFor(m => m.LeaveGroup.Code, (SelectList)ViewBag.LeaveGroup, "--Leave Group--", new
                                    {
                                        @class = "form-control form-control-sm",
                                        @onchange = "validate(this,'MlevGroup');" +
                                   "$('.Lgroup').val($('#LeaveGroup_Code').val());fillData();"
                                    })
                                    <span id="MlevGroup"></span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-group">
                                    <label>Select Leave</label>
                                    @Html.DropDownListFor(m => m.Leave.Code, (SelectList)ViewBag.Leave, "--Leave--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'Mlev');$('.Ltype').val($('#Leave_Code').val());fillData();" })
                                    <span id="Mlev"></span>
                                </div>
                            </div>

                        </div>
                    </div>






                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items ml-5 pr-0 border-none select-option">
                                <div class="form-group filter-combobox mr-2" style="width: 150px;">

                                    @Html.DropDownListFor(m => m.LeavePeriod.Code, (SelectList)ViewBag.LeavePeriod, "--Leave Period--", new
                                    {
                                        @class = "form-control form-control-sm Lperiod",
                                   @onchange = "validate(this,'levPeriod');$('#LeavePeriod_Code').val($('.Lperiod').val());fillData()"
                               })
                                    <span id="levPeriod"></span>
                                </div>
                            </div>
                            <div class="tab-items ml-5 pr-0 border-none select-option">
                                <div class="form-group filter-combobox mr-2" style="width: 200px;">

                                    @Html.DropDownListFor(m => m.LeaveGroup.Code, (SelectList)ViewBag.LeaveGroup, "--Leave Group--", new
                                    {
                                        @class = "form-control form-control-sm Lgroup",
                                        @onchange = "validate(this,'levGroup');" +
                                   "$('#LeaveGroup_Code').val($('.Lgroup').val());fillData()"
                               })
                                    <span id="levGroup"></span>
                                </div>


                            </div>
                            <div class="tab-items ml-5 pr-0 border-none select-option">
                                <div class="form-group filter-combobox mr-2" style="width: 200px;">

                                    @Html.DropDownListFor(m => m.Leave.Code, (SelectList)ViewBag.Leave, "--Leave--", new { @class = "form-control form-control-sm Ltype", @onchange = "validate(this,'lev');$('#Leave_Code').val($('.Ltype').val());fillData()" })
                                    <span id="lev"></span>
                                </div>
                            </div>

                            @*<button type="button" class="btn btn-default mobile-full-width" onclick="OnDeleteAllClick()">
            Delete All
        </button>*@





                            <div class="tab-items pr-0 border-none">

                            </div>





                            <div class="tab-items d-flex align-items-center highs mr-5 mb-2">
                                <div class="d-flex align-center pt-4">
                                    <a href="#" type="button" class="btn btn-default float-right mobile-full-width" onclick="OnDeleteAllClick()">
                                        Delete All
                                    </a>
                                </div>

                            </div>



                            <div class="tab-items select-option lows ">


                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>


                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>


                                <a data-bs-toggle="tooltip" title="Export to Excel"
                                   class="btn btn-excel mr-0" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>

                            </div>


                        </div>
                    </div>





                    @using (Html.BeginForm("", "", FormMethod.Post, new { @id = "openingDelete" }))
                    {
                       
                      
                        <div id="editLeaveOpening">
                            @await Html.PartialAsync("_DeleteList", Model)
                        </div>


                        <!-- Table Setion End -->
                        @*<div class="row card-footer-bottom-fixed">

                            <div class="col-md-12 align-right">

                                <a data-bs-toggle="tooltip" data-bs-original-title="Delete" class="btn btn-icon btn-delete big-btn float-none" onclick="Delete()">
                                    <i class="icon-xl far fa-trash-alt"></i>
                                </a>

                            </div>
                        </div>*@
                    }

                    <!--end: Datatable-->
                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
                    </div>
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
<!--end::Content-->
