@model Hrms.Lite.Shared.TimeOffice.LeaveEncashment
    <script src="~/js/tooltip.js"></script>

    <script>
        $(document).ready(function () {
            debugger;
            //$('#Name').focus();
            moveCursorToEnd('LeaveEncashmentEditDetils_EnCashment');
        });
        $(window).ready(function () {
            $(document).keypress(function (e) {
                if (e.which == 13) {
                    if (preventENterFlag == 0)
                        EmployeeWiseLeaveEncashModify();
                    return false;
                }
            });
        });
    </script>
    @using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "LeaveEncashEdit" }))
    {

        <div id="editleaveencash" class="slider-forms slider-forms-open EditLeaveEncashment">
            <div class="slider-inner-style">
                <div class="slider-form-close" onclick="CloseSlider('EditLeaveEncashment');preventENterFlag =1">
                    <i class="ki ki-close icon-xs text-muted"></i>
                </div>
                <h4>
                    Leave Encash
                </h4>
                <div class="profile-header position-relative pb-12 mb-5"
                     style="padding-bottom: 2px !important; padding-top: 5px !important;">
                    <div class="row">
                        @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeSliderHeader.cshtml", Model.EmployeeHeader)                  
                    </div>
                    <div class="profile-header-overflow"></div>
                </div>
                @Html.HiddenFor(m => m.EmployeeGI)
                <div class="row">

                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Leave
                                Period
                            </label>
                            <div class="view-details">
                                @Html.HiddenFor(m => m.LeaveEncashmentEditDetils.LeavePeriod.Code)
                                @Model.LeaveEncashmentEditDetils.LeavePeriod.Name
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Leave Group
                            </label>
                            <div class="view-details">
                                @Html.HiddenFor(m => m.LeaveEncashmentEditDetils.LeaveGroup.Code)
                                @Model.LeaveEncashmentEditDetils.LeaveGroup.Name
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Leave
                            </label>
                            <div class="view-details">
                                @Html.HiddenFor(m => m.LeaveEncashmentEditDetils.Leave.Code)
                                @Model.LeaveEncashmentEditDetils.Leave.Name
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Month

                            </label>
                            <div class="view-details">
                                @Html.HiddenFor(m => m.LeaveEncashmentEditDetils.Month.Code)
                                @Model.LeaveEncashmentEditDetils.Month.Name
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title"> Opening</label>
                            <div class="view-details">

                                @Html.DisplayFor(m => m.LeaveEncashmentEditDetils.Opening)


                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Credit
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(m => m.LeaveEncashmentEditDetils.Credit)

                            </div>
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Debit
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(m => m.LeaveEncashmentEditDetils.Debit)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title"> Taken</label>
                            <div class="view-details">
                                @Html.DisplayFor(m => m.LeaveEncashmentEditDetils.Taken)

                            </div>
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Carry
                                Forward
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(m => m.LeaveEncashmentEditDetils.CF)

                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Balance
                            </label>
                            <div class="view-details">
                                @Html.HiddenFor(m => m.LeaveEncashmentEditDetils.Balance)
                                @Html.DisplayFor(m => m.LeaveEncashmentEditDetils.Balance)

                            </div>
                        </div>
                    </div>

                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Encash Limit
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(m => m.LeaveEncashmentEditDetils.MaxLimit)

                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="row-outer">

                            <label class="view-title">
                                Encash
                            </label>
                            @Html.TextBoxFor(m => m.LeaveEncashmentEditDetils.EnCashment, new
                       {
                           @class = "form-control form-control-sm",
                           @placeholder = "Encash",
                           style = "width: 100%",
                           @onkeypress = "return onlyAmount(event)",
                           @maxlength = "3",
                           @onchange = "validate(this,'edit_encash_amount')"
                       })
                            <span id="edit_encash_amount"></span>
                        </div>

                    </div>

                </div>

                <div class="row ">
                    <div class="col-md-12">
                        <div class="row-outer">
                            <label class="view-title">Remarks</label>
                            @Html.TextAreaFor(m => m.LeaveEncashmentEditDetils.Remarks, new
                             {
                                 @class = "form-control form-control-sm",
                                 @placeholder = "Remarks",
                            style = "width: 100%",@maxlength="250"
                             })
                        </div>
                    </div>

                </div>








                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12 align-right">
                        <button type="button"
                                class="btn btn-default  mobile-full-width" onclick="EmployeeWiseLeaveEncashModify()">
                            Modify
                        </button>
                    </div>
                </div>

            </div>
        </div>
    }