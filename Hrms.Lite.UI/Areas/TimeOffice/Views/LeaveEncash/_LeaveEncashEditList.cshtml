@model Hrms.Lite.Shared.TimeOffice.LeaveEncashment

<script src="~/js/tooltip.js"></script>
<script>
    $(document).ready(function () {
        fillData();
    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table encashment-list-table ">
    @Html.HiddenFor(m => m.LeaveEncashmentList.Count)
    <table id="encash_editTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">Balance</th>
                <th scope="col" data-bs-toggle="tooltip" title="Encashment Max Limit">
                    Max Limit
                </th>
                <th scope="col">
                    Encash
                </th>
                <th scope="col">
                    Action
                </th>

            </tr>
        </thead>
        <tbody>
        </tbody>

    </table>
</div>
<div id="leaveEncashEdit"></div>