@model Hrms.Lite.Shared.TimeOffice.LeaveEncashment
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>

<script src="~/js/datatables.min.js"></script>

<script src="~/scripts/TimeOffice/LeaveEncash.js"></script>


<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Leave Encash</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Leave Encash
                    </li>

                </ul>
            </div>
        </div>
       
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
               
                    <!--begin: Search Form-->
                    @using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "encash_Index_form" }))
                    {

                        <div class="row tab-style-button">
                            <div class="tab-button-wrap">
                                <div class="tab-items ml-1 pr-0 border-none select-option">
                                    <div class="form-group filter-combobox mr-2" style="width: 150px;">
                                        @Html.DropDownListFor(m => m.LeavePeriod.Code, (SelectList)ViewBag.LeavePeriod, "--Select Leave Period--", 
                                       new { @class = "form-control form-control-sm Lperiod", @onchange = "validate(this,'levPeriod');$('#LeavePeriod_Code').val($('.Lperiod').val());onLeavePeriodChange(this,'levPeriod');fillData()" })
                                        <span id="levPeriod"></span>
                                    </div>


                                </div>
                                <div class="tab-items ml-1 pr-0 border-none select-option">
                                    <div class="form-group filter-combobox mr-2" style="width: 180px;">
                                        @Html.DropDownListFor(m => m.LeaveGroup.Code, (SelectList)ViewBag.LeaveGroup, "--Select Leave Group--",
                                       new { @class = "form-control form-control-sm LGroup", @onchange = "validate(this,'leavGroup');$('#LeaveGroup_Code').val($('.LGroup').val());" +
                                       "fillLeaveCombo(this);fillData()" })
                                        <span id="leavGroup"></span>
                                    </div>

                                </div>
                                <div class="tab-items ml-1 pr-0 border-none select-option">
                                    <div class="form-group filter-combobox mr-2" style="width: 180px;">
                                        @Html.DropDownListFor(m => m.Leave.Code, (SelectList)ViewBag.Leave, "--Select Leave--",
                                       new { @class = "form-control form-control-sm LType", @onchange = "validate(this,'leav');$('#Leave_Code').val($('.LType').val());fillData()" })
                                        <span id="leav"></span>
                                    </div>

                                </div>

                                <div class="tab-items ml-1 pr-0 border-none select-option">
                                    <div class="form-group filter-combobox mr-2" style="width: 180px;">
                                        @Html.DropDownListFor(m => m.Month.Code, (SelectList)ViewBag.Month, "--Select Month--", new { @class = "form-control form-control-sm LMonth", @onchange = "validate(this,'MonthID');$('#Month_Code').val($('.LMonth').val());fillData()" })
                                        <span id="MonthID"></span>
                                    </div>

                                </div>
                                <div class="tab-items ml-1 pr-0 border-none select-option">
                                    <div class="form-group filter-combobox mr-2" style="width: 220px;">

                                      
                                        @Html.DropDownListFor(Model=>Model.EntryType,
       new List<SelectListItem> {
            new SelectListItem {  Value= "1" , Text = "Create Encashment" },
            new SelectListItem { Value = "2" , Text = "Edit Encashment" },

         }, "--Select--",
       new { @class = "form-control form-control-sm LEntry", @onchange = "GetEncashHeading();validate(this,'entry_Type')" })


                                        <span id="entry_Type"></span>
                                    </div>
                                </div>








                                <div class="tab-items select-option ">


                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>
                                    <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>
                                    <a data-bs-toggle="tooltip" title="Export to Excel"
                                       class="btn btn-excel mr-0" onclick="ExportToExcel()">
                                        <i class="icon-xl far fa-file-excel"></i>
                                    </a>
                                    <button data-bs-toggle="tooltip" title="Import From Excel"
                                            class="btn btn-excel ml-0 import hide">
                                        <i class="fa fa-upload icon-xls" aria-hidden="true"></i>
                                    </button>




                                </div>


                            </div>
                        </div>
                    }

                    <div id="leaveEncashList">
                        @await Html.PartialAsync("_LeaveEncashCreateList")
                    </div>

                    <div class="row card-footer-bottom-fixed">
                        <div class="col-md-6">
                            <div class="d-flex responsive-center">
                                <a href="@Url.Action("History","LeaveEncash", new { Area="TimeOffice"})">
                                    <div class="application-btn d-flex align-items-center  pr-3 ">
                                        <div class="history-btn">
                                            <img src="/images/Icon awesome-history.png">

                                        </div>
                                        <div class="application-icon"> <h3 class="pt-2 pl-3">Transaction History </h3></div>
                                    </div>
                                </a>


                            </div>
                        </div>
                        <div class="col-md-6 align-right">
                            <a type="button"
                               class="btn btn-default mobile-full-width" onclick="BatchUpdate()">
                                Save
                            </a>
                        </div>


                    </div>

                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
