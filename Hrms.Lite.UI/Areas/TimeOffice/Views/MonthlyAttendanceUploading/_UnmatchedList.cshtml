@model Hrms.Lite.Shared.TimeOffice.MonthlyAttendanceUploading

<script src="~/js/settings.js"></script>
<h2 style="font-size: 16px; padding-top: 15px; ">Upload Failed<span>:Unmatched List</span></h2>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table budget-upload-list">
    <table id="BudgetUpload" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">Employee ID </th>
                <th scope="col"> Employee Name</th>
                <th scope="col">
                    Remarks
                </th>

            </tr>
        </thead>
        <tbody>
            @if (Model.MonthlyAttendanceUploading_Data != null && Model.MonthlyAttendanceUploading_Data.Count > 0)
            {

                for (int i = 0; i < Model.MonthlyAttendanceUploading_Data.Count; i++)
                {

                    <tr>
                        <td data-label="Location">@Model.MonthlyAttendanceUploading_Data[i].EmployeeID</td>
                        <td data-label="Region">@Model.MonthlyAttendanceUploading_Data[i].FullName</td>
                        <td data-label="Budgeted Nos">@Model.MonthlyAttendanceUploading_Data[i].Remarks</td>

                    </tr>
                }
            }
        </tbody>
    </table>
</div>
<!-- Table Setion End -->