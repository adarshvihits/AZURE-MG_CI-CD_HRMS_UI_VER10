@model Hrms.Lite.Shared.TimeOffice.DailyAttendanceEntry

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table vertical-scroll-450">
    <table id="procSummaryTable">
        <thead>
            <tr class="table-dark">
                <th scope="col">Attendance Status</th>
                <th scope="col">Count</th>

            </tr>
        </thead>
        <tbody>
            @if (Model.status != null && Model.status.Count > 0)
            {

                for (int i = 0; i < Model.status.Count; i++)
                {
                    <tr>
                        <td data-label="Type">@Model.status[i].Description</td>

                        <td data-label="Count">

                            <a href="@Url.Action("ProcessedIndex", "DailyAttendanceProcessing",new {Date=Model.ProcesingDate,AttendStatus=Model.status[i].Code, AttenStastusName=Model.status[i].Description})">
                                @Model.status[i].Count
                            </a>

                        </td>
                    </tr>
                }
            }
            else

            {
                <tr>
                    <td colspan="2">
                        <div style="text-align: center;display: flex;align-items: center;justify-content: center;height: 45 vh;"><img src="/images/nodata.png" /></div>
                    </td>

               </tr>

                    }



            </tbody>


    </table>

</div>