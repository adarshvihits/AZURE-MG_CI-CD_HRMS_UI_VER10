@model Hrms.Lite.Shared.TimeOffice.LOPSandwichUpdation
<script src="~/js/settings.js"></script>
<script src="~/js/tooltip.js"></script>

<div class="ihits-table table-border odd-even  mobile-responsive-table salary_advance_issuetrn">
    @Html.HiddenFor(m => m.LOPSandwichUpdationList.Count)
    <table id="LOPSandwichUpdationHistoryTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                @*<th scope="col">Designation </th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>*@
                <th scope="col">Date</th>
                <th scope="col">Status</th>
                <th scope="col">Previous Day status</th>
                <th scope="col">Next Day Status</th>

            </tr>
        </thead>
        <tbody>

            @if (Model.LOPSandwichUpdationList != null && Model.LOPSandwichUpdationList.Count > 0)
            {
                for (int i = 0; i < Model.LOPSandwichUpdationList.Count; i++)
                {
            <tr>
                <td data-label="ID">@Model.LOPSandwichUpdationList[i].ID</td>
                <td data-label="Employee Name">@Model.LOPSandwichUpdationList[i].EmployeeName</td>
                @*<td data-label="Designation">@Model.LOPSandwichUpdationList[i].Designation</td>
        <td data-label="Department">@Model.LOPSandwichUpdationList[i].Department </td>
        <td data-label="Location">@Model.LOPSandwichUpdationList[i].Location</td>*@
                <td data-label="Date"> @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.LOPSandwichUpdationList[i].Date))</td>
                <td data-label="Status">@Model.LOPSandwichUpdationList[i].Status</td>
                <td data-label="PrevDayStatus">@Model.LOPSandwichUpdationList[i].PrevDaystatus</td>
                <td data-label="NextDayStatus">@Model.LOPSandwichUpdationList[i].NextdatStatus</td>
            </tr>
                }
            }
        </tbody>
    </table>

</div>