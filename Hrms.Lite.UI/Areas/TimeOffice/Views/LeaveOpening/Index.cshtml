@model Hrms.Lite.Shared.TimeOffice.LeaveOpening
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>
<script src="~/scripts/TimeOffice/leaveOpening.js"></script>


<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Leave Opening</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Leave Opening
                    </li>

                </ul>
            </div>
        </div>

        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                    <div class="mobile-tab-section">
                        <div class="row mb-2">



                            <div class="col-6">
                                <div class="form-group">
                                    <label>Select Leave Period</label>
                                    @Html.DropDownListFor(m => m.LeavePeriod.Code, (SelectList)ViewBag.LeavePeriod, "--Leave Period--",
                                   new { @class = "form-control form-control-sm", @onchange = "validate(this,'MlevPeriod');$('.Lperiod').val($('#LeavePeriod_Code').val());GetOpeningHeading();" })
                                    <span id="MlevPeriod"></span>
                                </div>
                            </div>
                            <div class="col-6" id="assetFilter">
                                <div class="form-group">
                                    <label>Select Leave Group</label>
                                    @Html.DropDownListFor(m => m.LeaveGroup.Code, (SelectList)ViewBag.LeaveGroup, "--Leave Group--", new
                               {
                                   @class = "form-control form-control-sm",
                                   @onchange = "validate(this,'MlevGroup');" +
                                   "$('.Lgroup').val($('#LeaveGroup_Code').val());GetOpeningHeading();"
                               })
                                    <span id="MlevGroup"></span>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-group">
                                    <label>Select Leave</label>
                                    @Html.DropDownListFor(m => m.Leave.Code, (SelectList)ViewBag.Leave, "--Leave--", new
                                    {
                                        @class = "form-control form-control-sm",
                                   @onchange = "validate(this,'Mlev');$('.Ltype').val($('#Leave_Code').val());GetOpeningHeading();"
                               })
                                    <span id="Mlev"></span>
                                </div>
                            </div>
                          
                        </div>
                    </div>







                    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "LeaveOpeningUpload", enctype = "multipart/form-data" }))
                    {
                        <div class="row tab-style-button">
                            <div class="tab-button-wrap">
                                <div class="tab-items ml-5 pr-0 border-none select-option">
                                    <div class="form-group filter-combobox mr-2" style="width: 150px;">

                                        @Html.DropDownListFor(m => m.LeavePeriod.Code, (SelectList)ViewBag.LeavePeriod, "--Leave Period--", new
                                   {
                                       @class = "form-control form-control-sm Lperiod",
                                       @onchange = "validate(this,'levPeriod');$('#LeavePeriod_Code').val($('.Lperiod').val());GetOpeningHeading()"
                                   })
                                        <span id="levPeriod"></span>
                                    </div>
                                </div>
                                <div class="tab-items ml-5 pr-0 border-none select-option">
                                    <div class="form-group filter-combobox mr-2" style="width: 200px;">

                                        @Html.DropDownListFor(m => m.LeaveGroup.Code, (SelectList)ViewBag.LeaveGroup, "--Leave Group--", new
                                   {
                                       @class = "form-control form-control-sm Lgroup",
                                       @onchange = "validate(this,'levGroup');" +
                            "$('#LeaveGroup_Code').val($('.Lgroup').val());GetOpeningHeading()"
                                   })
                                        <span id="levGroup"></span>
                                    </div>


                                </div>
                                <div class="tab-items ml-5 pr-0 border-none select-option">
                                    <div class="form-group filter-combobox mr-2" style="width: 200px;">

                                        @Html.DropDownListFor(m => m.Leave.Code, (SelectList)ViewBag.Leave, "--Leave--",
                            new { @class = "form-control form-control-sm Ltype", @onchange = "validate(this,'lev');$('#Leave_Code').val($('.Ltype').val());GetOpeningHeading()" })
                                        <span id="lev"></span>
                                    </div>
                                </div>

                                <div class="tab-items ml-5 pr-0 border-none select-option">
                                    <div class="form-group filter-combobox mr-2" style="width: 200px;">

                                        @Html.DropDownListFor(m => m.EntryType, (SelectList)ViewBag.EntryType, "--Entry Type--", new
                                   {
                                       @class =
                            "form-control form-control-sm Lentrytype",
                                       @onchange = "validate(this,'entry_Type');$('#EntryType').val($('.Lentrytype').val());GetOpeningHeading()"
                                   })
                                        <span id="entry_Type"></span>
                                    </div>
                                </div>
                                <div class="tab-items pr-0 border-none">

                                </div>

                                <div id="batchUpdatePartial">


                                </div>
                                <!-- <batch updates></batch> -->







                                <div class="tab-items select-option">

                                    <div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
                                        <div class="modal-dialog modal-lg">
                                            <div class="modal-content popup">
                                                <div class="modal-header" style="padding:10px">
                                                    <h5 class="modal-title" id="exampleModalLabel">Upload Format</h5>
                                                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close" onclick="$('#Unmatchedlist').html('');$('#Excel_FileData').val()">
                                                        <i aria-hidden="true" class="ki ki-close"></i>
                                                    </button>
                                                </div>

                                                <div class="modal-body pt-3">
                                                    <div class="colums_list pb-1">
                                                        Please ensure your Excel file contains the following columns with the exact headings. Spelling and case must match precisely for a successful import -

                                                        Employee ID,
                                                        Employee Name,
                                                        Opening<br />
                                                        @*Columns Needed :- Employee ID, Employee Name, Opening*@
                                                    </div>
                                                    <div class="row">
                                                        <div class="col-md-4">
                                                            <div class="file-upload-form-group">
                                                                <label for="formFileMultiple" class="form-label">
                                                                    Attach
                                                                    File
                                                                    <span class="Mandatory">*</span>
                                                                </label>

                                                                <div class="file-upload-form mb-1" data-bs-toggle="tooltip" data-bs-original-title=" Only pdf, doc, docx files are
                                            allowed , File size less than 1 MB.">
                                                                    <div class="small-btn-group">

                                                                        <button type="button" data-bs-toggle="tooltip" data-placement="top" data-bs-original-title="View Image" class="btn btn-icon btn-default"><i class="icon-xl far fa-eye"></i></button>

                                                                    </div>
                                                                    <input id="File_AbsoluteUri" name="File.AbsoluteUri" type="hidden" value="">
                                                                    @*<input accept=".png, .jpg, .jpeg, .pdf" id="File_FileData" name="File.FileData" onchange="CheckImageExtensionSize(this)" title="" type="file">*@
                                                                    @Html.HiddenFor(model => model.Excel.FileData, new { type = "file", @class = "input-file PreviewImage form-control h-100", @onchange = "onImportExcelClick()" })
                                                                </div>


                                                            </div>


                                                        </div>

                                                    </div>

                                                    <div id="Unmatchedlist">

                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>


                                    <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>


                                    <a data-bs-toggle="tooltip" title="Export to Excel"
                                       class="btn btn-excel mr-0" onclick="ExportToExcel()">
                                        <i class="icon-xl far fa-file-excel"></i>
                                    </a>
                                    <a id="importbtn" data-bs-toggle="tooltip" title="Import From Excel" onclick="validateLeaveOpeningDropdowns()"
                                            class="btn btn-excel ml-0 import">
                                        <i class="fa fa-upload icon-xls" aria-hidden="true"></i>
                                    </a>
                                </div>


                            </div>
                        </div>
                    }
                        <div id="editLeaveOpening"></div>

                        <!-- Table Section -->
                        <div id="leaveOpeningList">
                            @await Html.PartialAsync("_LeaveOpCreateList")
                        </div>
                        <!-- Table Setion End -->
                        <div class="row card-footer-bottom-fixed">
                            <div class="col-md-6">
                                <div class="d-flex responsive-center">
                                    <a href="@Url.Action("History","LeaveOpening", new { Area="TimeOffice"})">
                                        <div class="application-btn d-flex align-items-center  pr-3 ">
                                            <div class="history-btn">
                                                <img src="/images/Icon awesome-history.png">

                                            </div>
                                            <div class="application-icon"> <h3 class="pt-2 pl-3">Transaction History </h3></div>
                                        </div>
                                    </a>


                                </div>
                            </div>

                            <div class="col-md-6 align-right batchleave">
                                <a type="button"
                                   class="btn btn-default mobile-full-width" onclick="onBatchUpdateClick()">
                                    Save All
                                </a>
                            </div>

                        </div>


                        <!--end: Datatable-->
                        <div id="filterSlider">
                            @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
                        </div>
                    </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
<!--end::Content-->
