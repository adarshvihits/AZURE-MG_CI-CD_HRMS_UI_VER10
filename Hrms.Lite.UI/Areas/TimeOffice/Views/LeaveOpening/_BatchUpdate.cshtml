@model Hrms.Lite.Shared.TimeOffice.LeaveOpening
    <script>
        $(document).ready(function () {
            debugger;
            //$('#Name').focus();
            moveCursorToEnd('LeaveOpeningBatchUpDate_Opening');

        });
    </script>
    @using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "BatchUpdate1" }))
    {
        <div  class="slider-forms slider-forms-open batchUpdateSlider">
            <div class="slider-inner-style">
                <div class="slider-form-close" onclick="CloseSlider('batchUpdateSlider')">
                    <i class="ki ki-close icon-xs text-muted"></i>
                </div>
                <h4>
                   Leave Opening
                </h4>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Leave Period</label>
                            <div class="view-details">
                                @Html.HiddenFor(m => m.LeaveOpeningBatchUpDate.LeavePeriod.Code)
                                @Html.HiddenFor(m => m.EmployeeGI)
                                @Model.LeaveOpeningBatchUpDate.LeavePeriod.Name
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Leave Group</label>
                            <div class="view-details">
                                @Html.HiddenFor(m => m.LeaveOpeningBatchUpDate.LeaveGroup.Code)
                                @Model.LeaveOpeningBatchUpDate.LeaveGroup.Name
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Leave </label>
                            <div class="view-details">
                                @Html.HiddenFor(m => m.LeaveOpeningBatchUpDate.Leave.Code)
                                @Model.LeaveOpeningBatchUpDate.Leave.Name
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>Opening</label><span class="Mandatory">*</span>
                         
                            @Html.TextBoxFor(m => m.LeaveOpeningBatchUpDate.Opening, new { @class = "form-control form-control-sm", @placeholder = "Opening", style = "width: 100%" ,@onblur="validate(this,'btchOpening')", @onkeypress = "return onlyNumberKey(event)" })
                            <span id="btchOpening"></span>
                        </div>
                    </div>
                </div>
                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">
                        <button type="button"
                                class="btn btn-default  mobile-full-width" onclick="LeaveOpeningSave()">
                            Update
                        </button>
                    </div>

                </div>
            </div>
        </div>
    }