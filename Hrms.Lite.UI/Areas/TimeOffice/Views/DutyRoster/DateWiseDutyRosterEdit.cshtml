@model Hrms.Lite.Shared.TimeOffice.DutyRoster
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/scripts/TimeOffice/dutyRoster.js"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>

<script>


    function POPUP() {

        debugger;
        $.ajax({
            type: 'GET',
            url: '/TimeOffice/DutyRoster/GetShiftDetailsPOPUP',
            dataType: 'html',

            success: function (Data) {
                var m = $('#dutyRostershiftPopUP');
                m.find('.modal-body').html('');
                m.find('.modal-body').html(Data);
                m.modal('show');
            },
            error: function (xhr, textStatus, errorThrown) {
                swal.fire(xhr.responseText);

            }
        });
    }


</script>

<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Duty Roster</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home" , new {Area="" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        <a href="@Url.Action("DutyRoster", "DutyRoster", new { Area = "TimeOffice",Month=Model.Month.Code,PayrollGroup=Model.PayrollGroup.Code,CIRCLE=Model.Circle.Code})">Duty Roster List</a>

                    </li>
                    <li class="breadcrumb-item text-muted">
                        Duty Roster
                    </li>

                </ul>
            </div>
        </div>

        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid " id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->


            <div class="row height-100per">
                <div class="col-md-12">
                    <div class="card card-custom height-100per footer-row-fixed">

                        <div class="card-body">

                            <div class="mobile-tab-section">
                                <div class="row mb-2">
                                    <div class="col-6">
                                        <div class="form-group">
                                            <div class="tab-items px-5">
                                                <div class="row-outer">
                                                    <label class="view-title">Selected Date</label>
                                                    <div class="view-details">
                                                        @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.SelectedDate))
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6" id="assetFilter">
                                        <div class="form-group">
                                            <div class="row-outer">
                                                <label class="view-title">Month</label>
                                                <div class="view-details">
                                                    @Model.Month.Name
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6" id="assetFilter">
                                        <div class="form-group">
                                            <div class="tab-items px-5">
                                                <div class="row-outer">
                                                    <label class="view-title">Circle</label>
                                                    <div class="view-details">
                                                        @Model.Circle.Name
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-6" id="assetFilter">
                                        <div class="form-group">
                                            <div class="row-outer">
                                                <label class="view-title">Payroll Group</label>
                                                <div class="view-details">
                                                    @Model.PayrollGroup.Name
                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                    <div class="col-6 d-flex align-items-center">
                                        <div class="tab-items px-5">
                                            <div class="button-group float-left ">
                                                <button type="button" class="btn btn-default btn-sm" onclick="ondutyDateWiseBatchUpdateClick('@Model.SelectedDate',@Model.Month.Code,@Model.PayrollGroup.Code,@Model.Circle.Code)">
                                                    Batch Update
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>


                            <!--begin: Search Form-->
                            <div class="row tab-style-button">
                                <div class="tab-button-wrap">
                                    <div class="tab-items px-5">
                                        <div class="row-outer">
                                            <label class="view-title">Selected Date</label>
                                            <div class="view-details">
                                                @Html.HiddenFor(m => Model.SelectedDate)
                                                @Html.HiddenFor(m => Model.Month.Code)
                                                @Html.HiddenFor(m => Model.PayrollGroup.Code)
                                                @Html.HiddenFor(m => Model.Circle.Code)
                                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.SelectedDate))
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tab-items px-5">
                                        <div class="row-outer">
                                            <label class="view-title">Month</label>
                                            <div class="view-details">
                                                @Model.Month.Name
                                            </div>
                                        </div>
                                    </div>




                                    <div class="tab-items px-5">
                                        <div class="row-outer">
                                            <label class="view-title">Circle</label>
                                            <div class="view-details">
                                                @Model.Circle.Name
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tab-items border-none">
                                        <div class="row-outer">
                                            <label class="view-title">Payroll Group</label>
                                            <div class="view-details">
                                                @Model.PayrollGroup.Name
                                            </div>
                                        </div>
                                    </div>




                                    <div class="tab-items select-option">



                                        <div class="button-group float-left mr-5">

                                            <button type="button" class="btn btn-default btn-sm" onclick="ondutyDateWiseBatchUpdateClick('@Model.SelectedDate',@Model.Month.Code,@Model.PayrollGroup.Code,@Model.Circle.Code)">
                                                Batch Update
                                            </button>


                                        </div>
                                        <div class="sraech-slider">
                                            <div class="search-slider-inner">
                                                <i class="fa fa-search"></i>
                                            </div>
                                            <input type="text" id="dataTableSearch" class="form-control form-control-sm" placeholder="ID/Name">
                                        </div>

                                        <a data-bs-toggle="tooltip" title="Export to Excel" class="btn btn-excel" onclick="onDateWiseExportClick()">
                                            <i class="icon-xl far fa-file-excel"></i>
                                        </a>
                                        <!-- <button data-bs-toggle="tooltip" title="Download Excel" type="button" class="btn btn-sm btn-excel ml-2">
                                            <i class="icon-xl fas fa-download"></i>
                                        </button> -->

                                        <div class="filter-button" data-bs-toggle="tooltip" title="Filter" id="filterForm" onclick="onFilterClick('innerList')">
                                            <i class="fas fa-filter"></i>
                                            <i class="fas fa-check"></i>
                                        </div>

                                    </div>


                                </div>
                            </div>

                            <div id="dutyDateFilter">
                            </div>

                            <!-- Table Section -->
                            <div id="dateWiseDutyList">
                                @await Html.PartialAsync("_DateWiseDutyRosterList", Model)
                            </div>

                            <div id="dateWiseDutyBatch">

                            </div>


                            <!-- Table Setion End -->

                            <div class="row card-footer-bottom-fixed">

                                <div class="col-md-12">


                                    <!-- Large modal -->
                                    <button type="button" class="btn btn-group btn-default btn-sm" data-bs-toggle="modal" data-target="#dutyRostershiftPopUP" onclick="POPUP()"> Shift Details</button>

                                    @*<div class="modal fade bd-example-modal-lg" tabindex="-1" aria-labelledby="myLargeModalLabel" style="display: none;" aria-hidden="true">*@



                                </div>


                            </div>

                            <!--end: Datatable-->
                        </div>
                    </div>
                </div>

            </div>



            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>


<div class="modal fade bd-example-modal-lg" id="dutyRostershiftPopUP" tabindex="-1" aria-labelledby="myLargeModalLabel" style="display: none;" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content popup">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Shift Details</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body">

            </div>


        </div>
    </div>
</div>