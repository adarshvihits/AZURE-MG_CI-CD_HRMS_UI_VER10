@model Hrms.Lite.Shared.TimeOffice.MonthlyAttendanceProcessing

<script src="~/js/custom.js"></script>
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "Individual_AttendanceProcessing" }))
{
    

  

                <div class="row">
                    <div class="col-md-12">
                        <h4 class="pending-tk">
                            Pending Task
                        </h4>
                        @Html.HiddenFor(m => m.Month.Code)
                        @Html.HiddenFor(m => m.Employee.Code)
                        @Html.HiddenFor(m =>m.Employee.GI)
                        @Html.HiddenFor(m => m.MonthlyAttendanceProcessing_Validations.Count)
                        @Html.HiddenFor(m => m.Validation_Msg.FLAG)
                        @Html.HiddenFor(m => m.Validation_Msg.Description)

                        <div class="pending-task-list">
                            <ul>

                                @if (Model.MonthlyAttendanceProcessing_Validations != null && Model.MonthlyAttendanceProcessing_Validations.Count > 0)
                                {

                                    for (int i = 0; i < Model.MonthlyAttendanceProcessing_Validations.Count; i++)
                                    {
                                        <li>
                                            @Model.MonthlyAttendanceProcessing_Validations[i].Description
                                        </li>
                                    }
                                }

                            </ul>
                        </div>

                        <div class="row pt-10">
                            <div class="col-md-12">
                                <div class=" mt-4  d-flex justify-content-end">

                                    <button type="button" class="btn searchProfileSliderClose search-btn-cancel mr-2 " data-bs-dismiss="modal"
                                            aria-label="Close">
                                        Cancel
                                    </button>
                                    <a type="button" class="btn btn-default " onclick="onOkClick(@Model.Month.Code,@Model.Employee.Code,'@Model.Employee.GI')">
                                        OK
                                    </a>
                                </div>

                            </div>


                        </div>

                    </div>
                </div>


}