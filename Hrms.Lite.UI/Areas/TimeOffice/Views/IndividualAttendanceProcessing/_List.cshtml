@model Hrms.Lite.Shared.TimeOffice.MonthlyAttendanceProcessing

<div class="profile-header mb-3 hide individual_Attendance_Process_EmpHeader ">
    @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeHeader.cshtml",Model.EmployeeHeader)
    <div class="profile-header-overflow"></div>
</div>



<div class="row">
    <div class="col-md-3">
        <div class="form-group d-flex">
            <label>
                Processed Month :
            </label>
            <div class="pl-2"><span id="monthSpan"></span></div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group d-flex">
            <label>
                Processing Status :
            </label>
            <div class="pl-2"><span id="processingResponse"></span></div>
        </div>
    </div>
</div>
<div class="ihits-table table-border  mobile-responsive-table indivigual-attendance-processing">
    <table>
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">PR</th>
                <th scope="col">RA</th>
                <th scope="col">AB</th>
                <th scope="col">LOP</th>
                <th scope="col">ESI.Lev</th>
                <th scope="col">Leave</th>
                <th scope="col">COF</th>
                <th scope="col">OD</th>
                <th scope="col">WFH</th>
                <th scope="col">HD</th>
                <th scope="col">Hd.Pr</th>
                <th scope="col">WO</th>
                <th scope="col">OP</th>
                <th scope="col">LJP</th>
                <th scope="col">LTP</th>
                <th scope="col">Prv.Lop</th>
                <th scope="col">Prv.Arr</th>
                <th scope="col">SUS</th>
                <th scope="col">Tot.Lop</th>
                <th scope="col">Paid days</th>

            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.MonthlyAttendanceProcessing_Data != null && Model.MonthlyAttendanceProcessing_Data.Count > 0)
            {

                for (int i = 0; i < Model.MonthlyAttendanceProcessing_Data.Count; i++)
                {
            <tr>

                <td data-label="ID">@Model.MonthlyAttendanceProcessing_Data[i].EmployeeID</td>
                <td data-label="Employee Name">@Model.MonthlyAttendanceProcessing_Data[i].FullName</td>
                <td data-label="PR">@Model.MonthlyAttendanceProcessing_Data[i].PresentDays</td>
                <td data-label="RA">
                    @Model.MonthlyAttendanceProcessing_Data[i].Ra

                </td>
                <td data-label="AB">@Model.MonthlyAttendanceProcessing_Data[i].Absent</td>
                <td data-label="LOP">@Model.MonthlyAttendanceProcessing_Data[i].Lop</td>
                <td data-label="ESI.Lev">@Model.MonthlyAttendanceProcessing_Data[i].ESILeave</td>
                <td data-label="Leave">@Model.MonthlyAttendanceProcessing_Data[i].Leave</td>
                <td data-label="C.Off">@Model.MonthlyAttendanceProcessing_Data[i].Coff</td>
                <td data-label="OD">@Model.MonthlyAttendanceProcessing_Data[i].OnDuty</td>
                <td data-label="WFH">@Model.MonthlyAttendanceProcessing_Data[i].Wfh</td>
                <td data-label="HD">@Model.MonthlyAttendanceProcessing_Data[i].HoliDay</td>
                <td data-label="HD">@Model.MonthlyAttendanceProcessing_Data[i].HolidayPresent</td>                
                <td data-label="WO">@Model.MonthlyAttendanceProcessing_Data[i].OffDay</td>
                <td data-label="ODPR">@Model.MonthlyAttendanceProcessing_Data[i].OffdayPresent</td>
                <td data-label="LJP">@Model.MonthlyAttendanceProcessing_Data[i].Ljp</td>
                <td data-label="LTP">@Model.MonthlyAttendanceProcessing_Data[i].Ltp</td>
                <td data-label="Prv.Lop">@Model.MonthlyAttendanceProcessing_Data[i].PreviousLOP</td>
                <td data-label="Prv.Arr">@Model.MonthlyAttendanceProcessing_Data[i].PreviousArrear</td>
                <td data-label="SUS">@Model.MonthlyAttendanceProcessing_Data[i].Suspension</td>
                <td data-label="Tot.Lop">@Model.MonthlyAttendanceProcessing_Data[i].TotalLOP</td>
                <td data-label="Paid days">@Model.MonthlyAttendanceProcessing_Data[i].PaidDays</td>


            </tr>

                }
            }
        </tbody>
    </table>
</div>
