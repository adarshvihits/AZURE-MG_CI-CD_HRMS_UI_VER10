                    </div>
                      


                    <div class="row card-footer-bottom-fixed">
                        <div class="col-md-6">
                            <div class="d-flex responsive-center">
                                <a href="@Url.Action("History","LeaveCarryForward", new { Area="TimeOffice"})">
