                    <!--begin: Search Form-->
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items ml-1 pr-0 border-none select-option">
                                <div class="form-group filter-combobox mr-2" style="width:140px;">

                                    @Html.DropDownListFor(Model => Model.LeaveGroup.Code, (SelectList)ViewBag.LeaveGroup, "--Leave Group--",
                                   new { @class = "form-control form-control-sm leavegroup", @onchange = "fillLeaveCombo(this);GetCarryForwardHeading();validate(this,'levGroup')" })
                                    <span id="levGroup"></span>
                                </div>
                            </div>
                            <div class="tab-items ml-1 pr-0 border-none select-option">
                                <div class="form-group filter-combobox mr-2" style="width: 140px;">

                                    @Html.DropDownListFor(m => m.Leave.Code, (SelectList)ViewBag.Leave, "--Leave--",
                                   new { @class = "form-control form-control-sm leavetype", @onchange = "GetCarryForwardHeading();validate(this,'lev')" })
                                    <span id="lev"></span>
                                </div>
                            </div>
                            <div class="tab-items ml-1 pr-0 border-none select-option">
                                <div class="form-group filter-combobox mr-2" style="width: 150px;">

                                    @Html.DropDownListFor(m => m.LeavePeriodFrom.Code, (SelectList)ViewBag.LeavePeriodFrom, "--Leave Period From--", new
                               { @class = "form-control form-control-sm from", @onchange = "validate(this,'levPeriodFrom');fillToDropdown(this);" })
                                    <span id="levPeriodFrom"></span>
                                </div>
                            </div>
                            <div class="tab-items ml-1 pr-0 border-none select-option">
                                <div class="form-group filter-combobox mr-2" style="width: 140px;">
                                    @Html.HiddenFor(m => m.LeavePeriodTo.Code)
                                    @Html.HiddenFor(m => m.LeavePeriodTo.Name)
                                    @Html.DropDownListFor(m => m.LeavePeriodTo.ShortName, (SelectList)ViewBag.LeavePeriodTo, "--Leave Period To--", new
                               { @class = "form-control form-control-sm to", @disabled = "true" })
                                    <span id="levPeriodTo"></span>
                                </div>
                            </div>
                            <div class="tab-items ml-1 pr-0 border-none select-option">
                                <div class="form-group filter-combobox mr-2" style="width: 150px;">

                                    @Html.DropDownListFor(m => m.Month.Code, (SelectList)ViewBag.Month, "--Leave Month--", new
                               { @class = "form-control form-control-sm month", @onchange = "GetCarryForwardHeading();validate(this,'month')" })
                                    <span id="month"></span>
                                </div>
                            </div>

                            <div class="tab-items ml-1 pr-0 border-none select-option">
                                <div class="form-group filter-combobox mr-2" style="width: 220px;">

                                    @Html.DropDownListFor(m => m.EntryType, (SelectList)ViewBag.EntryType, "--Entry Type--", new
                               { @class = "form-control form-control-sm LEntry", @onchange = "GetCarryForwardHeading();validate(this,'entry_Type')" })
                                    <span id="entry_Type"></span>
                                </div>
                            </div>

                            <!-- <batch updates></batch> -->
                           

