@model Hrms.Lite.Shared.TimeOffice.ManualReaderIntegration
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*<script src="~/scripts/Custom/ERPIntegration.js"></script>*@
<script src="~/scripts/TimeOffice/ManualReaderIntegration.js"></script>

<style>
    .downloadbtnnewww {
        display: flex;
        background-color: #fff;
        width:400px;
        justify-content: flex-end;
        align-items: center;
        padding: 16px 10px;
        border-radius: 10px;
    }

   

    .btn-neww {
        font-size: 25px;
        font-weight: 700;
        padding-right:24px;
        color: #598ae2;
    }

    .btn-full-cls {
        align-items: center;
        justify-content: center;
        display: flex;
        padding-top: 62px;
        margin-right: 40px;
    }

    .fa-download:before {
        content: "\f019" !important;
        font-size: 30px !important;
        margin-right: 6px !important;
        color: #598ae2;
    }
</style>




<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                   Attendance Data Download
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Attendance Data Download
                    </li>

                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>


<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->


            <div class="row bck-grund-img">

                <div class="col-md-6 " style="padding: 100px 50px;">

                    <h2  class="pt-48" style=" line-height:1.8; color:white; ">When you click "Sync attendance data," the punching data from the attendance database will sync with the HRMS. Please note that only data up to the time of clicking "Sync attendance data" will be synced.</h2>


                    <div class="btn-full-cls  cursor-pointer">
                        <div class="downloadbtnnewww" onclick="Download()" >
                            <div class="btn-neww">Sync Attendance Data</div><i class="fa fa-download" aria-hidden="true"></i>
                        </div>

                    </div>

                </div>


                <div class="col-md-6 d-flex justify-content-center">


                    <img class="img-fluid w-80 " src="~/images/icons/downloadd-bck.svg" />




                </div>





            </div>

            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>
