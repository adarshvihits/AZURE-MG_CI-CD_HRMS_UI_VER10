@{
   
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@model Hrms.Lite.Shared.TimeOffice.DailyAttendanceEntry


<script src="~/js/jquery.min.js"></script>
<script src="~/scripts/TimeOffice/advancedEmpWiseAttendanceEntry.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>
<script>
    $(document).ready(function () {
        debugger;
        fillEmplist();
    });

</script>
<style>
    .card.card-custom > .card-body {
        padding: 18px 30px 40px 20px !important;
    }
</style>


<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Advanced Employee Wise Attendance</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new {Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        <a  onclick="breadscrumb()">
                        Advanced Employee Wise Attendance List</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Advanced  Employee Wise Attendance
                    </li>

                </ul>
            </div>
        </div>

        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid " id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">
               
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 d-flex justify-content-end">
                            <div class="tab-items select-option">
                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                </div>
                            </div>

                        <div class="col-lg-12 col-xl-5">

                            <div class="form-group filter-combobox mr-4 float-left" style="width: 150px;">
                                @Html.DropDownListFor(m => Model.PayrollGroup.Code, (SelectList)ViewBag.PGroup, "--Select Payroll Group--", new { @class = "form-control form-control-sm", @onchange = "fillMonthInnerList(this);" })
                                <span id="pgroup"></span>
                            </div>
                            <div class="tab-items border-none">
                                <div class="form-group filter-combobox mr-4 float-left" style="width: 150px;">
                                    @Html.DropDownListFor(m => Model.Month.Code, (SelectList)ViewBag.Month, "--Select Month--", new { @class = "form-control form-control-sm RMonth", @onchange = "fillEmplist()" })
                                    <span id="EmployeeWiseAttendanceMonth"></span>
                                </div>

                            </div>
                            <span class="advanced-emp-name" style="float: left; padding-right: 20px; padding-top: 10px; font-weight: 700;">
                            @Model.EmployeeHeader.EmployeeName</span>
                     

                        </div>


                            <div class="col-md-4 d-flex justify-content-center">
                                <div class="checkbox-inline float-left mt-2 mr-4">
                                    <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">

                                        @Html.CheckBoxFor(m => m.ShowAbsentDays, new { @class = "absentDays", @onchange = "onAbsentDaysCheckboxChange(this,'" + Model.EmployeeGI + "')" })
                                        <span></span>Show Absent Days only
                                    </label>
                                </div>


                                <div class="button-group float-left mr-0">

                                    <button type="button" class="btn btn-default btn-sm" onclick="onEmpWiseBatchUpdateClick('@Model.EmployeeGI', '@Model.Employee_DailyAttendanceEditDetails[0].Date.ToString("yyyy-MM-dd")','@Model.PayrollGroup.Name')">
                                        Batch Update
                                    </button>
                                </div>


                                <a data-bs-toggle="tooltip" title="Export to Excel" class="btn btn-excel" onclick="ExportToExcel_EmployeeAttendanceEDitList('@Model.EmployeeGI')">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>
                            </div>


                        </div>
                    <div class="row ">

                        <div class="col-lg-12 col-xl-3 ">
                            <div class="ihits-table table-border  mobile-responsive-table">
                                @Html.HiddenFor(m => m.EmployeeWiseAttendanceList.Count)
                                <table id="eaEntry_Emp_table">
                                    <thead>
                                        <tr class="table-dark">
                                            <th scope="col">ID</th>
                                            <th scope="col">Employee Name</th>

                                        </tr>
                                    </thead>

                                </table>
                            </div>

                        </div>


                            <div class="col-lg-12 col-xl-7 ">
                                <!--begin: Search Form-->
                                 @Html.HiddenFor(m => m.EmployeeHeader.EmployeeGuid)
                                <div id="eaEntry_Edit_List_Partial">                                  
                                    @await Html.PartialAsync("_EmployeeWiseAttendanceEditList", Model)
                                </div>


                                <div id="eaEntry_Edit_Slider">

                                </div>


                                <div id="eaEntry_BatchUpdateSlider">

                                </div>

                                <!--end: Datatable-->
                            </div>

                            <div class="col-lg-12 col-xl-2">
                                <div class="row middle_class  ad-summary">
                                    <div class="col-xl-12 col-lg-4">

                                        <div class="right-card">
                                            <div class=" card-custom mb-5">

                                            


                                                    <h5>Attendance Summary</h5>
                                                    <div class="ihits-table table-border vertical-scroll-100  mobile-responsive-table employee-wise-attendance-entry-two-col">
                                                        <table>
                                                            <thead>
                                                                <tr class="table-light">
                                                                    <th scope="col">Status</th>
                                                                    <th scope="col">Count</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>

                                                                @if (Model.AttendanceSummary != null && Model.AttendanceSummary.Count > 0)
                                                                {
                                                                    for (int i = 0; i < Model.AttendanceSummary.Count; i++)
                                                                    {
                                                                        <tr>
                                                                            <td data-label="Status">@Model.AttendanceSummary[i].Status</td>
                                                                            <td data-label="Count">@Model.AttendanceSummary[i].Count</td>

                                                                        </tr>
                                                                    }
                                                                }
                                                                else
                                                                {
                                                                    <tr><td colspan="2"> no data found</td></tr>
                                                                }




                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    <!-- Table Setion End -->
                                                    <!--end: Datatable-->
                                              
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xl-12 col-lg-4">


                                        <div class="right-card">
                                            <div class=" card-custom mb-5">
                                             
                                                    <h5>Leave Balance</h5>
                                                    <div class="ihits-table table-border vertical-scroll-100  mobile-responsive-table employee-wise-attendance-entry-two-col">
                                                        <table>
                                                            <thead>
                                                                <tr class="table-light">
                                                                    <th scope="col">Leave</th>
                                                                    <th scope="col">Balance</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @if (Model.LeaveBalance != null && Model.LeaveBalance.Count > 0)
                                                                {
                                                                    for (int i = 0; i < Model.LeaveBalance.Count; i++)
                                                                    {
                                                                        <tr>
                                                                            <td data-label="Leave">@Model.LeaveBalance[i].Leave</td>
                                                                            <td data-label="Balance">@Model.LeaveBalance[i].Balance</td>
                                                                        </tr>
                                                                    }
                                                                }
                                                                else
                                                                {

                                                                    <tr>
                                                                        <td colspan="2">No data</td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    <!-- Table Setion End -->
                                                    <!--end: Datatable-->
                                               
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-xl-12 col-lg-4">


                                        <div class="right-card">
                                            <div class=" card-custom">

                                             


                                                    <h5>Coff Details</h5>
                                                    <div class="ihits-table table-border vertical-scroll-100  mobile-responsive-table employee-wise-attendance-entry-two-col">
                                                        <table>
                                                            <thead>
                                                                <tr class="table-light">
                                                                    <th scope="col">E.Date</th>
                                                                    <th scope="col">Expire On</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>

                                                                @if (Model.CoffDetails != null && Model.CoffDetails.Count > 0)
                                                                {
                                                                    for (int i = 0; i < Model.CoffDetails.Count; i++)
                                                                    {
                                                                        <tr>
                                                                            <td data-label="E.Date">
                                                                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.CoffDetails[i].EDate))
                                                                            </td>
                                                                            <td data-label="Expire On">
                                                                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.CoffDetails[i].ExpireOn))

                                                                            </td>
                                                                        </tr>
                                                                    }
                                                                }
                                                                else
                                                                {

                                                                    <tr>
                                                                        <td colspan="2">No data</td>
                                                                    </tr>
                                                                }




                                                            </tbody>
                                                        </table>
                                                 
                                                    <!-- Table Setion End -->
                                                    <!--end: Datatable-->
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                  
            </div>

            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->




</div>