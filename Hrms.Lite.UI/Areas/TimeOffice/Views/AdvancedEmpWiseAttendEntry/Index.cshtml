@model Hrms.Lite.Shared.TimeOffice.DailyAttendanceEntry
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/scripts/TimeOffice/advancedEmpWiseAttendanceEntry.js"></script>
<script src="~/js/jquery.min.js"></script>

<script src="~/js/datatables.min.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        fillData();
    });

</script>
   
 <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->


            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Advanced Employee Wise Attendance Entry</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })" class=""><i class="icon-nm fas fa-home"></i></a>
                        </li>
                        <li class="breadcrumb-item text-muted">
                            Advanced Employee Wise Attendance Entry
                        </li>

                    </ul>
                </div>
            </div>
            <div class="topbar">

                <!--begin::User-->
             
                <!--end::User-->
            </div>
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body">
                       
                        <div class="row tab-style-button">
                            <div class="tab-button-wrap">
                                <div class="tab-items border-none">
                                    <div class="form-group filter-combobox mr-4 float-left" style="width: 150px;">
                                        @Html.DropDownListFor(m => Model.PayrollGroup.Code, (SelectList)ViewBag.PGroup, "--Select Payroll Group--", new { @class = "form-control form-control-sm", @onchange ="fillMonth(this);"})
                                        <span id="pgroup"></span>
                                    </div>

                                </div>
                                <div class="tab-items border-none">
                                    <div class="form-group filter-combobox mr-4 float-left" style="width: 150px;">
                                        @Html.DropDownListFor(m => Model.Month.Code, (SelectList)ViewBag.Month, "--Select Month--", new { @class = "form-control form-control-sm RMonth", @onchange = "fillData()" @*@onchange = "validate(this,'EmployeeWiseAttendanceMonth');onProceedClick(this)"*@})
                                        <span id="EmployeeWiseAttendanceMonth"></span>
                                    </div>

                                </div>
                                <div class="tab-items select-option">
                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>

                                    <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>
                                    <a data-bs-toggle="tooltip" title="Export to Excel"
                                       class="btn btn-excel">
                                        <i class="icon-xl far fa-file-excel" onclick="ExportToExcel_EmployeeAttendanceList()"></i>
                                    </a>
                                </div>


                            </div>
                        </div>

                        <div id="eaEntry_List_Partial">
                        
                                @await Html.PartialAsync("_EmployeeWiseAttendanceList", Model)
                        </div>

                        <div id="filterSlider">
                            @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
                        </div>

                        <!--end: Datatable-->
                    </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>
    <!--end::Content-->






