@model Hrms.Lite.Shared.TimeOffice.DailyAttendanceEntry
        <div class="ihits-table table-border  mobile-responsive-table">
    @Html.HiddenFor(m => m.EmployeeWiseAttendanceList.Count)
    <table id="eaEntry_Summary_table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th data-bs-toggle="tooltip" title="Absent" scope="col">AB</th>
                <th scope="col">Leave</th>
                <th data-bs-toggle="tooltip" title="Loss of Pay" scope="col">LOP</th>
                <th data-bs-toggle="tooltip" title="Week Off" scope="col">WO</th>
                <th data-bs-toggle="tooltip" title="Holiday" scope="col">HD</th>
                <th data-bs-toggle="tooltip" title="Offday Present" scope="col">OP</th>
                <th data-bs-toggle="tooltip" title="Holiday Present" scope="col">HP</th>
                <th data-bs-toggle="tooltip" title="Coff" scope="col">CO</th>
                <th data-bs-toggle="tooltip" title="Present" scope="col">PR</th>
                <th data-bs-toggle="tooltip" title="On Duty" scope="col">OD</th>
                <th data-bs-toggle="tooltip" title="Regularise Attendance" scope="col">RA</th>
                <th data-bs-toggle="tooltip" title="Work From Home" scope="col">WFH</th>
                <th data-bs-toggle="tooltip" title="Late Joining Period" scope="col">LJP</th>
                <th data-bs-toggle="tooltip" title="Late Termination Period" scope="col">LTP</th>
                <th scope="col">ESI</th>
                <th  scope="col">Paid Days</th>

            </tr>
        </thead>
       
    </table>
</div>
