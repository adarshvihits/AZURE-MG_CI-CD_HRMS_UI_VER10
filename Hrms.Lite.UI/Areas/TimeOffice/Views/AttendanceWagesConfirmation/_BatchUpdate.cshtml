@model Hrms.Lite.Shared.TimeOffice.AttendanceWagesConfirmation

@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "wage_batch" }))
{                  
<div id="EmployRewardsRecognition" class="slider-forms slider-forms-open batch">
    <div class="slider-inner-style">
        <div class="slider-form-close" onclick="CloseSlider('batch')">
            <i class="ki ki-close icon-xs text-muted"></i>
        </div>
        <h4 class="mb-4"> Batch Update</h4>

        <div class="reward-section border-none">

            @Html.HiddenFor(Model => Model.Month.Code)

            @Html.HiddenFor(Model => Model.PGroup.Code)
            @Html.HiddenFor(Model => Model.Type)
            @if (Model.Type == "Holiday")
            {

            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">

                        <label class="view-title">Payroll Group</label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.PGroup.Name)
                        </div>
                    </div>
                </div>   
                <div class="col-md-6">
                    <div class="row-outer">

                        <label class="view-title">Salary Period</label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.Month.Name)
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Confirmed Days</label>
                        @Html.TextBoxFor(Model => Model.Details.ConfirmedValues, new { @class = "form-control form-control-sm " })


                    </div>
                </div>
            </div>

            }
            <div class="row">
                <div class="col-md-12">
                    <label>Remarks</label>
                    @Html.TextAreaFor(Model => Model.Details.Remarks, new { @class = "form-control form-control-sm remark", @onblur = "validate(this,'rmrks')" })
                    <span id="rmrks"></span>
                </div>
            </div>



            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">

                    <button class="btn btn-default float-right mobile-full-width" type="button" onclick="batchUpdate()">
                        Update
                    </button>

                </div>


            </div>
        </div>



    </div>
</div>

}