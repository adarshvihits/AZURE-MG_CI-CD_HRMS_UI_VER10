
@model Hrms.Lite.Shared.TimeOffice.AttendanceWagesConfirmation


@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/scripts/TimeOffice/AttendanceWagesConfirmation.js?v=1"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>

<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Attendance Wages Confirmation
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Attendance Wages Confirmation

                    </li>

                </ul>
            </div>
        </div>
        <div class="topbar">


            <!--end::User-->
        </div>
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <!--begin: Search Form-->


                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">

                            <div class="tab-items ">
                                <a class="btn-title active Holiday" onclick="onTabClick('Holiday','Holiday')">
                                    Holiday
                                    <span class="btn-notification HolidayCount">@Model.HolidayCount</span>
                                </a>
                            </div>
                            <div class="tab-items high" onclick="onTabClick('OffDay','OffDay')">
                                <a class="btn-title OffDay">
                                    Offday
                                    <span class="btn-notification OffdayCount">@Model.OffdayCount</span>
                                </a>

                            </div>
                            <div class="tab-items high " onclick="onTabClick('OTHours','OTHours')">
                                <a class="btn-title OTHours">
                                    OT Hours
                                    <span class="btn-notification OTCount">@Model.OTCount</span>
                                </a>

                            </div>
                            <div class="tab-items medium">
                                <a class="btn-title LessHours" onclick="onTabClick('LessHours','LessHours')">
                                    Less Hours
                                    <span class="btn-notification LessCount">@Model.LessCount</span>
                                </a>

                            </div>
                            <div class="tab-items medium">
                                <a class="btn-title Shift" onclick="onTabClick('Shift','Shift')">
                                    Shift
                                    <span class="btn-notification ShiftCount">@Model.ShiftCount</span>
                                </a>

                            </div>


                            <div class="tab-items select-option">
                                <div class="form-group mr-6">

                                    @Html.DropDownListFor(m => m.PGroup.Code, (SelectList)ViewBag.PGroup, "--Select Payroll Group--" ,new { @class = "form-control form-control-sm", @onchange = "fillMonth(this)" })
                                </div>
                                <span id="PGroup"></span>
                                <div class="form-group mr-6">

                                    @Html.DropDownListFor(m => m.Month.Code, (SelectList)ViewBag.Month,"--Select Month--" ,new { @class = "form-control form-control-sm", @onchange = "GetMonthWiseList()" })
                                </div>
                                <span id="month"></span>

                                <div class="form-group mr-15">                                 
                                        @Html.DropDownListFor(model => model.ConfirmationStatus,
                                           new List<SelectListItem> {
                                                new SelectListItem {  Value= "0" , Text = "Not Confirmed" },
                                                new SelectListItem { Value = "1" , Text = "Confirmed" },

                                             },
                                           new { @class = "form-control form-control-sm", @onchange = "GetList()" })                                 

                                </div>

                                <div class="form-group batch_hidebutton">

                                    <button class="btn btn-default float-right mobile-full-width" onclick="onbatchUpdateclick()">
                                        BatchUpdate
                                    </button>

                                </div>




                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn" data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left" data-bs-original-title="Export to Excel">
                                    <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                </a>

                            </div>




                            </div>
                    </div>
                    @using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "ConfirmAllList" }))
                    {
                        <div id="AttendanceConfirmationList">
                            @await Html.PartialAsync("_AttendanceWagesConfirmationList.cshtml", Model)
                        </div>

                        <div class="row card-footer-bottom-fixed" id="confimbtn">

                            <div class="col-md-12 align-right">
                                <a class="btn btn-default float-right mobile-full-width" onclick="SubmitAllAttendanceList()">
                                    Confirm
                                </a>

                            </div>


                        </div>
                    }
                    <!--end: Datatable-->
                </div>

                <div id="EditConfirmationSlider">

                </div>

                <div id="filterSlider">
                    @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
                </div>
                <div id="PopUpList" class="hide">
                    @await Html.PartialAsync("_AttendanceWagesConfimationPopUp.cshtml", Model)

                </div>

            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>


