@model Hrms.Lite.Shared.TimeOffice.DailyAttendanceEntry
<script src="~/js/settings.js"></script>
<script src="~/js/tooltip.js"></script>

<div class="ihits-table table-border odd-even mobile-responsive-table daily-att-report">
    @Html.HiddenFor(m => m.DailyAttendanceProcessing.Count)
    <table id="Daily_Attendance_Individual" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Date</th>
                <th scope="col">Shift</th>
                <th scope="col">IN</th>
                <th scope="col">OUT</th>
                <th scope="col" data-bs-toggle="tooltip" title=""
                    data-bs-original-title="Total Time">Tot Time</th>
                <th scope="col" data-bs-toggle="tooltip" title=""
                    data-bs-original-title="Total Time In Shift">Time SH</th>
                <th scope="col">Early In</th>
                <th scope="col">Late In</th>
                <th scope="col">Early Out</th>
                <th scope="col">Overtime</th>
                <th scope="col" data-bs-toggle="tooltip" title=""
                    data-bs-original-title="Attendance Status">Att.Status</th>
                <th scope="col">Absent Reason</th>



            </tr>
        </thead>
        <tbody>
             @if (Model.DailyAttendanceProcessing != null && Model.DailyAttendanceProcessing.Count > 0)
        {
            for (int i = 0; i < Model.DailyAttendanceProcessing.Count; i++)
            {


            <tr>
                <td data-label="ID">@Model.DailyAttendanceProcessing[i].EmployeeID</td>
                <td data-label="name">@Model.DailyAttendanceProcessing[i].FullName</td>
                <td data-label="Date">
                    @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.DailyAttendanceProcessing[i].PunchingDate))

                    @*@Model.DailyAttendanceProcessing[i].PunchingDate*@

                </td>
                <td data-label="shift">@Model.DailyAttendanceProcessing[i].Shift.Name</td>
                <td data-label="In">@Model.DailyAttendanceProcessing[i].IN </td>
                <td data-label="out">@Model.DailyAttendanceProcessing[i].OUT</td>

                <td data-label="total time">@Model.DailyAttendanceProcessing[i].TotalTime</td>
                <td data-label="total time">@Model.DailyAttendanceProcessing[i].InShiftTime</td>


                <td data-label="Early in">@Model.DailyAttendanceProcessing[i].EarlyIn</td>
                <td data-label="latein">@Model.DailyAttendanceProcessing[i].LateIn</td>
                <td data-label="Earlyout">
                    @Model.DailyAttendanceProcessing[i].EarlyOut

                </td>
                <td data-label="overtime">@Model.DailyAttendanceProcessing[i].OverTime</td>
                <td data-label="session">@Model.DailyAttendanceProcessing[i].Session </td>
                <td data-label="Reason">@Model.DailyAttendanceProcessing[i].Reason</td>



            </tr>


            }
        }


            
        </tbody>
    </table>
</div>
