@model Hrms.Lite.Shared.TimeOffice.DailyAttendanceEntry
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>






<script src="~/scripts/TimeOffice/DailyAttendanceProcessingIndividual.js"></script>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Individual - Daily Attendance Processing</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class=""><i class="icon-nm fas fa-home"></i></a>
                    </li>
                    <li class="breadcrumb-item">
                        Individual - Daily Attendance Processing
                    </li>

                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per">

                <div class="card-body">
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap align-items-center">

                            <div class="tab-items">

                                <div class="">
                                    <div>
                                        <label>Date</label>
                                        <div class="input-group date">
                                            @Html.TextBoxFor(m => m.ProcesingDate, "{0:dd-MMM-yyyy}", new
                                       {
                                           @class = "form-control kt_datepicker_2 ",
                                           @placeholder = "Date",
                                           @autocomplete = "off",
                                           @readonly = "true",
                                           @onchange = "validate(this,'att_process_date')"

                                       })

                                            <div class="input-group-append">
                                                <span class="input-group-text">
                                                    <i class="la la-calendar"></i>
                                                </span>
                                            </div>
                                        </div>
                                        <span id="att_process_date"></span>
                                    </div>

                                </div>













                            </div>


                            <div class="tab-items">

                                <div class="">
                                    <div>
                                        <div class="form-group emp " style="width:280px ;">
                                            <label> </label>
                                            <div id="new_val">


                                                @Html.DropDownListFor(m => m.EmpId, (SelectList)ViewBag.Emp, "Select By Employee Name", new
                                           {
                                               @class = "selectpicker form-control form-control-sm form-control emp_id general-validation",
                                               //@onchange = "OnEmpChange()",
                                               data_show_subtext = "true",
                                               data_live_search = "true",
                                               data_max_options = "0",
                                               @onchange = "validateEmployee(this,'emp_id','empid')",

                                           })
                                            </div>
                                        </div>

                                    </div>
                                    <span id="empid"></span>
                                </div>
                             
                            </div>
                                    <div class="tab-items pl-3 pt-3">

                                        <button type="button" class="btn btn-default btn-sm float-left" onclick="GetList()">
                                            Proceed To Save
                                        </button>
                                    </div>

                                    <div class="tab-items select-option">
                                        @*<div class="sraech-slider">
            <div class="search-slider-inner">
                <i class="fa fa-search"></i>
            </div>
            <input type="text" id="dataTableSearch" class="form-control form-control-sm" placeholder="ID/Name">
        </div>
        <div id="filterForm" class="filter-button filteropen" data-bs-toggle="tooltip" title="" data-bs-original-title="Filter" onclick="validatefilter()">
            <i class="fas fa-filter"></i>
            <i class="fas fa-check"></i>
        </div>*@

                                        <button data-bs-toggle="tooltip" title="" class="btn btn-excel float-left" data-bs-original-title="Export to Excel">
                                            <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                        </button>

                                    </div>

                                </div>
                            </div>
                            <div id="IndAttnProccListId">
                                @await Html.PartialAsync("_List", Model)
                            </div>
                            <div id="filterSlider">
                                @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
                            </div>
                            <!-- Table Section -->
                            <!-- Table Setion End -->
                            <!--end: Datatable-->
                        </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
