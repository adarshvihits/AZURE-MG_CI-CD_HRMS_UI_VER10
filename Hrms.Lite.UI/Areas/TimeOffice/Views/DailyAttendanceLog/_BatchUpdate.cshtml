@model Hrms.Lite.Shared.TimeOffice.DailyAttendanceLog
    <script src="~/js/bootstrap-timepicker.js"></script>

            @using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "dailyLog_Batch" })) {  
                <div class="row p-5">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>IN Time </label>
                            <div class="input-group timepicker">
                                @Html.TextBoxFor(Model => Model.InTime, new { @class = "form-control form-control-sm kt_timepicker_2", @placeholder = "IN Time",
                               @onchange= "validate(this,'log_batch_in')",
                               @readonly = "readonly" })
                                <div class="input-group-append">
                                    <span class="input-group-text">
                                        <i class="la la-clock-o"></i>
                                    </span>
                                </div>
                            </div>
                            <span  id="log_batch_in"></span>

                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>OUT Time </label>
                            <div class="input-group timepicker">
                                @Html.TextBoxFor(Model => Model.OutTime, new { @class = "form-control form-control-sm kt_timepicker_2", @placeholder = "OUT Time",
                               @onchange = "validate(this,'log_batch_out')",
                               @readonly = "readonly" })

                                <div class="input-group-append">
                                    <span class="input-group-text">
                                        <i class="la la-clock-o"></i>
                                    </span>
                                </div>
                            </div>
                            <span id="log_batch_out"></span>
                        </div>
                    </div>


                </div>

                <div class="row pt-10 align-right pb-2">

                    <div class="col-md-12">

                        <button type="button" class="btn btn-default mobile-full-width" onclick="BatchUpdateSave()">
                            Save
                        </button>


                    </div>

                </div>

}