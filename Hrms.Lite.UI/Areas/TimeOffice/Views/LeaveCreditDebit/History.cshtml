@model Hrms.Lite.Shared.TimeOffice.LeaveCreditDebit
@{
  
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>
<script src="~/scripts/TimeOffice/leaveCreditDebitHistory.js"></script>


<script>
    $(document).ready(function () {
        fillData();
    });
</script>
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Leave Credit/Debit History</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "LeaveCreditDebit", new { Area = "TimeOffice" })"> Leave Credit/Debit</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Leave Credit/Debit History
                    </li>

                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <!--begin: Search Form-->
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items ml-2 pr-0 border-none select-option">
                                <div class="form-group filter-combobox mr-2" style="width: 150px;">
                                    @Html.DropDownListFor(m => m.LeavePeriod.Code, (SelectList)ViewBag.LeavePeriod, "--Leave Period--", new
                               { @class = "form-control form-control-sm Lcrperiod", @onchange = "validate(this,'leaveperiod');fillData()" })
                                    <span id="leaveperiod"></span>
                                </div>

                            </div>
                            <div class="tab-items pr-0 border-none ">
                                <div class="form-group filter-combobox mr-2" style="width: 200px;">
                                    @Html.DropDownListFor(m => m.Month.Code, (SelectList)ViewBag.Month, "--Month--", new
                                    {
                                        @class = "form-control form-control-sm LcrMonth",
                                   @onchange = "validate(this,'month');fillData()"
                               })
                                    <span id="month"></span>

                                </div>

                            </div>
                            <div class="tab-items pr-0 border-none ">
                                <div class="form-group filter-combobox mr-2" style="width: 150px;">
                                    @Html.DropDownListFor(m => m.DebitCredit.Code, (SelectList)ViewBag.LeaveIncrement, "--Leave Inc--", new
                                    {
                                        @class = "form-control form-control-sm LcrIncremnt"
                                   ,
                                        @onchange = "validate(this,'debitcredit');fillData()"
                               })
                                    <span id="debitcredit"></span>
                                </div>

                            </div>
                            <div class="tab-items pr-0 border-none ">
                                <div class="form-group filter-combobox mr-2" style="width: 200px;">
                                    @Html.DropDownListFor(m => m.Leave.Code, (SelectList)ViewBag.Leave, "--Leave--", new
                                    {
                                        @class = "form-control form-control-sm LcrLeave",
                                        @onchange =
                                   "validate(this,'leave');fillData()"
                               })
                                    <span id="leave"></span>
                                </div>

                            </div>

                            <div class="tab-items select-option">


                          

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="Export to Excel" onclick="ExportToExcel()"
                                   class="btn btn-excel mr-0">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>
                             
                            </div>


                        </div>
                    </div>

                    <!-- Table Section -->

                    @await Html.PartialAsync("_HistoryList")


                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
                    </div>
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
<!--end::Content-->