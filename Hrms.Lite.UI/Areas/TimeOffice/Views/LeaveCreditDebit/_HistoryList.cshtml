@model Hrms.Lite.Shared.TimeOffice.LeaveCreditDebit
<script src="~/js/tooltip.js"></script>


<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Leave-Credit-Debit-History">
    @Html.HiddenFor(m => m.LeaveCreditDebitList.Count)
    <table id="cre_deb_HistoryTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col" data-bs-toggle="tooltip" title="Current Balance">Curt.Bal</th>
                <th scope="col" data-bs-toggle="tooltip" title="Applied Leave">Appl.Lev</th>
                <th scope="col">Entry User</th>
                <th scope="col">Entry Date</th>
                <th scope="col">Entry From</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>
<!-- Table Setion End -->