@model Hrms.Lite.Shared.TimeOffice.Generic.LeaveApplication
@{
    ViewData["Title"] = "LeaveApplication";
    Layout = "~/Views/Shared/_Layout.cshtml";
}




<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/TimeOffice/maternityLeaveAppln.js"></script>




@using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", enctype = "multipart/form-data", @id = "levAppl" }))
{
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">



        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->


            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Maternity Leave Application</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "DashBoard", new { Area = "" })" class="">
                                <i class="icon-nm fas fa-home mt-1"></i>
                            </a>
                        </li>
                      
                                <li class="breadcrumb-item ">
                                    <a href="@Url.Action("Index","MaternityLeaveApplication", new { Area = "TimeOffice" })" class="">Maternity Leave Application List</a>
                                </li>
                            
                                <li class="breadcrumb-item text-muted child-mute">
                                    Maternity Leave Application
                                </li>

                    </ul>
                </div>
            </div>

        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->

                <div class=" height-100per">


                    @Html.HiddenFor(m => m.LeaveApplicationGI)
                    @Html.HiddenFor(m => m.DateOfApplication)

                    @Html.HiddenFor(m => m.EmployeeGI)

                    <div class="card card-custom height-100per">
                        <div class="card-body ">

                            @*<header section></header>*@
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="tab-items select-option">
                                        <div class="view-details">

                                            <strong>
                                                <label> Date of Application :   </label>
                                                @ViewBag.Date


                                            </strong>
                                        </div>


                                    </div>
                                    <div>
                                        <p class="userclass">@Model.EmployeeHeader.EmployeeName </p>
                                    </div>


                                </div>

                                <div class="col-md-6">


                                    <div class="d-flex justify-content-end responsive-center">
                                        <a href="@Url.Action("ApplicationHistory","MaternityLeaveApplication",new { EmployeeGI=Model.EmployeeGI})">
                                            <div class="application-btn d-flex align-items-center  pr-3 ">
                                                <div>
                                                    <img class="leave_appli_img">

                                                </div>
                                                <div class="application-icon"> <h3 class="pt-2 pl-3">Application History </h3></div>
                                            </div>
                                        </a>

                                        <a href="#" data-bs-toggle="modal" data-target=".bd-example-modal-lg">
                                            <div class="application-btn d-flex align-items-center pl-4">
                                                <div>
                                                    <img class="histroy_img">

                                                </div>
                                                <div class="application-icon"> <h3 class="pt-2 pl-3">Approval Authorities</h3></div>
                                            </div>
                                        </a>
                                    </div>






                                </div>
                            </div>

                            <div class="row pt-2">


                                <div class="col-lg-8 col-md-12">

                                    <div class="left-sidecoff">
                                        <div class="row">
                                            <div class="col-md-12">

                                                <div class="row">

                                                    <div class="col-md-4">

                                                        <label>Leave Type</label>
                                                        <span class="Mandatory">*</span>
                                                        <div class="form-group filter-combobox ">
                                                            @Html.DropDownListFor(m => m.LeaveType.Code, (SelectList)ViewBag.LeaveType, "Select Leave Type", new { @class = "form-control form-control-sm" })
                                                            <span id="levType"></span>
                                                        </div>

                                                    </div>
                                                    <div class="col-md-4 form-group">
                                                        <label>From</label>
                                                        <span class="Mandatory">*</span>
                                                        <div class="input-group date">

                                                            @Html.TextBoxFor(m => m.From, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "readonly", @placeholder = "From Date", @onchange = "validate(this,'fromDate'); fillToDate()" })

                                                            <div class="input-group-append">
                                                                <span class="input-group-text">
                                                                    <i class="la la-calendar"></i>
                                                                </span>

                                                            </div>

                                                        </div>
                                                        <span id="fromDate"></span>
                                                    </div>
                                                    <div class="col-md-4 form-group">
                                                        <div class="form-group filter-combobox ">

                                                            <label>Session</label>
                                                            <span class="Mandatory"></span>
                                                            @Html.DropDownListFor(m => m.FromType.Code, (SelectList)ViewBag.Session, new { @class = "form-control form-control-sm", @onchange = "disabletodate();" })
                                                            <span id="SessionFrom"></span>

                                                        </div>

                                                    </div>


                                                </div>


                                                <div class="row my-3">







                                                    <div class="col-md-4 form-group">
                                                        <label>To</label>
                                                        <span class="Mandatory">*</span>
                                                        <div class="input-group date">


                                                            @Html.TextBoxFor(m => m.To, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2 todate", @readonly = "readonly", @placeholder = "To Date", @onchange = "validate(this, 'toDate');showsessionto(this);CalculateDays();" })

                                                            <div class="input-group-append">
                                                                <span class="input-group-text">
                                                                    <i class="la la-calendar"></i>
                                                                </span>
                                                            </div>

                                                        </div>
                                                        <span id="toDate"></span>
                                                    </div>




                                                    <div class="col-md-4 form-group hide" id="sessiontoshow">
                                                        <label>Session</label>
                                                        <div class="form-group filter-combobox ">
                                                            @Html.DropDownListFor(m => m.ToType.Code, (SelectList)ViewBag.SessionTo, new { @class = "form-control form-control-sm" })
                                                            <span id="SessionTo"></span>

                                                        </div>
                                                    </div>
                                                    <div class="col-md-4 form-group d-flex align-items-center">
                                                        <div class=" pt-4 align-right">

                                                            <div class="button-group">

                                                                <button type="button" class="btn btn-default btn-sm " onclick="GetLeaveDayWiseDetails()">
                                                                    Proceed
                                                                </button>

                                                            </div>

                                                        </div>
                                                    </div>


                                                </div>






                                            </div>

                                            <!-- leave approval view end -->
                                            <!--end: Datatable-->
                                        </div>


                                    </div>
                                </div>


                                <!-- right leave view start -->
                                <div class="col-lg-4 col-md-12">

                                    <div class="card-body p-3 right-leave-section">

                                        <div class="employee-details-left">


                                            <p><strong>My Leave Balance</strong></p>
                                            <div class="">
                                                <div class="ihits-table table-border hover-color odd-even mobile-responsive-table approval-balance vertical-scroll-100">
                                                    <table>
                                                        <thead>
                                                            <tr class="table-light">
                                                                <th scope="col">Leave Type</th>

                                                                <th scope="col">Taken </th>
                                                                <th scope="col">Balance </th>
                                                                <th scope="col">Applied </th>


                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @if (Model.LeaveBalanceList != null && Model.LeaveBalanceList.Count > 0)
                                                            {

                                                                for (int i = 0; i < Model.LeaveBalanceList.Count; i++)
                                                                {


                                                                    <tr>
                                                                        <td data-label="Leave Type">@Model.LeaveBalanceList[i].LeaveType</td>
                                                                        <td data-label="Taken">@Model.LeaveBalanceList[i].Taken</td>
                                                                        <td data-label="Balance">@Model.LeaveBalanceList[i].Balance</td>
                                                                        <td data-label="Applied">@Model.LeaveBalanceList[i].Applied</td>
                                                                    </tr>

                                                                }
                                                            }

                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>

                                        </div>


                                    </div>
                                </div>
                                <!-- right leave view start -->


                            </div>
                            <div class="left-sidecoff mt-8">

                                <div class="row">

                                    <div class="col-md-6">



                                        <div id="DayWiseLeaveHRMSList">
                                            @await Html.PartialAsync("_DayWiseList", Model)
                                        </div>
                                    </div>


                                    <div class="col-md-6">
                                        <div class="row pt-2">
                                            <div class="col-md-6">


                                                <div class="form-group">
                                                    <label>Reason</label><span class="Mandatory">*</span>
                                                    <div class="form-group filter-combobox">
                                                        @Html.DropDownListFor(m => m.LeaveReason.Code, (SelectList)ViewBag.Reason, "Select Reason", new { @class = "form-control form-control-sm", @onchange = "validate(this,'Reason')", disabled = "true" })


                                                    </div>
                                                    <span id="Reason"></span>
                                                </div>


                                            </div>
                                            <div class="col-md-6">


                                                <div class="form-group">
                                                    <label>Work Handover Details</label>
                                                    @Html.TextBoxFor(m => m.HandOverDetails, new { @class = "form-control form-control-sm", @placeholder = "Work Handover Details", maxlength = "250", @autocomplete = "off" })

                                                </div>

                                            </div>



                                        </div>

                                        <div class="row
                                             ">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label>Contact details & Address</label>
                                                    @Html.TextBoxFor(m => m.ContactDetails, new { @class = "form-control form-control-sm", @placeholder = "Contact details & Address", maxlength = "250", @autocomplete = "off" })
                                                    <span id="ContactDetails"></span>
                                                </div>

                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label>Additional Remarks</label>
                                                    @Html.TextBoxFor(m => m.AdditionalRemarks, new { @class = "form-control form-control-sm", @placeholder = "Additional Remarks", maxlength = "250", @autocomplete = "off" })


                                                </div>
                                            </div>




                                        </div>

                                        <div class="row">
                                            <div class="col-md-6">
                                                <div class="file-upload-form-group">
                                                    <label for="formFileMultiple" class="form-label">
                                                        Attach
                                                        File
                                                    </label>

                                                    <div class="file-upload-form mb-1">
                                                        <div class="small-btn-group">
                                                            @*<button type="button" data-bs-toggle="tooltip" data-placement="top" data-bs-original-title="View Image" class="btn btn-icon btn-default" onclick="Preview()"><i class="icon-xl far fa-eye"></i></button>*@
                                                        </div>
                                                        <div data-bs-toggle="tooltip" data-bs-original-title=" Only pdf, doc, docx files
                                            are
                                            allowed , File size less than 1 MB.">
                                                            @Html.TextBoxFor(model => model.Attachment.FileData, null, new { type = "file", @class = "form-control PreviewImage", @onchange = "CheckExtensionAndSize(this)", tabindex = "@(++tabindex)", title = "" })
                                                        </div>
                                                    </div>

                                                </div>


                                            </div>

                                        </div>



                                    </div>

                                </div>
                            </div>

                            <div class="row card-footer-bottom-fixed">



                                <div class="col-md-12 align-right">

                                    <button type="button" class="btn btn-default  mobile-full-width" disabled="disabled" id="leaveSubmit" onclick="ApplyLeave()">
                                        Apply
                                    </button>
                                </div>

                            </div>
                        </div>




                    </div>
                </div>

                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>
    <!--end::Content-->

}
<div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog"
     aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" style="max-width:630px ;">
        <div id="myDiv" class="modal-content popup">
            <div class="modal-header" style="padding:10px">
                <h5 class="modal-title" id="exampleModalLabel">
                    Approval Authorities
                </h5>
                <div>

                    <button type="button" class="close mt-2" data-bs-dismiss="modal"
                            aria-label="Close">
                        <i aria-hidden="true" class="ki ki-close"></i>
                    </button>
                </div>
            </div>

            <div class="modal-body">
                <div class="authority-section">
                    @if (Model.EmployeeAuthority != null && Model.EmployeeAuthority.Count > 0)
                    {

                        @for (int i = 0; i < Model.EmployeeAuthority.Count; i++)
                        {
                            <div class="new-authority">


                                <div class="row">
                                    <div class="col-md-2 d-flex justify-content-center align-items-center">
                                        @if (ViewBag.Storage == "BLOB")
                                        {
                                            <div class="image-input image-input-outline image-input-circle float-right new-input-image" id="kt_image_4"
                                                 style="background-image: url(@Model.EmployeeAuthority[i].Base64string)">
                                                <div class="image-input-wrapper new-inputwrapper">
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                    <div class="image-input image-input-outline image-input-circle float-right new-input-image"
                                         id="kt_image_4" style="background-image:url(@Model.EmployeeAuthority[i].AbsoluteUri)">
                                        <div class="image-input-wrapper new-inputwrapper">
                                        </div>
                                    </div>                    }

                                    </div>
                                    <div class="col-md-7 pl-7">
                                        <div class="row">

                                            <div class="flex-grow-1">
                                                <!--begin::Title-->
                                                <div class="d-flex justify-content-between flex-wrap">
                                                    <div class="d-flex mr-3 header-profile-name">
                                                        <span class="">
                                                            @Model.EmployeeAuthority[i].AuthorityName
                                                        </span>

                                                    </div>

                                                </div>

                                                <!--end::Title-->
                                                <!--begin::Content-->
                                                <div class=" flex-wrap justify-content-between">
                                                    <div class="flex-column flex-grow-1 pr-8">
                                                        <div class=" flex-wrap mb-1">
                                                            <span data-bs-toggle="tooltip" data-bs-original-title="ID" class="header-profile-email mr-5 mb-lg-0 mb-2 popup-id">
                                                                @*<i class="fas fa-briefcase icon-nm mr-2"></i>*@
                                                                <i class="fa fa-hashtag icon-nm mr-2" aria-hidden="true"></i>@Model.EmployeeAuthority[i].EmployeeID
                                                            </span>
                                                            <div>
                                                                <span data-bs-toggle="tooltip" data-bs-original-title="Designation" class="header-profile-email mr-5 mb-lg-0 mb-2 popup-id">
                                                                    <i class="fas fa-briefcase icon-nm mr-2"></i>@Model.EmployeeAuthority[i].Designation
                                                                </span>

                                                            </div>
                                                            <div>
                                                                <span data-bs-toggle="tooltip" data-bs-original-title="Email" class="header-profile-email mr-5 mb-lg-0 mb-2 popup-id">
                                                                    <i class="fas fa-envelope icon-nm mr-2"></i>@Model.EmployeeAuthority[i].Email
                                                                </span>

                                                            </div>
                                                            <div>
                                                                <span data-bs-toggle="tooltip" data-bs-original-title="Phone Number" class="header-profile-email mr-5 mb-lg-0 mb-2 popup-id">
                                                                    <i class="far fas fa-mobile-alt icon-nm mr-2"></i>@Model.EmployeeAuthority[i].PhoneNumber
                                                                </span>

                                                            </div>



                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3 d-flex align-items-center">
                                        <div class="authorityone">
                                            <span>Authority @Model.EmployeeAuthority[i].Level</span>
                                        </div>
                                    </div>
                                </div>
                            </div>




                        }

                    }
                    else
                    {
                        <div class="new-authority">


                            <div class="row">
                                <div class="col-md-12">
                                    <h4>
                                        No Authority Assigned
                                    </h4>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>