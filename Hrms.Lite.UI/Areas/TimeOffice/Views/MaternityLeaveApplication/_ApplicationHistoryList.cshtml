@model Hrms.Lite.Shared.TimeOffice.MaternityLeaveApplication

<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllCount').html("@Model.LeaveApplication.TotalCount");
        $('.RejectedCount').html("@Model.LeaveApplication.RejectedCount");
        $('.ApprovedCount').html("@Model.LeaveApplication.ApproveCount");
        $('.PendingCount').html("@Model.LeaveApplication.PendingCount");


        

    });
</script>

<div class="ihits-table table-border odd-even mobile-responsive-table Applicant-History-leave">
    @Html.HiddenFor(m => m.LeaveApplication.LeaveApplicationList.Count)
    <table id="maternityHistoryTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">Employee ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">From</th>
                <th scope="col">To</th>
                <th scope="col">No.of Days</th>
                <th scope="col">Type</th>
                <th scope="col">Reason</th>
                <th scope="col">Date of Application</th>
                <th scope="col">Status</th>
                <th scope="col">Tracker</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.LeaveApplication.LeaveApplicationList != null && Model.LeaveApplication.LeaveApplicationList.Count > 0)
            {

                for (int i = 0; i < Model.LeaveApplication.LeaveApplicationList.Count; i++)
                {
            <tr>
                <td data-label="ID">@Model.LeaveApplication.LeaveApplicationList[i].EmployeeID</td>
                <td data-label="Name">@Model.LeaveApplication.LeaveApplicationList[i].EmployeeName</td>
                <td data-label="Code">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.LeaveApplication.LeaveApplicationList[i].From))</td>
                <td data-label="To">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.LeaveApplication.LeaveApplicationList[i].To))</td>
                <td data-label="No.of Days">@Model.LeaveApplication.LeaveApplicationList[i].TotalDays</td>
                <td data-label="Type">@Model.LeaveApplication.LeaveApplicationList[i].LeaveType.Name</td>
                <td data-label="Reason">@Model.LeaveApplication.LeaveApplicationList[i].LeaveReason.Name</td>
                <td data-label="Date of Application">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.LeaveApplication.LeaveApplicationList[i].DateOfApplication))</td>
                <td data-label="Status">@Model.LeaveApplication.LeaveApplicationList[i].Status</td>
                <td data-label="Tracker">

                    <a id="trainingEmployeeDetails " onclick="ApplnTracker('@Model.LeaveApplication.LeaveApplicationList[i].LeaveApplicationGI')">
                        <i class="icon-xl la la-arrow-circle-right"></i>
                    </a>

                </td>
            </tr>

                }
            }

        </tbody>
    </table>
    <div id="applntracker"></div>

</div>

