@model Hrms.Lite.Shared.TimeOffice.EmployeeWiseOffdaySettings
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>


<script src="~/scripts/TimeOffice/employeeWiseOffdaySettings.js"></script>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Yearly Employee Wise Offday Settings</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted ">
                        Yearly Employee Wise Offday Settings
                    </li>

                </ul>
            </div>
        </div>
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <!--begin: Search Form-->
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">



                            <div class="tab-items pr-0 border-none">


                                <div class="form-group filter-combobox mr-2 width-100px">
                                    @Html.DropDownListFor(m => m.Year.Code, (SelectList)ViewBag.Year, "--Select Year--", new { @class = "form-control form-control-sm", @onchange = "fillData()", @style = "Width:130px;" })
                                </div>


                            </div>
                            <div class="tab-items pr-0 border-none">
                                <div class="form-group filter-combobox mr-2 width-100px">
                                    @Html.DropDownListFor(m => m.ShiftType.Code, (SelectList)ViewBag.ShiftType, "--Select Shift Type--", new { @class = "form-control form-control-sm", @onchange = "fillData()", @style = "Width:170px;" })
                                </div>


                            </div>


                            <!-- <div class="tab-items pr-0 border-none">

        <div class="form-group filter-combobox width-100px">
            <select class="form-control form-control-sm " id="exampleSelects">
                <option value="data">Circle</option>
                <option>Demo</option>
                <option>Demo</option>

            </select>
        </div>

    </div>

    -->

                            <div class="tab-items select-option d-flex">


                                <div class="button-group float-left mr-10">

                                    <button id="BatchUpdate" type="button"
                                            class="btn btn-default btn-sm slider-btn" onclick="batchupdateClick()">
                                        Batch Update
                                    </button>

                                    <div id="batchupdateSlider">

                                    </div>
                                </div>


                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <div id="filterSlider">
                                    @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.filter)
                                </div>

                                <a data-bs-toggle="tooltip" title="Export to Excel" onclick="ExportToExcel()"
                                   class="btn btn-excel">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>
                            </div>




                        </div>
                    </div>




                    <div id="OffdaySettingsListPartial">
                        @await Html.PartialAsync("_List", Model)
                    </div>
                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>




<!--end::Content-->