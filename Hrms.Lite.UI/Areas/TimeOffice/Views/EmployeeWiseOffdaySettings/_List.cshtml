</script>


<div class="ihits-table table-border hover-color odd-even mobile-responsive-table yearlyempset-list">
    @Html.HiddenFor(m=>m.List.Count)
    <table id="EmployeeOffDayTable">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col" data-bs-toggle="tooltip" title="Previous Combination">
                    Pre. Combination
                </th>
                <th scope="col">New Combination</th>
                <th scope="col" data-bs-toggle="tooltip" title="Effective From">
                    Eff.
                    From
                </th>
                <th scope="col">Action</th>
            </tr>
        </thead>
             <tbody>
        
                             
            </tbody>
    </table>

    <div id="editSlider">

    </div>
</div>



<div class="modal fade bd-example-modal-lg" id="offdaysettingsPopupId" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content popup">
            <div class="modal-header" style="padding:10px">
                <h5 class="modal-title" id="exampleModalLabel">Yearly Employee Wise Offday Settings </h5>
                <button type="button" class="close" data-bs-dismiss="modal" data-target="#offdaysettingsPopupId" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">

            </div>
        </div>
    </div>
</div>


