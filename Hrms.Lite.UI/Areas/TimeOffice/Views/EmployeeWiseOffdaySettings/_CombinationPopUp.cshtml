@model Hrms.Lite.Shared.TimeOffice.EmployeeWiseOffdaySettings
@Html.HiddenFor(m => m.EmployeeGI)
@Html.HiddenFor(m => m.EmployeeName)
@Html.HiddenFor(m => m.NewCombination.Name)
@*<script src="~/js/jquery.min.js"></script>*@
<script src="~/scripts/TimeOffice/employeeWiseOffdaySettings.js"></script>
<script src="~/js/tooltip.js"></script>
    <div style="padding:10px;"
         class="ihits-table table-border hover-color odd-even mobile-responsive-table yearlypopup-list-table vertical-scroll-250">

        <div class="row pb-2 d-flex align-items-center" >
            <div class="col-md-4">



                <h5 class="headname mb-0">  @Model.EmployeeName </h5>

            </div>
            <div class="col-md-2">
                <div class="d-flex"><span class="headname">Year : </span> <Span class="pl-1"> @Model.Year.Name</Span></div>

            </div>
            <div class="col-md-5">

                <div class="d-flex"><span class="headname">Current Combination : </span><Span class="pl-1"> @Model.NewCombination.Name</Span></div>
            </div>


            <div class="col-md-1 d-flex justify-content-end">

                <a data-bs-toggle="tooltip" title="" class="btn btn-excel" data-bs-original-title="Export to Excel" onclick="popUpExportToExcel()">
                    <i class="icon-xl far fa-file-excel"></i>
                </a>
            </div>

        </div>


        <table id="EmployeepopupTable">
            <thead>
                <tr class="table-light">
                    <th scope="col">Offdays</th>
                    <th scope="col">Day</th>


                </tr>
            </thead>
            <tbody>
                @if (Model.Dates != null && Model.Dates.Count > 0)
                {

                    for (int i = 0; i < Model.Dates.Count; i++)
                    {
                        <tr>
                            <td data-label="Offdays">@Model.Dates[i].Date</td>
                            <td data-label="Day">
                                @Model.Dates[i].Day
                            </td>




                        </tr>

                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="new"></td>
                    </tr>
                }
            </tbody>


        </table>
        <div class="row pt-5">
            <div class="col-md-12">
                @Model.Description
            </div>

        </div>
    </div>

