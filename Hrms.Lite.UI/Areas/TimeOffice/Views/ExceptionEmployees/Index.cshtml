
@model Hrms.Lite.Shared.TimeOffice.ExceptionEmployees
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>
(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<link href="~/css/custom.css" rel="stylesheet" />
<script>


</script>

<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>

<script src="~/scripts/TimeOffice/ExceptionEmployees.js"></script>
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Exception Employees
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home" , new { Area="" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Exception Employees

                    </li>

                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body ">


                            @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "ExceptionEmployeeUpload", enctype = "multipart/form-data" }))
                            {

                                <div class="row tab-style-button">
                                    <div class="tab-button-wrap">

                                        <div class="tab-items ">
                                            <span class="btn-title active tab1" onclick="tabClick('tab1','0')">
                                                Normal
                                            </span>
                                        </div>


                                        <div class="tab-items ">
                                            <span class="btn-title  tab2" onclick="tabClick('tab2', '1')">
                                                Exceptional
                                            </span>
                                        </div>


                                        <!--<div class="tab-items border-none d-flex align-items-center">
                                         <div>
                                              <label>Based On</label>
                                              <div class="radio-inline">
                                                <label class="radio radio-outline radio-success">-->
                                                 @*@Html.RadioButtonFor(m => m.BasedOn, "0", new { @onchange = "fillData()" })*@
                                                 <!--<span></span>Normal
                                                </label>
                                             <label class="radio radio-outline radio-success">-->
                                        @*<input type="radio" name="radios15">*@
                                        @*@Html.RadioButtonFor(m => m.BasedOn, "1", new { @onchange = "fillData()" })
                                               <span></span>Exceptional
                                                   </label>
                                                   </div>
                                                   </div>
                                                   </div>*@


                                    <div class="tab-items  d-flex align-items-center " >

                                        <div class="row-outer " style="width:250px">
                                            @*<label>Month</label>*@
                                            <div class="form-group filter-combobox  mb-0 mt-0">
                                                @Html.DropDownListFor(model => model.Month.Code, (SelectList)ViewBag.Month, "-SELECT MONTH-", new { @class = "form-control form-control-sm Typevalue", @onchange = "fillData();validate(this,'type');" })
                                                <span ></span>
                                            </div>

                                        </div>

                                    </div>
                                    <!--<div class="tab-items d-flex align-items-center Month_1 ">
                                        <div class="row-outer  " id="exceptn" style="width:250px">
                                            <label>Month</label>
                                            <div class="form-group filter-combobox  mb-0 mt-0">-->
                                                @*@Html.DropDownListFor(m => m.Month1.Code, (SelectList)ViewBag.Month1, "-SELECT MONTH-", new { @class = "form-control form-control-sm", @onchange = "fillData();validate(this,'type');" })*@
                                                <!--<span ></span>
                                            </div>
                                        </div>
                                    </div>-->

                                        <div class="tab-items select-option ">

                                            @*<div class="button-group float-left">
                                            <button type="button" class="btn btn-default btn-sm" onclick="onBatchUpdateClick()">
                                              Batch Update
                                            </button>
                                            </div>*@

                                            <div class="sraech-slider">
                                                <div class="search-slider-inner">
                                                    <i class="fa fa-search"></i>
                                                </div>
                                                <input type="text" id="dataTableSearch" class="form-control form-control-sm" placeholder="ID/Name">
                                            </div>
                                            <a data-bs-toggle="tooltip" title="Export to Excel"
                                               class="btn btn-excel" onclick="ExportToExcel()">
                                                <i class="icon-xl far fa-file-excel"></i>
                                            </a>

                                            <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                                <i class="fas fa-filter"></i>
                                                <i class="fas fa-check"></i>
                                            </div>

                                            <button type="button" data-bs-toggle="tooltip" title="Import From Excel" onclick="validateMonth()" class="btn btn-excel ml-0 import">
                                                <i class="fa fa-upload icon-xls" aria-hidden="true"></i>
                                            </button>


                                            <div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
                                                <div class="modal-dialog modal-lg">
                                                    <div class="modal-content popup">
                                                        <div class="modal-header" style="padding:10px">
                                                            <h5 class="modal-title" id="exampleModalLabel">Upload Format</h5>
                                                            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close" onclick="$('#Unmatchedlist').html('');$('#Excel_FileData').val()">
                                                                <i aria-hidden="true" class="ki ki-close"></i>
                                                            </button>
                                                        </div>

                                                        <div class="modal-body pt-3">
                                                            <div class="colums_list pb-1">
                                                                Please ensure your Excel file contains the following columns with the exact headings. Spelling and case must match precisely for a successful import -

                                                                Employee ID,
                                                                Employee Name,
                                                                Remark,
                                                                Status

                                                                <br />
                                                                @*Columns Needed :- Employee ID, Employee Name, LOP, OP, HP, Late Hrs, OT Hrs*@

                                                            </div>
                                                            <div class="row">
                                                                <div class="col-md-4">
                                                                    <div class="file-upload-form-group">
                                                                        <label for="formFileMultiple" class="form-label">
                                                                            Attach
                                                                            File
                                                                            <span class="Mandatory">*</span>
                                                                        </label>

                                                                        <div class="file-upload-form mb-1" data-bs-toggle="tooltip" data-bs-original-title=" Only pdf, doc, docx files are
                                                                         allowed , File size less than 1 MB.">
                                                                            <div class="small-btn-group">

                                                                                <button type="button" data-bs-toggle="tooltip" data-placement="top" data-bs-original-title="View Image" class="btn btn-icon btn-default"><i class="icon-xl far fa-eye"></i></button>

                                                                            </div>
                                                                            <input id="File_AbsoluteUri" name="File.AbsoluteUri" type="hidden" value="">
                                                                            @Html.HiddenFor(model => model.Excel.FileData, new { type = "file", @class = "input-file PreviewImage form-control h-100", @onchange = "onImportExcelClick()" })
                                                                        </div>


                                                                    </div>


                                                                </div>

                                                            </div>

                                                            <div id="Unmatchedlist">

                                                            </div>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>




                                        </div>

                                    </div>
                                </div>
                            }
                                <div class="row">

                                    <div class="col-md-12" id="EmployeeList">
                                        @await Html.PartialAsync("_List", Model)
                                    </div>
                                    <div id="filterSlider">
                                        @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.filter)
                                    </div>
                                </div>

                                <!-- <end table></end> -->
                                <div class="row card-footer-bottom-fixed">
                                    <div class="col-md-6">
                                        <div class="d-flex responsive-center">

                                            <a href="@Url.Action("History","ExceptionEmployees", new { Area="TimeOffice"})">

                                                <div class="application-btn d-flex align-items-center  pr-3 ">
                                                    <div class="history-btn">
                                                        <img src="/images/Icon awesome-history.png">

                                                    </div>
                                                    <div class="application-icon"> <h3 class="pt-2 pl-3">Transaction History </h3></div>
                                                </div>
                                            </a>


                                        </div>
                                    </div>

                                  

                                </div>
                            </div>

                    </div>
                </div>
            </div>

        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>
<!--end::Content-->
