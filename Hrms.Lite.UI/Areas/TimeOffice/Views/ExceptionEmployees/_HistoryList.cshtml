@model Hrms.Lite.Shared.TimeOffice.ExceptionEmployees
<script src="~/js/tooltip.js"></script>
<script>
    function ApplyFilter(mode) {
        var tabIndex = $('#Tabindex').val();
        var search = $('#SearchId').val();
        //$("#Tabindex").val(currentTab);
        $("#SearchId").val($('#FilterList_Code').val())
        if (mode == 'apply') {
            if (filterApplicable >= 1) {
                fillData();
                CloseSlider('basicFilter');
                $('#filterForm').removeClass('filter-apply');
            }
            else {
                /*  showSpinner();*/
                fillData();
                CloseSlider('basicFilter');
                $('#filterForm').addClass('filter-apply');
            }
        }
        else {
            /*showSpinner();*/
            filterApplicable = 1;
            $('.reset').val('');
            $('#Optional_Filter_EmploymentStatus_Code').val(0);
            $('#filterForm').removeClass('filter-apply');
            fillData();
            //    CloseSlider('basicFilter');
        }
    }
</script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table exception_emp_list">
    @Html.HiddenFor(m => m.TransactionHistoryList.Count)

    <table id="TransactionHistoryTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">Remarks</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>
