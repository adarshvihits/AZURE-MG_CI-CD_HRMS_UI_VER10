@model Hrms.Lite.Shared.TimeOffice.ExceptionEmployees

<h2 style="font-size: 16px; padding-top: 15px; ">Upload Failed<span>:Unmatched List</span></h2>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table budget-upload-list">
    <table id="BudgetUpload" class="common-table-two">
        <thead>
            <tr class="table-dark">
                <th scope="col">EmployeeID </th>
                <th scope="col"> EmployeeName</th>
                <th scope="col">
                    Remarks
                </th>

            </tr>
        </thead>
        <tbody>
            @if (Model.ExceptionEmployeesList != null && Model.ExceptionEmployeesList.Count > 0)
            {

                for (int i = 0; i < Model.ExceptionEmployeesList.Count; i++)
                {

                    <tr>
                        <td data-label="Location">@Model.ExceptionEmployeesList[i].EmployeeID</td>
                        <td data-label="Region">@Model.ExceptionEmployeesList[i].EmployeeName</td>
                        <td data-label="Budgeted Nos">@Model.ExceptionEmployeesList[i].Remarks</td>

                    </tr>
                }
            }
        </tbody>
    </table>
</div>