@model Hrms.Lite.Shared.TimeOffice.AttendanceSetting
    @*<script src="~/js/settings.js"></script>
    <script src="~/js/tooltip.js"></script>*@
    <script>
        $(document).ready(function () {
            debugger;
            fillData();
        });

