@model Hrms.Lite.Shared.TimeOffice.AttendanceSetting
<link href="~/css/custom.css" rel="stylesheet" />
<script src="~/js/tooltip.js"></script>
<script src="~/js/Multiselectdropdown.js"></script>
<script>
    $(document).ready(function () {
        debugger;

        if (@Model.ShiftType != 1) {
            $('#singleselect').hide();
            $('#multipleselect').show();
        }
        else {
            $('#singleselect').show();
            $('#multipleselect').hide();
        }
        if (@Model.PunchingApplicability== 1)            
                $(".pun_MethodDiv").removeClass('hide');
           
            else {
            $(".pun_MethodDiv").addClass('hide');
            /* AttendanceSettings_PunchingMethodIDs.length = 0;*/
            }
    });
</script>
<style>
    .multiselect-native-select .btn.dropdown-toggle {
        border: none !important;
    }
</style>
@using (Html.BeginForm("Create", "Category", FormMethod.Post, new { id = "AttendaceSettSave" }))
{
    @Html.HiddenFor(model => Model.AttendanceSettingDetails.EmployeeCode)
    @Html.HiddenFor(model => Model.AttendanceSettingDetails.EmpId)
    @Html.HiddenFor(model => Model.AttendanceSettingDetails.EmployeeGuid)
    @Html.HiddenFor(model => Model.AttendanceSettingDetails.EmployeeName)
<div id="empattendancesettings" class="slider-forms slider-forms-open closeEdit">
    <div class="slider-inner-style  new-inner-style">
        <div class="slider-form-close">
            <i class="ki ki-close icon-xs text-muted" onclick="CloseSlider('closeEdit')"></i>
        </div>


        <div class="location-slider">

            <h4>
                Employee Attendance Settings
            </h4>
            <div class="profile-header position-relative pb-12 mb-5" style="padding-bottom: 2px !important; padding-top: 5px !important;">
                <div class="row">
                    @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeSliderHeader.cshtml", Model.EmployeeHeader)
                </div>
                <div class="profile-header-overflow"></div>
            </div>

        </div>
        <div class="add-padding">

            <div class="d-flex align-items-center  pb-2">
                <div class="fingerprint">
                    <i class="fa fa-podcast icon-clr-new" aria-hidden="true"></i>



                </div>
                <h4 class="mb-1 iconpad">
                    Punching
                </h4>
            </div>

            <div class="row">

                <div class="col-md-4">
                    <div class="form-group">
                        <label>Punching ID</label>
                        @Html.TextBoxFor(Model => Model.AttendanceSettingDetails.PUNCHINGID, new { @class = "form-control form-control-sm ", @placeholder = "Punching ID", @onblur = "capitalizeFirstLetter(this,'attsett_PUNCHINGID')", maxlength = "120" })

                        <span id="attsett_PUNCHINGID"></span>

                    </div>
                </div>


                <div class="col-md-4">
                    <div class="form-group">
                        <label>Punching Applicable</label>

                        @Html.DropDownListFor(model => Model.PunchingApplicability,
                        new List<SelectListItem> {new SelectListItem {  Value= "1" , Text = "YES" },new SelectListItem { Value = "0" , Text = "NO" },
                       }, "-- Select--", new { @class = "form-control form-control-sm", @onchange = "onPunchingApplChange(this)" })


                    </div>
                    <span id="punchingAppl"></span>
                </div>




                <div class="col-md-4 pun_MethodDiv">
                    <div class="form-group">
                        <label>Punching Method</label>
                        <div class="form-control  form-control-sm punchdiv">
                            @Html.ListBoxFor(Model => Model.AttendanceSettingPunchMethods, (SelectList)ViewBag.punchingMethod, new
                       {
                           @class = "multiselectDropdownField form-control-multiselect form-control-sm",
                           placeholder = "Select Punching Method",
                           @multiple = "multiple",
                           @onchange = "validateMultiselect('AttendanceSettingPunchMethods', 'attsett_punchMethods','punchdiv')"
                       })
                        </div>
                    </div>
                    <span id="attsett_punchMethods"></span>
                </div>
            </div>
            <div class="d-flex align-items-center pt-6 pb-2">
                <div class="fingerprint">
                    <i class="fa fa-retweet icon-clr-new" aria-hidden="true"></i>

                </div>
                <h4 class="mb-1 iconpad">
                    Shift
                </h4>
            </div>
            <div class="row">

                <div class="col-md-4">

                    <div class="form-group">
                        <label>Shift Type</label>
                        @Html.DropDownListFor(m => m.ShiftType, (SelectList)ViewBag.ShiftType, "--Select--", new
                        {
                            @class = "form-control form-control-sm",
                       @onchange = "validate(this, 'attsett_ShiftType');onShiftTypeChange(this);"
                   })
                        <span id="attsett_ShiftType"></span>
                    </div>

                </div>
                <div class="col-md-4">

                    <div class="form-group">
                        <label>Shift Selection</label>

                        <div id="multipleselect">

                            <div class="form-control  form-control-sm  shiftmultidiv">
                                @Html.ListBoxFor(m => m.AttendanceSettingShtSelection, (SelectList)ViewBag.ShiftDetails, new
                           {
                               @class =
                               "multiselectDropdownField form-control-multiselect form-control-sm",
                               @multiple = "multiple",
                               @onchange = "validateMultiselect('AttendanceSettingShtSelection','attsett_shiftmulti','shiftmultidiv')"
                           })
                            </div>
                        </div>
                        <div id="singleselect">
                            @Html.DropDownListFor(m => m.ShiftSelect, (SelectList)ViewBag.ShiftDetails, "--Select Shift Details--", new
                            {
                                @class = "form-control form-control-sm",
                           @onchange = "validate(this, 'attsett_Shiftsingle')"
                       })
                            <span id="attsett_Shiftsingle"></span>
                        </div>

                    </div>
                    <span id="attsett_shiftmulti"></span>

                </div>

                <div class="col-md-4">

                    <div class="form-group">
                        <label>Shift Circle</label>
                        @Html.DropDownListFor(m => m.Circle, (SelectList)ViewBag.Circle, "--Select--", new
                   {
                       @class = "form-control form-control-sm",
                       //@onchange = "validate(this,'attsett_Circle')"
                   })
                        <span id="attsett_Circle"></span>
                    </div>

                </div>


            </div>

            <div class="d-flex align-items-center pt-6 pb-2">
                <div class="fingerprint">
                    <i class="fa fa-car icon-clr-new" aria-hidden="true"></i>

                </div>
                <h4 class="mb-1 iconpad">
                    Holiday & Offday
                </h4>
            </div>
            <div class="row ">

                <div class="col-md-6">

                    <div class="form-group">
                        <label>Holiday Group</label>
                        @Html.DropDownListFor(m => m.HolidayGroup, (SelectList)ViewBag.HolidayGroup, "--Select--", new
                        {
                            @class = "form-control form-control-sm",
                       @onchange = "validate(this,'attsett_HolidayGroup')"
                   })
                        <span id="attsett_HolidayGroup"></span>
                    </div>

                </div>
                <div class="col-md-6">

                    <div class="form-group">
                        <label>Offday</label>
                        @Html.DropDownListFor(m => m.Offday, (SelectList)ViewBag.OffDaySettings, "--Select--", new { @class = "form-control form-control-sm" })
                        <span id="attsett_Offday"></span>
                    </div>

                </div>
            </div>
            <div class="d-flex align-items-center pt-6 pb-2">
                <div class="fingerprint">
                    <i class="fa fa-list-alt icon-clr-new" aria-hidden="true"></i>


                </div>
                <h4 class="mb-1 iconpad">
                    Leave
                </h4>
            </div>
            <div class="row ">

                <div class="col-md-6">

                    <div class="form-group">
                        <label>Leave Group</label>
                        @Html.DropDownListFor(m => m.LeaveGroup, (SelectList)ViewBag.LeaveGroup, "--Select--", new
                        {
                            @class = "form-control form-control-sm",
                            @onchange = "onLeaveGrpChange();"
                        })
                        <span id="attsett_LeaveGroup"></span>
                    </div>

                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Applicable Leaves</label>
                        <div class="form-control  form-control-sm appldiv">


                            @Html.ListBoxFor(Model => Model.ApplicableLeave, (SelectList)ViewBag.ApplLeaves, new
                       {
                           @class = "multiselectDropdownField form-control-multiselect form-control-sm loan12",
                           placeholder = "Select Punching Method",
                           @multiple = "multiple"

                       })

                        </div>
                    </div>

                    <span id="attsett_appleaves"></span>
                </div>
            </div>
            <div class="row my-5">

                <div class="col-md-6">

                    <div class="d-flex align-items-center">

                        <label class="pr-3">Coff Applicability </label>
                        <div class="checkbox-inline justify-content-center">
                            <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                @Html.CheckBoxFor(m => m.AttendanceSettingDetails.COFFAPPLICABILTY, new { @class = "atleastonecheck" })
                                <span></span>
                            </label>
                        </div>

                    </div>
                </div>
                <div class="col-md-6">

                    <div class="d-flex align-items-center">

                        <label class="pr-3">Less Hour Applicability </label>
                        <div class="checkbox-inline justify-content-center">
                            <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                @Html.CheckBoxFor(m => m.AttendanceSettingDetails.LESSHOUR, new { @class = "atleastonecheck" })
                                <span></span>
                            </label>
                        </div>

                    </div>
                </div>

            </div>


            <div class="row my-5">

                <div class="col-md-6">

                    <div class="d-flex align-items-center">

                        <label class="pr-3">Single Punch Applicability </label>
                        <div class="checkbox-inline justify-content-center">
                            <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                @Html.CheckBoxFor(m => m.AttendanceSettingDetails.SINGLEPUNCHAPPLICABILTY, new { @class = "atleastonecheck" })
                                <span></span>
                            </label>
                        </div>

                    </div>
                </div>
                <div class="col-md-6">

                    <div class="d-flex align-items-center">

                        <label class="pr-3">Night Off </label>
                        <div class="checkbox-inline justify-content-center">
                            <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                @Html.CheckBoxFor(m => m.AttendanceSettingDetails.NIGHTOFFAPPLICABILTY, new { @class = "atleastonecheck" })
                                <span></span>
                            </label>
                        </div>

                    </div>
                </div>


            </div>
            <div class="row my-6">

                <div class="col-md-6">

                    <div class="d-flex align-items-center">

                        <label class="pr-3">OD/RA Auto Approval </label>
                        <div class="checkbox-inline justify-content-center">
                            <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                @Html.CheckBoxFor(m => m.AttendanceSettingDetails.ODAR, new { @class = "ODARcheck" })
                                <span></span>
                            </label>
                        </div>

                    </div>
                </div>
               


            </div>



            <div class="row card-footer-bottom-fixed border-none">
                <div class="col-md-12 align-right">
                    <a type="button" onclick="EditSave()"
                       class="btn btn-default  mobile-full-width">
                        Modify
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
}
<!-- Edit Slider  end-->