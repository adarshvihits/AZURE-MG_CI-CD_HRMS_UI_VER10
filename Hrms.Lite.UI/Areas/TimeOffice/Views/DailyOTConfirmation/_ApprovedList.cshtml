@model Hrms.Lite.Shared.TimeOffice.OverTimeApproval





<div class="ihits-table table-border hover-color odd-even mobile-responsive-table  Daily-Overtime-Confirmation-apov-list">
    @Html.HiddenFor(m => m.Details.Count)
    <table id="overtimeApprovedTable">
        <thead>
            <tr class="table-dark">

                <th scope="col">ID </th>
                <th scope="col">Employee Name </th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">Shift</th>
                <th scope="col">IN</th>
                <th scope="col">OUT</th>
                <th scope="col" data-bs-toggle="tooltip" title="Total Time">Tol Time</th>
                <th scope="col" data-bs-toggle="tooltip" title="Actual Overtime Hours">Act.OT Hrs</th>
                <th scope="col" data-bs-toggle="tooltip" title="Actual Overtime Minutes">Act.OT Mins</th>
                <th scope="col"data-bs-toggle="tooltip" title="">Edit OT Hrs</th>
                <th scope="col"data-bs-toggle="tooltip" title="">Edit OT Mins</th>
                
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.Details != null && Model.Details.Count > 0)
                {
                    for (int i = 0; i < Model.Details.Count; i++)

                    {
                        <tr>

                            <td data-label=" ID">
                                @Html.HiddenFor(m => m.Details[i].EmployeeGI)
                                @Model.Details[i].EmployeeID
                            </td>
                            <td data-label=" Name">
                                @Model.Details[i].EmployeeName
                            </td>

                            <td data-label="Designation">@Model.Details[i].Designation</td>
                            <td data-label="Department">@Model.Details[i].Department</td>
                            <td data-label="Location">@Model.Details[i].Location</td>
                            <td data-label="Shift">@Model.Details[i].Shift</td>
                            <td data-label="Shift">@Model.Details[i].PunchIn</td>
                            <td data-label="Shift">@Model.Details[i].PunchOutTime</td>
                            <td data-label="Shift">@Model.Details[i].TotalPunchTime</td>
                            <td data-label="COT Hours">
                                @Model.Details[i].ActualOTHours                                
                            </td>
                            <td data-label="COT Hours">
                                @Model.Details[i].ActualOTMin                                
                            </td>
                            <td data-label="COT Hours">
                                @Model.Details[i].OTHours                                
                            </td>
                            <td data-label="COT Minutes">
                                @Model.Details[i].OTMin
                            </td>
                            <td data-label="">
                                <div class="checkbox-inline " style="justify-content:center;">
                                    <label class="checkbox checkbox-outline checkbox-success">
                                        @Html.CheckBoxFor(m => m.Details[i].YN)
                                        <span></span>
                                    </label>
                                </div>
                            </td>
                        </tr>
                        }
                    }
                }


        </tbody>
    </table>
</div>