@model Hrms.Lite.Shared.TimeOffice.OverTimeApproval
<script src="~/js/tooltip.js"></script>
<style>


    

    .ihits-table table .loading tbody {
        position: relative;
    }

        .ihits-table table.loading tbody:after {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: url("/images/Loader_img1 (7).gif");
            background-position: center;
            background-repeat: no-repeat;
            background-size: 100px 100px;
            content: "";
        }
</style>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table  overtime-approval-list">
    @Html.HiddenFor(m => m.Details.Count)
    <table id="overtimeApprovalTable">

        <thead>
            <tr class="table-dark">

                <th scope="col">ID </th>
                <th scope="col">Employee Name </th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">Shift</th>
                <th scope="col">IN</th>
                <th scope="col">OUT</th>
                <th scope="col">Total Time</th>
                <th scope="col" data-bs-toggle="tooltip" title="Overtime Hours">OT Hours</th>
                <th scope="col" data-bs-toggle="tooltip" title="Overtime Minutes">OT Minutes</th>

                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
