@model Hrms.Lite.Shared.TimeOffice.AbscondingIntimation

<script src="~/js/bootstrap-datepicker.js"></script>

<style>

    .popup {
        margin: 2% auto;
        padding: 10px;
    }

    .pro_ph {
        padding: 6px !important;
        border-radius: 10px;
    }

    .image-input .image-input-wrapper {
        width: 50px;
        height: 50px;
    }


    .scond-divsprate {
        border-radius: 10px;
        border: 1px solid lightgrey;
        padding: 10px;
    }

    /*.page-scroll-new {
        overflow-y: scroll;
        height: 510px;
        display: block;
        overflow-x: hidden;
        padding-right: 10px;
    }*/


</style>



@using (Html.BeginForm("", "", FormMethod.Post, new { @class = "display-flex", enctype = "multipart/form-data", @id = "erEntry_Form" }))
{

    <!--begin::Dashboard-->
    <!--begin::Row-->

    <div class="page-scroll-new popup_header  ">

        <div class="profile-header position-relative pb-12 mb-5">
            <div class="">

                <div class="col-md-12 pl-10">
                    <div class="row">
                        <div class="d-flex">
                            <div class="image-input-wrapper">
                                <div class="image-input image-input-outline image-input-circle  mr-5 emp_HeaderPic" id="kt_image_4">
                                    <div class="image-input-wrapper">
                                        <img src="/AccessFile/GetEmpThumbnail?EmployeeGI=@(Model.EmployeeHeader.EmployeeGuid)" />
                                    </div>
                                </div>
                            </div>
                            <div class="flex-grow-1">

                                <!--begin::Title-->
                                <div class="d-flex justify-content-between flex-wrap ">
                                    <div class="d-flex mr-3 header-profile-name">
                                        <a class="header-profile-name">@Model.EmployeeHeader.EmployeeName</a>

                                    </div>

                                </div>
                                <!--end::Title-->
                                <!--begin::Content-->
                                <div class="d-flex flex-wrap justify-content-between">
                                    <div class="d-flex flex-column flex-grow-1 pr-8">
                                        <div class="d-flex flex-wrap mb-1">
                                            <a data-bs-toggle="tooltip" data-bs-original-title="Functional Designation" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                <i class="fas fa-network-wired icon-nm mr-2"></i>@Model.EmployeeHeader.FunctionalDesignation
                                            </a>
                                            <a data-bs-toggle="tooltip" data-bs-original-title="Fun.Designation" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                <i class="fas fa-briefcase icon-nm mr-2"></i>@Model.EmployeeHeader.Designation.Name
                                            </a>
                                            <a data-bs-toggle="tooltip" data-bs-original-title="Department" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                <i class="fas fa-building icon-nm mr-2"></i>@Model.EmployeeHeader.Department.Name

                                            </a>
                                            <a data-bs-toggle="tooltip" data-bs-original-title="Location" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                <i class="fas fa-map-marker-alt icon-nm mr-2"></i>@Model.EmployeeHeader.Location.Name

                                            </a>

                                            <a data-bs-toggle="tooltip" data-bs-original-title="Location Code" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                <i class="fas fa-map-marker-alt icon-nm mr-2"></i>@Model.EmployeeHeader.LocationCode
                                            </a>
                                            <a data-bs-toggle="tooltip" data-bs-original-title="DOJ" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                <i class="fas fa-calendar-alt icon-nm mr-2"></i>@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.EmployeeHeader.DOJ))
                                            </a>
                                            <a data-bs-toggle="tooltip" data-bs-original-title="Category" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                <i class="fas fa-check-square icon-nm mr-2"></i>@Model.EmployeeHeader.Category.Name
                                            </a>




                                        </div>



                                    </div>



                                </div>

                                <!--end::Content-->
                            </div>

                        </div>
                    </div>

                </div>
            </div>







            <div class="profile-header-overflow"></div>
        </div>


        <div class="scond-divsprate">

            <div class="emp-historynew">
                <h4>History</h4>
            </div>
            <!--2nd table-->

            <div class="ihits-table table-border odd-even mobile-responsive-table vertical-scroll-150 Employee-Absconding-Intimation-list">



                <table id="PH_ApprovalTable" class="common-table">
                    <thead>
                        <tr class="table-dark">
                            <th scope="col">Absconding Intimated Employee</th>
                            <th scope="col">Absconding Date</th>
                            <th scope="col">Communication Method</th>
                            <th scope="col">Remarks</th>

                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.HistoryList != null && Model.HistoryList.Count > 0)
                        {

                            for (int i = 0; i < Model.HistoryList.Count; i++)
                            {
                                @Html.HiddenFor(m => m.HistoryList.Count)
                                @Html.HiddenFor(m => m.EmployeeGI)
                                <tr>

                                    <td data-label="ID">
                                        @Model.HistoryList[i].EmployeeName

                                    </td>
                                    <td data-label="Employee Name"> @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.HistoryList[i].AbscondingDate))</td>
                                    <td data-label="Month">@Model.HistoryList[i].CommunicatedMethod</td>
                                    <td data-label="Month">@Model.HistoryList[i].Remarks</td>



                                </tr>

                            }
                        }
                        else
                        {
                            <tr>
                                <td>

                                    <div id="noDataFound" style="text-align: center;display: flex;align-items: center;justify-content: center;height: 30vh;"><img src="/images/nodata.png" style="width:130px;" /></div>
                                </td>
                            </tr>
                        }

                    </tbody>
                </table>

            </div>
        </div>
        <!--3nd table-->


        <div class="scond-divsprate mt-2 mb-8">

            <div class="row pt-2">



                <div class="col-md-5 ">
                    <div class="form-group">
                        <label>Detaging Date<span class="Mandatory">*</span></label>

                    </div>


                </div>
                <div class="col-md-4">
                    <div class="input-group date">
                        @Html.TextBoxFor(m => m.DatagDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "readonly", @placeholder = "Enter Date", @onChange = "validate(this,'Date')" })


                        <div class="input-group-append">
                            <span class="input-group-text">
                                <i class="la la-calendar"></i>
                            </span>

                        </div>

                    </div>
                    <span id="Date"></span>
                </div>
            </div>

            


           

           


            <div class="row my-3">
                <div class="col-md-5">

                    <div class="row-ithems">
                        <label class="">Remarks<span class="Mandatory">*</span></label>

                    </div>

                </div><div class="col-md-4">

                    <div class="row-ithems">
                        @Html.TextBoxFor(m => m.DetagRemarks, new { @class = "form-control form-control-sm", @placeholder = "", maxlength = "250", @onblur = "validate(this,'RemarksEntered')" })
                        <span id="RemarksEntered"></span>
                    </div>

                </div>
            </div>

        </div>







    </div>





    <div class="row ">

        <div class="col-md-12 align-right">
            <button type="button" onclick="onSubmit()"
                    class="btn btn-default float-right mobile-full-width">

                Detag
            </button>

        </div>

    </div>











    <!--end::Row-->
    <!--begin::Row-->
    <!--end::Row-->
    <!--end::Dashboard-->
}
