 @model Hrms.Lite.Shared.TimeOffice.AbscondingIntimation
<script src="~/js/settings.js"></script>
<script src="~/js/tooltip.js"></script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table  AbscondingIntimation">

    <table class="common-table">
        <thead>
            <tr class="table-dark">
                @*<th scope="col">ID</th>*@
                <th scope="col"data-bs-toggle="tooltip" data-bs-original-title="Absconding Date">Abs. Date</th>
                <th scope="col">Employee ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col"data-bs-toggle="tooltip" data-bs-original-title="Functional Designation">Fun. Designation</th>
                <th scope="col">Status</th>
                <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Communication Method">Com. Method</th>
                <th scope="col">Remarks</th>
                <th scope="col">Intimated Authority</th>
                <th scope="col">View</th>


            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.IntimationList != null && Model.IntimationList.Count > 0)
            {
                for (int i = 0; i < Model.IntimationList.Count; i++)
                {
            <tr>
                <td data-label="E:DOJ">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.IntimationList[i].AbscondingDate))</td>
                <td data-label="Designation">@Model.IntimationList[i].EmployeeID</td>
                <td data-label="Candidate Name">
                    @Html.HiddenFor(m => m.IntimationList[i].EmployeeGI)
                    @Model.IntimationList[i].EmployeeName
                </td>

                <td data-label="Designation">@Model.IntimationList[i].Designation</td>
                <td data-label="department">@Model.IntimationList[i].FunctionalDesignation</td>
                <td data-label="Location">@Model.IntimationList[i].Status</td>
                <td data-label="Due Days">@Model.IntimationList[i].CommunicatedMethod</td>
                <td data-label="Due Days">@Model.IntimationList[i].Remarks</td>
                <td data-label="Due Days">@Model.IntimationList[i].EntryEmployeeName</td>
                
                    <td data-label="Action">
                    <div class="d-flex ">


                        <a id="mrfrequestlist" type="button" class="btn btn-default  mobile-full-width  m-0" onclick="View('@Model.IntimationList[i].EmployeeGI')">
                            View
                        </a>
                        <div id="AddNewLoanRequestSlider">


                        </div>

                        @*<a data-bs-toggle="tooltip" title="Approve" class="btn_approve" onclick="approveSubmit('@Model.AbscondingIntimationList[i].EmployeeGI')"></a>
            <a data-bs-toggle="tooltip" title="Reject" class="btn_reject" onclick="confirmRejectIconClick('@Model.AbscondingIntimationList[i].EmployeeGI')"> </a>*@


                    </div>

                </td>




            </tr>
                }
            }


        </tbody>
    </table>



</div>