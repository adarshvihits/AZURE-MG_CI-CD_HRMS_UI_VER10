@model Hrms.Lite.Shared.TimeOffice.ManualCOFFCredit
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>

<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/TimeOffice/ManualCOFFCredit.js"></script>
<script>
    $(document).ready(function () {
        fillData();
    });
</script>

<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Manual COFF Credit</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Manual COFF Credit
                    </li>

                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <!--begin: Search Form-->
                    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "ManualCOFFCredit", enctype = "multipart/form-data" }))
                    {
                    <div class="row tab-style-button">


                      

                        <div class="tab-button-wrap">
                            @*<div class="tab-items border-none">
                                <div class="form-group filter-combobox mr-4 float-left" style="width: 150px;">
                                    @Html.DropDownListFor(m => Model.LeaveGroup.Code, (SelectList)ViewBag.group, "--Leave Group--", new { @class = "form-control form-control-sm", @onchange = "fillData();" })
                                    <span id="pgroup"></span>
                                </div>

                            </div>*@


                            <div class="tab-items select-option">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="Export to Excel" onclick="ExportToExcel()"
                                   class="btn btn-excel mr-0">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>

                            </div>
                        </div>
                    </div>
                    }
                    <!-- Table Section -->
                    <div id="ManualCOFFCreditList">
                        @await Html.PartialAsync("_ManualCOFFCreditList")
                    </div>
                    <div id="editManualCOFFCredit"></div>
             

                    <div class="row card-footer-bottom-fixed">
                   

                    </div>

                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
                    </div>
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
<!--end::Content-->