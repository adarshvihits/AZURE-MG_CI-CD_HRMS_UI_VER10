@model Hrms.Lite.Shared.TimeOffice.DailyAttendanceEntry

    <script>
        $(document).ready(function () {
            moveCursorToEnd('BatchUpDate_FirstHalfOld_Code');
        });
    </script>

@using (Html.BeginForm(null, null, FormMethod.Post, new {@id="dailyAttendanceBatch"}))
{

    <div  id="BatchUpdate"  class="slider-forms slider-forms-open BatchUpdateDaily">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('BatchUpdateDaily')"><i class="ki ki-close icon-xs text-muted"></i></div>
            <h4>
                Batch Update
            </h4>
            <div class="row">
                <div class="col-md-12">
                    <div class="row-outer">
                        <label class="view-title">Date</label>
                        <div class="view-details">
                            @Html.HiddenFor(m => m.BatchUpDate.Date)
                            @Html.HiddenFor(m => m.PayrollGroup.Code)

                            @Model.BatchUpDate.Date.ToString("dd-MMM-yyyy")

                        </div>
                    </div>
                </div>
            </div>
            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>First Half Old Status</label>
                     
                        @Html.DropDownListFor(m => Model.BatchUpDate.FirstHalfOld.Code, (SelectList)ViewBag.AttendenceStatus, "--Select--", new { @class = "form-control form-control-sm", @onchange= "validate(this,'fOld'),ValidateStatus(this,'FirstOld')" })
                        <span id="fOld"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>First Half New Status</label>
                       
                        @Html.DropDownListFor(m => Model.BatchUpDate.FirstHalfNew.Code, (SelectList)ViewBag.AttendenceStatus, "--Select--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'fNew'),ValidateStatus(this,'FirstNew')" })
                        <span id="fNew"></span>


                    </div>
                </div>
            </div>

            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Second Half Old Status</label>
                      

                        @Html.DropDownListFor(m => Model.BatchUpDate.SecondHalfOld.Code, (SelectList)ViewBag.AttendenceStatus, "--Select--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'sOld'),ValidateStatus(this,'SecOld')" })
                        <span id="sOld"></span>

                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Second Half New Status</label>
                    

                        @Html.DropDownListFor(m => Model.BatchUpDate.SecondHalfNew.Code, (SelectList)ViewBag.AttendenceStatus, "--Select--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'sNew'),ValidateStatus(this,'SecNew')" })
                        <span id="sNew"></span>

                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label>Remarks</label>
                       
                        @Html.TextAreaFor(m => m.BatchUpDate.Remarks, new { @class = "form-control form-control-sm", @placeholder = "Remarks" })
                    </div>
                </div>
            </div>



            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    <button type="button" class="btn btn-default  mobile-full-width" onclick="return dailyAttendanceBatchUpdateSave('@Model.BatchUpDate.Date.ToString("yyyy-MM-dd")')">
                        Update
                    </button>
                </div>

            </div>
        </div>
    </div>
}
