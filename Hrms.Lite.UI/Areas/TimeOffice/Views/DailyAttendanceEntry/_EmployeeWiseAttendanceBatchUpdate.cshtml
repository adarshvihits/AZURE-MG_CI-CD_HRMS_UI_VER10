@model Hrms.Lite.Shared.TimeOffice.DailyAttendanceEntry
<script src="~/js/bootstrap-datepicker.js"></script>
<script>   
    $(document).ready(function () {
        $('#Employee_DailyAttendanceBatchUpdate_From').focus();
        $("#Employee_DailyAttendanceBatchUpdate_From").datepicker('hide');
    });   
</script>
<style>
    .datepicker table tr td.disabled, .datepicker table tr td.disabled:hover {
        visibility: hidden !important;
    }
</style>
    @using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "empAttendanceBatch",onsubmit= "return validateBatchUpdate()" }))
    {
        <div class="slider-forms slider-forms-open BatchUpdateEmp">
            <div class="slider-inner-style">
                <div class="slider-form-close" onclick="CloseSlider('BatchUpdateEmp')"><i class="ki ki-close icon-xs text-muted"></i></div>
                <h4>
                    Batch Update
                </h4>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Month</label>
                            <div class="view-details">
                                @Html.HiddenFor(m => m.Employee_DailyAttendanceBatchUpdate.EmployeeGI)
                                @Html.HiddenFor(m => m.Employee_DailyAttendanceBatchUpdate.Month.Name)
                                @Model.Employee_DailyAttendanceBatchUpdate.Month.Name
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">PayRoll Group</label>
                            <div class="view-details">
                                @Model.Employee_DailyAttendanceBatchUpdate.PayrollGroup.Name
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>From</label>
                            <span class="Mandatory">*</span>
                            <div class="input-group date">
                                @Html.TextBoxFor(m => m.Employee_DailyAttendanceBatchUpdate.From, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_11", @placeholder = "Date", @autocomplete = "off", @readonly = true,
                               @onclick = "$('#Employee_DailyAttendanceBatchUpdate_From').datepicker('show');", @onchange = "validate(this,'da_emp_from')"
                           })
                                <span id="from"></span>
                                <div class="input-group-append">
                                    <span class="input-group-text">
                                        <i class="la la-calendar"></i>
                                    </span>
                                </div>
                            </div>
                            <span id="da_emp_from"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>To</label>
                            <span class="Mandatory">*</span>
                            <div class="input-group date">
                                @Html.TextBoxFor(m => m.Employee_DailyAttendanceBatchUpdate.To, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_11", @placeholder = "Date", @autocomplete = "off", @readonly = true,
                               @onchange = "validateToDate(this,'da_emp_to')" })
                                <span id="to"></span>
                                <div class="input-group-append">
                                    <span class="input-group-text">
                                        <i class="la la-calendar"></i>
                                    </span>
                                </div>
                            </div>
                            <span id="da_emp_to"></span>
                        </div>
                    </div>
                </div>



                <div class="row">

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>First Half</label>
                            <span class="Mandatory">*</span>
                            @Html.DropDownListFor(m => Model.Employee_DailyAttendanceBatchUpdate.FirstHalf.Code, (SelectList)ViewBag.AttendenceStatus, "--Select--", new { @class = "form-control form-control-sm",@onchange = "validate(this,'da_emp_first'), ValidateStatus(this,'fstHlf')" })
                            <span id="da_emp_first"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Second Half</label>
                            <span class="Mandatory">*</span>
                            @Html.DropDownListFor(m => Model.Employee_DailyAttendanceBatchUpdate.SecondHalf.Code, (SelectList)ViewBag.AttendenceStatus, "--Select--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'da_emp_second'),ValidateStatus(this,'scnHlf')" })
                            <span id="da_emp_second"></span>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label>Remarks</label>
                            @Html.TextAreaFor(m => m.Employee_DailyAttendanceBatchUpdate.Remarks, new { @class = "form-control form-control-sm", @placeholder = "Remarks" ,@maxlength="250"})


                        </div>
                    </div>
                </div>




                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">
                        <a type="button" class="btn btn-default  mobile-full-width" onclick="return EmployeedailyAttendanceBatchUpdateSave()">
                            Update
                        </a>
                    </div>

                </div>
            </div>
        </div>

    }