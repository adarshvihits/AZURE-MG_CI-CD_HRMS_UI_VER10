
@model Hrms.Lite.Shared.TimeOffice.MonthlyAttendanceProcessing
<div class="content content-background-remove d-flex flex-column flex-column-fluid" id="kt_content">
    @*begin::Entry*@
    <div class="d-flex flex-column-fluid">
        @*begin::Container*@
        <div class="container full-width">
            @*begin::Dashboard
                begin::Row*@

            <div class="row ">

                <div class="col-md-12">
                    <div>

                        <div class="card-body p-5 pb-13 pt-0">

                            <div class="step-outer pb-10 mt-0 step_row">
                                <a class="step-item active" onclick="onTabNameClick('map_Selection',0)">
                                    Selection
                                    <span class="step-circle"></span>
                                </a>
                                <a class="step-item active">
                                    Attendance Settings
                                    <span class="step-circle"></span>
                                </a>
                                <a class="step-item">
                                    Attendance Status
                                    <span class="step-circle"></span>
                                </a>
                                <a class="step-item">
                                    Leave
                                    <span class="step-circle"></span>
                                </a>
                                <a class="step-item">
                                    Attendance Wages
                                    <span class="step-circle"></span>
                                </a>
                                <a class="step-item">
                                    Attendance Processing
                                    <span class="step-circle"></span>
                                </a>

                            </div>
                            <div class="page_white" style="padding: 10px 23px 10px; margin-bottom: 17px; ">

                                <div class="row my-2">
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label class="view-title">Payroll Group </label>
                                            <div class="view-details">
                                                @Model.PayrollGroup.Name
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label class="view-title">Month </label>
                                            <div class="view-details">
                                                @Model.Month.Name
                                            </div>
                                        </div>
                                    </div>


                                </div>
                            </div>
                            <div class="ihits-table table-border  mobile-responsive-table attendance-setting-list vertical-scroll-200">
                                <table>
                                    <thead>
                                        <tr class="table-dark">
                                            <th scope="col">Attendance Settings</th>
                                            <th scope="col">Count</th>

                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.MonthlyAttendanceProcessing_Validations != null && Model.MonthlyAttendanceProcessing_Validations.Count > 0)
                                        {

                                            for (int i = 0; i < Model.MonthlyAttendanceProcessing_Validations.Count; i++)
                                            {
                                                <tr>
                                                    <td data-label="Attendance Settings">@Model.MonthlyAttendanceProcessing_Validations[i].Description</td>
                                                    @*<td data-label="Count">@Model.MonthlyAttendanceProcessing_Validations[i].Count</td>*@

                                                    




                                                        <td data-label="Count">
                                                            <a onclick="GetPopUp('@Model.MonthlyAttendanceProcessing_Validations[i].SlNo', '@Model.MonthlyAttendanceProcessing_Validations[i].Description','ATTENDANCE_SETTINGS')">@Model.MonthlyAttendanceProcessing_Validations[i].Count</a>




                                                        </td>
                                                    
                                                </tr>


                                            }
                                        }

                                    </tbody>
                                </table>
                            </div>

                            <end table></end>

                        </div>

                    </div>
                </div>
            </div>




            @*end::Row
                begin::Row
                end::Row
                end::Dashboard*@
        </div>
        @*end::Container*@
    </div>
    @*end::Entry*@
</div>

<div class="row card-footer-bottom-fixed">

    <div class="col-md-12">
        <a onclick="onNextClick('map_Status', 2)"
           class="btn btn-default float-right mobile-full-width">
            Next
        </a>
    </div>

</div>





