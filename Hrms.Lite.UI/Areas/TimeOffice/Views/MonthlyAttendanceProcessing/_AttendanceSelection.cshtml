
@model Hrms.Lite.Shared.TimeOffice.MonthlyAttendanceProcessing




<div class="ihits-table table-border vertical-scroll-90-per mobile-responsive-table attendance-selection-list vertical-scroll-250">
    <table>
        <thead>
            <tr class="table-dark">
                <th scope="col">Selection</th>
                <th scope="col">Count</th>


            </tr>
        </thead>
        <tbody>
            @if (Model.MonthlyAttendanceProcessing_Validations != null && Model.MonthlyAttendanceProcessing_Validations.Count > 0)
            {

                for (int i = 0; i < Model.MonthlyAttendanceProcessing_Validations.Count; i++)
                {
                    <tr>
                        <td data-label="Selection">@Model.MonthlyAttendanceProcessing_Validations[i].Description</td>
                        <td data-label="Count">@Model.MonthlyAttendanceProcessing_Validations[i].Count  </td>
                    </tr>
                }


            }

        </tbody>
    </table>
</div>

