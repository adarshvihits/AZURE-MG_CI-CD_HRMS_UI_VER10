@model Hrms.Lite.Shared.TimeOffice.MonthlyAttendanceProcessing
    <div class="row tab-style-button">
        <div class="tab-button-wrap">
            <div class="tab-items select-option">


                <div class="sraech-slider">
                    <div class="search-slider-inner">
                        <i class="fa fa-search"></i>
                    </div>
                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                           placeholder="ID/Name">
                </div>

                <a data-bs-toggle="tooltip" title="Export to Excel" onclick="ExportToExcel_PopUp()"
                   class="btn btn-excel">
                    <i class="icon-xl far fa-file-excel"></i>
                </a>
            </div>
            </div></div>
            <div style="padding:10px;" class="ihits-table table-border hover-color odd-even mobile-responsive-table attend_processing_pending">
                @Html.HiddenFor(m => m.AttendanceApprovalPending_popup.Count)

                <table id="attApprPendingTable">
                    <thead>
                        <tr class="table-dark">
                            <th scope="col">ID</th>
                            <th scope="col">Employee Name</th>

                            <th scope="col">Department</th>
                            <th scope="col">Location</th>
                            <th scope="col">Type</th>
                            <th scope="col">From Date</th>
                            <th scope="col">To Date</th>
                            <th scope="col">Authority</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>


                </table>
            </div>
