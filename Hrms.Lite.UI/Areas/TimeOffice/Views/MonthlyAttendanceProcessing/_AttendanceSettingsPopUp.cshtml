

@model Hrms.Lite.Shared.TimeOffice.MonthlyAttendanceProcessing

<script src="~/js/settings.js"></script>
<style>
    .dataTables_scrollBody {
        height: 30vh !important;
    }
</style>
<script>

    $(".search-slider-inner").click(function () {
        $(".form-control").toggleClass('field-width-big')
    });

</script>

<div class="row tab-style-button">
    <div class="tab-button-wrap align-items-center">





        <div class="tab-items">

        </div>



        <div class="tab-items select-option high">


            @*<div class="sraech-slider">



            <div class="search-slider-inner">
                <i class="fa fa-search" onclick="$('#searchList').focus();"></i>
            </div>
            <input id="searchList" type="text" class="form-control form-control-sm"
                   placeholder="ID/Name" onkeyup="EmployeeSearch('SettingsPopUpTable')">
        </div>*@

            <div class="sraech-slider">
                <div class="search-slider-inner">
                    <i class="fa fa-search"></i>
                </div>
                <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                       placeholder="ID/Name">
            </div>


            <button data-bs-toggle="tooltip" title=""
                    class="btn btn-excel"
                    data-bs-original-title="Export to Excel" onclick="ExportToExcelPopUp('SettingsPopUpTable')">
                <i class="icon-xl far fa-file-excel"></i>
            </button>

        </div>


    </div>
</div>




<div style="padding:10px;" class="ihits-table table-border hover-color odd-even mobile-responsive-table">
    @Html.HiddenFor(m => m.MonthlyAttendanceProcessing_Validations_popup.Count)

    <table id="SettingsPopUpTable" class="common-table">
        <thead>
            <tr class="table-dark">
                @if (ViewBag.RowName == "Daily Attendance Processing Pending Days")
                {
                    <th scope="col">sl.No</th>
                    <th scope="col">Date</th>

                }
                else
                {
                    <th scope="col">ID</th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">Designation</th>
                    <th scope="col">Department</th>
                    <th scope="col">Location</th>
                }






            </tr>
        </thead>
        <tbody>
            @if (Model.MonthlyAttendanceProcessing_Validations_popup != null && Model.MonthlyAttendanceProcessing_Validations_popup.Count > 0)
            {
                for (int i = 0; i < Model.MonthlyAttendanceProcessing_Validations_popup.Count; i++)
                {
                    <tr>
                        @if (ViewBag.RowName == "Daily Attendance Processing Pending Days")
                        {
                            <td data-label="slno">
                                @Model.MonthlyAttendanceProcessing_Validations_popup[i].SlNo
                            </td>
                            <td data-label="date">
                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.MonthlyAttendanceProcessing_Validations_popup[i].PendingDates))
                            </td>

                        }
                        else
                        {
                            <td data-label="ID">
                                @Model.MonthlyAttendanceProcessing_Validations_popup[i].EmployeeID
                            </td>
                            <td data-label="Employee Name">
                                @Model.MonthlyAttendanceProcessing_Validations_popup[i].FullName

                            </td>
                            <td data-label="Designation">@Model.MonthlyAttendanceProcessing_Validations_popup[i].Designation</td>
                            <td data-label="Department">
                                @Model.MonthlyAttendanceProcessing_Validations_popup[i].Department
                            </td>
                            <td data-label="Location">@Model.MonthlyAttendanceProcessing_Validations_popup[i].Location</td>
                        }


                    </tr>


                }
            }
        </tbody>


    </table>
</div>
