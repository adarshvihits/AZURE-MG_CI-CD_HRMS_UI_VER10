                                            @Html.DropDownListFor(Model => Model.Month.Code, (SelectList)ViewBag.month, "--Select--", new { @class = "form-control form-control-sm month", @onchange = "validate(this,'month')", @style = "width:150px; " })
                                            <span id="month"></span>
                                        </div>

                                    </div>

                                    <div class="tab-items d-flex align-items-center">
                                        <div class="d-flex align-center pt-4">
                                            <a href="#" type="button"
                                               class="btn btn-default float-right mobile-full-width" onclick="onNextClick('map_Settings', 1)">
                                                Proceed
