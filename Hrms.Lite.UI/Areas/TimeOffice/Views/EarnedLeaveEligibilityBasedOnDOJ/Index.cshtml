@model Hrms.Lite.Shared.TimeOffice.EarnedLeaveEligibility

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


}

<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>
<script src="~/scripts/TimeOffice/EarnedLeaveEligibilityBasedOnDOJ.js"></script>
<script>
    $(document).ready(function () {

        $('.NotConfirmedTabCount').html("@Model.Count_NotConfirmed");
        $('.ConfirmedTabCount').html("@Model.Count_Confirmed");
       
        //$('.search-profile-details').hide(300);


    });

</script>

@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "Earned_Leave_Based_onDOJ" }))
{

    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->


            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Earned Leave Eligibility Based On DOJ</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            Earned Leave Eligibility Based On DOJ
                        </li>

                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <div class="d-flex flex-column-fluid">
            <div class="container full-width">
                <div class="card card-custom height-100per footer-row-fixed">
                    <div class="card-body">
                        <div class="row tab-style-button">
                            <div class="tab-button-wrap">

                                <div class="tab-items low">
                                    <span class="btn-title all active tab1" onclick="Tab('tab1','0')">
                                        Not Confirmed
                                        <span class="btn-notification active NotConfirmedTabCount">@Model.Count_NotConfirmed</span>
                                    </span>

                                </div>
                                <div class="tab-items medium">

                                    <span class="btn-title tab2" onclick="Tab('tab2', '1')">
                                        Confirmed
                                        <span class="btn-notification ConfirmedTabCount">@Model.Count_Confirmed</span>
                                    </span>
                                </div>
                                <div class="tab-items select-option">

                                    <div class="form-group filter-combobox filterList">

                                        @Html.DropDownListFor(m => m.Month.Code, (SelectList)ViewBag.Month, "--Select Month--", new { @class = "form-control form-control-sm month", @onchange = "getLeave(this)" })
                                    </div>
                                    <div class="form-group filter-combobox filterList">

                                        @Html.DropDownListFor(m => m.Leave.Code, (SelectList)ViewBag.Leave, "--Select Leave--", new { @class = "form-control form-control-sm leave", @onchange = "fillData()" })
                                    </div>
                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>
                                    <div class="filter-button slider-btn" id="filterForm" data-bs-toggle="tooltip" title="Filter">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>
                                    <a data-bs-toggle="tooltip" title="Export to Excel"
                                       class="btn btn-excel mr-0" onclick="ExportToExcel()">
                                        <i class="icon-xl far fa-file-excel"></i>
                                    </a>


                                    <button type="button" data-bs-toggle="tooltip" title="Import From Excel" onclick="validateEarnedLeaveEligibility_Import()" class="btn btn-excel ml-0 import">
                                        <i class="fa fa-upload icon-xls" aria-hidden="true"></i>
                                    </button>


                                </div>
                                <div class="modal fade MAU_ExcelDiv" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-lg">
                                        <div class="modal-content popup">
                                            <div class="modal-header" style="padding:10px">
                                                <h5 class="modal-title" id="exampleModalLabel">Upload Format</h5>
                                                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close" onclick="$('#Unmatchedlist').html('');$('#Excel_FileData').val()">
                                                    <i aria-hidden="true" class="ki ki-close"></i>
                                                </button>
                                            </div>

                                            <div class="modal-body pt-3">
                                                <div class="colums_list pb-1">
                                                    Please ensure your Excel file contains the following columns with the exact headings. Spelling and case must match precisely for a successful import -

                                                    Employee ID,
                                                    Employee Name,
                                                   Opening<br />

                                                </div>
                                                <div class="row">
                                                    <div class="col-md-4">
                                                        <div class="file-upload-form-group">
                                                            <label for="formFileMultiple" class="form-label">
                                                                Attach
                                                                File
                                                                <span class="Mandatory">*</span>
                                                            </label>

                                                            <div class="file-upload-form mb-1" data-bs-toggle="tooltip" data-bs-original-title=" Only pdf, doc, docx files are
                                            allowed , File size less than 1 MB.">
                                                                <div class="small-btn-group">

                                                                    <button type="button" data-bs-toggle="tooltip" data-placement="top" data-bs-original-title="View Image" class="btn btn-icon btn-default"><i class="icon-xl far fa-eye"></i></button>

                                                                </div>
                                                                <input id="File_AbsoluteUri" name="File.AbsoluteUri" type="hidden" value="">
                                                                @Html.HiddenFor(model => model.Excel.FileData, new { type = "file", @class = "input-file PreviewImage form-control h-100", @onchange = "onImportExcelClick()" })
                                                            </div>


                                                        </div>


                                                    </div>

                                                </div>

                                                <div id="Unmatchedlist">

                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>




                        <!-- Table Section -->
                        <div id="ELBasedOnDOJList">
                            @await Html.PartialAsync("_List")
                        </div>
                        <!-- Table Setion End -->
                        <div class="row card-footer-bottom-fixed">
                            <div class="col-md-12 align-right" id="El_Conf_ConfirmBtn">
                                <a type="button" id="confirmdeletebtn"  class="btn btn-default float-right mobile-full-width" onclick="EarnedLeaveEligibilitySave('Confirm')">
                                    Confirm
                                </a>

                            </div>
                        </div>


                    </div>
                </div>
            </div>
        </div>
    </div>
}
<div id="filterSlider">
    @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
</div>