
@model Hrms.Lite.Shared.TimeOffice.HRAbsentRegularization
@{
 
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/TimeOffice/hrAbsentRegularization.js"></script>


<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    HR Absent Regularization

                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                        </li>
                    <li class="breadcrumb-item text-muted">
                        HR Absent Regularization

                    </li>

                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">


                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">

                            @using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "HR_Abscent_Form" }))
                            {
                                <div class="d-flex">
                                    <div class="tab-items">
                                        <div class="form-group filter-combobox mr-3">
                                            @Html.DropDownListFor(m => m.PGroup.Code, (SelectList)ViewBag.PGroup, "--Select Payroll Group--", new { @class = "form-control form-control-sm", @style = "width: 170px;", @onchange = "fillMonth();fillData()" })

                                        </div>
                                    </div>
                                    <div class="tab-items">
                                        <div class="form-group filter-combobox mr-3">
                                            @Html.DropDownListFor(m => m.Month.Code, (SelectList)ViewBag.Month, "--Select Month--", new { @class = "form-control form-control-sm", @style = "width: 170px;",
                                           @onchange = "$('#hrAbscentHiidenTable tbody tr').remove();fillData();" })

                                        </div>
                                    </div>
                                    <div class="tab-items">
                                        <div class="form-group filter-combobox mr-3">
                                            @Html.DropDownListFor(m => m.Leave.Code, (SelectList)ViewBag.Leave, "--Select Leave--", new { @class = "form-control form-control-sm",
                                           @style = "width: 170px;", @onchange = "$('#hrAbscentHiidenTable tbody tr').remove();fillData();" })

                                        </div>
                                    </div>
                                </div>
                                <div id="testOT" class="hide">
                                    <table id="hrAbscentHiidenTable">
                                        <thead>
                                            <tr class="table-dark">
                                                <th scope="col">Employee ID</th>
                                                <th scope="col">Employee Name</th>
                                                <th scope="col">Designation</th>
                                                <th scope="col">Department</th>
                                                <th scope="col">Location </th>
                                                <th scope="col">Abscent Count</th>
                                                <th scope="col">Leave Balance</th>
                                                <th scope="col">
                                            </tr>
                                        </thead>
                                        <tbody>
                                        </tbody>
                                    </table>
                                </div>



                            }
                            <div class="tab-items select-option">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>

                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left" data-bs-original-title="Export to Excel" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>


                            </div>
                        </div>

                    </div>
                    <div id="HRAtt_List">
                        @await Html.PartialAsync("_EmpList", Model)
                    </div>

                  

                    <div id="filterSlider">

                        @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
                    </div>
                    <div class="row card-footer-bottom-fixed">
                        <div class="col-md-12">                          

                            <a onclick="regularize()"
                               class="btn btn-default float-right mobile-full-width">
                               Regularize
                            </a>
                        </div>

                    </div>

                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>

<div class="modal fade hrAbscentPopup" tabindex="-1" role="dialog"
     aria-labelledby="myLargeModalLabel" aria-hidden="true" style="display: none;" data-backdrop="static" >
    <div class="modal-dialog modal-lg" style="max-width:800px;">
        <div id="myDiv" class="modal-content popup" style=" margin: 7% auto;">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Abscent Regularization</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body"  style=" padding: 5px 20px;">



            </div>
        </div>
    </div>
</div>
