@model Hrms.Lite.Shared.TrainingModule.TrainingReport
@*<script src="~/js/settings.js"></script>*@
@*<link href="~/css/tablestyle.css" rel="stylesheet" />
    <link href="~/css/custom.css" rel="stylesheet" />
    <link href="~/css/style.bundle.css" rel="stylesheet" />*@
@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "SaveService" }))
{
    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table   Employee-Selection-poup  vertical-scroll-250">

        @Html.HiddenFor(m => m.TrainingReportList.Count)


        <table id="TRNPARTICIPANTTable">
            <thead>
                <tr class="table-dark">
                    <th scope="col">ID</th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">Designation</th>
                    <th scope="col">Department</th>
                    <th scope="col">Location</th>
                    <th scope="col">DOJ</th>

                    <th scope="col">
                       
                       
                    </th>

                </tr>
            </thead>
            <tbody>
                @{
                    if (Model.TrainingReportList != null && Model.TrainingReportList.Count > 0)

                    {
                        for (int i = 0; i < Model.TrainingReportList.Count; i++)

                        {

                            <tr>
                                @*<td data-label="EmployeeID">
                                    @Model.TrainingReportList[i].EmployeeID
                                    @Html.HiddenFor(m => m.TrainingReportList[i].EmployeeCode)
                                  
                                </td>
                                <td data-label="Name">@Model.TrainingReportList[i].EmployeeName </td>
                                <td data-label="Designation">@Model.TrainingReportList[i].Designation </td>
                                <td data-label="Department">@Model.TrainingReportList[i].Department</td>
                                <td data-label="Location">@Model.TrainingReportList[i].Location</td>
                                <td data-label="DOJ">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.TrainingReportList[i].DOJ))</td>

                                <td data-label="DOJ">
                                    <label class="checkbox checkbox-outline checkbox-success">
                                        @Html.CheckBoxFor(m => m.TrainingReportList[i].applicable)

                                        <span id="checkbx"></span>
                                    </label>
                              
                                </td>*@

                               

                            </tr>
                        }
                    }
                }
            </tbody>





        </table>

        <div class="row pt-10 align-right pb-2">

            <div class="col-md-12">

                <button type="button" class="btn btn-default mobile-full-width" onclick="Save()">
                    Save
                </button>


            </div>

        </div>



    </div>

}