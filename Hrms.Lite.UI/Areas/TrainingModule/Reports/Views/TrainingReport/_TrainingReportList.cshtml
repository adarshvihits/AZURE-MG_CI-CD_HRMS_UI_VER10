@model Hrms.Lite.Shared.TrainingModule.TrainingReport
<script src="~/js/settings.js"></script>


<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Trainingmodule_Report_list">

    @Html.HiddenFor(m => m.TrainingReportList.Count)

    <table id="TrainingReportTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">Sl.No</th>
                <th scope="col">Schedule</th>
                <th scope="col">Start Date</th>
                <th scope="col">End Date</th>
                <th scope="col">Count</th>
                <th scope="col">Cost</th>
                <th scope="col">Duration</th>
               
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.TrainingReportList != null && Model.TrainingReportList.Count > 0)
                {
                    for (int i = 0; i < Model.TrainingReportList.Count; i++)

                    {
                        <tr>
                            @*<td data-label="EmployeeID">
            @Model.MonthlyReportList[i].EmployeeID
        </td>*@

                            <td>@(i+1)</td>
                            <td data-label="Schedule">@Model.TrainingReportList[i].Schedule </td>
                            <td data-label="Start Date"> @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.TrainingReportList[i].StartDate))</td>
                            <td data-label="EndDate"> @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.TrainingReportList[i].EndDate))</td>
                            <td data-label="Count">@Model.TrainingReportList[i].Count</td>
                            <td data-label="Cost">@Model.TrainingReportList[i].TotalCost</td>
                            <td data-label="Duration">@Model.TrainingReportList[i].Duration</td>

                        </tr>
                    }
                }
            }
        </tbody>





    </table>





</div>
