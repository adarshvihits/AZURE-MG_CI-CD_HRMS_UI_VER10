@model Hrms.Lite.Shared.TrainingModule.TrainingCostReport
<script src="~/js/settings.js"></script>


<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Trainingcost_Report_list">

    @Html.HiddenFor(m => m.TrainingCostReportList.Count)

    <table id="TrainingReportTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">Sl.No</th>
                <th scope="col">Schedule</th>
                <th scope="col">Total Trainees</th>
                <th scope="col">Duration</th>
                <th scope="col">Trainer Cost</th>
                <th scope="col">Training Cost</th>
                <th scope="col">Trainee Cost</th>
                <th scope="col">Total Cost</th>
                <th scope="col">Cost Per Head</th>
                <th scope="col">Man Hours</th>

            </tr>
        </thead>
        <tbody>
            @{
                if (Model.TrainingCostReportList != null && Model.TrainingCostReportList.Count > 0)
                {
                    for (int i = 0; i < Model.TrainingCostReportList.Count; i++)

                    {
                        <tr>
                            @*<td data-label="EmployeeID">
            @Model.MonthlyReportList[i].EmployeeID
        </td>*@

                            <td>@(i+1)</td>
                            <td data-label="Schedule">@Model.TrainingCostReportList[i].Schedule </td>
                            <td data-label="Cost">@Model.TrainingCostReportList[i].TotalTrainees</td>
                            <td data-label="Duration">@Model.TrainingCostReportList[i].Duration</td>
                            <td data-label="Count">@Model.TrainingCostReportList[i].Trainercost</td>
                            <td data-label="Cost">@Model.TrainingCostReportList[i].TrainingCost</td>
                            <td data-label="Duration">@Model.TrainingCostReportList[i].TraineeCost</td>
                            <td data-label="Count">@Model.TrainingCostReportList[i].TotalCost</td>
                            <td data-label="Cost">@Model.TrainingCostReportList[i].CostPerHead</td>
                            <td data-label="Duration">@Model.TrainingCostReportList[i].ManHours</td>

                        </tr>
                    }
                }
            }
        </tbody>





    </table>





</div>
