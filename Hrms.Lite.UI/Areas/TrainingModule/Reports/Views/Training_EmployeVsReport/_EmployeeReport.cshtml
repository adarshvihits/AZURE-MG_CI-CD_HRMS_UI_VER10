@model Hrms.Lite.Shared.TrainingModule.Training_EmployeVsReport



<div class="ihits-table table-border hover-color odd-even mobile-responsive-table TrainingEmployeeReportTable-list">

    @Html.HiddenFor(m => m.TrainingEmployeeReportList.Count)

    <table id="TrainingEmployeeReportTable">
        <thead>
            <tr class="table-dark">
                <th scope="col">Category</th>
                <th scope="col">Training</th>
                <th scope="col">From</th>
                <th scope="col">To</th>
                <th scope="col">Training Location</th>
                <th scope="col">Trainer</th>
                <th scope="col">Cost</th>
                <th scope="col">Hours</th>
                <th scope="col">Status</th>

            </tr>
        </thead>
        <tbody>
            @{
                if (Model.TrainingEmployeeReportList != null && Model.TrainingEmployeeReportList.Count > 0)
                {
                    for (int i = 0; i < Model.TrainingEmployeeReportList.Count; i++)

                    {
                        <tr>
                            @*<td data-label="EmployeeID">
            @Model.MonthlyReportList[i].EmployeeID
        </td>*@


                            <td data-label="Category">@Model.TrainingEmployeeReportList[i].Category </td>

                            <td data-label="Training">@Model.TrainingEmployeeReportList[i].Training</td>
                            @*<td data-label="From">@Model.TrainingEmployeeReportList[i].From</td>*@
                            <td data-label="From">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.TrainingEmployeeReportList[i].From))
                            <td data-label="To">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.TrainingEmployeeReportList[i].To))
                          

                            <td data-label="Training Location">@Model.TrainingEmployeeReportList[i].TrainingLocation</td>
                            <td data-label="Trainer">@Model.TrainingEmployeeReportList[i].Trainer</td>
                            <td data-label="Cost">@Model.TrainingEmployeeReportList[i].Cost</td>
                            <td data-label="Hours">@Model.TrainingEmployeeReportList[i].Hours</td>
                            <td data-label="Status">@Model.TrainingEmployeeReportList[i].Status</td>
                        </tr>
                    }
                }
            }
        </tbody>





    </table>





</div>

