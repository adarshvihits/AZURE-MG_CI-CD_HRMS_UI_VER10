<div class="row tab-style-button">
    <div class="tab-button-wrap">




        <div class="tab-items select-option">



            <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-right" data-bs-original-title="Export to Excel" onclick="TrainingExportToExcel()" style=" margin-top: 0px;">
                <i class="icon-xl far fa-file-excel"></i>
            </a>

        </div>



    </div>
</div>

@Html.HiddenFor(m => m.EmployeeCode)
@Html.HiddenFor(m => m.EmployeeID)
@Html.HiddenFor(m => m.popupDTList.Count)

<div style="padding:10px;" class="ihits-table table-border hover-color odd-even mobile-responsive-table partcipantcompleted_details  vertical-scroll-200">
    @Html.HiddenFor(m => m.popupDTList.Count)

    <table id="ParticipantsCompleted">
        <thead>
            <tr class="table-dark">
                <th scope="col">Training</th>
                <th scope="col">Category</th>
                <th scope="col">Startdate</th>
                <th scope="col">EndDate</th>
                <th scope="col">Duration</th>
                <th scope="col">Cost</th>



            </tr>
        </thead>
        <tbody>

            @if (Model.popupDTList != null && Model.popupDTList.Count > 0)
            {
                for (int i = 0; i < Model.popupDTList.Count; i++)

                {
                    <tr>


                        <td data-label="ID">@Model.popupDTList[i].Trainingname</td>
                        <td data-label="Employee Name">@Model.popupDTList[i].Category</td>
                        <td data-label="Designation">@Model.popupDTList[i].StartDate</td>
                        <td data-label="Department">@Model.popupDTList[i].EndDate</td>
                        <td data-label="Department">@Model.popupDTList[i].Duration</td>
                        <td data-label="Department">@Model.popupDTList[i].Cost</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8">
                        <div style="text-align: center;display: flex;align-items: center;justify-content: center;height: 60vh;"><img src="/images/nodata.png" /></div>
                    </td>
                </tr>
            }

        </tbody>



    </table>
</div>

