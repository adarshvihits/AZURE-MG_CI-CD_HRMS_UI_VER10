@model Hrms.Lite.Shared.TrainingModule.MonthlyReport



<div class="ihits-table table-border hover-color odd-even mobile-responsive-table monthly_training_Report_list vertical-scroll-500">

    @Html.HiddenFor(m => m.MonthlyReportList.Count)


    <table id="EsiSettingsTable">
        <thead>
            <tr class="table-dark">
                <th scope="col">Training</th>
                <th scope="col">Start Date</th>
                <th scope="col">End Date</th>
                <th scope="col">Participants Selected</th>
                <th scope="col">Participants Completed</th>
                <th scope="col">Trainee Cost</th>
                <th scope="col">Trainer Cost</th>
                <th scope="col">Training Cost</th>
                <th scope="col">Total Cost</th>
                <th scope="col">Completion Status</th>

            </tr>
        </thead>
        <tbody>
            @{
                if (Model.MonthlyReportList != null && Model.MonthlyReportList.Count > 0)
                {
                    for (int i = 0; i < Model.MonthlyReportList.Count; i++)

                    {
                        <tr>


                            @*<td data-label="EmployeeID">
                                    @Model.MonthlyReportList[i].EmployeeID
                                </td>*@
                            <td data-label="Name">@Model.MonthlyReportList[i].Training </td>
                            <td data-label="Department"> @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.MonthlyReportList[i].StartDate))</td>
                            <td data-label="Department"> @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.MonthlyReportList[i].EndDate))</td>
                            <td data-label="Location">
                                <a data-bs-toggle="modal"data-target=".participantselecteddetails"   onclick="OnParticipantSelectedClick('@Model.MonthlyReportList[i].ScheduleCode','@Model.MonthlyReportList[i].Training')">
                                    @Model.MonthlyReportList[i].ParticipantsSelected
                                </a>
                            </td>
                            <td data-label="EmployeeContribution">
                                <a data-bs-toggle="modal"data-target=".participantcompleteddetails"   onclick="OnParticipantCompletedClick('@Model.MonthlyReportList[i].ScheduleCode','@Model.MonthlyReportList[i].Training')">
                                    @Model.MonthlyReportList[i].ParticipantsCompleted
                                </a>
                            </td>


                            <td data-label="EmployerContribution">@Model.MonthlyReportList[i].Traineecost</td>
                            <td data-label="EmployerContribution">@Model.MonthlyReportList[i].Trainercost</td>
                            <td data-label="EmployerContribution">@Model.MonthlyReportList[i].Trainingcost</td>
                            <td data-label="EmployerContribution">@Model.MonthlyReportList[i].Totalcost</td>
                            <td data-label="EmployerContribution">@Model.MonthlyReportList[i].Completionstatus</td>

                        </tr>
                    }
                }
            }

        </tbody>





    </table>





</div>
