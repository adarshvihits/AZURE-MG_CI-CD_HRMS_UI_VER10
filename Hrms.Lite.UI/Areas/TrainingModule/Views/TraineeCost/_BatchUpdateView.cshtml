
@model Hrms.Lite.Shared.TrainingModule.TraineeCost
<script src="~/js/tooltip.js"></script>


@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "BatchList" }))
{

    <div id="editloanissue" class="slider-forms slider-forms-open IssueSlider">
        <div class="slider-inner-style">
            <div class="slider-form-close mb-4" onclick="CloseSlider('IssueSlider')">

                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>
                Batch Update
            </h4>

            <div class="row">


                @Html.HiddenFor(m => m.EmployeeCode)

                <div class="ihits-table table-border hover-color odd-even mobile-responsive-table loan-History-Table">

                    <table id="" class="">
                        <thead>
                            <tr class="table-light">
                                <th scope="col">Cost Head</th>
                                <th scope="col">Cost</th>

                                <!--<th scope="col">-->@*Disbursement Date*@<!--</th>-->

                            </tr>
                        </thead>
                        <tbody>

                            @if (Model.Details != null && Model.Details.Count > 0)
                            {

                                for (int i = 0; i < Model.Details.Count; i++)
                                {

                                    <tr>
                                        <td data-label="Name">

                                            @Html.HiddenFor(m => Model.Details[i].CostHead)
                                            @Html.HiddenFor(m => Model.Details[i].CostHeadCode)
                                            @Model.Details[i].CostHead
                                        </td>
                                        <td>
                                            @Html.TextBoxFor(m => m.Details[i].Cost, new { @class = "form-control form-control-sm" })
                                            <!--<input class="form-control form-control-sm" id="Details_JobTitle" maxlength="50" name="Details.JobTitle"--> @*onblur="validate(this, 'jobtitle')"*@ <!--placeholder="Trainee Cost" type="text" value="">-->
                                        </td>

                                    </tr>
                                }
                            }









                        </tbody>
                    </table>
                </div>
            </div>
            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    <a type="button"
                       class="btn btn-default  mobile-full-width" onclick="BatchSave()">
                        Update
                    </a>
                </div>

            </div>

        </div>
    </div>
}