
@model Hrms.Lite.Shared.TrainingModule.TraineeCost

<script src="~/js/settings.js"></script>

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "updatelist" }))
{



    @*<script src="~/js/tooltip.js"></script>*@
    <div class="ihits-table table-border hover-color odd-even">
        <table id="test" class="common-table">
           
            <thead>
                <tr class="table-dark">
                    <th scope="col">ID</th>
                    <th scope="col">
                        Employee Name
                        @Html.HiddenFor(m => Model.TraineeCostList.Count)
                    </th>
                    <th scope="col">Designation</th>
                    <th scope="col">Department</th>
                    <th scope="col">Location</th>
                    <th scope="col">DOJ</th>
                    <th scope="col">Cost</th>
                    <th scope="col">Action</th>


                </tr>
            </thead>
            <tbody>
                @{
                    if (Model.TraineeCostList != null && Model.TraineeCostList.Count > 0)
                    {
                        for (int i = 0; i < Model.TraineeCostList.Count; i++)

                        {
                                <tr>
                                    <td data-label="EmployeeID">
                                        @Model.TraineeCostList[i].EmployeeID
                                        @Html.HiddenFor(m => Model.TraineeCostList[i].EmployeeCode)
                                        @Html.HiddenFor(m => Model.TraineeCostList[i].EmployeeGI)
                                        @Html.HiddenFor(m => Model.TraineeCostList[i].EmployeeID)
                                        @Html.HiddenFor(m => Model.TraineeCostList[i].Designation)
                                        @Html.HiddenFor(m => Model.TraineeCostList[i].Department)
                                        @Html.HiddenFor(m => Model.TraineeCostList[i].Location)
                                    </td>
                                    <td data-label="Employee Name">@Model.TraineeCostList[i].EmployeeName </td>
                                    <td data-label="Designation">@Model.TraineeCostList[i].Designation </td>
                                    <td data-label="Department">@Model.TraineeCostList[i].Department</td>
                                    <td data-label="Location">@Model.TraineeCostList[i].Location</td>
                                    <td data-label="DOJ">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.TraineeCostList[i].DOJ))</td>
                                    <td data-label="Status">@Model.TraineeCostList[i].Traineecost</td>
                                    <td>
                                        @*<button data-bs-toggle="tooltip" title="Delete"
                                                class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.TrnParticipantList[i].EmployeeGI')">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </button>*@

                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="departmentedit"
                                           class="btn btn-icon btn-edit icon-only" onclick="onEmployeeClick('@Model.TraineeCostList[i].EmployeeGI')">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>

                                    </td>



                                </tr>
                        }
                    }
                }
            </tbody>





        </table>





    </div>

}