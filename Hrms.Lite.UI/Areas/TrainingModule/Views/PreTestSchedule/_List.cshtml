@model Hrms.Lite.Shared.TrainingModule.PreTrainingSchedule
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script src="~/scripts/TrainingModule/PreTrainingSchedule.js"></script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table pt-1 Training-Pre-Test-Schedule">
    @Html.HiddenFor(model => Model.PreTrainingScheduleList.Count)
    <table id="DesignationTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">Training</th>
                <th scope="col">Schedule Date</th>
                <th scope="col">Schedule Emp Count</th>
                <th scope="col">Actions</th>
               



            </tr>
        </thead>
        <tbody>
            @{
                if (Model.PreTrainingScheduleList != null && Model.PreTrainingScheduleList.Count > 0)
                {
                    for (int i = 0; i < Model.PreTrainingScheduleList.Count; i++)

                    {
                        <tr>
                            @Html.HiddenFor(model => Model.PreTrainingScheduleList[i].TestHeadCode)
                            @Html.HiddenFor(model => Model.PreTrainingScheduleList[i].PreTestScheduleCode)
                            <td data-label="Short Name">@Model.PreTrainingScheduleList[i].Training</td>
                            <td data-label="Name">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.PreTrainingScheduleList[i].ScheduleDate))</td>
                            <td data-label="Short Name">@Model.PreTrainingScheduleList[i].HeadCount</td>
                          
                            <td>
                                <a data-bs-toggle="tooltip" title="Add Employee"
                                   class="btn btn-icon btn-edit icon-only" onclick="validateAll('@Model.PreTrainingScheduleList[i].PreTestScheduleCode')">
                                    <i class="icon-xl fas fa-plus"></i>
                                </a>
                                @*<a data-bs-toggle="tooltip" title="Delete"
           class="btn btn-icon  icon-only  btn-delet" onclick="DeleteAll('@Model.PreTrainingScheduleList[i].PreTestScheduleCode')">
            <i class="icon-xl far fa-trash-alt"></i>
        </a>*@
                                <a data-bs-toggle="tooltip" title="" id="id=deletetrainer" class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="DeleteAll('@Model.PreTrainingScheduleList[i].PreTestScheduleCode');
                                         " data-bs-original-title="Delete">
                                    <i class="icon-xl far fa-trash-alt"></i>
                                </a>
                            </td>


                        </tr>

                    }
                }

            }
        </tbody>
    </table>
</div>