@model Hrms.Lite.Shared.TrainingModule.PreTrainingSchedule


<style>

    .modal-body {
        padding: 0px 20px;
        height: 235px;
    }
</style>



<script src="~/js/bootstrap-datepicker.js"></script>
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "Pre_Training_Schedule_Save" }))
{

    <div class="modal-body">

        <div class="row tab-style-button pb-0" style="padding:10px">

            <div class="tab-button-wrap align-items-center">

                <div class="tab-items ">

                    <div class="row-outer pb-2 " style="width:180px">
                        <label>Training</label>
                        @Html.DropDownListFor(m => m.TrainingCode, (SelectList)ViewBag.Training, "--Status--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'TrainingSub')" })
                        <span id="TrainingStatus"></span>
                    </div>
                </div>
                <div class="tab-items ">

                    <div class="row-outer pb-2  ml-8" style="width:150px">
                        <label>schedule Date</label>
                        <div class="input-group date">
                            @Html.TextBoxFor(Model => Model.ScheduleDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "From", onchange = "ValidateDate();fillData();validate(this,'fromdate')" })


                            <div class="input-group-append">
                                <span class="input-group-text">
                                    <i class="la la-calendar"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>



            </div>

            <div class="tab-items ml-5 " style=" width: 378px;">

                <label>Comments</label>
                <div class="d-flex align-items-center">
                    @Html.TextAreaFor(m => m.Remarks, new { @class = "form-control" })
                </div>
            </div>


        </div>

        <div class="row mt-5" style=" padding: 10px 5px; left: 15px; right: 17px; bottom: 2px;">

            <div class="col-md-12 align-right">
                <a type="button" class="btn btn-default float-right mobile-full-width" onclick="PreTrainingScheduleSave()">
                    Save

                </a>

            </div>


        </div>


    </div>
}