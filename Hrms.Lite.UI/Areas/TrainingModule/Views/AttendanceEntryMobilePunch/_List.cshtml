
@model Hrms.Lite.Shared.TrainingModule.AttendanceEntryMobilePunch
<script src="~/js/settings.js"></script>
@*<script src="~/js/tooltip.js"></script>*@
@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "updatelist" }))
{
    @Html.HiddenFor(m => Model.AttendanceEntryMobilePunchList.Count)
    <div class="ihits-table table-border hover-color odd-even ">
        <table id="Participant_List_entry" class="common-table">
            <thead>
                <tr class="table-dark">
                    <th scope="col">ID     </th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">Designation</th>
                    <th scope="col">Department</th>
                    <th scope="col">Location</th>
                    <th scope="col">DOJ</th>
                    <th scope="col">Status</th>
                    <th scope="col">Total Topics</th>
                    <th scope="col">Total Punch</th>
                    <th scope="col">
                        Action
                    </th>



                </tr>
            </thead>
            <tbody>
                @{
                    if (Model.AttendanceEntryMobilePunchList != null && Model.AttendanceEntryMobilePunchList.Count > 0)
                    {
                        for (int i = 0; i < Model.AttendanceEntryMobilePunchList.Count; i++)

                        {
                                <tr>
                                    <td data-label="EmployeeID">
                                        @Model.AttendanceEntryMobilePunchList[i].EmployeeID
                                        @Html.HiddenFor(m => Model.AttendanceEntryMobilePunchList[i].EmployeeCode)
                                        @Html.HiddenFor(m => Model.AttendanceEntryMobilePunchList[i].EmployeeID)
                                        @Html.HiddenFor(m => Model.AttendanceEntryMobilePunchList[i].EmployeeID)
                                        @Html.HiddenFor(m => Model.AttendanceEntryMobilePunchList[i].Designation)
                                        @Html.HiddenFor(m => Model.AttendanceEntryMobilePunchList[i].Department)
                                        @Html.HiddenFor(m => Model.AttendanceEntryMobilePunchList[i].Location)
                                    </td>
                                    <td data-label="Employee Name">@Model.AttendanceEntryMobilePunchList[i].EmployeeName </td>
                                    <td data-label="Designation">@Model.AttendanceEntryMobilePunchList[i].Designation </td>
                                    <td data-label="Department">@Model.AttendanceEntryMobilePunchList[i].Department</td>
                                    <td data-label="Location">@Model.AttendanceEntryMobilePunchList[i].Location</td>
                                    <td data-label="DOJ">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.AttendanceEntryMobilePunchList[i].DOJ))</td>
                                    <td data-label="Status">@Model.AttendanceEntryMobilePunchList[i].TrnStatus</td>
                                    <td data-label="Status">
                                    <a data-bs-toggle="modal" data-target=".topicsdetails" onclick="OnTopicsClick('@Model.AttendanceEntryMobilePunchList[i].EmployeeCode','@Model.AttendanceEntryMobilePunchList[i].EmployeeName','@Model.AttendanceEntryMobilePunchList[i].EmployeeID')">
                                        @Model.AttendanceEntryMobilePunchList[i].TotalTopics
                                    </a></td>
                                    <td data-label="Status">@Model.AttendanceEntryMobilePunchList[i].TotalPunch</td>

                                    <td data-label="DOJ">
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           class="btn btn-icon btn-edit icon-only" onclick="EditChange(@Model.AttendanceEntryMobilePunchList[i].EmployeeCode)">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>

                                    </td>



                                </tr>
                        }
                    }
                }
            </tbody>





        </table>





    </div>

}