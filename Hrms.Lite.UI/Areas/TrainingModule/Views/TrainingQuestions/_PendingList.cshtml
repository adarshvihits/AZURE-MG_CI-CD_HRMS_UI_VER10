@model Hrms.Lite.Shared.TrainingModule.TrainingQuestions
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.pendingTabCount').html("@Model.PendingCount");

        //$('#PendingSectiontable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');


    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table section-master-pending pt-1">
    @Html.HiddenFor(m => m.TrainingQuestionsList.Count)
    <table id="PendingSectiontable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">Question</th>
                <th scope="col">Training</th>
                <th scope="col">Reply Group</th>
                <th scope="col">Reply</th>
                <th scope="col">Entry Type</th>
                <th scope="col">Approve</th>
            </tr>
        </thead>
        <tbody>


            @{
                if (Model.TrainingQuestionsList != null && Model.TrainingQuestionsList.Count > 0)
                {
                    for (int i = 0; i < Model.TrainingQuestionsList.Count; i++)

                    {
                        <tr>
                            @Html.HiddenFor(m => m.TrainingQuestionsList[i].MakerChecker)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Question">@Model.TrainingQuestionsList[i].Name</td>
                            <td data-label="Training">@Model.TrainingQuestionsList[i].Training</td>
                            <td data-label="Reply Group">@Model.TrainingQuestionsList[i].ReplyGroupName</td>
                            <td data-label="Reply">@Model.TrainingQuestionsList[i].Reply</td>

                            <td data-label="Entry Type">@Model.TrainingQuestionsList[i].Mode</td>
                            <td data-label="Approve">
                                @if (CurrentUserRoleActions.Approve == true)
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="sectionapprove"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.TrainingQuestionsList[i].GI','@Model.TrainingQuestionsList[i].LogGI','APPROVAL',@i)">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                                else
                                {
                                    <a data-bs-toggle="tooltip" title="Approve"
                                       id="sectionapprove"
                                       class="btn btn-icon btn-tick icon-only " onclick="onApproveClick('@Model.TrainingQuestionsList[i].GI', '@Model.TrainingQuestionsList[i].LogGI', 'APPROVAL',@i);
                                       swal.fire(MasterPersmissionMsg);">
                                        <i class="icon-xl far fa-check-circle"></i>
                                    </a>
                                }
                            </td>

                        </tr>
                    }
                }

            }
        </tbody>
    </table>
</div>
