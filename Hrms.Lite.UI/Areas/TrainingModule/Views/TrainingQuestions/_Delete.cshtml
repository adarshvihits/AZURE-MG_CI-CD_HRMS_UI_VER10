@model Hrms.Lite.Shared.TrainingModule.TrainingQuestions
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
@using (Html.BeginForm("", "", FormMethod.Post, new { @id = "DeleteReview" }))
{
    <div id="sectiondelete" class="slider-forms slider-forms-open Delete">
        <div class="slider-inner-style  new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('Delete')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>Training Questions </h4>
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Reply Group</label>
                            <div class="view-details">
                                @Html.DropDownListFor(m => m.ReplygroupCode.Code, (SelectList)ViewBag.ReplyGroup, "--Select--", new { @class = "form-control form-control-sm", @onchange = "fillData();validate(this,'Reviewcode')" })
                                <span id="Replycode"></span>
                                @Html.HiddenFor(model => Model.Mode)
                                @Html.HiddenFor(model => Model.GI)
                                @Html.HiddenFor(model => Model.LogGI)
                                @Html.HiddenFor(model => Model.Description)
                            </div>
                        </div>
                    </div>


                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Reply </label>
                        <div class="view-details">
                            @Html.DropDownListFor(m => m.ReplyCode.Code, (SelectList)ViewBag.Reply, "--Select--", new { @class = "form-control form-control-sm", @onchange = "fillData();validate(this,'Replycode')" })
                            <span id="Replycode"></span>
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Description)
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Training </label>
                        <div class="view-details">
                            @Html.DropDownListFor(m => m.TrainingCode.Code, (SelectList)ViewBag.Training, "--Select--", new { @class = "form-control form-control-sm", @onchange = "fillData();validate(this,'Trainingcode')" })
                            <span id="Trainingcode"></span>
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.Description)
                        </div>
                    </div>
                </div>


                <div class="row ">
                    <div class="col-md-12">
                        <label class="view-title">Active</label>
                        <div class="view-details">
                            @if (Model.Active == true)
                            {
                                <button type="button" class="btn btn-icon btn-tick">
                                    <i class="icon-xl fas fa-check"></i>
                                </button>

                            }
                            else
                            {
                                <button type="button" class="btn btn-icon btn-close">
                                    <i class="icon-xl fas fa-times"></i>

                                </button>
                            }
                        </div>
                    </div>
                </div>

                <div class="row my-3">

                    <div class="col-md-12">
                        <label class="view-title">Question</label>
                        <div class="view-details">
                            @Html.DisplayFor(model => Model.Description)
                        </div>
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">
                        @if (CurrentUserRoleActions.Delete == true)
                        {
                            <a type="button"
                               data-bs-toggle="tooltip" title=""
                               data-bs-original-title="Delete"
                               class="btn btn-icon btn-delete big-btn float-none" onclick="return confirmDelete('@Model.GI','@Model.LogGI')">
                                <i class="icon-xl far fa-trash-alt"></i>
                            </a>
                        }
                    </div>


                </div>
            </div>
        </div>
    </div>
}
