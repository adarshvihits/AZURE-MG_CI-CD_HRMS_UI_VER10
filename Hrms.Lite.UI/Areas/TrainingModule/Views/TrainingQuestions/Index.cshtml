@model Hrms.Lite.Shared.TrainingModule.TrainingQuestions
@{ ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml"; 
}
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}

<script src="~/scripts/TrainingModule/trainingQuestions.js"></script>

<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>


<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Training Questions
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Training Questions
                    </li>

                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->


<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body">
                            <div class="mobile-tab-section">
                                <div class="row mb-2">
                                    <div class="col-12">
                                        <div class="form-group">
                                            <label>Type</label>
                                            <select class="form-control form-control-sm "
                                                    id="tabsDropdownZone"
                                                    onchange="tabClick(this)">
                                                <option value="ACTIVE">Active</option>
                                                <option value="INACTIVE">Inactive</option>
                                                <option value="APPROVAL_PENDING">
                                                    Pending
                                                </option>

                                            </select>

                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="row tab-style-button">
                                <div class="tab-button-wrap">
                                    <div class="tab-items">
                                        <span class="btn-title ActiveTab active" onclick="TabOnClick('ActiveTab','ACTIVE')">
                                            Active
                                            @*<span class="btn-notification AllTabCount">@Model.ActiveCount</span>*@
                                        </span>
                                    </div>
                                    <div class="tab-items medium">
                                        <span class="btn-title InctiveTab" onclick="TabOnClick('InctiveTab','INACTIVE')">
                                            Inactive
                                            @*<span class="btn-notification InActiveTabCount">@Model.InactiveCount</span>*@
                                        </span>
                                    </div>
                                    <div class="tab-items low">
                                        <span class="btn-title PendingTab" onclick="TabOnClick('PendingTab','APPROVAL_PENDING')">
                                            Pending
                                            <span class="btn-notification pendingTabCount">@Model.PendingCount</span>
                                        </span>
                                    </div>

                                    <div class="tab-items">
                                        <label>Training</label>
                                        <div class="form-group filter-combobox mt-0">
                                            @Html.DropDownListFor(m => m.TrainingCode, (SelectList)ViewBag.Training, "ALL", new { @class = "form-control form-control-sm", @onchange = "fillData()" })
                                            <span id="classification"></span>
                                        </div>
                                    </div>

                                    <div class="tab-items select-option">

                                        <div class="sraech-slider">
                                            <div class="search-slider-inner">
                                                <i class="fa fa-search"></i>
                                            </div>
                                            <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                                   placeholder="ID/Name">
                                        </div>
                                        <a data-bs-toggle="tooltip" title="Export to Excel"
                                           class="btn btn-excel" onclick="ExportToExcel()">
                                            <i class="icon-xl far fa-file-excel"></i>
                                        </a>

                                    </div>


                                </div>
                            </div>

                            <div id="ActiveList">
                                @await Html.PartialAsync("_ReviewList", Model)
                            </div>
                            <div id="AddNewOrEditSlider">


                            </div>
                            <div id="DeleteSlider">


                            </div>
                            <div id="ApproveSlider">


                            </div>

                            <!-- <end table></end> -->
                            <div class="row card-footer-bottom-fixed">

                                <div class="col-md-12 align-right">
                                    @if (CurrentUserRoleActions.Create == true)
                                    {
                                        <a id="addzone"
                                           class="btn btn-default float-right mobile-full-width " onclick="onAddNewOrEditClick('Create')">
                                            Add
                                            New
                                        </a>
                                    }
                                    else
                                    {
                                        <a id="addzone"
                                           class="btn btn-default float-right mobile-full-width " onclick="swal.fire(MasterPersmissionMsg);">
                                            Add
                                            New
                                        </a>

                                    }
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>




            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>
<!--end::Content-->
