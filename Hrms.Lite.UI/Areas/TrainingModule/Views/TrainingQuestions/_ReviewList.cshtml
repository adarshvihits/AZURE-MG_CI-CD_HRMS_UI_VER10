@model Hrms.Lite.Shared.TrainingModule.TrainingQuestions
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");

        //$('#SectionTable').DataTable({
        //    "pageLength": 25,
        //    "language": {
        //        searchPlaceholder: "Search"
        //    }
        //});


        //$('.ihits-table table').removeClass("dataTable no-footer");
        //$(".ihits-table table tr th").removeAttr('style');


    });
</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table question-master-list pt-1">
    @Html.HiddenFor(m => m.TrainingQuestionsList.Count)
    <table id="SectionTable" class="common-table">
        <thead>
            <tr class="table-dark">

                <th scope="col">Question</th>
                <th scope="col">Training</th>
                <th scope="col">Reply Group</th>
                <th scope="col">Reply</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>

            @{
                if (Model.TrainingQuestionsList != null && Model.TrainingQuestionsList.Count > 0)
                {
                    for (int i = 0; i < Model.TrainingQuestionsList.Count; i++)

                    {
                        <tr>
                            @Html.HiddenFor(m => m.TrainingQuestionsList[i].EditActive)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.GI)
                            <td data-label="Question">@Model.TrainingQuestionsList[i].Name</td>
                            <td data-label="Training">@Model.TrainingQuestionsList[i].Training</td>
                            <td data-label="Reply group">@Model.TrainingQuestionsList[i].ReplyGroupName</td>
                            <td data-label="Reply ">@Model.TrainingQuestionsList[i].Reply</td>
                            <td data-label="Actions">
                                <div>
                                    @if (CurrentUserRoleActions.Modify == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="sectionedit"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY', '@Model.TrainingQuestionsList[i].GI', '@Model.TrainingQuestionsList[i].LogGI',@i)">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="sectionedit"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY', '@Model.TrainingQuestionsList[i].GI', '@Model.TrainingQuestionsList[i].LogGI',@i);
                                           swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#AddNewOrEditSlider');});">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>

                                    }

                                    @if (CurrentUserRoleActions.Delete == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="sectiondelete"
                                           class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.TrainingQuestionsList[i].GI', '@Model.TrainingQuestionsList[i].LogGI','DELETE',@i)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="sectiondelete"
                                           class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.TrainingQuestionsList[i].GI', '@Model.TrainingQuestionsList[i].LogGI', 'DELETE',@i);
                                           swal.fire(MasterPersmissionMsg);">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                </div>

                            </td>
                        </tr>

                    }
                }

            }
        </tbody>
    </table>
</div>
