@model Hrms.Lite.Shared.TrainingModule.TrainingGroupVsEmployee
<script>
        $(document).ready(function () {      
            moveCursorToEnd('Amount');
        });       
</script>

@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "BatchUpdateTrainingGrp" }))
{
    <div id="BatchUpdate" class="slider-forms slider-forms-open batchUpdateDiv">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('batchUpdateDiv');">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>
                Batch Update
            </h4>           
            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Training Group</label><span class="Mandatory">*</span>

                        @Html.DropDownListFor(m => m.TrainingGroupVsEmployeeDetails.TrainingGroupCode, (SelectList)ViewBag.TrainingGroup, "--Select--", new { @class = "form-control form-control-sm",@onchange= "validate(this,'BatchTGrp')" })
                        <span id="BatchTGrp"></span>

                    </div>
                </div>
            </div>
            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    <button type="button"
                            class="btn btn-default  mobile-full-width" onclick="onBatchUpdateSave()">
                        Update
                    </button>
                </div>

            </div>
        </div>
    </div>
}