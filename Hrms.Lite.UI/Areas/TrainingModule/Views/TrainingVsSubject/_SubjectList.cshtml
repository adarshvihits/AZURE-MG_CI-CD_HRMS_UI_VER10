@model Hrms.Lite.Shared.TrainingModule.TrainingVsSubject

    <div class="ihits-table table-border subject_vs_training mb-0 vertical-scroll-450">
        <table id="Trainingvssubject">
            <thead>
                <tr class="table-dark">
                    <th scope="col">Subject</th>
                    <th scope="col">
                        <label class="checkbox checkbox-outline checkbox-success pl-3">
                            <input type="checkbox" name="Checkboxes15" id="allSub" onclick="onAllClick('allSub','Trainingvssubject')">
                            <span class="mr-1"></span>
                        </label>
                    </th>

                </tr>
            </thead>
            <tbody>
                @if (Model.SubjectDetails != null && Model.SubjectDetails.Count > 0)
                {

                    for (int i = 0; i < Model.SubjectDetails.Count; i++)
                    {
                        @Html.HiddenFor(m => m.SubjectDetails[i].Code)
                        <tr>
                            <td data-label="Subject">@Model.SubjectDetails[i].Name</td>
                            <td data-label="Y/S">
                                <div class="checkbox-inline">
                                    <label class="checkbox checkbox-outline checkbox-success">
              
                                        @Html.CheckBoxFor(m => m.SubjectDetails[i].Applicable, new { @id = "dsg", @onclick = "onChkBoxClick(this,'allSub')"})
                                        <span></span>
                                    </label>
                                </div>
                            </td>
                        </tr>
                    }
                }
                
                <div class="row card-footer-bottom-fixed">


                    <div class="col-md-12 align-right">
                        <button type="button"
                                class="btn btn-default float-right mobile-full-width" onclick="Save()">
                            Save
                        </button>

                    </div>

            </tbody>


        </table>
    </div>

