@model Hrms.Lite.Shared.TrainingModule.TrainingSchedule
 <script src="~/scripts/TrainingModule/TrainingSchedule.js"></script>
<div class="ihits-table table-border mobile-responsive-table topic-list-sliderr pt-3">
    <table class="table form-grid clear fixTable" id="TopicList">
        <thead>
            <tr class="table-gray">
                <th scope="col">Topic<span class="Mandatory">*</span></th>
                <th scope="col">Trainer</th>
                <th scope="col">Venue</th>
                <th scope="col">Training Date</th>
                <th scope="col">Start Time</th>
                <th scope="col">End Time</th>
                <th scope="col">Delete</th>

            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null && Model.TrainerTopicList != null)
                {

                    @for (int i = 0; i < Model.TrainerTopicList.Count; i++)
                    {
                        @Html.HiddenFor(m => m.TrainerTopicList[i].TransactionCode)
                        @Html.HiddenFor(m => m.TrainerTopicList[i].ScheduleCode)
                        @Html.HiddenFor(m => m.TrainerTopicList[i].TrainingCode)
                        @Html.HiddenFor(m => m.TrainerTopicList[i].TrainingSubjectCode)
            <tr>

                <td data-label="Name">
                    @Model.TrainerTopicList[i].Topicsub
                </td>
                <td data-label="Point">
                    @Model.TrainerTopicList[i].Trainer
                </td>

                <td data-label="Point">
                    @Model.TrainerTopicList[i].Venue

                </td>
                <td data-label="Point">
                    @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.TrainerTopicList[i].Trainingdate)) 

                </td>
                <td data-label="Point">
                    @Model.TrainerTopicList[i].StartTime.ToLongTimeString()

                </td>
                <td data-label="Point">
                    @Model.TrainerTopicList[i].EndTime.ToLongTimeString()

                </td>
                <td>
                    <a data-bs-toggle="tooltip" title="Delete" id="deleteskilltype"
                       type="button"
                       class="btn btn-icon  icon-only mobile-full-width btn-delete" onclick="DeleteTopic(@Model.TrainerTopicList[i].TransactionCode)">
                        <i class="icon-xl far fa-trash-alt"></i>
                    </a>
                </td>
            </tr>

                    }
                }
            }
        </tbody>
    </table>
</div>