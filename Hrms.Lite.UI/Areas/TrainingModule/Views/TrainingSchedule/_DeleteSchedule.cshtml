@model Hrms.Lite.Shared.TrainingModule.TrainingSchedule
<script src="~/js/bootstrap-datepicker.js"></script>
@using (Html.BeginForm("Delete", "TrainingSchedule", FormMethod.Post, new { id = "TrainingScheduleDelete" }))
{
    <div id="addallowance" class="slider-forms slider-forms-open DeleteSchedule">
        <div class="slider-inner-style ">
            <div class="slider-form-close" onclick="CloseSlider('DeleteSchedule')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>

                Training Schedule
            </h4>
            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Select Training
                            <span class="Mandatory">*</span>
                        </label>
                        @Html.HiddenFor(m => m.Mode)
                        @Html.HiddenFor(m => m.ScheduleCode)
                    <div>
                        @Html.DisplayFor(m => m.Training.Name)
                    </div>
                       
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            select Month
                            <span class="Mandatory">*</span>
                        </label>
                        <div>
                            @Html.DisplayFor(m => m.Month.Name)

                        </div>
                       


                    </div>
                </div>
            </div>
            <div class="row">

                <div class="col-md-6">

                    <div class="form-group">
                        <label>Start Date</label>
                        <div class="input-group date">
                           @Html.DisplayFor(Model => Model.StartDate)
                           
                        </div>
                        <span id="StartDateschedule"></span>

                    </div>

                </div>
                <div class="col-md-6">


                    <div class="form-group">
                        <label>End Date</label>
                        <div>
                            @Html.DisplayFor(Model => Model.EndDate)
                        </div>
                       
                    </div>


                </div>
            </div>
            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">

                        <label>Post Assessment Required/Not</label>
                        <div>
                            <div class="radio-inline">
                                <label class="radio radio-outline radio-success">
                                    @if (Model.PostassessmentRequired == 1)
                                    {
                                        <label> Yes</label>

                                    }
                                    else
                                    {
                                        <label> No</label>

                                    }
                                    
                                </label>

                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">

                    <div class="form-group AssessmentDate">
                        <label>Post Assessment Date</label>
                        <div>
                            @Html.DisplayFor(Model => Model.RequestUptoDate)
                        </div>
                     
                        <span id="RequestUpto"></span>
                    </div>


                </div>


            </div>
            <div class="row">
                <div class="col-md-12">
                    <label>Remarks/Responsibility</label>
                    <div>
                        @Html.DisplayFor(Model => Model.Remarks)
                    </div>
               
                </div>

            </div>
            @*<div class="row">
                    <div class="col-md-12">
                        <label>Training Needs</label>
                        @Html.TextAreaFor(model => Model.Description, new { @class = "form-control form-control-sm FactorDiscription", @placeholder = "Description", maxlength = "250" })

                    </div>

                </div>
                <div class="row">
                    <div class="col-md-12">
                        <label>Required Facilities </label>
                        @Html.TextAreaFor(model => Model.Description, new { @class = "form-control form-control-sm FactorDiscription", @placeholder = "Description", maxlength = "250" })

                    </div>

                </div>*@

            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            No Of Participants
                            <span class="Mandatory">*</span>
                        </label>
                        <div>
                            @Html.DisplayFor(model => model.ParticipantsCount)

                        </div>
                      
                        <span id="ParticipantsHeadCount"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Request Type</label>
                        <div>
                            @Html.DisplayFor(model => model.RequestType.Name)
                        </div>
            
                    </div>
                </div>
            </div>

            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Duration
                            <span class="Mandatory">*</span>
                        </label>
                        <div>
                            @Html.DisplayFor(model => model.Duration)
                        </div>
                     
                        
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Request UpTo</label>
                        <div>
                            @Html.DisplayFor(model => model.RequestUpTo)
                        </div>
                      
                    </div>
                </div>
            </div>

            <div class="row">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>
                            Out Of Mark
                            <span class="Mandatory">*</span>
                        </label>
                        <div>
                            @Html.DisplayFor(model => model.OutOfMark)
                        </div>
                      
                        <span id="OutOfMark"></span>
                    </div>
                </div>

            </div>

            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                        <button type="button" class="btn btn-default  mobile-full-width" onclick="TrainingScheduleDelete()">
                            Delete
                        </button>
                </div>

            </div>
        </div>
    </div>
}

