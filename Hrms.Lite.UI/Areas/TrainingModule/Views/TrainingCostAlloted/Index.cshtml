@model Hrms.Lite.Shared.TrainingModule.TraineeCost
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/scripts/TrainingModule/TrainingCostAlloted.js"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>

<script src="~/js/settings.js"></script>




<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Training Alloted Cost
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Training Alloted Cost
                    </li>

                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->


<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                    <div class="col-md-12">
                        <div class="card card-custom height-100per">

                            <div class="card-body">
                                @using (Html.BeginForm(null, null, FormMethod.Get, new { id = "TrainingCostAllotedForm" }))
                                {
                                <div class="ihits-table table-border hover-color odd-even mobile-responsive-table TRAINEE_COST_LIST">
                                    <table class="common-table">
                                        <thead>
                                            <tr class="table-dark">
                                                <th scope="col">Financial Year</th>
                                                <th scope="col">AllotedAmount</th>
                                            </tr>
                                        </thead>

                                        <tbody>
                                            @if (Model.TraineeCostList != null)
                                            {
                                                @for (var i = 0; i < Model.TraineeCostList.Count; i++)
                                                {
                                                    <tr id="row_@i">
                                                      
                                                        <td>
                                                            @Html.DisplayFor(Model => Model.TraineeCostList[i].FinancialYearName)
                                                            @Html.HiddenFor(Model => Model.TraineeCostList[i].FinancialYearCode)    
                                                        </td>
                                                        <td >
                                                            @Html.TextBoxFor(Model => Model.TraineeCostList[i].AllotedAmount, new { @class = "form-control form-control-sm text-right", @placeholder = "AllotedAmount", @onblur = "validate(this,'AllotedAmount')" })
                                                            
                                                        </td>
                                                    </tr>

                                                }
                                            }


                                        </tbody>


                                    </table>
                                    <div class="col-md-12 align-right">

                                        <a type="button" class="btn btn-default float-right mobile-full-width " onclick="SaveAmount()">
                                            Save
                                        </a>


                                    </div>



                                </div>

                                    <!-- <end table></end> -->
                                    
                                }

                                </div>
                                
                        </div>

                    </div>
                </div>
            
            </div>




            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

<!--end::Content-->





