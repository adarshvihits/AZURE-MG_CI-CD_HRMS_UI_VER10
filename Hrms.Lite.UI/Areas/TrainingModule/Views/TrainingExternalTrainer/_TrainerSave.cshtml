@model Hrms.Lite.Shared.TrainingModule.TrainingExternalTrainer
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;

<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });
</script>
<script src="~/scripts/commonValidators.js"></script>


@using (Html.BeginForm("Save", "TrainingExternalTrainer", FormMethod.Post, new { id = "trainerSave" }))
{
    <div id="addtrainer" class="slider-forms slider-forms-open trainerSaveclose">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('trainerSaveclose')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>
                    External Trainer
                </h4>
            </div>
            <div class="add-padding">
                <div class="row">

                    <div class="col-md-12">
                        <div class="form-group">
                            <label>
                                Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm RName", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'TrainerName')", maxlength = "120" })
                            <span id="TrainerName"></span>
                            @*<span id="RegionName" class="error-message is-invalid"></span>*@
                        </div>
                    </div>
                    @*<div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Short Name
                           
                            </label>
                            @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm RShortName", @placeholder = "Short Name", @onblur = "validate(this,'TrainerShortName')", maxlength = "5" })
                            <span id="TrainerShortName"></span>
                        </div>
                    </div>*@
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Contact Number
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.TextBoxFor(Model => Model.ContactNumber, new { @class = "form-control form-control-sm RContactNumber", @placeholder = "Contact Number", @onblur = "validateMobileNumber('ContactNumber','TrainerContactnumber')", @onkeypress = "return onlyNumberKey(event)", maxlength = "10" })
                            <span id="TrainerContactnumber"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Email
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.TextBoxFor(Model => Model.Email, new { @class = "form-control form-control-sm REmail", @placeholder = "Email", @onblur = "validateEmailID(this,'Traineremail')", maxlength = "120" })
                            <span id="Traineremail"></span>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="form-group">
                            <label>
                                Contact Address
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.TextAreaFor(Model => Model.ContactAddress, new { @class = "form-control form-control-sm RAddress", @placeholder = "Contact Address", @onblur = "validate(this,'Traineraddress')", maxlength = "500" })
                            <span id="Traineraddress"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Approximate Amount
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.TextBoxFor(Model => Model.ApproximateAmount, new { @class = "form-control form-control-sm RAmount", @placeholder = "Amount", @onblur = "onlyAmount(this,'Traineramount')", @onkeypress = "return onlyNumberKey(event)", maxlength = "7" })
                            <span id="Traineramount"></span>
                        </div>
                    </div>
                    <div class="col-md-6 d-flex align-items-center">
                        <div class="d-flex align-items-center">

                            <div> Active</div>
                            <label class="switch" onchange="ActiveInactiveValidation('Training','@Model.Code')">

                                @Html.CheckBoxFor(model => model.Active, new { @id = "Activeinactivereg" })
                                <span class="slider round"></span>
                            </label>
                        </div>
                    </div>

                </div>



             


                <div class="row my-3">

                    <div class="col-md-12">
                        @if (Model.Mode == "Create")
                        {
                            <label>Description</label>
                            @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm", @placeholder = "Description", maxlength = "250" })
                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            <label class="view-title">Description</label>
                            <div class="view-details">
                                @Html.HiddenFor(model => Model.Description)
                                @Html.DisplayFor(Model => Model.Description)
                            </div>
                        }
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">
                        @if (Model.Mode == "Create")
                        {
                            @*@if (CurrentUserRoleActions.Create == true)*@
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="SaveTrainer('Save')">
                                    Save
                                </button>
                            }
                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            @*@if (CurrentUserRoleActions.Modify == true)*@
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="SaveTrainer('Modify')">
                                    Modify
                                </button>
                            }
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
}