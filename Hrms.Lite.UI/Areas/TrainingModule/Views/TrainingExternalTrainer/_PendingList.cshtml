                            <td data-label="Contact Number">@Model.TrainingList[i].ContactNumber</td>
                            <td data-label="Email">@Model.TrainingList[i].Email</td>
                            <td data-label="Contact Address">@Model.TrainingList[i].ContactAddress</td>
                            <td data-label="Approximate Amount">@Model.TrainingList[i].ApproximateAmount</td>
                            <td data-label="Entry Type">@Model.TrainingList[i].Mode</td>
