@model Hrms.Lite.Shared.TrainingModule.TrainingCompletion
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/TrainingModule/TrainingCompletion.js"></script>

<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">  Training Completion</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Training Completion
                    </li>

                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>


<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">


            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items ml-5 pr-0 border-none select-option lows">

                                <div class="form-group filter-combobox mr-2" style="width: 140px;">


                                    @Html.DropDownListFor(m => m.FinancialYear.Code, (SelectList)ViewBag.FinancialYear, "--FinancialYear--", new { @class = "form-control form-control-sm", @onchange = "fillHeading()" })
                                    <span id="pms_Appraisal"></span>
                                </div>

                            </div>
                            <div class="tab-items border-none d-flex align-items-center">
                                <div>
                                    <div class="radio-inline">
                                        <label class="radio radio-outline radio-success">
                                            @Html.RadioButtonFor(m => m.Status, "1", new { @onchange = "fillHeading()" })
                                            <span></span>Conducted
                                        </label>
                                        <label class="radio radio-outline radio-success">
                                            @Html.RadioButtonFor(m => m.Status, "0", new { @onchange = "fillHeading()" })
                                            <span></span>Not Conducted
                                        </label>
                                        <label class="radio radio-outline radio-success">
                                            @Html.RadioButtonFor(m => m.Status, "2", new { @onchange = "fillHeading()" })
                                            <span></span>Cancelled
                                        </label>

                                    </div>
                                </div>
                            </div>

                            <!--<batch updates></batch> -->
                            <div class="tab-items pr-0 border-none highs">
                                @*<div class="button-group float-left  schedulediv hide">
                        <a data-bs-toggle="modal" data-target=".pms_ScheduleBatch" class="btn btn-default float-left mobile-full-width mr-3" onclick="document.getElementById('pms_ScheduleForm').reset();">
                            Batch Update
                        </a>

                    </div>*@
                            </div>




                            <div class="tab-items select-option lows">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                @*<div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>*@
                                <a data-bs-toggle="tooltip" title="Export to Excel"
                                   class="btn btn-excel mr-0" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>

                            </div>


                        </div>
                    </div>


                    <div id="TrainingScheduleCompletionList">
                        @await Html.PartialAsync("_TrainingScheduleLIst")
                    </div>
                    <div id="AddNewTrainingSchedule">


                    </div>
                 
                </div>
            </div>

        </div>

    </div>

</div>