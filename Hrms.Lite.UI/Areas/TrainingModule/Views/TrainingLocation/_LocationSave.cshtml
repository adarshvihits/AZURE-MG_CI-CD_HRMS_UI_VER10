@model Hrms.Lite.Shared.TrainingModule.TrainingLocation
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;

<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });
</script>
<script src="~/scripts/commonValidators.js"></script>


@using (Html.BeginForm("Save", "TrainingLocation", FormMethod.Post, new { id = "locationSave" }))
{
    <div id="addtrainer" class="slider-forms slider-forms-open locationSaveclose">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('locationSaveclose')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>
                    Location
                </h4>
            </div>
            <div class="add-padding">
                <div class="row">

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm RName", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'locationName')", maxlength = "120" })
                            <span id="locationName"></span>
                            @*<span id="RegionName" class="error-message is-invalid"></span>*@
                        </div>
                    </div>
                    @*<div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Short Name
                              
                            </label>
                            @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm RShortName", @placeholder = "Short Name", @onblur = "validate(this,'locationShortName')", maxlength = "5" })
                            <span id="locationShortName"></span>
                        </div>
                    </div>*@
                  


                    


                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Latitude
                            </label>
                            @Html.TextBoxFor(Model => Model.Latitude, new { @class = "form-control form-control-sm", @placeholder = "Latitude", maxlength = "200" })
                            <span id="Latitude"></span>
                        </div>
                    </div>


                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Longitude
                            </label>
                            @Html.TextBoxFor(Model => Model.Longitude, new { @class = "form-control form-control-sm", @placeholder = "Longitude", maxlength = "200" })
                            <span id="Longitude"></span>
                        </div>
                    </div>
                </div>
                <div class="row">

                    <div class="col-md-12">
                        <div class="form-group">
                            <label>
                                Location Address
                            </label>
                            @Html.TextBoxFor(Model => Model.LocationAddress, new { @class = "form-control form-control-sm", @placeholder = "Location Address", maxlength = "200" })
                            <span id="LocationAddress"></span>
                        </div>
                    </div>

                </div>
                <div class="row my-3">


                    <div class="col-md-12 d-flex align-items-center">
                        <div class="d-flex align-items-center">

                            <div> Active</div>
                            <label class="switch" onchange="ActiveInactiveValidation('Training','@Model.Code')">

                                @Html.CheckBoxFor(model => model.Active, new { @id = "Activeinactivereg" })
                                <span class="slider round"></span>
                            </label>
                        </div>
                    </div>


                </div>


                <div class="row my-3">

                    <div class="col-md-12">
                        @if (Model.Mode == "Create")
                        {
                            <label>Description</label>
                            @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm", @placeholder = "Description", maxlength = "250" })
                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            <label class="view-title">Description</label>
                            <div class="view-details">
                                @Html.HiddenFor(model => Model.Description)
                                @Html.DisplayFor(Model => Model.Description)
                            </div>
                        }
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">
                        @if (Model.Mode == "Create")
                        {
                            @*@if (CurrentUserRoleActions.Create == true)*@
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="SaveLocation('Save')">
                                    Save
                                </button>
                            }
                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            @*@if (CurrentUserRoleActions.Modify == true)*@
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="SaveLocation('Modify')">
                                    Modify
                                </button>
                            }
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>
}