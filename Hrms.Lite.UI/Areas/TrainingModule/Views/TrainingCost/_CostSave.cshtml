@model Hrms.Lite.Shared.TrainingModule.TrainingCost
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;

<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });
</script>
<script src="~/scripts/commonValidators.js"></script>


@using (Html.BeginForm("Save", "TrainingCost", FormMethod.Post, new { id = "TrainingcostSave" }))
{
    <div id="addtrainingcost" class="slider-forms slider-forms-open CostSaveclose">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('CostSaveclose')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>
                    Training Cost
                </h4>
            </div>
            <div class="add-padding">
                <div class="row">

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Name
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(model => Model.GI)
                            @Html.TextBoxFor(Model => Model.Name, new { @class = "form-control form-control-sm RName", @placeholder = "Name", @onblur = "OnlycapitalizeFirstLetter(this,'Name')", maxlength = "120" })
                            <span id="Name"></span>

                        </div>
                    </div>
                    @*<div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Short Name
                            </label>
                            @Html.TextBoxFor(Model => Model.ShortName, new { @class = "form-control form-control-sm RShortName", @placeholder = "Short Name", @onblur = "validate(this,'ShortName')", maxlength = "5" })
                            <span id="ShortName"></span>
                        </div>
                    </div>*@
                    <div class="col-md-6">
                        <label>
                            Type
                            <span class="Mandatory">*</span>
                        </label>
                        <div class="form-group filter-combobox mt-0">
                            @Html.DropDownListFor(m => m.TrainingCostHeadTypeCode, (SelectList)ViewBag.Training, "--Select--", new { @class = "form-control form-control-sm", @onblur = "validate(this,'classification')", @onchange = "fillData()" })
                            <span id="classification"></span>
                        </div>
                    </div>
                    <div class="col-md-6 d-flex align-items-center">
                        <div class="d-flex align-items-center">

                            <div> Active</div>
                            <label class="switch" @*onchange="ActiveInactiveValidation('Training','@Model.Code')"*@>

                                @Html.CheckBoxFor(model => model.Active, new { @id = "Activeinactivereg" })
                                <span class="slider round"></span>
                            </label>
                        </div>
                    </div>




                </div>



                   



                    <div class="row my-3">

                        <div class="col-md-12">
                            @if (Model.Mode == "Create")
                            {
                                <label>Description</label>
                                @Html.TextAreaFor(Model => Model.Description, new { @class = "form-control form-control-sm", @placeholder = "Description", maxlength = "250" })
                            }
                            @if (Model.Mode == "MODIFY")
                            {
                                <label class="view-title">Description</label>
                                <div class="view-details">
                                    @Html.HiddenFor(model => Model.Description)
                                    @Html.DisplayFor(Model => Model.Description)
                                </div>
                            }
                        </div>
                    </div>

                    <div class="row card-footer-bottom-fixed border-none">

                        <div class="col-md-12 align-right">
                            @if (Model.Mode == "Create")
                            {
                                @*@if (CurrentUserRoleActions.Create == true)*@
                                {
                                    <button type="button" class="btn btn-default  mobile-full-width" onclick="SaveTrainingCost('Save')">
                                        Save
                                    </button>
                                }
                            }
                            @if (Model.Mode == "MODIFY")
                            {
                                @*@if (CurrentUserRoleActions.Modify == true)*@
                                {
                                    <button type="button" class="btn btn-default  mobile-full-width" onclick="SaveTrainingCost('Modify')">
                                        Modify
                                    </button>
                                }
                            }
                        </div>

                    </div>
                </div>
        </div>
    </div>
}