@model Hrms.Lite.Shared.TrainingModule.TrainingCost
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;

<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");
      

    });
</script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table TrainingCost-master-list pt-1">
    @Html.HiddenFor(m => m.GetTrainingCostList.Count)
    <table id="TrainingCostTable" class="common-table">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                @*<th scope="col">Short Name</th>*@
                <th scope="col">Type</th>


                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>

            @{
                if (Model.GetTrainingCostList != null && Model.GetTrainingCostList.Count > 0)
                {

                    for (int i = 0; i < Model.GetTrainingCostList.Count; i++)
                    {
                        <tr>

                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(m => m.GetTrainingCostList[i].EditActive)
                            <td data-label="Name">@Model.GetTrainingCostList[i].Name</td>
                            @*<td data-label="Short Name">@Model.GetTrainingCostList[i].ShortName</td>*@
                            <td data-label="Type">@Model.GetTrainingCostList[i].TrainingCostHeadTypeName</td>

                            <td data-label="Actions">
                                <div>
                                  

                               
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       id="addtrainer"
                                       class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY', '@Model.GetTrainingCostList[i].GI', '@Model.GetTrainingCostList[i].LogGI',@i);
                                      ">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>
                                 

                                    <a data-bs-toggle="tooltip" title="Delete"
                                       id="id=deletetrainer"
                                       class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.GetTrainingCostList[i].GI', '@Model.GetTrainingCostList[i].LogGI', 'DELETE',@i);
                                         ">
                                        <i class="icon-xl far fa-trash-alt"></i>
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                }


            }

        </tbody>
    </table>
</div>