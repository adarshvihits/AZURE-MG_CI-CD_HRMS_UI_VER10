@model Hrms.Lite.Shared.TrainingModule.TrainingCost
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
<script src="~/js/tooltip.js"></script>
@using (Html.BeginForm("Delete", "TrainingLocation", FormMethod.Post, new { @id = "deletetrainingcost" }))
{
    <div id="deletetrainingcost" class="slider-forms slider-forms-open deletetrainingcost">
        <div class="slider-inner-style  new-inner-style">
            <div class="slider-form-close">
                <i class="ki ki-close icon-xs text-muted" onclick="CloseSlider('deletetrainingcost')"></i>
            </div>
            <div class="location-slider">
                <h4>
                    Training Cost
                </h4>
            </div>
            <div class="add-padding">
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Name</label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.Name)

                                @Html.HiddenFor(model => Model.GI)

                                @Html.HiddenFor(model => Model.LogGI)
                                @Html.HiddenFor(model => Model.GI)
                                @Html.HiddenFor(model => Model.Mode)


                            </div>
                        </div>
                    </div>
                    @*<div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Short
                                Name
                            </label>
                            <div class="view-details">
                                @Html.DisplayFor(model => Model.ShortName)
                            </div>
                        </div>
                    </div>*@
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label>
                                Type
                                <span class="Mandatory">*</span>
                            </label>
                            <div class="form-group filter-combobox mt-0">
                                @Html.DisplayFor(model => Model.TrainingCostHeadTypeName)
                                <span id="classification"></span>
                            </div>
                            </div>
                        </div>


                        </div>
                        <div class="row my-3">
                            <div class="col-md-12">
                                <div class="row-outer">
                                    <label class="view-title">Active</label>
                                    <div class="view-details">

                                        @if (Model.Active == true)
                                        {

                                            <button type="button" class="btn btn-icon btn-tick">
                                                <i class="icon-xl fas fa-check"></i>
                                            </button>

                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-icon btn-close">
                                                <i class="icon-xl fas fa-times"></i>

                                            </button>
                                        }


                                    </div>
                                </div>

                            </div>

                        </div>
                        <div class="row my-3">

                            <div class="col-md-12">
                                <label class="view-title">Description</label>
                                <div class="view-details">
                                    @Html.DisplayFor(model => Model.Description)
                                </div>
                            </div>
                        </div>

                        <div class="row card-footer-bottom-fixed border-none">

                            <div class="col-md-12 align-right">
                            
                                <a type="button"
                                   data-bs-toggle="tooltip" title="Delete"
                                   data-bs-original-title="Delete"
                                   class="btn btn-icon btn-delete big-btn float-none" onclick="return confirmDelete('@Model.GI','@Model.LogGI')">
                                    <i class="icon-xl far fa-trash-alt"></i>
                                </a>
                             
                            </div>


                        </div>
                    </div>

                </div>
    </div>
}

