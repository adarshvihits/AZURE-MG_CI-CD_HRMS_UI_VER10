
@model Hrms.Lite.Shared.TrainingModule.ParticipantEntry
<script src="~/js/settings.js"></script>
@*<script src="~/js/tooltip.js"></script>*@
@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "updatelist" }))
{
    @Html.HiddenFor(m => Model.TrainingCompletionList.Count)
    <div class="ihits-table table-border hover-color odd-even attendance_trm_entry">
        <table id="Participant_List_entry" class="common-table">
            <thead>
                <tr class="table-dark">
                    <th scope="col">ID     </th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">Designation</th>
                    <th scope="col">Department</th>
                    <th scope="col">Location</th>
                    <th scope="col">DOJ</th>
                    <th scope="col">Status</th>
                    <th scope="col">
                        Action
                    </th>



                </tr>
            </thead>
            <tbody>
                @{
                    if (Model.TrainingCompletionList != null && Model.TrainingCompletionList.Count > 0)
                    {
                        for (int i = 0; i < Model.TrainingCompletionList.Count; i++)

                        {
                            <tr>
                                <td data-label="EmployeeID">
                                    @Model.TrainingCompletionList[i].EmployeeID
                                    @Html.HiddenFor(m => Model.TrainingCompletionList[i].EmployeeCode)
                                    @Html.HiddenFor(m => Model.TrainingCompletionList[i].EmployeeID)
                                    @Html.HiddenFor(m => Model.TrainingCompletionList[i].EmployeeID)
                                    @Html.HiddenFor(m => Model.TrainingCompletionList[i].Designation)
                                    @Html.HiddenFor(m => Model.TrainingCompletionList[i].Department)
                                    @Html.HiddenFor(m => Model.TrainingCompletionList[i].Location)
                                </td>
                                <td data-label="Employee Name">@Model.TrainingCompletionList[i].EmployeeName </td>
                                <td data-label="Designation">@Model.TrainingCompletionList[i].Designation </td>
                                <td data-label="Department">@Model.TrainingCompletionList[i].Department</td>
                                <td data-label="Location">@Model.TrainingCompletionList[i].Location</td>
                                <td data-label="DOJ">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.TrainingCompletionList[i].DOJ))</td>
                                <td data-label="Status">@Model.TrainingCompletionList[i].TrnStatus</td>

                                <td data-label="DOJ">
                                    <a data-bs-toggle="tooltip" title="Edit"
                                       class="btn btn-icon btn-edit icon-only" onclick="EditChange(@Model.TrainingCompletionList[i].EmployeeCode)">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>

                                </td>



                            </tr>
                        }
                    }
                }
            </tbody>





        </table>





    </div>

}