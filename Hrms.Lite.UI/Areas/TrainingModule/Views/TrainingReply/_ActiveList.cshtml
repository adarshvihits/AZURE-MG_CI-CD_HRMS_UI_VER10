@model Hrms.Lite.Shared.TrainingModule.TrainingReply
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        $('.AllTabCount').html("@Model.ActiveCount");
        $('.InActiveTabCount').html("@Model.InactiveCount");
        $('.pendingTabCount').html("@Model.PendingCount");

    });
</script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table replay-master-list pt-1">
    @Html.HiddenFor(m => m.TrainingReplyList.Count)
    <table id="SectionTable" class="common-table">
        <thead>
            <tr class="table-dark">

                <th scope="col">Name</th>
                <th scope="col">Reply Group</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>

            @{
                if (Model.TrainingReplyList != null && Model.TrainingReplyList.Count > 0)
                {

                    for (int i = 0; i < Model.TrainingReplyList.Count; i++)
                    {
                        <tr>

                            @Html.HiddenFor(model => Model.GI)
                            @Html.HiddenFor(model => Model.LogGI)
                            @Html.HiddenFor(m => m.TrainingReplyList[i].EditActive)
                            @Html.HiddenFor(model => Model.TrainingReplyList[i].Code)
                            <td data-label="Name">@Model.TrainingReplyList[i].Name</td>
                            <td data-label="Reply Group">@Model.TrainingReplyList[i].TrainingReplyGroup.Name</td>
                            <td data-label="Actions">
                                <div>
                                    @if (CurrentUserRoleActions.Modify == true)
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="addregion"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY', '@Model.TrainingReplyList[i].GI', '@Model.TrainingReplyList[i].LogGI',@i)">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Edit"
                                           id="addregion"
                                           class="btn btn-icon btn-edit icon-only " onclick="onAddNewOrEditClick('MODIFY', '@Model.TrainingReplyList[i].GI', '@Model.TrainingReplyList[i].LogGI',@i);
                                           swal.fire(MasterPersmissionMsg).then(function () { DisableAllElements('#newRequestSlider');});">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    }
                                    @if (CurrentUserRoleActions.Delete == true)
                                    {
                                        <!-- delete Slider  start-->
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="id=deleteregion"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.TrainingReplyList[i].GI','@Model.TrainingReplyList[i].LogGI','DELETE',@i)">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="Delete"
                                           id="id=deleteregion"
                                           class="btn btn-icon  icon-only mobile-full-width  btn-delete" onclick="onDeleteClick('@Model.TrainingReplyList[i].GI', '@Model.TrainingReplyList[i].LogGI', 'DELETE',@i);
                                           swal.fire(MasterPersmissionMsg);">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }


            }

        </tbody>
    </table>
</div>


