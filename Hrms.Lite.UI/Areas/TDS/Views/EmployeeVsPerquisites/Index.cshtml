@model Hrms.Lite.Shared.TDS.EmployeeVsPerquisites
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/TDS/EmployeeVsPerquisites.js"></script>
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Employee Vs Perquisites</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Employee Vs Perquisites
                    </li>

                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <!--begin: Search Form-->
                    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "perqUpload", enctype = "multipart/form-data" }))
                    { 
                        <div class="row tab-style-button">
                            <div class="tab-button-wrap">
                                <div class="tab-items ml-5 pr-0 border-none select-option">
                                    <div class="row-outer">
                                        <div class="form-group filter-combobox mr-2" style="width: 269px;">
                                            @Html.DropDownListFor(model => model.AssessmentYear.Code, (SelectList)ViewBag.AssessmentYear, "--Select Assessment Year--", new { @class = "form-control form-control-sm", @onchange = "onAssessmentYearChange(this);validate(this,'Assessmnt_year')" })
                                            <span id="Assessmnt_year"></span>
                                        </div>
                                        <div class="form-group filter-combobox mr-2" style="width: 269px;">
                                            @Html.DropDownListFor(Model => Model.PayrollMonth.Code, (SelectList)ViewBag.month, "--Select Month--", new { @class = "form-control form-control-sm month", @onchange = "validate(this,'month')" })
                                            <span id="month"></span>
                                        </div>
                                        <div class="form-group filter-combobox mr-2" style="width: 269px;">
                                            @Html.DropDownListFor(model => model.Perquisite.Code, (SelectList)ViewBag.Perquisite, "--Select Perquisite--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'Perquisit')" })
                                            <span id="Perquisit"></span>
                                        </div>
                                        <div class="tab-items pl-3 pt-3  d-flex align-items-center">

                                            <button type="button" class="btn btn-default btn-sm float-left" onclick="fillData()">
                                                Proceed
                                            </button>
                                        </div>
                                    </div>

                                </div>


                                <div class="tab-items select-option">


                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>
                                    <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>

                                    <a data-bs-toggle="tooltip" title="Export to Excel"
                                       class="btn btn-excel mr-0" onclick="ExportToExcel()">
                                        <i class="icon-xl far fa-file-excel"></i>
                                    </a>
                                    <button data-bs-toggle="tooltip" title="Import From Excel" type ="button"onclick="validateExcelDropdowns()"
                                            class="btn btn-excel ml-0 import">
                                        <i class="fa fa-upload icon-xls" aria-hidden="true"></i>
                                    </button>
                                </div>


                            </div>
                        </div>

                    <div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
                        <div class="modal-dialog modal-lg">
                            <div class="modal-content popup">
                                <div class="modal-header" style="padding:10px">
                                    <h5 class="modal-title" id="exampleModalLabel">Upload Format</h5>
                                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close" onclick="$('#Unmatchedlist').html('');$('#Excel_FileData').val()">
                                        <i aria-hidden="true" class="ki ki-close"></i>
                                    </button>
                                </div>

                                <div class="modal-body pt-3">
                                    <div class="colums_list pb-1">
                                        Please ensure your Excel file contains the following columns with the exact headings. Spelling and case must match precisely for a successful import -

                                        Employee ID,
                                        Employee Name,
                                        Perquisite Amount,
                                        TDS Amount<br />

                                    </div>
                                    <div class="row align-items-center mt-3">


                                        <div class="col-md-4">
                                            <div class="file-upload-form-group">
                                                <label for="formFileMultiple" class="form-label">
                                                    Attach
                                                    File
                                                    <span class="Mandatory">*</span>
                                                </label>

                                                <div class="file-upload-form mb-1" data-bs-toggle="tooltip" data-bs-original-title=" Only .xlsx files are
                                            allowed , File size less than 1 MB.">
                                                    <div class="small-btn-group">

                                                        <button type="button" data-bs-toggle="tooltip" data-placement="top" data-bs-original-title="View Image" class="btn btn-icon btn-default"><i class="icon-xl far fa-eye"></i></button>

                                                    </div>
                                                   
                                                    @Html.HiddenFor(model => model.Excel.FileData, new { type = "file", @class = "input-file PreviewImage form-control h-100", @onchange = "onImportExcelClick()" })


                                                </div>
                                            </div>


                                        </div>
                                    </div>

                                    <div id="Unmatchedlist">

                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                    }
                    <div id="SettingsEmployeeList">
                        @await Html.PartialAsync("_PerquisiteSettingsList", Model.EmployeeVsPerquisitesList)
                    </div>

                    <!-- Table Section -->
                    <!-- Table Setion End -->









                    

                    <!--end: Datatable-->
                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
                    </div>
                </div>
            </div>
            <div id="FilterPartial">

            </div>
            <div id="batchUpdate"></div>
        </div>


    </div>
    <div id="defaultsettings"></div>
</div>
