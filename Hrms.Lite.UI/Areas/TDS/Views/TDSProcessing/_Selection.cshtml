@model Hrms.Lite.Shared.TDS.TDSProcessing


<style>

    .drop-downs-boxx {
        width: 100%;
        padding:20px;
        background-color: #b2b3b5;
        box-shadow: rgba(99, 94, 102, 0.2) 0px -1px 15px 0px;
        border-radius: 10px;
    }


    .center-align-dropdownzz {
       
        background-color: white;
        padding: 40px 0px 50px;
        border-radius: 10px;
    }
    



</style>









<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body d-flex  justify-content-center align-items-center " >

                       


                                <!-- BOX Starts here-->



                            <div class="row justify-content-center w-100">

                                <div class="col-md-5">

                                    <div class="drop-downs-boxx">

                                        <div class="center-align-dropdownzz ">

                                            <div class="row justify-content-center">
                                                <div class="col-md-8">
                                                    <div class="form-group">
                                                        <label>Assessment Year</label>
                                                        @Html.DropDownListFor(model => model.AssessmentYear.Code, (SelectList)ViewBag.AssessmentYear, "--Select Assessment Year--", new { @class = "form-control form-control-sm", @onchange = "onAssessmentYearChange(this,'Assessmnt_year')" })
                                                        <span id="Assessmnt_year"></span>
                                                    </div>
                                                </div>
                                            </div>



                                            <div class="row justify-content-center">
                                                <div class="col-md-8">
                                                    <div class="form-group">
                                                        <label>Month</label>
                                                        @Html.DropDownListFor(Model => Model.PayrollMonth.Code, (SelectList)ViewBag.month, "--Select--", new { @class = "form-control form-control-sm month", @onblur = "validate(this,'month')" })
                                                        <span id="month"></span>
                                                    </div>
                                                </div>
                                            </div>



                                            <div class="row  justify-content-center ">
                                                <div class="col-md-8">
                                                    <div class="form-group">
                                                        <label>Payroll Group</label>
                                                        @Html.DropDownListFor(Model => Model.PayrollGroup.Code, (SelectList)ViewBag.PayrollGroup, "--Select--", new { @class = "form-control form-control-sm payroll", @onblur = "validate(this,'payrollgp');fillMonth(this)" })
                                                        <span id="payrollgp"></span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row  justify-content-center ">
                                                <div class="col-md-8">
                                                    <div class="form-group d-flex align-items-center">

                                                        <div class="checkbox-inline ">
                                                            <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary">
                                                                @Html.CheckBoxFor(m => m.Approved, new { @class = "allowance_appl" })
                                                                <span></span>
                                                            </label>
                                                        </div>
                                                        <label>Process with Approved declaration</label>
                                                    </div>
                                                </div>
                                            </div>


                                            <div class="row  justify-content-center ">
                                                <div class="col-md-2  align-items-center d-flex justify-content-center">
                                                    <a href="#" type="button"
                                                       class="btn btn-default float-right mobile-full-width mt-5" onclick="onProcessClick()">
                                                        Process
                                                    </a>
                                                </div>
                                            </div>

                                        </div>








                                        </div>




                                    </div>



                            </div>









                            <!-- <end table></end> -->

                        </div>

                    </div>
                </div>
            </div>




            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>