@model Hrms.Lite.Shared.TDS.TDSProcessing
<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>
<script src="~/scripts/TDS/TDSProcessing.js"></script>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">TDS Processing</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        TDS Processing
                    </li>

                </ul>
            </div>
        </div>

        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "TDS_PROCESS" }))
{
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body">

                        <div class="row tab-style-button">
                            <div class="tab-button-wrap">


                                <div class="tab-items">

                                    <div class="form-group filter-combobox mr-2" style="width: 120px;">
                                        <label class="view-title">Assessment Year </label>
                                        <div class="view-details">
                                            @Model.AssessmentYear.Name
                                            @Html.HiddenFor(Model => Model.AssessmentYear.Name)
                                            @Html.HiddenFor(Model => Model.AssessmentYear.Code)

                                        </div>

                                    </div>
                                </div>
                                <div class="tab-items">
                                    <div class="form-group filter-combobox mr-2" style="width: 120px;">
                                        <label class="view-title">PayRoll Group </label>
                                        <div class="view-details">
                                            @Model.PayrollGroup.Name
                                            @Html.HiddenFor(Model => Model.PayrollGroup.Name)
                                            @Html.HiddenFor(Model => Model.PayrollGroup.Code)
                                        </div>
                                    </div>
                                </div>
                                <div class="tab-items">
                                    <div class="form-group filter-combobox mr-2" style="width: 120px;">
                                        <label class="view-title">Month </label>
                                        <div class="view-details">
                                            @Model.PayrollMonth.Name
                                            @Html.HiddenFor(Model => Model.PayrollMonth.Name)
                                            @Html.HiddenFor(Model => Model.PayrollMonth.Code)
                                        </div>
                                    </div>
                                </div>

                                <div class="tab-items select-option">

                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>
                                    @*<div class="filter-button slider-btn" id="filterForm" data-bs-toggle="tooltip" title="Filter">
                        <i class="fas fa-filter"></i>
                        <i class="fas fa-check"></i>
                    </div>*@

                                    <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                       data-bs-original-title="Export to Excel">
                                        <i class="icon-xl far fa-file-excel" onclick="TDSSummaryExportToExcel()"></i>
                                    </a>
                                </div>



                            </div>
                        </div>

                            <div id="tds_DetailsList">
                                @await Html.PartialAsync("_ConfirmationDetails")
                            </div>

                            <div class="row card-footer-bottom-fixed">
                                <div class="col-md-12">

                                    <a href="#" type="button" class="btn btn-default float-right mobile-full-width" onclick="TDSConfirmationSave()">
                                        Apply
                                    </a>
                                    <a href="#" type="button"
                                       class="btn btn-default  mobile-full-width" onclick="TDSDetailRptExportToExcel()">
                                        Export - Detail Report
                                    </a>

                                </div>




                            </div>



                    




                            <!--end: Datatable-->
                        </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>


}




<div class="modal fade bd-example-modal-lg" tabindex="-1"
     role="dialog" aria-labelledby="myLargeModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg" style="max-width:1300px;">
        <div id="myDiv" class="modal-content popup" style=" margin: initial;">
            <div class="modal-header" style="padding:0px 10px">
                <h5 class="modal-title" id="exampleModalLabel">
                    TDS Details<span id="empDetails"></span>
                </h5>
                <button type="button" class="close mt-2"
                        data-bs-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true"
                       class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body" style=" padding: 1px 20px;">

            </div>



        </div>
    </div>
</div>