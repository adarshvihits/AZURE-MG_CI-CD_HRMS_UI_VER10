@model Hrms.Lite.Shared.TDS.TDSProcessing
<script src="~/js/settings.js"></script>


<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>






    <div class="ihits-table table-border  mobile-responsive-table tds_confirmation_details table_wrapper">
        @Html.HiddenFor(Model => Model.TDSConfirmationDetails.Count)
        <table id="TDSTable" class="common-table">

            <thead>
                <tr class="table-dark">
                    <th scope="col">ID</th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">Regime</th>
                    <th scope="col" class="text-right">Processed Salary</th>
                    <th scope="col" class="text-right">Projected Salary</th>
                    <th scope="col" class="text-right">Gross Salary</th>
                    <th scope="col" class="text-right">Tot.Exemption</th>
                    <th scope="col" class="text-right">Professional Tax</th>
                    <th scope="col" class="text-right">Other Income</th>
                    <th scope="col" class="text-right">80C</th>
                    <th scope="col" class="text-right">VI A</th>
                    <th scope="col" class="text-right">Taxable Income</th>
                    <th scope="col" class="text-right">Tax</th>
                    <th scope="col" class="text-right">Rebate</th>
                    <th scope="col" class="text-right">Surcharge</th>
                    <th scope="col" class="text-right">Edu.Cess</th>
                    <th scope="col" class="text-right">Total Tax</th>
                    <th scope="col" class="text-right">Tax Paid</th>
                    <th scope="col" class="text-right">Bal.Tax</th>
                    <th scope="col" class="text-right">Cur.Month Tax</th>
                    <th scope="col">Remaining Months</th>

                </tr>
            </thead>

            <tbody>

                @if (Model.TDSConfirmationDetails != null && Model.TDSConfirmationDetails.Count > 0)
                {


                    for (int i = 0; i < Model.TDSConfirmationDetails.Count; i++)
                    {

                <tr>

                    <td>
                        @Html.HiddenFor(m => m.TDSConfirmationDetails[i].EmployeeHeader.EmployeeGuid)

                        @Model.TDSConfirmationDetails[i].EmployeeHeader.EmployeeId

                    </td>
                    <td><a data-bs-toggle="modal" data-target=".bd-example-modal-lg" class="cursor-pointer" onclick="GetEmpPopUpDetails('@Model.TDSConfirmationDetails[i].EmployeeHeader.EmployeeGuid','@Model.PayrollMonth.Code')">  @Model.TDSConfirmationDetails[i].EmployeeHeader.EmployeeName </a></td>
                    <td>@Model.TDSConfirmationDetails[i].Regime</td>
                    <td class="text-right">@Model.TDSConfirmationDetails[i].ProcessedSalary</td>
                    <td class="text-right">@Model.TDSConfirmationDetails[i].ProjectedSalary</td>
                    <td class="text-right">@Model.TDSConfirmationDetails[i].GrossSalary</td>
                    <td class="text-right">@Model.TDSConfirmationDetails[i].TotExemption</td>
                    <td class="text-right">@Model.TDSConfirmationDetails[i].ProfessionalTax</td>
                    <td class="text-right">@Model.TDSConfirmationDetails[i].OtherIncome</td>
                    <td class="text-right">@Model.TDSConfirmationDetails[i].EightyC</td>
                    <td class="text-right">@Model.TDSConfirmationDetails[i].SixA</td>
                    <td class="text-right">@Model.TDSConfirmationDetails[i].TaxableIncome</td>
                    <td class="text-right">
                        @Html.HiddenFor(m => m.TDSConfirmationDetails[i].Tax)
                        @Model.TDSConfirmationDetails[i].Tax
                    </td>
                    <td class="text-right">@Model.TDSConfirmationDetails[i].Rebate</td>
                    <td class="text-right">@Model.TDSConfirmationDetails[i].Surcharge</td>
                    <td class="text-right">@Model.TDSConfirmationDetails[i].EduCess</td>
                    <td class="text-right">@Model.TDSConfirmationDetails[i].TotalTax</td>
                    <td class="text-right">@Model.TDSConfirmationDetails[i].TaxPaid</td>
                    <td class="text-right">@Model.TDSConfirmationDetails[i].BalTax</td>
                    <td class="text-right">
                        @Html.HiddenFor(m => m.TDSConfirmationDetails[i].CurrentMonthTax)
                        @Model.TDSConfirmationDetails[i].CurrentMonthTax
                    </td>
                    <td class="text-center">@Model.TDSConfirmationDetails[i].RemainingMonths</td>


                </tr>




                    }

                }
            </tbody>
        </table>
    </div>
    <!-- <end table></end> -->
