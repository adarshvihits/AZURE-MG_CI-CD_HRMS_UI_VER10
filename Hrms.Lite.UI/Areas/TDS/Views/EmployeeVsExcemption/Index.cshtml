@model Hrms.Lite.Shared.TDS.EmployeeVsExcemption
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/TDS/EmployeeVsExcemption.js"></script>
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Employee Vs Excemption</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Employee Vs Excemption
                    </li>

                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <!--begin: Search Form-->

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items ml-5 pr-0 border-none select-option">
                                <div class="row-outer">
                                    <div class="form-group filter-combobox mr-2" style="width: 269px;">
                                        @Html.DropDownListFor(model => model.AssessmentYear.Code, (SelectList)ViewBag.AssessmentYear, "--Select Assessment Year--", new { @class = "form-control form-control-sm", @onchange = "onAssessmentYearChange(this);validate(this,'Assessmnt_year')" })
                                        <span id="Assessmnt_year"></span>
                                    </div>
                                    <div class="form-group filter-combobox mr-2" style="width: 269px;">
                                        @Html.DropDownListFor(Model => Model.PayrollMonth.Code, (SelectList)ViewBag.month, "--Select Month--", new { @class = "form-control form-control-sm month", @onchange = "validate(this,'month')" })
                                        <span id="month"></span>
                                    </div>
                                    <div class="form-group filter-combobox mr-2" style="width: 269px;">
                                        @Html.DropDownListFor(model => model.Excemption.Code, (SelectList)ViewBag.Excemption, "--Select Excemption--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'Exemption')" })
                                        <span id="Exemption"></span>
                                    </div>
                                    <div class="tab-items pl-3 pt-3  d-flex align-items-center">

                                        <button type="button" class="btn btn-default btn-sm float-left" onclick="fillData()">
                                            Proceed
                                        </button>
                                    </div>





                                </div>

                            </div>




                            <div class="button-group float-right  batchleave mr-4">



                            </div>









                            <div class="tab-items select-option">


                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>

                                <a data-bs-toggle="tooltip" title="Export to Excel"
                                   class="btn btn-excel mr-0" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>
                               
                            </div>


                        </div>
                    </div>
                    <div id="SettingsEmployeeList">
                        @await Html.PartialAsync("_ExcemptionSettingsList", Model.EmployeeVsExcemptionList)
                    </div>

                    <!-- Table Section -->
                    <!-- Table Setion End -->









                    <div class="row card-footer-bottom-fixed d-flex ">







                    </div>

                    <!--end: Datatable-->
                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
                    </div>
                </div>
            </div>
            <div id="FilterPartial">

            </div>
            <div id="batchUpdate"></div>
        </div>


    </div>
    <div id="defaultsettings"></div>
</div>
