@model Hrms.Lite.Shared.TDS.Excemptions

    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table excemptios_vs_allowance vertical-scroll-500 mt-5">

        @Html.HiddenFor(m => m.ExcemptionsList.Count)
        <table id="ExcemptionVsAllowanceTable" class="common-table">
            <thead>
                <tr class="table-dark">

                    <th scope="col">Excemptions</th>
                    <th scope="col">Section</th>
                    <th scope="col">Component</th>
                    <th scope="col">Amount</th>
                    <th scope="col">Type</th>
                    <th scope="col">Allowance</th>


                </tr>
            </thead>
            <tbody>
                @if (Model.ExcemptionsList != null && Model.ExcemptionsList.Count > 0)
                {

                    for (int i = 0; i < Model.ExcemptionsList.Count; i++)
                    {

                        <tr>

                            <td data-label="Code">
                                @Html.HiddenFor(m => m.ExcemptionsList[i].ExCode)
                                @Html.DisplayFor(m => m.ExcemptionsList[i].Excemption)
                            </td>
                            <td data-label="Section">
                                @Html.DisplayFor(m => m.ExcemptionsList[i].Section)
                            </td>
                            <td data-label="Component">
                                @Html.DisplayFor(m => m.ExcemptionsList[i].ComponentType)
                            </td>
                            <td data-label="Amount">
                                @Html.DisplayFor(m => m.ExcemptionsList[i].ExAmount)
                            </td>
                            <td data-label="Type">
                                @Html.DisplayFor(m => m.ExcemptionsList[i].ExcemptionType)
                            </td>
                            <td data-label="Allowance">
                                @Html.DropDownListFor(m => m.ExcemptionsList[i].ExcemptionAllowance.Code, (SelectList)ViewBag.TDSAllowance, "--Select--", new { @class = "form-control form-control-sm" })

                            </td>


                        </tr>

                    }
                }
            </tbody>


        </table>

    </div>

