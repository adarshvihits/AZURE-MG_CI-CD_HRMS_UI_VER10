                        <td data-label="Limit"></td>
                        <td data-label="EAmount"></td>
                    </tr>



                    <tr class="even">

                        <td data-label="80U">15. Leave Travel (LT)</td>

                        <td data-label="ULeaveTravel">@Html.TextBoxFor(m => m.ChapterVIADetails.LeaveTravelAmt, new { @class = "form-control form-control-sm", @maxlength = 10, @onkeypress = "return onlyNumberKey(event)", @style = "text-align:right" })</td>



                        <td data-label="Limit"></td>
                        <td data-label="EAmount"></td>
                    </tr>









                    <tr class="even">

                        <td data-label="80U">16. Number of children for education allowance</td>

                        <td data-label="UChildrenfrEduAlw">@Html.TextBoxFor(m => m.ChapterVIADetails.NoOfChildren, new { @class = "form-control form-control-sm", @maxlength = 10, @onkeypress = "return onlyNumberKey(event)" })</td>



                        <td data-label="Limit"></td>
                        <td data-label="EAmount"></td>
                    </tr>



                    <tr class="even">

                        <td data-label="80U">17.Uniform Expense</td>

                        <td data-label="UUniformExpense">@Html.TextBoxFor(m => m.ChapterVIADetails.UniformExpense, new { @class = "form-control form-control-sm", @maxlength = 10, @onkeypress = "return onlyNumberKey(event)", @style = "text-align:right" })</td>
                        <td data-label="Limit"></td>
                        <td data-label="EAmount"></td>
                    </tr>





                </table>
                <div class="row mt-5">
                    <div class="col-md-12">
                        <button type="button" onclick="ChapterVIASave()"
                                class="btn btn-default float-right">
                            Save
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>

}




