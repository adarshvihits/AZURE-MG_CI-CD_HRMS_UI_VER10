@model Hrms.Lite.Shared.TDS.InvestmentDeclaration

<style>

    .grid-border-new{margin-top:10px;

    }

    .header-adress{
        font-weight:800;
        color:black;
    }
</style>


<div class="top-hed-new">

    @if (Model.HLRepayList != null && Model.HLRepayList.Count > 0)
    {

        for (int i = 0; i < Model.HLRepayList.Count; i++)
        {
            <div class="grid-border-new">
                <div class="row ">

                    <div class="col-md-2">
                        <div class="form-group">
                            <h5  class="header-adress">Address of House</h5>

                            <label class="view-title">Address of House</label>
                            <div class="view-details">
                                @Model.HLRepayList[i].HouseAddress
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="view-title">Location Status</label>
                            <div class="view-details">
                                @Model.HLRepayList[i].LocationStatusName
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="view-title">
                                Ownership Status
                            </label>
                            <div class="view-details">
                                @Model.HLRepayList[i].OwnerStatusName
                            </div>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="view-title">Percentage</label>
                            <div class="view-details">
                                @Model.HLRepayList[i].Percentage
                            </div>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="view-title">Purpose</label>
                            <div class="view-details">
                                @Model.HLRepayList[i].PurposeName
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="view-title">Date of Loan</label>
                            <div class="view-details">
                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.HLRepayList[i].DateofLoan))
                            </div>
                        </div>
                    </div>



                </div>

             

                <div class="row my-3">

                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="view-title">Date of Completion	</label>
                            <div class="view-details">
                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.HLRepayList[i].DateofCompletion))
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="view-title">Principal Amount</label>
                            <div class="view-details">
                                @Model.HLRepayList[i].PrincipalAmt
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="view-title">
                                Interest
                            </label>
                            <div class="view-details">
                                @Model.HLRepayList[i].Interest
                            </div>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="view-title">	Pre EMI Interest</label>
                            <div class="view-details">
                                @Model.HLRepayList[i].PreEMIInterest
                            </div>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="view-title">	Total Interest</label>
                            <div class="view-details">
                                @Model.HLRepayList[i].TotalInterest
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="view-title">	Name of Bank</label>
                            <div class="view-details">
                                @Model.HLRepayList[i].NameofBank
                            </div>
                        </div>
                    </div>



                </div>

                <div class="row my-3">

                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="view-title">	PAN of Bank</label>
                            <div class="view-details">
                                @Model.HLRepayList[i].PANofBank
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="view-title">	Address of Bank</label>
                            <div class="view-details">
                                @Model.HLRepayList[i].BankAddress
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="view-title">
                                Remarks
                            </label>
                            <div class="view-details">
                                @Model.HLRepayList[i].Remarks
                            </div>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <label class="view-title">
                            Edit
                        </label>
                        <div class="small-btn-group">
                            <a id="addHLRepayDetails" type="button"
                               class="btn btn-icon btn-edit icon-only" data-bs-toggle="tooltip" data-placement="top" title="Edit" onclick="HLRepayCreate('@Model.HLRepayList[i].TrnCode')">
                                <i class="icon-xl fas fa-pencil-alt"></i>
                            </a>

                            <a type="button"
                               class="btn btn-icon btn-delete icon-only" data-bs-toggle="tooltip" data-placement="top" title="Delete" onclick="DeleteHouseLoanRepay('@Model.HLRepayList[i].TrnCode')">
                                <i class="icon-xl far fa-trash-alt"></i>
                            </a>
                        </div>
                    </div>







                </div>
                </div>
                }

                }
                else
                {
                <div class="row "style="height:100%;">
                    <div class="new-dataaa-found">
                        No Data Found
                    </div>
                  
                </div>
                }
            </div>
   


