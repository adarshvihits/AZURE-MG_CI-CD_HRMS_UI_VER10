@model Hrms.Lite.Shared.TDS.InvestmentDeclaration
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "HouseRental" }))
        {
    <div class="row">
        <div class="col-md-12">
            <div class="ihits-table table-border mobile-responsive-table House-Rental-list mb-2 vertical-scroll-300 ">
                <table id="rental">
                    <thead>
                        <tr class="table-light">
                            <th scope="col">Month</th>
                            <th scope="col">City</th>
                            <th scope="col">Other City Name</th>
                            <th scope="col">Metro/NonMetro</th>
                            <th scope="col" class="text-right">Current Amt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @Html.HiddenFor(m => m.EmployeeGuid)
                        @Html.HiddenFor(m => m.AssessmentYear.Code)
                        @if (Model != null && Model.HouseRentalData.Count > 0)
                        {

                            for (int i = 0; i < Model.HouseRentalData.Count; i++)
                            {
                        <tr class="even">

                            <td data-label="Month">
                                @Html.HiddenFor(m => @Model.HouseRentalData[i].SalaryPeriodCode)
                                @Model.HouseRentalData[i].Month
                            </td>
                            <td data-label="City">
                                <div style="position:relative;">
                                    @Html.DropDownListFor(m => m.HouseRentalData[i].MetroCity.Code, (SelectList)ViewBag.MetroCity, "--Select--", new { @class = "form-control form-control-sm", @onchange = "onCityChange(this," + i + ")" })
                                    <span id="city_@i"></span>
                                </div>
                            </td>
                            <td data-label="other City Name">
                              
                                    @Html.TextBoxFor(m => Model.HouseRentalData[i].OtherCityName, new { @class = "form-control", placeholder = "Other City Name", @maxlength = 120, @onchange = "onOtherCityChange(this," + i + ")" })
                                    
                            </td>
                            <td data-label="Metro/NonMetro">@Html.TextBoxFor(m => Model.HouseRentalData[i].MetroNonMetro, new { @class = "form-control", placeholder = "Metro/NonMetro", @maxlength = 120 })</td>
                            <td data-label="Current Amount">
                               
                                    @Html.TextBoxFor(m => Model.HouseRentalData[i].Amount, new { @class = "form-control", placeholder = "Amount", @maxlength = 120, @onkeypress = "return onlyNumberKey(event)", @onblur = "validateCity(" + i + ")", @style = "text-align:right", @onchange = "onRentAmountChange(this," + i + ")" })
                                    
                                    </td>
                           
                        </tr>
                            }
                        }

                    </tbody>

                </table>
            </div>
        </div>
    </div>
<div class="accoding-new-color-change">House Rent Landlord Details</div>
<div id="landlord" class="row">
    <div class="col-md-12">
        <div class="ihits-table table-border mobile-responsive-table Investment-Under-Section-Landlord mb-2">
            <table id="tbllandlord">
                <thead>
                    <tr class="table-light">
                        <th scope="col">Sl.No.</th>
                        <th scope="col">Landlord</th>
                        <th scope="col">Address</th>
                        <th scope="col">From</th>
                        <th scope="col">To</th>
                        <th scope="col">Pan</th>
                        <th scope="col">Edit</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.LandlordList.Count > 0)
                    {
                        @for (int i = 0; i < Model.LandlordList.Count; i++)
                        {

                            <tr id="row_OI_@i">
                                <td data-label="SlNo">
                                    @Html.HiddenFor(m => m.LandlordList[i].TrnCode)
                                    @(i+1)
                                </td>
                                <td data-label="Name">
                                    @Html.TextBoxFor(m => m.LandlordList[i].Name, new { @class = "form-control", @readonly = "true" })

                                </td>

                                <td data-label="Address">
                                    @Html.TextBoxFor(m => m.LandlordList[i].Address, new { @class = "form-control", @readonly = "true" })

                                </td>
                                <td data-label="From">
                                    @Html.HiddenFor(m => m.LandlordList[i].From.Code)
                                    @Html.TextBoxFor(m => m.LandlordList[i].From.Name, new { @class = "form-control", @readonly = "true" })

                                </td>
                                <td data-label="To">
                                    @Html.HiddenFor(m => m.LandlordList[i].To.Code)
                                    @Html.TextBoxFor(m => m.LandlordList[i].To.Name, new { @class = "form-control", @readonly = "true" })
                                </td>
                                <td data-label="pan">
                                    @Html.TextBoxFor(m => m.LandlordList[i].Pan, new { @class = "form-control", @readonly = "true" })

                                </td>
                                <td data-label="Edit">
                                    <div class="small-btn-group">
                                        <a id="addLandlordDetails" type="button"
                                           class="btn btn-icon btn-edit icon-only" data-bs-toggle="tooltip" data-placement="top" title="Edit" onclick="LandlordCreate('Modify','@i')">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>

                                        <a type="button"
                                           class="btn btn-icon btn-delete icon-only" data-bs-toggle="tooltip" data-placement="top" title="Delete" onclick="LandlordDelete('@Model.LandlordList[i].TrnCode','@i')">
                                            <i class="icon-xl far fa-trash-alt"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }

                    }
                    else
                    {
                <tr>
                    <td colspan="7" align="center"><em>No table data</em></td>
                </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

</div>
}
<div class="row">
    <div class="col-md-12 ">
        <button type="button" onclick="HouseRentalSave()"
                class="btn btn-default float-right">
            Save
        </button>
        <button id="addLandlordDetails" type="button" class="btn btn-default float-right  add-btn-icon " onclick="LandlordCreate()">
            <i class="icon-nm fas fa-plus"></i>
        </button>
        <div id="LandlordAdd">
        </div>
    </div>
</div>
