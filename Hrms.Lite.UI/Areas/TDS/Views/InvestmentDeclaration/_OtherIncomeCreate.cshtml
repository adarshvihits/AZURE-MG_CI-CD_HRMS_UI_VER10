@model Hrms.Lite.Shared.TDS.InvestmentDeclaration
@{
    Model.TabIndex = "Other Income";
}

@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "pada" }))
{
    @Html.HiddenFor(m => m.TabIndex)
    @Html.HiddenFor(m => m.EmployeeGuid)

    <div id="addOtherIncomeDetails" class="slider-forms slider-forms-open OtherIncome">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('OtherIncome')"><i class="ki ki-close icon-xs text-muted"></i></div>
            <h3>Other Income Details</h3>
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label>Nature of Income</label><span class="Mandatory">*</span>
                        @Html.HiddenFor(m => m.OtherIncomeDetails.TrnCode, new { @class = "form-control form-control-sm" })
                        @Html.HiddenFor(m => m.SliderName)
                        @Html.TextBoxFor(m => m.OtherIncomeDetails.NatureofIncome, new { @class = "form-control", placeholder = "Nature of Income", @maxlength = 120, @onchange = "validate(this,'address')" })
                        <span id="address"></span>
</div>
                </div>
            </div>
          
        
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label>Amount</label><span class="Mandatory">*</span>
                        @Html.TextBoxFor(m => m.OtherIncomeDetails.Amount, new { @class = "form-control", placeholder = "Amount", @maxlength = 120, @onkeypress = "return onlyNumberKey(event)", @onchange = "validate(this,'amt  ')" })
                        <span id="amt"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label>TDS/TCS</label>
                        @Html.TextBoxFor(m => m.OtherIncomeDetails.TdsorTcs, new { @class = "form-control", placeholder = "Tds or Tcs", @maxlength = 120, @onkeypress = "return onlyNumberKey(event)" })
                    </div>
                </div>
            </div>
    
            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 float-right-btn">
                    <button id="otherincomeid" type="button" class="btn btn-default" onclick="OtherIncomeSave('@Model.SliderName')">@Model.SliderName</button>
                </div>
            </div>

        </div>
    </div>
}
