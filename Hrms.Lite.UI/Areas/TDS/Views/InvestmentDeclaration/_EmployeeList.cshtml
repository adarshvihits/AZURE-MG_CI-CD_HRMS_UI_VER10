
@model Hrms.Lite.Shared.TDS.InvestmentDeclaration
<script src="~/js/settings.js"></script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Investment_Declaration_Emp_List">
    @Html.HiddenFor(m => m.TDSEmployeeList.Count)
    <table id="TDSEmployeeListtable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th data-bs-toggle="tooltip" data-bs-original-title="House Rental" scope="col">Rental</th>
                <th data-bs-toggle="tooltip" data-bs-original-title="Section 80-C" scope="col">80-C</th>
                <th data-bs-toggle="tooltip" data-bs-original-title="Chapter VI A"  scope="col">VI A</th>
                @*<th scope="col">80-G</th>*@
                <th data-bs-toggle="tooltip" data-bs-original-title="House Loan Repayment" scope="col">Repay</th>
                <th data-bs-toggle="tooltip" data-bs-original-title="Income from Let Out House" scope="col">LOH</th>
                <th data-bs-toggle="tooltip" data-bs-original-title="Other Income"  scope="col">Others</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>



</div>