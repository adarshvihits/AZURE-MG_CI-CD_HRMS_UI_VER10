@model Hrms.Lite.Shared.TDS.InvestmentDeclaration
<div class="row">
    <div class="col-md-12">
        <div class="ihits-table table-border mobile-responsive-table  otherincome-tble-list mb-2">
            <table id="otherIncome">
                <thead>
                    <tr class="table-light">
                        <th scope="col">Sl.No.</th>
                        <th scope="col">Nature of Income</th>
                        <th scope="col">Amount(RS)</th>
                        <th scope="col">TDS/TCS</th>
                        <th scope="col">Edit</th>

                    </tr>
                </thead>
                <tbody>
                    @if (Model.OtherIncomeList.Count > 0)
                    {
                        @for (int i = 0; i < Model.OtherIncomeList.Count; i++)
                        {

                    <tr id="row_OI_@i">
                        <td data-label="SlNo">

                            @(i+1)
                        </td>

                        <td data-label="NatureofIncome">

                            @Html.DisplayFor(m => m.OtherIncomeList[i].NatureofIncome)
                        </td>

                        <td data-label="Amount">

                            @Html.DisplayFor(m => m.OtherIncomeList[i].Amount)
                        </td>
                        <td data-label="TdsorTcs">

                            @Html.DisplayFor(m => m.OtherIncomeList[i].TdsorTcs)
                        </td>

                        <td data-label="Edit">
                            <div class="small-btn-group">
                                <a id="addOtherIncome" type="button"
                                   class="btn btn-icon btn-edit icon-only" data-bs-toggle="tooltip" data-placement="top" title="Edit" onclick="OtherIncomeCreate('@Model.OtherIncomeList[i].TrnCode')">
                                    <i class="icon-xl fas fa-pencil-alt"></i>
                                </a>

                                <a type="button"
                                   class="btn btn-icon btn-delete icon-only" data-bs-toggle="tooltip" data-placement="top" title="Delete" onclick="DeleteOtherIncomeDetails('@Model.OtherIncomeList[i].TrnCode')">
                                    <i class="icon-xl far fa-trash-alt"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                        }

                    }
                    else
                    {
                <tr>
                    <td colspan="5" align="center"><em>No table data</em></td>
                </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>
</div>
<div class="row">
    <div class="col-md-12 ">
        <button id="addOtherIncome" type="button" class="btn btn-default float-right add-btn-icon " onclick="OtherIncomeCreate()">
            <i class="icon-nm fas fa-plus"></i>
            
        </button>
        <div id="OtherIncomeSave">


        </div>
    </div>
</div>