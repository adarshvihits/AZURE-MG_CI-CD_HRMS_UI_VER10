@model Hrms.Lite.Shared.TDS.InvestmentDeclaration
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "ChapterVIA" }))

{

    <style>
        .flaticon-attachment:before {
            content: "\f126" !important;
            font-family: Flaticon !important;
            padding-right: 12px;
        }

        .tds-dfexx {
            display: flex;
            align-items: center;
            justify-content: right;
            padding-right: 35px;
        }

        .tds-status{
            font-size:12px;
            margin:0;
            padding-left:10px;
        }


    </style>
    <link href="~/css/plugins.bundle.css" rel="stylesheet" />
    <div class="row">
        <div class="col-md-12">


            <div class="ihits-table table-border mobile-responsive-table four-a-Proof-list mb-2">
                <table id="chapterVIA">
                    <thead>
                        <tr class="table-light">
                            <th scope="col"></th>
                            <th scope="col">Actual Amount</th>
                            <th scope="col">Approved Amount</th>


                        </tr>
                    </thead>


                </table>
            </div>
        </div>
