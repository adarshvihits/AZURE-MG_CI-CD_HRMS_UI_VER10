                                }
                            </div>
                            @if (Model.ChapterVIADetails.CCDAppStatus == "Approved")
                            {
                                <div style="width: 75px; color: #37B678; display: flex; align-items: center;">
                                    <h3 class="tds-status">@Model.ChapterVIADetails.CCDAppStatus </h3>
                                </div>
                            }
                            else
                            {
                                <div style="width: 75px; color: red; display: flex; align-items: center;">
                                    <h3 class="tds-status">@Model.ChapterVIADetails.CCDAppStatus </h3>
                                </div>
                            }
                           
                        </div>









                    </div>

                </div>



