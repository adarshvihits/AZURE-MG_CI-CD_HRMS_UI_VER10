                                {
                                    <a data-bs-toggle="modal" data-bs-original-title="Reject" id="SixACCCbtnId" class="btn_reject" onclick="RejectionPopUp(0,'80CCC')">  </a>
                                    <a data-bs-toggle="tooltip" data-bs-original-title="Approve" id="ApprovebtnId" class="btn_approve" onclick="ChapterSixAApproval('Approved','80CCC')"></a>
                                }
                            </div>
                            @if (Model.ChapterVIADetails.CCCAppStatus == "Approved")
                            {
                                <div style="width: 75px; color: #37B678; display: flex; align-items: center;">
                                    <h3 class="tds-status">@Model.ChapterVIADetails.CCCAppStatus </h3>
                                </div>
                            }
                            else
                            {
                                <div style="width: 75px; color: red; display: flex; align-items: center;">
                                    <h3 class="tds-status">@Model.ChapterVIADetails.CCCAppStatus </h3>
                                </div>
                            }

                        </div>

                    </div>
                </div>

                <div class="ihits-table table-border mobile-responsive-table four-a-Proof-list mb-2">
