                            <td data-label="DExpenditureSnr">@Html.TextBoxFor(m => m.ChapterVIADetails.A_MedExpSrCtznAmt, new { @class = "form-control form-control-sm", @disabled = "disabled", @style = "text-align:right" })</td>
