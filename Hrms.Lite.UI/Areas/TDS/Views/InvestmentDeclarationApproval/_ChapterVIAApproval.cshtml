                            <td></td>
                            <td></td>

                        </tr>

                    </table>
                </div>





                <div class="d-flex" style="background-color: #dce4eb;">
                    <div class=" col-md-10 accoding-new-color-change">7. 80DD (Certificate in form 10IA from prescribed government medical authority is required)</div>
                    <div class=" col-md-2 pt-1 pb-1 tds-dfexx">





