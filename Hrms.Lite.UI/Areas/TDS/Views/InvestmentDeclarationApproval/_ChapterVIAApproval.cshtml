                            <tr class="table-light">
                                <th scope="col"></th>
                                <th scope="col"></th>
                                <th scope="col"></th>


                            </tr>
                        </thead>
                        <tr class="even">
                            @Html.HiddenFor(m => m.EmployeeGuid)
                            @Html.HiddenFor(m => m.AssessmentYear.Code)
                            @Html.HiddenFor(m => m.ChapterVIADetails.TrnCode)


                            <td data-label="PPS">4.1. Payment to pension schemes</td>
                            <td data-label="PPSAmount">@Html.TextBoxFor(m => m.ChapterVIADetails.A_PPSAmt, new { @class = "form-control form-control-sm", @disabled = "disabled", @style = "text-align:right" })</td>
                            <td data-label="PPSAmount">@Html.TextBoxFor(m => m.ChapterVIADetails.PPSAmt, new { @class = "form-control form-control-sm", @maxlength = 10, @onkeypress = "return onlyNumberKey(event)", @style = "text-align:right", @onchange = "PPSChange()" })</td>

                        </tr>
                        <tbody>
                        </tbody>

                    </table>
                </div>


                <div class="d-flex" style="background-color: #dce4eb;">
                    <div class=" col-md-10 accoding-new-color-change">5. 80CCD - 1B</div>
