                                @Html.DropDownListFor(m => m.ChapterVIADetails.CriticalAilments.Code, (SelectList)ViewBag.CriticalAliments, "--Select--", new { @class = "form-control form-control-sm", @onchange = "CriticalAilments()" })
                            </td>

