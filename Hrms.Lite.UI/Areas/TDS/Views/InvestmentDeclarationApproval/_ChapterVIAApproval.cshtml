                            <td data-label="other City Name">
                                @Html.DropDownListFor(m => m.ChapterVIADetails.IsDepndHandicaped.Code, (SelectList)ViewBag.YesorNo, "--Select--", new { @class = "form-control form-control-sm", @onchange = "IsHandicaped()" })
