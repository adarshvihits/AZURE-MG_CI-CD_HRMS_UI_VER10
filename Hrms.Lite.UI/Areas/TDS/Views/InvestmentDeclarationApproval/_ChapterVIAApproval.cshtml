                                    <h3 class="tds-status">@Model.ChapterVIADetails.DDAppStatus </h3>
                                </div>
                            }

                          
                        </div>


                    </div>

                </div>

                <div class="ihits-table table-border mobile-responsive-table four-a-Proof-list mb-2">
                    <table id="family">

                        <tr class="even">

                            <td data-label="DepHandicaped">7.1. Handicaped dependent</td>
                            <td data-label="other City Name">
                                @Html.DropDownListFor(m => m.ChapterVIADetails.A_IsDepndHandicaped.Code, (SelectList)ViewBag.YesorNo, "--Select--", new { @class = "form-control form-control-sm", @disabled = "disabled" })
