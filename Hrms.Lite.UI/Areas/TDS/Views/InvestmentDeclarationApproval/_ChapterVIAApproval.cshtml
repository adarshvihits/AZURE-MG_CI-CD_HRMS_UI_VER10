                            <td data-label="NPS">5.1. National Pension Scheme(NPS) [Tier 1]</td>
                            <td data-label="NPSAmt">@Html.TextBoxFor(m => m.ChapterVIADetails.A_NPSAmt, new { @class = "form-control form-control-sm", @disabled = "disabled", @style = "text-align:right" })</td>
