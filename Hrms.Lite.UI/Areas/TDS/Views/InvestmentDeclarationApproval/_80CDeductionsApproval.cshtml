@model Hrms.Lite.Shared.TDS.InvestmentDeclaration

<style>
    .form-control {
        height: calc(1.0em + 1.3rem + 2px) !important;
    }



    .ihits-table .form-control {
        color: tomato;
        font-weight: 500;
    }
</style>

@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "deduction" }))
{



    <div class="row">
        <div class="col-md-12">
            <div class="ihits-table table-border mobile-responsive-table  eighty-g-tble-Approval-list  mb-2 Investmen-Under-Section-list ">
                <table id="investment">
                    <thead>
                        <tr class="table-light">
                            <th scope="col">Sl.No.</th>
                            <th scope="col">Deduction</th>
                            <th class="text-right" scope="col">Actual Amt</th>
                            <th class="text-right" scope="col">Approved Amt</th>
                            <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="View">View</th>
                            <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Actions">Action</th>
                            <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Status">Status</th>
                        </tr>
                    </thead>
                    <tbody>

                        @Html.HiddenFor(m => m.EmployeeGuid)
                        @Html.HiddenFor(m => m.AssessmentYear.Code)
                        @Html.HiddenFor(m => m.EightyCDeductionList.Count)

                        @if (Model.EightyCDeductionList != null)
                        {
                            @for (int i = 0; i < Model.EightyCDeductionList.Count; i++)
                            {

                                <tr id="row_OI_@i">

                                    <td data-label="slno">

                                        @(i + 1)
                                    </td>
                                    <td data-label="deduction">
                                        @Html.HiddenFor(m => Model.EightyCDeductionList[i].flag)
                                        @Html.HiddenFor(m => Model.EightyCDeductionList[i].TrnCode)
                                        @Html.HiddenFor(m => Model.EightyCDeductionList[i].InvestmentCode)
                                        @Html.DisplayFor(m => Model.EightyCDeductionList[i].InvestmentName)
                                    </td>
                                    <td data-label="Amount">
                                        @Html.TextBoxFor(m => Model.EightyCDeductionList[i].Amount, new { @class = "form-control", placeholder = "Amount", @maxlength = 120, @onkeypress = "return onlyNumberKey(event)", @readonly = "true", @style = "text-align:right" })
                                    </td>

                                    <td data-label="Amount">
                                        @Html.TextBoxFor(m => Model.EightyCDeductionList[i].ApprovedAmount, new { @class = "form-control", placeholder = "Amount", @maxlength = 120, @onkeypress = "return onlyNumberKey(event)", @style = "text-align:right", @onchange = "onDeductionAmtChange()" })
                                    </td>
                                    <td data-label="AttachDocument">
                                        <i onclick="GetUploadDocumentPopUp('80C_DED', '@Model.EightyCDeductionList[i].InvestmentCode')" title="Click Here To View Document" class="flaticon far fa-eye"></i>
                                        <span class="">@Model.EightyCDeductionList[i].DedDocCount </span>
                                    </td>

                                    <td data-label="reject">
                                        @if(Model.EightyCDeductionList[i].DedDocCount > 0 && Model.EightyCDeductionList[i].Amount > 0)
                                        {
                                            <a data-bs-toggle="modal" data-bs-original-title="Reject" id="DeductionbtnId_@i" class="btn_reject" onclick="RejectionPopUp(@i,'80CSection')">  </a>

                                            <a data-bs-toggle="tooltip" data-bs-original-title="Approve" id="ApprovebtnId_@i" class="btn_approve" onclick="DeductionApproval(@i,'Approved','80CSection')"></a>
                                        }

                                    </td>



                                    <td data-label="Status" style="font-weight:600; color:@Model.EightyCDeductionList[i].StatusColor"> @Html.DisplayFor(m => Model.EightyCDeductionList[i].ApprovalStatus)</td>



                                </tr>
                            }

                        }

                    </tbody>


                    <tfoot style=" width:100%;">
                        <tr class="table-light">
                            <td data-label="slno"><strong></strong></td>
                            <td data-label="deduction">
                                <strong></strong>
                            </td>
                            <td data-label="Actual" align="right">
                                <span id="DedActAmt"></span>
                            </td>
                            <td data-label="Approved" align="right">
                                <span id="DedAppAmt"></span>
                            </td>
                            <td data-label="view">
                                <strong></strong>
                            </td>
                            <td data-label="action">
                                <strong></strong>
                            </td>
                            <td data-label="status">
                                <strong></strong>
                            </td>
                        </tr>

                    </tfoot>




                </table>

            </div>

        </div>
    </div>


}
<div class="accoding-new-color-change">LIC - Actual Entry Details</div>
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "lic" }))
{
    <div id="tablic" class="row">
        <div class="col-md-12">
            <div class="ihits-table table-border mobile-responsive-table    LIC-Actual-Entry-Details-list  mb-2">
                <table id="family">
                    <thead>
                        <tr class="table-light">
                            <th scope="col">Sl.No.</th>
                            <th scope="col">Name</th>
                            <th scope="col">Relationship</th>
                            <th scope="col">Policy Taken Date</th>
                            <th scope="col">Policy No.</th>
                            <th class="text-right" scope="col">Annual Premium</th>
                            <th class="text-right" scope="col">Sum Assured</th>

                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.LICActualList.Count > 0)
                        {
                            @for (int i = 0; i < Model.LICActualList.Count; i++)
                            {

                                <tr id="row_OI_@i">
                                    <td data-label="SlNo">
                                        @(i + 1)
                                    </td>
                                    <td data-label="Name">

                                        @Html.DisplayFor(m => m.LICActualList[i].Name)
                                    </td>

                                    <td data-label="Relationship">

                                        @Html.DisplayFor(m => m.LICActualList[i].RelationShipName)
                                    </td>
                                    <td data-label="PolicyTakenDate">
                                        @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.LICActualList[i].PolicyTakenDate))

                                    </td>
                                    <td data-label="PolicyNo">

                                        @Html.DisplayFor(m => m.LICActualList[i].PolicyNo)

                                    </td>
                                    <td class="text-right" data-label="PremiumAmount">

                                        @Html.DisplayFor(m => m.LICActualList[i].PremiumAmount)
                                    </td>
                                    <td class="text-right" data-label="SumAssured">

                                        @Html.DisplayFor(m => m.LICActualList[i].SumAssured)
                                    </td>


                                </tr>
                            }

                        }
                        else
                        {
                            <tr>
                                <td colspan="9" align="center"><em>No table data</em></td>
                            </tr>
                        }
                    </tbody>




                </table>
            </div>
        </div>

    </div>
    <div class="accoding-new-color-change">LIC - Approval</div>
    <div id="tablic" class="row">
        <div class="col-md-12">
            <div class="ihits-table table-border mobile-responsive-table Investment-Under-Section-Landlord-Approval-list mb-2">
                <table id="family">
                    <thead>
                        <tr class="table-light">
                            <th scope="col">Sl.No.</th>
                            <th scope="col">Name</th>
                            <th scope="col">Relationship</th>
                            <th scope="col">Policy Taken Date</th>
                            <th scope="col">Policy No.</th>
                            <th class="text-right" scope="col">Annual Premium</th>
                            <th class="text-right" scope="col">Sum Assured</th>
                            <th scope="col">Remarks</th>
                            <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="View">View</th>
                            <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Reject">Action</th>


                            <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Status">Status</th>



                        </tr>
                    </thead>

                    <tbody>
                        @Html.HiddenFor(m => m.EmployeeGuid)
                        @Html.HiddenFor(m => m.AssessmentYear.Code)
                        @if (Model.LICList.Count > 0)
                        {
                            @for (int i = 0; i < Model.LICList.Count; i++)
                            {

                        <tr id="row_OI_@i">
                            <td data-label="SlNo">
                                @(i + 1)
                            </td>
                            <td data-label="Name">
                                @Html.HiddenFor(m => Model.LICList[i].flag)
                                @Html.HiddenFor(m => Model.LICList[i].TrnCode)
                                @Html.HiddenFor(m => Model.LICList[i].Name)
                                @Html.DisplayFor(m => m.LICList[i].Name)
                            </td>

                            <td data-label="Relationship">
                                @Html.HiddenFor(m => Model.LICList[i].RelationShip.Code)
                                @Html.DisplayFor(m => m.LICList[i].RelationShipName)
                            </td>
                            <td data-label="PolicyTakenDate">
                                @Html.HiddenFor(m => Model.LICList[i].PolicyTakenDate)
                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.LICList[i].PolicyTakenDate))

                            </td>
                            <td data-label="PolicyNo">
                                @Html.HiddenFor(m => Model.LICList[i].PolicyNo)
                                @Html.DisplayFor(m => m.LICList[i].PolicyNo)

                            </td>
                            <td class="text-right" data-label="PremiumAmount">
                                @Html.TextBoxFor(m => m.LICList[i].PremiumAmount, new { @class = "form-control", placeholder = "Premium Amount", @maxlength = 120, @onkeypress = "return onlyNumberKey(event)", @style = "text-align:right" })
                                <span id="premium" class="text-danger"></span>
                            </td>
                            <td class="text-right" data-label="SumAssured">

                                @Html.TextBoxFor(m => m.LICList[i].SumAssured, new { @class = "form-control", placeholder = "Sum Assured", @maxlength = 120, @onkeypress = "return onlyNumberKey(event)", @style = "text-align:right" })
                                <span id="sumassured" class="text-danger"></span>
                            </td>
                            <td data-label="Remarks">
                                @Html.HiddenFor(m => Model.LICList[i].Remarks)
                                @Html.DisplayFor(m => m.LICList[i].Remarks)
                            </td>

                            <td data-label="AttachDocument">
                                <i onclick="GetUploadDocumentPopUp('LIC', '@Model.LICList[i].TrnCode')" title="Click Here To View Document" class="flaticon far fa-eye"></i>
                                <span>@Model.LICList[i].LICDocCount </span>
                            </td>






                            <td data-label="reject">
                                <a data-bs-toggle="modal" data-bs-original-title="Reject" id="licbtnId_@i" class="btn_reject" onclick="RejectionPopUp(@i,'lic')">  </a>

                                <a data-bs-toggle="tooltip" data-bs-original-title="Approve" id="ApprovebtnId_@i" class="btn_approve" onclick="LICApproval(@i,'Approved','lic')"></a>
                            </td>




                            <td data-label="Status" style="font-weight:600; color:@Model.LICList[i].StatusColor"> @Html.DisplayFor(m => Model.LICList[i].ApprovalStatus)</td>
                       





                        </tr>
                            }

                        }
                        else
                        {
                            <tr>
                                <td colspan="8" align="center"><em>No table data</em></td>
                            </tr>
                        }
                    </tbody>




                </table>
            </div>
        </div>

    </div>
}