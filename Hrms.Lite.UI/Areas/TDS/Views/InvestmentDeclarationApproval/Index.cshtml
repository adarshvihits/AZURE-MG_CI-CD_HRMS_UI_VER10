@model Hrms.Lite.Shared.TDS.InvestmentDeclaration
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>

<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/TDS/investmentDeclarationApproval.js"></script>


<style>

    textarea.form-control {
        height: 60px !important;
        PADDING: 8PX;
    }



</style>


<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->

        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Investment Declaration Approval</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Investment Declaration Approval List
                    </li>
                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <!--begin: Search Form-->
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items">
                                <span class="btn-title active tab1"onclick="tabClick('tab1','0')">
                                    Approval Pending
                                </span>
                            </div>

                            <div class="tab-items">
                                <span class="btn-title tab2" onclick="tabClick('tab2', '1')">
                                    Approved/Rejected
                                </span>
                            </div>

                            @Html.HiddenFor(m => m.TabIndex)
                            <div class="tab-items ml-5 pr-0  mr-5  border-none ">
                                <div class="row-outer">
                                    <div class="form-group filter-combobox mr-2" style="width: 269px;">

                                        @Html.DropDownListFor(model => model.AssessmentYear.Code, (SelectList)ViewBag.AssessmentYear, @*"--Select Assessment Year--",*@ new { @class = "form-control form-control-sm"@*, @onblur= "validate(this,'Allowance_span')"*@, @onchange = "fillData(0);validate(this,'Assessmnt_year')" })
                                        <span id="Assessmnt_year" style="bottom: -15px;"></span>
                                    </div>
                                </div>

                            </div>
                            <div class="tab-items pl-3 pt-1  d-flex align-items-center">

                                <button type="button" class="btn btn-default btn-sm float-left" onclick="fillData($('#AssessmentYear_Code').val())">
                                    Proceed
                                </button>
                            </div>


                            <div class="tab-items select-option d-flex ">




                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>

                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>



                            </div>



                        </div>
                    </div>
                    <!-- Table Section -->
                    <div id="SettingsEmployeeList">



                        @await Html.PartialAsync("_EmployeeList")
                    </div>

                    <!-- Table Setion End -->
                    <div class="row card-footer-bottom-fixed">




                    </div>
                    <!--end: Datatable-->
                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.filter)
                    </div>

                </div>
                <div id="FilterPartial">

                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>

</div>
<!--end::Content-->
<!--end::Entry-->
