@model Hrms.Lite.Shared.TDS.Form16
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*<script src="~/js/jquery.min.js"></script>*@
<script src="~/js/jquery.min.js"></script>
<link href="https://kendo.cdn.telerik.com/2022.3.913/styles/kendo.common.min.css" rel="stylesheet" />
<link href="https://kendo.cdn.telerik.com/2022.3.913/styles/kendo.uniform.min.css" rel="stylesheet" />


<style>

    #Form16Viewer {
        position: absolute;
        left: 52px;
        right: 52px;
        top: 50px;
        bottom: 5px;
        overflow: hidden;
        clear: both;
    }
</style>





<style>
    #Form16Viewer {
        position: absolute;
        left: 40px;
        right: 38px;
        top: 0;
        overflow: hidden;
        clear: both;
    }

    .card.card-custom > .card-body {
        padding: 10px 25px 25px 50px !important;
    }

    .my-wrapper {
        display: block !important;
    }

    .my-inner3 {
        padding-top: 15px;
        float: left !important;
    }

    .my-inner2 {
        float: left !important;
    }

    .tab-button-wrap .tab-items {
        padding: 0px 2px 0px 5px;
    }

    .payslip_container {
        padding: 0;
        height: 100%;
    }

    .select-option .sraech-slider {
        margin-right: -1px;
    }

    .payslip_container {
        background-color: #f6f8fc;
    }
</style>


<script src="~/scripts/TDS/Form16.js"></script>
<script>
    $(document).ready(function () {
        fillData();

    })

</script>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->

        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Form 16</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area=""})"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Form 16
                    </li>
                </ul>
            </div>
        </div>


    </div>
    <!--end::Container-->
</div>
<!--end::Header-->

<div class="card card-custom height-100per footer-row-fixed">


    <div class="card-body">

       
        <div class="form-group filter-combobox mr-2" style="width: 269px;">
            @Html.DropDownListFor(model => model.AssessmentYear.Code, (SelectList)ViewBag.AssessmentYear, "--Select Assessment Year--", new { @class = "form-control form-control-sm", @onchange = "onAssessmentYearChange(this);validate(this,'Assessmnt_year')" })
            <span id="Assessmnt_year"></span>
        </div>



        <div class="row">


            <div class="col-xl-4 col-md-4">

                <!------------- search emplyee here ------------------>
                <div class="payslip_container">
                    <div class="row tab-style-button pb-3">
                        <div class="tab-button-wrap">

                            <div class="tab-items select-option d-flex align-items-center">


                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>


                            </div>



                        </div>
                    </div>

                    @await Html.PartialAsync("~/Areas/TDS/Reports/Views/Form16/_EmployeeList.cshtml", Model)


                </div>

                <!------------- search emplyee here ------------------>

            </div>
            <div class="col-xl-8 col-md-8">

                <!------------- pdf view here ------------------>

                <div class="payslip_container">

                    <div id="Form16Viewer" class="hide">

                    </div>




                </div>
                <!------------- pdf view here ------------------>

            </div>
        </div>





    </div>



</div>




@section scripts
    {
    <script src="/api/reports/resources/js/telerikReportViewer"></script>

    <script type="text/javascript">

        function onReady(e, args) {
            var kendoTouch = $(".trv-pages-area").data("kendoTouch");

            if (kendoTouch) {
                kendoTouch.unbind("doubletap");
            }
        }

        $(document).ready(function () {

            var code = $('#Basic_Filter_Location_Code').val();

          

            $("#Form16Viewer")
                .telerik_ReportViewer({
                    // The URL of the service which will serve reports.
                    // The URL corresponds to the name of the controller class (ReportsController).
                    // For more information on how to configure the service please check http://www.telerik.com/help/reporting/telerik-reporting-rest-conception.html.
                    serviceUrl: "/api/reports/",

                    pageReady: onReady,


                    reportSource: {

                        report: 'Form16.trdp',


                        parameters: {

                            Url: "",

                        }


                    },


                    viewMode: telerikReportViewer.ViewModes.PRINT_PREVIEW,

                    scaleMode: telerikReportViewer.ScaleModes.SPECIFIC,

                    scale: 1.0,
                    enableAccessibility: false,
                    sendEmail: { enabled: true }
                });




        });
    </script>
}




