
@model Hrms.Lite.Shared.TDS.EmployeePerquisitesReport

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/scripts/TDS/employeePerquisitesReport.js" asp-append-version="true"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>

<div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->
            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Employee Perquisites Report</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>
                        <li class="breadcrumb-item text-muted">
                            Employee Perquisites Report
                        </li>
                    </ul>
                </div>
            </div>
            <!--begin::Topbar-->
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->
                <div class="card card-custom height-100per footer-row-fixed">
                    <div class="card-body">
                        <div class="row tab-style-button">
                            <div class="tab-button-wrap">
                                <div class="tab-items ml-5 pr-0 border-none select-option">
                                    <div class="row-outer">
                                        <div class="form-group filter-combobox mr-2" style="width: 250px;"><label>Assessment Year</label>
                                            @Html.DropDownListFor(model => model.AssessmentYear.Code, (SelectList)ViewBag.AssessmentYear, "--Select Assessment Year--", new { @class = "form-control form-control-sm", @onchange = "onAssessmentYearChange(this);validate(this,'Assessmnt_year');fillData()" })
                                            <span id="Assessmnt_year"></span>
                                        </div>
                                        <div class="form-group filter-combobox mr-2" style="width:150px;"><label>Month</label>
                                            @Html.DropDownListFor(Model => Model.Month.Code, (SelectList)ViewBag.month, "--All--", new { @class = "form-control form-control-sm month", @onchange = "validate(this,'month');fillData()" })
                                            <span id="month"></span>
                                        </div>
                                        <div class="form-group filter-combobox mr-2" style="width: 269px;"><label>Perquisite</label>
                                            @Html.DropDownListFor(model => model.Perquisite.Code, (SelectList)ViewBag.Perquisite, "--All--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'Perquisit');fillData()" })
                                            <span id="Perquisit"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="tab-items select-option">
                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>
                                    <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>

                                    <a data-bs-toggle="tooltip" title="Export to Excel"
                                       class="btn btn-excel mr-0" onclick="ExportToExcel()">
                                        <i class="icon-xl far fa-file-excel"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div id="TDSProcessd">
                            @await Html.PartialAsync("~/Areas/TDS/Reports/Views/EmployeePerquisitesReport/_List.cshtml")
                        </div>
                        <div id="filterSlider">
                            @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.filter)
                        </div>
                        <!--end: Datatable-->
                    </div>
                </div>
                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->
    </div>
    <!--end::Content-->
</div>