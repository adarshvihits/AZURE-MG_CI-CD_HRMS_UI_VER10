@model Hrms.Lite.Shared.TDS.TDSVariationReport
@*<script src="~/js/jquery.min.js"></script>
    <script src="~/js/datatables.min.js"></script>*@
<script src="~/scripts/TDS/TDSProcessing.js"></script>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "TDS_PROCESS" }))
{
    <div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
        <!--begin::Header-->
        <div id="kt_header" class="header header-fixed">
            <!--begin::Container-->
            <div class="container-fluid d-flex align-items-stretch justify-content-between">
                <!--begin::Header Menu Wrapper-->


                <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                    <!--begin::Header Menu-->
                    <div class="d-flex align-items-baseline flex-wrap mr-5">
                        <h3 class="main-title"> TDS Variation Report</h3>
                        <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                            <li class="breadcrumb-item ">
                                <a href="@Url.Action("Index", "Home", new { Area = "" })" class=""><i class="icon-nm fas fa-home"></i></a>
                            </li>

                            <li class="breadcrumb-item text-muted">
                                TDS Variation Report
                            </li>
                        </ul>
                    </div>
                </div>

            </div>
            <!--end::Container-->
        </div>
        <!--end::Header-->
        <!--begin::Content-->
        <div id="tds_selection">
            @await Html.PartialAsync("~/Areas/TDS/Reports/Views/TDSVariationReport/_Selection.cshtml")
        </div>
        @*<div id="tds_DetailsList" class="hide">
            @await Html.PartialAsync("_ConfirmationDetails")
        </div>*@
        <!--end::Content-->
    </div>

}