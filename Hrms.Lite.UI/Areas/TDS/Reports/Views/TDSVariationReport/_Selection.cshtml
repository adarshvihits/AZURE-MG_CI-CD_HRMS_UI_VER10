@model Hrms.Lite.Shared.TDS.TDSVariationReport
<script src="~/scripts/TDS/TDSVariationReport.js"></script>

<style>

    .drop-downs-boxx {
        width: 100%;
        padding:20px;
        background-color: #b2b3b5;
        box-shadow: rgba(99, 94, 102, 0.2) 0px -1px 15px 0px;
        border-radius: 10px;
    }


    .center-align-dropdownzz {
       
        background-color: white;
        padding: 40px 0px 50px;
        border-radius: 10px;
    }
   

    .btn-multi-selection {
      
        height: 32px !important;
        border: 1px solid #cdc8c8 !important;
    }
</style>









<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body d-flex  justify-content-center align-items-center " >

                            <div class="row justify-content-center w-100">

                                <div class="col-md-5">

                                    <div class="drop-downs-boxx">

                                        <div class="center-align-dropdownzz ">

                                            <div class="row justify-content-center">
                                                <div class="col-md-8">
                                                    <div class="form-group">
                                                        <label>Assessment Year</label>
                                                        @Html.DropDownListFor(model => model.AssessmentYear, (SelectList)ViewBag.AssessmentYear, new { @class = "form-control form-control-sm", @onchange = "onAssessmentYearChange(this,'Assessmnt_year')" })
                                                        <span id="Assessmnt_year"></span>
                                                    </div>
                                                </div>
                                            </div>



                                            <div class="row justify-content-center">
                                                <div class="col-md-8">
                                                    <div class="form-group">
                                                        <label>Location</label>
                                                        @Html.DropDownListFor(Model => Model.Location, (SelectList)ViewBag.Loc, "ALL", new { @class = "form-control form-control-sm month", @onblur = "validate(this,'month')" })
                                                        <span id="location"></span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row justify-content-center">
                                                <div class="col-md-8">
                                                    <div class="form-group">
                                                        <label>Department</label>
                                                        @Html.DropDownListFor(Model => Model.Department, (SelectList)ViewBag.Dept, "ALL", new { @class = "form-control form-control-sm month", @onblur = "validate(this,'month')" })
                                                        <span id="department"></span>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="row justify-content-center">
                                                <div class="col-md-8">
                                                    <div class="form-group">
                                                        <label>Fun.Designation</label>
                                                        @Html.DropDownListFor(Model => Model.Designation, (SelectList)ViewBag.Dsg, "ALL", new { @class = "form-control form-control-sm month", @onblur = "validate(this,'month')" })
                                                        <span id="dsg"></span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row justify-content-center">
                                                <div class="col-md-8">
                                                    <div class="form-group">
                                                        <label>Category</label>
                                                        @Html.DropDownListFor(Model => Model.Category, (SelectList)ViewBag.Cat, "ALL", new { @class = "form-control form-control-sm month", @onblur = "validate(this,'month')" })
                                                        <span id="category"></span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row  justify-content-center ">
                                                <div class="col-md-8">
                                                    <div class="form-group w-100">
                                                        <label>Designation </label>
                                                        @Html.DropDownListFor(Model => Model.Grade, (SelectList)ViewBag.Grd, "ALL", new { @class = "form-control form-control-sm month", @onblur = "validate(this,'PayrollGp')" })
                                                        <span id="PayrollGp"></span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row  justify-content-center ">
                                                <div class="col-md-8">
                                                    <div class="form-group w-100">
                                                        <label>Payroll Group </label>
                                                        @Html.DropDownListFor(Model => Model.PayrollGroup, (SelectList)ViewBag.PayrollGroup, "ALL", new { @class = "form-control form-control-sm month", @onblur = "validate(this,'PayrollGp')" })
                                                        <span id="PayrollGp"></span>
                                                    </div>
                                                </div>
                                            </div>



                                            <div class="row  justify-content-center ">
                                                <div class="col-md-2  align-items-center d-flex justify-content-center">
                                                    <a href="#" type="button"
                                                       class="btn btn-default float-right mobile-full-width mt-5" onclick="Proceed()">
                                                        Proceed
                                                    </a>
                                                </div>
                                            </div>

                                        </div>








                                        </div>




                                    </div>



                            </div>









                            <!-- <end table></end> -->

                        </div>

                    </div>
                </div>
            </div>




            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>