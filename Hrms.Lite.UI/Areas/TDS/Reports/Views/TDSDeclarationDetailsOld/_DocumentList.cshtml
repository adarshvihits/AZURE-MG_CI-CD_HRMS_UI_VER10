@model Hrms.Lite.Shared.TDS.InvestmentDeclaration
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Upload-Documents-popiup-list vertical-scroll-200">

    <table class="" id="tblDocument">
        <thead>
            <tr class="table-light">
                <th scope="col">Sl.No.</th>
                <th scope="col">Document Name</th>
                <th scope="col">Date</th>
                <th scope="col">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.DocumentList != null && Model.DocumentList.Count > 0)
            {

                for (int i = 0; i < Model.DocumentList.Count; i++)
                {
                    <tr>

                        <td data-label="slno">


                            @(i+1)
                        </td>

                        <td data-label="Name">
                            @Html.TextBoxFor(m => m.DocumentList[i].Attachment.FileName, new { @class = "form-control", @readonly = "true" })

                        </td>

                        <td data-label="CreatedON">
                            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.DocumentList[i].CreatedOn))
                        </td>
                        <td data-label="Edit">
                            <div class="small-btn-group">

                                <a id="addEducationDetails" type="button"
                                   class="btn btn-icon btn-secondar" data-bs-toggle="tooltip" data-placement="top" title="View" onclick="ViewDocument(@Model.DocumentList[i].TrnCode)">
                                    <i class="icon-xl far fa-eye black"></i>
                                </a>

                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" align="center"><em>No table data</em></td>
                </tr>
            }




        </tbody>
    </table>
</div>