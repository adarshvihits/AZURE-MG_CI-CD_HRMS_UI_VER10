@model System.Data.DataSet

<script>

    $(document).ready(function () {
        $(".search-slider-inner").click(function () {
            $(".form-control").toggleClass('field-width-big')
        });
        $.fn.DataTable.ext.pager.numbers_length = 5;

        var dataTable = $('.tdsdeclaration-table').DataTable({

            "paging": true,

            "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "All"]],
            "pagingType": 'full_numbers',
            //"pagingType": 'full_numbers_no_ellipses',
            "scrollY": '60vh',
            "sScrollX": "100%",
            "sScrollXInner": "100%",

            "ordering": false,
            "autoWidth": false,





            "scrollCollapse": false,

            // "dom": '<"top" if>rt<"bottom" lp>',
            "dom": '<t><"my-wrapper"<"my-inner2"l><"my-inner1"i><"my-inner3"p>>',


            language: {

                emptyTable: '<div style="text-align: center;display: flex;align-items: center;justify-content: center;height: 60vh;"><img src="/images/nodata.png" /></div >',

                zeroRecords: '<div style="text-align: center;display: flex;align-items: center;justify-content: center;height: 60vh;"><img src="/images/nodata.png" /></div >',

                sLengthMenu: "_MENU_",
                paginate: {
                    //next: '&#8594;', // or '→'
                    //previous: '&#8592;' // or '←'

                    next: '<img src="/images/icons/Icon awesome-arrow-right-1.png">',
                    previous: '<img src="/images/icons/Icon awesome-arrow-right.png">',
                    first: '<img src="/images/icons/Icon metro-next-1.png">',
                    last: '<img src="/images/icons/Icon metro-next.png">'

                    //next: '<span class="glyphicon glyphicon-menu-right"></span>',
                    //previous: '<span class="glyphicon glyphicon-menu-left"></span>'

                }
            }



        });


        //  $(".intro, .demo, .end").css('background', 'green');



        $('.ihits-table table').removeClass("dataTable no-footer");


        $('.paginate_button.next').attr("data-bs-toggle", "tooltip");
        $('.paginate_button.next').attr("title", "Next");
        $('.paginate_button.previous').attr("data-bs-toggle", "tooltip");
        $('.paginate_button.previous').attr("title", "Previous");
        $('.paginate_button.first').attr("data-bs-toggle", "tooltip");
        $('.paginate_button.first').attr("title", "First");
        $('.paginate_button.last').attr("data-bs-toggle", "tooltip");
        $('.paginate_button.last').attr("title", "Last");

        $(".ihits-table table tr th").removeAttr('style');


        $("#dataTableSearch").on("keyup search input paste cut", function () {
            dataTable.search(this.value).draw();




        });

        $('.search-slider-inner').click(function () {
            //dataTable.search('').draw();
            $('#dataTableSearch').val('');
            $('#dataTableSearch').focus();
        });
        debugger;
        var info = dataTable.page.info();

        dataTable.on('draw', function () {



            $('.paginate_button.next').attr("data-bs-toggle", "tooltip");
            $('.paginate_button.next').attr("title", "Next");
            $('.paginate_button.previous').attr("data-bs-toggle", "tooltip");
            $('.paginate_button.previous').attr("title", "Previous");
            $('.paginate_button.first').attr("data-bs-toggle", "tooltip");
            $('.paginate_button.first').attr("title", "First");
            $('.paginate_button.last').attr("data-bs-toggle", "tooltip");
            $('.paginate_button.last').attr("title", "Last");

        });

        /*}, 100);*/




    });




</script>

<div class="row tab-style-button">
    <div class="tab-button-wrap align-items-center">



     

        <div class="form-group filter-combobox mr-10 highs mb-0 mt-2">

        </div>


        <div class="tab-items select-option lows">


            <div class="sraech-slider">
                <div class="search-slider-inner">
                    <i class="fa fa-search"></i>
                </div>
                <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                       placeholder="ID/Name">
            </div>
       





        </div>


    </div>
</div>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table mt-5">

    <table id="DeclarationReportTable" class="tdsdeclaration-table">
        <thead>
            <tr class="table-dark">
                @foreach (System.Data.DataColumn col in Model.Tables[0].Columns)
                {





                <th>
                    @{
                        string colname = col.ColumnName?.First().ToString().ToUpper() + col.ColumnName?.Substring(1);
                        string[] abc = colname.Split('_');
                        if(abc.Length>1)
                            colname = abc[0] +" " +abc[1];
                    } 
                    @*@col.ColumnName.ToUpper()*@                    
                    @colname
                </th>



                }
            </tr>
        </thead>
        <tbody>
            @foreach (System.Data.DataRow row in Model.Tables[0].Rows)
            {

                <tr>
                    @foreach (var item in row.ItemArray)
                    {


                        <td>@item.ToString()</td>

                    }
                </tr>
            }
        </tbody>
    </table>





</div>

