@model Hrms.Lite.Shared.TDS.TDSDeclarationReport

<script>
    debugger;
    $(document).ready(function () {

        getReport();

    });
</script>
<style>
    .dataTables_scrollBody {
        height: 42vh !important;
    }
</style>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table assessment-master-pending-list">
    <table class="common-table">
        <thead>
            <tr class="table-dark">
               
                            <th scope="col">TDS Declaration</th>
                            <th scope="col">Total Employees</th>

                        </tr>
                    </thead>
        <tbody>
            @{
                if (Model.TDSDeclarationDetails != null && Model.TDSDeclarationDetails.Count > 0)
                {
                    for (int i = 0; i < Model.TDSDeclarationDetails.Count; i++)

                    {

                        <tr>
                           
                                        <td data-label="Assessment Year">
                                            @Model.TDSDeclarationDetails[i].Declaration
                                        
                                        </td>
                            <td data-label="TotalEmployees"><a onclick="ShowPopup(@Model.TDSDeclarationDetails[i].CategoryCode)">@Model.TDSDeclarationDetails[i].TotalEmployees</a></td>

                        </tr>
                    }
                }
            }
        </tbody>
                </table>
</div>

<div class="modal fade bd-example-modal-lg" tabindex="-1"
     role="dialog" aria-labelledby="myLargeModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg" style="max-width:1300px;">
        <div id="myDiv" class="modal-content popup" style=" margin: 7% auto;">
            <div class="modal-header" >
                <h5 class="modal-title" id="exampleModalLabel">
                    TDS Declaration Details<span id="empDetails"></span>
                </h5>
                <button type="button" class="close"
                        data-bs-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true"
                       class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body" style=" ">

            </div>



        </div>
    </div>
</div>

