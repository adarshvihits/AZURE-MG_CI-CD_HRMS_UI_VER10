                                                            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Convert.ToDateTime(Model.Details.CreatedOn)))
                                                        }

                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label class="view-title">Entry Comments</label>
                                                    <div class="view-details">
                                                        @Model.Details.Remarks
                                                    </div>
                                                    <!-- <textarea class="form-control form-control-sm"
                                                    placeholder="Remarks"></textarea> -->
                                                </div>
                                            </div>
                                            @*<div class="col-md-3">
                                                    <div class="form-group">
                                                        <label class="view-title">Verification Comments</label>
                                                        <div class="view-details">Demo</div>
                                                    </div>
                                                </div>*@

                                        </div>

                                    </div>
                                    <hr>
                                    <div class="ptag">
                                        <div class="">
                                            <h4>Full & Final Settlement Verification Done By</h4>
                                        </div>
                                        <div class="row">


                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label class="view-title">User</label>
                                                    <div class="view-details">
                                                        @Model.Details.VarifieddBy
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label class="view-title">Date & Time</label>
                                                    <div class="view-details">
                                                        @if (Model.Details.VarifiedOn != "")
                                                        {
                                                            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Convert.ToDateTime(Model.Details.VarifiedOn)))
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label class="view-title">Verification Comments</label>
                                                    <div class="view-details">
                                                        @Model.Details.VarificationComments
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="row my-3">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                              
                                                    <label>Approver Comments<span class="Mandatory">*</span></label>
                                                    @Html.TextAreaFor(m => m.Details.ApproverComments, new { @class = "form-control form-control-sm", @placeholder = "Description", @maxlength = "120", @onblur = "validate(this,'comments')" })

                                                </div>
                                                <span id="comments"></span>

                                            </div>

                                        </div>

                                    </div>
                                    <!-- <footer></footer> -->
                                    <div class="row card-footer-bottom-fixed">

                                        <div class="col-md-12 align-right">
                                            <a type="button" class="btn btn-default  mobile-full-width" onclick="confirmApproval()">
                                                Approve
                                            </a>
                                        </div>

                                    </div>
                                </div>

                            </div>


                        </div>
                    </div>
                </div>
            </div>
        </div>




        <!--end::Row-->
        <!--begin::Row-->
        <!--end::Row-->
        <!--end::Dashboard-->
    </div>
    <!--end::Container-->
}