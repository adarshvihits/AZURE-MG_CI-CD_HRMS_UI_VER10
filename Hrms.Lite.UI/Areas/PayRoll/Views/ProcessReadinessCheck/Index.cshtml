@model Hrms.Lite.Shared.PayRoll.ProcessReadinessCheck

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>
<script src="~/scripts/Payroll/ProcessReadinessCheck.js"></script>


@*<script>
        if (currentTab == 'Holiday') $(".batch_hidebutton").removeClass('hide');
        else $(".batch_hidebutton").addClass('hide');
        prevTab = tabName;

    </Script>*@

<script>
    var searchClick = 0;
    $(document).ready(function () {
        //$(".tab1").addClass('active');
        //$(".tab2").removeClass('active');
        //$(".class_attn_dropdowns").show();
        //$(".class_sal_dropdowns").hide();
        getList()
    });



</script>


<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Process Readiness Check
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Process Readiness Check
                    </li>

                </ul>
            </div>
        </div>
        <div class="topbar">


            <!--end::User-->
        </div>
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <!--begin: Search Form-->


                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">

                            <div class="tab-items ">
                                <div class="form-group mr-6 class_sal_dropdowns">
                                    @Html.DropDownListFor(m => m.PayrollGroup.Code, (SelectList)ViewBag.PayrollGroup, new { @class = "form-control form-control-sm", @onchange = "getList()" })
                                </div>
                                <span id="SalPayrollGroup"></span>
                            </div>


                            <div class="tab-items ">

                                <div class="form-group mr-6 class_sal_dropdowns">

                                    @Html.DropDownListFor(m => m.Month.Code, (SelectList)ViewBag.Month, new { @class = "form-control form-control-sm", @onchange = "getList()" })
                                </div>
                                <span id="SalPayroll"></span>
                            </div>

                                <div class="tab-items select-option">






                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search" onclick="$('#searchList').focus();"></i>
                                        </div>
                                        <input id="searchList" type="text" class="form-control form-control-sm"
                                               placeholder="Search Here" onkeyup="searchRows()">
                                    </div>



                                    <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left class_sal_dropdowns" data-bs-original-title="Export to Excel">
                                        <i class="icon-xl far fa-file-excel" onclick="PRcheckListExportToExcel()"></i>
                                    </a>
                                </div>

                            </div>
                        </div>
                    <div id="listID">
                        @await Html.PartialAsync("_List", Model)
                    </div>
                </div>



            </div>
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>

<div class="modal fade readinessEmpList" tabindex="-1" role="dialog"
     aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" style="max-width:940px ;">
        <div class="modal-content popup">
            <div class="modal-header" style="padding:10px">
                <h5 class="modal-title" id="exampleModalLabel">
                </h5>
                <button type="button" class="close mt-2" data-bs-dismiss="modal"
                        aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">

            </div>


        </div>
    </div>
</div>

<div class="modal fade bd-example-modal-lg2" tabindex="-1" aria-labelledby="myLargeModalLabel" aria-hidden="true" style="display: none;">
    <div class="modal-dialog" style="max-width:450px;">
        <div class="modal-content popup " style="height:350px ;">
            <div class="modal-header" style="padding:10px">
                <h5 class="modal-title" id="exampleModalLabelemp">
                </h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close" >
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">
            </div>




        </div>
    </div>
</div>
