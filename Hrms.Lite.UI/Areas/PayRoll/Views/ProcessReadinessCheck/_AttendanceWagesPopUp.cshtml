

@model Hrms.Lite.Shared.PayRoll.ProcessReadinessCheck
<script src="~/js/settings.js"></script>


<script>

    $(".search-slider-inner11").click(function () {
        $("#dataTableSearch").toggleClass('field-width-big')
    });

</script>
<style>
    .dataTables_scrollBody {
        height: 30vh !important;
    }

    .searchicons {
        z-index: 3;
        position: relative;
        padding-top: 6px;
    }
</style>

<div class="row tab-style-button">
    <div class="tab-button-wrap align-items-center">





        <div class="tab-items">

        </div>



        <div class="tab-items select-option high">
            <div class="sraech-slider">
                <div class="search-slider-inner11">
                    <i class="fa fa-search searchicons "></i>
                </div>
                <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                       placeholder="ID/Name">
            </div>

            @*<div class="sraech-slider">



            <div class="search-slider-inner">
                <i class="fa fa-search" onclick="$('#searchList').focus();"></i>
            </div>
            <input id="searchList" type="text" class="form-control form-control-sm"
                   placeholder="ID/Name" onkeyup="EmployeeSearch('WagesPopUpTable')">
        </div>*@


            <button data-bs-toggle="tooltip" title=""
                    class="btn btn-excel"
                                        data-bs-original-title="Export to Excel" onclick="AttendanceExportToExcelPopUp('ATTENDANCE_WAGE','@ViewBag.RowName',4)">                 
                <i class="icon-xl far fa-file-excel"></i>
            </button>

        </div>


    </div>
</div>




<div style="padding:10px;" class="ihits-table table-border hover-color odd-even mobile-responsive-table">
    @Html.HiddenFor(m => m.MonthlyAttendanceProcessing.MonthlyAttendanceProcessing_Validations_popup.Count)

    <table id="WagesPopUpTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>





            </tr>
        </thead>
        <tbody>
            @if (Model.MonthlyAttendanceProcessing.MonthlyAttendanceProcessing_Validations_popup != null && Model.MonthlyAttendanceProcessing.MonthlyAttendanceProcessing_Validations_popup.Count > 0)
            {
                for (int i = 0; i < Model.MonthlyAttendanceProcessing.MonthlyAttendanceProcessing_Validations_popup.Count; i++)
                {
                    <tr>
                        <td data-label="ID">
                            @Model.MonthlyAttendanceProcessing.MonthlyAttendanceProcessing_Validations_popup[i].EmployeeID
                        </td>
                        <td data-label="Employee Name">
                            @Model.MonthlyAttendanceProcessing.MonthlyAttendanceProcessing_Validations_popup[i].FullName

                        </td>
                        <td data-label="Designation">@Model.MonthlyAttendanceProcessing.MonthlyAttendanceProcessing_Validations_popup[i].Designation</td>
                        <td data-label="Department">
                            @Model.MonthlyAttendanceProcessing.MonthlyAttendanceProcessing_Validations_popup[i].Department
                        </td>
                        <td data-label="Location">@Model.MonthlyAttendanceProcessing.MonthlyAttendanceProcessing_Validations_popup[i].Location</td>



                    </tr>


                }
            }

        </tbody>


    </table>
</div>
