@model Hrms.Lite.Shared.PayRoll.ProcessReadinessCheck




<div class="ihits-table table-border odd-even mobile-responsive-table process-readiness_check-list vertical-scroll-350">
    @Html.HiddenFor(m => m.ProcessReadinessCheckList.Count)
    <table id="ProcessReadinessCheck_Table" >
        <thead>
            <tr class="table-dark">
                <th scope="col">Sl.No.</th>
                <th scope="col">Check Item</th>
                <th scope="col">Count</th>
                <th scope="col">Type</th>
                <th scope="col">Impact</th>

            </tr>
        </thead>
        <tbody>

            @if (Model != null && Model.ProcessReadinessCheckList != null && Model.ProcessReadinessCheckList.Count > 0)
            {

                for (int i = 0; i < Model.ProcessReadinessCheckList.Count; i++)
                {

            <tr>
                <td data-label="SlNo">@(i+1)</td>
                <td data-label="CheckItem">@Model.ProcessReadinessCheckList[i].Description</td>


                <td data-label="Count">


                    <a onclick="getPopUpDetails('@Model.ProcessReadinessCheckList[i].Description','@Model.ProcessReadinessCheckList[i].ProcessType','@Model.ProcessReadinessCheckList[i].AttType','@Model.ProcessReadinessCheckList[i].Type')">@Model.ProcessReadinessCheckList[i].Count</a>

                </td>

                <td data-label="type">@Model.ProcessReadinessCheckList[i].ProcessType</td>

                <td data-label="type">@Model.ProcessReadinessCheckList[i].Impact</td>
            </tr>
                }
            }
        </tbody>
    </table>
</div>
