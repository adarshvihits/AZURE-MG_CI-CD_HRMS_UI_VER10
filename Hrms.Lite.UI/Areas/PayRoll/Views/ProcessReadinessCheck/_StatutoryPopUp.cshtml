            $("#dataTableSearch").toggleClass('field-width-big')
        });

        function ExportToExcelSalaryPopUp1(TabIndex,RawDescription) {
            alert(TabIndex);
        }

    </script>
    <style>

        .dataTables_scrollBody {
            height: 30vh !important;
        }
        .searchicons {
            z-index: 3;
            position: relative;
            padding-top: 6px;
        }
    </style>
    <div class="row tab-style-button">
        <div class="tab-button-wrap align-items-center">
            <div class="tab-items">

            </div>
            <div class="tab-items select-option high">

                @*<div class="sraech-slider">



            <div class="search-slider-inner">
                <i class="fa fa-search" onclick="$('#searchList').focus();"></i>
            </div>
            <input id="searchList" type="text" class="form-control form-control-sm"
                   placeholder="ID/Name" onkeyup="EmployeeSearch('StatutoryTable')">
        </div>*@

                <div class="sraech-slider">
                    <div class="search-slider-inner11">
                        <i class="fa fa-search searchicons "></i>
                    </div>
                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                           placeholder="ID/Name">
                </div>

                <a data-bs-toggle="tooltip" title=""
                   class="btn btn-excel"
                   data-bs-original-title="Export to Excel" onclick="ExportToExcelSalaryPopUp('@ViewBag.SalaryType','@ViewBag.RowName','ProcessReadinessCheck_Popup_Count');">
                    <i class="icon-xl far fa-file-excel"></i>
                </a>

            </div>


        </div>
    </div>




    <div style="padding:10px;" class="ihits-table table-border hover-color odd-even mobile-responsive-table  ">
        @Html.HiddenFor(Model => Model.ProcessReadinessCheck_Popup.Count)
        <table id="StatutoryTable" class="common-table">
            <thead>
                <tr class="table-dark">
                    <th scope="col">ID</th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">Designation</th>
                    <th scope="col">Department</th>
                    <th scope="col">Location</th>



                    @if (@ViewBag.RowName == "Payment Mode Bank But Account Details Missing")
                    {
                        <th scope="col" tooltip="">Bank</th>
                        <th scope="col" tooltip="">Account No.</th>
                        <th scope="col" tooltip="">IFSC</th>


                    }
                    else if (@ViewBag.RowName == "Account Number Variation With Previous Month")
                    {
                        <th scope="col" tooltip="">Previous</th>
                        <th scope="col" tooltip="">Current</th>

                    }
                    else if (@ViewBag.RowName == "Payroll Group Varience")
                    {
                        <th scope="col" tooltip="">Previous</th>
                        <th scope="col" tooltip="">Current</th>

                    }
                    else if (@ViewBag.RowName == "Bank Account Number Duplication")
                    {
                        <th scope="col" tooltip="">Bank</th>
                        <th scope="col" tooltip="">Account No.</th>
                    }



                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.ProcessReadinessCheck_Popup != null && Model.ProcessReadinessCheck_Popup.Count > 0)
                {
                    for (int i = 0; i < Model.ProcessReadinessCheck_Popup.Count; i++)
                    {
                <tr>
                    <td data-label="ID">
                        @Model.ProcessReadinessCheck_Popup[i].ID
                    </td>
                    <td data-label="Employee Name">
                        @Model.ProcessReadinessCheck_Popup[i].Name

                    </td>
                    <td data-label="Designation">@Model.ProcessReadinessCheck_Popup[i].Designation</td>
                    <td data-label="Department">
                        @Model.ProcessReadinessCheck_Popup[i].Department
                    </td>
                    <td data-label="Location">@Model.ProcessReadinessCheck_Popup[i].Location</td>



                    @if (@ViewBag.RowName == "Payment Mode Bank But Account Details Missing")
                    {
                        <td data-label="Bank">@Model.ProcessReadinessCheck_Popup[i].Bank</td>
                        <td data-label="Account number">@Model.ProcessReadinessCheck_Popup[i].AccNo</td>
                        <td data-label="ifsc code">@Model.ProcessReadinessCheck_Popup[i].IFSC</td>

                    }
                    else if (@ViewBag.RowName == "Account Number Variation With Previous Month")
                    {
                        <td data-label="Previous">@Model.ProcessReadinessCheck_Popup[i].PrevAccNo</td>
                        <td data-label="Current">@Model.ProcessReadinessCheck_Popup[i].CurrAccNo</td>
                    }
                    else if (@ViewBag.RowName == "Payroll Group Varience")
                    {
                        <td data-label="Previous">@Model.ProcessReadinessCheck_Popup[i].PrevPayrollGroup</td>
                        <td data-label="Current">@Model.ProcessReadinessCheck_Popup[i].CurrPayrollGroup</td>
                    }
                    else if (@ViewBag.RowName == "Bank Account Number Duplication")
                    {
                        <td data-label="Bank">@Model.ProcessReadinessCheck_Popup[i].Bank</td>
                        <td data-label="Account number">@Model.ProcessReadinessCheck_Popup[i].AccNo</td>
                           
                        }

                </tr>


                            }
                }
            </tbody>

        </table>
    </div>
