<div class="ihits-table table-border hover-color odd-even mobile-responsive-table unauthorised-nub-od-days-list  vertical-scroll-200">
    @Html.HiddenFor(m => m.MonthlyAttendanceProcessing.MonthlyAttendanceProcessing_Validations_popup.Count)

    <table id="Days_POPUP_AttnStatus">
        <thead>
            <tr class="table-dark">

                <th scope="col">Sl.No </th>
                <th scope="col">Date</th>

            </tr>
        </thead>
        <tbody>

            @{ var slno = 0;


            }

            @if (Model.MonthlyAttendanceProcessing.MonthlyAttendanceProcessing_Validations_popup != null && Model.MonthlyAttendanceProcessing.MonthlyAttendanceProcessing_Validations_popup.Count > 0)
            {

                for (int i = 0; i < Model.MonthlyAttendanceProcessing.MonthlyAttendanceProcessing_Validations_popup.Count; i++)
                {




                    slno++;

                    <tr>
                        @Html.HiddenFor(m => m.MonthlyAttendanceProcessing.MonthlyAttendanceProcessing_Validations_popup[0].FullName)
                        @Html.HiddenFor(m => m.MonthlyAttendanceProcessing.MonthlyAttendanceProcessing_Validations_popup[0].EmployeeID)
                        <td data-label="slno">@slno</td>

                        <td data-label="date">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.MonthlyAttendanceProcessing.MonthlyAttendanceProcessing_Validations_popup[i].Dates))</td>





                    </tr>


                }
            }

        </tbody>
    </table>
</div>
