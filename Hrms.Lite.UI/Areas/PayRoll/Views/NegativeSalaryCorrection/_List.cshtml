@model Hrms.Lite.Shared.PayRoll.NegativeSalary
    <script src="~/js/settings.js"></script>
    <script src="~/js/tooltip.js"></script>
    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table Negative_Salary_Correction">
        @Html.HiddenFor(Model => Model.NegativeSalaryList.Count)
        <table id="NegativeSalaryCorrectionTable" class="common-table">
            <thead>
                <tr class="table-dark">

                    <th scope="col">ID </th>
                    <th scope="col">Employee Name </th>
                    <th scope="col">Designation</th>
                    <th scope="col">Department</th>
                    <th scope="col">Location</th>
                    <th scope="col" data-bs-toggle="tooltip" title="Gross Allowance">Gross Allw.</th>
                    <th scope="col" data-bs-toggle="tooltip" title="Gross Deduction">Gross Ded.</th>
                    <th scope="col">Advance</th>
                    <th scope="col">Net Pay</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.NegativeSalaryList != null && Model.NegativeSalaryList.Count > 0)
                {
                    for (int i = 0; i < Model.NegativeSalaryList.Count; i++)
                    {
                        <tr>
                            <td>@Model.NegativeSalaryList[i].EmployeeID</td>
                            <td>@Model.NegativeSalaryList[i].EmployeeName</td>
                            <td>@Model.NegativeSalaryList[i].Designation.Name</td>
                            <td>@Model.NegativeSalaryList[i].Department.Name</td>
                            <td>@Model.NegativeSalaryList[i].Location.Name</td>
                            <td>@Model.NegativeSalaryList[i].GrossAlw</td>
                            <td>@Model.NegativeSalaryList[i].GrossDed</td>
                            <td>@Model.NegativeSalaryList[i].Advance</td>
                            <td>@Model.NegativeSalaryList[i].Netsalary</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>






