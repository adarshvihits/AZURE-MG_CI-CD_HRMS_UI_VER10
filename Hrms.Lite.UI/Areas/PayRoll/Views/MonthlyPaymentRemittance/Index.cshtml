@model Hrms.Lite.Shared.PayRoll.MonthlyPaymentRemittance
@{ 
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/PayRoll/MonthlyPaymentRemittance.js"></script>
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Monthly Payment Remittance
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Monthly Payment Remittance
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <div class="row height-100per">
                <div class="col-md-12">
                    <div class="card card-custom height-100per">
                        <div class="card-body ">
                           
                            <div class="row tab-style-button">
                                <div class="tab-button-wrap">
                                    <div class="tab-items">
                                        <span class="btn-title active PF pr-7" onclick="OnTabClick('PF','PF')">
                                            PF
                                        </span>
                                    </div>
                                    <div class="tab-items medium">
                                        <span class="btn-title ESI pr-7" onclick="OnTabClick('ESI','ESI')">
                                            ESI
                                        </span>
                                    </div>
                                    <div class="tab-items medium">
                                        <span class="btn-title ESI pr-7" onclick="OnTabClick('TDS','TDS')">
                                            TDS
                                        </span>
                                    </div>
                                    <div class="tab-items low">
                                        <span class="btn-title LWF pr-7" onclick="OnTabClick('LWF','LWF')">
                                            LWF
                                        </span>
                                    </div>
                                    <div class="tab-items low">
                                        <span class="btn-title PT pr-7" onclick="OnTabClick('PT','PT')">
                                            PT
                                        </span>
                                    </div>
                                    <div class="tab-items low">
                                        <span class="btn-title PT pr-7" onclick="OnTabClick('ER','ER')">
                                            Employee Remittance
                                        </span>
                                    </div>
                                    <div class="tab-items select-option">
                                        @*<div class="sraech-slider">
                                            <div class="search-slider-inner">
                                                <i class="fa fa-search"></i>
                                            </div>
                                            <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                                   placeholder="ID/Name">
                                        </div>*@
                                        <a data-bs-toggle="tooltip" title="Export to Excel"
                                           class="btn btn-excel" onclick="clickOnExportToExcel()">
                                            <i class="icon-xl far fa-file-excel"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <div id="pfList">
                                @await Html.PartialAsync("_PFList", Model)
                            </div>
                            <div class="row card-footer-bottom-fixed justify-content-end">
                                <button id="addnew" type="button"
                                        class="btn btn-default float-right mobile-full-width " onclick="AddNewOrEditClick()">
                                    Add New
                                </button>
                            </div>
                        </div>
                        <div id="AddNewOrEditSlider">

                        </div>
                    </div>
                </div>
            </div>
            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>