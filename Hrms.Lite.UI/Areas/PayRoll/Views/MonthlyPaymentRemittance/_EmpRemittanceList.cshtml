@model Hrms.Lite.Shared.PayRoll.MonthlyPaymentRemittance
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table monthly-pay-remittancelist">
    @Html.HiddenFor(m => m.PFdetailsList.Count)

    <table id="monthlypayremittance">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Payment Type</th>
                <th scope="col">Paid Date</th>
                <th scope="col">Amount Paid</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.PFdetailsList != null && Model.PFdetailsList.Count > 0)
                {
                    for (int i = 0; i < Model.PFdetailsList.Count; i++)
                    {
                        <tr>
                            <td data-label="EmpCode">@Model.PFdetailsList[i].EmployeeID</td>
                            <td data-label="Name">@Model.PFdetailsList[i].EmpName</td>
                            <td data-label="PaymentType">@Model.PFdetailsList[i].Code</td>
                            <td data-label="PaidDate">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.PFdetailsList[i].Date))</td>
                            <td data-label="AmountPaid">@Model.PFdetailsList[i].TotalAmount</td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>