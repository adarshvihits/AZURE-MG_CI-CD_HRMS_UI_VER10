@model Hrms.Lite.Shared.PayRoll.MonthlyPaymentRemittance
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });
</script>
<script src="~/js/bootstrap-datepicker.js"></script>
<script src="~/js/tooltip.js"></script>

@using (Html.BeginForm("Save", "MonthlyPaymentRemittance", FormMethod.Post, new { id = "Pfsave" }))
{
    <div id="pfedit" class="slider-forms slider-forms-open AddnewOrEditDiv">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddnewOrEditDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>PF Remittance</h4>
            </div>
            <div class="add-padding">
                <div class="row">

                    <div class="col-md-6">
                        <label>Month</label>
                        <div class="form-group filter-combobox mr-2">
                            @Html.DropDownListFor(m => m.Month.Code, (SelectList)ViewBag.Month, "--Select Month--", new { @class = "form-control form-control-sm month" })
                            <span id="month"></span>
                        </div>
                        <span id="Month"></span>
                    </div>
                    <div class="col-md-4 form-group">
                        <label>From</label>
                        <span class="Mandatory">*</span>
                        <div class="input-group date">

                            @Html.TextBoxFor(m => m.Date, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "readonly", @placeholder = "Date", @onchange = "$('#To').val($('#From').val());validate(this,'fromDate');CalculateDays();" @*"setToDate()"*@})

                            <div class="input-group-append">
                                <span class="input-group-text">
                                    <i class="la la-calendar"></i>
                                </span>

                            </div>

                        </div>
                        <span id="fromDate"></span>
                    </div>
                </div>

                <div class="row ">
                    <div class="col-md-6">
                        <label>Voucher Number</label>
                        <div class="view-details">
                            @if (Model.Mode == "CREATE")
                            {
                                @Html.TextBoxFor(model => Model.VoucherNum, new { @class = "form-control form-control-sm DeptDiscription", @placeholder = "Voucher Number",  maxlength = "250"})
                            }
                            @if (Model.Mode == "MODIFY")
                            {
                                @Html.HiddenFor(model => Model.VoucherNum)

                                @Html.DisplayFor(model => Model.VoucherNum)

                            }

                        </div>
                    </div>
                    <div class="col-md-6">
                        <label>PF Employee</label>
                        <div class="view-details">
                            @if (Model.Mode == "CREATE")
                            {
                                @Html.TextBoxFor(model => Model.PFEmployee, new { @class = "form-control form-control-sm DeptDiscription",  maxlength = "250", type = "number" })
                            }
                            @if (Model.Mode == "MODIFY")
                            {
                                @Html.HiddenFor(model => Model.PFEmployee)

                                @Html.DisplayFor(model => Model.PFEmployee)

                            }

                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <label>VPF</label>
                        <div class="view-details">
                            @if (Model.Mode == "CREATE")
                            {
                                @Html.TextBoxFor(model => Model.VPF, new { @class = "form-control form-control-sm DeptDiscription",  maxlength = "250", type = "number" })
                            }
                            @if (Model.Mode == "MODIFY")
                            {
                                @Html.HiddenFor(model => Model.VPF)

                                @Html.DisplayFor(model => Model.VPF)

                            }
                        </div>
                    </div>
              
             
                    <div class="col-md-6">
                        <label>PF 3.67</label>
                        <div class="view-details">
                            @if (Model.Mode == "CREATE")
                            {
                                @Html.TextBoxFor(model => Model.PF, new { @class = "form-control form-control-sm DeptDiscription",  maxlength = "250", type = "number" })
                            }
                            @if (Model.Mode == "MODIFY")
                            {
                                @Html.HiddenFor(model => Model.PF)

                                @Html.DisplayFor(model => Model.PF)

                            }
                        </div>
                    </div>
                </div>
                <div class="row">

              
                <div class="col-md-6">
                    <label>PF EPS</label>
                    <div class="view-details">
                        @if (Model.Mode == "CREATE")
                        {
                            @Html.TextBoxFor(model => Model.PFEPS, new { @class = "form-control form-control-sm DeptDiscription", maxlength = "250", type = "number" })
                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            @Html.HiddenFor(model => Model.PFEPS)

                            @Html.DisplayFor(model => Model.PFEPS)

                        }
                    </div>
                </div>
                <div class="col-md-6">
                    <label>PF Admin Charge</label>
                    <div class="view-details">
                        @if (Model.Mode == "CREATE")
                        {
                            @Html.TextBoxFor(model => Model.PFadmin, new { @class = "form-control form-control-sm DeptDiscription",  maxlength = "250", type = "number" })
                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            @Html.HiddenFor(model => Model.PFadmin)

                            @Html.DisplayFor(model => Model.PFadmin)

                        }
                    </div>
                </div>
                    </div>
                <div class="row">


                    <div class="col-md-6">
                        <label>PF EDLI</label>
                        <div class="view-details">
                            @if (Model.Mode == "CREATE")
                            {
                                @Html.TextBoxFor(model => Model.PFEdli, new { @class = "form-control form-control-sm DeptDiscription",  maxlength = "250", type = "number" })
                            }
                            @if (Model.Mode == "MODIFY")
                            {
                                @Html.HiddenFor(model => Model.PFEdli)

                                @Html.DisplayFor(model => Model.PFEdli)

                            }
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label>Total Amount Paid</label>
                        <div class="view-details">
                            @if (Model.Mode == "CREATE")
                            {
                                @Html.TextBoxFor(model => Model.TotalAmount, new { @class = "form-control form-control-sm DeptDiscription", maxlength = "250", type = "number" })
                            }
                            @if (Model.Mode == "MODIFY")
                            {
                                @Html.HiddenFor(model => Model.TotalAmount)

                                @Html.DisplayFor(model => Model.TotalAmount)

                            }
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <label>Description</label>
                        <div class="view-details">
                            @if (Model.Mode == "CREATE")
                            {
                                @Html.TextAreaFor(model => Model.Remarks, new { @class = "form-control form-control-sm DeptDiscription", @placeholder = "Remarks", maxlength = "250" })
                            }
                            @if (Model.Mode == "MODIFY")
                            {
                                @Html.HiddenFor(model => Model.Remarks)

                                @Html.DisplayFor(model => Model.Remarks)

                            }

                        </div>
                    </div>
                </div>
                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12 align-right">
                        @if (Model.Mode == "CREATE")
                        {
                            @if (CurrentUserRoleActions.Create == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="pfSave('Save')">
                                    Save
                                </button>
                            }
                        }
                        @if (Model.Mode == "MODIFY")
                        {
                            @if (CurrentUserRoleActions.Modify == true)
                            {
                                <button type="button" class="btn btn-default  mobile-full-width" onclick="pfSave('Modify')">
                                    Modify
                                </button>
                            }
                        }
                    </div>
                </div>
            </div>

        </div>
    </div>

}
