@model Hrms.Lite.Shared.PayRoll.MonthlyPaymentRemittance
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table monthly-pay-remittancelist">
    @Html.HiddenFor(m => m.PFdetailsList.Count)

    <table id="monthlypayremittance">
        <thead>
            <tr class="table-dark">
                <th scope="col">Month</th>
                <th scope="col">Voucher No.</th>
                <th scope="col">Payment Date</th>
                <th scope="col">PT Amount Paid</th>
                @*<th scope="col">Amount Paid</th>*@
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.PFdetailsList != null && Model.PFdetailsList.Count > 0)
                {
                    for (int i = 0; i < Model.PFdetailsList.Count; i++)
                    {
                        <tr>
                            <td data-label="Month">@Model.PFdetailsList[i].Month.Name</td>
                            <td data-label="VoucherNum">@Model.PFdetailsList[i].VoucherNum</td>
                            <td data-label="PaymentDate">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.PFdetailsList[i].Date))</td>
                            <td data-label="PTAmountPaid">@Model.PFdetailsList[i].PTAmountPaid</td>
                            @*<td data-label="AmountPaid">@Model.PFdetailsList[i].TotalAmount</td>*@
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>