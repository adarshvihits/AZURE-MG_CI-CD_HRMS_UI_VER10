@model Hrms.Lite.Shared.PayRoll.CertificationReimbursement

<script src="~/js/tooltip.js"></script>

<div class="ihits-table table-border odd-even  mobile-responsive-table variable-allowance-list">
    @Html.HiddenFor(m => m.CertificationReimbursementList.Count)
    <table id="Certi_pendingTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Location</th>
                <th scope="col">Designation </th>
                <th scope="col">Exam</th>
                <th scope="col">Amount</th>
                <th scope="col">Action</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>

<div class="row card-footer-bottom-fixed border-none">

    <div class="col-md-12 align-right">

        <button type="button" onclick="SaveCertification()"
                class="btn btn-default mt-4 mobile-full-width ">
            Save
        </button>

    </div>

</div>
