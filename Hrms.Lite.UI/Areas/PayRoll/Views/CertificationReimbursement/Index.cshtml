@model Hrms.Lite.Shared.PayRoll.CertificationReimbursement
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/PayRoll/CertificationReimbursement.js"></script>

<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Certification Reimbursement</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Certification Reimbursement
                    </li>

                </ul>
            </div>
        </div>

        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                    <!--begin: Search Form-->

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap align-items-center">
                            <div class="tab-items">
                                <span class="btn-title PendingTab active" onclick="OnTabClick('PendingTab',0)">
                                    Pending
                                    <span class="btn-notification PendingTabCount">@Model.PendingCount</span>
                                </span>
                            </div>
                            <div class="tab-items medium">
                                <span class="btn-title ConfirmedTab" onclick="OnTabClick('ConfirmedTab',1)">
                                    Confirmed
                                    <span class="btn-notification ConfirmedTabCount">@Model.ConfirmedCount</span>
                                </span>
                            </div>




                            <div class="tab-items mt-2">
                                @*<label>Month</label>*@
                                <div class="form-group filter-combobox mt-0">

                                    @Html.DropDownListFor(m => m.Month.Code, (SelectList)ViewBag.month, "--select Month--", new { @class = "form-control form-control-sm", @onchange = "fillData()" })

                                </div>
                            </div>




                            <div class="tab-items select-option high">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>



                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <button data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                        data-bs-original-title="Export to Excel">
                                    <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                </button>


                            </div>


                        </div>
                    </div>
                    @using (Html.BeginForm("", "", FormMethod.Post, new { @class = "display-flex", enctype = "multipart/form-data", @id = "Certification_Entry" }))
                    {
                        <div id="Certifi_Pending_List">
                            @await Html.PartialAsync("~/Areas/PayRoll/Views/CertificationReimbursement/_CertificationReimbursementList.cshtml", Model)
                        </div>
                        <div id="Certifi_Confirm_List" class=" hide">
                            @await Html.PartialAsync("~/Areas/PayRoll/Views/CertificationReimbursement/_ConfirmList.cshtml", Model)
                        </div>
                    }
                    <!--end: Datatable-->
                    @*<div class="row card-footer-bottom-fixed border-none">

            <div class="col-md-12 align-right">

                <button type="button" onclick="SaveCertification()"
                        class="btn btn-default mt-4 mobile-full-width ">
                    Save
                </button>

            </div>

        </div>*@
                </div>
            </div>
            <div id="filterSlider">
                @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
            </div>

            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
<div class="slider-over-flow"></div>