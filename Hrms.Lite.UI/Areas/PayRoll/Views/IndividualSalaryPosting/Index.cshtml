@model Hrms.Lite.Shared.PayRoll.SalaryPosting

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/PayRoll/individualSalaryPosting.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        fillData();
    });
</script>
<style>
    .pdf-icon {
        width: 21px;
        height: 21px;
        fill: #7c8da7;
    }
</style>
<div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->


            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Individual Salary Posting</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            Individual Salary Posting
                        </li>
                    </ul>
                </div>
            </div>
            <!--begin::Topbar-->
            <div class="topbar">


            </div>
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body">
                        <!--begin: Search Form-->

                        <div class="row tab-style-button">
                            <div class="tab-button-wrap align-items-center">




                                <div class="tab-items">


                                </div>
                                <div class="tab-items">

                                    <div class="form-group filter-combobox mt-0">
                                        @Html.DropDownListFor(m => m.PayrollGroup.Code, (SelectList)ViewBag.Pgroup, "--Payroll Group--", new { @class = "form-control form-control-sm", @onchange = "onPayrollGrpChange()" })

                                    </div>
                                </div>
                                <div class="tab-items">

                                    <div class="form-group filter-combobox mt-0">

                                        @Html.DropDownListFor(m => m.PayrollMonth.Code, (SelectList)ViewBag.Month, "--Select Month--", new { @class = "form-control form-control-sm", @onchange = "fillData()" })

                                    </div>
                                </div>




                                <div class="tab-items select-option high">


                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>


                                    <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>

                                    <button data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                            data-bs-original-title="Export to Excel" onclick="ExportToExcel()">
                                        <i class="icon-xl far fa-file-excel"></i>
                                    </button>

                                </div>


                            </div>
                        </div>
                        <div id="SalaryReportDraftID">
                            @await Html.PartialAsync("~/Areas/PayRoll/Views/IndividualSalaryPosting/_List.cshtml", Model)
                        </div>

                        <div id="filterSlider">
                            @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
                        </div>
                        <div class="modal fade bd-example-modal-lg" tabindex="-1"
                             role="dialog" aria-labelledby="myLargeModalLabel"
                             aria-hidden="true">
                            <div class="modal-dialog modal-lg">
                                <div id="myDiv" class="modal-content popup">
                                    <div class="modal-header" style="padding:10px">
                                        <h5 class="modal-title" id="exampleModalLabel">
                                            <span id="empNm"> </span>
                                        </h5>
                                        <button type="button" class="close"
                                                data-bs-dismiss="modal" aria-label="Close">
                                            <i aria-hidden="true"
                                               class="ki ki-close"></i>
                                        </button>
                                    </div>

                                    <div class="modal-body" style=" padding: 10px 20px !important;">

                                    </div>



                                </div>
                            </div>
                        </div>
                        <!--end: Datatable-->
                        <div class="row card-footer-bottom-fixed border-none">

                            <div class="col-md-12 align-left">


                            </div>

                        </div>
                    </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>
    <div class="slider-over-flow"></div>
    <!--end::Content-->
    `
</div>