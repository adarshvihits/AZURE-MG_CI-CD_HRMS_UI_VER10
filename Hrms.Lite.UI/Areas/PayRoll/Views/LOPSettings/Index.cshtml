@model Hrms.Lite.Shared.PayRoll.LOPSettings
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/scripts/PayRoll/LOPSettings.js"></script>

<script src="~/js/jquery.min.js"></script>
<script src="~/js/tooltip.js"></script>

<script>
    //$(document).ready(function () {



    //    $('#allowancesettings').DataTable({
    //        "pageLength": 25,
    //        "language": {
    //            searchPlaceholder: "Search"
    //        }
    //    });


    //    $('.ihits-table table').removeClass("dataTable no-footer");
    //    $(".ihits-table table tr th").removeAttr('style');

    //    });
</script>

<style>
    .dataTables_filter label{
        display:none;
    }


    .dataTables_wrapper .dataTable th.sorting:before, .dataTables_wrapper .dataTable th.sorting:after, .dataTables_wrapper .dataTable td.sorting:before, .dataTables_wrapper .dataTable td.sorting:after {
        opacity: 0;
    }

    .dataTables_wrapper .dataTable th.sorting_asc, .dataTables_wrapper .dataTable td.sorting_asc {
        color: #ffffff !important;
    }

    .dataTables_length{
        display:none;
    }

</style>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->

        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">LOP Settings</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        LOP Settings
                    </li>
                </ul>
            </div>
        </div>

    </div>

</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <div class="ihits-table table-border hover-color LOP_Settings_list">
                    <table>
                        <thead>
                            <tr class="table-light">
                                <th scope="col"></th>
                                <th scope="col"></th>
                                <th scope="col">LOP</th>
                                <th scope="col"></th>
                                <th scope="col">ESI Leave</th>
                                <th scope="col"></th>
                                <th scope="col">Less Hours</th>
                                <th scope="col"></th>
                                <th scope="col">Suspension</th>
                                <th scope="col"></th>
                                <th scope="col">Lay Off</th>
                                <th scope="col"></th>


                                <th scope="col">Maternity Leave</th>

                            </tr>
                            
                        </thead>
                    </table>
                        </div>
                    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table LOP_Settings_list vertical-scroll-400">
                        <table id="allowancesettings" class="w-100  layout-fixed newlisted ">
                            <thead>

                                @*<tr class="table-light">
                        <th scope="col"></th>
                        <th class="text" scope="col" colspan="2">LOP</th>
                        <th scope="col" colspan="2">ESI Leave</th>
                        <th scope="col" colspan="2">Less Hours</th>

                        <th scope="col" colspan="2">Suspension</th>
                        <th scope="col" colspan="2">Lay Off</th>
                    </tr>*@
                                <tr class="table-dark">
                                    <th scope="col">Allowance</th>
                                    <th scope="col">Y|N</th>
                                    <th scope="col">App %</th>
                                    <th scope="col">Y|N</th>
                                    <th scope="col">App %</th>
                                    <th scope="col">Y|N</th>
                                    <th scope="col">App %</th>
                                    <th scope="col">Y|N</th>
                                    <th scope="col">App %</th>
                                    <th scope="col">Y|N</th>
                                    <th scope="col">App %</th>
                                    <th scope="col">Y|N</th>
                                    <th scope="col">App %</th>
                                </tr>

                            </thead>
                            <tbody>


                                @if (Model.LOPSettingsList != null && Model.LOPSettingsList.Count > 0)
                                {

                                    for (int i = 0; i < Model.LOPSettingsList.Count; i++)
                                    {

                                <tr>

                                    <td data-label="Allowance">
                                        @Model.LOPSettingsList[i].Name






                                        @Html.HiddenFor(m => m.LOPSettingsList[i].Name)
                                        @Html.HiddenFor(m => m.LOPSettingsList[i].AllowanceCode)
                                    </td>
                                    <td data-label="Select">



                                        <div class="checkbox-inline">
                                            <label class="checkbox checkbox-outline checkbox-outline-2x checkbox-primary">
                                                @Html.CheckBoxFor(Model => Model.LOPSettingsList[i].LopStatus, new { onclick = "EnableDisableTextLOP('" + i + "')" })
                                                @*<input class="LOPAllowance" id=@LOPid name=@LOPname type="checkbox" value=true   onclick="EnableDisabletext(@i)">*@


                                                @*<input type="checkbox" name="checkboxes16">*@
                                                <span></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td data-label="">
                                        <div class="form-group">


                                            @Html.TextBoxFor(Model => Model.LOPSettingsList[i].LopPercent, new { @placeholder = "0.00", @readonly = "true", onkeypress = "return isNumberKey(event)" })

                                            @*<input type="text" class="form-control form-control-sm" placeholder="0.00">*@
                                        </div>
                                    </td>
                                    <td data-label="">



                                        <div class="checkbox-inline">
                                            <label class="checkbox checkbox-outline checkbox-outline-2x checkbox-primary">


                                                @Html.CheckBoxFor(Model => Model.LOPSettingsList[i].EsiLeaveStatus, new { onclick = "EnableDisableTextESI('" + i + "')" })
                                                <span></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td data-label="">
                                        <div class="form-group">
                                            @Html.TextBoxFor(Model => Model.LOPSettingsList[i].EsiLeavePercent, new { @placeholder = "0.00", @readonly = "true", onkeypress = "return isNumberKey(event)" })
                                            @*<input type="text" class="form-control form-control-sm" placeholder="0.00">*@
                                        </div>
                                    </td>
                                    <td data-label="Select">


                                        <div class="checkbox-inline">
                                            <label class="checkbox checkbox-outline checkbox-outline-2x checkbox-primary">


                                                @Html.CheckBoxFor(Model => Model.LOPSettingsList[i].LateHourStatus, new { onclick = "EnableDisableTextLATEHour('" + i + "')" })
                                                @*<input type="checkbox" name="checkboxes16">*@
                                                <span></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td data-label="">
                                        <div class="form-group">
                                            @Html.TextBoxFor(Model => Model.LOPSettingsList[i].LateHourPercent, new { @placeholder = "0.00", @readonly = "true", onkeypress = "return isNumberKey(event)" })
                                            @*<input type="text" class="form-control form-control-sm" placeholder="0.00">*@
                                        </div>
                                    </td>
                                    <td data-label="Select">



                                        <div class="checkbox-inline">
                                            <label class="checkbox checkbox-outline checkbox-outline-2x checkbox-primary">


                                                @Html.CheckBoxFor(Model => Model.LOPSettingsList[i].SuspensionStatus, new { onclick = "EnableDisableTextSuspension('" + i + "')" })
                                                <span></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td data-label="">
                                        <div class="form-group">

                                            @Html.TextBoxFor(Model => Model.LOPSettingsList[i].SuspensionPercent, new { @placeholder = "0.00", @readonly = "true", onkeypress = "return isNumberKey(event)" })
                                        </div>
                                    </td>
                                    <td data-label="Select">

                                        <div class="checkbox-inline">
                                            <label class="checkbox checkbox-outline checkbox-outline-2x checkbox-primary">


                                                @Html.CheckBoxFor(Model => Model.LOPSettingsList[i].LayOffStatus, new { onclick = "EnableDisabletextLayOff('" + i + "')" })
                                                <span></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td data-label="">
                                        <div class="form-group">

                                            @Html.TextBoxFor(Model => Model.LOPSettingsList[i].LayOffPercent, new { @placeholder = "0.00", @readonly = "true",
                                           onkeypress = "return isNumberKey(event)"})
                                        </div>
                                    </td>



                                    <td data-label="Select">

                                        <div class="checkbox-inline">
                                            <label class="checkbox checkbox-outline checkbox-outline-2x checkbox-primary">


                                                @Html.CheckBoxFor(Model => Model.LOPSettingsList[i].MaternityLeaveStatus, new { onclick = "EnableDisabletextMaternityLeave('" + i + "')" })
                                                <span></span>
                                            </label>
                                        </div>
                                    </td>
                                    <td data-label="">
                                        <div class="form-group">

                                            @Html.TextBoxFor(Model => Model.LOPSettingsList[i].MaternityLeavePercent, new { @placeholder = "0.00", @readonly = "true" ,
                                           onkeypress = "return isNumberKey(event)"})
                                        </div>
                                    </td>
                                </tr>


                                    }
                                }



                            </tbody>
                        </table>
                    </div>



                    <!-- Table Setion End -->
                    <div class="row card-footer-bottom-fixed">

                        <div class="col-md-12 align-right">

                            <button class="btn btn-default float-right mobile-full-width" onclick="OnSaveClick()">
                                Save
                            </button>



                        </div>


                    </div>

                </div>
            </div>

        </div>

    </div>

</div>

