@model Hrms.Lite.Shared.PayRoll.SalaryHold

<style>
    .icon_users {
        height: 21px !important;
    }
</style>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table salary-hold-list-tble">
    @Html.HiddenFor(m => m.SalaryHoldList.Count)
    <table id="TableSalaryHold">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">Gross Sal.</th>
                <th scope="col">Gross Ded.</th>
                <th scope="col">Net Pay</th>
                <th scope="col" data-bs-toggle="tooltip" title="Hold Amount">Hold Amt.</th>
                <th scope="col">Remarks</th>
                <th scope="col">Action</th>

            </tr>
        </thead>
        <tbody>

        

        </tbody>
    </table>



</div>
