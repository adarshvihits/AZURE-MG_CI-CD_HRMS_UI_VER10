@model Hrms.Lite.Shared.PayRoll.SalaryReleaseWorkFlow
<script src="~/js/settings.js"></script>

    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table">
        @Html.HiddenFor(m => m.SalaryReleaseWorkFlowList.Count)
        @Html.HiddenFor(m => m.PendingCount)
        @Html.HiddenFor(m => m.ConfirmedCount)
        <table id="SalaryReleaseWFTable" class="common-table">
            <thead>
                <tr class="table-dark">
                    <th scope="col">ID</th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">Location</th>
                    <th scope="col">Designation</th>
                    <th scope="col">First Approver</th>
                    <th scope="col">Second Approver</th>
                    <th scope="col">Amount</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.SalaryReleaseWorkFlowList != null && Model.SalaryReleaseWorkFlowList.Count > 0)
                {
                    for (int i = 0; i < Model.SalaryReleaseWorkFlowList.Count; i++)
                    {
                        <tr>
                            <td data-label="ID">@Model.SalaryReleaseWorkFlowList[i].EmployeeID</td>
                            <td data-label="Name">@Model.SalaryReleaseWorkFlowList[i].EmployeeName</td>
                            <td data-label="Location">@Model.SalaryReleaseWorkFlowList[i].Location</td>
                            <td data-label="Designation">@Model.SalaryReleaseWorkFlowList[i].Designation</td>
                            <td data-label="First Approver">@Model.SalaryReleaseWorkFlowList[i].FirstApprover</td>
                            <td data-label="Second Approver">@Model.SalaryReleaseWorkFlowList[i].SecondApprover</td>
                            <td data-label="Amount">@Model.SalaryReleaseWorkFlowList[i].Amount</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (Model.TabIndex == 0)
    {
        <div class="row card-footer-bottom-fixed align-right">


            <div class="col-md-12">
                <button class="btn btn-default float-right mobile-full-width" id="saveButton" type="button" onclick="onSaveClick()">
                    Save
                </button>

            </div>


        </div>
    }
