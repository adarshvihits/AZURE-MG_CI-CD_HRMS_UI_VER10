
@model Hrms.Lite.Shared.General.Filter
<script>
    $(document).ready(function () {
        debugger;


    });
</script>
@using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "HolidayWageFilter" }))
{

    @Html.HiddenFor(m => m.Tabindex)
    @Html.HiddenFor(m => m.SearchId)
   

    <div id="filterForm" class="slider-forms slider-forms-open HolidayWageFilter">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('HolidayWageFilter')"><i class="ki ki-close icon-xs text-muted"></i></div>
            <div class="filter-slider-item-box">
                <h4>Basic Filter</h4>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Functional Designation</label>


                            @Html.DropDownListFor(m => m.Basic_Filter.Designation.Code, (SelectList)ViewBag.Dsg, "--Select--", new { @class = "form-control form-control-sm reset" })



                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Department</label>
                            @Html.DropDownListFor(m => m.Basic_Filter.Department.Code, (SelectList)ViewBag.Dept, "--Select--", new { @class = "form-control form-control-sm reset" })

                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Location</label>


                            @Html.DropDownListFor(m => m.Basic_Filter.Location.Code, (SelectList)ViewBag.Loc, "--Select--", new { @class = "form-control form-control-sm reset" })

                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Category</label>


                            @Html.DropDownListFor(m => m.Basic_Filter.Category.Code, (SelectList)ViewBag.Cat, "--Select--", new { @class = "form-control form-control-sm reset" })

                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Designation</label>
                            @Html.DropDownListFor(m => m.Basic_Filter.Grade.Code, (SelectList)ViewBag.Grd, "--Select--", new { @class = "form-control form-control-sm reset" })

                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Payroll Group</label>

                            @Html.DropDownListFor(m => m.Basic_Filter.PayrollGroup.Code, (SelectList)ViewBag.PayrollGrp, "--Select--", new { @class = "form-control form-control-sm reset" })

                        </div>
                    </div>
                </div>
            </div>
            <div class="filter-slider-item-box">
                <h4>Optional Filter</h4>
                <div class="row">


                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Division</label>
                            @Html.DropDownListFor(m => m.Optional_Filter.Division.Code, (SelectList)ViewBag.division, "--Select--", new { @class = "form-control form-control-sm reset" })



                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Section</label>
                            @Html.DropDownListFor(m => m.Optional_Filter.Section.Code, (SelectList)ViewBag.section, "--Select--", new { @class = "form-control form-control-sm reset" })

                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Employment Type</label>
                            @Html.DropDownListFor(m => m.Optional_Filter.Division.Code, (SelectList)ViewBag.EmploymentType, "--Select--", new { @class = "form-control form-control-sm reset" })

                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Work Location</label>
                            @Html.DropDownListFor(m => m.Optional_Filter.WorkLocation.Code, (SelectList)ViewBag.WorkLocation, "--Select--", new { @class = "form-control form-control-sm reset" })

                        </div>
                    </div>
                </div>
                <div class="row">

                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Wage Grade</label>
                            @Html.DropDownListFor(m => m.Optional_Filter.WageGradeMaster.Code, (SelectList)ViewBag.WageGrade, "--Select--", new { @class = "form-control form-control-sm reset" })

                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Employment Status</label>
                            @Html.DropDownListFor(m => m.Optional_Filter.EmploymentStatus.Code, (SelectList)ViewBag.EmploymentStatus, "--Select--", new { @class = "form-control form-control-sm reset" })

                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Gender</label>

                            @Html.DropDownListFor(m => m.Optional_Filter.Gender.Code, (SelectList)ViewBag.Gen, "--Select--", new { @class = "form-control form-control-sm reset" })

                        </div>
                    </div>


                </div>

            </div>



            <div class="row card-footer-bottom-fixed border-none">
                <div class="col-md-12 align-right">
                    <button type="button" class="btn btn-secondary  mobile-full-width" onclick="ApplyFilter('reset')">
                        Reset
                    </button>
                    <button type="button" class="btn btn-default  mobile-full-width" onclick="ApplyFilter('apply')">

                        Apply
                    </button>
                </div>

            </div>

        </div>






    </div>
}