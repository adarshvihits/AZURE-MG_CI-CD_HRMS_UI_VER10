@model Hrms.Lite.Shared.PayRoll.AllowanceSettings.ApplicableAllowance
@*@{
        ViewData["Title"] = "SaveApplicableAllowance";

    }*@
<script>
    $(document).ready(function () {
        $('.all').on('click', function () {
            debugger
