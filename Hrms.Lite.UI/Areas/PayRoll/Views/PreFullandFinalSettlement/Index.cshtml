@model Hrms.Lite.Shared.PayRoll.PreFullandFinalSettlement
@{
    ViewData["Title"] = "View";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/scripts/PayRoll/PreFullandFinalSettlement.js"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>


<div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->


            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title"> Pre Full and Final Settlement</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index","Home",new { Area=""})"><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            Pre Full and Final Settlement
                        </li>
                    </ul>
                </div>
            </div>
            <!--begin::Topbar-->
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body">



                        <div class="row tab-style-button">
                            <div class="tab-button-wrap">
                                <div class="tab-items pt-3 ml-3">
                                    <div class="row-outer  " style="width:215px">
                                        <div class="form-group filter-combobox mt-0">
                                            @Html.DropDownListFor(m => m.PayrollGroup.Code, (SelectList)ViewBag.PayrollGroup, "--Select PayRoll Group--", new { @class = "form-control form-control-sm", @onchange = "fillMonth(this);validate(this,'Payrollgroup')" })
                                            <span id="Payrollgroup"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="tab-items pt-3">

                                    <div class="row-outer  ">
                                        <div class="form-group filter-combobox mt-0">
                                            @Html.DropDownListFor(m => Model.PayrollMonth.Code, (SelectList)ViewBag.month, "--Select Month--", new { @class = "form-control form-control-sm", @onchange = "getList();validate(this,'Month')", @style = "width:150px;" })
                                            <span id="Month"></span>
                                        </div>
                                    </div>
                                </div>
                                <div class="tab-items select-option">
                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="PreFandFEmpSearch" class="form-control form-control-sm"
                                               placeholder="Search Employee ID" onkeyup="searchRows()">
                                    </div>
                                    <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>
                                    <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                       data-bs-original-title="Export to Excel" onclick="ExportToExcel()">
                                        <i class="icon-xl far fa-file-excel"></i>
                                    </a>



                                </div>

                            </div>
                        </div>
                        <div id="filterSlider">
                            @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
                        </div>
                        <div id="PreFandFList">
                            @await Html.PartialAsync("_PreFandFList")
                        </div>

                        <!--end: Datatable-->
                     

                    </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>

    <!--end::Content-->

</div>


