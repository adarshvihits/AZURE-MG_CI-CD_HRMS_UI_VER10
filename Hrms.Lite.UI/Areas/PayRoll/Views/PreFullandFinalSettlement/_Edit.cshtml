@model Hrms.Lite.Shared.PayRoll.PreFullandFinalSettlement
<script src="~/js/tooltip.js"></script>
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "PreFandFDetailsSave" }))
{
    <div id="PF_Settings_slider" class="slider-forms slider-forms-open closeEdit">
        <div class="slider-inner-style">
            <div class="slider-form-close">
                <i class="ki ki-close icon-xs text-muted" onclick="CloseSlider('closeEdit')"></i>
            </div>
            <h4>Employee Settlement</h4>
            @Html.HiddenFor(m => m.EmployeeHeader.EmployeeGuid)
            @Html.HiddenFor(m => m.PayrollMonth.Code)
            <div class="profile-header position-relative pb-12 mb-5" style="padding-bottom: 2px !important; padding-top: 5px !important;">
                <div class="row">
                    @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeSliderHeader.cshtml", Model.EmployeeHeader)
                </div>
                <div class="profile-header-overflow"></div>
            </div>
            <div class="add-padding">
                <div class="row">

                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Location
                            </label>
                            <div class="view-details">
                                @Model.EmployeeHeader.Location.Name
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Last Working Date</label>
                            <div class="view-details">

                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.LWD))
                            </div>
                        </div>
                    </div>


                </div>


                <div class="row">



                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">LOP/AB Days</label>
                            <div class="view-details">
                                @Model.LOPDays
                                @Html.HiddenFor(m => m.LOPDays)
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Pay Days
                            </label>
                            <div class="view-details">
                                @Model.PayDays
                                @Html.HiddenFor(m => m.PayDays)
                            </div>
                        </div>
                    </div>

                </div>
                <div class="row">

                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Total Basic Salary
                            </label>
                            <div class="view-details">

                                @Model.TotalBasic
                                @Html.HiddenFor(m => m.TotalBasic)
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Earned Basic Salary
                            </label>
                            <div class="view-details">
                                @Model.EarnedBasic
                                @Html.HiddenFor(m => m.EarnedBasic)
                            </div>
                        </div>
                    </div>


                </div>

                <div class="row">

                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Held Basic Salary
                            </label>
                            <div class="view-details">
                                @Html.TextBoxFor(Model => Model.Held, new { @class = "form-control form-control-sm", @placeholder = "Amount",@onkeypress = "return onlyAmount(event)" })
                                @*@Model.Held
                                @Html.HiddenFor(m => m.Held)*@
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Total Release Salary
                            </label>
                            <div class="view-details">

                                @Model.Release
                                @Html.HiddenFor(m => m.Release)
                            </div>
                        </div>
                    </div>



                </div>




                <div class="row">




                    <div class="col-md-12">
                        <label>Remarks</label>
                        @Html.TextAreaFor(Model => Model.Remarks, new { @class = "form-control form-control-sm", maxlength = "250" })
                    </div>

                </div>
                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">
                        <button type="button" class="btn btn-default  mobile-full-width" onclick="PreFandFSave()">
                            Save
                        </button>
                    </div>

                </div>
            </div>

        </div>
    </div>
}