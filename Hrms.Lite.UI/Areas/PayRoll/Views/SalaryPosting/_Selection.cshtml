@model Hrms.Lite.Shared.PayRoll.SalaryPosting


                            <div class="step-outer pb-10 step_row">
                                <div class="step-item active">
                                    Selection
                                    <span class="step-circle"></span>
                                </div>
                                <div class="step-item ">
                                    Posting Verification
                                    <span class="step-circle"></span>
                                </div>
                                <div class="step-item ">
                                    Comparison
                                    <span class="step-circle"></span>
                                </div>
                                <div class="step-item">
                                    Posting
                                    <span class="step-circle"></span>
                                </div>


                            </div>

                            <div class="page_white">

                                <div class="row my-2">
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label>Payroll Group</label>
                                            @Html.DropDownListFor(Model => Model.PayrollGroup.Code, (SelectList)ViewBag.PayrollGroup, "--Select--", new { @class = "form-control form-control-sm payroll", @onchange = "validate(this,'payrollgp');GetMonth()" })
                                            <span id="payrollgp"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label>Month</label>
                                            @Html.DropDownListFor(Model => Model.PayrollMonth.Code, (SelectList)ViewBag.month, "--Select--", new { @class = "form-control form-control-sm month", @onchange = "validate(this,'month')" })
                                            <span id="month"></span>
                                        </div>
                                    </div>

                                    <div class="col-md-2  align-items-center d-flex justify-content-center">
                                        <a href="#" type="button"
                                           class="btn btn-default float-right mobile-full-width mt-5" onclick="onProceedClick()">
                                            Proceed
                                        </a>
                                    </div>
                                </div>



                                <div class="row my-2">


                                </div>


                            </div>




                            <!-- <end table></end> -->




