@model Hrms.Lite.Shared.PayRoll.SalaryPosting
<script src="~/js/settings.js"></script>
<style>
    .act-table .dataTables_scrollBody {
        height: 30vh !important;
    }
</style>
<script>

    $(".search-slider-inner").click(function () {
        $(".form-control").toggleClass('field-width-big')
    });

</script>
<div class="row tab-style-button">
    <div class="tab-button-wrap align-items-center">





        <div class="tab-items">
            <div class="form-group">
                <label class="view-title">Description</label>

                <div class="view-details">@ViewBag.Desc</div>

            </div>
        </div>
        <div class="tab-items">
            <div class="form-group">
                <label class="view-title">Month</label>

                <div class="view-details">@ViewBag.MName</div>

            </div>
        </div>



        <div class="tab-items select-option high">

            <div class="sraech-slider">
                <div class="search-slider-inner">
                    <i class="fa fa-search"></i>
                </div>
                <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                       placeholder="ID/Name">
            </div>


            <button data-bs-toggle="tooltip" title=""
                    class="btn btn-excel"
                    data-bs-original-title="Export to Excel" onclick="EmpExportToExcelPopUp('@ViewBag.Desc','@ViewBag.Type','@ViewBag.code')">
                <i class="icon-xl far fa-file-excel"></i>
            </button>

        </div>


    </div>
</div>

