<div style="padding:10px;" class="ihits-table table-border hover-color odd-even mobile-responsive-table act-table">
    @Html.HiddenFor(m => m.PostingEmpList_Popup.Count)
    <table id="PopUpAccountStatemntTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">Amount</th>

            </tr>
        </thead>
        <tbody>
            @if (Model.PostingEmpList_Popup != null && Model.PostingEmpList_Popup.Count > 0)
            {
                for (int i = 0; i < Model.PostingEmpList_Popup.Count; i++)
                {
                    <tr>
                        <td data-label="ID">
                            @Model.PostingEmpList_Popup[i].EmployeeID
                        </td>
                        <td data-label="Employee Name">
                            @Model.PostingEmpList_Popup[i].EmployeeName

                        </td>
                        <td data-label="Designation">@Model.PostingEmpList_Popup[i].Designation</td>
                        <td data-label="Department">
                            @Model.PostingEmpList_Popup[i].Department
                        </td>
                        <td data-label="Location">@Model.PostingEmpList_Popup[i].Location</td>
                        <td data-label="Amount">@Model.PostingEmpList_Popup[i].Amount</td>



                    </tr>


                }
            }
           
        </tbody>


    </table>
</div>
