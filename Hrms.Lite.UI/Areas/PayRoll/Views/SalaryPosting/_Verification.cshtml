@model Hrms.Lite.Shared.PayRoll.SalaryPosting


                            <div class="step-outer step_row pb-10">
                                <div class="step-item active" onclick="onTabNameClick('selection')">
                                    Selection
                                    <span class="step-circle"></span>
                                </div>
                                <div class="step-item active">
                                    Posting Verification
                                    <span class="step-circle" onclick="onTabNameClick('Verify')"></span>
                                </div>
                                <div class="step-item ">
                                    Comparison
                                    <span class="step-circle"></span>
                                </div>
                                <div class="step-item">
                                    Posting
                                    <span class="step-circle"></span>
                                </div>


                            </div>

                            <div class="" >

                                <div class="row my-2">
                                    <div class="col-md-1">
                                        <div class="form-group">
                                            <label class="view-title">PayRoll Group </label>
                                            <div class="view-details">
                                                @Model.PayrollGroup.Name
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-1">
                                        <div class="form-group">
                                            <label class="view-title">Month </label>
                                            <div class="view-details">
                                                @Model.PayrollMonth.Name
                                            </div>
                                        </div>
                                    </div>


                                </div>
                            </div>
                            <div class="ihits-table table-border  mobile-responsive-table salary-setting-list vertical-scroll-400">
                                <table>
                                    <thead>
                                        <tr class="table-dark">
                                            <th scope="col">Description</th>
                                            <th scope="col">Count</th>

                                        </tr>
                                    </thead>

                                    <tbody>

                                        @if (Model.PostingVerification != null && Model.PostingVerification.Count > 0)
                                        {


                                            for (int i = 0; i < Model.PostingVerification.Count; i++)
                                            {

                                        <tr>
                                          
                                            <td data-label="HR & Time Office">@Model.PostingVerification[i].Description</td>





                                            <td data-label="Count" data-bs-toggle="modal" data-target=".bd-example-modal-lg-HR">
                                                <a onclick="getPopUp('@Model.PostingVerification[i].Code', '@Model.PostingVerification[i].Description')">@Model.PostingVerification[i].Count</a>




                                            </td>
                                        </tr>




                                            }

                                        }
                                    </tbody>
                                </table>
                            </div>
                            <!-- <end table></end> -->
                            <div class="row card-footer-bottom-fixed">

                                <div class="col-md-12 align-right">
                                    <a href="#" type="button"
                                       class="btn btn-default float-right mobile-full-width" onclick="onNextClick('Verify')">
                                        Next
                                    </a>
                                </div>

                            </div>
                        