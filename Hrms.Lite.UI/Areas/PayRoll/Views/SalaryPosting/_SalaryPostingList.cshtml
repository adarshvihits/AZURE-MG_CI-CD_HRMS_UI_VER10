
@model Hrms.Lite.Shared.PayRoll.SalaryPosting
<style>
    .ihits-table .btn {
        padding: 0px 10px;
        cursor: pointer;
        line-height: 1;
    }
</style>

                            <div class="step-outer step_row pb-10">
                                <div class="step-item active" onclick="onTabNameClick('selection')">
                                    Selection
                                    <span class="step-circle"></span>
                                </div>
                                <div class="step-item active">
                                    Posting Verification
                                    <span class="step-circle" onclick="onTabNameClick('Verify')"></span>
                                </div>
                                <div class="step-item active">
                                    Comparison
                                    <span class="step-circle" onclick="onTabNameClick('Comparison')"></span>
                                </div>
                                <div class="step-item active">
                                    Posting
                                    <span class="step-circle"></span>
                                </div>


                            </div>

                            <div >

                                <div class="row my-2">
                                    <div class="col-md-1">
                                        <div class="form-group">
                                            <label class="view-title">PayRoll Group </label>
                                            <div class="view-details">
                                                @Model.PayrollGroup.Name
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-1">
                                        <div class="form-group">
                                            <label class="view-title">Month </label>
                                            <div class="view-details">
                                                @Model.PayrollMonth.Name
                                            </div>
                                        </div>
                                    </div>


                                </div>
                            </div>
                            <div class="ihits-table table-border  mobile-responsive-table salary-setting-list vertical-scroll-400">
                                <table>
                                    <thead>
                                        <tr class="table-dark">
                                            <th scope="col">Description</th>
                                            <th scope="col" data-bs-toggle="tooltip"
                                                data-bs-original-title="Number Of Employee">No. Of Employees</th>
                                            <th scope="col">Amount</th>

                                        </tr>
                                    </thead>

                                    <tbody>

                                        @if (Model.PostingDetails != null && Model.PostingDetails.Count > 0)
                                        {


                                            for (int i = 0; i < Model.PostingDetails.Count; i++)
                                            {

                                                <tr>
                                                    <td data-label="Description">@Model.PostingDetails[i].Description</td>
                                                    <td data-label="Number Of Employee">

                                                        <a data-bs-toggle="modal" data-target=".bd-example-modal-lg"
                                                           type="button" class="btn btn-sm float-left" onclick="OnEmployeeCountClick('@Model.PostingDetails[i].Description', '@Model.PostingDetails[i].TYPE', '@Model.PostingDetails[i].Code')">
                                                            @Model.PostingDetails[i].EmployeeCount
                                                        </a>



                                                    <td data-label="Amount">
                                                        @Model.PostingDetails[i].Amount

                                                    </td>


                                                </tr>




                                            }

                                        }
                                    </tbody>
                                </table>
                            </div>
                            <!-- <end table></end> -->
                            <div class="row card-footer-bottom-fixed">

                                <div class="col-md-12 align-right">
                                    <a href="#" type="button"
                                       class="btn btn-default float-right mobile-full-width" onclick="MonthlySalaryPostingValidation()">
                                        Salary Posting
                                    </a>
                                </div>

                            </div>
                      
<div class="modal fade bd-example-modal-lg" tabindex="-1"
     role="dialog" aria-labelledby="myLargeModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg" style=" max-width: 1000px;">
        <div id="myDiv" class="modal-content popup">
            <div class="modal-header" style="padding:10px">
                <h5 class="modal-title" id="exampleModalLabel">
                    Employee Details
                </h5>
                <button type="button" class="close"
                        data-bs-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true"
                       class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body">

            </div>



        </div>
    </div>
</div>

