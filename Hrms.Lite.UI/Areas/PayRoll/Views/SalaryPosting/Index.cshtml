@model Hrms.Lite.Shared.PayRoll.SalaryPosting
@*<script src="~/js/jquery.min.js"></script>
    <script src="~/js/datatables.min.js"></script>*@
<script src="~/scripts/PayRoll/SalaryPosting.js"></script>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "sal_save" }))
{
<div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->


            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Salary Posting </h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })" class=""><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            Salary Posting
                        </li>
                    </ul>
                </div>
            </div>

        </div>
        <!--end::Container-->
    </div>




    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->

                <div class="row height-100per">

                    <div class="col-md-12">
                        <div class="card card-custom height-100per">

                            <div class="card-body">






                                <!--end::Header-->
                                <!--begin::Content-->
                                <div id="sal_selection">
                                    @await Html.PartialAsync("_Selection")
                                </div>
                                <div id="sal_CommonList">
                                    @await Html.PartialAsync("_CommonDetails")
                                </div>
                                <!--end::Content-->
                            </div>
                            

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
        </div>
}
                        <div class="modal fade bd-validation-modal-lg" tabindex="-1"
                             role="dialog" aria-labelledby="myLargeModalLabel"
                             aria-hidden="true">
                            <div class="modal-dialog modal-lg" style=" max-width: 1051px; height:400px;">
                                <div id="myDiv" class="modal-content popup">
                                    <div class="modal-header" style="padding:10px">
                                        <h5 class="modal-title" id="modeltittle">
                                        </h5>
                                        <button type="button" class="close"
                                                data-bs-dismiss="modal" aria-label="Close">
                                            <i aria-hidden="true"
                                               class="ki ki-close"></i>
                                        </button>
                                    </div>

                                    <div class="validationpopup">

                                    </div>



                                </div>
                            </div>
                        </div>
