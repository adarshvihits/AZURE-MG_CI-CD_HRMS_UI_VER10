@model Hrms.Lite.Shared.PayRoll.NoticePayReturn
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;

<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        moveCursorToEnd('Name');
    });


</script>
<script src="~/js/tooltip.js"></script>
@using (Html.BeginForm("Save", "NoticePayReturn", FormMethod.Post, new { id = "NoticePayReturnsave" }))
{
    <div id="departmentedit" class="slider-forms slider-forms-open AddnewOrEditDiv">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('AddnewOrEditDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4>Notice Pay Return</h4>
            </div>
            <div class="add-padding">
                <div class="profile-header position-relative box-shadow-none mb-2">
                    @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeHeader.cshtml", Model.EmployeeHeader)



                    <div class="profile-header-overflow"></div>
                </div>



                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-0">
                            <label>Payed Date</label><span class="Mandatory">*</span>
                            @Html.HiddenFor(model => Model.Mode)
                            @Html.HiddenFor(model => Model.code)
                            <div class="input-group date">
                                @Html.TextBoxFor(m => m.PayedDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2 dojpicker", @readonly = "true", @placeholder = "", @onchange = " ", onclick = "$('.dojpicker').datepicker('show')" })

                                <div class="input-group-append">
                                    <span class="input-group-text">
                                        <i class="la la-calendar"></i>
                                    </span>
                                </div>
                            </div>
                            <span id="PayedDate"></span>
                        </div>
                    </div>


                    <div class="col-md-6">
                        <div class="form-group">
                            <label>
                                Amount
                                <span class="Mandatory">*</span>
                            </label>
                            @Html.TextBoxFor(Model => Model.Amount, new { @class = "form-control form-control-sm DeptShtName", @placeholder = "PranNumber", @onblur = "validate(this,'Amount')", maxlength = "12" })


                        </div>
                        <span id="Amount"></span>
                    </div>
                </div>


                <div class="row my-3">
                    <div class="col-md-12">
                        <label>Description</label>
                        <div class="view-details">
                            @if (Model.Mode == "CREATE")
                            {

                                @Html.TextAreaFor(model => Model.Remarks, new { @class = "form-control form-control-sm DeptDiscription", @placeholder = "Description", maxlength = "250" })



                            }
                            @if (Model.Mode == "MODIFY")
                            {

                                @Html.HiddenFor(model => Model.Remarks)

                                @Html.DisplayFor(model => Model.Remarks)

                            }

                        </div>
                    </div>
                </div>

                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12 align-right">
                        @if (Model.Mode == "CREATE")
                        {

                            <button type="button" class="btn btn-default  mobile-full-width" onclick="NoticePayReturnSave('Save')">
                                Save
                            </button>

                        }
                        @if (Model.Mode == "MODIFY")
                        {

                            <button type="button" class="btn btn-default  mobile-full-width" onclick="NoticePayReturnSave('Modify')">
                                Modify
                            </button>
                            <button type="button" class="btn btn-default  mobile-full-width" onclick="confirmDelete('Model.code')">
                                Delete
                            </button>

                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}