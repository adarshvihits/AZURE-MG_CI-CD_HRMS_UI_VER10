@model Hrms.Lite.Shared.PayRoll.AllowanceSettings.AllowanceSettingsBatchUpdate
<script>
    $(document).ready(function () {
        debugger;


    });
</script>
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "DefaultSettings" }))
{
    <div id="DefaultSettings" class="slider-forms slider-forms-open defaultSettingsSlider">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('defaultSettingsSlider')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>
                Default settings
            </h4>
            <div class="row mt-2">

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Calculation Type</label><span class="Mandatory">*</span>
                        <div class="view-details">
                            @Html.DropDownListFor(model => model.CalcTypeCode, (SelectList)ViewBag.CalculationType, "Select Calculation Type", new { @class = "form-control form-control-sm" , @style = "width: 200px;" , @onchange = "validate(this,'CalcType')" })
                            <span id="CalcType"></span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">

                    <div class="form-group">
                        <label>Amount/Rate in %</label><span class="Mandatory">*</span>
                        @Html.TextBoxFor(model => model.Rate, new { @class = "form-control form-control-sm", @placeholder = "Amount/Rate in %", style = "width: 100%" , maxlength = "8", onpaste = "return false", onkeypress = "return onlyNumberKey(event)" })
                        <span id="RateValidation"></span>
                    </div>

                </div>
            </div>

            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 align-right">
                    <button type="button"
                            class="btn btn-default  mobile-full-width"onclick="DefaultSettingsUpdate()">
                        Save
                    </button>
                </div>

            </div>
        </div>
    </div>


}