@model Hrms.Lite.Shared.PayRoll.BonusProcessing
<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>
<script src="~/scripts/PayRoll/bonusProcessing.js"></script>

@{
 
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Bonus Processing</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a href="@Url.Action("Index", "BonusProcessing", new { Area = "PayRoll" })" class="">
                            Bonus Processing 
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Bonus Processing Employee Grid
                    </li>

                </ul>
            </div>
        </div>

        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>

    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body">
                        @using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "processed_form" }))
                        {
                            <div class="row tab-style-button">
                                <div class="tab-button-wrap">
                                    @Html.HiddenFor(Model => Model.ProcessMonth.Code)
                                    @Html.HiddenFor(Model => Model.PeriodFrom.Code)
                                    @Html.HiddenFor(Model => Model.PeriodTo.Code)
                                    @Html.HiddenFor(Model => Model.BonusGroup.Code)
                                    <div class="tab-items">
                                        <div class="form-group filter-combobox mr-2" style="width: 120px;">
                                            <label class="view-title">Process Month </label>
                                            <div class="view-details p_month">
                                                @Model.ProcessMonth.Name
                                            </div>

                                        </div>
                                    </div>
                                    <div class="tab-items">
                                        <div class="form-group filter-combobox mr-2" style="width: 120px;">
                                            <label class="view-title">Period From </label>
                                            <div class="view-details from_month">
                                                @Model.PeriodFrom.Name

                                            </div>
                                        </div>
                                    </div>
                                    <div class="tab-items">
                                        <div class="form-group filter-combobox mr-2" style="width: 120px;">
                                            <label class="view-title">Period To </label>
                                            <div class="view-details to_month">
                                                @Model.PeriodTo.Name

                                            </div>
                                        </div>
                                    </div>
                                    <div class="tab-items">
                                        <div class="form-group filter-combobox mr-2" style="width: 120px;">
                                            <label class="view-title">Bonus Group </label>
                                            <div class="view-details bonus">
                                                @Model.BonusGroup.Name

                                            </div>
                                        </div>
                                    </div>

                                    <div class="tab-items select-option">

                                        <div class="sraech-slider">
                                            <div class="search-slider-inner">
                                                <i class="fa fa-search"></i>
                                            </div>
                                            <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                                   placeholder="ID/Name">
                                        </div>


                                        <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                           data-bs-original-title="Export to Excel">
                                            <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                        </a>
                                    </div>



                                </div>
                            </div>


                        }
                        <div id="">
                            @await Html.PartialAsync("_EmpList")
                        </div>


                        <div id="filterSlider">
                            @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
                        </div>

                        <!--end: Datatable-->
                    </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>







<div class="modal fade bonuspopup" tabindex="-1"
     role="dialog" aria-labelledby="myLargeModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg" style="max-width:800px;">
        <div id="myDiv" class="modal-content popup" style=" margin: initial;">
            <div class="modal-header" style="padding:0px 10px">
                <h5 class="modal-title" id="exampleModalLabel">
                  <span id="empDetails"></span>
                </h5>
                <button type="button" class="close mt-2"
                        data-bs-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true"
                       class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body" style="padding:20px;" >

       </div>



        </div>
    </div>
</div>