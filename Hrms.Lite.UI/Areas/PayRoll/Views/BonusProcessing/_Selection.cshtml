@model Hrms.Lite.Shared.PayRoll.BonusProcessing


<style>

    .drop-downs-boxx {
        width: 100%;
        padding:20px;
        background-color: #b2b3b5;
        box-shadow: rgba(99, 94, 102, 0.2) 0px -1px 15px 0px;
        border-radius: 10px;
    }


    .center-align-dropdownzz {
       
        background-color: white;
        padding: 40px 0px 50px;
        border-radius: 10px;
    }
    



</style>


<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body d-flex  justify-content-center align-items-center " >
                            <div class="row justify-content-center w-100">

                                <div class="col-md-5">
                                    <div class="drop-downs-boxx">

                                        <div class="center-align-dropdownzz ">

                                            <div class="row justify-content-center">
                                                <div class="col-md-8">
                                                    <div class="form-group">
                                                        <label>Process Month</label>
                                                        @Html.DropDownListFor(model => model.ProcessMonth.Code, (SelectList)ViewBag.processMonth,
                                                       "--Select Process Month--", new { @class = "form-control form-control-sm", @onchange = "onProcMonthChange(this);" })
                                                        <span id="pMonth"></span>
                                                    </div>
                                                </div>
                                            </div>



                                            <div class="row justify-content-center">
                                                <div class="col-md-8">
                                                    <div class="form-group">
                                                        <label>Period From</label>
                                                        @Html.DropDownListFor(Model => Model.PeriodFrom.Code, (SelectList)ViewBag.Period, "--Select--", new { @class = "form-control form-control-sm", @onblur = "validate(this,'from')" })
                                                        <span id="from"></span>
                                                    </div>
                                                </div>
                                            </div>



                                            <div class="row  justify-content-center ">
                                                <div class="col-md-8">
                                                    <div class="form-group">
                                                        <label>Period To</label>
                                                        @Html.DropDownListFor(Model => Model.PeriodTo.Code, (SelectList)ViewBag.Period, "--Select--", new { @class = "form-control form-control-sm", @onblur = "validate(this,'to')" })
                                                        <span id="to"></span>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="row  justify-content-center ">
                                                <div class="col-md-8">
                                                    <div class="form-group">
                                                        <label>Bonus Group</label>
                                                        @Html.DropDownListFor(Model => Model.BonusGroup.Code, (SelectList)ViewBag.BonusGroup, "--Select--", new { @class = "form-control form-control-sm", @onblur = "validate(this,'bgroup')" })
                                                        <span id="bgroup"></span>
                                                    </div>
                                                </div>
                                            </div>


                                            <div class="row  justify-content-center ">
                                                <div class="col-md-2  align-items-center d-flex justify-content-center">
                                                    <a href="#" type="button"
                                                       class="btn btn-default float-right mobile-full-width mt-5" onclick="onProcessClick()">
                                                        Process
                                                    </a>
                                                </div>
                                            </div>

                                        </div>

                                        </div>




                                    </div>



                            </div>









                            <!-- <end table></end> -->

                        </div>

                    </div>
                </div>
            </div>




            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>