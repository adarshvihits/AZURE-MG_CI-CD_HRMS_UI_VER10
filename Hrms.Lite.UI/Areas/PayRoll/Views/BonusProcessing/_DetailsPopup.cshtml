@model Hrms.Lite.Shared.PayRoll.BonusProcessing

<div class="profile-header position-relative box-shadow-none mb-5">
    @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeHeader.cshtml", Model.EmployeeHeader)   
    <div class="profile-header-overflow"></div>
</div>

<div class="ihits-table table-border  mobile-responsive-table table_wrapper   Bonus-Processing-popup vertical-scroll-200">
    @Html.HiddenFor(Model => Model.BonusProcessingDetails.Count)
    <table id="bonusEmpTable">

        <thead>
            <tr class="table-dark">
                <th scope="col">Month</th>
                <th scope="col">Lop Amount</th>
                <th scope="col">Bonus Amount</th>
                <th scope="col">Bonus Applicable Salary</th>

            </tr>
        </thead>

        <tbody >

            @if (Model != null && Model.BonusProcessingDetails != null && Model.BonusProcessingDetails.Count > 0)
            {

                for (int i = 0; i < Model.BonusProcessingDetails.Count; i++)
                {

            <tr>
                <td data-label="ID">@Model.BonusProcessingDetails[i].Month</td>
                <td data-label="Name">
                    @Model.BonusProcessingDetails[i].LopAmount
                </td>
                <td data-label="Name">
                    @Model.BonusProcessingDetails[i].BonusAmount
                </td>
                <td data-label="Name">
                    @Model.BonusProcessingDetails[i].BonusApplSalary
                </td>

            </tr>
                }
            }

        </tbody>
        <tfoot style="display:inline;">
            <tr style=" position: sticky; bottom: 0;" class="table-light">
                <td data-label="ID" rowspan="1" colspan="1" style="width: 10%;"><strong></strong></td>
                <td data-label="ID" rowspan="1" colspan="1" style="width: 5%;"><strong>
                         <span >@Model.LopTotal</span></strong></td>

                <td data-label="No of days" rowspan="1" colspan="1" style="width: 5%;">
                    <strong>
                        <span>@Model.BonusTotal</span>
                    </strong>
                </td>
                <td data-label="No of days" rowspan="1" colspan="1" style="width: 0%;">
                    <strong>
                        <span>@Model.SalaryTotal</span>
                    </strong>
                </td>

            </tr>

        </tfoot>
    </table>
</div>
