@model Hrms.Lite.Shared.Master.VDAGroup
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}
@*<script src="~/js/jquery.min.js"></script>*@
<script src="~/scripts/PayRoll/monthlyVDASettings.js"></script>
<script>
    $(document).ready(function () {

    });
</script>
<script src="~/js/settings.js"></script>

<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Monthly VDA</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Monthly VDA
                    </li>
                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "MVDAsettingsform" }))
{
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body">
                        <!--begin: Search Form-->

                        <div class="row tab-style-button">
                            <div class="tab-button-wrap align-items-center">





                                <div class="tab-items">
                                    <label>Month</label>
                                    <div class="form-group filter-combobox mt-0">

                                        @Html.DropDownListFor(model => model.Month.Code, (SelectList)ViewBag.SalaryPeriod, "--Select--", new
                                        {
                                       @class = "form-control form-control-sm",
                                            @style = "width: 170px;",
                                            @onchange = "validate(this,'mvda_month');getList();"
                                        })
                                        <span id="mvda_month"></span>

                                    </div>
                                </div>





                                <div class="tab-items select-option high">


                                </div>


                            </div>
                        </div>
                        <div id="MVDASettings">
                            @await Html.PartialAsync("_List")

                        </div>


                        <!--end: Datatable-->
                        <div class="row card-footer-bottom-fixed border-none">

                            <div class="col-md-12 align-right">
                                <a type="button"
                                   class="btn btn-default  mobile-full-width" onclick="Save();">
                                    Save
                                </a>

                            </div>

                        </div>
                    </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>
}
<div class="slider-over-flow"></div>
<!--end::Content-->
