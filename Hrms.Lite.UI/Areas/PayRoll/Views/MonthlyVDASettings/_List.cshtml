@model Hrms.Lite.Shared.Master.VDAGroup
    <script src="~/js/settings.js"></script>
    <script src="~/js/tooltip.js"></script>
    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table monthly-vda-list vertical-scroll-450">
        <table class="common-table ">
            <thead>
                <tr class="table-dark">
                    <th scope="col">VDA Group</th>
                    <th scope="col">DA Point</th>
                    <th scope="col">Standard Deduction</th>
                    <th scope="col">DA Index</th>
                    <th scope="col">VDA Amount</th>




                </tr>
            </thead>
            <tbody>
                @if (Model.MonthlySetting != null && Model.MonthlySetting.Count > 0)
                {
                    @for (int i = 0; i < Model.MonthlySetting.Count; i++)
                    {
                        <tr>

                            <td data-label="VDA Group">
                                @Html.HiddenFor(m => m.MonthlySetting[i].VDAGroupCode)
                                @Model.MonthlySetting[i].VDAGroupName
                            </td>
                            <td data-label="DA Point ">
                                @Html.TextBoxFor(m => m.MonthlySetting[i].VDAPoint, new
                                {
                                    @class = "form-control form-control-sm",
                               @placeholder = "DA Point",
                                    @onkeypress = "onlyAmount(event)",
                               @onchange = "calculateVDAAmount(" + @i + ");"
                                })

                            </td>
                            <td data-label="Standard Deduction">
                                @Html.TextBoxFor(m => m.MonthlySetting[i].StandardDeduction, new
                                {
                                    @class = "form-control form-control-sm",
                               @placeholder = "Standard Deduction",
                                    @onkeypress = "onlyAmount(event)",
                               @onchange = "calculateVDAAmount(" + @i + ");"
                           })

                            </td>
                            <td data-label="DA Index">
                                @Html.TextBoxFor(m => m.MonthlySetting[i].DAIndex, new
                                {
                                    @class = "form-control form-control-sm",
                                    @placeholder = "DA Index",
                               @onkeypress = "onlyAmount(event)",
                                    @onchange = "calculateVDAAmount(" + @i + ");"
                           })

                            </td>
                            <td data-label="VDA Amount">
                                @Html.TextBoxFor(m => m.MonthlySetting[i].VDAAmount, new
                                {
                                    @class = "form-control form-control-sm",
                                    @placeholder = "VDA Amount"
                           })

                            </td>



                        </tr>

                    }
                }




            </tbody>
        </table>
    </div>