<script src="~/js/tooltip.js"></script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table  Loan-Closure-List ">
    @Html.HiddenFor(m => m.LoanIssuesList.Count)
    <table id="loanClosureTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>

                <th scope="col">Loan Type</th>
                <th scope="col" data-bs-toggle="tooltip"
                    data-bs-original-title="Loan Balance">Loan Bal.</th>
                <th scope="col">Monthly EMI</th>
                <th scope="col">Employee Staus</th>
                <th scope="col">Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.LoanIssuesList != null && Model.LoanIssuesList.Count > 0)
            {

                for (int i = 0; i < Model.LoanIssuesList.Count; i++)
                {
                    <tr>
                        <td data-label="SL:NO">
                            @Html.HiddenFor(m => m.LoanIssuesList[i].EmployeeGI)
                            @Html.HiddenFor(m => m.LoanIssuesList[i].LoanIssueGI)
                            @Model.LoanIssuesList[i].EmployeeID
                        </td>
                        <td data-label="Candidate Name">
                            @Model.LoanIssuesList[i].EmployeeName
                        </td>
                        <td data-label="Designation">@Model.LoanIssuesList[i].Designation.Name</td>
                        <td data-label="Department">@Model.LoanIssuesList[i].Department.Name</td>
                        <td data-label="Location">@Model.LoanIssuesList[i].Location.Name</td>
                        <!-- <td data-label="Evaluation Period">Evaluation A</td> -->
                        <td data-label="Loan Type">@Model.LoanIssuesList[i].LoanType</td>
                        <td data-label="Loan Balance">@Model.LoanIssuesList[i].LoanBalance</td>
                        <td data-label="Monthly EMI">@Model.LoanIssuesList[i].MonthlyEMI</td>
                        <td data-label="Monthly EMI">@Model.LoanIssuesList[i].EmployeeStatus</td>
                        <td data-label="Action">
                            <a data-bs-toggle="tooltip" title="Edit"
                               id="AppraisalView " type="button"
                               class="btn btn-icon btn-edit icon-only " onclick="onEditClick('@Model.LoanIssuesList[i].EmployeeGI','@Model.LoanIssuesList[i].LoanIssueGI')">
                                <i class="icon-xl fas fa-pencil-alt"></i>
                            </a>
                        </td>
                    </tr>
                }
            }


        </tbody>
     
            <tr style=" position: sticky; bottom: 0;" class="table-light">


                <td data-label="No of days">
                    <strong>
                        Total
                        <span></span>
                    </strong>
                </td>


                <td data-label="No of days">
                    <strong></strong>
                </td>

                <td data-label="No of days">
                    <strong></strong>
                </td>


                <td data-label="No of days">
                  
                </td>
                <td data-label="No of days">
                   
                </td>
                <td data-label="No of days">
                  
                </td>
                <td data-label="No of days">
                    <strong>
                        <span>@Model.TotalBalanceAmount</span>
                    </strong>
                </td>
                <td data-label="No of days">
                    <strong>
                        <span>@Model.TotalMonthlyEMI</span>
                    </strong>
                </td>
                <td data-label="No of days">
                   
                </td>
                <td data-label="No of days">
                    
                </td>
              
            </tr>

   

    </table>
    <div id="editLoanClosure">

    </div>
</div>