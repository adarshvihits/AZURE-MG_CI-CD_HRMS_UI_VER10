@model Hrms.Lite.Shared.PayRoll.LoanIssue
<script src="~/js/settings.js"></script>

    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table Loan-Processing-list">
        @Html.HiddenFor(m => m.LoanIssuesList.Count)
        <table id="AllTableee" class="common-table">
            <thead>
                <tr class="table-dark">
                    <th scope="col">ID</th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">Loan Amount</th>
                    <th scope="col">EMI</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.LoanIssuesList != null && Model.LoanIssuesList.Count > 0)
                {
                    for (int i = 0; i < Model.LoanIssuesList.Count; i++)
                    {       
                <tr>
                    <td data-label="ID">@Model.LoanIssuesList[i].EmployeeID</td>
                    <td data-label="Employee Name">@Model.LoanIssuesList[i].Name</td>
                    <td data-label="Loan Amount">@Model.LoanIssuesList[i].Amount</td>
                    <td data-label="EMI">@Model.LoanIssuesList[i].EMI</td>
                </tr>
                    }
                }
            </tbody>
        </table>
    </div>