@model Hrms.Lite.Shared.PayRoll.LoanIssue
<script src="~/js/tooltip.js"></script>



<div id="editloanissue" class="slider-forms slider-forms-open EditLoanIssueSlider">
    <div class="slider-inner-style">
        <div class="slider-form-close mb-4" onclick="CloseSlider('EditLoanIssueSlider')">

            <i class="ki ki-close icon-xs text-muted"></i>
        </div>
        <h4>Loan Processing</h4>
        <div class="profile-header position-relative pb-12 mb-5"
             style="padding-bottom: 2px !important; padding-top: 5px !important;">
            <div class="row">
                @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeSliderHeader.cshtml", Model.EmployeeHeader)
            </div>
            <div class="profile-header-overflow"></div>
        </div>


        <div class="row">
            <div class="col-md-12">
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Loan
                                Type
                            </label>
                            <div class="view-details">
                                @Model.LoanType

                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Purpose</label>
                            <div class="view-details">
                                @ViewBag.Pourpose

                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Repayment
                                Method
                            </label>
                            <div class="view-details">
                                @ViewBag.RepaymentMethod

                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Loan Amount
                            </label>
                            <div class="view-details">
                                @Model.LoanAmount

                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Monthly
                                EMI
                            </label>
                            <div class="view-details">
                                @ViewBag.MonthlyEMI
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">Tenure</label>
                            <div class="view-details">
                                @ViewBag.Tenure
                            </div>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Disbursement
                                Date
                            </label>
                            <div class="view-details">
                                @ViewBag.DisbursementDate
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="row-outer">
                            <label class="view-title">
                                Repayment
                                Start Month
                            </label>
                            <div class="view-details">
                                @ViewBag.RepaymentStartMonth
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12">
                        <div class="row-outer">
                            <label class="view-title">
                                Remarks
                            </label>
                            <div class="view-details">
                                @ViewBag.Remarks
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <label >
                            IOM Letter :
                        </label>
                        <a data-bs-toggle="tooltip" title="" type="button" class="btn   icon-only" data-bs-original-title="Download"onclick="GetEmpProfilePrint(@Model.RequestCode)"><i class="fa fa-download" aria-hidden="true" style=" font-size: 22px !important; color: #01877c;"></i></a>
                      
                    </div>

                </div>
            </div>
        </div>



        <div class="ihits-table table-border hover-color odd-even mobile-responsive-table loan-History-Table">

            <table id="" class="">
                <thead>
                    <tr class="table-light">
                        <th scope="col">Type</th>
                        <th scope="col">Amount</th>
                        <th scope="col">Disbursement Date</th>

                    </tr>
                </thead>
                <tbody>
                    @if (Model.info != null && Model.info.Count > 0)
                    {

                        for (int i = 0; i < Model.info.Count; i++)
                        {
                            <tr>
                                <td>@Model.info[i].Type</td>
                                <td data-label="Name">
                                    @Model.info[i].Amount
                                </td>
                                <td data-label="Designation">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.info[i].DisbursementDate))</td>

                            </tr>
                        }
                    }



                </tbody>
            </table>
        </div>






    </div>
</div>



