        </div>*@
                                    <div class="row card-footer-bottom-fixed">
                                        <div class="col-md-12 align-right">
                                            <div class="col-md-12">
                                                <button type="button" class="btn btn-default " onclick="validateLoanIssue()">Save</button>
                                            </div>

                                            </div>
                                        </div>

                                        <div id="LoanIssueLogDetailsSlider">
                                            @*@await Html.PartialAsync("_LoanIssueLogDetails", Model)*@
                                        </div>

                                        @await Html.PartialAsync("_LoanIssueLogList", Model)

                                    </div>
                                </div>
                                <!--end::Row-->
                                <!--begin::Row-->
                                <!--end::Row-->
                                <!--end::Dashboard-->
                            </div>
                            <!--end::Container-->
                        </div>
                        <!--end::Entry-->
                    </div> <!--end::Content-->
}