@model Hrms.Lite.Shared.PayRoll.LoanIssue
    <script src="~/js/tooltip.js"></script>
<div id="EditLoanIssueLogDetails" class="slider-forms slider-forms-open loanIssueLogHistory">
    <div class="slider-inner-style">
        <div class="slider-form-close" onclick="CloseSlider('loanIssueLogHistory')"><i class="ki ki-close icon-xs text-muted"></i></div>

        <h4>Loan Processing Log</h4>
        <div class="row">
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Loan Type</label>
                    <div class="view-details">
                        @Model.LoanIssueDetails.LoanType.Name
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Purpose</label>
                    <div class="view-details">
                        @Model.LoanIssueDetails.Pourpose
                    </div>
                </div>
            </div>

        </div>
        <div class="row">

            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Repayment Method</label>
                    <div class="view-details">
                        @Model.LoanIssueDetails.RepaymentMethod.Name
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Loan Amount</label>
                    <div class="view-details">
                        @Model.LoanIssueDetails.LoanAmount
                    </div>
                </div>
            </div>

        </div>

        <div class="row">
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Monthly EMI</label>
                    <div class="view-details">
                        @Model.LoanIssueDetails.MonthlyEMI
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Tenure</label>
                    <div class="view-details">
                        @Model.LoanIssueDetails.Tenure
                    </div>
                </div>
            </div>

        </div>


        <div class="row">

            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Disbursement Date</label>
                    <div class="view-details">
                        @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.LoanIssueDetails.DisbursementDate))
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Repayment Start Month</label>
                    <div class="view-details">
                        @Model.LoanIssueDetails.PaymentStartMonth.Name

                    </div>
                </div>
            </div>

        </div>
        <div class="row">

            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Balance </label>
                    <div class="view-details">
                        @Model.LoanIssueDetails.Balance

                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Status </label>
                    <div class="view-details">
                        @Model.LoanIssueDetails.Status
                    </div>
                </div>
            </div>

        </div>
        <div class="row">

            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Remarks </label>
                    <div class="view-details">
                        @Model.LoanIssueDetails.Remarks

                    </div>
                </div>
            </div>
            

        </div>
    </div>
</div>

