@model Hrms.Lite.Shared.PayRoll.LoanConfirmation

<script src="~/js/bootstrap-datepicker.js"></script>

<script src="~/js/tooltip.js"></script>

@using (Html.BeginForm(null,null, FormMethod.Post, new { @id="loanConfirmationSave"}))
{
<div id="AppraisalView" class="slider-forms slider-forms-open closureEdit">
    <div class="slider-inner-style">
        <div class="slider-form-close">
            <i class="ki ki-close icon-xs text-muted" onclick="CloseSlider('closureEdit')"></i>
        </div>
        <h4>Loan Confirmation</h4>
        <div class="profile-header position-relative pb-12 mb-5" style="padding-bottom: 2px !important; padding-top: 5px !important;">
            <div class="row">
                @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeSliderHeader.cshtml", Model.EmployeeHeader)
            </div>
            <div class="profile-header-overflow"></div>
        </div>
        <div class="row">
            <!-- <div class="col-md-4">
                <div class="row-outer">
                    <label class="view-title">Evaluation Period</label>
                    <div class="view-details">
                        Demo</div>
                </div>
            </div> -->
            @Html.HiddenFor(m => m.EmployeeGI)
            @Html.HiddenFor(m => m.LoanIssueGI)
             @Html.HiddenFor(m => m.LoanIssueCode)
             @Html.HiddenFor(m => m.LoanSettingsCode)
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">
                        Loan Type
                    </label>
                    <div class="view-details">
                        @Model.LoanName
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">Monthly EMI</label>
                    <div class="view-details">
                        @Model.MthlyEMI
                    </div>
                </div>
            </div>


        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="row-outer">
                    <label class="view-title">
                        Total Tenure
                    </label>
                    <div class="view-details">
                        @Model.BalanceTenure
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group">
                    <label>Confirmed Amount</label>
                    @Html.TextBoxFor(m => m.ConfAmount, new { @class = "form-control form-control-sm", @maxlength = 8, @placeholder = "Confirmed Amount", @onkeypress = "return onlyNumberKey(event)" })
                </div>
            </div>





        </div>


        <div class="row">




            <div class="col-md-12">
                <label>Remarks</label>
                @Html.TextAreaFor(m => m.Remarks, new { @class = "form-control form-control-sm", @placeholder = "Remarks" })
            </div>

        </div>
        <div class="row card-footer-bottom-fixed border-none">
            <div class="col-md-12 align-right">
                <a data-bs-toggle="tooltip" data-bs-original-title="Delete" id="deleteEmpbtn" class="btn btn-icon btn-delete big-btn float-none"  onclick="onListWiseEditClick('DELETE','Delete')">
                    <i class="icon-xl far fa-trash-alt"></i>
                </a>
                <a type="button" class="btn btn-default  mobile-full-width" onclick="onListWiseEditClick('Create','Save')">
                    Save
                </a>
            </div>

            </div>


       
</div>
</div>
}
