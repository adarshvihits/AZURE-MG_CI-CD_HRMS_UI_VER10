@model Hrms.Lite.Shared.PayRoll.PTSettings
    @*<script src="~/js/settings.js"></script>*@
@using (Html.BeginForm(null,null, FormMethod.Post))
{

    <div class="ihits-table table-border mobile-responsive-table mb-5 pt-settings-popup vertical-scroll-300" style="padding:10px;">
        <table id="PTAllowanceTable" class="">
            <thead>
                <tr class="table-light">

                    <th scope="col">Allowance</th>

                    <th scope="col">Y/N</th>
                </tr>
            </thead>
            <tbody>

                @if (Model != null && Model.Allowance != null && Model.Allowance.Count > 0)
                {

                    for (int i = 0; i < Model.Allowance.Count; i++)
                    {
                <tr>
                    <td data-label="">@Html.DisplayFor(Model => Model.Allowance[i].Allowance)</td>
                    @Html.HiddenFor(m => m.Allowance[i].Allowance)
                    @Html.HiddenFor(m => m.Allowance[i].AllowanceCode)
                    @Html.HiddenFor(m => m.PTGroup.Code)
                    <td data-label="">
                        <div class="checkbox-inline">
                            <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary ">
                                @Html.CheckBoxFor(Model => Model.Allowance[i].Applicability)
                                <span></span>
                            </label>

                        </div>


                    </td>

                </tr>








                    }
                }




            </tbody>
        </table>
    </div>

    <div style="margin-top: 10px;">

        <div class="col-md-12 align-right pb-2">

            <button type="button" class="btn btn-default  mobile-full-width" onclick="PTSettingsAllowanceSave()">
                Save
            </button>
        </div>


    </div>
}