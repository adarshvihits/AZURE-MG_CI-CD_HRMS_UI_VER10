@model Hrms.Lite.Shared.PayRoll.PTSettings
<script src="~/scripts/PayRoll/PTSettings.js"></script>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
@using (Html.BeginForm(null, null, FormMethod.Post))
{

    <div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
        <!--begin::Header-->
        <div id="kt_header" class="header header-fixed">
            <!--begin::Container-->
            <div class="container-fluid d-flex align-items-stretch justify-content-between">
                <!--begin::Header Menu Wrapper-->
                <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                    <!--begin::Header Menu-->
                    <div class="d-flex align-items-baseline flex-wrap mr-5">
                        <h3 class="main-title">
                            PT Settings
                        </h3>
                        <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                            <li class="breadcrumb-item ">
                                <a href="@Url.Action("Index", "Home", new { Area = "" })"> <i class="icon-nm fas fa-home"></i></a>
                            </li>
                            <!-- <li class="breadcrumb-item text-muted">
                                <a href="financial-year.html">Financial Year List</a>
                              </li> -->
                            <li class="breadcrumb-item text-muted">
                                PT Settings

                            </li>

                        </ul>
                    </div>
                </div>
                <!--end::Header Menu Wrapper-->
                <!--begin::Topbar-->
                <!--end::Topbar-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Header-->
        <!--begin::Content-->


        <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
            <!--begin::Entry-->
            <div class="d-flex flex-column-fluid">
                <!--begin::Container-->
                <div class="container full-width">
                    <!--begin::Dashboard-->
                    <!--begin::Row-->

                    <div class="row height-100per">

                        <div class="col-md-12">
                            <div class="card card-custom height-100per">

                                <div class="card-body">

                                    <div class="row tab-style-button pb-3">
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                @*<label>PT Group </label>*@
                                                @*@Html.HiddenFor(Model => Model.PTGroup.Code)*@
                                                @Html.DropDownListFor(Model => Model.PTGroup.Code, (SelectList)ViewBag.PTGroup, "--Select PT Group--", new { @class = "form-control form-control-sm ", @onblur = "validate(this,'PTGrp')", @onchange = "GetPTSettingsGrid()"})
                                                <span id="PTGrp"></span>
                                            </div>
                                        </div>
                                    </div>

                                    <div id="GridID">
                                        @await Html.PartialAsync("_PTSettingsList", Model)
                                    </div>
                                    <div class="row card-footer-bottom-fixed align-right">

                                        <div class="col-md-6 align-right">



                                            <div class="d-flex">
                                                <a data-bs-toggle="modal" data-target=".ESI_settings_applicable"  onclick="OnApplicableAllowanceClick()">
                                                    <div class="application-btn d-flex align-items-center">
                                                        <div class="history-btn">
                                                            <img src="~/images/add-category-icon (1).png" />

                                                        </div>
                                                        <div class="application-icon"> <h3 class="pt-2 pl-3"> Applicable Allowance</h3></div>
                                                    </div>
                                                </a>
                                            </div>



                                            @*<button data-bs-toggle="modal" data-target=".ESI_settings_applicable" type="button"
                    class="btn btn-default  mobile-full-width mr-3" onclick="OnApplicableAllowanceClick()">
                Applicable Allowance
            </button>*@

                                        </div>
                                        
                                            <div class="col-md-6 align-right">

                                                <button class="btn btn-default  mobile-full-width" type="button" onclick="applicableAllowanceCountCheck(1)">
                                                    Save
                                                </button>
                                            </div>
                                       

                                    </div>


                                    <div class="modal fade ESI_settings_applicable" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div id="myDiv" class="modal-content popup">
                                                <div class="modal-header" style="padding:10px">
                                                    <h5 class="modal-title" id="exampleModalLabel">PT Settings Applicable Allowance</h5>
                                                    <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                                                        <i aria-hidden="true" class="ki ki-close"></i>
                                                    </button>
                                                </div>

                                                <div class="modal-body">

                                                </div>

                                            </div>

                                        </div>
                                    </div>






                                    



                                    <!-- <end table></end> -->

                                </div>
                                @*<div id="PopUpID">

                                    </div>*@
                            </div>
                        </div>
                    </div>




                    <!--end::Row-->
                    <!--begin::Row-->
                    <!--end::Row-->
                    <!--end::Dashboard-->
                </div>
                <!--end::Container-->
            </div>
            <!--end::Entry-->
        </div>
        <!--end::Content-->


    </div>


}

