@model Hrms.Lite.Shared.PayRoll.EmployeeRequestLoanIssue
<script src="~/js/settings.js"></script>
<script src="~/js/tooltip.js"></script>


<style>

    /*salary_advance_issuetrn*/

    .emp_request_loan_issuetrn table thead tr th:nth-child(1),
    .emp_request_loan_issuetrn table tbody tr td:nth-child(1) {
        width: 10% !important;
    }

    .emp_request_loan_issuetrn table thead tr th:nth-child(2),
    .emp_request_loan_issuetrn table tbody tr td:nth-child(2) {
        width: 15% !important;
    }

    .emp_request_loan_issuetrn table thead tr th:nth-child(3),
    .emp_request_loan_issuetrn table tbody tr td:nth-child(3) {
        width: 10% !important;
    }

    .emp_request_loan_issuetrn table thead tr th:nth-child(4),
    .emp_request_loan_issuetrn table tbody tr td:nth-child(4) {
        width: 10% !important;
    }

    .emp_request_loan_issuetrn table thead tr th:nth-child(5),
    .emp_request_loan_issuetrn table tbody tr td:nth-child(5) {
        width: 8% !important;
    }

    .emp_request_loan_issuetrn table thead tr th:nth-child(6),
    .emp_request_loan_issuetrn table tbody tr td:nth-child(6) {
        width: 8% !important;
        text-align: end;
    }

    .emp_request_loan_issuetrn table thead tr th:nth-child(7),
    .emp_request_loan_issuetrn table tbody tr td:nth-child(7) {
        width: 7% !important;
        text-align: end;
    }

    .emp_request_loan_issuetrn table thead tr th:nth-child(8),
    .emp_request_loan_issuetrn table tbody tr td:nth-child(8) {
        width: 7% !important;
        text-align: end;
    }

    .emp_request_loan_issuetrn table thead tr th:nth-child(9),
    .emp_request_loan_issuetrn table tbody tr td:nth-child(9) {
        width: 10% !important;
    }

    .emp_request_loan_issuetrn table thead tr th:nth-child(10),
    .emp_request_loan_issuetrn table tbody tr td:nth-child(10) {
        width: 15% !important;
    }

</style>



<div class="ihits-table table-border odd-even  mobile-responsive-table emp_request_loan_issuetrn">
    @Html.HiddenFor(m => m.LoanIssueList.Count)
    <table id="SalaryAdvanceIssueTrnHistoryTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation </th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">Gross Salary</th>
                <th scope="col" data-bs-toggle="tooltip" title="Requested Amount">Req. Amt</th>
                <th scope="col" data-bs-toggle="tooltip" title="Confirmed Amount">Conf. Amt</th>
                <th scope="col">Remarks</th>
                <th scope="col">Issued By</th>


            </tr>
        </thead>
        <tbody>

            @if (Model.LoanIssueList != null && Model.LoanIssueList.Count > 0)
            {

                for (int i = 0; i < Model.LoanIssueList.Count; i++)
                {


                    <tr>
                        <td data-label="ID">
                            @Model.LoanIssueList[i].EmployeeID
                        </td>
                        <td data-label="Name"> @Model.LoanIssueList[i].EmployeeName </td>
                        <td data-label="Designation">@Model.LoanIssueList[i].Designation</td>
                        <td data-label="Department">@Model.LoanIssueList[i].Department</td>
                        <td data-label="Location">@Model.LoanIssueList[i].Location</td>
                        <td data-label="Gross Salary">@Model.LoanIssueList[i].GrossSalary</td>
                        <td data-label="Requested Amount">                 
                                @Model.LoanIssueList[i].LoanAmount                           
                        </td>
                        <td data-label="Confirmed Amount">
                            @Model.LoanIssueList[i].ConfirmedAmnt
                        </td>
                        <td data-label="Remarks">                   
                                @Model.LoanIssueList[i].Remarks                                                  
                        </td>

                        <td data-label="Issued By">
                            @Model.LoanIssueList[i].IssuedBy
                        </td>
                    </tr>



                }
            }

        </tbody>
    </table>
</div>