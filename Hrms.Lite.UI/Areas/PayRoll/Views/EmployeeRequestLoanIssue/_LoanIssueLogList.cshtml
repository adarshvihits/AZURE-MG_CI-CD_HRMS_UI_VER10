@model Hrms.Lite.Shared.PayRoll.LoanIssue
<script src="~/js/tooltip.js"></script>
<script src="~/scripts/PayRoll/loanIssue.js"></script>

<h6 class="main-title mb-3 mt-5 mr-0">Loan Processing Log</h6>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table vertical-scroll-200 loanissuetype-log-details">
    <table>
        <thead>
            <tr class="table-dark">
                <th @*data-bs-toggle="tooltip"*@ data-bs-original-title="SlNo" scope="col">
                    SlNo
                </th>
                <th @*data-bs-toggle="tooltip"*@ data-bs-original-title=" Loan Type">
                    Loan Type
                </th>
                <th @*data-bs-toggle="tooltip"*@ data-bs-original-title="Purpose" scope="col">
                    Purpose
                </th>
                <th @*data-bs-toggle="tooltip"*@ data-bs-original-title="Repayment Method"
                    scope="col">
                    Repayment Method
                </th>
                <th @*data-bs-toggle="tooltip"*@ data-bs-original-title="Monthly EMI"
                    scope="col">
                    Monthly EMI
                </th>
                <th @*data-bs-toggle="tooltip"*@ data-bs-original-title=" Tenure" scope="col">
                    Tenure
                </th>
                <th @*data-bs-toggle="tooltip"*@ data-bs-original-title="Loan Amount" scope="col">
                    Loan Amount
                </th>
                <th @*data-bs-toggle="tooltip"*@ data-bs-original-title="Balance"
                    scope="col">
                    Balance
                </th>
                <th @*data-bs-toggle="tooltip"*@ data-bs-original-title="Status"
                    scope="col">
                    Status
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model.LoanIssueLogList != null && Model.LoanIssueLogList.Count > 0)
            {
                for (int i = 0; i < Model.LoanIssueLogList.Count; i++)
                {
                    <tr>
                        <td data-label="SlNo"> @Model.LoanIssueLogList[i].SlNo</td>
                        <td data-label="Loan Type">
                            @*<a id="EditLoanIssueLogDetails" class="slider-btn" onclick="onLoanIssueLogClick('@Model.LoanIssueLogList[i].LoanIssueGI)">@Model.LoanIssueLogList[i].LoanType</a>*@
                            @*<a id="EditLoanIssueLogDetails" class="slider-btn" onclick="onLogClick('@Model.LoanIssueLogList[i].LoanIssueGI')">@Model.LoanIssueLogList[i].LoanType</a>*@
                            <a id="EditLoanIssueLogDetails" class="slider-btn" onclick="onLogClick('@Model.LoanIssueLogList[i].LoanIssueGI')">@Model.LoanIssueLogList[i].LoanType</a>

                        </td>
                        <td data-label="Purpose">@Model.LoanIssueLogList[i].Pourpose</td>
                        <td data-label="Repayment Method">@Model.LoanIssueLogList[i].RepaymentMethod</td>
                        <td data-label="Monthly EMI">@Model.LoanIssueLogList[i].MonthlyEMI</td>
                        <td data-label="Tenure">@Model.LoanIssueLogList[i].Tenure</td>
                        <td data-label="Loan Amount">@Model.LoanIssueLogList[i].LoanAmount</td>
                        <td data-label="Balance">@Model.LoanIssueLogList[i].Balance</td>
                        <td data-label="Status">@Model.LoanIssueLogList[i].Status</td>





                    </tr>
                }
            }
            else
            {
                <tr><td colspan="5"> No Data Found</td></tr>
            }
        </tbody>
      
    </table>
</div>