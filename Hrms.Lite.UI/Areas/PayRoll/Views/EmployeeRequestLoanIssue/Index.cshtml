@model Hrms.Lite.Shared.PayRoll.EmployeeRequestLoanIssue
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/PayRoll/EmployeeRequestLoanIssue.js" asp-append-version="true"></script>


