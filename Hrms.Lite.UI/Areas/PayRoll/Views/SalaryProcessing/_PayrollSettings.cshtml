@model Hrms.Lite.Shared.PayRoll.SalaryProcessing
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body">

                            <div class="step-outer pb-10 step_row">
                                <div class="step-item active" onclick="onTabNameClick('Selection')">
                                    Selection
                                    <span class="step-circle"></span>
                                </div>
                                <div class="step-item active" onclick="onTabNameClick('Hr')">
                                    HR & Time Office
                                    <span class="step-circle"></span>
                                </div>
                                <div class="step-item active" onclick="onTabNameClick('statutory')">
                                    Statutory
                                    <span class="step-circle"></span>
                                </div>
                                <div class="step-item active">
                                    Payroll Settings
                                    <span class="step-circle"></span>
                                </div>
                                <div class="step-item">
                                    Payroll Transaction
                                    <span class="step-circle"></span>
                                </div>


                            </div>

                            <div class="page_white" style="padding: 10px 23px 10px; margin-bottom: 17px; ">

                                <div class="row my-2">
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label class="view-title">Payroll Group </label>
                                            <div class="view-details">
                                                @Model.PayrollGroup.Name
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="form-group">
                                            <label class="view-title">Month </label>
                                            <div class="view-details">
                                                @Model.PayrollMonth.Name
                                            </div>
                                        </div>
                                    </div>


                                </div>
                            </div>
                            <div class="ihits-table table-border  mobile-responsive-table salary-payroll-list vertical-scroll-200">
                                <table>
                                    <thead>
                                        <tr class="table-dark">
                                            <th scope="col">Payroll Settings</th>
                                            <th scope="col">Count</th>

                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.Payroll_Settings != null && Model.Payroll_Settings.Count > 0)
                                        {

                                            for (int i = 0; i < Model.Payroll_Settings.Count; i++)
                                            {

                                        <tr>
                                            <td data-label="Payroll Settings">@Model.Payroll_Settings[i].Description </td>
                                            @*<td data-label="Count">@Model.Payroll_Settings[i].Count</td>*@
                                            <td data-label="Count" data-bs-toggle="modal" data-target=".bd-example-modal-lg-settings">
                                                <a onclick="getPopUp('@Model.Payroll_Settings[i].Code', '@Model.Payroll_Settings[i].Description','PAYROLL_SETTINGS')">@Model.Payroll_Settings[i].Count</a>




                                            </td>
                                        </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <!-- <end table></end> -->
                            <div class="row card-footer-bottom-fixed">
                                <div class="col-md-12 align-right">
                                    <a href="#" type="button"
                                       class="btn btn-default float-right mobile-full-width" onclick="onNextClick('settings')">
                                        Next
                                    </a>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>
            </div>




            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>


