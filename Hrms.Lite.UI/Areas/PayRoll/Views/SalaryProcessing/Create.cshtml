@model Hrms.Lite.Shared.PayRoll.SalaryProcessing
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/scripts/PayRoll/salaryProcessing.js"></script>
<script src="~/js/jquery.min.js"></script>

@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "sal_save" }))
{
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->
            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">
                        Monthly Salary Processing
                    </h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index","Home",new { Area=""})"><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            Monthly Salary Processing
                        </li>

                    </ul>
                </div>
            </div>
            <!--end::Header Menu Wrapper-->

        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->
    <div id="sal_selection">
        @await Html.PartialAsync("_Selection")
    </div>
    <div id="sal_CommonList">
        @await Html.PartialAsync("_CommonDetails")

    </div>

    <!--end::Content-->

    <div class="modal fade bd-example-modal-lg" tabindex="-1"
         role="dialog" aria-labelledby="myLargeModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-lg" style=" max-width: 1051px; height:400px;">
            <div id="myDiv" class="modal-content popup">
                <div class="modal-header" style="padding:10px">
                    <h5 class="modal-title" id="salProcessPopup">
                     
                    </h5>
                    <button type="button" class="close"
                            data-bs-dismiss="modal" aria-label="Close">
                        <i aria-hidden="true"
                           class="ki ki-close"></i>
                    </button>
                </div>

                <div class="modal-body">

                </div>



            </div>
        </div>
    </div>
}
