@model Hrms.Lite.Shared.PayRoll.SalaryProcessing
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body">

                            <div class="step-outer pb-10 step_row">
                                <div class="step-item active">
                                    Selection
                                    <span class="step-circle"></span>
                                </div>
                                <div class="step-item ">
                                    HR & Time Office
                                    <span class="step-circle"></span>
                                </div>
                                <div class="step-item">
                                    Statutory
                                    <span class="step-circle"></span>
                                </div>
                                <div class="step-item">
                                    Payroll Settings
                                    <span class="step-circle"></span>
                                </div>
                                <div class="step-item">
                                    Payroll Transaction
                                    <span class="step-circle"></span>
                                </div>
                               

                            </div>
                            @*<div class="step-progress-outer">
                                <div class="step-left">*@
                        <div class="page_white">

                            <div class="row my-2">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Payroll Group</label>
                                        @Html.DropDownListFor(Model => Model.PayrollGroup.Code, (SelectList)ViewBag.PayrollGroup, "--Select--", new { @class = "form-control form-control-sm payroll", @onchange = "validate(this,'payrollgp');fillMonth(this)" })
                                        <span id="payrollgp"></span>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label>Month</label>
                                        @Html.DropDownListFor(Model => Model.PayrollMonth.Code, (SelectList)ViewBag.month, "--Select--", new { @class = "form-control form-control-sm month", @onchange = "validate(this,'month')" })
                                        <span id="month"></span>
                                    </div>
                                </div>

                                <div class="col-md-2  align-items-center d-flex justify-content-center">
                                    <a href="#" type="button"
                                       class="btn btn-default float-right mobile-full-width mt-5" onclick="onProceedClick()">
                                        Proceed
                                    </a>
                                </div>
                            </div>



                            <div class="row my-2">
                               

                            </div>


                        </div>
                                @*</div>

                            </div>*@



                            <!-- <end table></end> -->

                        </div>

                    </div>
                </div>
            </div>




            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>