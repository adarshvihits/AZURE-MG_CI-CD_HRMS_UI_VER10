

@model Hrms.Lite.Shared.PayRoll.SalaryProcessing

    <script src="~/js/settings.js"></script>
    <script>

        $(".search-slider-inner").click(function () {
            $(".form-control").toggleClass('field-width-big')
        });

    </script>
    <style>
        .dataTables_scrollBody {
            height: 30vh !important;
        }
    </style>
    <div class="row tab-style-button">
        <div class="tab-button-wrap align-items-center">





            <div class="tab-items">

            </div>



            <div class="tab-items select-option high">

                @*<div class="sraech-slider">



            <div class="search-slider-inner">
                <i class="fa fa-search" onclick="$('#searchList').focus();"></i>
            </div>
            <input id="searchList" type="text" class="form-control form-control-sm"
                   placeholder="ID/Name" onkeyup="EmployeeSearch('PayRollTrnTable1')">
        </div>*@



                <div class="sraech-slider">
                    <div class="search-slider-inner">
                        <i class="fa fa-search"></i>
                    </div>
                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                           placeholder="ID/Name">
                </div>
                <a data-bs-toggle="tooltip" title=""
                   class="btn btn-excel"
                   data-bs-original-title="Export to Excel" onclick="ExportToExcelPopUp()">
                    <i class="icon-xl far fa-file-excel"></i>
                </a>

            </div>


        </div>
    </div>




    <div style="padding:10px;" class="ihits-table table-border hover-color odd-even mobile-responsive-table  ">
        @Html.HiddenFor(Model => Model.SalaryProcessing_popup.Count)
        <table id="PayRollTrnTable1" class="common-table">
            <thead>
                <tr class="table-dark">
                    <th scope="col">ID</th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">Designation</th>
                    <th scope="col">Department</th>
                    <th scope="col">Location</th>






                </tr>
            </thead>
            @if (Model != null && Model.SalaryProcessing_popup != null && Model.SalaryProcessing_popup.Count > 0)
            {
                for (int i = 0; i < Model.SalaryProcessing_popup.Count; i++)
                {
                    <tr>
                        <td data-label="ID">
                            @Model.SalaryProcessing_popup[i].ID
                        </td>
                        <td data-label="Employee Name">
                            @Model.SalaryProcessing_popup[i].Name

                        </td>
                        <td data-label="Designation">@Model.SalaryProcessing_popup[i].Designation</td>
                        <td data-label="Department">
                            @Model.SalaryProcessing_popup[i].Department
                        </td>
                        <td data-label="Location">@Model.SalaryProcessing_popup[i].Location</td>


                    </tr>

                }
            }



        </table>
    </div>
