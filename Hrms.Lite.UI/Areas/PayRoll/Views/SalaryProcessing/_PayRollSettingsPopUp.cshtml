

@model Hrms.Lite.Shared.PayRoll.SalaryProcessing
<script src="~/js/settings.js"></script>
<script>

    $(".search-slider-inner").click(function () {
        $(".form-control").toggleClass('field-width-big')
    });

</script>
<style>
    .dataTables_scrollBody {
        height: 30vh !important;
    }
</style>
<div class="row tab-style-button">
    <div class="tab-button-wrap align-items-center">





        <div class="tab-items">

        </div>



        <div class="tab-items select-option high">


            <div class="sraech-slider">
                <div class="search-slider-inner">
                    <i class="fa fa-search"></i>
                </div>
                <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                       placeholder="ID/Name">
            </div>

            @*<div class="sraech-slider">



            <div class="search-slider-inner">
                <i class="fa fa-search" onclick="$('#searchList').focus();"></i>
            </div>
            <input id="searchList" type="text" class="form-control form-control-sm"
                   placeholder="ID/Name" onkeyup="EmployeeSearch('PayrollSettingsTable')">
        </div>*@
            <a data-bs-toggle="tooltip" title=""
               class="btn btn-excel"
               data-bs-original-title="Export to Excel" onclick="ExportToExcelPopUp()">
                <i class="icon-xl far fa-file-excel"></i>
            </a>

        </div>


    </div>
</div>




<div style="padding:10px;" class="ihits-table table-border hover-color odd-even mobile-responsive-table  ">
    @Html.HiddenFor(Model => Model.SalaryProcessing_popup.Count)
    <table id="PayrollSettingsTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>


                @if (@ViewBag.RowName == "New to LWF")
                {
                    <th scope="col">DOJ</th>
                }

                @if (@ViewBag.RowName == "PT Varience With Previous Month")
                {
                    <th scope="col">Pre. PFGroup</th>
                    <th scope="col">Curr. PFGroup</th>
                    <th scope="col">Pre. Applicability</th>
                    <th scope="col">Curr. Applcability</th>

                }
                else if (@ViewBag.RowName == "ESI Not Applicable Salary Less Than 21000")
                {
                    <th scope="col" tooltip="">Gross Salary</th>


                }
                else if (@ViewBag.RowName == "ESI Applicable Salary Greater Than 21000")
                {
                    <th scope="col" tooltip="">Gross Salary</th>

                }

                else if (@ViewBag.RowName == "ESI Varience With Previous Month")
                {
                    <th scope="col">Previous ESIGroup</th>
                    <th scope="col">Current ESIGroup</th>
                    <th scope="col">Pre. Applicability</th>
                    <th scope="col">Curr. Applcability</th>

                }





            </tr>
        </thead>
        @if (Model != null && Model.SalaryProcessing_popup != null && Model.SalaryProcessing_popup.Count > 0)
        {
            for (int i = 0; i < Model.SalaryProcessing_popup.Count; i++)
            {
    <tr>
        <td data-label="ID">
            @Model.SalaryProcessing_popup[i].ID
        </td>
        <td data-label="Employee Name">
            @Model.SalaryProcessing_popup[i].Name

        </td>
        <td data-label="Designation">@Model.SalaryProcessing_popup[i].Designation</td>
        <td data-label="Department">
            @Model.SalaryProcessing_popup[i].Department
        </td>
        <td data-label="Location">@Model.SalaryProcessing_popup[i].Location</td>
        @if (@ViewBag.RowName == "New to LWF")
        {
            <td data-label="DOJ">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.SalaryProcessing_popup[i].DOJ))</td>
        }
            @if (@ViewBag.RowName == "PT Varience With Previous Month")
            {
                <td data-label="previous">@Model.SalaryProcessing_popup[i].PrevPayrollGroup</td>
                <td data-label="current">@Model.SalaryProcessing_popup[i].CurrPayrollGroup</td>
                <td data-label="">@Model.SalaryProcessing_popup[i].PrevPFApplicability</td>
                <td data-label="">@Model.SalaryProcessing_popup[i].CurrPFApplicability</td>

            }
            else if (@ViewBag.RowName == "ESI Not Applicable Salary Less Than 21000")
            {
                <td data-label="">@Model.SalaryProcessing_popup[i].GrossSalary</td>

            }
            else if (@ViewBag.RowName == "ESI Applicable Salary Greater Than 21000")
            {
                <td data-label="">@Model.SalaryProcessing_popup[i].GrossSalary</td>
            }

            else if (@ViewBag.RowName == "ESI Varience With Previous Month")

            {
                <td data-label="previous">@Model.SalaryProcessing_popup[i].OldEsiGroup</td>
                <td data-label="current">@Model.SalaryProcessing_popup[i].NewEsiGroup</td>
                <td data-label="">@Model.SalaryProcessing_popup[i].PrevEsiApplicability</td>
                <td data-label="">@Model.SalaryProcessing_popup[i].CurrEsiApplicability</td>
            }
        </tr>


            }
        }



    </table>
</div>
