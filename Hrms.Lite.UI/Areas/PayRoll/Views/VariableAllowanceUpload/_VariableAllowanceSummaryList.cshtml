@model Hrms.Lite.Shared.PayRoll.VariableAllowance
    <script src="~/js/settings.js"></script>
    <div class="ihits-table table-border odd-even  mobile-responsive-table variable-alw-upload-list">
        @Html.HiddenFor(m => m.VariableAllowanceList.Count)
        <table id="VariableAllowanceUploadTable" class="common-table">
            <thead>
                <tr class="table-dark">
                    <th scope="col">Allowance</th>
                    <th scope="col">Short Name</th>
                    <th scope="col">No.of Employees</th>
                    <th scope="col">Amount</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.VariableAllowanceList != null && Model.VariableAllowanceList.Count > 0)
                {

                    for (int i = 0; i < Model.VariableAllowanceList.Count; i++)
                    {

                        <tr>
                            <td data-label="name">@Model.VariableAllowanceList[i].Allowance.Name</td>
                            <td data-label="shortname">@Model.VariableAllowanceList[i].Allowance.ShortName</td>
                            <td data-label="EmployeesCount">@Model.VariableAllowanceList[i].NoofEmployees</td>
                            <td data-label="aMT">@Model.VariableAllowanceList[i].Amount</td>
                        </tr>
                    }
                }
                else
                {

                }
            </tbody>
        </table>
    </div>