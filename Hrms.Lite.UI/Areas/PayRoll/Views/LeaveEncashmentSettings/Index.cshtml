@model Hrms.Lite.Shared.PayRoll.AllowanceSettings.ApplicableAllowance
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/PayRoll/leaveEncashmentSettings.js"></script>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Leave Encashment Settings</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Leave Encashment Settings
                    </li>

                </ul>
            </div>
        </div>

        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <!--begin: Search Form-->

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">

                            <div class="tab-items ml-5 pr-0 border-none select-option">
                                <div class="form-group filter-combobox mr-10" style="width: 320px;">
                                    @Html.DropDownListFor(model => model.AttendanceStatus.Code, (SelectList)ViewBag.LeaveAllowance, "--Select Leave Encashment Allowance--", new { @class = "form-control form-control-sm", @onchange = "fillData();validate(this,'Allowance')" })
                                    <span id="Allowance" style="bottom: -20px;"></span>
                                </div>

                            </div>

                            <!-- <batch updates></batch> -->
                            <div class="tab-items pr-0 border-none">
                                <div class="button-group float-left  batchleave mr-10">


                                </div>
                            </div>

                            <!-- <batch updates></batch> -->







                            <div class="tab-items select-option">

                                <button id="BatchUpdate" type="button"
                                        class="btn btn-default btn-sm float-left mt-2 mr-5"  onclick="sliderChange()">
                                    Batch Update
                                </button>


                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <button data-bs-toggle="tooltip" title="Export to Excel"
                                        class="btn btn-excel mr-0" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </button>

                            </div>


                        </div>
                    </div>


                    <!-- Table Section -->
                    <div id="LeaveEncashmentList">
                        @await Html.PartialAsync("_LeaveEncashList", Model.ApplicableAllowanceList)
                    </div>
                    <!-- Table Setion End -->

                    <div class="row card-footer-bottom-fixed">

                        <div class="col-md-12 ">



                            <div class="d-flex">
                                <a class="btn-default">
                                    <div class="application-btn d-flex align-items-center">
                                        <div class="history-btn">
                                            <img src="~/images/settings-line-icon.png" />

                                        </div>
                                        <div class="application-icon" onclick="defaultSettingsClick()"> <h3 class="pt-2 pl-3"> Default Settings</h3></div>
                                    </div>
                                </a>

                                <a class="pl-10  btn-default">
                                    <div class="application-btn d-flex align-items-center">
                                        <div class="history-btn">
                                            <img src="~/images/add-category-icon (1).png" />

                                        </div>
                                        <div class="application-icon" onclick="applicableAllowanceClick()"> <h3 class="pt-2 pl-3">  Applicable Allowance</h3></div>
                                    </div>
                                </a>
                            </div>











                            @*<button id="defultsettings" type="button" class="btn btn-default" onclick="defaultSettingsClick()">Default Settings</button>
                        <a id="addApplicableAllowance" type="button"
                           class="btn btn-default mobile-full-width " onclick="applicableAllowanceClick()">
                            Applicable
                            Allowance
                        </a>*@


                        </div>


                    </div>
                    <div id="defaultsettings"></div>

                    <div id="applicableallowance">
                        @*@await Html.PartialAsync("_ApplicableAllowance")*@
                    </div>

                    <div id="FilterPartial">

                    </div>
                    <div id="batchUpdate"></div>







                    <!--end: Datatable-->
                </div>
            </div>
            <div id="filterSlider">
                @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
            </div>

            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
<!--end::Content-->