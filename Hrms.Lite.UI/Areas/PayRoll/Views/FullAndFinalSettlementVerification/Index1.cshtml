                                                                <tr>
                                                                    @Html.HiddenFor(Model => Model.Details.OtherAdditions[i].Code)

                                                                    <td data-label=" Narration"> @Model.Details.OtherAdditions[i].Narration </td>
                                                                    <td data-label="Amount">
