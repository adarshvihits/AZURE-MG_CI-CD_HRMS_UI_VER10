                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label class="view-title">Notice Served Days</label>
                                                <div class="view-details">
                                                    @Model.Details.NoticeServedDays
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label class="view-title">Shortfall Days</label>
                                                <div class="view-details">
                                                    @Model.Details.ShortfallDays
                                                </div>
                                            </div>
                                        </div>




