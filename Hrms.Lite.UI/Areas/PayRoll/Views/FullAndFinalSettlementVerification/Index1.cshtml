                                                                    <strong>937</strong>
                                                                </td>



                                                            </tr>
                                                        </tfoot>*@
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                                <!-- <end table></end> -->



                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label class="view-title">Leave Encashment</label>
                                                <div class="view-details">
                                                    @Model.Details.LeaveEncashment
                                                </div>
                                            </div>
                                        </div>


                                    </div>
                                    <div class="row my-2">

                                        <div class="col-md-3">
                                            <div class="form-group">
                                                <label class="view-title">Gratuity</label>
                                                <div class="view-details">
