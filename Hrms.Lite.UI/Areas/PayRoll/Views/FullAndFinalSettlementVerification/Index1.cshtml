                                    <div class="">
                                        <h4>Resignation Details</h4>
                                    </div>
                                    <div class="row ">

                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label class="view-title">Resignation Date</label>
                                                <div class="view-details">
                                                    @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Details.ResignationDate))
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-2">
                                            <div class="form-group">
                                                <label class="view-title">Last Working Date</label>
                                                <div class="view-details">
