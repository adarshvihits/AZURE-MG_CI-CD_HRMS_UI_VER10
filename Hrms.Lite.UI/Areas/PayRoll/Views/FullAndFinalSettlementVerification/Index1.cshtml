                                            </div>
                                            <div class="ihits-table table-border  mobile-responsive-table full-final-tab new-vertical-scroll-100">
                                                <table>
                                                    <thead>
                                                        <tr class="table-light">
                                                            <th scope="col">Narration</th>

                                                            <th scope="col">Amount</th>

                                                        </tr>
                                                    </thead>
                                                    <tbody>


                                                        @if (Model.Details.OtherDeduction != null && Model.Details.OtherDeduction.Count > 0)
                                                        {
                                                            @for (int i = 0; i < Model.Details.OtherDeduction.Count; i++)
                                                            {
                                                                <tr>
                                                                    @Html.HiddenFor(Model => Model.Details.OtherDeduction[i].Code)

                                                                    <td data-label="Narration"> @Model.Details.OtherDeduction[i].Narration </td>
                                                                    <td data-label="Amount">
