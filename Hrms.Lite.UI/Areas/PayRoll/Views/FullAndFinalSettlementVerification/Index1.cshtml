                                    @Html.HiddenFor(Model => Model.Details.LeaveEncashment)
                                    @Html.HiddenFor(Model => Model.Details.NoticePeriodDeduction)
                                    @Html.HiddenFor(Model => Model.FinalSettlementGI)
                                    @Html.HiddenFor(Model => Model.mode)
