                                    @Html.HiddenFor(Model => Model.Details.ResignationDate)
                                    @Html.HiddenFor(Model => Model.Details.LWD)
                                    @Html.HiddenFor(Model => Model.Details.NoticePeriod)
                                    @Html.HiddenFor(Model => Model.Details.ShortfallDays)
                                    @Html.HiddenFor(Model => Model.Details.RecoverableAmount)
                                    @Html.HiddenFor(Model => Model.Details.SettlementAging)
                                    @Html.HiddenFor(Model => Model.Details.FinalSettlementAmountPayable)
