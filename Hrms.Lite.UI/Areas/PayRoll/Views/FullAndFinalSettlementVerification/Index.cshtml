@model Hrms.Lite.Shared.PayRoll.FullandFinalSettelment
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/scripts/PayRoll/fullAndFinalSettelmentVerification.js"></script>
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->

        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Full & Final Settlement Verification</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>

                    <li class="breadcrumb-item text-muted child-mute">
                        Full & Final Settlement Verification
                    </li>
                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                    <!--begin: Search Form-->
                    <!-- TILE STYLE -->
                    <!-- TILE STYLE -->

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="form-group col-md-2">
                                <label> Month</label>
                                @Html.DropDownListFor(m => m.Month.Code, (SelectList)ViewBag.Month, "--Select--", new
                                {
                               @class = "form-control form-control-sm processMnth",
                               @onblur = "validate(this,'payrollM')",
                               @onchange = "ApplyFilter();"
                           })

                                <span id="payrollM"></span>

                            </div>



                            <div class="tab-items select-option">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm" placeholder="ID/Name">
                                </div>

                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left" data-bs-original-title="Export to Excel" onclick="onExportToExcelClick()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>
                            </div>

                        </div>
                    </div>

                    <div id="EmployeeList">
                        @await Html.PartialAsync("_EmpList", Model)
                    </div>
                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
                    </div>
                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
<!--end::Content-->
