                                                    </label>
                                                    <div class="view-details">
                                                        <h2> <span id="finalAmtInWords"></span></h2>
                                                    </div>
                                                </div>
                                            </div>




                                        </div>
                                    </div>
                                    <hr>
                                    <div class="ptag">
                                        <div class="">
                                            <h4>Full & Final Settlement Done By</h4>
                                        </div>
                                        <div class="row">


                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label class="view-title">Prepared By</label>
                                                    <div class="view-details">
                                                        @Model.Details.CreatedBy
                                                    </div>
                                                </div>

                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label class="view-title">Checked By</label>
                                                    <div class="view-details">
                                                        @Model.Details.CreatedBy
                                                    </div>
                                                </div>

                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label class="view-title">Date & Time</label>
                                                    <div class="view-details">
                                                        @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Details.CreatedOn))
                                                        @*@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Convert.ToDateTime(Model.Details.CreatedOn)))*@
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="form-group">
                                                    <label class="view-title">Entry Comments</label>
                                                    <div class="view-details">
                                                        @Model.Details.Remarks
                                                    </div>
                                                </div>
                                            </div>

                                        </div>
                                        <div class="row my-3">
                                            <div class="col-md-6">
                                                <div class="form-group">
                                                    <label class="">Verification Comments</label><span class="Mandatory">*</span>
                                                    @Html.TextAreaFor(m => m.Details.VarificationComments, new { @class = "form-control form-control-sm", @placeholder = "Description", @maxlength = "120", @onblur = "validate(this,'rmrks')" })
                                                </div>
                                                <span id="rmrks"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- <footer></footer> -->

                                </div>




                                <div class="row card-footer-bottom-fixed">


                                    <div class="col-md-12 align-right">
                                        <a type="button" class="btn btn-default  mobile-full-width" onclick="ProcessAndGetDetails('@Model.Details.EmployeeGI', '@Model.Month.Code')">
                                            process
                                        </a>
                                        <a type="button" class="btn btn-default  mobile-full-width" onclick="confirmVerification()">
                                            Verify
                                        </a>
                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>




        <!--end::Row-->
        <!--begin::Row-->
        <!--end::Row-->
        <!--end::Dashboard-->
    </div>
    <!--end::Container-->
}


