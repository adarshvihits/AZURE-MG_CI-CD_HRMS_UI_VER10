                            EmployeeName: '@Model.Url.EmployeeName',
                            ID: '@Model.Url.ID'

                            @*EmpCode: '@Model.Details.EmployeeCode',
                            UserCode: '@Model.Details.UserCode',

                            ComCode: '@Model.Details.CompanyCode'*@

