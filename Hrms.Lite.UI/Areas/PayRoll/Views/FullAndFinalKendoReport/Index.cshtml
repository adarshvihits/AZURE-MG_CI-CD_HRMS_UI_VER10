                    serviceUrl: "/api/reports/",

                    pageReady: onReady,
                    //ReportSource - report description
                    reportSource: {

                        // The report can be set to a report file name (.trdx or .trdp report definition)
                        // or CLR type name (report class definition).

                       // report: "FullAndFinalSettlement.trdp",

                        report: '@Model.Url.Payslip',


                        parameters: {

                           

                            @*Url: "http://localhost:5001/GetFullAndFinalJSON?EmpCode=" + '@Model.Details.EmployeeCode' + '&UserCode=' + '@Model.Details.UserCode' +'&ComCode='+'@Model.Details.CompanyCode',*@

