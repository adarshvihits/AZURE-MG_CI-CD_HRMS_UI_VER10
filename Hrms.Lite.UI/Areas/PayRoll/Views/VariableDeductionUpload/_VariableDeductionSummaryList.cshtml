@model Hrms.Lite.Shared.PayRoll.VariableDeduction
    <script src="~/js/settings.js"></script>
    <div class="ihits-table table-border odd-even  mobile-responsive-table variable-ded-upload-list">
        @Html.HiddenFor(m => m.VariableDeductionList.Count)
        <table id="VariableDeductionUploadTable" class="common-table">
            <thead>
                <tr class="table-dark">
                    <th scope="col">Deduction</th>
                    <th scope="col">Short Name</th>
                    <th scope="col">No.of Employees</th>
                    <th scope="col">Amount</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.VariableDeductionList != null && Model.VariableDeductionList.Count > 0)
                {

                    for (int i = 0; i < Model.VariableDeductionList.Count; i++)
                    {

                        <tr>
                            <td data-label="Name">@Model.VariableDeductionList[i].Deduction.Name</td>
                            <td data-label="shortname">@Model.VariableDeductionList[i].Deduction.ShortName</td>
                            <td data-label="NoofEmployees">@Model.VariableDeductionList[i].NoofEmployees</td>
                            <td data-label="Amt">@Model.VariableDeductionList[i].Amount</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>