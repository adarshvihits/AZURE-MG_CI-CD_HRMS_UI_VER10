@model Hrms.Lite.Shared.PayRoll.GratuityProcessing
    <script src="~/js/bootstrap-datepicker.js"></script>

    <div class="step-outer pb-10 step_row">
        @*<a href="#" class="step-item active">
            Breaking Service
            <span class="step-circle"></span>
        </a>
        <a href="#" class="step-item active">
            Approval
            <span class="step-circle"></span>
        </a>
        <a href="#" class="step-item active">
            Payment Details
            <span class="step-circle"></span>
        </a>*@


        <a href="#" class="step-item active" @*onclick="onStepCircleClick('Breaking_Service')"*@>
            Breaking Service
            <span class="step-circle"></span>
        </a>

        <a href="#" class="step-item active" @*onclick="onStepCircleClick('Approval')*@">
            Approval
            <span class="step-circle"></span>
        </a>

        <a href="#" class="step-item active" >
            Payment Details
            <span class="step-circle"></span>
        </a>






    </div>


    <div class="page_white">
        <div class="row my-2">
            <div class="col-md-3">
                <div class="form-group">
                    <label class="view-title">Breaking Period</label>
                    @Html.HiddenFor(m => Model.EmployeeGaratuity.BreakingYears)
                    @Html.HiddenFor(m => Model.EmployeeGaratuity.ActualYears)
                    @Html.HiddenFor(m => Model.EmployeeGaratuity.GratuityApplSalary)
                    @Html.HiddenFor(m => Model.EmployeeGaratuity.GratuityAmount)
                    @Html.HiddenFor(m => Model.EmployeeGaratuity.LIC)
                    @Html.HiddenFor(m => Model.EmployeeGaratuity.PF)
                    @Html.HiddenFor(m => Model.EmployeeGaratuity.UAN)
                    @Html.HiddenFor(m => Model.EmployeeGaratuity.ESI)
                    @Html.HiddenFor(m => Model.EmployeeGaratuity.AadharNo)
                    @Html.HiddenFor(m => Model.EmployeeCode)
                    <div class="view-details">@Model.EmployeeGaratuity.BreakingYears</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label class="view-title">Actual Y/S</label>

                    <div class="view-details">@Model.EmployeeGaratuity.ActualYears</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label class="view-title">Gratuity Applicable Salary </label>

                    <div class="view-details">@Model.EmployeeGaratuity.GratuityApplSalary</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label class="view-title">Final Gratuity Amount </label>

                    <div class="view-details">@Model.EmployeeGaratuity.GratuityAmount</div>
                </div>
            </div>

        </div>
        <div class="row my-2">
            <div class="col-md-3">
                <div class="form-group">
                    <label class="view-title">LIC </label>

                    <div class="view-details">@Model.EmployeeGaratuity.LIC</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label class="view-title">PF </label>

                    <div class="view-details">@Model.EmployeeGaratuity.PF</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label class="view-title">UAN  </label>

                    <div class="view-details">@Model.EmployeeGaratuity.UAN</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="form-group">
                    <label class="view-title">ESI  </label>

                    <div class="view-details">@Model.EmployeeGaratuity.ESI</div>
                </div>
            </div>

        </div>
        <div class="row my-2">
            <div class="col-md-3">
                <div class="form-group">
                    <label class="view-title">Aadhar  </label>

                    <div class="view-details">@Model.EmployeeGaratuity.AadharNo</div>
                </div>
            </div>
        </div>
    </div>









    <div class="row my-2">
        <div class="col-md-3">

            <div class="form-group">
                <label>Cheque Number </label>
                @Html.HiddenFor(m => m.GratuityPayment.EmployeeCode)
                @Html.TextBoxFor(Model => Model.GratuityPayment.CheckNumber, new { @class = "form-control form-control-sm num", @placeholder = "Cheque Number", maxlength = "120", @onchage = "validate(this,'checknumber')" })
                <span id="checknumber"></span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="row-outer pb-2">
                <label>Cheque Date</label>
             
                <div class="input-group date">


                    @Html.TextBoxFor(Model => Model.GratuityPayment.CheckDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2 dop chequeDate", @placeholder = "Cheque Date", @onchange = "validate(this,'Chequedate')" })

                    <div class="input-group-append">
                        <span class="input-group-text">
                            <i class="la la-calendar"></i>
                        </span>
                    </div>
                   
                </div>
                <span id="Chequedate"></span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label>Handover To </label>

                @Html.TextBoxFor(Model => Model.GratuityPayment.HandoverTo, new { @class = "form-control form-control-sm handover", @placeholder = "HandoverTo", maxlength = "120" , @onblur = "validate(this,'handoverTo')" })
                <span id="handoverTo"></span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="row-outer pb-2">
                <label>Handover Date</label>
                <div class="input-group date">
                    @Html.TextBoxFor(Model => Model.GratuityPayment.HandoverDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "From", @onchange = "validate(this,'handoverDate')" })

                    @*@Html.TextBoxFor(Model => Model.GratuityPayment.HandoverDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2 dop", @placeholder = "HandOver Date" })*@
                    @*   @Html.TextBoxFor(m => m.GratuityPayment.HandoverDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2 dojpicker ", @readonly = "true", @placeholder = "HandOver Date", @onblur = "validate(this,'handoverDate')" })*@

                    <div class="input-group-append">
                        <span class="input-group-text">
                            <i class="la la-calendar"></i>
                        </span>
                    </div>
                    
                </div>
                <span id="handoverDate"></span>
            </div>
        </div>
    </div>



    <div class="row my-2">


    </div>

    <div class="row card-footer-bottom-fixed">

        <div class="col-md-12 align-right">
            <button type="button" class="btn btn-default  mobile-full-width" onclick="SavePaymentDetails()">
                Save 
            </button>
        </div>

   

</div>