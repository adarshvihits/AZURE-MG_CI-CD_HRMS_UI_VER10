@model Hrms.Lite.Shared.PayRoll.SalaryReleaseBankStatement
<script src="~/js/settings.js"></script>
<script src="~/js/tooltip.js"></script>

<div class="ihits-table table-border odd-even  mobile-responsive-table salary_release_bnk_statement">
    @Html.HiddenFor(m => m.SalaryReleaseBankStatementList.Count)
    <table id="SalaryStatementHistoryTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Designation </th>
                <th scope="col">Account.No.</th>
                <th scope="col">IFSC Code</th>
                <th scope="col">Bank</th>
                <th scope="col">Type</th>
                <th scope="col">Date</th>
                <th scope="col">Net Pay</th>
            </tr>
        </thead>
        <tbody>

            @if (Model.SalaryReleaseBankStatementList != null && Model.SalaryReleaseBankStatementList.Count > 0)
            {
            for (int i = 0; i < Model.SalaryReleaseBankStatementList.Count; i++)
            {
            <tr>
                <td data-label="ID">
                    @Model.SalaryReleaseBankStatementList[i].EmployeeHeader.EmployeeId
                </td>
                <td data-label="Name">
                    @Model.SalaryReleaseBankStatementList[i].EmployeeHeader.EmployeeName

                </td>
                <td data-label="Designation">@Model.SalaryReleaseBankStatementList[i].Designation</td>
                <td data-label="accountno">@Model.SalaryReleaseBankStatementList[i].AccountNo</td>
                <td data-label="ifsc">@Model.SalaryReleaseBankStatementList[i].IFSC</td>
                <td data-label="bank">@Model.SalaryReleaseBankStatementList[i].Bank</td>

                <td data-label="type">
                    @Model.SalaryReleaseBankStatementList[i].ReportFormatName
                </td>
                <td data-label="date">
                    @Model.SalaryReleaseBankStatementList[i].Date
                </td>
                <td data-label="netpay">
                    @Model.SalaryReleaseBankStatementList[i].NetPay
                </td>

            </tr>



            }
            }

        </tbody>
    </table>
</div>