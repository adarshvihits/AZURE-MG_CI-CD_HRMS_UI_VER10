
@model Hrms.Lite.Shared.PayRoll.SalaryReleaseBankStatement

@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "SRBankStatemntSave" }))
{
    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table pt-3 vertical-scroll-400 Salary-Release-bk-List">
        <table id="SRBnkStatemntTable" class="common-table">
            <thead>
                <tr class="table-dark">

                    <th scope="col">ID</th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">Designation</th>
                    <th scope="col">Account No.</th>
                    <th scope="col">IFSC Code</th>
                    <th scope="col">Bank</th>
                    <th scope="col">Net Pay</th>
                    <th scope="col">Transfer Status</th>
                    <th scope="col">
                        <div class="checkbox-inline selectAllChkBx" style=" text-align:center;justify-content:center;padding-left:23px; }">
                            <label class="checkbox checkbox-outline checkbox-success">
                                <input data-val="true" value="true" id="SelectAll" name="SelectAll" type="checkbox" onchange="onSelectAllClick()">
                                <span cursorshover="true"></span>
                            </label>
                            <label class="checkbox checkbox-outline checkbox-success"></label>
                        </div>
                    </th>

                </tr>
            </thead>
            <tbody>
                @{
                    if (Model.SalaryReleaseBankStatementList != null && Model.SalaryReleaseBankStatementList.Count > 0)
                    {
                        for (int i = 0; i < Model.SalaryReleaseBankStatementList.Count; i++)

                        {
                                <tr>

                                                    <td>
                                              
                                                        @Model.SalaryReleaseBankStatementList[i].EmployeeHeader.EmployeeId
                                                        @Html.HiddenFor(model => model.SalaryReleaseBankStatementList[i].EmployeeHeader.EmployeeCode)
                                                    

                                                    </td>
                                    <td>
                                        @Model.SalaryReleaseBankStatementList[i].EmployeeHeader.EmployeeName
                                    </td>
                                    <td>
                                        @Model.SalaryReleaseBankStatementList[i].Designation
                                    </td>
                                    <td>
                                        @Model.SalaryReleaseBankStatementList[i].AccountNo
                                    </td>
                                    <td>
                                        @Model.SalaryReleaseBankStatementList[i].IFSC
                                    </td>
                                    <td>
                                        @Model.SalaryReleaseBankStatementList[i].Bank
                                    </td>
                                    <td>
                                        @Model.SalaryReleaseBankStatementList[i].NetPay
                                    </td>
                                    <td>
                                        @Model.SalaryReleaseBankStatementList[i].TransferStatus
                                        @Html.HiddenFor(model => model.SalaryReleaseBankStatementList[i].TransferStatus)
                                    </td>
                                    <td data-label="Appicability">
                                        <div class="checkbox-inline d-flex justify-content-center">
                                            <label class="checkbox checkbox-outline checkbox-success">
                                                @Html.CheckBoxFor(model => model.SalaryReleaseBankStatementList[i].Applicability)
                                                <span></span>
                                            </label>
                                        </div>
                                    </td>

                                </tr>

                        }
                    }
                }

            </tbody>
        </table>
    </div>

 }