@model Hrms.Lite.Shared.PayRoll.BankStatementRepost
<script src="~/js/settings.js"></script>
<script>
    $(document).ready(function () {

        $(".Repost_Count").html(@Model.RepostingCount);
        $(".Pending_Count").html(@Model.PendingCount);


    });

</script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table pt-3 vertical-scroll-400 RePosting-List">
    <table id="RepostingTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">Company</th>
                <th scope="col">File Name</th>
                <th scope="col">Posted User</th>
                <th scope="col">Posted Date</th>
                <th scope="col">Approve</th>

            </tr>
        </thead>
        <tbody>
            @{
                if (Model.BankStatementRepostList != null && Model.BankStatementRepostList.Count > 0)
                {
                    for (int i = 0; i < Model.BankStatementRepostList.Count; i++)

                    {
                        <tr>

                            <td data-label="Company">
                                @Model.BankStatementRepostList[i].GroupCompany.Name
                            </td>
                            <td data-label="FileName">

                                @Model.BankStatementRepostList[i].FileName
                            </td>
                            <td data-label="User">

                                @Model.BankStatementRepostList[i].PostedUser
                            </td>
                            <td data-label="Date">
                                @Model.BankStatementRepostList[i].PostedDate
                            </td>
                            <td data-label="Approve">
                                <a onclick="onApproveClick('@Model.BankStatementRepostList[i].FileName','@Model.BankStatementRepostList[i].PostedUserCode','@Model.BankStatementRepostList[i].GroupCompany.GI')">
                                    <i class="icon-xl la la-arrow-circle-right"></i>
                                </a>
                            </td>
                        </tr>

                    }
                }
            }

        </tbody>
    </table>
</div>

