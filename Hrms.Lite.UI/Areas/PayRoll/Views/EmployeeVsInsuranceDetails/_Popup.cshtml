@model Hrms.Lite.Shared.PayRoll.EmployeeVsInsuranceDetails
    <script src="~/js/bootstrap-datepicker.js"></script>
@using (Html.BeginForm("Save", "Allowance", FormMethod.Post, new { id = "InsuranceDetailsListSave" }))
{
    @Html.HiddenFor(m => m.EmployeeGI)
    <div class="ihits-table table-border mobile-responsive-table mb-5 vertical-scroll-200 employee-insurance-list">
        <table id="popupTable">
            <thead>
                <tr class="table-light">
                    <th scope="col">Company</th>

                    <th scope="col">Policy</th>
                    <th scope="col">Policy No.</th>
                    <th scope="col">Start Date</th>
                    <th scope="col">Maturity </th>
                    <th scope="col">Principal Amt. </th>
                    <th scope="col">Premium </th>
                    <th scope="col">Status </th>
                    <th scope="col">Action </th>



                </tr>
            </thead>
            <tbody>
                @if (Model.EmployeeVsInsuranceDetailsList != null && Model.EmployeeVsInsuranceDetailsList.Count > 0)
                {

                    for (int i = 0; i < Model.EmployeeVsInsuranceDetailsList.Count; i++)
                    {
                        <tr id="row_@i">
                            <td data-label="">
                                @Html.HiddenFor(m => m.EmployeeVsInsuranceDetailsList[i].InsurancePolicy.InsuranceCompany.Code)
                                @Model.EmployeeVsInsuranceDetailsList[i].InsurancePolicy.InsuranceCompany.Name
                            </td>

                            <td data-label="Policy" >
                                @Html.HiddenFor(m => m.EmployeeVsInsuranceDetailsList[i].InsurancePolicy.Code)
                                @Model.EmployeeVsInsuranceDetailsList[i].InsurancePolicy.Name
                            </td>

                            <td data-label="Policy/Invest Num" style="position:relative;"> 
                                @*@Model.EmployeeVsInsuranceDetailsList[i].PolicyNumber
                                @Html.HiddenFor(m => m.EmployeeVsInsuranceDetailsList[i].PolicyNumber)*@
                                @Html.HiddenFor(m => m.EmployeeVsInsuranceDetailsList[i].TransactionCode)
                                @Html.TextBoxFor(m => m.EmployeeVsInsuranceDetailsList[i].PolicyNumber, new { @class = "form-control form-control-sm", @placeholder = "Policy Number", @onblur = "validate(this,'pNumber')" })
                                <span id="pNumber"></span>
                            </td>
                            <td data-label="Start Date">
                                <div style="position:relative;">
                                    <div class="input-group date">
                                        @Html.TextBoxFor(m => m.EmployeeVsInsuranceDetailsList[i].StartDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "Start Date", @onchange = "validate(this,'stDate_" + i + "')" })
                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                        <span id="stDate_@i"></span>
                                    </div>
                            </td>
                            <td data-label="Maturity">
                                <div style="position:relative;">
                                    <div class="input-group date">
                                        @Html.TextBoxFor(m => m.EmployeeVsInsuranceDetailsList[i].MaturityDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "Maturity", @onchange = "validate(this,'MtDate_" + i + "')" })
                                        <div class="input-group-append">
                                            <span class="input-group-text">
                                                <i class="la la-calendar"></i>
                                            </span>
                                        </div>
                                    </div>
                                        <span id="MtDate_@i"></span>
                                    </div>
                            </td>
                            <td data-label="Amount">
                                <div style="position:relative;">
                                    @Html.TextBoxFor(m => m.EmployeeVsInsuranceDetailsList[i].PrincipalAmount, new { @class = "form-control form-control-sm", @maxlength = 8, @placeholder = "Amount", @onkeypress = "return onlyNumberKey(event)", @onblur = "validate(this,'princAmt_" + i + "')" })
                                    <span id="princAmt_@i"></span>
                                    </div>
                            </td>
                            <td data-label="Premium">
                                <div style="position:relative;">
                                    @Html.TextBoxFor(m => m.EmployeeVsInsuranceDetailsList[i].PremiumAmount, new { @class = "form-control form-control-sm", @maxlength = 8, @placeholder = "Premium", @onkeypress = "return onlyNumberKey(event)", @onblur = "validate(this,'PremAmt_" + i + "')" })
                                    <span id="PremAmt_@i"></span>
                                </div>
                            </td>
                            <td data-label="Status">

                                Active
                            </td>
                            <td data-label="Action">
                                @*<a id="updateButton" type="button" data-bs-toggle="tooltip" title="" class="btn btn-icon btn-update icon-only hide" data-bs-original-title="Update" onclick="$('#updateButton').addClass('hide'); $('#editButton').removeClass('hide')"> 
                                <i class="icon-xl fas fa-sync-alt"></i>
                                </a>*@

                                @*<a id="editButton" data-bs-toggle="tooltip" title="Edit" type="button" onclick="$('#updateButton').removeClass('hide'); $('#editButton').addClass('hide')"
                                   class="btn btn-icon btn-edit icon-only slider-btn">
                                    <i class="icon-xl fas fa-pencil-alt"></i>
                                </a>*@

                                <a data-bs-toggle="tooltip" title="Delete"
                                   id="allowancedelete" type="button"
                                   class="btn btn-icon  icon-only mobile-full-width slider-btn btn-delete" onclick="onDeleteClick(@i)">
                                    <i class="icon-xl far fa-trash-alt"></i>
                                </a>
                            </td>



                        </tr>
                    }
                }



            </tbody>
        </table>
    </div>

    <div style="margin-top: 10px;">

        <div class="col-md-12 align-right">
            @if (Model.EmployeeVsInsuranceDetailsList != null && Model.EmployeeVsInsuranceDetailsList.Count > 0)
            {
                <a type="button" class="btn btn-default  mobile-full-width" onclick="onInsuranceDetailsListSaveClick()">
                    Save
                </a>
            }
        </div>


    </div>
}