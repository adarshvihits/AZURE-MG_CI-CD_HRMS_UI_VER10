


@model Hrms.Lite.Shared.PayRoll.PaySlipGeneration
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>

<script src="~/scripts/PayRoll/GeneratePaySlip.js"></script>

<style>
    .arrow_sep{
        padding-left:3px;
        padding-right:3px;
    }
    .playslip_note {
        padding-top: 15px;
        color: red;
    }
    .playslip_note span
    {
        padding-left:3px;
    }
</style>

<div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->


            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Generate PaySlip</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            Generate PaySlip
                        </li>
                    </ul>
                </div>
            </div>
            <!--begin::Topbar-->
            <div class="topbar">


            </div>
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->
    @using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "Generate_PaySlip" }))
    {
        <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
            <!--begin::Entry-->
            <div class="d-flex flex-column-fluid">
                <!--begin::Container-->
                <div class="container full-width">
                    <!--begin::Dashboard-->
                    <!--begin::Row-->



                    <div class="card card-custom height-100per footer-row-fixed">

                        <div class="card-body">
                            <!--begin: Search Form-->

                            <div class="row tab-style-button">
                                <div class="tab-button-wrap align-items-center">

                                    <div class="tab-items">

                                        <div class="row-outer pb-2">
                                            @Html.DropDownListFor(m => m.Month.Code, (SelectList)ViewBag.currMonth, "--Month--", new { @class = "form-control form-control-sm", @onchange = "fillData()" })

                                        </div>
                                    </div>
                                    <div class="tab-items pl-3">

                                        <div class="row-outer pb-2">
                                            @Html.DropDownListFor(m => m.PayGroup.Code, (SelectList)ViewBag.Pgroup, "--Payroll Group--", new { @class = "form-control form-control-sm", @onchange = "fillData()" })


                                        </div>
                                    </div>

                                    <div class="pl-8 d-flex align-items-center">
                                        <div class="radio-inline pt-4">
                                            <label class="radio radio-outline radio-success mr-10">
                                                @Html.RadioButtonFor(m => m.Type, "2", new { @onchange = "fillData()" })
                                                <span></span>All
                                            </label>
                                            <label class="radio radio-outline radio-success">
                                                @Html.RadioButtonFor(m => m.Type, "1", new { @onchange = "fillData()" })
                                                <span></span>Generated
                                            </label>
                                            <label class="radio radio-outline radio-success">
                                                @Html.RadioButtonFor(m => m.Type, "0", new { @onchange = "fillData()" })
                                                <span></span>Not Generated
                                            </label>

                                        </div>
                                    </div>
                                    <div class="tab-items select-option high">

                                        <div class="sraech-slider">
                                            <div class="search-slider-inner">
                                                <i class="fa fa-search"></i>
                                            </div>
                                            <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                                   placeholder="ID/Name">
                                        </div>


                                        <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                           data-bs-original-title="Export to Excel">
                                            <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                        </a>


                                    </div>


                                </div>
                            </div>
                            <div id="LIST_ID">
                                @await Html.PartialAsync("_List", Model)

                            </div>
                            <div class="playslip_note">Note:<span>Payslip generation will take a few minutes. Feel free to exit the form while the payslip is being generated.</span></div>
                            <!--end: Datatable-->
                            <div class="row card-footer-bottom-fixed">


                                <div class="col-md-12 payslipbutton d-flex justify-content-end align-items-center">

                                    <div id="GenerationStatus" class="hide" style=" font-weight: 600;">  Payslip Generated: <span id="genCount"></span><span class="arrow_sep">/</span><span id="totCount"></span></div>
                                    <button id="GenBtn" type="button" class="btn btn-default float-right mobile-full-width" onclick="GeneratePaySlip()">
                                        Generate PaySlip
                                    </button>


                                </div>


                            </div>
                        </div>
                    </div>


                    <!--end::Row-->
                    <!--begin::Row-->
                    <!--end::Row-->
                    <!--end::Dashboard-->
                </div>
                <!--end::Container-->
            </div>
            <!--end::Entry-->

        </div>
    }
        <div class="slider-over-flow"></div>
    </div>


