@model Hrms.Lite.Shared.PayRoll.SalaryProcessing
<div class="profile-header mb-3">


    @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeHeader.cshtml",Model.EmployeeHeader)    

    <div class="profile-header-overflow"></div>
</div>

<div class="page_white">
    <div class="row">
        <div class="col-md-2">
            <div class="form-group d-flex">
                <label>
                    Processed Month :
                </label>
                <div class="pl-2"><span id="mName"></span></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group d-flex">
                <label>
                    Processing Status :
                </label>
                <div class="pl-2">Processed</div>
            </div>
        </div>
    </div>
    <div class="row pt-3">
        <div class="col-md-12">
            <h4>Allowance and Deduction</h4>

        </div>

    </div>
    <div class="ihits-table table-border  mobile-responsive-table monthly-salary-individual vertical-scroll-350">
        <table>
            <thead>
                <tr class="table-dark">
                    <th scope="col">Description</th>
                    <th scope="col">@Model.SalaryIntegrityReport.MonthA.Name</th>
                    <th scope="col">@Model.SalaryIntegrityReport.MonthB.Name</th>
                    <th scope="col">Difff(A-B)</th>
                    <th scope="col">LOP(A)</th>
                    <th scope="col">LOB(B)</th>

                </tr>
            </thead>
            <tbody>


                @if (Model.SalaryIntegrityReport.Details != null && Model.SalaryIntegrityReport.Details.Count > 0)
                {
                    for (int i = 0; i < Model.SalaryIntegrityReport.Details.Count; i++)
                    {
                        <tr>
                            <td data-label="Description">@Model.SalaryIntegrityReport.Details[i].Name</td>
                            <td data-label="Jan2023">@Model.SalaryIntegrityReport.Details[i].AmountA</td>
                            <td data-label="Dec2021">@Model.SalaryIntegrityReport.Details[i].AmountB</td>
                            <td data-label="Difff(A-B)">@Model.SalaryIntegrityReport.Details[i].Difference</td>
                            <td data-label="LOP(A)">
                                @Model.SalaryIntegrityReport.Details[i].LopA

                            </td>
                            <td data-label="LOB(B)">@Model.SalaryIntegrityReport.Details[i].LopB</td>


                        </tr>
                    }
                }

                    </tbody>
        </table>
    </div>
</div>