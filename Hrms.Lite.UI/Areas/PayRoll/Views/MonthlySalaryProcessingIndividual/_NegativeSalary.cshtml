@model Hrms.Lite.Shared.PayRoll.SalaryProcessing
<script src="~/js/tooltip.js"></script>
<style>
    .negative_salary_list .dataTables_wrapper.no-footer .dataTables_scrollBody {
        max-height: 30vh !important;
        height: 30vh !important;
    }
    .modal-open .modal {
        overflow-x: hidden;
         overflow-y: hidden; 
    }
</style>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table  negative_salary_list   vertical-scroll-200">
    @Html.HiddenFor(m => m.SalaryProcessing_popup.Count)

    <table>
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Gross Allowance">Gross Allw.</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Gross Deduction">Gross Ded.</th>
                <th scope="col">Advance</th>
                <th scope="col">Net Salary</th>
                <th scope="col">Remarks</th>

            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.SalaryProcessing_popup != null && Model.SalaryProcessing_popup.Count > 0)
            {

                for (int i = 0; i < Model.SalaryProcessing_popup.Count; i++)
                {

                    <tr>

                        <td data-label="ID">@Model.SalaryProcessing_popup[i].ID</td>
                        <td data-label="Name">
                            @Model.SalaryProcessing_popup[i].Name
                        </td>
                        <td data-label="Designation">@Model.SalaryProcessing_popup[i].Designation</td>
                        <td data-label="Department">@Model.SalaryProcessing_popup[i].Department</td>
                        <td data-label="Location">@Model.SalaryProcessing_popup[i].Location</td>
                        <td data-label="LoanType">@Model.SalaryProcessing_popup[i].GrossAllowance</td>
                        <td data-label="LoanBalance">@Model.SalaryProcessing_popup[i].GrossDeduction</td>
                        <td data-label="LoanBalance">@Model.SalaryProcessing_popup[i].Advance</td>
                        <td data-label="MthlyEMI">@Model.SalaryProcessing_popup[i].NET_SALARY</td>
                        <td data-label="ConfAmount">@Model.SalaryProcessing_popup[i].Remarks</td>

                    </tr>
                }
            }
        </tbody>

    </table>

</div>