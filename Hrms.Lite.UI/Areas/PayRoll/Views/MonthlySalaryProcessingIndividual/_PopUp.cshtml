@model Hrms.Lite.Shared.PayRoll.SalaryProcessing
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "Individual_SalaryProcessing" }))
{
    <div class="row">
        <div class="col-md-12">
            <h4>
                Pending Task
            </h4>
            @Html.HiddenFor(m => m.PayrollMonth.Code)
            @Html.HiddenFor(m => m.Employee.Code)
            @Html.HiddenFor(m => m.Validation_Msg.FLAG)
            @Html.HiddenFor(m => m.Validation_Msg.Description)
            @Html.HiddenFor(m =>m.Employee.GI)
            @Html.HiddenFor(m => m.Statutory.Count)
            <div class="pending-task-list">
                <ul>

                    @if (Model.Statutory != null && Model.Statutory.Count > 0)
                    {

                        for (int i = 0; i < Model.Statutory.Count; i++)
                        {
                            <li>
                                @Model.Statutory[i].Description
                            </li>
                        }
                    }
                    @*<li>
                    Job Transistion Approval
                </li>
                <li>
                    Employee edit approval
                </li>
                <li>
                    Employee master changes
                </li>
                <li>
                    Salary Revision
                </li>
                <li>
                    Actual Gross salary variation with previous month
                </li>
                <li>
                    Account Number Variation With Previous Month
                </li>
                <li>
                    Holiday Wage Default Settings Change
                </li>
                <li>
                    Offday Wage Default Settings Change
                </li>
                <li>
                    Overtime Default Settings Change
                </li>*@
                </ul>
            </div>

            <div class="row pt-10">
                <div class="col-md-12">
                    <div class=" mt-4  d-flex justify-content-end">

                        <button type="button" class="btn  searchProfileSliderClose search-btn-cancel mr-2 " data-bs-dismiss="modal"
                                aria-label="Close" onclick="$('#procBtn').prop('disabled', false);">
                            Cancel
                        </button>
                        <a type="button" class="btn btn-default " onclick="onOkClick()">
                            OK
                        </a>
                    </div>

                </div>


            </div>

        </div>
    </div>
}