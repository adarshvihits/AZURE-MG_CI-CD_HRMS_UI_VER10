@model Hrms.Lite.Shared.PayRoll.SlabDeductionConfirmation
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>

<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/PayRoll/Reports/SlabBasedDedConfirmation.js"></script>


<style>
    .dataTables_processing {
        display: none !important;
    }
</style>

<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Slab Based Deduction Confirmation</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Slab Based Deduction Confirmation
                    </li>

                </ul>
            </div>
        </div>

        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <!--begin: Search Form-->

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">

                            <div class="tab-items low">
                                <span class="btn-title active tab1" onclick="tabClick('tab1','0')">                                 
                                    Pending                                  
                                </span>
                              
                            </div>


                            <div class="tab-items medium">
                                <span class="btn-title  tab2" onclick="tabClick('tab2', '1')">                                  
                                    Confirmed
                               
                                </span>                              
                            </div>

                            <div class="tab-items select-option ">

                                <div class="form-group filter-combobox mr-6" style="width: 145px;">

                                    @Html.DropDownListFor(m => m.Month, (SelectList)ViewBag.DeductionMonth, "--Month--", new { @class = "form-control form-control-sm", @onchange = "GetList();validate(this,'month')" })
                                    <span id="month"></span>

                                </div>



                                <div class="form-group filter-combobox mr-15">
                                    @Html.DropDownListFor(m => m.DeductionCode, (SelectList)ViewBag.Deduction, "--Deduction--", new { @class = "form-control form-control-sm", @onchange = "GetList();validate(this,'deduction')" })
                                    <span id="deduction"></span>
                                </div>




                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>


                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                   data-bs-original-title="Export to Excel" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>
                            

                            </div>


                        </div>
                    </div>

                    <div id="ConfirmationList">
                        @await Html.PartialAsync("~/Areas/PayRoll/Views/SlabBasedDeductionConfirmation/_List.cshtml")
                    </div>

                
                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.filter)
                    </div>

                    <div class="row card-footer-bottom-fixed ">

                        <div class="col-md-12 align-right confirm " id="ConfirmBtn">
                            <a  id="confirmdeletebtn" class="btn btn-default float-right mobile-full-width" onclick="AllConfirmClick('Confirm')">
                                Confirm
                            </a>

                        </div>


                    </div>

                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>

