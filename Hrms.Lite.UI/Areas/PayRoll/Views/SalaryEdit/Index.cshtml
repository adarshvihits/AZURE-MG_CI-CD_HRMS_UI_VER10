@model Hrms.Lite.Shared.PayRoll.SalaryEdit
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/PayRoll/SalaryEdit.js"></script>
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->

        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Salary Edit</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                         Salary Edit
                    </li>
                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <!--begin: Search Form-->
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">


                            @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "SalaryEdit", enctype = "multipart/form-data" }))
                            {

                                <div class="tab-items mt-2">

                                    <label>Month</label>
                                    <div class="form-group filter-combobox mt-0">

                                        @Html.DropDownListFor(m => m.Month, (SelectList)ViewBag.month, "--Select--", new { @class = "form-control form-control-sm", @onchange = "fillData()", @style = "width:120px;" })
                                        <span id="MonthSalRelease"></span>
                                    </div>
                                </div>

                                <div class="tab-items mt-2">
                                    <label>Payroll Group</label>
                                    <div class="form-group filter-combobox mt-0">

                                        @Html.DropDownListFor(m => m.PayrollGroup, (SelectList)ViewBag.Payroll, "--Select--", new { @class = "form-control form-control-sm", @onchange = "fillData()", @style = "width:200px;" })
                                        <span id="PgSalRelease"></span>
                                    </div>


                                </div>






                            }





                            <div class="tab-items select-option srch-fli-exp-pad">


                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                               


                            </div>




                        </div>
                    </div>




                    <div id="list">
                        @await Html.PartialAsync("~/Areas/PayRoll/Views/SalaryEdit/_SalaryEditList.cshtml", Model)

                    </div>
                    <div id="edit">


                    </div>

                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <div id="filterSlider">
        @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.filter)
    </div>

</div>

