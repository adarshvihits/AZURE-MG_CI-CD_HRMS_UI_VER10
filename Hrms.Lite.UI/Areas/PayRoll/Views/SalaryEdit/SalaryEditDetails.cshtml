@model Hrms.Lite.Shared.PayRoll.SalaryEdit
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/settings.js"></script>
<script src="~/scripts/PayRoll/SalaryEdit.js"></script>




<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->

        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Salary Edit</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">

                        <a href="@Url.Action("Index", "DashBoard", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a href="@Url.Action("Index", "SalaryEdit", new { Area = "PayRoll" })" class="">
                            Salary Edit List
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Salary Edit
                    </li>
                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                       <div class="profile-header  pro_ph mb-2">
                                                            <div class="">

                                                                <div class="col-md-12 pl-10">
                                                                    <div class="row">
                                                                        <div class="d-flex">
                                                                            <div class="image-input-wrapper">
                                                                                <div class="image-input image-input-outline image-input-circle  mr-5 emp_HeaderPic" id="kt_image_4">
                                                                                    <div class="image-input-wrapper">
                                                                                        <img src="/AccessFile/GetEmpThumbnail?EmployeeGI=@(Model.EmployeeHeader.EmployeeGuid)" />
                                                                                    </div>
                                                                                </div>
                                                                            </div>
                                                                            <div class="flex-grow-1">

                                                                                <!--begin::Title-->
                                                                                <div class="d-flex justify-content-between flex-wrap mt-2">
                                                                                    <div class="d-flex mr-3 header-profile-name">
                                                                                        <a class="header-profile-name">@Model.EmployeeHeader.EmployeeName</a>
                                                                                        @Html.HiddenFor(m => m.EmployeeHeader.EmployeeGuid)
                                                                                    </div>

                                                                                </div>
                                                                               
                                                                                <!--end::Title-->
                                                                                <!--begin::Content-->
                                                                                <div class="d-flex flex-wrap justify-content-between">
                                                                                    <div class="d-flex flex-column flex-grow-1 pr-8">
                                                                                        <div class="d-flex flex-wrap mb-1">
                                                                                            <a data-bs-toggle="tooltip" data-bs-original-title="Functional Designation" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                                                                <i class="fas fa-network-wired icon-nm mr-2"></i>@Model.EmployeeHeader.FunctionalDesignation
                                                                                            </a>
                                                                                            <a data-bs-toggle="tooltip" data-bs-original-title="Designation" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                                                                <i class="fas fa-briefcase icon-nm mr-2"></i>@Model.EmployeeHeader.Designation.Name
                                                                                            </a>
                                                                                            <a data-bs-toggle="tooltip" data-bs-original-title="Department" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                                                                <i class="fas fa-building icon-nm mr-2"></i>@Model.EmployeeHeader.Department.Name

                                                                                            </a>
                                                                                            <a data-bs-toggle="tooltip" data-bs-original-title="Location" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                                                                <i class="fas fa-map-marker-alt icon-nm mr-2"></i>@Model.EmployeeHeader.Location.Name

                                                                                            </a>

                                                                                            <a data-bs-toggle="tooltip" data-bs-original-title="Location Code" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                                                                <i class="fas fa-map-marker-alt icon-nm mr-2"></i>@Model.EmployeeHeader.LocationCode
                                                                                            </a>
                                                                                            <a data-bs-toggle="tooltip" data-bs-original-title="DOJ" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                                                                <i class="fas fa-calendar-alt icon-nm mr-2"></i>@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.EmployeeHeader.DOJ))
                                                                                            </a>
                                                                                            <a data-bs-toggle="tooltip" data-bs-original-title="Category" class="header-profile-email mr-lg-8 mr-5 mb-lg-0 mb-2">
                                                                                                <i class="fas fa-check-square icon-nm mr-2"></i>@Model.EmployeeHeader.Category.Name
                                                                                            </a>




                                                                                        </div>



                                                                                    </div>



                                                                                </div>

                                                                                <!--end::Content-->
                                                                            </div>

                                                                        </div>
                                                                    </div>

                                                                </div>
                                                            </div>



                                                            <div class="profile-header-overflow"></div>
                                                        </div>
                  


                    <div class="row" style="padding:10px 0; background-color: white; margin-bottom: 2px;">



                        <div class="col-md-12" style=" border-right: 1px solid #ebedf3;">
                            <div class="ihits-table table-border hover-color odd-even mobile-responsive-table Salary-Edit-Details-list-tble pt-3">
                      
                                    @Html.HiddenFor(m => m.SalaryEditList.Count)
                                    <table Id="Salaryedittable" class="common-table">
                                        <thead>
                                            <tr class="table-dark">
                                                <th scope="col">Description</th>
                                                <th scope="col">Total</th>
                                                <th scope="col">Action</th>


                                            </tr>
                                        </thead>

                                        <tbody>
                                            @if (Model.SalaryEditDetailsList != null && Model.SalaryEditDetailsList.Count > 0)
                                            {
                                                for (int i = 0; i < Model.SalaryEditDetailsList.Count; i++)
                                                {

                                                    <tr style="background-color:@Model.SalaryEditDetailsList[i].Colour">
                                                        <td data-label="slno">
                                                            @Model.SalaryEditDetailsList[i].Description

                                                            @Html.HiddenFor(m => m.Month)
                                                            @Html.HiddenFor(m => m.SalaryEditDetailsList[i].RowType)



                                                        </td>

                                                        <td data-label="Amount">
                                                            <div class="form-group">
                                                                <span id="amtLabel2_@i">@Model.SalaryEditDetailsList[i].Total</span>
                                                                <span id="amtTxtbox2_@i" class="hide">
                                                                    @Html.TextBoxFor(Model => Model.SalaryEditDetailsList[i].Total, new
                                                               {
                                                                   @class = "form-control text-right form-control-sm",
                                                                   maxlength = "300",
                                                                   oninput = "this.value = this.value.replace(/[^0-9.]/g, '')",
                                                                   @style = "width:100%;"
                                                               })
                                                                    <span id="SalaryEditTotal"></span>
                                                                </span>
                                                            </div>
                                                        </td>

                                                        <td data-label="Edit">
                                                            <div class="d-flex justify-content-center">
                                                                @if (Model.SalaryEditDetailsList[i].Editable != 0)
                                                                {
                                                                    <span id="editbt2_@i">
                                                                        <a data-bs-toggle="tooltip" title="Edit"
                                                                           id="ceedit"
                                                                           class="btn btn-icon btn-edit icon-only" onclick="onEditClick(@i)">
                                                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                                                        </a>
                                                                    </span>
                                                                }
                                                            </div>
                                                            @if (Model.SalaryEditDetailsList[i].Editable != 0)
                                                            {
                                                                <span id="updateCancel2_@i" class="hide">
                                                                    <a data-bs-toggle="tooltip" title="Update"
                                                                       id="cupdate"
                                                                       class="btn btn-icon btn-edit icon-only" onclick="onUpdateClick(@Model.SalaryEditDetailsList[i].DescriptionCode,@i)">

                                                                        <i class="icon-xl fas fa-sync-alt"></i>
                                                                    </a>
                                                                    <a data-bs-toggle="tooltip" title="Cancel"
                                                                       id="ccancel"
                                                                       class="btn btn-icon btn-cancel icon-only" onclick="onCancelClick(@i)">
                                                                        <i class="icon-xl fas fa-times"></i>
                                                                    </a>
                                                                </span>
                                                            }
                                                        </td>

                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="3">
                                                        <div style="text-align: center;display: flex;align-items: center;justify-content: center;height: 60vh;"><img src="/images/nodata.png" /></div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>


                                    </table>



                                </div>







                            </div>




                        </div>



                   
                </div>
            </div>
        </div>
    </div>
</div>
