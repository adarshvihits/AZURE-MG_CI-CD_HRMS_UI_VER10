@model Hrms.Lite.Shared.PayRoll.SalaryReleaseRepost
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>

<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/PayRoll/SalaryReleaseRepost.js"></script>
<script>
    $(document).ready(function () {
        GetList(0);
    });
</script>

<style>

    textarea.form-control {
        height: 60px !important;
        PADDING: 8PX;
    }
</style>


<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->

        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Salary Release Bank Statement Repost and Approval</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                       Salary Release Bank Statement Repost and Approval
                    </li>
                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items  ">
                                <div class="form-group filter-combobox mr-2" style="width: 200px;">
                                    @Html.DropDownListFor(model => model.PayrollMonth.Code, (SelectList)ViewBag.Period, new { @class = "form-control form-control-sm", @onchange = "GetList(currentTab);validate(this,'Period')" })
                                    <span id="Period"></span>
                                </div>

                            </div>
                            <div class="tab-items  ">
                                <div class="form-group filter-combobox mr-2" style="width: 200px;">
                                   @Html.DropDownListFor(m => m.ReportFormat, (SelectList)ViewBag.ReportFormat, new { @class = "form-control form-control-sm", @style = "width:200px;", @onchange = "GetList(currentTab)" })
                                    <span id="RptFormat"></span>
                                </div>

                            </div>
                            
                            <div class="tab-items">
                                <span class="btn-title active tab1" onclick="OnTabClick('tab1',0,'Reposting')">
                                    Reposting
                                    <span class="btn-notification Repost_Count">@Model.RepostingCount</span>
                                </span>
                            </div>
                            <div class="tab-items medium">
                                <span class="btn-title tab2" onclick="OnTabClick('tab2',1,'Approval Pending')">
                                    Approval Pending
                                    <span class="btn-notification Pending_Count">@Model.PendingCount</span>
                                </span>
                            </div>
                            <div class="tab-items select-option">
                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm" placeholder="ID/Name">
                                </div>

                            </div>


                        </div>
                    </div>
                    @using (Html.BeginForm("", "", FormMethod.Post, new { @id = "Reposting" }))
                    {
                        <!-- Table Section -->
                        <div id="RepostList">
                            @await Html.PartialAsync("_RepostingList")
                        </div>
                    }
                    <!-- Table Setion End -->
                    <div class="row card-footer-bottom-fixed">
                    </div>
                    <!--end: Datatable-->


                </div>

            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>

</div>
<!--end::Content-->
<!--end::Entry-->
