@model Hrms.Lite.Shared.PayRoll.PFSettings

@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "ApplicableAllowanceSave" }))
{

    <div class="ihits-table table-border mobile-responsive-table mb-5 vertical-scroll-250 pf-settings-allowance" style="padding:10px;">
        <table>
            <thead>
                <tr class="table-light">
                    <th scope="col">Allowance</th>

                    <th scope="col">Y/N</th>
                    <th scope="col">Applicable</th>



                </tr>
            </thead>
            <tbody>
                @if (Model.PFApplicableAllowance != null && Model.PFApplicableAllowance.Count > 0)
                {

                    for (int i = 0; i < Model.PFApplicableAllowance.Count; i++)
                    {
                <tr>
                    @Html.HiddenFor(m => m.PFDeduction.Code)
                    @Html.HiddenFor(m => m.PFGroup.Code)
                    <td data-label="">
                        @Html.HiddenFor(m => m.PFApplicableAllowance[i].AllowanceCode)
                        @Html.HiddenFor(m => m.PFApplicableAllowance[i].AllowanceName)

                        @Model.PFApplicableAllowance[i].AllowanceName
                    </td>

                    <td data-label="">


                        <div class="checkbox-inline">
                            <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary">
                                @Html.CheckBoxFor(m => m.PFApplicableAllowance[i].YN, new { @onchange = "onCheckboxClick('" + i + "')" })
                                <span></span>
                            </label>

                        </div>


                    </td>
                    <td data-label="">



                        <div class="form-group">

                            @Html.TextBoxFor(m => m.PFApplicableAllowance[i].Applicable, new { @class = "form-control form-control-sm" })
                        </div>

                    </td>

                </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div style="margin-top: 10px;">

        <div class="col-md-12 align-right mb-3">

            <a type="button" class="btn btn-default  mobile-full-width" onclick="applicableAllowanceSave()">
                Save
            </a>
        </div>


    </div>
}