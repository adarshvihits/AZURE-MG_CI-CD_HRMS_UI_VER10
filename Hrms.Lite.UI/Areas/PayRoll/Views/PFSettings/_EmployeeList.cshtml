@model Hrms.Lite.Shared.PayRoll.PFSettings
@*<script src="~/js/settings.js"></script>*@
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table pf-settings-list">
    @Html.HiddenFor(m => m.PFSettingsList.Count)
    <table id="EmpList" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>

                <th scope="col">PF Group</th>
                <th scope="col">PF No</th>
                <th scope="col">UAN No</th>


                <th scope="col">EPF%</th>
                <th data-bs-toggle="tooltip" title="Employee Pension scheme" scope="col">EPS%</th>
                <th data-bs-toggle="tooltip" title="Employer PF" scope="col">ERPF%</th>
                <th scope="col">VPF%</th>
                <th scope="col">VPF Amt</th>
                <th scope="col">Min Limit</th>
                <th scope="col">Emp Max Limit</th>
                <th scope="col" data-bs-toggle="tooltip" title="Employer Max Limit">ER Max Lim</th>
                <th scope="col">Action</th>
            </tr>
        </thead>
        <tbody>
            @*@if (Model.PFSettingsList != null && Model.PFSettingsList.Count > 0)
