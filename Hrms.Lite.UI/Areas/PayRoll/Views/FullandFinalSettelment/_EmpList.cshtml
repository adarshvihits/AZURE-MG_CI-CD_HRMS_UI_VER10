@model Hrms.Lite.Shared.PayRoll.FullandFinalSettelment
    <script src="~/js/settings.js"></script>
    <div class="ihits-table table-border hover-color  odd-even mobile-responsive-table full-finalsettlements">
        @Html.HiddenFor(m => m.EmployeeList.Count)
        <table id="FFEmployeeList" class="common-table">
            <thead>
                <tr class="table-dark">
                    <th scope="col">ID</th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">Designation</th>
                    <th scope="col">Department</th>
                    <th scope="col">Location</th>
                    <th scope="col">Resignation Date</th>
                    @*<th scope="col" data-bs-toggle="tooltip" title=""
                        data-bs-original-title="Last Working Day">LWD</th>
                    <th scope="col">Held Amount</th>
                    <th scope="col" data-bs-toggle="tooltip" title=""
                        data-bs-original-title="Last Salary Processed Month">Last Sal. Pro. Month </th>
                    <th scope="col">Aging</th>*@

                </tr>
            </thead>
            <tbody>
                @if (Model.EmployeeList != null && Model.EmployeeList.Count > 0)
                {

                    for (int i = 0; i < Model.EmployeeList.Count; i++)
                    {
                        <tr>
                            <td data-label="ID">
                                @Html.HiddenFor(m => m.EmployeeList[i].EmployeeGI)
                                @Html.HiddenFor(m => m.EmployeeList[i].EmployeeCode)
                                @Html.HiddenFor(m => m.EmployeeList[i].AttnProcessingValidation)
                                @Html.HiddenFor(m => m.EmployeeList[i].SalProcessingValidation)
                                @Model.EmployeeList[i].EmployeeID
                            </td>
                            <td data-label="Name">

                                @*<a href="@Url.Action("Create", "FullandFinalSettelment", new {EmployeeGI =Model.EmployeeList[i].EmployeeGI,  Area = "PayRoll" })">@Model.EmployeeList[i].EmployeeName</a>*@
                                <a onclick="onEmpClick('@Model.EmployeeList[i].EmployeeGI',@i)">@Model.EmployeeList[i].EmployeeName</a>
                            </td>
                            <td data-label="Designation"> @Model.EmployeeList[i].Designation</td>
                            <td data-label="Department"> @Model.EmployeeList[i].Department</td>
                            <td data-label="Location"> @Model.EmployeeList[i].Location</td>
                            <td data-label="Resignation Date ">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.EmployeeList[i].ResignationDate))</td>
                            @*<td data-label="LWD"> @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.EmployeeList[i].LWD))</td>
                            <td data-label="Held Amount "> @Model.EmployeeList[i].HeldAmount</td>
                            <td data-label="Last Salary Processed Month"> @Model.EmployeeList[i].LastProcessingMonth</td>
                            <td data-label="Aging"> @Model.EmployeeList[i].Aging</td>*@

                        </tr>

                    }
                }



            </tbody>
        </table>
    </div>