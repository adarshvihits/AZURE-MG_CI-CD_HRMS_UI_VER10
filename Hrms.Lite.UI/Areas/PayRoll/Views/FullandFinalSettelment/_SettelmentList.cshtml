<div class="ptag">

    <div class="row ">

        <div class="col-md-6">
            <div class="form-group">
                <label>Remarks<span class="Mandatory">*</span></label>
                @Html.TextAreaFor(m => m.Details.Remarks, new { @class = "form-control form-control-sm", @placeholder = "Description", @maxlength = "120", @onblur = "validate(this,'ffRemarks')" })
                <span id="ffRemarks"></span>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-group">
                <label class="view-title">
                    Notice Period Refund
                </label>
                <div class="view-details">
                    <span id="refud"> @Model.Details.NoticePeriodRefund</span>

                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="form-group">
                <label class="view-title finalSettlementLabel">
                    Final Settlement Amount
                    Payable
                </label>
                <div class="view-details">
                    <span id="finalsettamt"> @Model.Details.FinalSettlementAmountPayable</span>@Html.HiddenFor(m => m.Details.FinalSettlementAmountPayable)

                </div>
            </div>
        </div>





    </div>
</div>