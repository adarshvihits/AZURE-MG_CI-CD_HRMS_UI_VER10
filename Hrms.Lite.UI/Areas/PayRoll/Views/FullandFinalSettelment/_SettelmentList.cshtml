@model Hrms.Lite.Shared.PayRoll.FullandFinalSettelment
<hr>
<div class="ptag">
    <div class="row ">

        <div class="col-md-3">
            <div class="form-group">
                <label class="view-title">Salary For The Month</label>
                <div class="view-details">
                    @Model.Details.SalaryForTheMonth
                </div>
            </div>
        </div>

    </div>
    <div class="row my-2">
        <div class="col-md-12">
            <div class="row">
                <div class="col-md-6">


                    <div class="ihits-table table-border  mobile-responsive-table full-final-tab new-vertical-scroll-100">
                        <table>
                            <thead>
                                <tr class="table-dark">
                                    <th scope="col">Allowance</th>
                                    <th scope="col">Actual Amount</th>
                                    <th scope="col">Earnings</th>

                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Details.Allowance != null && Model.Details.Allowance.Count > 0)
                                {
                                    @for (int i = 0; i < Model.Details.Allowance.Count; i++)
                                    {
                                    <tr>
                                        
                                         @Html.HiddenFor(Model=>Model.Details.Allowance[i].Code)
                                         @Html.HiddenFor(Model=>Model.Details.Allowance[i].Description)
                                         @Html.HiddenFor(Model=>Model.Details.Allowance[i].ActualAmount)
                                        <td data-label="Allowance">@Model.Details.Allowance[i].Description</td>
                                        <td data-label="Actual Amount">
                                            @Model.Details.Allowance[i].ActualAmount
                                        </td>
                                        <td data-label="Earnings">
                                            @Model.Details.Allowance[i].Earning
                                        </td>


                                    </tr>
                                    }
                                }
                                else
                                {
                                <tr>
                                    <td>No data found</td>
                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <!-- <end></end> -->
                <div class="col-md-6">


                    <div class="ihits-table table-border  mobile-responsive-table full-final-deduction new-vertical-scroll-100">
                        <table>
                            <thead>
                                <tr class="table-dark">
                                    <th scope="col"> Deduction</th>
                                    <th scope="col">Amount</th>


                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Details.Deduction != null && Model.Details.Deduction.Count > 0)
                                {
                                        @for (int i = 0; i < Model.Details.Deduction.Count; i++)
                                        {
                                <tr>
                                    @Html.HiddenFor(Model => Model.Details.Deduction[i].Code)
                                    @Html.HiddenFor(Model => Model.Details.Deduction[i].Description)
                                    @Html.HiddenFor(Model => Model.Details.Deduction[i].ActualAmount)

                                    <td data-label=" Deduction"> @Model.Details.Deduction[i].Description </td>
                                    <td data-label="Amount">
                                        @Model.Details.Deduction[i].Earning

                                    </td>



                                </tr>
                                        }
                                }
                                else
                                {
                                <tr>
                                    <td>No data found</td>
                                </tr>
                                }
                                @*<tfoot>
            <tr style=" position: sticky; bottom: 0;"
                class="table-light attendance-table-footer">
                <td data-label="Allowance">
                    <strong>
                        Total
                        Deduction
                    </strong>
                </td>

                <td data-label="Actual Amount">
                    <strong>5000</strong>
                </td>





            </tr>
        </tfoot>*@



                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row ">

        <div class="col-md-2">
            <div class="form-group">
                <label class="view-title">Earned Gross</label>
                <div class="view-details">
                    @Model.Details.EarnedGross
                </div>
            </div>
        </div>

        <div class="col-md-2">
            <div class="form-group">
                <label class="view-title">Total Deduction</label>
                <div class="view-details">
                    @Model.Details.TotalDeduction @Html.HiddenFor(m => m.Details.TotalDeduction)
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <label class="view-title">Net Payable</label>
                <div class="view-details">
                    @Model.Details.NetPayable @Html.HiddenFor(m => m.Details.NetPayable)
                </div>
            </div>
        </div>
       

        <div class="col-md-2">
            <div class="form-group">
                <label class="view-title"> Held Amount</label>
                <div class="view-details">
                    <a data-bs-toggle="modal"
                       data-target=".PF_settings_applicable" type="button"
                       type="button"
                       class="float-left mobile-full-width mr-3">
                        @Model.Details.HeldAmount
                    </a>



                    <div class="modal fade PF_settings_applicable"
                         tabindex="-1" role="dialog"
                         aria-labelledby="myLargeModalLabel"
                         aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content popup "
                                 style="height:300px ;">
                                <div class="modal-header"
                                     style="padding:10px">
                                    <h5 class="modal-title"
                                        id="exampleModalLabel">
                                        Held Amount Details
                                    </h5>
                                    <button type="button" class="close"
                                            data-bs-dismiss="modal"
                                            aria-label="Close">
                                        <i aria-hidden="true"
                                           class="ki ki-close"></i>
                                    </button>
                                </div>
                                <div class="ihits-table table-border hover-color odd-even mobile-responsive-table held-amount-details new-vertical-scroll-100">
                                    <table>
                                        <thead>
                                            <tr class="table-dark">

                                                <th scope="col">Month</th>
                                                <th scope="col">
                                                    Held Amount
                                                </th>
                                                <th scope="col">
                                                    Remarks
                                                </th>


                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.HeldAmountDetaisl != null && Model.HeldAmountDetaisl.Count > 0)
                                            {

                                                for (int i = 0; i < Model.HeldAmountDetaisl.Count; i++)
                                                {
                                                    <tr>

                                                        <td data-label="Month">
                                                            @Model.HeldAmountDetaisl[i].Month
                                                        </td>
                                                        <td data-label="Held Amount">
                                                            @Model.HeldAmountDetaisl[i].Amount
                                                        </td>
                                                        <td data-label="Remarks">
                                                            @Model.HeldAmountDetaisl[i].Remarks
                                                        </td>

                                                    </tr>
                                                }
                                            }
                                            @*<tfoot>
                                                <tr style=" position: sticky; bottom: 0;"
                                                    class="table-light">
                                                    <td data-label="Month">
                                                        <strong>Total</strong>
                                                    </td>

                                                    <td data-label="Held Amount">
                                                        <strong>937</strong>
                                                    </td>



                                                </tr>
                                            </tfoot>*@
                                        </tbody>
                                    </table>
                                </div>
                                <!-- <end table></end> -->



                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <label class="view-title">Notice Period Deduction</label>
                <div class="view-details">
                    <span id="npded">@Model.Details.NoticePeriodDeduction @Html.HiddenFor(m => m.Details.NoticePeriodDeduction)</span>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="form-group">
                <label class="view-title">Leave Encashment</label>
                <div class="view-details">


                    <span id="Encash">@Model.Details.LeaveEncashment @Html.HiddenFor(m => m.Details.LeaveEncashment)</span>

                </div>
            </div>
        </div>


    </div>
