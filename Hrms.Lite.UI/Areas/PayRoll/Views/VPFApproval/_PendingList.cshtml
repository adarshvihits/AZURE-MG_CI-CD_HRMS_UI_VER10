@model Hrms.Lite.Shared.PayRoll.VPFApproval

<script>
    $(document).ready(function () {
        $('.pending_Count').html(@Model.pendingCount);
        $('.approved_Count').html(@Model.approvedCount);
    });
</script>


<div class="ihits-table table-border mobile-responsive-table VPFApprovalActiveList vertical-scroll-400">
    @Html.HiddenFor(m => m.VPFApprovalList.Count)
    <table id="pendingTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Function </th>
                <th scope="col">Location</th>
                <th scope="col">Modified Date</th>
                <th scope="col">VPF Amount Old</th>
                <th scope="col">VPF Amount New</th>
                <th scope="col">
                    <div class="checkbox-inline selectAllChkBx">
                        <label class="checkbox checkbox-outline checkbox-success">
                            <input data-val="true" value="true" id="SelectAll" name="SelectAll" type="checkbox" onchange="onSelectAllClick()">
                            <span cursorshover="true"></span>
                        </label>
                    </div>
                </th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.VPFApprovalList != null && Model.VPFApprovalList.Count > 0)
            {
                for (int i = 0; i < Model.VPFApprovalList.Count; i++)
                {

                    @Html.HiddenFor(Model => Model.VPFApprovalList[i].EmployeeGI)
                    @Html.HiddenFor(Model => Model.VPFApprovalList[i].EmployeeCode)
                    <tr>

                        <td data-label="ID">@Model.VPFApprovalList[i].EmployeeID</td>
                        <td data-label="Employee Name">@Model.VPFApprovalList[i].EmployeeName</td>
                        <td data-label="Function">@Model.VPFApprovalList[i].Function</td>
                        <td data-label="Location">@Model.VPFApprovalList[i].Location</td>
                        <td data-label="Modified Date">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.VPFApprovalList[i].ModifiedDate))</td>
                        <td data-label="VPF Amount Old">@Model.VPFApprovalList[i].oldVpfAmount</td>
                        <td data-label="VPF Amount New">@Model.VPFApprovalList[i].newVpfAmount</td>
                        <td data-label="Action">
                            <div class="checkbox-inline ">
                                <label class="checkbox checkbox-outline checkbox-success">
                                    @Html.CheckBoxFor(m => m.VPFApprovalList[i].Applicability)
                                    <span></span>
                                </label>
                            </div>
                        </td>
                    </tr>

                }
            }


        </tbody>
    </table>
</div>
<div class="row card-footer-bottom-fixed">
    <div class="col-md-12 align-right">
        <a type="button"
           class="btn btn-default mobile-full-width" onclick="onApproveClick()">
            Approve
        </a>
    </div>

</div>