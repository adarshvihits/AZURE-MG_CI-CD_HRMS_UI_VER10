@model Hrms.Lite.Shared.PayRoll.VPFApproval
@{ ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/PayRoll/vpfApproval.js"></script>

<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">VPF Approval</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        VPF Approval
                    </li>
                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "Approve_vpf" }))
{
    <!--begin::Content-->
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body">

                        <!--begin: Search Form-->


                        <div class="row tab-style-button">
                            <div class="tab-button-wrap">
                                <div class="tab-items  ">
                                    <div class="form-group filter-combobox mr-2" style="width: 200px;">

                                        @Html.DropDownListFor(m => m.FinancialYear.Code, (SelectList)ViewBag.Financialyear, "--Select Financial Year--", new { @class = "form-control form-control-sm Dmonth", @onchange = "validate(this,'FyFill');GetList()" })
                                        <span id="FyFill"></span>
                                    </div>

                                </div>
                                <div class="tab-items">
                                    <span class="btn-title active Tab1" onclick="OnTabClick('Tab1','Pending')">
                                        Pending
                                        <span class="btn-notification pending_Count">@Model.pendingCount</span>
                                    </span>
                                </div>
                                <div class="tab-items medium">
                                    <span class="btn-title Tab2" onclick="OnTabClick('Tab2','Approved')">
                                        Approved
                                        <span class="btn-notification approved_Count">@Model.approvedCount</span>
                                    </span>
                                </div>
                                <div class="tab-items select-option">
                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search" onclick="$('#searchList').focus();"></i>
                                        </div>
                                        <input id="searchList" type="text" class="form-control form-control-sm"
                                               placeholder="Search Here" onkeyup="searchRows()">
                                    </div>
                                    <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left" data-bs-original-title="Export to Excel" onclick="ExportToExcel()">
                                        <i class="icon-xl far fa-file-excel"></i>
                                    </a>
                                </div>


                            </div>
                        </div>


                        <div id="ApprovalList">
                            @await Html.PartialAsync("_Pendinglist")
                        </div>

                        <!--end: Datatable-->
                       

                    </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>
}