


@model Hrms.Lite.Shared.PayRoll.SendPayslip
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>

<script src="~/scripts/PayRoll/sendPayslip.js"></script>


<style>
    .playslip_note {
        padding-top: 15px;
        color: red;
    }

        .playslip_note span {
            padding-left: 3px;
        }
</style>
<div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->


            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Send Payslip</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            Send Payslip
                        </li>
                    </ul>
                </div>
            </div>
            <!--begin::Topbar-->
            <div class="topbar">


            </div>
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->
    
        <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
            <!--begin::Entry-->
            <div class="d-flex flex-column-fluid">
                <!--begin::Container-->
                <div class="container full-width">
                    <!--begin::Dashboard-->
                    <!--begin::Row-->



                    <div class="card card-custom height-100per footer-row-fixed">

                        <div class="card-body">
                            <!--begin: Search Form-->
                            @using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "Send_PaySlip" }))
                            {
                                <div class="row tab-style-button">
                                    <div class="tab-button-wrap align-items-center">

                                        <div class="tab-items">

                                            <div class="row-outer pb-2">
                                                @Html.DropDownListFor(m => m.Month.Code, (SelectList)ViewBag.currMonth, "--Month--", new { @class = "form-control form-control-sm", @onchange = "GetList()" })

                                            </div>
                                        </div>
                                        <div class="tab-items pl-3">

                                            <div class="row-outer pb-2">
                                                @Html.DropDownListFor(m => m.PayGroup.Code, (SelectList)ViewBag.Pgroup, "--Payroll Group--", new { @class = "form-control form-control-sm", @onchange = "GetList()" })


                                            </div>
                                        </div>

                                        <div class="pl-8 d-flex align-items-center">
                                            <div class="radio-inline pt-4">
                                                <label class="radio radio-outline radio-success mr-10">
                                                    @Html.RadioButtonFor(m => m.Type, "2", new { @onchange = "GetList()" })
                                                    <span></span>All
                                                </label>
                                                <label class="radio radio-outline radio-success">
                                                    @Html.RadioButtonFor(m => m.Type, "1", new { @onchange = "GetList()" })
                                                    <span></span>Payslip Send
                                                </label>
                                                <label class="radio radio-outline radio-success">
                                                    @Html.RadioButtonFor(m => m.Type, "0", new { @onchange = "GetList()" })
                                                    <span></span>Payslip not Send
                                                </label>

                                            </div>
                                        </div>
                                        <div id="testOT" class="hide">
                                            <table id="overtimeApprovalTableTwo">
                                                <thead>
                                                    <tr class="table-dark">

                                                        <th scope="col">ID </th>
                                                        <th scope="col">Employee Name </th>
                                                        <th scope="col">Designation</th>
                                                        <th scope="col">Department</th>
                                                        <th scope="col">Location</th>
                                                        <th scope="col">Shift</th>
                                                        <th scope="col">IN</th>
                                                        <th scope="col">OUT</th>
                                                        <th scope="col">Total Time</th>
                                                        <th scope="col">Mail</th>
                                                        <th scope="col" data-bs-toggle="tooltip" title="Overtime Hours">OT Hours</th>
                                                        <th scope="col" data-bs-toggle="tooltip" title="Overtime Minutes">OT Minutes</th>

                                                        <th scope="col"></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                </tbody>
                                            </table>
                                        </div>
                                        <div class="tab-items select-option high">

                                            <div class="sraech-slider">
                                                <div class="search-slider-inner">
                                                    <i class="fa fa-search"></i>
                                                </div>
                                                <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                                       placeholder="ID/Name">
                                            </div>

                                            <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                                <i class="fas fa-filter"></i>
                                                <i class="fas fa-check"></i>
                                            </div>
                                            <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                               data-bs-original-title="Export to Excel">
                                                <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                            </a>


                                        </div>


                                    </div>
                                </div>
                                <div id="LIST_ID">
                                    @await Html.PartialAsync("_List", Model)
                                </div>
                            }
                            <div id="filterSlider">
                                @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.filter)
                            </div>
                            <div class="playslip_note">Note:<span>Payslip generation will take a few minutes. Feel free to exit the form while the payslip is being generated.</span></div>
                            <!--end: Datatable-->
                            <div class="row card-footer-bottom-fixed">


                                <div class="col-md-12 payslipbutton">
                                    <a type="button" class="btn btn-default float-right mobile-full-width" onclick="SendPaySlip()">
                                        Send PaySlip
                                    </a>


                                </div>


                            </div>
                        </div>
                    </div>


                    <!--end::Row-->
                    <!--begin::Row-->
                    <!--end::Row-->
                    <!--end::Dashboard-->
                </div>
                <!--end::Container-->
            </div>
            <!--end::Entry-->

        </div>
    
</div>


