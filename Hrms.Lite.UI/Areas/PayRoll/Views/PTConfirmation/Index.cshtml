@model Hrms.Lite.Shared.PayRoll.PTConfirmation
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>


<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/PayRoll/PTConfirmation.js"></script>
<script>
    $(document).ready(function () {
        fillData();
    });
</script>
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">PT Confirmation</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        PT Confirmation
                    </li>

                </ul>
            </div>
        </div>

        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                    <div class="mobile-tab-section">
                        @*<div class="row mb-2">
                <div class="col-6">
                    <div class="form-group">
                        <label>Month</label>
                            @Html.DropDownListFor(m => m.PTMonth.Code, (SelectList)ViewBag.Month, "--Select--", new { @class = "form-control form-control-sm", @onblur = "validate(this,'PtMth')", @onchange = "$('.RMonth').val($('#PTMonth_Code').val());GetList()" })
                    <span id="PtMth"></span>
                    </div>
                </div>
                <div class="col-6" id="assetFilter">
                    <div class="form-group">
                        <label>Deduction</label>
                            @Html.DropDownListFor(m => m.Deduction.Code, (SelectList)ViewBag.Deduction, "--Select--", new { @class = "form-control form-control-sm", @onblur = "validate(this,'Dedtn')", @onchange = "$('.RDeduction').val($('#Deduction_Code').val());GetList()" })
                    <span id="Dedtn"></span>
                    </div>
                </div>
            </div>*@
                    </div>
                    <!--begin: Search Form-->
                    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "ptConfirmationUpload", enctype = "multipart/form-data" }))
                    {
                        <div class="row tab-style-button">
                            <div class="tab-button-wrap">
                                <div class="tab-items ml-5 pr-0 border-none select-option " style="margin-left:0px !important;">
                                    <div class="form-group filter-combobox mr-2" style="width: 142px;">
                                        @Html.DropDownListFor(m => m.PTMonth.Code, (SelectList)ViewBag.Month, "--Select--", new { @class = "form-control form-control-sm RMonth", @onblur = "validate(this,'RPtMth')", @onchange = "fillData()" })
                                        <span id="RPtMth"></span>
                                    </div>
                                </div>
                                <div class="tab-items ml-5 pr-0 border-none select-option">
                                    <div class="form-group filter-combobox mr-10">
                                        @Html.DropDownListFor(m => m.Deduction.Code, (SelectList)ViewBag.Deduction, "--Select--", new { @class = "form-control form-control-sm RDeduction", @onchange = "fillData()" })
                                        <span id="RDedtn"></span>
                                    </div>
                                </div>


                                <!-- <batch updates></batch> -->
                                <div class="tab-items pr-0 border-none">
                                    <div class="button-group float-left  batchleave mr-10">


                                    </div>
                                </div>

                                <!-- <batch updates></batch> -->







                                <div class="tab-items select-option d-flex">



                                    <div>
                                        <div class="sraech-slider">
                                            <div class="search-slider-inner">
                                                <i class="fa fa-search"></i>
                                            </div>
                                            <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                                   placeholder="ID/Name">
                                        </div>
                                    </div>
                                    <div>
                                        <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                            <i class="fas fa-filter"></i>
                                            <i class="fas fa-check"></i>
                                        </div>
                                    </div>
                                    <div>
                                        <a data-bs-toggle="tooltip" title="Export to Excel"
                                           class="btn btn-excel mr-0" onclick="ExportToExcel()">
                                            <i class="icon-xl far fa-file-excel"></i>
                                        </a>
                                    </div>
                                    <div>
                                        <button type="button" data-bs-toggle="tooltip" title="Import From Excel"
                                                class="btn btn-excel ml-0 import" onclick="validateDeductionDropdowns()">
                                            <i class="fa fa-upload icon-xls" aria-hidden="true"></i>
                                        </button>
                                    </div>




                                </div>


                            </div>
                        </div>

                        <div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
                            <div class="modal-dialog modal-lg">
                                <div class="modal-content popup">
                                    <div class="modal-header" style="padding:10px">
                                        <h5 class="modal-title" id="exampleModalLabel">Upload Format</h5>
                                        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close" onclick="$('#Unmatched').html('');$('#Excel_FileData').val()">
                                            <i aria-hidden="true" class="ki ki-close"></i>
                                        </button>
                                    </div>

                                    <div class="modal-body pt-3">
                                       
                                        <div class="colums_list pb-1">
                                            Please ensure your Excel file contains the following columns with the exact headings. Spelling and case must match precisely for a successful import -

                                            Employee ID,
                                            Employee Name,
                                            Amount<br />
                                            @*Columns Needed :- Employee ID, Employee Name, Amount*@
                                        </div>
                                        <div class="row">
                                            <div class="col-md-4">
                                                <div class="file-upload-form-group">
                                                    <label for="formFileMultiple" class="form-label">
                                                        Attach
                                                        File
                                                        <span class="Mandatory">*</span>
                                                    </label>

                                                    <div class="file-upload-form mb-1" data-bs-toggle="tooltip" data-bs-original-title=" Only pdf, doc, docx files are
                                            allowed , File size less than 1 MB.">
                                                        <div class="small-btn-group">

                                                            <button type="button" data-bs-toggle="tooltip" data-placement="top" data-bs-original-title="View Image" class="btn btn-icon btn-default"><i class="icon-xl far fa-eye"></i></button>

                                                        </div>
                                                        <input id="File_AbsoluteUri" name="File.AbsoluteUri" type="hidden" value="">
                                                        @*<input accept=".png, .jpg, .jpeg, .pdf" id="File_FileData" name="File.FileData" onchange="CheckImageExtensionSize(this)" title="" type="file">*@
                                                        @Html.HiddenFor(model => model.Excel.FileData, new { type = "file", @class = "input-file PreviewImage form-control h-100", @onchange = "onImportExcelClick()" })

                                                    </div>


                                                </div>

                                              
                                            </div>
                                            
                                        </div>
                                         
                                       
                                        <div id="Unmatched">

                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }

                        <div id="filterSlider">
                            @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
                        </div>

                        <!-- Table Section -->
                        @using (Html.BeginForm("PTConfirmationSave", "PTConfirmation", FormMethod.Post, new { @id = "PTConfirmation" }))
                        {
                            <div id="ptConfirmationList">
                                @await Html.PartialAsync("_PTConfirmationList")
                            </div>
                            <!-- Table Setion End -->
                            @*<div class="row card-footer-bottom-fixed">
                    <div class="col-md-12 mt-1">
                        <span class="display-inline-block mr-6">
                            Employees with
                            Allowance: <span id="empWithAmt"></span>/<span id="totEmpCnt">0</span>
                        </span>
                        <span>Total Amount: <span id="totAmt"></span></span>
                    </div>


                </div>*@

                            <div class="row card-footer-bottom-fixed">
                                <div class="col-md-6 mt-1">
                                    <span class="display-inline-block mr-6 footerDiv textDisplay">
                                        Employees with
                                        Allowance: <span id="empWithAmt"></span>/<span id="totEmpCnt">0</span>
                                    </span>
                                    <span class="footerDiv textDisplay">Total Amount: <span id="totAmt"></span></span>
                                </div>
                                <div class="col-md-6 ">
                                    <div class="d-flex justify-content-end">


                                        <a id="addPlanning" type="button"
                                           class="btn btn-default mobile-full-width" onclick="PTConfirmationSave()">
                                            Confirm
                                        </a>
                                    </div>


                                </div>

                            </div>

                        }
                        <!--end: Datatable-->
                    </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
<!--end::Content-->
