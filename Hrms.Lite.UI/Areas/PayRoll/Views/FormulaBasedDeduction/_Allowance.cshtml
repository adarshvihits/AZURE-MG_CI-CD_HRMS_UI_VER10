@model Hrms.Lite.Shared.PayRoll.FormulaBasedDeduction
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table deduction-formula vertical-scroll-350">
    <table>
        <thead>
            <tr class="table-dark">
                <th scope="col"> Allowance</th>
                <th scope="col">
                    Y / N
                </th>
                <th scope="col">App %</th>




            </tr>
        </thead>
        <tbody>
            @if (Model.Substraction != null && Model.Substraction.Count > 0)
            {

                for (int i = 0; i < Model.Substraction.Count; i++)
                {
                    <tr>
                        <td data-label="Deduction">@Html.HiddenFor(m => m.Substraction[i].DeductionCode)
                        @Html.HiddenFor(m => m.Substraction[i].Type) 
                        @Model.Substraction[i].DeductionName</td>
                        <td data-label="Y / N">
                            <div class="checkbox-inline justify-content-center">
                                <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                    @Html.CheckBoxFor(m => m.Substraction[i].YN)
                                    <span></span>
                                </label>
                            </div>
                        </td>
                        <td data-label="App %">
                            @Html.TextBoxFor(m => m.Substraction[i].Percentage, new { @class = "form-control form-control-sm", @placeholder = "App %", @onkeypress = "return onlyNumberKey(event)" })
                        </td>


                    </tr>
                }
            }

                </tbody>
    </table>
</div>