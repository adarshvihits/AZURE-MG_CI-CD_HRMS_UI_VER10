@model Hrms.Lite.Shared.PayRoll.FormulaBasedDeduction
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>
<script src="~/scripts/PayRoll/formulaBasedDeduction.js"></script>
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->
            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">
                        Formula Based Deduction
                    </h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>
                        <!-- <li class="breadcrumb-item text-muted">
                            <a href="financial-year.html">Financial Year List</a>
                          </li> -->
                        <li class="breadcrumb-item text-muted">
                            Formula Based Deduction

                        </li>

                    </ul>
                </div>
            </div>


            <!--end::Topbar-->
        </div>

    </div>



    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->

                <div class="row height-100per">

                    <div class="col-md-12">
                        <div class="card card-custom height-100per">

                            <div class="card-body p-5 pb-13 pt-0">
                                <div class="row tab-style-button">
                                    <div class="tab-button-wrap">

                                        <div class="form-group filter-combobox pt-2 pl-2" style="width: 200px;">
                                            <label>Deduction</label>
                                            @Html.DropDownListFor(m => m.Deduction.Code, (SelectList)ViewBag.Deduction, "--SELECT Deduction--", new { @class = "form-control form-control-sm" ,@onchange= "onDeductionChange();validate(this,'dCode')" })
                                            <span id="dCode"></span>
                                        </div>




                                        <div class="tab-items select-option lows">



                                        </div>



                                    </div>
                                </div>
                              <div id="DedAndAlwDiv">
                                  @await Html.PartialAsync("_DeductionAndAllowance")
                              </div>
                            </div>
                        </div>
                    </div>

                    <!--
                    <end col-12></end> -->



                </div>




                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->
    </div>
    <!--end::Content-->

   

