@model Hrms.Lite.Shared.PayRoll.FormulaBasedDeduction
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "formulaBasedDeductionSave" }))
{
    <div class="row tab-style-button">
        <div class="col-md-6">
            @Html.HiddenFor(m => m.Deduction.Code)
            <div class="addition">
                <h3>Addition</h3>
            </div>
            <!-- Table Section -->



            <div id="deductionDiv">
                @await Html.PartialAsync("_Deduction")
            </div>

        </div>


        <div class="col-md-6">
            <div class="addition">
                <h3>Substraction</h3>
            </div>

            <!-- Table Section -->



            <div id="allowanceDiv">
                @await Html.PartialAsync("_Allowance")
            </div>
            <!-- Table Setion End -->


        </div>
        <div class="row card-footer-bottom-fixed border-none pb-5">
            <div class="col-md-4">
                <div >
                    <div class="form-group filter-combobox pt-2 pl-2 d-flex align-items-center">
                        <label class="pr-2">Operations</label>
                        <div style="position:relative;">


                            @Html.DropDownListFor(m => m.Operations.Code, (SelectList)ViewBag.Operations, "--Select--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'oCode')" })
                            <span id="oCode"></span>
                        </div>
                        <div style="position:relative;" class="ml-3">
                            
                            @Html.TextBoxFor(m => m.Value, new { @class = "form-control form-control-sm ml-3 align-right", @placeholder = "", @onkeypress = "return onlyNumberKey(event)", @onblur = "validate(this,'vals')" })
                            <span id="vals"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-8 align-right align-items-center d-flex justify-content-end " >
                <a type="button"
                   class="btn btn-default  mobile-full-width mt-3" onclick="formulaBasedDeductionSave()">
                    Save
                </a>
            </div>

        </div>
    </div>
}