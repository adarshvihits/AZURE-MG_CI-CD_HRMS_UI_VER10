@model Hrms.Lite.Shared.PayRoll.FormulaBasedDeduction
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table deduction-formula vertical-scroll-350">
    <table>
        <thead>
            <tr class="table-dark">
                <th scope="col"> Deduction</th>
                <th scope="col">
                    Y / N
                </th>
                <th scope="col">App %</th>




            </tr>
        </thead>
        <tbody>
            @if (Model.Addition != null && Model.Addition.Count > 0)
            {

                for (int i = 0; i < Model.Addition.Count; i++)
                {
                    <tr>
                        <td data-label="Deduction">@Html.HiddenFor(m => m.Addition[i].DeductionCode) 
                        @Html.HiddenFor(m => m.Addition[i].Type) 
                        @Model.Addition[i].DeductionName</td>
                        <td data-label="Y / N">
                            <div class="checkbox-inline justify-content-center">
                                <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                    @*<input type="checkbox" name="Checkboxes16">*@
                                    @Html.CheckBoxFor(m => m.Addition[i].YN)
                                    <span></span>
                                </label>
                            </div>
                        </td>
                        <td data-label="App %">
                            @*<input type="text" class="form-control form-control-sm"
                                   placeholder="App %">*@
                            @Html.TextBoxFor(m => m.Addition[i].Percentage, new { @class = "form-control form-control-sm", @placeholder = "App %", @onkeypress = "return onlyNumberKey(event)" })

                        </td>


                    </tr>
                }
            }

                </tbody>
    </table>
</div>