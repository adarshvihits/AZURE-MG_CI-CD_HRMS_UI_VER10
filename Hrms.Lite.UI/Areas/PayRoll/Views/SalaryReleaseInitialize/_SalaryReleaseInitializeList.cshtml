
@model Hrms.Lite.Shared.PayRoll.SalaryReleaseInitialize


<div class="ihits-table table-border hover-color odd-even mobile-responsive-table pt-3 vertical-scroll-400 Salary-Release-Initialize-List">
    <table id="SRInitializeTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">PayRoll Group</th>

                <th scope="col">
                    <div class="checkbox-inline selectAllChkBx" style=" text-align:center;justify-content:center;padding-left:23px; }">
                        <label class="checkbox checkbox-outline checkbox-success">
                            <input data-val="true" value="true" id="SelectAll" name="SelectAll" type="checkbox" onchange="onSelectAllClick()">
                            <span cursorshover="true"></span>
                        </label>
                        <label class="checkbox checkbox-outline checkbox-success"></label>
                    </div>
                </th>

            </tr>
        </thead>
        <tbody>
            @{
                if (Model.SalaryReleaseInitializeList != null && Model.SalaryReleaseInitializeList.Count > 0)
                {
                    for (int i = 0; i < Model.SalaryReleaseInitializeList.Count; i++)

                    {
                        <tr>

                            <td data-label="Location">

                                @Html.HiddenFor(model => model.SalaryReleaseInitializeList[i].PayrollGroup.Code)
                                @Model.SalaryReleaseInitializeList[i].PayrollGroup.Name

                            </td>


                            <td data-label="Appicability">
                                <div class="checkbox-inline d-flex justify-content-center">
                                    <label class="checkbox checkbox-outline checkbox-success">
                                        @Html.CheckBoxFor(model => model.SalaryReleaseInitializeList[i].Applicability)
                                        <span></span>
                                    </label>
                                </div>
                            </td>

                        </tr>

                    }
                }
            }

        </tbody>
    </table>
</div>

