@model Hrms.Lite.Shared.PayRoll.SalaryReleaseInitialize
@{
    ViewData["Title"] = "View";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="~/scripts/PayRoll/SalaryReleaseInitialize.js"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>

<div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->


            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Salary Release Initialize</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index","Home",new { Area=""})"><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            Salary Release Initialize
                        </li>
                    </ul>
                </div>
            </div>
            <!--begin::Topbar-->
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body">
                        <!--begin: Search Form-->
                        @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "SalaryReleaseInitializeSave", enctype = "multipart/form-data" }))
                        {
                            <div class="row tab-style-button">

                                <div class="tab-button-wrap">
                                    <div class="tab-items ml-5 pr-0 border-none select-option">

                                        <div class="form-group filter-combobox mt-0">
                                            @Html.DropDownListFor(m => m.Month, (SelectList)ViewBag.month, "--Select Month--", new { @class = "form-control form-control-sm", @onchange = "GetList()", @style = "width:150px;" })
                                            <span id="Month"></span>
                                        </div>
                                    </div>
                                    <div class="tab-items select-option">

                                        <div class="sraech-slider">
                                            <div class="search-slider-inner">
                                                <i class="fa fa-search" onclick="$('#searchInitializeList').focus();"></i>
                                            </div>
                                            <input id="searchInitializeList" type="text" class="form-control form-control-sm"
                                                   placeholder="Search Here" onkeyup="searchRows()">
                                        </div>


                                    </div>


                                </div>

                                <div class="tab-button-wrap align-items-center">


                                </div>
                            </div>
                            @*@using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "SalaryReleaseInitializeSave" }))
                            {*@

                                <div id="SalaryReleaseInitializeList">
                                    @await Html.PartialAsync("_SalaryReleaseInitializeList")
                                </div>

                                <!--end: Datatable-->
                                <div class="row card-footer-bottom-fixed">

                                    <div class="col-md-12 align-right">
                                        <button type="button"
                                                class="btn btn-default float-right mobile-full-width" onclick="SalaryReleaseInitializeSaveClick()">
                                            Save
                                        </button>

                                    </div>
                                </div>
                            }
                        </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>
    <div class="slider-over-flow"></div>
    <!--end::Content-->

</div>
