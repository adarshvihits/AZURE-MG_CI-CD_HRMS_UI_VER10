
@model Hrms.Lite.Shared.PayRoll.LeaveEncashmentProcessing

<script src="~/js/settings.js"></script>
@*<style>
        .dataTables_scrollHeadInner table {
            width: 100% !important;
        }
    </style>*@
<div class="ihits-table table-border odd-even  mobile-responsive-table LeaveEncashmentProcessing_list">
    @Html.HiddenFor(m => m.LeaveEncashmentList.Count)
    <table id="Leave_Encashment_list" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation </th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">Leave Days</th>             
                <th scope="col">Amount</th>
               


            </tr>
        </thead>
        <tbody>


            @if (Model.LeaveEncashmentList != null && Model.LeaveEncashmentList.Count > 0)
            {

                for (int i = 0; i < Model.LeaveEncashmentList.Count; i++)
                {


            <tr>
                <td data-label="ID">
                    @Model.LeaveEncashmentList[i].EmployeeID

                    @Html.HiddenFor(m => m.Month)
                    @Html.HiddenFor(m => m.LeaveEncashmentList[i].EmployeeGI)
                    @Html.HiddenFor(m => m.LeaveEncashmentList[i].EmployeeID)
                    @Html.HiddenFor(m => m.LeaveEncashmentList[i].EmployeeCode)
                    @Html.HiddenFor(m => m.LeaveEncashmentList[i].EmployeeName)
                    @Html.HiddenFor(m => m.LeaveEncashmentList[i].Designation)
                    @Html.HiddenFor(m => m.LeaveEncashmentList[i].Department)
                    @Html.HiddenFor(m => m.Allowance)


                </td>
                <td data-label="Name"> @Model.LeaveEncashmentList[i].EmployeeName </td>
                <td data-label="Designation">@Model.LeaveEncashmentList[i].Designation</td>
                <td data-label="Department">@Model.LeaveEncashmentList[i].Department</td>
                <td data-label="Location">@Model.LeaveEncashmentList[i].Location</td>
                <td data-label="Location">
                    @Model.LeaveEncashmentList[i].NoOfLeave
                                @Html.HiddenFor(m => Model.LeaveEncashmentList[i].NoOfLeave)
                            </td>
           
                <td data-label="y/s">@Model.LeaveEncashmentList[i].Amount
                @Html.HiddenFor(m=>Model.LeaveEncashmentList[i].Amount)
                </td>




            </tr>



                }
            }

        </tbody>
    </table>
</div>