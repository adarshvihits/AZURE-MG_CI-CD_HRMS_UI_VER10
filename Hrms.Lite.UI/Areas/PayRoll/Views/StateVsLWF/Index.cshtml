@model Hrms.Lite.Shared.PayRoll.LWFSettings

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@*<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>*@
<script src="~/scripts/PayRoll/stateVsLWF.js"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>

<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    LWF Settings
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href=""><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        LWF Settings

                    </li>

                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body p-5 pb-13 pt-0">

                            <div class="row tab-style-button">
                                <div class="tab-button-wrap">





                                    <div class="tab-items ml-5 pr-0 border-none select-option">
                                        <div class="form-group filter-combobox mr-10">

                                            @Html.DropDownListFor(m => m.DeductionCode, (SelectList)ViewBag.deduction, "--Deduction--", new { @class = "form-control form-control-sm Dname", @onchange = "GetList();validate(this,'deduction')" })
                                            <span id="deduction"></span>
                                        </div>

                                    </div>




                                    <div class="tab-items select-option">

                                        <div class="sraech-slider">
                                            <div class="search-slider-inner">
                                                <i class="fa fa-search"></i>
                                            </div>
                                            <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                                   placeholder="ID/Name">
                                        </div>
                                        <a data-bs-toggle="tooltip" title="Export to Excel"
                                           class="btn btn-excel mr-0" onclick="ExportToExcel()">
                                            <i class="icon-xl far fa-file-excel"></i>
                                        </a>

                                    </div>


                                </div>
                            </div>


                            <div id="listLWF">
                                @await Html.PartialAsync("~/Areas/PayRoll/Views/StateVsLWF/_List.cshtml")

                            </div>

                            <!-- <end table></end> -->
                            <div class="row card-footer-bottom-fixed">



                            </div>

                        </div>

                    </div>


                </div>
            </div>




            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>

<div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg " style="max-width:620px;">
        <div id="myDiv" class="modal-content popup">
            <div class="modal-header">
                <h5 class="modal-title Name" id="exampleModalLabel"></h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body">

            </div>
        </div>
    </div>
</div>
