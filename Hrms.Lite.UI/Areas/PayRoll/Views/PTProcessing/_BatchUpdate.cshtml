
@model Hrms.Lite.Shared.PayRoll.PTProcessing

    <div id="BatchUpdate" class="slider-forms slider-forms-open batchupdateDiv">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('batchupdateDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>
                Batch Update
            </h4>
            <div class="row">

                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Month</label>
                        <div class="view-details">
                            
                            @Html.DisplayFor(Model => Model.Month.Name, "{0:dd-MMM-yyyy}", new { @class = "form-control form-control-sm", @readonly = "true" })
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            PT Group
                        </label>
                        <div class="view-details">
                            @Html.DisplayFor(Model => Model.PTGroup.Name, "{0:dd-MMM-yyyy}", new { @class = "form-control form-control-sm", @readonly = "true" })
                        </div>
                    </div>
                </div>

            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            From
                        </label>
                        <div class="view-details">
                            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.From))
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">To</label>
                        <div class="view-details">
                            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.To))
                        </div>
                    </div>
                </div>


            </div>



            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            No. Of Salary Month
                        </label>
                        <div class="view-details">
                            @Html.DisplayFor(Model => Model.SalaryMonths, "{0:dd-MMM-yyyy}", new { @class = "form-control form-control-sm", @readonly = "true" })
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Duration
                        </label>
                        <div class="view-details">
                            @Html.DisplayFor(Model => Model.Duration, "{0:dd-MMM-yyyy}", new { @class = "form-control form-control-sm", @readonly = "true" })
                        </div>
                    </div>
                </div>



            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">

                        <div class="form-group">
                            <label>Dividing Period</label>
                            @Html.TextBoxFor(Model => Model.PTProcessing_Details.DividingPeriod, new { @class = "form-control form-control-sm" })
                        </div>
                    </div>


                </div>



                <div class="row card-footer-bottom-fixed border-none">

                    <div class="col-md-12 align-right">
                        <a type="button"
                           class="btn btn-default  mobile-full-width">
                            Update
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>

