@model Hrms.Lite.Shared.PayRoll.PTProcessing
    @*<script src="~/js/settings.js"></script>*@
<script src="~/js/tooltip.js"></script>



<div class="ihits-table table-border hover-color mobile-responsive-table pt-processing-list">
    @Html.HiddenFor(m => m.Details.Count)
    <table id="PTprocessingTable" class="common-table" style=" table-layout:auto; margin-left: 0px;">
        <thead>
            <tr class="table-dark">
                <th scope="col" class="basic-col">ID</th>
                <th scope="col" class="basic-col">Employee Name</th>
                <th scope="col" class="basic-col" data-bs-toggle="tooltip" title=""
                    data-bs-original-title="Actual PT Applicable Salary">PT Appl Sal</th>

                <th scope="col" class="basic-col" data-bs-toggle="tooltip" title=""
                    data-bs-original-title="Processed Month">Proc Mo</th>

                <th scope="col" class="basic-col" data-bs-toggle="tooltip" title=""
                    data-bs-original-title="Processed Salary">Proc Sal</th>

                <th scope="col" class="basic-col" class="basic-col" data-bs-toggle="tooltip" title=""
                    data-bs-original-title="Not Processed Month">Not Proc Mo</th>

                <th scope="col" class="basic-col" data-bs-toggle="tooltip" title=""
                    data-bs-original-title="Not Processed Salary">Not Proc Sal</th>

                <th scope="col" class="basic-col" data-bs-toggle="tooltip" title=""
                    data-bs-original-title=" PT Salary">PT Sal</th>

                <th scope="col" class="basic-col">Basic</th>

                <th scope="col" class="basic-col" data-bs-toggle="tooltip" title=""
                    data-bs-original-title="Sum Of All Allowances Except Basic">
                    Oth Alws
                </th>

                <th scope="col" class="basic-col" data-bs-toggle="tooltip" title=""
                    data-bs-original-title="PT Amount">PT Amt</th>

                <th scope="col" class="basic-col" data-bs-toggle="tooltip" title=""
                    data-bs-original-title="PT Already Paid">PT Paid</th>

                <th scope="col" class="basic-col" data-bs-toggle="tooltip" title=""
                    data-bs-original-title="Current Month PT">Curr Mo PT</th>

                <th scope="col" class="basic-col" data-bs-toggle="tooltip" title=""
                    data-bs-original-title="Remaining Amount">Rmng Amt</th>

                <th scope="col" class="basic-col" data-bs-toggle="tooltip" title=""
                    data-bs-original-title="Dividing Period">Div Period</th>

                <th scope="col" class="basic-col">Edit</th>
            </tr>
        </thead>
        <tbody>
