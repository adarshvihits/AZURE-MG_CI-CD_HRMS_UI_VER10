@model Hrms.Lite.Shared.PayRoll.PTProcessing

<script src="~/js/tooltip.js"></script>
@using (Html.BeginForm(null,null, FormMethod.Post, new { @id = "BatchUpdate_PTprocessing" }))
{

    <div id="readeredit" class="slider-forms slider-forms-open EditDiv">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('EditDiv')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <h4>
                PT Processing
            </h4>
            <div class="profile-header position-relative pb-12 mb-5"
                 style="padding-bottom: 2px !important; padding-top: 5px !important;">
                <div class="row">
                    <div class="col-md-2">
                        <div class="image-input image-input-outline image-input-circle float-right"
                             id="kt_image_4"
                             style="background-image:  @Model.EmployeeHeader.EmployeeAbsoluteUri">
                            <div class="image-input-wrapper">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-10 pl-7">
                        <div class="row">

                            <div class="flex-grow-1">
                                <!--begin::Title-->
                                <div class="d-flex justify-content-between flex-wrap">
                                    <div class="d-flex mr-3 header-profile-name">
                                        <span class="">
                                            @Model.EmployeeHeader.EmployeeName
                                        </span>
                                        <span>

                                        </span>

                                    </div>

                                </div>

                                <!--end::Title-->
                                <!--begin::Content-->
                                <div class="d-flex flex-wrap justify-content-between">
                                    <div class="d-flex flex-column flex-grow-1 pr-8">
                                        <div class="d-flex flex-wrap mb-1">
                                            <span data-bs-toggle="tooltip"
                                                  data-bs-original-title="Designation"
                                                  class="header-profile-email mr-5 mb-lg-0 mb-2">
                                                <i class="fas fa-briefcase icon-nm mr-2"></i> @Model.EmployeeHeader.Designation.Name
                                            </span>
                                            <span data-bs-toggle="tooltip"
                                                  data-bs-original-title="Department"
                                                  class="header-profile-email mr-5 mb-lg-0 mb-2">
                                                <i class="fas fa-network-wired icon-nm mr-2"></i> @Model.EmployeeHeader.Department.Name
                                            </span>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="profile-header-overflow"></div>
            </div>

            <div class="row">

                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">Month</label>
                        <div class="view-details">
                            @Html.HiddenFor(model => model.EmployeeHeader.EmployeeGuid)
                            @Html.DisplayFor(Model => Model.Month.Name, "{0:dd-MMM-yyyy}", new { @class = "form-control form-control-sm", @readonly = "true" })
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            PT Group
                        </label>
                        <div class="view-details">
                            @Html.DisplayFor(Model => Model.PTGroup.Name, "{0:dd-MMM-yyyy}", new { @class = "form-control form-control-sm", @readonly = "true" })
                        </div>
                    </div>
                </div>

            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            From
                        </label>
                        <div class="view-details">
                            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.From))
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">To</label>
                        <div class="view-details">
                            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.To))
                        </div>
                    </div>
                </div>


            </div>



            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            No. Of Salary Month
                        </label>
                        <div class="view-details">
                            @Html.DisplayFor(Model => Model.SalaryMonths, "{0:dd-MMM-yyyy}", new { @class = "form-control form-control-sm", @readonly = "true" })
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="row-outer">
                        <label class="view-title">
                            Duration
                        </label>
                        <div class="view-details">
                            @Html.DisplayFor(Model => Model.Duration, "{0:dd-MMM-yyyy}", new { @class = "form-control form-control-sm", @readonly = "true" })
                        </div>
                    </div>
                </div>



            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="row-outer">

                        <div class="form-group">
                            <label>Dividing Period</label>
                            @Html.TextBoxFor(Model => Model.PTProcessing_Details.DividingPeriod, new { @class = "form-control form-control-sm" })
                        </div>
                    </div>




                </div>


                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12 align-right">
                        <a type="button"
                           class="btn btn-default  mobile-full-width" onclick="Save()">
                            Modify
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}