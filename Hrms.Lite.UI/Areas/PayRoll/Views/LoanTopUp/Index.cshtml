@model Hrms.Lite.Shared.PayRoll.LoanIssue
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/scripts/PayRoll/LoanTopUp.js"></script>
<script src="~/js/jquery.min.js"></script>


<script src="~/js/datatables.min.js"></script>
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->

        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Loan TopUp</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Loan TopUp
                    </li>
                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
       
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <div class="mobile-tab-section">
                        <div class="row mb-2">
                            <div class="col-6">
                                <div class="form-group">
                                    <label>Select Loan Type</label>
                                    @Html.DropDownListFor(m => m.LoanTopUpDetails.LoanType.Code, (SelectList)ViewBag.loantype, "Loan Type", new { @class = "form-control form-control-sm", onchange = "getList(this)" })
                                </div>
                            </div>


                        </div>
                    </div>

                    <!--begin: Search Form-->
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items">
                                <div class="form-group filter-combobox pt-2 pl-2" style="width: 180px;">
                                    @Html.DropDownListFor(m => m.LoanTopUpDetails.LoanType.Code, (SelectList)ViewBag.loantype, "Select Loan Type", new { @class = "form-control form-control-sm filterDropDown", onchange = "getList(this)" })

                                    @*<select class="form-control form-control-sm " id="exampleSelects">
                            <option>Loan Type</option>
                            <option>Personal Loan</option>
                            <option>Car Loan</option>
                        </select>*@
                                </div>

                                <span id="type"></span>
                            </div>
                            <div class="tab-items select-option  pt-3">
                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>


                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                   data-bs-original-title="Export to Excel">
                                    <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                </a>

                            </div>



                        </div>
                    </div>
                    <div id="loantopuplist">
                        @await Html.PartialAsync("_LoanTopUpList", Model)
                    </div>
                    <div id="editSlider"></div>

                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
                    </div>


                </div>
            </div>

        </div>
    </div>
</div>

