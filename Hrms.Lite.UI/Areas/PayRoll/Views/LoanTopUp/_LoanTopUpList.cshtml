
@model Hrms.Lite.Shared.PayRoll.LoanIssue
    <script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>

    <script>
        $(document).ready(function () {

            //$('#loantopuptable').DataTable({
            //    "pageLength": 25,
            //    "language":
