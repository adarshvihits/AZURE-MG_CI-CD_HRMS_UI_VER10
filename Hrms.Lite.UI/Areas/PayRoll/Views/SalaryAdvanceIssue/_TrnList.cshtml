@model Hrms.Lite.Shared.PayRoll.SalaryAdvance
<script src="~/js/settings.js"></script>
<script src="~/js/tooltip.js"></script>

<div class="ihits-table table-border odd-even  mobile-responsive-table salary_advance_issuetrn">
    @Html.HiddenFor(m => m.SalaryAdvanceList.Count)
    <table id="SalaryAdvanceIssueTrnHistoryTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation </th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">Gross Salary</th>
                <th scope="col" data-bs-toggle="tooltip" title="Requested Amount">Req. Amt</th>
                <th scope="col" data-bs-toggle="tooltip" title="Confirmed Amount">Conf. Amt</th>
                <th scope="col">Remarks</th>
                <th scope="col">Issued By</th>


            </tr>
        </thead>
        <tbody>

            @if (Model.SalaryAdvanceList != null && Model.SalaryAdvanceList.Count > 0)
            {

                for (int i = 0; i < Model.SalaryAdvanceList.Count; i++)
                {


                    <tr>
                        <td data-label="ID">
                            @Model.SalaryAdvanceList[i].EmployeeID
                        </td>
                        <td data-label="Name"> @Model.SalaryAdvanceList[i].EmployeeName </td>
                        <td data-label="Designation">@Model.SalaryAdvanceList[i].Designation.Name</td>
                        <td data-label="Department">@Model.SalaryAdvanceList[i].Department.Name</td>
                        <td data-label="Location">@Model.SalaryAdvanceList[i].Location.Name</td>
                        <td data-label="Gross Salary">@Model.SalaryAdvanceList[i].GrossSalary</td>
                        <td data-label="Requested Amount">                 
                                @Model.SalaryAdvanceList[i].LoanAmount                           
                        </td>
                        <td data-label="Confirmed Amount">
                            @Model.SalaryAdvanceList[i].ConfirmedAmnt
                        </td>
                        <td data-label="Remarks">                   
                                @Model.SalaryAdvanceList[i].Remarks                                                  
                        </td>

                        <td data-label="Issued By">
                            @Model.SalaryAdvanceList[i].IssuedBy
                        </td>
                    </tr>



                }
            }

        </tbody>
    </table>
</div>