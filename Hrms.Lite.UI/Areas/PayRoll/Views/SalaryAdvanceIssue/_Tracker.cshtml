@model Hrms.Lite.Shared.PayRoll.SalaryAdvance
<script>
   $(document).ready(function () {
       debugger
         $.ajax({

            type: 'GET',
            url: '/AccessFile/GetFileStorageType',

            success: function (data) {

                if (data == 'BLOB') ifAzure();      
                else

                    $('.emp_HeaderPic').css('background-image', "url('" + '@Model.File.AbsoluteUri' + "')");

            },
            error: function (xhr, textStatus, errorThrown) {
                if ($($.parseHTML(xhr.responseText)).filter(".Login_Session").length > 0) {
                    window.location.reload();
                }
                else {
                    document.body.id = "kt_body";
                    $('body').html(xhr.responseText);
                }
            }
        });
        function ifAzure() {
            $.ajax({
                type: "POST",
                url: "/AccessFile/ViewAsBackGroundImage", // do not hard code your url's
                data: { filename: '@Model.File.FileName' },
                success: function (data, jqXHR, response) {

                    if (jqXHR = "success") {
                        var mimeType = getMimeTypeFromFilename('@Model.File.FileName');
                        debugger
                        $('.emp_HeaderPic').css('background-image', "url('" + mimeType + data + "')");


                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                }
            });
        }
   })

</script>
    <script src="~/js/tooltip.js"></script>
    <div id="applicant" class="slider-forms slider-forms-open TrackerSlider">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('TrackerSlider')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>
            <div class="location-slider">
                <h4 class="mb-4">Salary Advance Issue Tracking</h4>


                <div class="profile-header position-relative pb-12 mb-5"
                     style="padding-bottom: 2px !important; padding-top: 5px !important;">
                    <div class="row">
                        <div class="col-md-2">
                            <div class="image-input image-input-outline image-input-circle float-right emp_HeaderPic" 
                                 id="kt_image_4"
                               >
                                <div class="image-input-wrapper">
                                </div>
                            </div>
                        </div>
                        <div class="col-md-10 pl-7">
                            <div class="row">

                                <div class="flex-grow-1">
                                    <!--begin::Title-->
                                    <div class="d-flex justify-content-between flex-wrap">
                                        <div class="d-flex mr-3 header-profile-name">
                                            <span class="">
                                                @Model.EmployeeName
                                            </span>
                                            

                                        </div>

                                    </div>

                                    <!--end::Title-->
                                    <!--begin::Content-->
                                    <div class="d-flex flex-wrap justify-content-between">
                                        <div class="d-flex flex-column flex-grow-1 pr-8">
                                            <div class="d-flex flex-wrap mb-1">
                                                <span data-bs-toggle="tooltip"
                                                      data-bs-original-title="Fun.Designation"
                                                      class="header-profile-email mr-5 mb-lg-0 mb-2">
                                                    <i class="fas fa-briefcase icon-nm mr-2"></i>@Model.Designation.Name
                                                </span>
                                                <span data-bs-toggle="tooltip"
                                                      data-bs-original-title="Department"
                                                      class="header-profile-email mr-5 mb-lg-0 mb-2">
                                                    <i class="fas fa-network-wired icon-nm mr-2"></i>@Model.Department.Name
                                                </span>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="profile-header-overflow"></div>
                </div>
            </div>

            <div class="add-padding">

                <!----- stepper start here --->
                <div>

                   

                    @if (Model.Tracker != null && Model.Tracker.Count > 0)
                    {
                        for (int i = Model.Tracker.Count - 1; i >= 0; i--)
                        {
                            @if (Model.Tracker[i].IssueStatus != "Pending")
                            {
                                <div class="step active completed">
                                    <div class="v-stepper">
                                        <div class="circle">
                                            <i class="fa fa-check"></i>
                                        </div>
                                        <div class="line"></div>
                                    </div>

                                    <div class="stepper-content ">
                                        <div class="row-outer">

                                            <label class="view-title">
                                                @Model.Tracker[i].Stage
                                            </label>
                                            <div class="view-details">
                                                @{
                                                    string Status = "";
                                                }
                                                @if (Model.Tracker[i].IssueStatus != "")
                                                {
                                                    Status = Model.Tracker[i].IssueStatus;
                                                }
                                                @if (Model.Tracker[i].Authority != "")
                                                {
                                                    Status = Status + ", " + Model.Tracker[i].Authority;
                                                }
                                                @if (Model.Tracker[i].EntryDate != null)
                                                {
                                                    Status = Status + ", " + Convert.ToDateTime(Model.Tracker[i].EntryDate).ToString("dd-MMM-yyyy");                                                    
                                                }
                                                @Status
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="step">
                                    <div class="v-stepper">
                                        <div class="circle">
                                            @*<i class="fa fa-check"></i>*@
                                        </div>
                                        <div class="line"></div>
                                    </div>

                                    <div class="stepper-content">
                                        <div class="row-outer">
                                            <label class="view-title">
                                                @Model.Tracker[i].Stage

                                            </label>
                                            <div class="view-details">
                                                @Model.Tracker[i].IssueStatus, @Model.Tracker[i].Authority
                                            </div>
                                               


                                            </div>
                                        </div>
                                </div>
                            }


                        }
                    }

                </div>

            </div>

        </div>
        </div>