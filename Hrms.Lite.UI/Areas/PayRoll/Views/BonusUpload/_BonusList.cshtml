
@model Hrms.Lite.Shared.PayRoll.BonusUpload

<script src="~/js/tooltip.js"></script>
<style>
    .dataTables_scrollBody tfoot {
        display: none !important;
    }

    .wid50 {
        width: 50px !important;
    }
</style>
<div class="ihits-table table-border odd-even  mobile-responsive-table bonus-upload-list">
    @Html.HiddenFor(m => m.BonusUploadList.Count)
    <table id="BonusUploadTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Eff.Year </th>
                <th scope="col">Eff.Month</th>
                <th scope="col">Eff.Quarter</th>
                <th scope="col">Product</th>
                <th scope="col">SubProduct</th>
                <th scope="col">Bonus Type</th>
                <th scope="col">Amount</th>

            </tr>
        </thead>
        <tbody>
        </tbody>
        <tfoot>

            <tr style=" position: sticky; bottom: 0;" class="table-light">
                <td data-label=""><strong></strong></td>
                <td data-label=""><strong></strong></td>
                <td data-label=""><strong></strong></td>
                <td data-label=""><strong></strong></td>
                <td data-label=""><strong></strong></td>
                <td data-label=""><strong></strong></td>
                <td data-label=""><strong></strong></td>
                <td data-label=""><strong></strong></td>
                @*<td class="wid50" data-label="" align="right"><strong> <span id="totAmt"></span></strong></td>*@
                <td class="wid50" data-label="" align="right"><strong> <span id="totAmt" style="color: white; font-size: 14px; font-weight: 900;"></span></strong></td>


            </tr>

        </tfoot>
    </table>
</div>