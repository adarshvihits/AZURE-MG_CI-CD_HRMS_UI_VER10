@model Hrms.Lite.Shared.PayRoll.VariableAllowance
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>

<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/PayRoll/variableAllowance.js"></script>
<script>
    $(document).ready(function () {
        fillData();
    });
</script>

    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->


            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Variable Allowance</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            Variable Allowance
                        </li>

                    </ul>
                </div>
            </div>

        </div>
        <!--end::Container-->
    </div>



    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">


                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body">

                        <div class="mobile-tab-section">
                            @*<div class="row mb-2">
                <div class="col-6">
                    <div class="form-group">
                        <label>Select Type</label>
                        @Html.DropDownListFor(m => m.AllowanceMonth.Code, (SelectList)ViewBag.AllowanceMonth, "--Month--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'AllMonth');$('.Amonth').val($('#AllowanceMonth_Code').val());GetList()" })
                        <span id="AllMonth"></span>
                    </div>

                </div>
                <div class="col-6" id="assetFilter">
                    <div class="form-group">
                        <label>Select Allowance Type</label>
                        @Html.DropDownListFor(m => m.Allowance.Code, (SelectList)ViewBag.AllowanceType, "--Allowance--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'Alltype');$('.Aname').val($('#Allowance_Code').val());GetList()" })
                        <span id="Alltype"></span>
                    </div>

                </div>
                <div class="col-12 d-flex align-items-center justify-content-end">

                    <div class="button-group float-right ">

                        <button id="BatchUpdate" type="button"
                                class="btn btn-default btn-sm float-left slider-btn  mr-5" onclick="clickOnBatchUpdate()">
                            Batch Update
                        </button>

                    </div>
                </div>
            </div>*@
                        </div>

                        @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "variableAllowanceUpload", enctype = "multipart/form-data" }))
                        {
                            <div class="row tab-style-button">
                                <div class="tab-button-wrap">
                                    <div class="tab-items ml-5 pr-0 border-none select-option lows">
                                        <div class="form-group filter-combobox mr-2" style="width: 140px;">
                                            @*<select class="form-control form-control-sm " id="exampleSelects">
                                <option>Month</option>
                                <option>January</option>
                                <option>February</option>
                                <option>March</option>
                                <option>April</option>
                                <option>May</option>
                                <option>June</option>
                                <option>July</option>
                                <option>August</option>
                                <option>September</option>
                                <option>October</option>
                                <option>November</option>
                                <option>December</option>

                            </select>*@


                                            @Html.DropDownListFor(m => m.AllowanceMonth.Code, (SelectList)ViewBag.AllowanceMonth, "--Month--", new { @class = "form-control form-control-sm Amonth", @onchange = "fillData();validate(this,'MonthAllowance')" })
                                            <span id="MonthAllowance"></span>
                                        </div>

                                    </div>
                                    <div class="tab-items ml-5 pr-0 border-none select-option">
                                        <div class="form-group filter-combobox mr-10">
                                            @*<select class="form-control form-control-sm " id="exampleSelects">
                                <option>Allowance</option>
                                <option>Demo</option>
                                <option>Demo</option>

                            </select>*@

                                            @Html.DropDownListFor(m => m.Allowance.Code, (SelectList)ViewBag.AllowanceType, "--Allowance--", new { @class = "form-control form-control-sm Aname", @onchange = "fillData();validate(this,'TypeAllowance')" })
                                            <span id="TypeAllowance"></span>
                                        </div>

                                    </div>
                                    <div class="tab-items pr-0 border-none highs">

                                        <div class="tab-items pr-0 border-none ">
                                            <div class="button-group float-left  batchleave ">
                                                <button id="BatchUpdate" type="button"
                                                        class="btn btn-default btn-sm float-left mr-5" onclick="clickOnBatchUpdate()">
                                                    Batch Update
                                                </button>

                                            </div>
                                        </div>
                                    </div>
                                    <!-- <batch updates></batch> -->


                                    <div class="tab-items select-option lows">

                                        <div class="sraech-slider">
                                            <div class="search-slider-inner">
                                                <i class="fa fa-search"></i>
                                            </div>
                                            <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                                   placeholder="ID/Name">
                                        </div>
                                        <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                            <i class="fas fa-filter"></i>
                                            <i class="fas fa-check"></i>
                                        </div>
                                        <a data-bs-toggle="tooltip" title="Export to Excel"
                                           class="btn btn-excel mr-0" onclick="ExportToExcel()" @*onclick="getDataSetCountAJAX()"*@>
                                            <i class="icon-xl far fa-file-excel"></i>
                                        </a>
                                        <button type="button" data-bs-toggle="tooltip" title="Import From Excel" onclick="validateAllowanceDropdowns()"
                                                class="btn btn-excel ml-0 import">
                                            <i class="fa fa-upload icon-xls" aria-hidden="true"></i>
                                        </button>
                                    </div>

                                    <div id="batchUpdate"></div>
                                </div>
                            </div>
                            <div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog" aria-labelledby="myLargeModalLabel" aria-hidden="true">
                                <div class="modal-dialog modal-lg">
                                    <div class="modal-content popup">
                                        <div class="modal-header" style="padding:10px">
                                            <h5 class="modal-title" id="exampleModalLabel">Upload Format</h5>
                                            <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close" onclick="$('#Unmatchedlist').html('');$('#Excel_FileData').val()">
                                                <i aria-hidden="true" class="ki ki-close"></i>
                                            </button>
                                        </div>
                                       
                                        <div class="modal-body pt-3">
                                            <div class="colums_list pb-1">
                                                Please ensure your Excel file contains the following columns with the exact headings. Spelling and case must match precisely for a successful import -

                                                Employee ID,
                                                Employee Name,
                                                Remark,
                                                Amount<br />
                                                @*Columns Needed :- Employee ID, Employee Name, Amount*@
                                            </div>
                                            <div class="row align-items-center mt-3">

                                                <div class="col-md-3 mt-4">
                                                    <div class="checkbox-inline">
                                                        <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted ">

                                                            <input data-val="true" data-val-required="" id="append" name="append" type="checkbox" value="true">
                                                            <span cursorshover="true"></span>
                                                            Append Amount
                                                        </label>
                                                    </div>

                                                    @*<label>
                                                        <input data-val="true" value="true" id="append" name="append" type="checkbox">
                                                        <span cursorshover="true"></span>
                                                        Append Amount
                                                    </label>*@
                                                </div>
                                                    <div class="col-md-4">
                                                        <div class="file-upload-form-group">
                                                            <label for="formFileMultiple" class="form-label">
                                                                Attach
                                                                File
                                                                <span class="Mandatory">*</span>
                                                            </label>

                                                            <div class="file-upload-form mb-1" data-bs-toggle="tooltip" data-bs-original-title=" Only .xlsx files are
                                            allowed , File size less than 1 MB.">
                                                                <div class="small-btn-group">

                                                                    <button type="button" data-bs-toggle="tooltip" data-placement="top" data-bs-original-title="View Image" class="btn btn-icon btn-default"><i class="icon-xl far fa-eye"></i></button>

                                                                </div>
                                                                <input id="File_AbsoluteUri" name="File.AbsoluteUri" type="hidden" value="">
                                                                @*<input accept=".png, .jpg, .jpeg, .pdf" id="File_FileData" name="File.FileData" onchange="CheckImageExtensionSize(this)" title="" type="file">*@
                                                                @Html.HiddenFor(model => model.Excel.FileData, new { type = "file", @class = "input-file PreviewImage form-control h-100", @onchange = "onImportExcelClick()" })


                                                            </div>
                                                        </div>


                                                    </div>
                                                </div>

                                                <div id="Unmatchedlist">

                                                </div>
                                            </div>

                                    </div>
                                </div>
                            </div>
                        }
                        <div id="Variableallowancelist">
                            @await Html.PartialAsync("_VariableAllowanceList")
                        </div>
                        <div id="filterSlider">
                            @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
                        </div>
                        @*<div id="BatchUdateSlider" class="hide">
            @await Html.PartialAsync("_BatchUpdate")
        </div>*@
                        <div class="row card-footer-bottom-fixed ">
                            <div class="col-md-12 "style="font-weight:900;">
                                <span class="display-inline-block mr-6 footerDiv textDisplay">
                                    Employees with
                                    Allowance: <span id="empWithAmt"></span>/<span id="totEmpCnt"></span>
                                </span>
                                <span class="footerDiv textDisplay">Total Amount: <span id="totAmt"></span></span>
                            </div>


                        </div>

                    </div>
                </div>

            </div>

        </div>

    </div>



