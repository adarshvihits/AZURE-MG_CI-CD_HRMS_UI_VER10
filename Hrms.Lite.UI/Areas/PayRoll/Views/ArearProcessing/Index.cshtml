@model Hrms.Lite.Shared.PayRoll.ArearProcessing
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/scripts/PayRoll//arearProcessing.js"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>



<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Arrear Processing</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class=""><i class="icon-nm fas fa-home"></i></a>
                    </li>
                    <li class="breadcrumb-item">
                        Arrear Processing
                    </li>

                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per">

                <div class="card-body">
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap align-items-center">

                            <div class="tab-items">

                                <div class="row-outer pb-2">
                                    <label>Payroll Group</label>
                                    <div class="form-group filter-combobox mt-0">
                                        @Html.DropDownListFor(m => m.PayrollGroup.Code, (SelectList)ViewBag.PayrollGroup, "--Select--", new { @class = "form-control form-control-sm" , @onchange="fillMonth(this)"})

                                    </div>
                                    <span id="arear_month"></span>
                                </div>
                            </div>
                            <div class="tab-items">

                                <div class="row-outer pb-2">
                                    <label>Month</label>
                                    <div class="form-group filter-combobox mt-0">
                                        @Html.DropDownListFor(m => m.Month.Code, (SelectList)ViewBag.Month, "--Select--", new { @class = "form-control form-control-sm" })

                                    </div>
                                    <span id="arear_month"></span>
                                </div>
                            </div>
                            <div class="tab-items pl-3 pt-3">

                                <button type="button" class="btn btn-default btn-sm float-left" onclick="fillData()">
                                    Proceed To Save
                                </button>



                            </div>

                            <div class="tab-items select-option">
                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm" placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button filteropen" data-bs-toggle="tooltip" title="" data-bs-original-title="Filter" onclick="validatefilter()">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <button data-bs-toggle="tooltip" title="" class="btn btn-excel float-left" data-bs-original-title="Export to Excel" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </button>

                            </div>

                        </div>
                    </div>

                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
                    </div>
                    <!-- Table Section -->

                    @await Html.PartialAsync("_List")

                    <!-- Table Setion End -->
                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
   
</div>

<div class="modal fade bd-example-modal-lg" id="arear_popup" tabindex="-1" aria-labelledby="myLargeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" style="max-width:1250px;">
        <div class="modal-content popup">
            <div class="modal-header">
                <h5 class="modal-title">  <span class="popup-title"> </span></h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true" class="ki ki-close"></i>
                </button>
            </div>
            <div class="modal-body" style=" padding: 5px 20px;">
            </div>


        </div>
    </div>

</div>
