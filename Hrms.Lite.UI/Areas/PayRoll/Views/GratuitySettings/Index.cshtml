@model Hrms.Lite.Shared.PayRoll.GratuitySettings
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
@*<script src="~/js/datatables.min.js"></script>*@
<script src="~/scripts/PayRoll/gratuitySettings.js"></script>
@using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "GratutySave" }))
{
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->
            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Gratuity Settings</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>
                        <li class="breadcrumb-item">
                            Gratuity Settings
                        </li>

                    </ul>
                </div>
            </div>
            <!--begin::Topbar-->
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per">

                    <div class="card-body">
                        <div class="row tab-style-button">
                            <div class="tab-button-wrap align-items-center">

                                <div class="tab-items">

                                    <div class="row-outer pb-2">
                                        <label>Gratuity Eligible Service(In Months)</label>
                                        @Html.TextBoxFor(Model => Model.GratuityEligibleService, new { @class = "form-control form-control-sm", maxlength = "2", @placeholder = "Gratuity Eligible Service", onblur = "validate(this,'gratuityeligibleservice')" })
                                        <span id="gratuityeligibleservice"></span>
                                    </div>
                                </div>
                                <div class="tab-items pl-3">

                                    <div class="row-outer pb-2">
                                        <label> Avg days of Gratuity</label>
                                        @Html.TextBoxFor(Model => Model.GratuityDays, new { @class = "form-control form-control-sm", maxlength = "4", @placeholder = "Minimum Assured", onblur = "validate(this,'minimumassured')" })
                                        <span id="minimumassured"></span>
                                    </div>
                                </div>
                                <div class="tab-items pl-3">

                                    <div class="row-outer pb-2">
                                        <label> No of Working Days </label>
                                        @Html.TextBoxFor(Model => Model.NoOfWorkingDays, new { @class = "form-control form-control-sm", maxlength = "3", @placeholder = "Maximum Sealing Amount", onblur = "validate(this,'maximumsealingamount')" })
                                        <span id="maximumsealingamount"></span>
                                    </div>
                                </div>
                                <div class="tab-items select-option d-flex align-items-center">

                                    <div class="sraech-slider mt-0">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search" onclick="$('#searchList').focus();"></i>
                                        </div>
                                        <input id="searchList" type="text" class="form-control form-control-sm"
                                               placeholder="ID/Name" onkeyup="searchRows()">
                                    </div>
                                </div>
                            </div>
                            
                        </div>
                        

                        <!-- Table Section -->
                        <div id="GratutyList">
                            @await Html.PartialAsync("_List", Model)
                        </div>
                        <!-- Table Setion End -->

                        <div class="row card-footer-bottom-fixed">

                            <div class="col-md-12 align-right">
                                <a type="button"
                                   class="btn btn-default float-right mobile-full-width" onclick="gratutySave()">
                                    Save
                                </a>
                            </div>
                        </div>
                        <!--end: Datatable-->
                    </div>

                </div>

                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>
    <!--end::Content-->
}