@model Hrms.Lite.Shared.PayRoll.Reports.PFGroupSummaryReport


<div class="ihits-table table-border hover-color odd-even mobile-responsive-table PF-grpsummary-report">
    @Html.HiddenFor(m => m.PFGroupSummary.Count)
    <table id="PFGroupsummaryreportTable" class="common-table">
        <thead>
            <tr class="table-dark">


                <th scope="col">Sl.No.</th>
                <th scope="col" id="GroupByname"></th>
                <th scope="col">No.of Staffs</th>
                <th scope="col">Payable Salary</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Employee Contribution - 12 %">EPF</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Pension Fund 8.33%"> 8.33%</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Employer contribution 3.67%"> 3.67%</th>
                <th scope="col"> PF ER Cont</th>
                <th scope="col"> PF Admin Charges</th>
                <th scope="col"> EDLI Charges</th>



            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>
