<div style="padding:10px;" class="ihits-table table-border hover-color odd-even mobile-responsive-table salary-intergrity-name-poup vertical-scroll-250">
    @Html.HiddenFor(m => m.Details.Count)
 
    <table>
        <thead>
            <tr class="table-light">
                <th scope="col">Description</th>
                <th scope="col" class="mnthA"></th>
                <th scope="col" class="mnthB"></th>
                <th scope="col">Diff (A-B)</th>
                <th scope="col">LOP (A)</th>
                <th scope="col">LOP (B)</th>




            </tr>
        </thead>
        <tbody>
            @if (Model.Details != null && Model.Details.Count > 0)
            {

                @for (int i = 0; i < Model.Details.Count; i++)
                {
                    <tr>
                        <td data-label="ID">@Model.Details[i].Name</td>
                        <td data-label="Emoloyee Name" style="text-align: end;">@Model.Details[i].AmountA</td>
                        <td data-label="Designation" style="text-align: end;">@Model.Details[i].AmountB</td>
                        <td data-label="Department" style="text-align: end;">@Model.Details[i].Difference </td>
                        <td data-label="Location" style="text-align: end;">@Model.Details[i].LopA</td>
                        <td data-label="DOJ" style="text-align: end;">@Model.Details[i].LopB</td>


                    </tr>
                }
            }


                </tbody>


    </table>
</div>
