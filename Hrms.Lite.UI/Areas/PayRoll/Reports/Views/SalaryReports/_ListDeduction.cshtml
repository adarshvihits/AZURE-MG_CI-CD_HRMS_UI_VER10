@model Hrms.Lite.Shared.PayRoll.Reports.SalaryIntegrityReport


<div class="ihits-table table-border hover-color odd-even mobile-responsive-table">
    @Html.HiddenFor(m => m.MainList.Count)
    <table id="SalaryReportDeductionTable">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col" id="Ded_mthA"></th>
                <th scope="col" id="Ded_mthB"></th>
                <th scope="col" >Diff (A-B)</th>
                <th scope="col"  >Actual Gross(A)</th>
                <th scope="col" >Earned Gross(A)</th>
                <th scope="col">Actual Gross(B)</th>
                <th scope="col" >Earned Gross(B)</th>

            </tr>
        </thead>
      
    </table>



</div>