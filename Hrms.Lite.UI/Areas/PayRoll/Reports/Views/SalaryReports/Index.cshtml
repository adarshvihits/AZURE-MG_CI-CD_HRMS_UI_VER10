@model Hrms.Lite.Shared.PayRoll.Reports.SalaryIntegrityReport
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/PayRoll/Reports/salaryReports.js"></script>




<script>
        $(document).ready(function () {
            debugger;
            fillData();
        });
    </script>
<!--begin::Header-->
@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "getSalaryReportData" }))
{
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->


            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Salary Integrity Report</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index","Home",new { Area=""})"><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            Salary Integrity Report
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->

    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body">
                        <!--begin: Search Form-->

                        <div class="row tab-style-button">

                            <div class="tab-button-wrap align-items-center">


                                <div class="tab-items">

                                    <div class="row-outer pb-2 " style="width:180px">

                                        <div class="form-group filter-combobox highs mb-0 mt-2">
                                            <label>Month A</label>
                                            @Html.DropDownListFor(m => m.MonthA.Code, (SelectList)ViewBag.Month, "--Select--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'monthA');onMonthChange();" })
                                            <span id="monthA"></span>
                                        </div>
                                    </div>
                                </div>


                                <div class="tab-items">

                                    <div class="row-outer pb-2 " style="width:180px">

                                        <div class="form-group filter-combobox  highs mb-0 mt-2">
                                            <label>Month B</label>
                                            @Html.DropDownListFor(m => m.MonthB.Code, (SelectList)ViewBag.MonthB, "--Select--", new { @class = "form-control form-control-sm", @onchange = "validate(this,'monthB')" })
                                            <span id="monthB"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="tab-items pt-5">
                                    <div>

                                        <div class="radio-inline">
                                            <label class="radio radio-outline radio-success">

                                                @Html.RadioButtonFor(m => m.Allowance_Deduction, "0", new { @onchange = "onAllowDedRadioChange(this)" })
                                                <span></span>Allowance
                                            </label>
                                            <label class="radio radio-outline radio-success">
                                                @*<input type="radio" name="radios15">*@
                                                @Html.RadioButtonFor(m => m.Allowance_Deduction, "1", new { @onchange = "onAllowDedRadioChange(this)" })
                                                <span></span>Deduction
                                            </label>

                                        </div>
                                    </div>

                                </div>


                                <div class="tab-items">

                                    <div class="row-outer pt-3 " style="width:220px">

                                        <div class="form-group filter-combobox mr-10 highs mb-0 mt-2">

                                            @Html.DropDownListFor(m => m.Type.Code, (SelectList)ViewBag.AllowDed, new { @class = "form-control form-control-sm" })
                                        </div>
                                    </div>
                                </div>



                                <div class="tab-items pr-0 pt-4 border-none">
                                    <div class="button-group float-left border-none">
                                        <button type="button" class="btn btn-default btn-sm mr-10" onclick="fillData()">
                                            Proceed
                                        </button>
                                    </div>
                                </div>








                               

                                <div class="tab-items select-option pt-3 ">

                                    <div class="button-group float-left mt-4  d-flex align-items-center">
                                        <button data-bs-toggle="modal" data-target=".bd-example-modal-lg"
                                                type="button" class="btn btn-default btn-sm float-left">
                                            Grid Settings
                                        </button>
                                    </div>

                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>
                                    <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>

                                    <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                       data-bs-original-title="Export to Excel" onclick="GetExportToExcelData()">
                                        <i class="icon-xl far fa-file-excel"></i>
                                    </a>

                                </div>

                                <div class="modal fade bd-example-modal-lg" tabindex="-1" role="dialog"
                                     aria-labelledby="myLargeModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-lg pop-box-change-wi">
                                        <div class="modal-content popup">
                                            <div class="modal-header" style="padding:10px">
                                                <h5 class="modal-title" id="exampleModalLabel">
                                                    Salary Intergrity
                                                </h5>
                                                <button type="button" class="close" data-bs-dismiss="modal"
                                                        aria-label="Close">
                                                    <i aria-hidden="true" class="ki ki-close"></i>
                                                </button>
                                            </div>

                                            <div class="modal-body">
                                                @await Html.PartialAsync("~/Areas/PayRoll/Reports/Views/SalaryReports/_GridSettingsPopUp.cshtml")
                                            </div>


                                        </div>
                                    </div>
                                </div>


                                <div class="modal fade bd-example-modal-lg2" tabindex="-1" role="dialog"
                                     aria-labelledby="myLargeModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-lg pop-box-change-wi">
                                        <div class="modal-content popup">
                                            <div class="modal-header" style="padding:10px">
                                                <h5 class="modal-title" id="exampleModalLabel">
                                                    Salary Integrity Report-Employee Wise
                                                </h5>
                                                <button type="button" class="close" data-bs-dismiss="modal"
                                                        aria-label="Close">
                                                    <i aria-hidden="true" class="ki ki-close"></i>
                                                </button>
                                            </div>

                                            <div class="modal-body">
                                                @await Html.PartialAsync("~/Areas/PayRoll/Reports/Views/SalaryReports/_DetailsPopUp.cshtml")
                                            </div>


                                        </div>
                                    </div>
                                </div>




                            </div>

                        </div>
                        <!-- Table Section -->

                        <div id="salaryReportList">
                            @await Html.PartialAsync("~/Areas/PayRoll/Reports/Views/SalaryReports/_List.cshtml")
                        </div>
                        <div id="salaryReportDeductionList" class="hide">
                            @await Html.PartialAsync("~/Areas/PayRoll/Reports/Views/SalaryReports/_ListDeduction.cshtml")
                        </div>
                        <!-- Table Setion End -->
                        <!--end: Datatable-->
                        <!--end: Datatable-->
                    </div>

                    <div class="row card-footer-bottom-fixed">


                    </div>



                </div>


                <div id="filterSlider">
                    @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
                </div>




                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>
    <div class="slider-over-flow"></div>
    <!--end::Content-->
}