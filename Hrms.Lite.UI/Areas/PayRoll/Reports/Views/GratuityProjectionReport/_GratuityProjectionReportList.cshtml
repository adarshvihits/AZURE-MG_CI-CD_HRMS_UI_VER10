
@model Hrms.Lite.Shared.PayRoll.GratuitySettings
    @*<script src="~/js/settings.js"></script>*@



<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Gratity-Projection-Report-list">
    @Html.HiddenFor(m =>m.GratuityProjection.Count)
    <table id="GratuityProjectionTable"  class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Date of Joining">DOJ</th>
                <th scope="col" class="lwd" data-bs-toggle="tooltip" title="" data-bs-original-title="Last Working Date">LWD</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Years Of Service">Y/S</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Last Drawn Salary">LDS</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Gratuity Applicable Salary">Grat.Appli.Sal</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Eligible Gratuity Amount">Elig.Grat.Amount</th>


            </tr>
        </thead>
        <tbody>          

               
       </tbody>
    </table>



</div>
