
@model Hrms.Lite.Shared.PayRoll.LoanIssue
<script src="~/scripts/PayRoll/Reports/LoanRegister.js"></script>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>

<script>
    $(document).ready(function () {
        debugger
        fillData();
    });
</script>

<div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->

            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Loan Register</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })" class=""><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            Loan Register
                        </li>
                    </ul>
                </div>
            </div>
            <!--begin::Topbar-->
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body">

                        <!--begin: Search Form-->
                        <div class="row tab-style-button">
                            <div class="tab-button-wrap">
                                <div class="form-group filter-combobox pt-2 pl-2 mr-3"
                                     style="width: 140px;">
                                    <label>Loan Type</label>

                                    @Html.DropDownListFor(m => m.Loans.Code, (SelectList)ViewBag.LoanType, "All", new { @class = "form-control form-control-sm", @onchange = "fillData()", @value = 0 })

                                </div>
                                <div class="form-group filter-combobox pt-4 pl-2 mr-3 ml-14">
                                    <div class="d-flex align-items-center h-100 pt-4">
                                        <label></label>
                                        <div class="radio-inline" id="rates">
                                            <label class="radio radio-outline radio-success mr-5" checked name='radiobtn'>
                                                @Html.RadioButtonFor(Model => Model.Radio, "0", new { id = "r1", name = "rate", value = "0", @onchange = "fillData()" })

                                                <span></span>Active
                                            </label>
                                            <label class="radio radio-outline radio-success" checked name='radiobtn'>
                                                @Html.RadioButtonFor(Model => Model.Radio, "1", new { id = "r2", name = "rate", value = "1", @onchange = "fillData()" })

                                                <span></span>Closed
                                            </label>

                                        </div>
                                    </div>
                                </div>





                                <div class="tab-items select-option pt-3 align-items-center">
                                    <!-- <label class="lable-left">Evaluation Period</label> -->



                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>
                                    <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>

                                    <button data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                            data-bs-original-title="Export to Excel" onclick="ExportToExcel()">
                                        <i class="icon-xl far fa-file-excel"></i>
                                    </button>


                                </div>



                            </div>
                        </div>
                        <!-- Table Section -->

                        <div id="LoanRegList">
                            @await Html.PartialAsync("~/Areas/PayRoll/Reports/Views/LoanRegister/_LoanRegisterList.cshtml", Model)
                        </div>
                        <div id="filterSlider">
                            @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.SliderFilter)
                        </div>
                        <div class="modal fade bd-example-modal-lg" tabindex="-1"
                             role="dialog" aria-labelledby="myLargeModalLabel"
                             aria-hidden="true">
                            <div class="modal-dialog modal-lg">
                                <div id="myDiv" class="modal-content popup">
                                    <div class="modal-header" style="padding:10px">
                                        <h5 class="modal-title" id="exampleModalLabel">
                                            Employee Loan Details<span id="empDetails"> - @*@Model.LoanRegister[i].EmployeeName (@Model.LoanRegister[i].EmployeeID)*@</span>
                                        </h5>
                                        <button type="button" class="close"
                                                data-bs-dismiss="modal" aria-label="Close">
                                            <i aria-hidden="true"
                                               class="ki ki-close"></i>
                                        </button>
                                    </div>

                                    <div class="modal-body">

                                    </div>



                                </div>
                            </div>
                        </div>

                        <!-- Table Setion End -->
                        <!--end: Datatable-->
                    </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>

    </div>
    <!--end::Content-->
    <!--end::Entry-->


</div>