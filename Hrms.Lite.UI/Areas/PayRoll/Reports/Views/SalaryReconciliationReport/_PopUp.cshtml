<style>
    .new-salary .dataTables_wrapper.no-footer .dataTables_scrollBody {
        max-height: 30vh !important;
        height: 30vh !important;
    }

    .select-option .sraech-slider .search-slider-inner2 {
        width: 20px;
        height: 20px;
        border-radius: 3px;
        text-align: center;
        padding: 5px 0px;
        position: relative;
        z-index: 3;
        cursor: pointer;
        margin-top: 1px;
    }

    .salary-popup {
        width: 100% !important;
    }
    .dataTables_wrapper .dataTables_scrollBody {
        max-height: 30vh !important;
    }
</style>
<script>
    $(document).ready(function () {
        $(".search-slider-inner2").click(function () {
            $("#dataTableSearchPopUp").toggleClass('field-width-big')
        });
    });

    function Filter() {
        $('#filterSlider').removeClass('hide')
    }

</script>
