
@model Hrms.Lite.Shared.PayRoll.FullandFinalSettelment

    <script src="~/js/tooltip.js"></script>
    <script src="~/js/settings.js"></script>
    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table employee_group_summary">
        <div class="">
            <div class="">
                <table id="EmpGroupSummaryTable" class="layout-fixed common-table">
                    <thead>
                        <tr class="table-dark">
                            <th scope="col" class="sticky-col groupsummary-col">ID</th>
                            <th scope="col" class="sticky-col total-col"> NAME</th>
                            <th scope="col" class="sticky-col ">LOCATION</th>
                            <th scope="col" class="sticky-col ">ENTRY TYPE </th>
                            @if (Model.Head != null)
                            {
                                @for (int i = 4; i < Model.Head.Count; i++)
                                {
                                    <th scope="col">@Model.Head[i]</th>
                                }
                            }


                        </tr>
                    </thead>
                    <tbody>


                        @if (Model.Rows != null && Model.Rows.Count > 0)
                        {

                            @for (int i = 0; i < Model.Rows.Count; i++)
                            {
                        <tr>
                            <td data-label="col" class="sticky-col groupsummary-col">@Model.Rows[i].Columns[0]</td>
                            <td data-label="col" class="sticky-col total-col">@Model.Rows[i].Columns[1]</td>
                            <td data-label="col" class="sticky-col percent-width">@Model.Rows[i].Columns[2]</td>
                            <td data-label="col" class="sticky-col ">@Model.Rows[i].Columns[3]</td>
                            @if (Model.Head != null)
                            {

                                @for (int j = 4; j < Model.Rows[i].Columns.Count; j++)
                                {
                                    <td data-label="Basic" class=" basic-col">@Model.Rows[i].Columns[j]</td>


                                }
                            }
                        </tr>

                            }
                        }


                    </tbody>



                    @*<tfoot>
                            <tr class="Employee-GroupSmmary-list-table-footer">
                                <td data-label="ID"></td>
                                <td data-label="Employee Name"></td>

                                @for (int i = 0; i < Model.Rows.Count; i++)
                                {

                                    @for (int j = 4; j < Model.Head.Count; j++)
                                    {

                                        <td data-label="ID" class="sticky-col groupsummary-col">@Model.Footer[j]</td>

                                    }
                                }
                            </tr>
                        </tfoot>*@




                </table>
            </div>
        </div>
    </div>
