
@model Hrms.Lite.Shared.PayRoll.Reports.PaySheet

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/scripts/PayRoll/Reports/PaySheetPeriodWise.js"></script>
<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>

<script>
    $(document).ready(function () {
        debugger;


        $('#Designations')
            .multiselect('selectAll', false);
        $('#Departments')
            .multiselect('selectAll', false);
        $('#Locations')
            .multiselect('selectAll', false);
        $('#Categories')
            .multiselect('selectAll', false);
        $('#Grades')
            .multiselect('selectAll', false);
        $('#PayrollGroups')
            .multiselect('selectAll', false);
        $('#Divisions')
            .multiselect('selectAll', false);
        $('#Sections')
            .multiselect('selectAll', false);
        $('#EmploymentTypes')
            .multiselect('selectAll', false);
        $('#Regions')
            .multiselect('selectAll', false);
        $('#States')
            .multiselect('selectAll', false);
    });



</script>
<style>
    .multiselect-filter {
        position: sticky;
        top: 0;
        z-index: 10;
        background-color: white;
    }

        .multiselect-filter .input-group {
            padding: 5px;
            margin: 0px;
            border-radius: 2px;
        }

    .multiselect-search {
        border-radius: 5px !important;
        height: 26px;
    }
    .radio-inline .radio {
 
        margin-bottom: 0;
    }
</style>

<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Paysheet Period Wise
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Paysheet Period Wise
                    </li>

                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>


