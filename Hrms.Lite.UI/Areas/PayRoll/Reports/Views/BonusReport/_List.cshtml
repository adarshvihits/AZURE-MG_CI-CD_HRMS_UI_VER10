@model System.Data.DataSet

<script src="~/js/settings.js"></script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Bonus-Report-list-scrolll">

    <table id="CoffBalanceReportTable" class="common-table">
        <thead>
            <tr class="table-dark">
                @foreach (System.Data.DataRow row in Model.Tables[0].Rows)
                {
                    
                        <th>@row["head"].ToString()</th>
                   
                }
            </tr>
        </thead>
        <tbody>
            @foreach (System.Data.DataRow row in Model.Tables[1].Rows)
            {
               
                <tr>
                    @foreach (var item in row.ItemArray)
                    {
                                                   
                        
                            <td>@item.ToString()</td>
                       
                    }
                </tr>
            }
        </tbody>





    </table>





</div>
