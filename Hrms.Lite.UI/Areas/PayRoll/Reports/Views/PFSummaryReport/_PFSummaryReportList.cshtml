@model Hrms.Lite.Shared.PayRoll.Reports.PFSummaryReport

@*<script src="~/js/settings.js"></script>*@
<style>
    .dataTables_scrollBody tfoot{
        display:none;
    }
</style>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table PF-summary-report">
    @Html.HiddenFor(m => m.PFSummary.Count)
    <table id="PFsummaryreportTable" class="common-table">
        <thead>
            <tr class="table-dark">


