                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Employee Contribution - 12 %">  EPF-12% </th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Pension Fund 8.33%"> EPS-8.33%</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="employer contribution 3.67%"> ERPF 3.67% </th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="EDLI Wage">EDLIW</th>
