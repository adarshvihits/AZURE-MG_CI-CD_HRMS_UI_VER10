@model Hrms.Lite.Shared.PayRoll.Reports.PFSummaryReport

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/PayRoll/Reports/PFSummaryReport.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        fillData();
    });
</script>
<style>
    .pdf-icon {
        width: 21px;
        height: 21px;
        fill: #7c8da7;
    }
</style>
<div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->


            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">PF Summary Report</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            PF Summary Report
                        </li>
                    </ul>
                </div>
            </div>
            <!--begin::Topbar-->
            <div class="topbar">


            </div>
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->
    <!--begin::Content-->
    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body">
                        <!--begin: Search Form-->

                        <div class="row tab-style-button">
                            <div class="tab-button-wrap align-items-center">




                                <div class="tab-items">
                                    @Html.HiddenFor(m => Model.UserBase_Code.User_Code)
                                    @Html.HiddenFor(m => Model.UserBase_Code.Company_Code)
                                </div>

                                <div class="tab-items">
                           
                                    <div class="form-group filter-combobox mt-0">

                                        @Html.DropDownListFor(m => m.Month, (SelectList)ViewBag.Month, "--Select Month--", new { @class = "form-control form-control-sm", @onchange = "fillData()" })

                                    </div>
                                </div>
                                <div class="tab-items">
                                    
                                    <div class="form-group filter-combobox mt-0">
                                        @Html.DropDownListFor(m => m.PFGroup, (SelectList)ViewBag.PFgrp, "--Select PF Group--", new { @class = "form-control form-control-sm", @onchange = "fillData()" })

                                    </div>
                                </div>



                                <div class="tab-items select-option high">


                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>


                                    <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>

                                    <button data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                            data-bs-original-title="Export to Excel" onclick="ExportToExcel()">
                                        <i class="icon-xl far fa-file-excel"></i>
                                    </button>
                                    @*<div id="" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Export To Pdf" onclick="OnExportTopdfClick('@Model.UserBase_Code.User_Code', '@Model.UserBase_Code.Company_Code')">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" class="pdf-icon"><path d="M0 64C0 28.7 28.7 0 64 0H224V128c0 17.7 14.3 32 32 32H384V304H296 272 184 160c-35.3 0-64 28.7-64 64v80 48 16H64c-35.3 0-64-28.7-64-64V64zm384 64H256V0L384 128zM160 352h24c30.9 0 56 25.1 56 56s-25.1 56-56 56h-8v32c0 8.8-7.2 16-16 16s-16-7.2-16-16V448 368c0-8.8 7.2-16 16-16zm24 80c13.3 0 24-10.7 24-24s-10.7-24-24-24h-8v48h8zm88-80h24c26.5 0 48 21.5 48 48v64c0 26.5-21.5 48-48 48H272c-8.8 0-16-7.2-16-16V368c0-8.8 7.2-16 16-16zm24 128c8.8 0 16-7.2 16-16V400c0-8.8-7.2-16-16-16h-8v96h8zm72-112c0-8.8 7.2-16 16-16h48c8.8 0 16 7.2 16 16s-7.2 16-16 16H400v32h32c8.8 0 16 7.2 16 16s-7.2 16-16 16H400v48c0 8.8-7.2 16-16 16s-16-7.2-16-16V432 368z" /></svg>
                                        </div>
                                    </div>*@


                                </div>
                        </div>
                        <div id="PFSummaryID">
                            @await Html.PartialAsync("~/Areas/PayRoll/Reports/Views/PFSummaryReport/_PFSummaryReportList.cshtml", Model)
                        </div>

                        <div id="filterSlider">
                            @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.SliderFilter)
                        </div>
                        <!--end: Datatable-->
                        <div class="row card-footer-bottom-fixed border-none">

                            <div class="col-md-12 align-left">
                                <!-- <a type="button"
                class="btn btn-default  mobile-full-width">
                Save
            </a> -->

                            </div>

                        </div>
                    </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>
    <div class="slider-over-flow"></div>
    <!--end::Content-->
    `
</div>