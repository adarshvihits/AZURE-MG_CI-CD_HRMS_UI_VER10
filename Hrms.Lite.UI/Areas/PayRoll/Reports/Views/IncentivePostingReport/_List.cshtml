@model Hrms.Lite.Shared.PayRoll.Reports.IncentivePostingReport
    <script src="~/js/tooltip.js"></script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Incentive-posting-report">
    @Html.HiddenFor(m => m.IncentivePostingReportList.Count)
    <table id="incPostingTable">
        <thead>
            <tr class="table-dark">
                <th scope="col">Period ID</th>
                <th scope="col">Month</th>
                <th scope="col">Employee ID</th>
                <th scope="col">Location</th>
                <th scope="col" data-bs-toggle="tooltip" title="Location Short Name">Loc Short Name</th>
                <th scope="col">Department</th>
                <th scope="col" data-bs-toggle="tooltip" title="Department Short Name">Dept Short Name</th>
                <th scope="col" data-bs-toggle="tooltip" title="Department Cost Centre">Dept Cost Centre</th>
                <th scope="col">Functional Designation</th>
                <th scope="col">Incentive Amount</th>
                <th scope="col">Round</th>
                <th scope="col">Incentive Source</th>
                <th scope="col">Incentive Component</th>
                <th scope="col">Earned_Direct</th>
                <th scope="col">Incentive Type</th>
                <th scope="col">Company</th>
                <th scope="col">Final entry mapping</th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>