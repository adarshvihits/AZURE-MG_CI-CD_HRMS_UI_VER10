@model Hrms.Lite.Shared.PayRoll.Reports.ReferralIncentiveReport

<script src="~/js/settings.js"></script>

<div class="ihits-table table-border odd-even mobile-responsive-table Resignation-tracking-report">
    @Html.HiddenFor(m => m.List.Count)
    <table class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">Referred Employee ID</th>
                <th scope="col">Referred Employee Name</th>
                <th scope="col">Referred Employee Department</th>
                <th scope="col">Referred Employee Location</th>
                <th scope="col" >Referred Employee Designation</th>
                <th scope="col" >Candidate Employee ID</th>
                <th scope="col">Candidate Employee Name</th>
                <th scope="col">Referral Amount</th>
                <th scope="col">Installment</th>
              
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.List != null && Model.List.Count > 0)
            {

                for (int i = 0; i < Model.List.Count; i++)
                {

            <tr>
                <td data-label="Id"> @Model.List[i].ReferredEmployeeID </td>
                <td data-label="Employee name"> @Model.List[i].ReferredemployeeName </td>
                <td data-label="Designation"> @Model.List[i].ReferredemployeeDepartment</td>
                <td data-label="Department"> @Model.List[i].ReferredemployeeLocation </td>
                <td data-label="location">@Model.List[i].ReferredemployeeDesignation </td>
                <td data-label="DOJ"> @Model.List[i].CandidateEmployeeID</td>
                <td data-label="LWD">  @Model.List[i].CandidateEmployeeName</td>
                <td data-label="Res.date">@Model.List[i].Referralamount </td>
                <td data-label="LWD">@Model.List[i].payoutstatus</td>

                

            </tr>

                }
            }

        </tbody>
    </table>
</div>

