@model Hrms.Lite.Shared.PayRoll.Reports.PTReportStatutory
    <script src="~/scripts/PayRoll/Reports/PTReportStatutory.js"></script>
    <script src="~/js/settings.js"></script>
    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table pt_statutory_report_list">
        @*@Html.HiddenFor(m => m.GetPTReportStatutoryList.Count)*@
        <table id="PTReportTable" class="common-table">
            <thead>
                <tr class="table-dark">
                    <th scope="col">ID</th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">Designation</th>
                    <th scope="col">Basic Pay</th>
                    <th scope="col">Special Pay/Perosonal Pay</th>
                    <th scope="col">D.A</th>
                    <th scope="col">
                        Bonus/Festival
                        Allowance
                        Production
                        Linked
                        Incentive
                        Bonus
                    </th>
                    <th scope="col">
                        Earned leave
                        Surrender
                        Allowance
                    </th>
                    <th scope="col">
                        Washing
                        Allowance,
                        Risk
                        Allowance
                        Other Allowance
                    </th>
                    <th scope="col">
                        Total for 6
                        Months
                    </th>
                    <th scope="col">
                        Half
                        Yearly
                        Tax
                    </th>

            </thead>
            <tbody>


                @{
                    if (Model.PTReportStatutoryList != null && Model.PTReportStatutoryList.Count > 0)
                    {
                        for (int i = 0; i < Model.PTReportStatutoryList.Count; i++)
                        {
                            <tr>
                                <td data-label="ID">
                                    @Model.PTReportStatutoryList[i].EmployeeID
                                </td>
                                <td data-label="Employee Name">@Model.PTReportStatutoryList[i].EmployeeName </td>
                                <td data-label="Designation">@Model.PTReportStatutoryList[i].Designation </td>
                                <td data-label="Basic Pay">@Model.PTReportStatutoryList[i].BasicPay</td>
                                <td data-label="Special  Pay">@Model.PTReportStatutoryList[i].SpecialPay</td>
                                <td data-label="D.A">@Model.PTReportStatutoryList[i].DA</td>
                                <td data-label="Bonus/Festival">@Model.PTReportStatutoryList[i].Bonus</td>
                                <td data-label="Earnedleave">@Model.PTReportStatutoryList[i].Earnedleave</td>
                                <td data-label="Washing">@Model.PTReportStatutoryList[i].Washing</td>
                                <td data-label="Total">@Model.PTReportStatutoryList[i].Total</td>
                                <td data-label="Half">@Model.PTReportStatutoryList[i].Half</td>


                            </tr>
                        }
                    }

                }
            </tbody>



        </table>
    </div>
