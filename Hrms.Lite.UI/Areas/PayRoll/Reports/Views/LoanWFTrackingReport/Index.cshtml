@model Hrms.Lite.Shared.PayRoll.EmployeeRequestLoanIssue
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/PayRoll/EmployeeRequestLoanIssue.js"></script>


@*<script>
        $(document).ready(function () {
            /*GetList();*/

            ('.salBtns').show();
            ('.loanBtns').hide();

        });
    </script>*@

<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->

        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Loan Work Flow Tracking</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Loan Work Flow Tracking
                    </li>
                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <!--begin: Search Form-->
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">

                            <div class="tab-items ml-2">
                                <label>Loan Type</label>
                                <div class="form-group filter-combobox mr-10" style="width:160px;">

                                    @Html.DropDownListFor(m => m.LoanTypeCode, (SelectList)ViewBag.LoanType, "--All--", new { @class = "form-control form-control-sm", @onchange = "GetLoanWFReport();" })
                                    <span id="Type"></span>
                                </div>

                            </div>


                            <div class="tab-items select-option srch-fli-exp-pad">


                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <button data-bs-toggle="tooltip" title="Export to Excel"
                                        class="btn btn-excel mr-0">
                                    <i class="icon-xl far fa-file-excel" onclick="onExportToExcelClickReport()"></i>
                                </button>

                            </div>




                        </div>
                    </div>


                    <div id="LoanListView">
                        @await Html.PartialAsync("~/Areas/PayRoll/Reports/Views/LoanWFTrackingReport/_LoanIssueList.cshtml")

                    </div>
                    <div id="LoanTracker">


                    </div>


                    <!--end: Datatable-->
                </div>
            </div>
            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>


    <div id="filterSlider">
        @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
    </div>
</div>
