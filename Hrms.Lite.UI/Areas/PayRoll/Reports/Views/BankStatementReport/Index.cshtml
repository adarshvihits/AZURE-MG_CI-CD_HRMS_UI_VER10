@model Hrms.Lite.Shared.PayRoll.Reports.BankStatement
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*<script src="~/js/jquery.min.js"></script>
    <script src="~/js/datatables.min.js"></script>*@

<script src="~/scripts/PayRoll/Reports/BankStatement.js"></script>

<script src="~/js/jquery.min.js"></script>





<script>
    $(document).ready(function () {
        debugger;


        $('#Banks')
            .multiselect('selectAll', false);
    });



</script>



<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Bank Statement </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Bank Statement
                    </li>
                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
        <div class="topbar">


        </div>
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                    <!--begin: Search Form-->

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap align-items-center">




                            <div class="tab-items">
                                <label>Month</label>
                                <div class="form-group filter-combobox mt-0">

                                    @*<select class="form-control form-control-sm " id="exampleSelects" style="width:150px ;">
                    <option>Jan-22</option>
                    <option>feb-22</option>
                    <option>mar-22</option>


                </select>*@


                                    @Html.DropDownListFor(Model => Model.PayrollMonth.Code, (SelectList)ViewBag.month, "--Select Month--", new { @class = "form-control form-control-sm", onchange = "getList()" })
                                </div>
                            </div>
                            <!--<div class="tab-items">
    <label>Bank</label>
    <div class="form-group filter-combobox  pl-2" style="width: 150px;">-->
                            @*@Html.DropDownListFor(Model => Model.Banks, (SelectList)ViewBag.bank, new { @class = "multiselectDropdownField form-control-multiselect form-control-sm", @multiple = "multiple", onchange = "GetList()", data_db_filter = "true" })*@

                            @*@Html.ListBoxFor(Model => Model.Banks, (SelectList)ViewBag.bank, new
        {
            @class = "multiselectDropdownField form-control-multiselect form-control-sm",
            @multiple = "multiple",
            onchange = "GetList()",
            data_db_filter = "true",


        })*@


                            <!--</div>
    </div>-->





                            <div class="tab-items">
                                <label> Bank</label>
                                <div class="form-group filter-combobox  pl-2" style="width: 140px;">

                                    @*<select class="form-control form-control-sm " id="exampleSelects">
                    <option>Demo</option>
                    <option>1</option>
                    <option>2</option>
                </select>*@

                                    @Html.ListBoxFor(Model => Model.Banks, (SelectList)ViewBag.bank, new
                               {
                                   @class = "multiselectDropdownFields form-control-multiselect form-control-sm",
                                   @multiple = "multiple",
                                   onchange = "getList()",
                                   data_db_filter = "true",


                               })




                                </div>

                            </div>






                            <div class="tab-items">
                                <label>Excel Format</label>
                                <div class="form-group filter-combobox mt-0" style="width: 200px;">


                                    @Html.DropDownListFor(Model => Model.BankStatementFormat.Code, (SelectList)ViewBag.format, new { @class = "form-control form-control-sm", @onchange = "showAllowance();getList()" })




                                </div>
                            </div>

                            <div class="tab-items hide bank_allowance" >
                                <label>Incentive</label>
                                <div class="form-group filter-combobox mt-0" style="width: 200px;">


                                    @Html.DropDownListFor(Model => Model.Allowance.Code, (SelectList)ViewBag.allowance, "--Incentive--", new { @class = "form-control form-control-sm Aname", @onchange = "fillData();validate(this,'TypeAllowance')" })




                                </div>
                            </div>




                            <div class="tab-items select-option high">



                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn" data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <button data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                        data-bs-original-title="Export to Excel" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </button>
                                <button data-bs-toggle="tooltip" title="" class="notepad btn btn-excel float-left"
                                        data-bs-original-title="Export to Notepad" onclick="OnNotepadClick()">
                                    <i class="icon-xl far fa-notepad"></i>
                                    @*<img src="~/images/notes_768818.png" style="width:100%; height:100%" />*@
                                </button>


                            </div>


                        </div>
                    </div>

                    <div id="BankStatementList">
                        @await Html.PartialAsync("~/Areas/PayRoll/Reports/Views/BankStatementReport/_BankStatementReportList.cshtml")
                    </div>

                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_FilterMultiSelect.cshtml", Model.Filter)
                    </div>

                    <!--end: Datatable-->
                    <div class="row card-footer-bottom-fixed border-none">

                        <div class="col-md-12 align-left">


                        </div>

                    </div>
                </div>
            </div>

        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>



<div id="myDiv" class="modal fade bd-example-modal-lg" tabindex="-1"
     role="dialog" aria-labelledby="myLargeModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg" style=" max-width: 1051px; height:400px;">
        <div  class="modal-content popup">
            <div class="modal-header" style="padding:10px">
                <h5 class="modal-title" id="exampleModalLabel">
                    Bank Account Number Duplication

                </h5>
                <button type="button" class="close"
                        data-bs-dismiss="modal" aria-label="Close"onclick="ClosePopup()">
                    <i aria-hidden="true"
                       class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-body">

            </div>



        </div>
    </div>
</div>
