@model Tuple<Hrms.Lite.Shared.PayRoll.Reports.SalaryReports, System.Data.DataTable>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>
<link href="https://kendo.cdn.telerik.com/2023.1.117/styles/kendo.bootstrap-main.min.css" rel="stylesheet" type="text/css" />
<script src="https://kendo.cdn.telerik.com/2023.1.117/js/kendo.all.min.js"></script>
<script src="https://kendo.cdn.telerik.com/2023.1.117/js/kendo.aspnetmvc.min.js"></script>
<script src="~/scripts/PayRoll/Reports/NonPayrollAllowanceReport.js"></script>



<div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">

    <div id="kt_header" class="header header-fixed">

        <div class="container-fluid d-flex align-items-stretch justify-content-between">


            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">

                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title"> Non Payroll Allowance Report</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            Non Payroll Allowance Report
                        </li>
                    </ul>
                </div>
            </div>

        </div>

    </div>

    <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body">
                        <!--begin: Search Form-->

                        <div class="row tab-style-button">
                            <div class="tab-button-wrap align-items-center">



                                <div class="tab-items">

                                    <div class="row-outer pb-2 " style="width:180px">

                                        <div class="form-group filter-combobox mr-10 highs mb-0 mt-2">
                                            @Html.DropDownListFor(m => m.Item1.PayrollMonth.Code, (SelectList)ViewBag.month, new { @class = "form-control form-control-sm", @onchange = "GetList()" })

                                        </div>
                                    </div>
                                </div>
                                <div class="tab-items">

                                </div>

                                <div class="form-group filter-combobox mr-10 highs mb-0 mt-2">

                                </div>

                                <div class="tab-items highs d-flex align-items-center highs">


                                 @*   <button type="button" onclick="showDetails()" class="btn btn-default btn-sm float-left">
                                        Settings
                                    </button>*@


                                </div>

                                <div class="tab-items select-option lows">



                                    <div class="sraech-slider">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>


                                    <div id="filterForm" class="filter-button slider-btn" data-bs-toggle="tooltip" title="Filter">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>
                                    <button data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                            data-bs-original-title="Export to Excel">
                                        <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                    </button>

                                </div>

                              
                            </div>
                        </div>


                        <div id="NonPayrollList">
                            @await Html.PartialAsync("~/Areas/PayRoll/Reports/Views/NonPayrollAllowanceReport/_List.cshtml", Model)
                        </div>
                        <div id="filterSlider">
                            @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Item1.Filter)
                        </div>
                    </div>



                    <!--end: Datatable-->
                    <!--end: Datatable-->
                </div>

                <div class="row card-footer-bottom-fixed">


                </div>



            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
