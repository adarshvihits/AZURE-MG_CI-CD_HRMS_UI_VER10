
@model Hrms.Lite.Shared.PayRoll.Reports.SalaryReports
    <script src="~/js/settings.js"></script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Non-Payroll-Allowance-Report-list">
    @Html.HiddenFor(m => m.Data.Count)

            <table style="table-layout:auto;" class="common-table">
                <thead>
                    <tr class="table-dark">
                        <th scope="col" class="sticky-col  groupsummary-cols">ID</th>
                        <th scope="col" class="sticky-col totals-col">Employee Name</th>

                        @for (int i = 2; i < Model.MainList.Header.Count; i++)
                        {
                            <th scope="col" class="basic-col">@Model.MainList.Header[i].HeaderName</th>
                        }







                        @*<th scope="col" class="basic-cols">Designation</th>


        <th scope="col" class="basic-cols">Department</th>
        <th scope="col" class="basic-cols">Location</th>
        <th scope="col" class=" basic-cols">Grauity</th>
        <th scope="col" class=" basic-cols">Others</th>
        <th scope="col" class=" basic-cols">Total</th>*@




                    </tr>
                </thead>
                <tbody>


                    @if (Model.Data != null && Model.Data.Count > 0)
                    {

                        @for (int i = 0; i < Model.Data.Count; i++)
                        {



                    <tr>
                        <td data-label="ID" class="sticky-col groupsummary-cols">@Model.Data[i]["Employee"].employeeID</td>
                        <td data-label="Employee Name" class="sticky-col totals-col">
                            @Model.Data[i]["Employee"].employeeName

                        </td>
                        <td data-label="Location" class=" basic-cols">@Model.Data[i]["Employee"].location</td>
                        <td data-label="Designation" class="sticky-col basic-col"> @Model.Data[i]["Employee"].designation</td>

                        <td data-label="Department" class="sticky-col basic-col">@Model.Data[i]["Employee"].department</td>

                        <td data-label="PF No" class="sticky-col basic-col">@Model.Data[i]["Employee"].pfNumber</td>
                        <td data-label="Payment type" class="sticky-col basic-col">@Model.Data[i]["Employee"].presentDays</td>
                        <td data-label="Payment type" class="sticky-col basic-col">@Model.Data[i]["Employee"].paymentMode</td>
                        <td data-label="Payment type" class="sticky-col basic-col">@Model.Data[i]["Employee"].lop</td>


                        @for (int j = 9; j < Model.MainList.Header.Count; j++)
                        {

                            <td data-label="ID" class="basic-col">
                                @Model.Data[i][Model.MainList.Header[j].FieldName]

                            </td>
                        }
                        @*<td data-label="Designation" class="">Ui Designer</td>

        <td data-label="Department" class="basic-cols">Software</td>
        <td data-label="Location" class=" basic-cols">Smart City</td>
        <td data-label="PF No" class=" basic-cols">20000</td>
        <td data-label="Payment type" class=" basic-cols">30000</td>
        <td data-label="Payment type" class=" basic-cols">50000</td>*@



                    </tr>



                        }
                    }




                        </tbody>
            @*</tablestyle="table-layout:auto;">*@
                </table>
        </div>
