@model Hrms.Lite.Shared.TimeOffice.LeaveEncashment

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table  Leave-Encashment-projection-list">
    @Html.HiddenFor(m=>m.LeaveEncashmentList.Count)
    <table id="ProjcetionTable">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Date of Joining">DOJ</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Current Leave Balance">Curr.L.B</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Maximum Limit For Encashable">Max.Encash</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Encashable Leave Count">ELC</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Last Drawn Salary">LDS</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Leave Encashment Applicable Salary">Appl.Sal</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Eligible Leave Encashment Amount">Encash.Amt</th>

            </tr>
        </thead>
        <tbody>

        


        </tbody>
    </table>



</div>