@model Hrms.Lite.Shared.PayRoll.Reports.BankStatement
    <script src="~/js/jquery.min.js"></script>
    <script src="~/js/datatables.min.js"></script>
    <script src="~/scripts/PayRoll/Reports/AccountStatement.js"></script>
    @{
        ViewData["Title"] = "Index";
        Layout = "~/Views/Shared/_Layout.cshtml";
    }

    <div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
        <!--begin::Header-->
        <div id="kt_header" class="header header-fixed">
            <!--begin::Container-->
            <div class="container-fluid d-flex align-items-stretch justify-content-between">
                <!--begin::Header Menu Wrapper-->


                <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                    <!--begin::Header Menu-->
                    <div class="d-flex align-items-baseline flex-wrap mr-5">
                        <h3 class="main-title">Account Statement </h3>
                        <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                            <li class="breadcrumb-item ">
                                <a href="@Url.Action("Index", "Home", new { Area = "" })" class=""><i class="icon-nm fas fa-home"></i></a>
                            </li>

                            <li class="breadcrumb-item text-muted">
                                Account Statement
                            </li>
                        </ul>
                    </div>
                </div>
                <!--begin::Topbar-->
                <div class="topbar">


                </div>
                <!--end::Topbar-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Header-->
        <!--begin::Content-->
        <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
            <!--begin::Entry-->
            <div class="d-flex flex-column-fluid">
                <!--begin::Container-->
                <div class="container full-width">
                    <!--begin::Dashboard-->
                    <!--begin::Row-->



                    <div class="card card-custom height-100per footer-row-fixed">

                        <div class="card-body">
                            <!--begin: Search Form-->

                            <div class="row tab-style-button">
                                <div class="tab-button-wrap align-items-center">





                                    <div class="tab-items">
                                        <label>Month</label>
                                        <div class="form-group filter-combobox mt-0">

                                            @Html.DropDownListFor(m => m.Month.Code, (SelectList)ViewBag.Month, new { @class = "form-control form-control-sm", @onchange = "GetList()" })

                                        </div>
                                    </div>



                                    <div class="tab-items select-option high">




                                        <button data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                                data-bs-original-title="Export to Excel">
                                            <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                        </button>

                                        <button data-bs-toggle="tooltip" title=""
                                                class="btn btn-excel float-left btn-pdf"
                                                data-bs-original-title="Export to Pdf" id="export">
                                            <i class="fa fa-file" aria-hidden="true" onclick="exportPdf()"></i>
                                        </button>


                                    </div>


                                </div>
                            </div>
                            <div id="AccountStatementList">
                                @await Html.PartialAsync("~/Areas/PayRoll/Reports/Views/AccountStatement/_AccountStatementList.cshtml", Model)
                            </div>
                            <!--end: Datatable-->
                            <!-- <div class="row card-footer-bottom-fixed ">

                                <div class="col-md-12 align-right">
                                    <a type="button"
                                        class="btn btn-default  mobile-full-width">
                                        Generate ECR
                                    </a>

                                </div>

                            </div> -->
                        </div>
                    </div>


                    <!--end::Row-->
                    <!--begin::Row-->
                    <!--end::Row-->
                    <!--end::Dashboard-->
                </div>
                <!--end::Container-->
            </div>
            <!--end::Entry-->

        </div>
        <div class="slider-over-flow"></div>
        <!--end::Content-->


    </div>