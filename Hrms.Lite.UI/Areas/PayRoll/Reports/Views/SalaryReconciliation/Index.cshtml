@model Hrms.Lite.Shared.PayRoll.Reports.SalaryReconciliation
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/PayRoll/Reports/salaryReconciliation.js"></script>
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->

        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Salary Comparison </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index","Home",new { Area=""})"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Salary Comparison
                    </li>
                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <!--begin: Search Form-->
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="form-group filter-combobox pt-2 pl-2 mr-3"
                                 style="width: 210px;">
                                @Html.DropDownListFor(m => m.CompareWith.Code, (SelectList)ViewBag.PayRollRptCompareWith, "--Select Current Month--", new { @class = "form-control form-control-sm", @onchange = "validateMonths();onCurrentMonthChange();$('#cmpWith').html($('#CompareWith_Code option:selected').text())" })
                                <span id="compare"></span>
                            </div>

                            <div class="form-group filter-combobox pt-2 pl-2 mr-3"
                                 style="width: 210px;">
                                @Html.DropDownListFor(m => m.SelectedMonth.Code, (SelectList)ViewBag.PayRollRptMonth, "--Select Previous Month--", new { @class = "form-control form-control-sm", @onchange = "validateMonths();$('#mthName').html($('#SelectedMonth_Code option:selected').text())" })
                                <span id="month"></span>
                            </div>


                            <div class="form-group filter-combobox pt-2 pl-2 mr-3"
                                 style="width: 160px;">
                                @Html.DropDownListFor(m => m.Status.Code, (SelectList)ViewBag.Status, new { @class = "form-control form-control-sm", @onchange = "onStatusChange()" })
                                <span id="status"></span>
                            </div>
                            <div class="form-group filter-combobox pt-2 pl-2 mr-3"
                                 style="width: 160px;">
                                @Html.DropDownListFor(m => m.PayrollGroup, (SelectList)ViewBag.PayrollGroup, new { @class = "form-control form-control-sm" })
                                <span id="status"></span>
                            </div>

                            <div class="tab-items pl-3 pt-3  d-flex align-items-center">

                                <button type="button" class="btn btn-default btn-sm float-left" onclick="Proceed()">
                                    Proceed
                                </button>
                            </div>












                            <div class="tab-items select-option d-flex align-items-center">
                                <!-- <label class="lable-left">Evaluation Period</label> -->
                                @*<div class="form-group filter-combobox pt-2 pl-2 mr-10"
                 style="width: 160px;">
                <label>Employee</label>
                @Html.DropDownListFor(m => m.Employee.Code, (SelectList)ViewBag.Emp, "--Select--", new { @class = "form-control form-control-sm" })
            </div>*@


                                <div class="sraech-slider mt-0">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search" onclick="$('#searchList').focus();"></i>
                                    </div>
                                    <input id="searchList" type="text" class="form-control form-control-sm"
                                           placeholder="Search Here..." onkeyup="searchRows()">
                                </div>

                                @*<div class="filter-button" data-bs-toggle="tooltip" title="" data-bs-original-title="Filter">
                <i class="fas fa-filter"></i>
            </div>*@
                                <button data-bs-toggle="tooltip" title="" class="btn btn-excel float-left " data-bs-original-title="Export to Excel" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </button>
                            </div>



                        </div>
                    </div>
                    <!-- Table Section -->
                    <div id="listView">

                        @await Html.PartialAsync("~/Areas/PayRoll/Reports/Views/SalaryReconciliation/_List.cshtml", Model)
                    </div>

                    <!-- Table Setion End -->
                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>

</div>
<!--end::Content-->
<!--end::Entry-->

<div class="modal fade sr-example-modal-lg" tabindex="-1"
     role="dialog" aria-labelledby="myLargeModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg" style="max-width:1000px;">
        <div class="modal-content popup">
            <div class="modal-header" style="padding:10px">
                <h5 class="modal-title"
                    id="exampleModalLabel">
                    Salary Comparison Employee Details : <span style="font-size:13px ;"><span id="mthName"></span> Comparison with <span id="cmpWith"></span> ( <span id="allw"></span> ) </span>
                </h5>
                <button type="button" class="close"
                        data-bs-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true"
                       class="ki ki-close" onclick="$('#filterSlider').addClass('hide')"></i>
                </button>
            </div>

            <div class="modal-body new-salary">
                @await Html.PartialAsync("~/Areas/PayRoll/Reports/Views/SalaryReconciliation/_PopUp.cshtml")
            </div>


        </div>
    </div>
</div>

