@model Hrms.Lite.Shared.PayRoll.Reports.SalaryReconciliation
<script src="~/js/tooltip.js"></script>
@*<script src="~/js/settings.js"></script>*@
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table salary-recoreport-new-list-tble vertical-scroll-350">
    <table id="salryReconciliationTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">
                    Description
                </th>
                <th scope="col" data-bs-toggle="tooltip" title="Previous  Employee Count">Pre. Emp. Count    </th>

                <th scope="col" data-bs-toggle="tooltip" title=""> Cur.Emp Count  </th>

                <th scope="col" data-bs-toggle="tooltip" title="">Prev.Gross   </th>


                <th scope="col" data-bs-toggle="tooltip" title="">    Cur.Gross    </th>
                <!-- <th data-bs-toggle="tooltip" title="Employer PF" scope="col">ERPF%</th>
                <th data-bs-toggle="tooltip" title="Employee Pension scheme"
                    scope="col">EPS%</th> -->
                <th scope="col">Pre.Earnings   </th>
                <th scope="col" data-bs-toggle="tooltip" title=""> Cur.Earnings</th>
                <th scope="col">Variance in Earnings</th>

            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.SalaryReconciliationDetails != null && Model.SalaryReconciliationDetails.Count > 0)
            {

                for (int i = 0; i < Model.SalaryReconciliationDetails.Count; i++)
                {
            <tr>
                @if (Model.SalaryReconciliationDetails[i].Link == true)
                {
                    <td data-label="Previous Month Employee Count">

                        <a href="" data-bs-toggle="modal" data-target=".sr-example-modal-lg" onclick="fillData(@Model.SalaryReconciliationDetails[i].Code, '@Model.SalaryReconciliationDetails[i].Type');
                            $('#allw').html('@Model.SalaryReconciliationDetails[i].Description');">
                            @Model.SalaryReconciliationDetails[i].Description
                            @Html.HiddenFor(m => m.SalaryReconciliationDetails[i].Code)
                            @Html.HiddenFor(m => m.SalaryReconciliationDetails[i].Type)
                        </a>
                        @Html.HiddenFor(m => m.SalaryReconciliationDetails.Count)


                    </td>

                }
                else
                {
                    <td data-label="Previous Month Employee Count">


                        @Model.SalaryReconciliationDetails[i].Description
                        </td>

                        }
                    <td data-label="Previous Month Employee Count" style="text-align: end;">

                        @Model.SalaryReconciliationDetails[i].PreviousEmpCount

                    </td>
                    <td data-label="Current Month Employee Count" style="text-align: end;">
                        @Model.SalaryReconciliationDetails[i].CurrentEmpCount


                    </td>
                    <td data-label="Variance" style="text-align: end;">@Model.SalaryReconciliationDetails[i].PreviousGross</td>

                    <td data-label="Previous Month Actual Gross" style="text-align: end;">@Model.SalaryReconciliationDetails[i].CurrentGross</td>
                    <!-- <td data-label="Evaluation Period">Evaluation A</td> -->

                    <td data-label="Current Month Actual Gross" style="text-align: end;">@Model.SalaryReconciliationDetails[i].PreviousEarning</td>
                    <td data-label="Variance" style="text-align: end;">@Model.SalaryReconciliationDetails[i].CurrentEarning</td>
                    <td data-label="Previous Month Earnings" style="text-align: end;">@Model.SalaryReconciliationDetails[i].Variance</td>




                </tr>
                }
            }
            else
            {
        <tr>
            <td colspan="8">
            <div style="text-align: center;display: flex;align-items: center;justify-content: center;height: 60vh;"><img src="/images/nodata.png" /></div>
       </td>
                </tr>
            }


        </tbody>
    </table>
</div>