@model Hrms.Lite.Shared.PayRoll.GratuityProcessing


<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Gratuity_processinglist">
    @Html.HiddenFor(m => m.GratuityReport.Count)
    
    <table id="Gratuity_Table_Report" class="common-table">

        <thead>
            <tr class="table-dark">

                <th scope="col">ID</th>
                <th scope="col">Name</th>
                <th scope="col">Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col" data-bs-toggle="tooltip" data-placement="top" title="Date of Joining">DOJ</th>
                <th scope="col" data-bs-toggle="tooltip" data-placement="top" title="Date of Confirmation">DOC</th>
                <th scope="col" data-bs-toggle="tooltip" data-placement="top" title="Last Working Date">LWD</th>
                <th scope="col" data-bs-toggle="tooltip" data-placement="top" title="Breaking Years">BY</th>
                <th scope="col" data-bs-toggle="tooltip" data-placement="top" title="Actual Years">AY</th>
                <th scope="col" data-bs-toggle="tooltip" data-placement="top" title="Gratuity Amount">GA</th>
                <th scope="col" data-bs-toggle="tooltip" data-placement="top" title="Cheque Number">Cheque Num</th>
                <th scope="col" data-bs-toggle="tooltip" data-placement="top" title="Cheque Date">Cheque Date</th>
                <th scope="col">Aadhar</th>
                <th scope="col">UAN</th>
                <th scope="col">PF</th>
                @*<th scope="col">ESI</th>*@
                @*<th scope="col">LIC</th>*@

            </tr>
        </thead>
        <tbody>        </tbody>
    </table>
</div>
