@model Hrms.Lite.Shared.PayRoll.Reports.LWFReport
<script src="~/js/settings.js"></script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table LWF_report_list">
    <table id="LWFtable" class="common-table">

        @Html.HiddenFor(m=>Model.LWFReportList.Count)
        <thead>
            <tr class="table-dark">



                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th scope="col">Employee Contribution</th>
                <th scope="col">Employer Contribution</th>

            </tr>
        </thead>

        <tbody>



            @{
                if (Model.LWFReportList != null && Model.LWFReportList.Count > 0)
                {
                    for (int i = 0; i < Model.LWFReportList.Count; i++)

                    {
                        <tr>
                            <td data-label="EmployeeID">
                                @Model.LWFReportList[i].EmployeeID
                            </td>
                            <td data-label="Name">@Model.LWFReportList[i].EmployeeName </td>
                            <td data-label="Designation">@Model.LWFReportList[i].Designation </td>
                            <td data-label="Department">@Model.LWFReportList[i].Department</td>
                            <td data-label="Location">@Model.LWFReportList[i].Location</td>
                            <td data-label="EmployeeContribution">@Model.LWFReportList[i].EmployeeContribution</td>
                            <td data-label="EmployerContribution">@Model.LWFReportList[i].EmployerContribution</td>
                        </tr>
                    }
                }
           
            }

            </tbody>



        </table>
</div>
