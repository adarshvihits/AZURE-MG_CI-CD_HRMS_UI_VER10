@model Hrms.Lite.Shared.PayRoll.Reports.CashStatement
@*<script src="~/js/settings.js"></script>*@

<script>
    $(document).ready(function () {
        fillData();
    });
</script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table cash_statement_list" >
    @Html.HiddenFor(m => m.Details.Count)
    <table id="CashStatementTable">
        <thead>
            <tr class="table-dark">

                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>                
                <th scope="col" data-bs-toggle="tooltip"
                    data-bs-original-title="Date Of Joining" scope="col">DOJ</th>              
                <th scope="col">Net Amount</th>                
            </tr>
        </thead>
    
    </table>
</div>

