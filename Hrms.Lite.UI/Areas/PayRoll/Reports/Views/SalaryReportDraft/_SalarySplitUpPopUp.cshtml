@model Hrms.Lite.Shared.PayRoll.Reports.NetPaySplitUp


<script src="~/js/tooltip.js"></script>
<link href="~/css/custom.css" rel="stylesheet" />
<style>
    .popup_payslip.table-border table thead tr th, td {
        border: 1px solid #EBEDF3 !important;
    }
</style>

<div class="profile-header position-relative pb-12 mb-5"
     style="padding-bottom: 2px !important; padding-top: 5px !important; border: 1px solid #D5D5D5; border-radius:10px;">
    <div class="row">
        @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeeSliderHeader.cshtml", Model.EmployeeHeader)
    </div>
    <div class="profile-header-overflow"></div>
</div>


<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-3">
                <div class="row-outer  ">
                    <label class="view-title">
                        Month
                    </label>
                    <div class="view-details text-center-align">
                        @Model.Month

                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="row-outer ">
                    <label class="view-title">PayRollGroup</label>
                    <div class="view-details text-center-align">
                        @Model.PayrollGroup

                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="row-outer ">
                    <label class="view-title">Category</label>
                    <div class="view-details text-center-align">
                        @Model.Category

                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="row-outer ">
                    <label class="view-title">Section</label>
                    <div class="view-details text-center-align">
                        @Model.Section

                    </div>
                </div>
            </div>


        </div>

    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-3">
                <div class="row-outer ">
                    <label class="view-title">
                        Grade
                    </label>
                    <div class="view-details text-center-align">
                        @Model.Grade

                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="row-outer ">
                    <label class="view-title">
                        DOJ
                    </label>
                    <div class="view-details text-center-align">
                        @Model.DOJ

                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="row-outer ">
                    <label class="view-title">Last Working Date </label>
                    <div class="view-details text-center-align">
                        @Model.LastWrkDay

                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="row-outer ">
                    <label class="view-title">Total Leave Days </label>
                    <div class="view-details text-center-align">
                        @Model.TotLeaveDay

                    </div>
                </div>
            </div>
        </div>

        </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="row">
            <div class="col-md-3">
                <div class="row-outer ">
                    <label class="view-title">
                        Pay Days
                    </label>
                    <div class="view-details text-center-align">
                        @Model.PayDay

                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="row-outer ">
                    <label class="view-title">Less HR Days </label>
                    <div class="view-details text-center-align">
                        @Model.LessHRDay

                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="row-outer ">
                    <label class="view-title">LOP Days</label>
                    <div class="view-details text-center-align">
                        @Model.LOPDay

                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="row-outer ">
                    <label class="view-title">
                        Prev LOP Days
                    </label>
                    <div class="view-details text-center-align">
                        @Model.PrevLOPDay

                    </div>
                </div>
            </div>





        </div>

    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="row">

            <div class="col-md-3">
                <div class="row-outer ">
                    <label class="view-title">LJP</label>
                    <div class="view-details text-center-align">
                        @Model.LJP

                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="row-outer ">
                    <label class="view-title">LTP </label>
                    <div class="view-details text-center-align">
                        @Model.LTP

                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="row-outer ">
                    <label class="view-title">
                        Prev Month Arrear
                    </label>
                    <div class="view-details text-center-align">
                        @Model.PrevMonthArrear

                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="row-outer ">
                    <label class="view-title">OT Hous</label>
                    <div class="view-details text-center-align">
                        @Model.Others

                    </div>
                </div>
            </div>


        </div>

    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <div class="row">            
            <div class="col-md-3">
                <div class="row-outer">
                    <label class="view-title">Less Hour Amount</label>
                    <div class="view-details text-center-align">
                        @Model.LessHRAmount

                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div style="padding:0px;"
             class="ihits-table table-border hover-color odd-even mobile-responsive-table SalaryRpt-Draft-SplitUp vertical-scroll-150 popup_payslip">
            <table id="SalarySplitUPopup">
                <thead>
                    <tr class="table-light">
                        <th scope="col">Earnings</th>
                        <th data-bs-toggle="tooltip" title="" scope="col" data-bs-original-title="Actual Amount">Actual Amt</th>
                        <th data-bs-toggle="tooltip" title="" scope="col" data-bs-original-title="Earned Amount">Earned Amt</th>
                        <th scope="col" style=" padding-left: 15px;">Deduction</th>
                        <th data-bs-toggle="tooltip" title="" scope="col" data-bs-original-title=" Amount"> Amt</th>


                    </tr>
                </thead>
                <tbody>
                    @{
                        if (Model.AllowanceDetails != null && Model.AllowanceDetails.Count > 0)
                        {
                            for (int i = 0; i < Model.AllowanceDetails.Count; i++)

                            {
                                <tr>
                                    <td data-label="Earnings">
                                        @Model.AllowanceDetails[i].Earnings
                                    </td>
                                    <td data-label="Actual">
                                        @Model.AllowanceDetails[i].ActualAmount
                                    </td>
                                    <td data-label="earned">
                                        @Model.AllowanceDetails[i].EarnedAmount
                                    </td>
                                    <td data-label="Ded" style=" padding-left: 19px !important;">
                                        @Model.AllowanceDetails[i].Deduction
                                    </td>
                                    <td data-label="Month">
                                        @Model.AllowanceDetails[i].Amount
                                    </td>




                                </tr>



                            }
                        }
                    }

                    <tr style="position: sticky; bottom: 0; background-color: aliceblue;">
                        <td>
                            <strong>  <span id="totearned">Total</span></strong>
                        </td>
                        <td>
                            <strong>  <span id="totearned">  @Model.PaOrgAmt</span></strong>
                        </td>
                        <td>
                            <strong>  <span id="totearned">     @Model.PaAmt</span></strong>
                        </td>
                        <td>
                            <strong>  <span id="totearned"></span></strong>
                        </td>
                        <td>
                            <strong>  <span id="totearned">     @Model.DedAmt</span></strong>
                        </td>
                    </tr>

                </tbody>


            </table>

        </div>
      


        <div class="row">
            <div class="col-md-12 d-flex justify-content-end">
                <div class="d-flex pt-4">
                    <label class="view-title">NetPay:</label>
                    <div class="view-details text-center-align">
                        @Model.NetPay


                    </div>
                </div>

            </div>
        </div>
                
          
     



    </div>



