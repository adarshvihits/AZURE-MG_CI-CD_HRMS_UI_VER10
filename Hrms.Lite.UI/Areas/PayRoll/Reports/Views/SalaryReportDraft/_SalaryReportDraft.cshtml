@model Hrms.Lite.Shared.PayRoll.Reports.SalaryReportDraft
    <script src="~/js/tooltip.js"></script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table salaryreport-draft">
    @Html.HiddenFor(m => m.SalaryDraft.Count)
    <table id="SalaryReportDraft" class="common-table">
        <thead>
            <tr class="table-dark">


                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>
                <th data-bs-toggle="tooltip" title="" scope="col" data-bs-original-title=" LOP Days">LOP</th>
                <th data-bs-toggle="tooltip" title="" scope="col" data-bs-original-title=" Paid Days">Paid</th>
                <th data-bs-toggle="tooltip" title="" scope="col" data-bs-original-title=" Actual Gross">Act.Gross</th>
                <th data-bs-toggle="tooltip" title="" scope="col" data-bs-original-title=" Lop Amount">LOP Amt.</th>
                <th scope="col">Earned Gross</th>
                <th data-bs-toggle="tooltip" title="" scope="col" data-bs-original-title=" Total Deduction">Tot.Ded.</th>
                <th data-bs-toggle="tooltip" title="" scope="col" data-bs-original-title=" Hold Amount">Hold Amt.</th>
                <th scope="col">Net Pay</th>


            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>
