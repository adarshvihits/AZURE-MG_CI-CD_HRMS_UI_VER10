

@model Hrms.Lite.Shared.PayRoll.Reports.SalaryReports

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "non_Payroll_Allowance" }))
{


    <div style="padding:0 10px;"
         class="ihits-table table-border hover-color odd-even mobile-responsive-table Non-payroll-reg-popup-list vertical-scroll-250">




        <div class="row">
            <div class="col-md-12">
                <table id="nonPayrollTable">
                    <thead>
                        <tr class="table-light Non-payroll-reg-popup-list ">
                            <th scope="col"> Allowance</th>
                            <th scope="col">
                                <div class="checkbox-inline justify-content-center">
                                    <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                        @*<input type="checkbox" name="Checkboxes16" id="nonPayroll_Checkbox1" onchange="OnCheckBoxAllClick('nonPayroll_Checkbox1','nonPayrollTable')">*@

                                        @Html.CheckBoxFor(m => m.AllApplicable, new { @onclick = "onAllClick('AllApplicable','nonPayrollTable')" })


                                        <span></span>
                                    </label>
                                </div>
                            </th>
                    </thead>






                    <tbody>


                        @if (Model.Allowances != null && Model.Allowances.Count > 0)
                        {

                            for (int i = 0; i < Model.Allowances.Count; i++)
                            {
                                @Html.HiddenFor(model => Model.Allowances[i].Code)
                                <tr>
                                    <td data-label="Classification">
                                        @Model.Allowances[i].Name
                                    </td>
                                    <td data-label="Count">
                                        <div class="checkbox-inline justify-content-center">
                                            <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                                @Html.CheckBoxFor(m => m.Allowances[i].Applicable,new { @onchange = "checkBoxClick(this,'nonPayrollTable','nonPayroll_Checkbox1')" })
                                                <span></span>
                                            </label>
                                        </div>

                                    </td>




                                </tr>

                            }
                        }















                    </tbody>


                </table>
            </div>

        </div>


    </div>
}