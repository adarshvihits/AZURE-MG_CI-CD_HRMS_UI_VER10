
@model Hrms.Lite.Shared.PayRoll.Reports.SalaryReports


@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "SalaryDetailedpopup" }))
{

    <div 
         class="ihits-table table-border hover-color odd-even mobile-responsive-table emp-group-list-table vertical-scroll-250">



        <br>

        <div class="row">
            <div class="col-md-6">
                <table id="SalaryAllowances">
                    <thead>
                        <tr class="table-light">
                            <th scope="col"> Allowance</th>
                            <th scope="col">
                                <div class="checkbox-inline justify-content-center">
                                    <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                        <input type="checkbox"
                                               name="Checkboxes16" id="Salary_Checkbox1" onchange="OnCheckBoxAllClick('Salary_Checkbox1','SalaryAllowances')">
                                        <span></span>
                                    </label>
                                </div>
                            </th>


                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Allowances != null && Model.Allowances.Count > 0)
                        {

                            for (int i = 0; i < Model.Allowances.Count; i++)
                            {
                                @Html.HiddenFor(model => Model.Allowances[i].Code)
                                <tr>
                                    <td data-label="Classification">
                                        @Model.Allowances[i].Name
                                    </td>
                                    <td data-label="Count">
                                        <div class="checkbox-inline justify-content-center">
                                            <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                                @Html.CheckBoxFor(m => m.Allowances[i].Applicable )
                                                <span></span>
                                            </label>
                                        </div>

                                    </td>




                                </tr>


                            }
                        }












                            </tbody>


                </table>

            </div>

            <div class="col-md-6">
                <table id="salaryDeductions">
                    <thead>
                        <tr class="table-light">
                            <th scope="col"> Deduction</th>
                            <th scope="col">
                                <div class="checkbox-inline justify-content-center">
                                    <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                        <input type="checkbox"
                                               name="Checkboxes16"id="Salary_Checkbox" onchange="OnCheckBoxAllClick('Salary_Checkbox','salaryDeductions')">
                                        <span></span>
                                    </label>
                                </div>
                            </th>


                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Deductions != null && Model.Deductions.Count > 0)
                        {

                            for (int i = 0; i < Model.Deductions.Count; i++)
                            {
                                @Html.HiddenFor(model => Model.Deductions[i].Code)
                                <tr>
                                    <td data-label="Classification">
                                        @Model.Deductions[i].Name
                                    </td>
                                    <td data-label="Count">
                                        <div class="checkbox-inline justify-content-center">
                                            <label class="checkbox checkbox-outline checkbox-outline-1x checkbox-primary text-muted">
                                                @Html.CheckBoxFor(m => m.Deductions[i].Applicable)
                                                <span></span>
                                            </label>
                                        </div>

                                    </td>




                                </tr>


                            }
                        }











                            </tbody>


                </table>

            </div>

        </div>

    </div>
}