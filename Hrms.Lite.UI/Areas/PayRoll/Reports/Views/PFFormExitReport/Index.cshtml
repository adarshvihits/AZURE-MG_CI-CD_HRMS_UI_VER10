

@model Hrms.Lite.Shared.PayRoll.Reports.PFExitReport


<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>
<script src="~/scripts/PayRoll/Reports/PFExitReport.js"></script>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">PF ExitUpload ECR Report</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        PF ExitUpload ECR Report
                    </li>
                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                    <!--begin: Search Form-->

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap ">

                            <div class="tab-items ">

                                <div>
                                 
                                    <div class="row-outer " style="width:200px;">
                                        <div class="form-group">
                                            <label>Salary Period</label>
                                            @Html.DropDownListFor(m => m.Month, (SelectList)ViewBag.SalaryPeriod, "--select--", new { @class = "form-control form-control-sm reset", @onchange = "fillData()" })
                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="tab-items ">
                                <div>
                                    <div class="row-outer " style="width:200px;">
                                        <div class="form-group">
                                            <label>PF Group</label>
                                            @Html.DropDownListFor(m => m.PFGroup, (SelectList)ViewBag.PfGp, "--select--", new { @class = "form-control form-control-sm reset", @onchange = "fillData()" })
                                        </div>
                                    </div>


                                </div>
                            </div>



                            <div class="tab-items select-option pt-4">
                                <div class="d-flex align-items-center">


                                    <div class="sraech-slider mt-0">
                                        <div class="search-slider-inner">
                                            <i class="fa fa-search"></i>
                                        </div>
                                        <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                               placeholder="ID/Name">
                                    </div>

                                    <div id="filterForm" class="filter-button slider-btn pt-5" data-bs-toggle="tooltip" title="Filter">
                                        <i class="fas fa-filter"></i>
                                        <i class="fas fa-check"></i>
                                    </div>        
                                    <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left pt-2"
                                                        data-bs-original-title="Export to Excel">
                                        <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                    </a>

                                    <button data-bs-toggle="tooltip" title="" class="notepad btn btn-excel float-left pt-3"
                                            data-bs-original-title="Export to Notepad" onclick="OnNotepadClick()">
                                        <i class="icon-xl far fa-notepad"></i>
                                        @*<img src="~/images/notes_768818.png" style="width:100%; height:100%" />*@
                                    </button>
                                </div>
                            </div>


                        </div>
                    </div>


                    <div id="Emplist">

                        @await Html.PartialAsync("~/Areas/PayRoll/Reports/Views/PFFormExitReport/_ExitEmpList.cshtml", Model)
                    </div>

                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)
                    </div>

                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->s
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
