@model Hrms.Lite.Shared.PayRoll.Reports.PTReport
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>

<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/PayRoll/Reports/PTReport.js"></script>
<!--begin::Header-->
<script>
    $(document).ready(function () {
        $('#PTGroupCode').prepend('<option value="0">All</option');
        $('#PTGroupCode').val(0);
            fillData();
        });
    </script>


<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">PT Report</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        PT Report
                    </li>

                </ul>
            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <!--begin: Search Form-->

                    <div class="row tab-style-button">

                        <div class="tab-button-wrap">
                            <div class="tab-items ml-5 pr-0 border-none select-option">
                                <div class="form-group filter-combobox mr-2" style="width: 141px;">


                                  
                                    @Html.DropDownListFor(m => m.PTGroupMonth, (SelectList)ViewBag.PTGrpMonth, new { @class = "form-control form-control-sm",@onchange="fillData()"})
                                    <span id="Month"></span>

                                </div>

                            </div>
                            <div class="tab-items ml-5 pr-0 border-none select-option">
                                <div class="form-group filter-combobox mr-2" style="width: 150px;">
                                   
                                    @Html.DropDownListFor(m => m.PTGroupCode, (SelectList)ViewBag.PTGrp, new { @class = "form-control form-control-sm", @onchange = "fillData()" })
                                    <span id="ptgrp"></span>
                                </div>

                            </div>


                            <div class="tab-items select-option">


                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                <div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>

                                <a data-bs-toggle="tooltip" title="Export to Excel"
                                   class="btn btn-excel mr-0" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </a>




                            </div>


                        </div>


                    </div>
                    <div id="ListView">
                        @await Html.PartialAsync("~/Areas/PayRoll/Reports/Views/PTReport/_List.cshtml")
                    </div>

                    <!-- Table Section -->
                    <!-- Table Setion End -->
                    <!--end: Datatable-->
                    <div id="filterSlider">                       
                        @await Html.PartialAsync("~/Views/Shared/_FilterMultiSelect.cshtml", Model.Filter)
                    </div>

                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div><!--end::Entry-->
<!--end::Content-->