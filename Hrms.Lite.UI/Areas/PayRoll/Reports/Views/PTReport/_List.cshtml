@model Hrms.Lite.Shared.PayRoll.Reports.PTReport

<style>


    .table_wrapper {
        display: block;
        white-space: nowrap;
        /*  background-color:#fff!important;*/
    }

        .table_wrapper tbody {
            overflow-y: visible !important;
        }

        .table_wrapper table thead {
            position: sticky;
            z-index: 16;
            top: 0;
        }

    

    ::-webkit-scrollbar {
        -webkit-appearance: none;
    }

        ::-webkit-scrollbar:vertical {
            width: 12px;
        }

        ::-webkit-scrollbar:horizontal {
            height: 12px;
        }

    ::-webkit-scrollbar-thumb {
        background-color: rgba(0, 0, 0, .5);
        border-radius: 10px;
        border: 2px solid #ffffff;
    }

    ::-webkit-scrollbar-track {
        border-radius: 10px;
        background-color: #ffffff;
    }

    .new-color-heding {
        color: black !important;
    }


    .back-color-new-add {
        background-color: #B2B3B5;
        height: 520px;
        box-shadow: rgba(99, 94, 102, 0.2) 0px -1px 15px 0px;
        border-radius: 10px;
    }


    .back-color-new-add-two {
        background-color: #B2B3B5;
        height: 288px;
        box-shadow: rgba(99, 94, 102, 0.2) 0px -1px 15px 0px;
        border-radius: 10px;
    }





</style>








<div class="ihits-table table-border hover-color odd-even mobile-responsive-table pt_report_list   table_wrapper ">
    @Html.HiddenFor(m => m.GetPTReportList.Count)
    <table id="PTReportTable" >
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">DOJ</th>
                <th data-bs-toggle="tooltip" title="Separation Date" scope="col">Sep. Date</th>
                <th   scope="col">PT Group</th>
                <th data-bs-toggle="tooltip" title="PT Duration" scope="col">PT. Dur</th>
                <th scope="col">Salary From</th>
                <th scope="col">Salary To</th>
                <th data-bs-toggle="tooltip" title="Remaining Month" scope="col">Rem. Mon</th>
                <th data-bs-toggle="tooltip" title="Actual Salary" scope="col">Act. Sal</th>
                <th data-bs-toggle="tooltip" title="Processed Salary " scope="col">Pro. Sal</th>
                <th data-bs-toggle="tooltip" title="Current Month Salary" scope="col">Curr. Mon. Sal</th>
                <th data-bs-toggle="tooltip" title="Projected Salary" scope="col">Pro. Sal</th>
                <th data-bs-toggle="tooltip" title="PT Salary" scope="col">PT. Sal</th>
                <th data-bs-toggle="tooltip" title="PT Amount" scope="col">PT. Amt</th>
                <th scope="col">PT Paid</th>
                <th data-bs-toggle="tooltip" title="Balance PT" scope="col">Bal. PT</th>
                <th data-bs-toggle="tooltip" title="Balance PT" scope="col">Curr. Mon. PT</th>

            </tr>
        </thead>
        <tbody>
            @*@if (Model != null && Model.TDSConfirmationList != null && Model.TDSConfirmationList.Count > 0)
