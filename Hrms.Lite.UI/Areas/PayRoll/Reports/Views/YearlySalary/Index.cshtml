@model Hrms.Lite.Shared.PayRoll.Reports.YearlySalary

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>
<script src="~/scripts/PayRoll/Reports/YearlySalary.js"></script>
<script src="~/js/datatables.min.js"></script>

<script>
    $(document).ready(function () {
        debugger;

        $('#EmpId').val('@Model.EmployeeCode');
        GetYearlySalaryDeatils();
    });
</script>
<div class="d-flex flex-column flex-row-fluid wrapper" id="kt_wrapper">
    <!--begin::Header-->
    <div id="kt_header" class="header header-fixed">
        <!--begin::Container-->
        <div class="container-fluid d-flex align-items-stretch justify-content-between">
            <!--begin::Header Menu Wrapper-->

            <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                <!--begin::Header Menu-->
                <div class="d-flex align-items-baseline flex-wrap mr-5">
                    <h3 class="main-title">Yearly Salary</h3>
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })" class=""><i class="icon-nm fas fa-home"></i></a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            Yearly Salary
                        </li>
                    </ul>
                </div>
            </div>

            <!--begin::Topbar-->
            <!--end::Topbar-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Header-->


    <!--begin::Content-->
    <div class="content d-flex flex-column flex-column-fluid " id="kt_content">
        <!--begin::Entry-->
        <div class="d-flex flex-column-fluid">
            <!--begin::Container-->
            <div class="container full-width">
                <!--begin::Dashboard-->
                <!--begin::Row-->



                <div class="card card-custom height-100per footer-row-fixed">

                    <div class="card-body">



                        <div class="row tab-style-button">
                            <div class="tab-button-wrap">
                                <div class="form-group col-md-2">
                                    <label>

                                    </label>
                                    @Html.HiddenFor(Model => Model.EmployeeGI)
                                    @Html.DropDownListFor(m => m.FinancialYear.Code, (SelectList)ViewBag.FinYear, "--Select Financial Year--", new { @class = "form-control form-control-sm", @onchange = "fillEmployeeDropdown()" })

                                </div>
                                <div class="form-group " style="width:396px ;">
                                    <label> </label>
                                    @Html.DropDownListFor(m => m.EmpId, (SelectList)ViewBag.Emp, @*"--Select Search by Employee name/ID--",*@ new
                               {
                                   @class = "selectpicker form-control form-control-sm",
                                  
                                   data_show_subtext = "true",
                                   data_live_search = "true",
                                   data_max_options = "0",
                                   @onchange= "GetYearlySalaryDeatils()"
                               })

                                    <!-- <div data-field="email" data-validator="notEmpty" class="error-message">This Field is required</div> -->
                                </div>



                                <div class="tab-items select-option">


                                    <button data-bs-toggle="tooltip" title="" class="btn btn-excel" data-bs-original-title="Export to Excel">
                                        <i class="icon-xl far fa-file-excel" onclick="ExportToExcel()"></i>
                                    </button>

                                </div>


                            </div>
                        </div>
                   
                       
                     

                        <div id="YearlySalaryDetailsList">
                         
                        </div>


                    </div>
                </div>


                <!--end::Row-->
                <!--begin::Row-->
                <!--end::Row-->
                <!--end::Dashboard-->
            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->

    </div>
    <div class="slider-over-flow"></div>
    <!--end::Content-->


</div>