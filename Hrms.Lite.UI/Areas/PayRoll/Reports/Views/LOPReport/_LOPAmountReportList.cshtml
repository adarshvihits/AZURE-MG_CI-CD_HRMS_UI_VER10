@model Hrms.Lite.Shared.PayRoll.Reports.LOPReport
    <script src="~/js/tooltip.js"></script>
<script src="~/js/settings.js"></script>


<div class="ihits-table table-border hover-color odd-even mobile-responsive-table LOP-amount-Report">

    @Html.HiddenFor(m => m.LOPReportList.Count)

    <table id="LopReportTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Department</th>
                <th scope="col">Fun.Designation</th>
                <th scope="col">Location</th>
                <th scope="col">LOP+AB</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="LOP+Absent Amount">Amount</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="ESI Leave">ESI</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="ESI Leave Amount">Amount</th>
                <th scope="col">LJP</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="LJP Amount">Amount</th>
                <th scope="col">LTP</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="LTP Amount">Amount</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Previous month LOP">Pre.LOP</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Previous month LOP Amount">Amount</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Total days of cutting">Tot.</th>
                @*<th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Total days of cutting Amount">Amount</th>*@
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Suspension">SUS</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Suspension Amount">Amount</th>
                <th scope="col">Layoff</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Layoff Amount">Amount</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Less Hours">Less Hrs.</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Less Hours Amount">Amount</th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Total cutting amount">Tot. Amount</th>

            </tr>
        </thead>
        <tbody>
            @{
                    if (Model.LOPReportList != null && Model.LOPReportList.Count > 0)
                    {
                        for (int i = 0; i < Model.LOPReportList.Count; i++)

                        {
                        <tr>
                            <td data-label="EmployeeID">
                                @Model.LOPReportList[i].EmployeeID
                            </td>
                            <td data-label="Name">@Model.LOPReportList[i].EmployeeName </td>
                            <td data-label="Department">@Model.LOPReportList[i].Department</td>
                            <td data-label="Designation">@Model.LOPReportList[i].Designation </td>

                            <td data-label="Location">@Model.LOPReportList[i].Location</td>
                            <td data-label="LOP+AB">@Model.LOPReportList[i].LOPAbsent</td>
                            <td data-label="Amount">@Model.LOPReportList[i].LOPAbsentAmount</td>
                            <td data-label="ESI Leave">@Model.LOPReportList[i].ESILeave</td>
                            <td data-label="Amount">@Model.LOPReportList[i].ESILeaveAmount</td>
                            <td data-label="LJP">@Model.LOPReportList[i].LJP</td>
                            <td data-label="Amount">@Model.LOPReportList[i].LJPAmount</td>
                            <td data-label="LTP">@Model.LOPReportList[i].LTP</td>
                            <td data-label="Amount">@Model.LOPReportList[i].LTPAmount</td>
                            <td data-label="Pre.LOP">@Model.LOPReportList[i].PrevLOP</td>
                            <td data-label="Amount">@Model.LOPReportList[i].PreviosLOPAmount</td>
                            <td data-label="Tot.">@Model.LOPReportList[i].TotCutDays</td>
                            @*<td data-label="Amount">@Model.LOPReportList[i].TotDaysToCutAmount</td>*@
                            <td data-label="SUS">@Model.LOPReportList[i].Suspension</td>
                            <td data-label="Amount">@Model.LOPReportList[i].SuspensionAmount</td>
                            <td data-label="Layoff">@Model.LOPReportList[i].Layoff</td>
                            <td data-label="Amount">@Model.LOPReportList[i].LayOffAmount</td>
                            <td data-label="Less Hrs.">@Model.LOPReportList[i].Latehrs</td>
                            <td data-label="Amount">@Model.LOPReportList[i].LessHoursAmount</td>
                            <td data-label="Tot. Amount">@Model.LOPReportList[i].TotCutAmt</td>

                        </tr>
                        }
                    }
                }
        </tbody>





    </table>





</div>
