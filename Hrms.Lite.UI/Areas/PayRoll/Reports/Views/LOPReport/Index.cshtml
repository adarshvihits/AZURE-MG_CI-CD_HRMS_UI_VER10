@model Hrms.Lite.Shared.PayRoll.Reports.LOPReport
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>

<script src="~/scripts/PayRoll/Reports/LOPReport.js"></script>


@*<script>
    $(document).ready(function () {
        GetList();
    });
</script>*@




<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->

        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title"> LOP Report</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index","Home",new { Area=""})"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        LOP Report
                    </li>
                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    <!--begin: Search Form-->
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">

                            <div class="tab-items d-flex align-items-center">

                                <!-- Dropdown -->
                                <div class="form-group filter-combobox mt-0 me-3" style="width:150px;">
                                    @Html.DropDownListFor(m => m.Month, (SelectList)ViewBag.Month, "--Select--", new { @class = "form-control form-control-sm", @onchange = "GetList()" })
                                </div>

                                <!-- Radio Buttons -->
                                <div class="radio-inline d-flex align-items-center">
                                    <label class="radio radio-outline radio-success me-3">
                                        @Html.RadioButtonFor(m => m.Type, "0", new { @onchange = "GetList()" })
                                        <span></span>LOP Count
                                    </label>
                                    <label class="radio radio-outline radio-success">
                                        @Html.RadioButtonFor(m => m.Type, "1", new { @onchange = "GetList()" })
                                        <span></span>LOP count with Amount
                                    </label>
                                </div>

                            </div>



                            @*<div class="tab-items">
                    <div class="form-group filter-combobox  pl-2" style="width: 192px;">
                        @Html.DropDownListFor(Model => Model.Leave.Code, (SelectList)ViewBag.Leave, "--Select Leave--", new
                   { @class = "form-control form-control-sm", @onchange = "validate(this,'proj_Leave');fillData();" })
                        <span id="proj_Leave"></span>

                    </div>
                </div>*@
                            <div class="tab-items select-option  align-items-center">









                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>



                                <div id="filterForm" class="filter-button slider-btn" data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>

                                <button data-bs-toggle="tooltip" title="" class="btn btn-excel" data-bs-original-title="Export to Excel" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </button>

                            </div>



                        </div>
                    </div>
                    <!-- Table Section -->

                    <div id="LOPListID">
                        @await Html.PartialAsync("~/Areas/PayRoll/Reports/Views/LOPReport/_LOPReportList.cshtml")
                    </div>
                    @*<div id="LOPAmtListID">
                        @await Html.PartialAsync("~/Areas/PayRoll/Reports/Views/LOPReport/_LOPAmountReportList.cshtml")
                    </div>*@

                    <div id="filterSlider">
                        @await Html.PartialAsync("~/Views/Shared/_EmployeeFilter.cshtml", Model.Filter)
                    </div>







                    @*Table section*@





















                    <!-- Table Setion End -->
                    <div class="row card-footer-bottom-fixed">



                    </div>














                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>

</div>
<!--end::Content-->
<!--end::Entry-->
