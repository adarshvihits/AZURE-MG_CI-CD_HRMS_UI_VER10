@model Hrms.Lite.Shared.Recruitment.MasterInterviewPanel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<link href="~/css/hrplan.css" rel="stylesheet" type="text/css" />
<link href="~/css/masterInterviewPanel.css" rel="stylesheet" type="text/css" />
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/Recruitment/masterInterviewPanel.js"></script>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Master Interview Panel</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Master Interview Panel
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <div class="card card-custom height-100per footer-row-fixed">
                <div class="card-body">

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items select-option mp-filter-bar">
                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="Search panel name or code">
                                </div>
                                <select class="form-control form-control-sm mp-filter" id="LocationFilter" onchange="loadMasterInterviewPanelList()">
                                    <option value="0">Branch: All</option>
                                    @foreach (var item in Model.LocationList ?? new List<Hrms.Lite.Shared.General.Dropdown>())
                                    {
                                        <option value="@item.Code">@item.Name</option>
                                    }
                                </select>
                                <select class="form-control form-control-sm mp-filter" id="DepartmentFilter" onchange="loadMasterInterviewPanelList()">
                                    <option value="0">Department: All</option>
                                    @foreach (var item in Model.DepartmentList ?? new List<Hrms.Lite.Shared.General.Dropdown>())
                                    {
                                        <option value="@item.Code">@item.Name</option>
                                    }
                                </select>
                                <select class="form-control form-control-sm mp-filter" id="SectionFilter" onchange="loadMasterInterviewPanelList()">
                                    <option value="0">Section: All</option>
                                    @foreach (var item in Model.SectionList ?? new List<Hrms.Lite.Shared.General.Dropdown>())
                                    {
                                        <option value="@item.Code">@item.Name</option>
                                    }
                                </select>
                                <select class="form-control form-control-sm mp-filter" id="GradeFilter" onchange="loadMasterInterviewPanelList()">
                                    <option value="0">Grade: All</option>
                                    @foreach (var item in Model.GradeList ?? new List<Hrms.Lite.Shared.General.Dropdown>())
                                    {
                                        <option value="@item.Code">@item.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div id="MasterInterviewPanelList">
                        @await Html.PartialAsync("_MasterInterviewPanelList", Model)
                    </div>

                    <div id="masterInterviewPanelSlider"></div>

                    <div class="row card-footer-bottom-fixed">
                        <div class="col-md-12 align-right">
                            @if (CurrentUserRoleActions.Create == true)
                            {
                                <a class="btn btn-default float-right mobile-full-width" onclick="onAddOrEditMasterInterviewPanel('CREATE')">
                                    Create Master Panel
                                </a>
                            }
                            else
                            {
                                <a class="btn btn-default float-right mobile-full-width" onclick="swal.fire(MasterPersmissionMsg);">
                                    Create Master Panel
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>
<!--end::Content-->
