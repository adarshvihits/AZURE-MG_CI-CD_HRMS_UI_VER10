
@model Hrms.Lite.Shared.DataBank.DTO.OnBoarding
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>

<script src="~/scripts/Recruitment/offerProcessing.js"></script>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <!--begin::Header Menu-->
                <h3 class="main-title">
                    Offer Initiation</h3>
                    <!--end::Header Menu-->
                    <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot p-0 mt-1 font-size-sm">
                        <li class="breadcrumb-item ">
                            <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                                <i class="icon-nm fas fa-home mt-1"></i>
                            </a>
                        </li>

                        <li class="breadcrumb-item text-muted">
                            Offer Initiation List
                        </li>
                    </ul>
</div>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    @*<div class="mobile-tab-section">
            <div class="row mb-2">
                <div class="col-6">
                    <div class="form-group">
                        <label>Select Type</label>

                        @Html.DropDownListFor(m => m.TabCode, (SelectList)ViewBag.Tabs, new { @class = "form-control form-control-sm", @onchange = "Tab($('#TabCode').val(),$('#TabCode option:selected').text())" })
                    </div>
                </div>
            </div>
        </div>*@


                    <!--begin: Search Form-->
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">

                            <div class="tab-items low">
                                <span href="resignation.html" class="btn-title active tab1" onclick="tabClick('tab1', 'ALL', 'All')">
                                    All
                                    <span class="btn-notification tab1Count">@Model.ALLOfferCount</span>
                                </span>
                            </div>
                            <div class="tab-items medium">
                                <span href="resignation-accept.html" class="btn-title tab2" onclick="tabClick('tab2', 'Offer_Initiation_Pending', 'Offer Initiation pending')">
                                   Initiation pending
                                    <span class="btn-notification tab2Count">@Model.OfferInitiationPendingCount</span>
                                </span>
                            </div>
                            <div class="tab-items high">
                                <span href="resignation-checklist-pending.html" class="btn-title tab3" onclick="tabClick('tab3', 'Offer_Acceptance_Pending', 'Offer Acceptance pending')">
                                  Acceptance pending
                                    <span class="btn-notification tab3Count">@Model.OfferAcceptancePendingCount</span>
                                </span>
                            </div>

                            <div class="tab-items low">
                                <span href="resignation-reliving-pending-list.html" class="btn-title tab4" onclick="tabClick('tab4', 'Offer_Accepted', 'Offer Accepted')">
                                  Accepted
                                    <span class="btn-notification tab4Count">@Model.Offer_AcceptedCount</span>
                                </span>
                            </div>

                            <div class="tab-items medium">
                                <span href="resignation-retirement-due-list.html" class="btn-title tab5" onclick="tabClick('tab5', 'Offer_Rejected', 'Offer Rejected')">
                                  Rejected
                                    <span class="btn-notification tab4Count">@Model.OfferRejectedCount</span>
                                </span>
                            </div>

                            <div class="tab-items select-option">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                @*<div id="filterForm" class="filter-button slider-btn " data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>*@
                                <a data-bs-toggle="tooltip" title="" class="btn btn-excel" data-bs-original-title="Export to Excel" onclick="onExportToExcelClick()">
                                    <i class="icon-xl far fa-file-excel"onclick="ExportToExcelOfferInitiation()"></i>
                                </a>
                            </div>


                          

                        </div>
                    </div>
                   
                    <!-- Table Section -->
                    <div id="offerInitiationList">
                        @await Html.PartialAsync("_OfferInitiationList") 
                    </div>





                    <!--end: Datatable-->
                    <div id="filterSlider">
                        @*@await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)*@
                    </div>
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>

</div>
<!--end::Content-->
<!--end::Entry-->
