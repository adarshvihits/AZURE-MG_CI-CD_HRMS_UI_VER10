<script>




    function OnApproveClick(ReportName, PreEnrollCode, PreEnrollGI, mode, Tab) {
        debugger;
       
        swal.fire({
            text: "Do you want to Approve?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Ok'
        }).then((result) => {
            if (result.isConfirmed) {

                $.ajax({

                    type: 'POST',
                    url: '/Recruitment/OfferProcessing/GenerateReportPDF',
                    dataType: 'json',
                    data: { ReportName: ReportName, PreEnrollCode: PreEnrollCode, PreEnrollGI: PreEnrollGI, Mode: mode},
                    success: function (result) {

                        if (result.success == true) {
                            debugger
                            swal.fire(result.message).then(function () {
                               
                          

                                var url = "/Recruitment/OfferProcessing/OfferInitiation";
                                window.location.href = url;
                         
                            //window.top.close();
                            });

                        }

                        else {
                            debugger;
                            swal.fire(result.message).then(function () {
                                var url = "/Recruitment/OfferProcessing/GertOfferLetter?PreEnrollCode=" + PreEnrollCode + "&PreEnrollGI=" + PreEnrollGI;
                                //window.open(url, "_blank");
                                window.location.reload();
                                //var url = "/Recruitment/OfferProcessing/GetList?TabIndex=" + Tab;

                                //$('#OfferVerificationLst').load(url, {}, function () { });


                            });
                        }

                    },
                    error: function (xhr, textStatus, errorThrown) {
                        if ($($.parseHTML(xhr.responseText)).filter(".Login_Session").length > 0) {
                            window.location.reload();
                        }
                        else {
                            document.body.id = "kt_body";
                            $('body').html(xhr.responseText);
                        }
                    }
                });
            }
            else {
                return false;
            }
        })
    }


</script>


