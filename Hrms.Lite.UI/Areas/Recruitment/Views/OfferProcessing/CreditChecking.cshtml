@model Hrms.Lite.Shared.DataBank.DTO.OnBoarding
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>
<script src="~/scripts/Recruitment/offerProcessing.js"></script>

<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Credit Check
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class=""><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Credit Check

                    </li>

                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->


<div class="content d-flex flex-column flex-column-fluid" id="kt_content creditTest">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body">

                            <div class="row tab-style-button">
                                <div class="tab-button-wrap">

                                    <div class="tab-items high">
                                        <span class="btn-title tab1 active" onclick="CreditCheckTab('tab1',1,'Pending')">
                                            Pending List
                                            <span id="tb1" class="btn-notification">@Model.CreditCheckingCount</span>
                                        </span>
                                    </div>

                                    <div class="tab-items high">
                                        <span class="btn-title tab2" onclick="CreditCheckTab('tab2',2,'Tracker')">
                                            Tracker
                                            <span id="tb2" class="btn-notification">@Model.ALLOfferCount</span>
                                        </span>
                                    </div>


                                    <div class="tab-items select-option">

                                        <div class="sraech-slider">
                                            <div class="search-slider-inner">
                                                <i class="fa fa-search"></i>
                                            </div>
                                            <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                                   placeholder="ID/Name">
                                        </div>
                                        <button data-bs-toggle="tooltip" title="Export to Excel"
                                                class="btn btn-excel" onclick="ExportTopExcelClick()">
                                            <i class="icon-xl far fa-file-excel"></i>
                                        </button>

                                    </div>


                                </div>
                            </div>

                            <div id="creditSlider">

                            </div>

                           <div id="CredCheckList">
                               @await Html.PartialAsync("_CreditCheckingList")
                           </div>

                        </div>

                    </div>
                </div>
            </div>




            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>
<!--end::Content-->
