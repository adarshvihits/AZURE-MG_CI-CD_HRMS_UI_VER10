@model Hrms.Lite.Shared.DataBank.DTO.OnBoarding
    <script src="~/js/settings.js"></script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table salary-spitup-offerverification new-tble-pad-tp ">
    <table id="PendingList" class="common-table">
        @Html.HiddenFor(m => Model.OnBoardingList.Count)
        <thead>
            <tr class="table-dark">
                <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Applicant ID">Appli. ID</th>
                <th scope="col">Applicant Name</th>
                <th scope="col">MRF No</th>
                <th scope="col">Job Title</th>

                <th scope="col">Designation</th>
                <th scope="col">Location</th>
                <th scope="col">Deadline</th>
                <th scope="col">Doc Verified </th>
                <th scope="col" data-bs-toggle="tooltip" title="Resume Uploaded By Candidate">Resume</th>
                @if (Model.TabName != "Pending")
                {
                    <th scope="col">Paused Level </th>
                }
            </tr>
        </thead>

        <tbody>
            @if (Model.OnBoardingList != null && Model.OnBoardingList.Count > 0)
            {
                for (int i = 0; i < Model.OnBoardingList.Count; i++)
                {
            <tr>
                <td data-label="Applicant ID"> @Model.OnBoardingList[i].RefNo</td>
                <td data-label="Job Title">
                    @if (Model.TabName == "Pending")
                    {
                        <a href="@Url.Action("GetOfferVerificationDetails", "OfferProcessing", new { Area = "Recruitment", ResumeDataBankGI = Model.OnBoardingList[i].ResumeDataBankGI,ApplicantTrackingCode=Model.OnBoardingList[i].ApplicantTrackingCode})" class="slider-btn">
                            @Model.OnBoardingList[i].CandidateName
                        </a>
                    }
                    else
                        @Model.OnBoardingList[i].CandidateName
                </td>
                <td data-label="Candidate Name"> @Model.OnBoardingList[i].JobCode</td>
                <td data-label="MRF No"> @Model.OnBoardingList[i].JobTitle</td>

                <td data-label="Designation"> @Model.OnBoardingList[i].Designation.Name</td>
                <td data-label="Location"> @Model.OnBoardingList[i].Location.Name</td>
                <td data-label="Need By Date">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.OnBoardingList[i].NeedByDate))</td>
                <td data-label="Doc Verified">
                    @if (Model.OnBoardingList[i].DocVerified == "Y")
                    {

                        <button class="btn btn-icon btn-tick">
                            <i class="icon-xl fas fa-check"></i>
                        </button>

                    }
                    else
                    {
                        <button class="btn btn-icon btn-close">
                            <i class="icon-xl fas fa-times"></i>
                        </button>
                    }
                </td>
                <td data-label="View"><i class="icon-xl far fa-eye" data-bs-toggle="tooltip" title="Resume Uploaded By Candidate" onclick="showDocument('@Model.OnBoardingList[i].ResumeFileName','@Model.OnBoardingList[i].Resume')"></i></td>
                @if (Model.TabName != "Pending")
                {
                    <td data-label="Stage">
                        @Model.OnBoardingList[i].Stage
                    </td>
                }
            </tr>
                }
            }

        </tbody>
    </table>
</div>