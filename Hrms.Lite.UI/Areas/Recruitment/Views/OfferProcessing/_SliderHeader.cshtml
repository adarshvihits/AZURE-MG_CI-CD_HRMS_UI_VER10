@model Hrms.Lite.Shared.DataBank.DTO.PreEnrollment


<script src="~/js/jquery.min.js"></script>
<script>
   $(document).ready(function () {
       debugger
       
        $.ajax({

            type: 'GET',
            url: '/AccessFile/GetFileStorageType',

            success: function (data) {

                if (data == 'BLOB') ifAzure();
                else

                $('.emp_HeaderPic').css('background-image', "url('" + '@Model.BasicInfo.File.AbsoluteUri' + "')");

            },
            error: function (xhr, textStatus, errorThrown) {
                if ($($.parseHTML(xhr.responseText)).filter(".Login_Session").length > 0) {
                    window.location.reload();
                }
                else {
                    document.body.id = "kt_body";
                    $('body').html(xhr.responseText);
                }
            }
        });
        function ifAzure() {
            $.ajax({
                type: "POST",
                url: "/AccessFile/ViewAsBackGroundImage", // do not hard code your url's
                data: { filename: '@Model.BasicInfo.CandidatePhotoFileName' },
                success: function (data, jqXHR, response) {

                    if (jqXHR = "success") {
                        var mimeType = getMimeTypeFromFilename('@Model.BasicInfo.CandidatePhotoFileName');
                        debugger
                        $('.emp_HeaderPic').css('background-image', "url('" + mimeType + data + "')");


                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                }
            });
        }
   })

</script>
<style>
    .AVATAR {
        WIDTH: 100%;
        HEIGHT: 200PX;
        OBJECT-FIT: cover;
    }

        .AVATAR .avatar {
            WIDTH: 100%;
            HEIGHT: 100%;
            BACKGROUND-POSITION: center;
            BACKGROUND-SIZE: cover;
        }
</style>


<div class="row">
    <div class="col-md-2">
        <div class="image-input image-input-outline image-input-circle float-right emp_HeaderPic" id="kt_image_4" style="">
            <div class="image-input-wrapper">
            </div>
        </div>
    </div>
    <div class="col-md-10 pl-7">
        <div class="row">

            <div class="flex-grow-1">
                <!--begin::Title-->
                <div class="d-flex justify-content-between flex-wrap">
                    <div class="d-flex mr-3 header-profile-name">
                        <span class="whitecolor">
                            @Model.BasicInfo.FullName
                        </span>

                    </div>

                </div>

                <!--end::Title-->
                <!--begin::Content-->
                <div class="d-flex flex-wrap justify-content-between">
                    <div class="d-flex flex-column flex-grow-1 pr-8">
                        <div class="d-flex flex-wrap mb-1">
                            <span data-bs-toggle="tooltip" data-bs-original-title="Designation" class="header-profile-email mr-5 mb-lg-0 mb-2">
                                <i class="fas fa-briefcase icon-nm mr-2"></i>  @Model.JobDetails.Designation.Name
                            </span>
                            <span data-bs-toggle="tooltip" data-bs-original-title="Department" class="header-profile-email mr-5 mb-lg-0 mb-2">
                                <i class="fas fa-map-marker-alt icon-nm mr-2"></i>  @Model.JobDetails.Location.Name
                            </span>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>