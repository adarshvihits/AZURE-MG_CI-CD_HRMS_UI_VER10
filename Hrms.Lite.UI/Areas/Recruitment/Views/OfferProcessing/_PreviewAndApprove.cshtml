@model Hrms.Lite.Shared.DataBank.DTO.PreEnrollment


           

                <div class="popup-inner-style">
                    <div class="profile-header position-relative pb-12 mb-5 " style="padding-bottom: 2px !important; padding-top: 5px !important;">
                        <div class="row">

                          @await Html.PartialAsync("~/Areas/DataBank/Views/Shared/_EmployeePopupHeader.cshtml", Model.EmployeeHeader)
                            </div>
                        </div>
                        <div class="profile-header-overflow"></div>
                    </div>
                
                <div style="padding:10px;"
                     class="ihits-table table-border hover-color odd-even mobile-responsive-table  vertical-scroll-200">



                    <div id="GroupSummaryListDiv">
                        <table id="GroupsummaryTable">
                            <thead>
                                <tr class="table-light">
                                    <th scope="col">Salary Breakup</th>
                                    <th scope="col">Per Month</th>
                                    <th scope="col">Per Annum</th>


                                </tr>
                            </thead>
                            <tbody>
                                 @if (Model.Compensation.FixedAllowance != null && Model.Compensation.FixedAllowance.Count > 0)
                                {

                    for (int i = 0; i < Model.Compensation.FixedAllowance.Count; i++)
                    {


                        @if (Model.Compensation.FixedAllowance[i].AllowanceType == "GS" || Model.Compensation.FixedAllowance[i].AllowanceType == "NS" || Model.Compensation.FixedAllowance[i].AllowanceType == "CTC")
                        { 
                        <tr>
                            <td style="font-weight:bold" data-label="FixedAllowance">@Model.Compensation.FixedAllowance[i].Name</td>

                                <td style="font-weight:bold" data-label="FixedAllowance">
                                @Model.Compensation.FixedAllowance[i].Amount
                    </td>
                                <td style="font-weight:bold" data-label="PerAnnum">@Model.Compensation.FixedAllowance[i].PerAnnum</td>
                   
                </tr>
                }
                else @if (Model.Compensation.FixedAllowance[i].AllowanceType == "A")
                {
                            <tr >
                                <td style="color:green" data-label="FixedAllowance">@Model.Compensation.FixedAllowance[i].Name</td>

                                <td style="color:green" data-label="FixedAllowance">
                                    @Model.Compensation.FixedAllowance[i].Amount
                                </td>
                                <td style="color:green" data-label="PerAnnum">@Model.Compensation.FixedAllowance[i].PerAnnum</td>

                            </tr>
                }
                        else @if (Model.Compensation.FixedAllowance[i].AllowanceType == "D")
                        {
                            <tr>
                                <td style="color:red" data-label="FixedAllowance">@Model.Compensation.FixedAllowance[i].Name</td>

                                <td style="color:red" data-label="FixedAllowance">
                                    @Model.Compensation.FixedAllowance[i].Amount
                                </td>
                                <td style="color:red" data-label="PerAnnum">@Model.Compensation.FixedAllowance[i].PerAnnum</td>

                            </tr>
                        }
                        else 
                        {
                            <tr>
                                <td  data-label="FixedAllowance">@Model.Compensation.FixedAllowance[i].Name</td>

                                <td  data-label="FixedAllowance">
                                    @Model.Compensation.FixedAllowance[i].Amount
                                </td>
                                <td  data-label="PerAnnum">@Model.Compensation.FixedAllowance[i].PerAnnum</td>

                            </tr>
                        }
                
                           }
                              }



                            </tbody>


                        </table>

                    </div>

                </div>



               

                <div class="row pt-10 align-right">

                    <div class="col-md-12">

                      <button type="button" class="btn btn-default mobile-full-width" onclick="ApproveReject('@Model.PreEnrollGI', 'APPROVE')">
            Approve
        </button>


                    </div>

                </div>

                



      