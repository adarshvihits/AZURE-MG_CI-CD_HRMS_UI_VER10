@model Hrms.Lite.Shared.Recruitment.DocumentVerification


<script>
    $(document).ready(function () {
        if ($('#Breadcrumb').val() == "Employee Rejoin")
            onEditClick();

        $.ajax({

            type: 'GET',
            url: '/AccessFile/GetFileStorageType',

            success: function (data) {

                if (data == 'BLOB') ifAzure();
                else

                $('.emp_HeaderPic').css('background-image', "url('" + '@Model.File.AbsoluteUri' + "')");

            },
            error: function (xhr, textStatus, errorThrown) {
                if ($($.parseHTML(xhr.responseText)).filter(".Login_Session").length > 0) {
                    window.location.reload();
                }
                else {
                    document.body.id = "kt_body";
                    $('body').html(xhr.responseText);
                }
            }
        });
        function ifAzure() {
            $.ajax({
                type: "POST",
                url: "/AccessFile/ViewAsBackGroundImage", // do not hard code your url's
                data: { filename: '@Model.File.FileName' },
                success: function (data, jqXHR, response) {

                    if (jqXHR = "success") {
                        var mimeType = getMimeTypeFromFilename('@Model.File.FileName');
                        debugger
                        $('.emp_HeaderPic').css('background-image', "url('" + mimeType + data + "')");


                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                }
            });
        }

    });

</script>


<script src="~/js/custom.js"></script>

<div class="row">

    <div class="col-md-12 ">
        <div class="d-flex">
            <div class="d-flex align-items-center">
                <div class="image-input image-input-outline image-input-circle  mr-5" id="kt_image_4"
                     style="background-image: url('@Model.CandidatePhoto')">
                    <div class="image-input-wrapper emp_HeaderPic">
                    </div>
                </div>
            </div>
            <div class="flex-grow-1">
                <!--begin::Title-->
                <div class="d-flex justify-content-between flex-wrap mt-2">
                    <div class="d-flex mr-3 header-profile-name">
                        <a class="header-profile-name">@Model.CandidateName</a>
                        @*<span> ( @Model.EmployeeId )</span>*@

                    </div>

                </div>

                <!--end::Title-->
                <!--begin::Content-->
                <div class="d-flex flex-wrap justify-content-between">
                    <div class="">
                        <div class="d-flex flex-wrap mb-1">
                            <a data-bs-toggle="tooltip" data-bs-original-title="Designation" class="header-profile-email mr-4 mb-lg-0 mb-2">
                                <i class="fas fa-briefcase icon-nm mr-2"></i>@Model.Designation.Name
                            </a>

                            <a data-bs-toggle="tooltip" data-bs-original-title="Location" class="header-profile-email mr-4 mb-lg-0 mb-2">
                                <i class="fas fa-map-marker-alt icon-nm mr-2"></i>@Model.Location.Name
                            </a>


                        </div>



                    </div>



                </div>

                <!--end::Content-->
            </div>

        </div>







    </div>
</div>