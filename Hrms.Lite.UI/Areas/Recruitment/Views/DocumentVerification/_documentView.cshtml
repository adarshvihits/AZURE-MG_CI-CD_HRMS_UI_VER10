@model Hrms.Lite.Shared.Recruitment.DocumentVerification
<script src="~/js/bootstrap-datepicker.js"></script>
<script src="~/js/tooltip.js"></script>
<script>
    $(document).ready(function () {
        debugger;
        //$('#Name').focus();
        if ('@Model.SliderTitle' != "Pan Card")
            moveCursorToEnd('NameInAadhar');
        else
            moveCursorToEnd('NameInPAN');
    });
</script>
<style>
    .slider-forms.slider-forms-opens {
        right: 0px;
        transition: 0.4s;
    }

 /*   #AadharFileView {
        width:850px;
        z-index:1000;
    }*/
</style>
@using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "AadharOrPanApprove", enctype = "multipart/form-data" }))
{
    <div id="AadharFileView" class="slider-forms slider-forms-opens viewAadharOrPan">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="ClosedocVerifnSlider('viewAadharOrPan')"><i class="ki ki-close icon-xs text-muted"></i></div>
            <h4>@Model.SliderTitle</h4>
            @Html.HiddenFor(m => m.EmployeeGI)
            @Html.HiddenFor(m => m.SliderTitle)
            @Html.HiddenFor(m => m.DocType)
            @Html.HiddenFor(m => m.ApplicantTrackingCode)

            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label>Name in Document</label>
                        @*<input type="text" class="form-control form-control-sm" placeholder="Name in Document">*@
                        @if (Model.SliderTitle == "Aadhaar")
                        {
                            @Html.TextBoxFor(m => m.NameInAadhar, new { @class = "form-control form-control-sm", @placeholder = "Name in Document", @maxlength = 120, @onblur = "validateById('#NameInAadhar', 'NameValidation')" })

                        }
                        @if (Model.SliderTitle == "Pan Card")
                        {
                            @Html.TextBoxFor(m => m.NameInPAN, new { @class = "form-control form-control-sm", @placeholder = "Name in Document", @maxlength = 120, @onblur = "validateById('#NameInPAN', 'NameValidation')" })

                        }

                        @if (Model.SliderTitle == "Passport")
                        {
                            @Html.TextBoxFor(m => m.NameInPassport, new { @class = "form-control form-control-sm", @placeholder = "Name in Document", @maxlength = 120, @onblur = "validateById('#NameInPassport', 'NameValidation')" })

                        }
                        @if (Model.SliderTitle == "Driving License")
                        {
                            @Html.TextBoxFor(m => m.NameInDrivingLicense, new { @class = "form-control form-control-sm", @placeholder = "Name in Document", @maxlength = 120, @onblur = "validateById('#NameInDrivingLicense', 'NameValidation')" })
                        }


                        <span id="NameValidation"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label>Number</label>
                        @*<input type="text" class="form-control form-control-sm" placeholder="Number">*@
                        @if (Model.SliderTitle == "Aadhaar")
                        {
                            @Html.TextBoxFor(m => m.AadharNumber, new { @class = "form-control form-control-sm", @placeholder = "Number", @onblur = "validateAadhar(this,'aadhar')", @onkeypress = "return onlyNumberKey(event)", @maxlength = 12, @oninput = "RestrictCharacters(this)" })
                            <span id="aadhar"></span>
                        }
                        @if (Model.SliderTitle == "Pan Card")
                        {
                            @Html.TextBoxFor(m => m.PANNumber, new { @class = "form-control form-control-sm", @placeholder = "Number", @onblur = "validatePan(this,'pan')", @maxlength = 10, @oninput = "validatePan(this,'pan')" })
                            <span id="pan"></span>
                        }

                        @if (Model.SliderTitle == "Driving License")
                        {
                            @Html.TextBoxFor(m => m.DrivingLicenseNumber, new { @class = "form-control form-control-sm", @placeholder = "Number", @maxlength = 20, @onblur = "validateById('#DrivingLicenseNumber', 'DocNumber')" })
                        }
                        @if (Model.SliderTitle == "Passport")
                        {
                            @Html.TextBoxFor(m => m.PassportNumber, new { @class = "form-control form-control-sm", @placeholder = "Number", @maxlength = 20, @onblur = "validateById('#PassportNumber', 'DocNumber')" })
                        }

                    </div>
                </div>
            </div>
            @if ((Model.SliderTitle == "Aadhaar") || (Model.SliderTitle == "Pan Card"))
            {
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Date Of Issue</label>
                            <div class="input-group date">
                                @*<input type="text" class="form-control" id="kt_datepicker_2" readonly="readonly"
                            placeholder="Date Of Issue">*@
                                @if (Model.SliderTitle != "Pan Card")
                                {
                                    @Html.TextBoxFor(m => m.AadharIssueDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_8", @readonly = "true", @placeholder = "Date Of Issue", @onchange = "validateById('#AadharIssueDate', 'IssueDateValidation')" })
                                }
                                else
                                {
                                    @Html.TextBoxFor(m => m.PANIssueDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_8", @readonly = "true", @placeholder = "Date Of Issue", @onchange = "validateById('#PANIssueDate', 'IssueDateValidation')" })
                                }
                                <div class="input-group-append">
                                    <span class="input-group-text">
                                        <i class="la la-calendar"></i>
                                    </span>
                                </div>
                            </div>
                            <span id="IssueDateValidation"></span>
                        </div>
                    </div>

                </div>
            }
            @if ((Model.SliderTitle == "Passport") || (Model.SliderTitle == "Driving License"))
            {
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Valid From</label>
                            <div class="input-group date">
                                @*<input type="text" class="form-control" id="kt_datepicker_2" readonly="readonly"
                            placeholder="Valid From">*@
                                @if (Model.SliderTitle == "Driving License")
                                {
                                    @Html.TextBoxFor(m => m.DrivingLicenseValidFrom, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_8", @readonly = "true", @placeholder = "Valid From", @onchange = "validateFromDate(this,'FromDate','DrivingLicenseValidTo')" })
                                }
                                @if (Model.SliderTitle == "Passport")
                                {
                                    @Html.TextBoxFor(m => m.PassportValidFrom, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_8", @readonly = "true", @placeholder = "Valid From", @onchange = "validateFromDate(this,'FromDate','PassportValidTo')" })
                                }
                                <div class="input-group-append">
                                    <span class="input-group-text">
                                        <i class="la la-calendar"></i>
                                    </span>
                                </div>
                            </div>
                            <span id="FromDate"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Valid To</label>
                            <div class="input-group date">
                                @*<input type="text" class="form-control" id="kt_datepicker_2" readonly="readonly"
                            placeholder="Valid To">*@
                                @if (Model.SliderTitle == "Driving License")
                                {
                                    @Html.TextBoxFor(m => m.DrivingLicenseValidTo, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "Valid To", @onchange = "validateToDate(this,'ToDate','DrivingLicenseValidFrom')" })
                                }
                                @if (Model.SliderTitle == "Passport")
                                {
                                    @Html.TextBoxFor(m => m.PassportValidTo, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2", @readonly = "true", @placeholder = "Valid To", @onchange = "validateToDate(this,'ToDate','PassportValidFrom')" })
                                }
                                <div class="input-group-append">
                                    <span class="input-group-text">
                                        <i class="la la-calendar"></i>
                                    </span>
                                </div>
                            </div>
                            <span id="ToDate"></span>
                        </div>
                    </div>

                </div>
            }


        <div class="row">
            <div class="col-md-12">

                @if (Model.DocType == "Aadhaar")
                {
                    <img width="350" height="200" src=@Model.AadharUrl>

                }

                @if (Model.DocType == "Pan")
                {
                    <img width="350" height="200" src=@Model.PANUrl>

                }

                @if (Model.DocType == "Driving License")
                {
                    <img width="350" height="200" src=@Model.DLUrl>

                }

                @if (Model.DocType == "Passport")
                {
                    <img width="350" height="200" src=@Model.PassportUrl>

                }


            </div>

        </div>

            <div class="row card-footer-bottom-fixed border-none">

                <div class="col-md-12 float-right-btn">


                    <button type="button" class="btn btn-default " onclick="approveDocument()">Verify</button>
                </div>
            </div>

        </div>
    </div>
}