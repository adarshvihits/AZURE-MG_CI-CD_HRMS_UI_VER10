@model Hrms.Lite.Shared.Recruitment.DocumentVerification
@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script src="~/js/jquery.min.js"></script>
<script src="~/scripts/Recruitment/documentVerification.js"></script>
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">

    <div class="container-fluid d-flex align-items-stretch justify-content-between">


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">

            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Document Verification</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a href="@Url.Action("Index", "DocumentVerification", new { Area = "Recruitment" })">Document Verification List</a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Document Verification
                    </li>
                </ul>
            </div>
        </div>


    </div>

</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                    <!--begin: Search Form-->

                    <div class="profile-header position-relative box-shadow-none mb-5">
                        @await Html.PartialAsync("~/Areas/Recruitment/Views/DocumentVerification/_Header.cshtml",Model)
                        @Html.HiddenFor(m => m.EmployeeGI)
                        @Html.HiddenFor(m => m.CandidateID)
                        @Html.HiddenFor(m => m.AadharUrl)
                        @Html.HiddenFor(m => m.PANUrl)
                        @Html.HiddenFor(m => m.DrivingLicenseUrl)
                        @Html.HiddenFor(m => m.PassportUrl)
                        <div class="profile-header-overflow"></div>
                    </div>


                    <div class="document-card-outer">
                        <div class="document-cards aadhar-card">
                            <div class="d-flex ">

                                <i class="fa fa-th-large document-icon" aria-hidden="true"></i>
                                @*<i class="fa fa-clipboard document-icon" aria-hidden="true"></i>*@
                                <h2 class="ahar-text">Aadhar </h2>
                            </div>
                            @*<div class="aadhar-card-top"><img src="/images/aadhar-card-header.jpg"></div>*@
                            <div class="aadhar-details-outer">

                                <div class="aadhar-details">
                                    <span class="aadhar-number">@Model.AadharNumber</span>
                                    <span class="aadhar-name">@Model.NameInAadhar</span>


                                </div>

                            </div>

                            <div class="d-flex justify-content-between new-doctype">
                                <span class="date">Issue Date: @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.AadharIssueDate))</span>
                                <div class="small-btn-group">

                                    @if (Model.AadharUrl != "")
                                    {
                                        <a data-bs-toggle="tooltip" title="" data-bs-original-title="View" type="button" class="btn btn-icon btn-view btn-big doc-view" onclick="viewFile('Aadhaar','@Model.AadharUrl')"><i class="icon-xl far fa-eye"></i></a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip"  title="" data-bs-original-title="View"  type="button" class="btn btn-icon btn-view btn-big doc-view" onclick="alert('Please upload image')"><i class="icon-xl far fa-eye"></i></a>
                                    }

                                    <a type="button" id="AadharFileEdit" class="btn btn-icon btn-edit slider-btn" data-bs-toggle="tooltip" data-bs-original-title="Edit" onclick="EditAadharOrPan('Aadhaar')">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>



                                </div>
                            </div>
                        </div>

                        <div class="document-cards pan-card-details">
                            <div class="d-flex ">

                                <i class="fa fa-th-large document-icon" aria-hidden="true"></i>
                                @*<i class="fa fa-clipboard document-icon" aria-hidden="true"></i>*@
                                <h2 class="ahar-text">PAN </h2>
                            </div>
                            <div class="aadhar-details pancard-pt">

                                <span class="pan-number">@Model.PANNumber</span>
                                <span class="pan-name">@Model.NameInPAN</span>

                            </div>
                            <div class="d-flex justify-content-between new-doctype">
                                <span class="date">Issue Date: @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.PANIssueDate))</span>
                                <div class="small-btn-group">
                                    
                                    @if (Model.PANUrl != "")
                                    {

                                        <a data-bs-toggle="tooltip" title="" data-bs-original-title="View" type="button" class="btn btn-icon btn-view btn-big doc-view" onclick="viewFile('Pan','@Model.PANUrl')"><i class="icon-xl far fa-eye"></i></a>
                                    }
                                    else
                                    {
                                        <a data-bs-toggle="tooltip" title="" data-bs-original-title="View" type="button" class="btn btn-icon btn-view btn-big doc-view" onclick="alert('Pleae upload image')"><i class="icon-xl far fa-eye"></i></a>
                                    }
                                    <a type="button" id="PanFileEdit" class="btn btn-icon btn-edit slider-btn" data-bs-toggle="tooltip" data-bs-original-title="Edit" onclick="EditAadharOrPan('Pan')">
                                        <i class="icon-xl fas fa-pencil-alt"></i>
                                    </a>



                                </div>
                            </div>
                        </div>





                        <div class="document-cards driving-license-details">
                            <div class="d-flex ">

                                <i class="fa fa-th-large document-icon" aria-hidden="true"></i>
                                @*<i class="fa fa-clipboard document-icon" aria-hidden="true"></i>*@
                                <h2 class="ahar-text">Driving License </h2>
                            </div>
                            <div class="pancard-pt">
                                <span class="license-number">@Model.DrivingLicenseNumber</span>
                                <span class="license-name">@Model.NameInDrivingLicense</span>

                            </div>
                            <div class="d-flex justify-content-between new-doctype">
                                <span class="date">Valid From: <br>@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.DrivingLicenseValidFrom))</span>
                                <span class="date">Valid To: <br>@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.DrivingLicenseValidTo))</span>
                            
                                    <div class="small-btn-group d-flex">

                                    
                                        <a data-bs-toggle="tooltip" title="" data-bs-original-title="View" type="button" class="btn btn-icon btn-view btn-big doc-view" onclick="viewFile('Driving License','@Model.DrivingLicenseUrl')"><i class="icon-xl far fa-eye"></i></a>
                                   
                                    <a type="button" id="DrivingLicenseFileEdit" class="btn btn-icon btn-edit slider-btn" data-bs-toggle="tooltip" data-bs-original-title="Edit" onclick="EditDrivingLicenseOrPassport('Driving License')">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>


                                   
                                </div>
                            </div>
                        </div>

                        <div class="document-cards passport-details">
                            <div class="d-flex ">

                                <i class="fa fa-th-large document-icon" aria-hidden="true"></i>
                                @*<i class="fa fa-clipboard document-icon" aria-hidden="true"></i>*@
                                <h2 class="ahar-text">Passport </h2>
                            </div>
                            <div class="pancard-pt">
                                <span class="passport-number">@Model.PassportNumber</span>
                                <span class="passport-name">@Model.NameInPassport</span>

                            </div>
                            <div class="d-flex justify-content-between new-doctype">
                                <span class="date">Valid From:<br> @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.PassportValidFrom))</span>
                                <span class="date">Valid To:<br>@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.PassportValidTo))</span>
                               
                                    <div class="small-btn-group d-flex">

                                   
                                        <a data-bs-toggle="tooltip" title="" data-bs-original-title="View" type="button" class="btn btn-icon btn-view btn-big doc-view" onclick="viewFile('Passport','@Model.PassportUrl')"><i class="icon-xl far fa-eye"></i></a>
                                   
                                    <a type="button" id="PassportFileEdit" class="btn btn-icon btn-edit slider-btn" data-bs-toggle="tooltip" data-bs-original-title="Edit" onclick="EditDrivingLicenseOrPassport('Passport')">
                                            <i class="icon-xl fas fa-pencil-alt"></i>
                                        </a>
                                    </div>

                               
                            </div>
                        </div>




                    </div>

                    @*<new section></new>*@




                    <div id="sliderDiv">

                    </div>                   
                    <!-- Table Section -->


                    <div class="pb-5 d-flex justify-content-between">
                        <div>
                            <h6>Other Documents</h6>
                        </div>

                    </div>
                    <div id="OtherDocsList">
                        @await Html.PartialAsync("_OtherDocumentsList")
                    </div>

                    <div class="row card-footer-bottom-fixed">
                        <div class="col-md-12">
                            <button id="addNewDocument" type="button"
                                    class="btn btn-default float-right mobile-full-width slider-btn mr-3" onclick="VerifyDoc('@Model.CandidateID',1)">
                                Verify
                            </button>
                            <button type="button" class="btn btn-danger float-right  mobile-full-width mr-4" onclick="VerifyDoc('@Model.CandidateID',2)">
                                Reject
                            </button>

                            @*<button id="addNewDocument" type="button"
                class="btn btn-default float-right mobile-full-width slider-btn" onclick="onAddNewClick('@Model.EmployeeGI')">
            Add New
        </button>*@
                            @*<div id="addDocument">

        </div>*@
                        </div>

                    </div>

                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
<div class="slider-over-flow"></div>
<!--end::Content-->
