@model Hrms.Lite.Shared.Recruitment.DocumentVerification
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/js/settings.js"></script>
<script src="~/scripts/Recruitment/documentVerification.js"></script>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->


        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Document Verification</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index","Home",new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Document Verification
                    </li>
                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                    <!--begin: Search Form-->

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap align-items-center">









                            <div class="tab-items select-option mb-2">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>



                                <button data-bs-toggle="tooltip" title="" class="btn btn-excel float-left"
                                        data-bs-original-title="Export to Excel" onclick="ExportToExcel()">
                                    <i class="icon-xl far fa-file-excel"></i>
                                </button>

                            </div>


                        </div>
                    </div>
                    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table  document-verification-report new-tble-pad-tp">
                        <table id="docVerification" class="common-table">
                            <thead>
                                <tr class="table-dark">
                                    <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Applicant ID">Appli. ID</th>
                                    <th scope="col">Applicant Name</th>
                                    <th scope="col">MRF No.</th>
                                    <th scope="col">Job Title</th>
                                    <th scope="col">Deadline</th>
                                    <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Days Left ">D.L.</th>
                                    <th scope="col">Location</th>

                                    <th scope="col">Age</th>
                                    <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Years Of Experience ">Y/E </th>
                                    <th scope="col">Aadhar </th>
                                    <th scope="col">PAN </th>
                                    <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Driving license ">DL. </th>
                                    <th scope="col">Other</th>
                                  



                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Document_List != null && Model.Document_List.Count > 0)
                                {

                                    for (int i = 0; i < Model.Document_List.Count; i++)
                                    {
                                <tr>
                                    <td data-label="Applicant ID">@Model.Document_List[i].RefNo</td>
                                    <td data-label="Applicant Name">

                                        <a href="@Url.Action("GetDocumentVerification","DocumentVerification",new 
                                            {VacancyManagementGI=Model.Document_List[i].VacancyManagementGI,
                                                CandidateId=Model.Document_List[i].CandidateID,TrackingCode=Model.Document_List[i].ApplicantTrackingCode, Area="Recruitment"})" id="vacancycancellation " class="">
                                            @Model.Document_List[i].CandidateName
                                        </a>

                                   
                                    </td>
                                    <td data-label="MRF Code">
                                        @Model.Document_List[i].JobCode @Html.HiddenFor(m => m.Document_List[i].VacancyManagementGI)
                                        @Html.HiddenFor(m => m.Document_List[i].CandidateID)
                                        @Html.HiddenFor(m => m.Document_List.Count)
                                    </td>
                                    <td data-label="Job Title">
                                       
                                        @Model.Document_List[i].JobTitle

                                    </td>
                                    <td data-label="Need By Date">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Document_List[i].NeedByDate))</td>
                                    <td data-label="Days Left">@Model.Document_List[i].DaysLeft </td>
                                    <td data-label="Required Location">@Model.Document_List[i].Location.Name</td>

                                    <td data-label="Age">@Model.Document_List[i].Age</td>
                                    <td data-label="Years Of Experience">@Model.Document_List[i].Experience</td>
                                    <td data-label="Aadhar">
                                        @if (Model.Document_List[i].Aadhar)
                                        {
                                            <a type="button" class="btn btn-icon btn-tick">
                                                <i class="icon-xl fas fa-check"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a type="button" class="btn btn-icon btn-close">
                                                <i class="icon-xl fas fa-times"></i>
                                            </a>
                                        }
                                    </td>
                                    <td data-label="PAN">
                                        @if (Model.Document_List[i].PAN)
                                        {
                                            <a type="button" class="btn btn-icon btn-tick">
                                                <i class="icon-xl fas fa-check"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a type="button" class="btn btn-icon btn-close">
                                                <i class="icon-xl fas fa-times"></i>

                                            </a>
                                        }
                                    </td>
                                    <td data-label="Driving license">
                                        @if (Model.Document_List[i].DrivingLicense)
                                        {
                                            <a type="button" class="btn btn-icon btn-tick">
                                                <i class="icon-xl fas fa-check"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a type="button" class="btn btn-icon btn-close">
                                                <i class="icon-xl fas fa-times"></i>
                                            </a>
                                        }
                                    </td>
                                    <td data-label="Other">
                                        @if (Model.Document_List[i].Others)
                                        {
                                            <a type="button" class="btn btn-icon btn-tick">
                                                <i class="icon-xl fas fa-check"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a type="button" class="btn btn-icon btn-close">
                                                <i class="icon-xl fas fa-times"></i>
                                            </a>
                                        }
                                    </td>



                                </tr>
                                    }
                                }


                            </tbody>
                        </table>
                    </div>



                    <!--end: Datatable-->

                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
<div class="slider-over-flow"></div>
<!--end::Content-->
