@model Hrms.Lite.Shared.DataBank.DTO.VacancyManagement
    <script src="~/js/settings.js"></script>

    <div class="ihits-table table-border odd-even mobile-responsive-table mrf-request-list pt-3">
        @Html.HiddenFor(m => m.VacancyManagement_List.Count)
        <table id="MRFReqTable" class="common-table">
            <thead>
                <tr class="table-dark">

                    <th scope="col">MRF No.</th>
                    <th scope="col">Job Title</th>
                    <th scope="col">Fun.Designation</th>
                    <th scope="col">Location</th>
                    <th scope="col">Deadline</th>
                    <th scope="col" data-bs-toggle="tooltip" title="Days Left">D.L.</th>
                    <th data-bs-toggle="tooltip" title="No of Requirements" scope="col">No.of Req</th>

                    <th scope="col" data-bs-toggle="tooltip" title="Mapped Resumes"> Resumes</th>
                    <th scope="col" data-bs-toggle="tooltip" title="Initiated By">Initiated By</th>


                    <th scope="col">Action</th>
                </tr>
            </thead>
            <tbody>

                @if (Model.VacancyManagement_List != null && Model.VacancyManagement_List.Count > 0)
                {

                    for (int i = 0; i < Model.VacancyManagement_List.Count; i++)
                    {
                        <tr>
                            <td data-label="Code">  @Model.VacancyManagement_List[i].JobCode</td>
                            <td data-label="Job Title">
                                @*@Model.VacancyManagement_List[i].JobTitle*@
                                <a class="" onclick="getApproveDetails('@Model.VacancyManagement_List[i].VacancyManagementGI')">
                                    @Model.VacancyManagement_List[i].JobTitle
                                </a>
                                <div id="viewMRFSlider">

                                </div>
                            </td>



                            <td data-label="Designation">  @Model.VacancyManagement_List[i].Designation</td>
                            <td data-label="Location">  @Model.VacancyManagement_List[i].Location</td>
                            <td data-label="Need by Date">  @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.VacancyManagement_List[i].NeedByDate))</td>
                            <td data-label="Days Left">  @Model.VacancyManagement_List[i].Aging</td>
                            <td data-label="No of Requirements">  @Model.VacancyManagement_List[i].NoOfRequirements</td>
                            <td data-label="Mapped Resumes">

                                <a data-bs-toggle="modal" data-target=".resumemodal"
                                   type="button" class="btn btn-sm float-left" onclick="onmappedResumeClick('@Model.VacancyManagement_List[i].VacancyManagementGI')">
                                    @Model.VacancyManagement_List[i].MappedResumes
                                </a>
                            </td>
                            <td data-label="Requested By">  @Model.VacancyManagement_List[i].RequestedBy</td>
                            <td data-label="Requested By">
                                <a data-bs-toggle="tooltip" title="Cancel" class="btn_reject" onclick="CancelMRF('@Model.VacancyManagement_List[i].VacancyManagementGI')"> </a>
                                @*<button type="button" onclick="CancelMRF('@Model.VacancyManagement_List[i].VacancyManagementGI')">Cancel</button>*@
                            </td>
                        </tr>

                    }
                }
            </tbody>
        </table>
    </div>

<div class="modal fade resumemodal" tabindex="-1"
     role="dialog" aria-labelledby="myLargeModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg" style="max-width:970px;">
        <div id="myDiv" class="modal-content popup">
            <div class="modal-header" style="padding:10px">
                <h5 class="modal-title" id="exampleModalLabel">
                    Mapped Resumes
                </h5>
                <button type="button" class="close"
                        data-bs-dismiss="modal" aria-label="Close">
                    <i aria-hidden="true"
                       class="ki ki-close"></i>
                </button>
            </div>

            <div class="modal-bodyyy">

            </div>



        </div>
    </div>
</div>