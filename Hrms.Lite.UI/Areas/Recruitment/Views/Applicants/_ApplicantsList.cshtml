@model Hrms.Lite.Shared.Recruitment.Applicants
<script>
    $(document).ready(function () {
        fillApplicantsList();
    });
</script>
<!-- rows are loaded page by page from GetApplicantsList (server-side paging) -->
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Applicants_list apl-list pt-3">
    <table id="ApplicantsTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">Applicant Code</th>
                <th scope="col">Application Date</th>
                <th scope="col" class="apl-col-name">Name</th>
                <th scope="col">DOB</th>
                <th scope="col">Gender</th>
                <th scope="col">Highest Qualification</th>
                <th scope="col">Experience</th>
                <th scope="col">Mobile</th>
                <th scope="col">Email</th>
                <th scope="col">Nationality</th>
                <th scope="col">Residence</th>
                <th scope="col">Languages Known</th>
                <th scope="col">Resume</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
        </tbody>
    </table>
</div>
