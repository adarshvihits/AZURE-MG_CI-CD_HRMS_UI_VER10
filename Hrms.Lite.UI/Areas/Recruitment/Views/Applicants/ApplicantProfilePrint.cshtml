@model Hrms.Lite.Shared.Recruitment.ApplicantProfile

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    <script>
       var link = @Json.Serialize(Model.Url);
    </script>
}
<script src="~/js/jquery.min.js"></script>
<link href="https://kendo.cdn.telerik.com/2022.3.913/styles/kendo.common.min.css" rel="stylesheet" />
<link href="https://kendo.cdn.telerik.com/2022.3.913/styles/kendo.uniform.min.css" rel="stylesheet" />

<style>
    body {
        margin: 5px;
        font-family: Verdana, Arial, sans-serif;
    }

    #ApplicantProfileReport {
        position: absolute;
        left: 52px;
        right: 52px;
        top: 50px;
        bottom: 5px;
        overflow: hidden;
        clear: both;
    }
</style>

<div id="kt_header" class="header header-fixed">
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Applicant Profile Print</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        <a href="@Url.Action("Index", "Applicants", new { Area = "Recruitment" })">
                            Applicants
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Applicant Profile PDF
                    </li>
                </ul>
            </div>
        </div>
        <div class="topbar">
        </div>
    </div>
</div>

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <div class="d-flex flex-column-fluid">
        <div class="container full-width">
            <div class="card card-custom height-100per">
                <div class="card-body">
                    <div>
                    </div>
                </div>
            </div>

            <div id="ApplicantProfileReport">
                loading...
            </div>
        </div>
    </div>
</div>

@section scripts
    {
    <script src="/api/reports/resources/js/telerikReportViewer"></script>

    <script type="text/javascript">
        $(document).ready(function () {
            $("#ApplicantProfileReport")
                .telerik_ReportViewer({

                    serviceUrl: "/api/reports/",

                    ready: function () {
                        $("[data-command*='telerik_ReportViewer_historyBack']").parent().hide();
                        $("[data-command*='telerik_ReportViewer_historyForward']").parent().hide();
                        $("[data-command*='telerik_ReportViewer_refresh']").parent().hide();
                        $("[data-command*='telerik_ReportViewer_stopRendering']").parent().hide();
                        $("[data-command*='telerik_ReportViewer_togglePrintPreview']").parent().hide();
                        $("[data-command*='telerik_ReportViewer_toggleSendEmailDialog']").parent().hide();
                        $("[data-command*='telerik_ReportViewer_toggleDocumentMap']").parent().hide();
                        $("[data-command*='telerik_ReportViewer_toggleParametersArea']").parent().hide();
                        $("[data-command*='telerik_ReportViewer_toggleZoomMode']").parent().hide();
                        $("[data-command*='telerik_ReportViewer_toggleSearchDialog']").parent().hide();
                    },

                    reportSource: {
                        report: "ApplicantProfile.trdp",
                        parameters: {
                            Url: link.urllink + "/api/ApplicantProfilePrint/GetApplicantProfilePrintJSON?ApplicantGI=" + '@Model.ApplicantGI'
                        }
                    },

                    viewMode: telerikReportViewer.ViewModes.PRINT_PREVIEW,
                    scaleMode: telerikReportViewer.ScaleModes.SPECIFIC,
                    pageMode: telerikReportViewer.PageModes.CONTINUOUS_SCROLL,
                    scale: 1.0,
                    enableAccessibility: false,
                    sendEmail: { enabled: true }
                });
        });
    </script>
}
