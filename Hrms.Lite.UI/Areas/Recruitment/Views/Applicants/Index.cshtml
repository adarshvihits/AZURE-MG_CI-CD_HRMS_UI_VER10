@model Hrms.Lite.Shared.Recruitment.Applicants
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/css/hrplan.css" rel="stylesheet" type="text/css" />
<link href="~/css/applicants.css" rel="stylesheet" type="text/css" />
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/Recruitment/applicants.js"></script>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Applicants</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Applicants
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <div class="card card-custom height-100per">
                <div class="card-body">

                    <div class="mobile-tab-section">
                        <div class="row mb-2">
                            <div class="col-12">
                                <div class="form-group">
                                    <label>Applicants</label>
                                    <select class="form-control form-control-sm" id="tabsDropdownApplicants" onchange="onApplicantsDropdownChange(this)">
                                        <option value="1">Active Applicants</option>
                                        <option value="2">Shortlisted Applicants</option>
                                        <option value="3">Applicants in Evaluation Process</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items">
                                <span class="btn-title ActiveApplicantsTab active" onclick="onApplicantsTabClick('ActiveApplicantsTab', 1)">
                                    Active Applicants
                                    <span class="btn-notification ActiveApplicantsCount">@Model.ActiveCount</span>
                                </span>
                            </div>
                            <div class="tab-items medium">
                                <span class="btn-title ShortlistedApplicantsTab" onclick="onApplicantsTabClick('ShortlistedApplicantsTab', 2)">
                                    Shortlisted Applicants
                                    <span class="btn-notification ShortlistedApplicantsCount">@Model.ShortlistedCount</span>
                                </span>
                            </div>
                            <div class="tab-items medium">
                                <span class="btn-title EvaluationApplicantsTab" onclick="onApplicantsTabClick('EvaluationApplicantsTab', 3)">
                                    Applicants in Evaluation Process
                                    <span class="btn-notification EvaluationApplicantsCount">@Model.EvaluationCount</span>
                                </span>
                            </div>

                            <div class="tab-items select-option apl-filter-bar">
                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="Search by name, code or mobile">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="ApplicantsList">
                        @await Html.PartialAsync("_ApplicantsList", Model)
                    </div>

                    <!-- Applicant quick view (filled from the clicked row) -->
                    <div id="ApplicantQuickViewSlider" class="slider-forms ApplicantQuickView apl-drawer">
                        <div class="slider-inner-style">
                            <div class="apl-drawer-head">
                                <h4>Applicant Quick View</h4>
                                <div class="apl-drawer-actions">
                                    <img data-bs-toggle="tooltip" data-bs-original-title="Export to PDF" title="Export to PDF"
                                         class="apl-pdf cursor-pointer" src="/images/newpdf.svg" onclick="exportApplicantProfilePdf()" />
                                    <button type="button" class="apl-drawer-close" onclick="closeApplicantQuickView()" title="Close">
                                        <i class="ki ki-close icon-xs"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="apl-drawer-body">
                                <div class="apl-profile">
                                    <div class="apl-profile-avatar" id="qvInitials"></div>
                                    <div>
                                        <div class="apl-profile-name" id="qvName"></div>
                                        <div class="apl-profile-sub"><span id="qvCode"></span> &nbsp;·&nbsp; Applied <span id="qvApplied"></span></div>
                                    </div>
                                </div>
                                <div class="apl-field-grid">
                                    <div><div class="apl-field-label">Date of Birth</div><div class="apl-field-value" id="qvDob"></div></div>
                                    <div><div class="apl-field-label">Gender</div><div class="apl-field-value" id="qvGender"></div></div>
                                    <div><div class="apl-field-label">Highest Qualification</div><div class="apl-field-value" id="qvQualification"></div></div>
                                    <div><div class="apl-field-label">Experience</div><div class="apl-field-value" id="qvExperience"></div></div>
                                    <div><div class="apl-field-label">Mobile</div><div class="apl-field-value" id="qvMobile"></div></div>
                                    <div><div class="apl-field-label">Email</div><div class="apl-field-value apl-break" id="qvEmail"></div></div>
                                    <div><div class="apl-field-label">Nationality</div><div class="apl-field-value" id="qvNationality"></div></div>
                                    <div><div class="apl-field-label">Residence</div><div class="apl-field-value" id="qvResidence"></div></div>
                                    <div class="apl-field-full"><div class="apl-field-label">Languages Known</div><div class="apl-field-value" id="qvLanguages"></div></div>
                                </div>
                            </div>
                            <div class="apl-drawer-foot">
                                <a class="btn apl-btn-cancel mr-2" onclick="closeApplicantQuickView()">Close</a>
                                <a class="btn btn-default apl-btn-profile" onclick="viewApplicantFullProfile()">
                                    View Full Profile <i class="fas fa-arrow-right ml-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>
<!--end::Content-->
