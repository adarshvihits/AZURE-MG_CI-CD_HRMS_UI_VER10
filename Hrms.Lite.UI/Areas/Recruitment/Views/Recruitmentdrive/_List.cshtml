@model Hrms.Lite.Shared.Recruitment.Recruitmentdrive
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<script src="~/js/settings.js"></script>
<script src="~/js/tooltip.js"></script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table Recruitmentdrive-list">
    @Html.HiddenFor(m => m.List.Count)
    <table id="RecruitmentdriveListTable" class="common-table dt-width-fix">
        <thead>
            <tr class="table-dark">
                <th scope="col">Name</th>
                <th scope="col">Location</th>
                <th scope="col">Venue</th>
                <th scope="col">From</th>
                <th scope="col">To</th>
                <th scope="col" class="text-right">Cost</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.List != null && Model.List.Count > 0)
            {
                for (int i = 0; i < Model.List.Count; i++)
                {
                   
                     @Html.HiddenFor(m => m.List[i].GI)
                            @Html.HiddenFor(m => m.List[i].LogGI)
                            @Html.HiddenFor(m => m.List[i].MakerChecker)
                            @Html.HiddenFor(m => m.List[i].EditActive)
                    
                    <tr>
                        
                        <td data-label="Name">
                           
                            @Model.List[i].Name
                        </td>
                        <td data-label="Location">@Model.List[i].LocationName</td>
                        <td data-label="Venue">@Model.List[i].Venue?.Name</td>
                        <td data-label="From">@Model.List[i].DateFrom?.ToString("dd-MMM-yyyy")</td>
                        <td data-label="To">@Model.List[i].DateTo?.ToString("dd-MMM-yyyy")</td>
                        <td data-label="Cost" class="text-right">@Model.List[i].Cost?.ToString("N2")</td>

                        <td data-label="Actions">
                            @if (CurrentUserRoleActions.Create == true)
                            {
                                <a data-bs-toggle="tooltip" title="Edit"
                                   id="" type="button"
                                   class="btn btn-icon btn-edit icon-only" onclick="onEditClick('@Model.List[i].GI','@Model.List[i].LogGI',@i)">
                                    <i class="icon-xl fas fa-pencil-alt"></i>
                                </a>
                            }
                            else
                            {
                                <a data-bs-toggle="tooltip" title="Edit"
                                   id="" type="button"
                                   class="btn btn-icon btn-edit icon-only" onclick="swal.fire(MasterPersmissionMsg).then(function () {
                                            onEditClick('@Model.List[i].GI', '@Model.List[i].LogGI',@i);
                                            });">
                                    <i class="icon-xl fas fa-pencil-alt"></i>
                                </a>
                            }

                            @if (CurrentUserRoleActions.Delete == true)
                            {
                                <a data-bs-toggle="tooltip" title="Delete"
                                   id="" type="button"
                                   class="btn btn-icon icon-only mobile-full-width btn-delete" onclick="onDeleteClick('@Model.List[i].GI','@Model.List[i].LogGI',@i)">
                                    <i class="icon-xl far fa-trash-alt"></i>
                                </a>
                            }
                            else
                            {
                                <a data-bs-toggle="tooltip" title="Delete"
                                   id="" type="button"
                                   class="btn btn-icon icon-only mobile-full-width btn-delete" onclick="swal.fire(MasterPersmissionMsg).then(function () { onDeleteClick('@Model.List[i].GI', '@Model.List[i].LogGI',@i);});">
                                    <i class="icon-xl far fa-trash-alt"></i>
                                </a>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>