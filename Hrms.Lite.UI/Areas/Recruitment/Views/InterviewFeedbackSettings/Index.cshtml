@model Hrms.Lite.Shared.Recruitment.InterviewFeedbackSettings
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{
    Hrms.Lite.Shared.Master.UserRole CurrentUserRoleActions = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Master.UserRole>(Context.Session.GetString("UserRoleActions"));
}
<link href="~/css/hrplan.css" rel="stylesheet" type="text/css" />
<link href="~/css/interviewFeedbackSettings.css" rel="stylesheet" type="text/css" />
<script src="~/js/jquery.min.js"></script>
<script src="~/js/datatables.min.js"></script>
<script src="~/scripts/Recruitment/interviewFeedbackSettings.js"></script>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Interview Feedback Settings</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Interview Feedback Settings
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <div class="card card-custom height-100per footer-row-fixed">
                <div class="card-body">

                   @*  <div class="ifs-caption">
                        Create feedback question sets for First Round and Second Round interviews, by grade.
                    </div> *@

                    <div class="mobile-tab-section">
                        <div class="row mb-2">
                            <div class="col-12">
                                <div class="form-group">
                                    <label>Round</label>
                                    <select class="form-control form-control-sm" id="tabsDropdownFeedbackRound" onchange="onRoundDropdownChange(this)">
                                        <option value="1">First Round</option>
                                        <option value="2">Second Round</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">
                            <div class="tab-items">
                                <span class="btn-title FirstRoundTab active" onclick="onRoundTabClick('FirstRoundTab', 1)">
                                    First Round
                                    <span class="btn-notification FirstRoundCount">@Model.FirstRoundCount</span>
                                </span>
                            </div>
                            <div class="tab-items medium">
                                <span class="btn-title SecondRoundTab" onclick="onRoundTabClick('SecondRoundTab', 2)">
                                    Second Round
                                    <span class="btn-notification SecondRoundCount">@Model.SecondRoundCount</span>
                                </span>
                            </div>

                            <div class="tab-items select-option ifs-filter-bar">
                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="Search question set name">
                                </div>
                                <select class="form-control form-control-sm ifs-grade-filter" id="GradeFilter" onchange="onGradeFilterChange()">
                                    <option value="0">Grade: All</option>
                                    @if (Model.GradeList != null)
                                    {
                                        foreach (var grade in Model.GradeList)
                                        {
                                            <option value="@grade.Code">@grade.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div id="InterviewFeedbackSettingsList">
                        @await Html.PartialAsync("_InterviewFeedbackSettingsList", Model)
                    </div>

                    <div id="feedbackSetSlider"></div>

                    <div class="row card-footer-bottom-fixed">
                        <div class="col-md-12 align-right">
                            @if (CurrentUserRoleActions.Create == true)
                            {
                                <a class="btn btn-default float-right mobile-full-width" onclick="onAddOrEditFeedbackSet('CREATE')">
                                    Create Question Set
                                </a>
                            }
                            else
                            {
                                <a class="btn btn-default float-right mobile-full-width" onclick="swal.fire(MasterPersmissionMsg);">
                                    Create Question Set
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>
<!--end::Content-->
