@model Hrms.Lite.Shared.DataBank.DTO.PreEnrollment

@using (Html.BeginForm(null, null, FormMethod.Post, new { @id = "_joinConfirm" }))
{

    <div id="creditcheckinglist" class="slider-forms slider-forms-open joinConfirm">
        <div class="slider-inner-style">
            <div class="slider-form-close" onclick="CloseSlider('joinConfirm')">
                <i class="ki ki-close icon-xs text-muted"></i>
            </div>

            <h4>
                Joining Confirmation
            </h4>

            <div class="profile-header position-relative pb-12 mb-5" style="padding-bottom: 2px !important; padding-top: 5px !important;">
                @await Html.PartialAsync("~/Areas/Recruitment/Views/OfferProcessing/_SliderHeader.cshtml")
                @Html.HiddenFor(m => m.PreEnrollGI)
                <div class="profile-header-overflow"></div>
            </div>
            <div class="row my-2">

                <div class="col-md-6">
                    <label class="view-title">
                        MRF No
                    </label>
                    <div class="view-details">
                        @Model.JobCode
                    </div>
                </div>
                <div class="col-md-6">
                    <label class="view-title">
                        Job Title
                    </label>
                    <div class="view-details">
                        @Model.JobTitle
                    </div>
                </div>


            </div>
            <div class="row my-2">
                <div class="col-md-6">
                    <label class="view-title">
                       Deadline
                    </label>
                    <div class="view-details">
                        @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.NeedByDate))
                    </div>
                </div>
                <div class="col-md-6">

                    <div class="form-group">
                        <label class="view-title">DOJ </label>
                        <div class="view-details">
                            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.BasicInfo.AcceptedDOJ))
                            </div>

                        </div>

                    </div>



                <div class="row my-2">
                    @*@if (Model.FormName == "CreditChecking")
                {
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Credit Score</label>
                            @Html.TextBoxFor(m => m.CreditChecking.CreditScore, new { @class = "form-control", @placeholder = "Credit Score" })
                        </div>
                    </div>
                }*@
                    @*<div class="col-md-6">
                    <div class="file-upload-form-group">
                        <label for="formFileMultiple" class="form-label">
                            File Upload
                        </label>

                        <div class="file-upload-form mb-1">
                            <div class="small-btn-group">
                                <button type="button" data-bs-toggle="tooltip" data-placement="top" data-bs-original-title="View Image" class="btn btn-icon btn-default"><i class="icon-xl far fa-eye"></i></button>
                            </div>
                            @Html.TextBoxFor(model => model.CreditChecking.Attachment.FileData, null, new { type = "file", @class = "input-file", @onchange = "CheckImageExtensionSize(this)" })
                        </div>
                        <label class="font-size-xs">
                            Only pdf, doc, docx files are
                            allowed , File size should be less than 1 MB.
                        </label>
                    </div>

                </div>*@




                    <div class="row card-footer-bottom-fixed border-none">
                        <div class="col-md-12 align-right">
                            <button type="button"
                                    class="btn btn-default  mobile-full-width" onclick="joinConfirm()">
                                Confirm
                            </button>
                        </div>


                    </div>
                </div>
            </div>
            <div class="row my-3">

                <div class="col-md-12">
                    <label>Remarks</label>
                    @Html.TextAreaFor(m => m.Description, new { @class = "form-control form-control-sm" })
                </div>
            </div>
        </div>
    </div>
}