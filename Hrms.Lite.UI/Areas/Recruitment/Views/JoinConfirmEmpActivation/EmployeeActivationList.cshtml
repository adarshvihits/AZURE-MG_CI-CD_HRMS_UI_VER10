@model Hrms.Lite.Shared.DataBank.DTO.OnBoarding
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<script src="~/scripts/Recruitment/joinConfirmEmpActivation.js"></script>

<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>
<script src="~/js/settings.js"></script>


<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <!--begin::Header Menu-->
                <h3 class="main-title"> Employee Account Activation</h3>
                <!--end::Header Menu-->
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot p-0 mt-1 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Employee Account Activation List
                    </li>
                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">

                    @*<div class="mobile-tab-section">
                            <div class="row mb-2">
                                <div class="col-6">
                                    <div class="form-group">
                                        <label>Select Type</label>

                                        @Html.DropDownListFor(m => m.TabCode, (SelectList)ViewBag.Tabs, new { @class = "form-control form-control-sm", @onchange = "Tab($('#TabCode').val(),$('#TabCode option:selected').text())" })
                                    </div>
                                </div>
                            </div>
                        </div>*@


                    <!--begin: Search Form-->
                    <div class="row tab-style-button">
                        <div class="tab-button-wrap">



                            <div class="tab-items select-option">

                                <div class="sraech-slider">
                                    <div class="search-slider-inner">
                                        <i class="fa fa-search"></i>
                                    </div>
                                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                           placeholder="ID/Name">
                                </div>
                                @*<div id="filterForm" class="filter-button slider-btn" data-bs-toggle="tooltip" title="Filter">
                                    <i class="fas fa-filter"></i>
                                    <i class="fas fa-check"></i>
                                </div>
                                <a class="btn btn-excel float-left" data-bs-toggle="tooltip" title="Export To Excel" onclick="onExportToExcelClick()">
                                    <i class="icon-xl far fa-file-excel"></i>

                                </a>*@


                            </div>


                        </div>
                    </div>
                    <!-- Table Section -->
                    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table joining-conirmation-newlist pt-5">
                        <table class="common-table">
                            <thead>
                                <tr class="table-dark">
                                    <th scope="col">Sl:No</th>
                                    <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Applicant ID">Appli. ID</th>
                                    <th scope="col">Candidate Name</th>
                                    <th scope="col">Designation</th>
                                    <th scope="col">Department</th>
                                    <th scope="col">Location</th>
                                    <th scope="col">Due days</th>
                                    <th scope="col" data-bs-toggle="tooltip" data-placement="right" title="Expected DOJ">E:DOJ</th>
                                    @*<th scope="col">Checklist</th>*@

                                </tr>
                            </thead>

                            <tbody>
                                @if (Model.OnBoardingList != null && Model.OnBoardingList.Count > 0)
                                {
                                    for (int i = 0; i < Model.OnBoardingList.Count; i++)
                                    {
                                        <tr>
                                            <td data-label="SL:NO">@(i + 1)</td>
                                            <td data-label="Applicant ID">@Model.OnBoardingList[i].RefNo</td>
                                            <td data-label="Candidate Name">
                                                @Html.ActionLink(@Model.OnBoardingList[i].CandidateName, "Create", "EnrollmentTest", new { EnrollGI = @Model.OnBoardingList[i].PreEnrollGI,Breadcrumb= "JoinConfirmEmpActivation", BreadcrumbName= "Employee Activation List", Area = "DataBank" }, null)
                                            </td>

                                            <td data-label="Designation"> @Model.OnBoardingList[i].Designation.Name</td>
                                            <td data-label="Department"> @Model.OnBoardingList[i].Department.Name</td>
                                            <td data-label="Location"> @Model.OnBoardingList[i].Location.Name</td>
                                            <td data-label="Due Days"> @Model.OnBoardingList[i].DueDays</td>
                                            <td data-label="E:DOJ"> @Html.Encode(String.Format("{0:dd-MMM-yyyy}", @Model.OnBoardingList[i].ExpectedDOJ))</td>
                                            @*<td data-label="Checklist" ></td>*@



                                        </tr>
                                    }
                                }

                            </tbody>
                        </table>
                    </div>





                    <!--end: Datatable-->
                    <div id="filterSlider">
                        @*@await Html.PartialAsync("~/Views/Shared/_Filter.cshtml", Model.Filter)*@
                    </div>
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>

</div>
<!--end::Content-->
<!--end::Entry-->
