@model Hrms.Lite.Shared.Recruitment.BackgroundVerification
<style>
    .vr_btn {
        border: 1px solid #c1b8b8;
        padding: 3px 23px;
        border-radius: 5px;
        margin-right: 20px;
    }
</style>
<div class="row my-2">
    <div class="col-md-12">
        <div class="">
            <h4>Experience Details</h4>
        </div>
        <div class="ihits-table table-border mobile-responsive-table my-4 experience_details_list">
            @Html.HiddenFor(m => m.ExperienceDetailsList.Count)
            <table id="AllowanceTable">
                <thead>
                    <tr class="table-gray">
                        <th scope="col">
                            Company Name
                        </th>
                        <th scope="col">
                            Location
                        </th>
                        <th scope="col">
                            Designation
                        </th>
                        <th scope="col">
                            From
                        </th>
                        <th scope="col">
                            To
                        </th>
                        <th scope="col">
                            Experience
                        </th>
                        <th scope="col">
                            Contact Person
                        </th>
                        <th scope="col">
                            File
                        </th>
                        @*<th scope="col">
                                Relieving Letter
                            </th>*@
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ExperienceDetailsList != null && Model.ExperienceDetailsList.Count > 0)
                    {
                        for (int i = 0; i < Model.ExperienceDetailsList.Count; i++)
                        {
                    <tr>
                        <td data-label="Document">@Model.ExperienceDetailsList[i].CompanyName</td>
                        <td data-label="">@Model.ExperienceDetailsList[i].Location</td>
                        <td data-label="Document">@Model.ExperienceDetailsList[i].Designation</td>                        
                        <td data-label="">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Convert.ToDateTime(Model.ExperienceDetailsList[i].From)))</td>
                        <td data-label="">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Convert.ToDateTime(Model.ExperienceDetailsList[i].To)))</td>
                        <td data-label="">@Model.ExperienceDetailsList[i].Experience</td>
                        <td data-label="">@Model.ExperienceDetailsList[i].ContactPerson</td>
                        <td data-label="">
                        <a data-bs-toggle="tooltip" title="" data-bs-original-title="View" type="button" class="btn btn-icon btn-view btn-big" onclick="showDocument('@Model.ExperienceDetailsList[i].FileName', '@Model.ExperienceDetailsList[i].AbsoluteURI')"><i class="icon-xl far fa-eye"></i></a>
                        </td>

                    </tr>

                        }
                    }

                </tbody>
            </table>
        </div>
        <div class="row my-2">
           

            <div class="col-md-4">
                <div class="form-group">
                    <label class="view-title">Previous Employer Details Remarks</label>
                    <div class="view-details">
                        @{
                            Model.Mode = "Experience";
                        }
                        @Html.HiddenFor(m => m.Mode)
                        @Html.HiddenFor(m => m.PreEnrollGI)
                        @Html.HiddenFor(m => m.PreEmployerDetailsStatus)
                        @Html.TextAreaFor(m => m.PreEmployerDetailsStatusReason, new { @class = "form-control form-control-sm",@onblur= "validate(this,'PreEmployerDetails')" })
                        <span id="PreEmployerDetails"></span>
                    </div>
                </div>
            </div>          

        </div>
        <div class="row">
            <div class="col-md-6">
                @if (Model.PreEmployerDetailsStatus == 1)
                {
                    <span class="verified_btn">Verified</span>
                }
                else if (Model.PreEmployerDetailsStatus == 2)
                {
                    <span class="reject_btn">Rejected</span>
                }
            </div>

            <div class="col-md-6 align-right d-flex justify-content-end">
                @if (Model.ExperienceDetailsList != null && Model.ExperienceDetailsList.Count > 0)
                {

                    <div class="d-flex align-items-center  vr_btn" onclick="onExperianceDetailsSave('Reject')">
                        <a data-bs-toggle="tooltip" data-bs-original-title="Reject" class="btn_reject mr-2"  cursorshover="true">
                        </a>  Reject
                    </div>
                    <div class="d-flex align-items-center  vr_btn" onclick="onExperianceDetailsSave('Verify')">
                        <a data-bs-toggle="tooltip" data-bs-original-title="Verify" class="btn_approve mr-2"  cursorshover="true">

                        </a>
                        Verify
                    </div>
                }

            </div>
        </div>
        </div>



</div>