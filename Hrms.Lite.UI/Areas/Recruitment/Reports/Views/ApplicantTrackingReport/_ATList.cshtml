                            }
                            else {
                                d.data[i].salary = '<button type="button" class="btn btn-icon btn-tick"><i class="icon-xl fas fa-check"></i></button>'

                            }
                            if (d.data[i].cc != true) {
                                d.data[i].cc = '<button type = "button" class="btn btn-icon btn-close"> <i class="icon-xl fas fa-times"></i> </button>'

                            }
                            else {
                                d.data[i].cc = '<button type="button" class="btn btn-icon btn-tick"><i class="icon-xl fas fa-check" ></i></button>'

                            }
