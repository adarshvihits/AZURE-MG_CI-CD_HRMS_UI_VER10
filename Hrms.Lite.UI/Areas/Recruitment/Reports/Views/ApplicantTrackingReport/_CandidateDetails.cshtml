@model Hrms.Lite.Shared.Recruitment.Reports.RecruitmentReports
<script>
    $(document).ready(function () {
        debugger
        $.ajax({

            type: 'GET',
            url: '/AccessFile/GetFileStorageType',

            success: function (data) {

                if (data == 'BLOB') ifAzure();
                else

                    $('.emp_HeaderPic').css('background-image', "url('" + '@Model.PhotoFilename' + "')");

            },
            error: function (xhr, textStatus, errorThrown) {
                if ($($.parseHTML(xhr.responseText)).filter(".Login_Session").length > 0) {
                    window.location.reload();
                }
                else {
                    document.body.id = "kt_body";
                    $('body').html(xhr.responseText);
                }
            }
        });
        function ifAzure() {
            $.ajax({
                type: "POST",
                url: "/AccessFile/ViewAsBackGroundImage", // do not hard code your url's
                data: { filename: '@Model.PhotoFilename' },
                success: function (data, jqXHR, response) {

                    if (jqXHR = "success") {
                        var mimeType = getMimeTypeFromFilename('@Model.PhotoFilename');
                        debugger
                        $('.emp_HeaderPic').css('background-image', "url('" + mimeType + data + "')");


                    }
                },
                error: function (xhr, textStatus, errorThrown) {
                }
            });
        }
    });


</script>
<div id="departmentedit" class="slider-forms slider-forms-open AddnewOrEditDiv">
    <div class="slider-inner-style new-inner-style">
        <div class="slider-form-close" onclick="CloseSlider('AddnewOrEditDiv')">
