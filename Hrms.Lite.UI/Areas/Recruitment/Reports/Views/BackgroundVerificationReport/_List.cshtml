@model Hrms.Lite.Shared.Recruitment.Reports.BackGroundVerificationReport

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table  background_verification_list">

    @Html.HiddenFor(m => m.BackGroundVerificationReport_List.Count)
    <table id="docVerification" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col" data-bs-toggle="tooltip" data-bs-original-title="Applicant ID">Appli. ID</th>
                <th scope="col">Applicant Name</th>
                <th scope="col">Employee ID</th>
                <th scope="col">MRF No.</th>
                <th scope="col">Job Title</th>
                <th scope="col">Location</th>
                <th scope="col">Entry User</th>
                <th scope="col">Address </th>
                <th scope="col">Education </th>
                <th scope="col">Document</th>
                <th scope="col">Experience</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.BackGroundVerificationReport_List != null && Model.BackGroundVerificationReport_List.Count > 0)
            {

                for (int i = 0; i < Model.BackGroundVerificationReport_List.Count; i++)
                {
                    <tr>
                        <td data-label="Applicant ID">@Model.BackGroundVerificationReport_List[i].RefNo</td>
                        <td data-label="Applicant Name">@Model.BackGroundVerificationReport_List[i].CandidateName</td>
                        <td data-label="Employee ID">@Model.BackGroundVerificationReport_List[i].EmployeeID</td>
                        <td data-label="MRF Code"> @Model.BackGroundVerificationReport_List[i].JobCode</td>
                        <td data-label="Job Title"> @Model.BackGroundVerificationReport_List[i].JobTitle</td>
                        <td data-label="Required Location">@Model.BackGroundVerificationReport_List[i].LocationName</td>
                        <td data-label="Agency">@Model.BackGroundVerificationReport_List[i].EntryUser</td>
                        <td data-label="Address">
                            @if (Model.BackGroundVerificationReport_List[i].AddressStatus == 1)
                            {
                                <a type="button" class="btn btn-icon btn-tick">
                                    <i class="icon-xl fas fa-check"></i>
                                </a>
                            }
                            else
                            {
                                <a type="button" class="btn btn-icon btn-close">
                                    <i class="icon-xl fas fa-times"></i>
                                </a>
                            }
                        </td>
                        <td data-label="PAN">
                            @if (Model.BackGroundVerificationReport_List[i].EducationStatus == 1)
                            {
                                <a type="button" class="btn btn-icon btn-tick">
                                    <i class="icon-xl fas fa-check"></i>
                                </a>
                            }
                            else
                            {
                                <a type="button" class="btn btn-icon btn-close">
                                    <i class="icon-xl fas fa-times"></i>
                                </a>
                            }
                        </td>
                        <td data-label="Driving license">
                            @if (Model.BackGroundVerificationReport_List[i].Employment_BackgroundStatus == 1)
                            {
                                <a type="button" class="btn btn-icon btn-tick">
                                    <i class="icon-xl fas fa-check"></i>
                                </a>
                            }
                            else
                            {
                                <a type="button" class="btn btn-icon btn-close">
                                    <i class="icon-xl fas fa-times"></i>
                                </a>
                            }
                        </td>
                        <td data-label="Other">
                            @if (Model.BackGroundVerificationReport_List[i].Relieving_LetterStatus == 1)
                            {
                                <a type="button" class="btn btn-icon btn-tick">
                                    <i class="icon-xl fas fa-check"></i>
                                </a>
                            }
                            else
                            {
                                <a type="button" class="btn btn-icon btn-close">
                                    <i class="icon-xl fas fa-times"></i>
                                </a>
                            }
                        </td>



                    </tr>
                }
            }


        </tbody>
    </table>
</div>
