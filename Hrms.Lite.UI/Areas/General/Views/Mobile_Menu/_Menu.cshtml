@model  Hrms.Lite.Shared.General.MenuApplicability
    <script>
     $(document).ready(function () {
         if ($('#moduleAllCheckBox').find('input[type="checkbox"]:checked').length == $('#moduleAllCheckBox').find('input[type="checkbox"]').length - 1) {
             $('#moduleAll').prop('checked', true);
         }

    });
    </script>


    <div id="module">
        <div class="ihits-table table-border user-role-module-list mb-0 vertical-scroll-300">
            <table id="moduleAllCheckBox">
                <thead>
                    <tr class="table-light">
                        <th scope="col">Menu</th>
                        <th scope="col">
                            <div class="checkbox-inline">
                                <label class="checkbox checkbox-outline checkbox-success">
                                    <input type="checkbox"
                                           name="Checkboxes15" id="moduleAll" onclick="onAllClick('moduleAll','moduleAllCheckBox')">
                                    <span></span>
                                </label>
                            </div>
                        </th>

                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.MenuList.Count > 0)
                    {

                        for (int i = 0; i < Model.MenuList.Count; i++)
                        {
                            @Html.HiddenFor(m => m.MenuList[i].MenuCode)
                            @Html.HiddenFor(m => m.MenuList[i].MenuName)
                            <tr>
                                <td data-label="Module">@Model.MenuList[i].MenuName</td>
                                <td data-label="">
                                    <div class="checkbox-inline">
                                        <label class="checkbox checkbox-outline checkbox-success">
                                            @*@Html.CheckBoxFor(m => m.MenuList[i].MenuApplicability, new { @onclick = "onChkBoxClick(this,'moduleAll','moduleAllCheckBox')" })*@
                                            @Html.CheckBoxFor(m => m.MenuList[i].MenuApplicability )

                                            <span></span>
                                        </label>
                                    </div>
                                </td>

                            </tr>
                        }
                    }
                </tbody>

            </table>
            <div>
            </div>
        </div>

    </div>


   