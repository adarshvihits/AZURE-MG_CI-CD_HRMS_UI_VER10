@model Hrms.Lite.Shared.General.ReportBuilder
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/scripts/General/databankreportbuilder.js"></script>


@using (Html.BeginForm("Save", "ReportBuilder", FormMethod.Post, new { @id = "dataBankReportBuilder" }))
{                                        
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Report Builder
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>
                    <!-- <li class="breadcrumb-item text-muted">
                        <a href="financial-year.html">Financial Year List</a>
                      </li> -->
                    <li class="breadcrumb-item text-muted">
                        Report Builder

                    </li>

                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->


<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body ">

                            <div class="row tab-style-button">
                                <div class="col-md-5">
                                    <div class="empstatus-new pr-2 pb-3">

                                    </div>

                                    <!-- Table Section -->

                                    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table report-builder-list vertical-scroll-450">
                                        <table id="databankLeft">

                                            <thead>
                                                <tr class="table-dark">
                                                    <th scope="col">Field Group</th>
                                                    <th scope="col">Field</th>
                                                    <th scope="col">Applicable</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model != null && Model.Details.Count > 0)
                                                {

                                                    for (int i = 0; i < Model.Details.Count; i++)
                                                    {

                                                        <tr>
                                                            <td data-label="Field Group">
                                                                @Html.HiddenFor(model => Model.Details[i].Code)
                                                                @Html.HiddenFor(model => Model.Details[i].Field)
                                                                @Html.HiddenFor(model => Model.Details[i].FieldGroup)
                                                                @Model.Details[i].FieldGroup
                                                            </td>
                                                            <td data-label="Field">@Model.Details[i].Field</td>
                                                            <td data-label="Field">
                                                                <div class="checkbox-inline">
                                                                    <label class="checkbox checkbox-outline checkbox-success">
                                                                        @Html.CheckBoxFor(m => m.Details[i].Applicability, new { @onclick = "onApplicabilityClick()" })
                                                                        @*, new { @onclick = "moduleChange(" + i + ")" }*@
                                                                        <span></span>
                                                                    </label>
                                                                </div>

                                                            </td>
                                                        </tr>

                                                    }
                                                }
                                            </tbody>
                                        </table>





                                    </div>
                                    <!-- Table Setion End -->
                                    <div class="row mt-5">
                                        <div class="col-md-12 align-right">


                                            <a data-bs-toggle="modal" data-target=".PF_settings_applicable"
                                               type="button" type="button"
                                               class="btn btn-default float-left mobile-full-width mr-3">
                                                View Saved Reports
                                            </a>
                                        </div>
                                        <div class="modal fade PF_settings_applicable" tabindex="-1"
                                             role="dialog" aria-labelledby="myLargeModalLabel"
                                             aria-hidden="true">
                                            <div class="modal-dialog" style="max-width:850px ;">
                                                <div class="modal-content popup "
                                                     style="height:400px ;">
                                                    <div class="modal-header" style="padding:10px">
                                                        <h5 class="modal-title" id="exampleModalLabel">
                                                            Saved Reports
                                                        </h5>
                                                        <button type="button" class="close"
                                                                data-bs-dismiss="modal" aria-label="Close">
                                                            <i aria-hidden="true"
                                                               class="ki ki-close"></i>
                                                        </button>
                                                    </div>
                                                    <div class="modal-body">

                                                    </div>
                                                    <!-- <end table></end> -->



                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                                <!-- <end col-6></end> -->
                                <div class="col-md-2 d-flex justify-content-center align-items-center">


                                </div>
                                <div class="col-md-5">
                                    <div class="d-flex">

                                        <!-- Table Section -->

                                        <div id="databank_combnGrid">
                                            @await Html.PartialAsync("_CombinationGrid")
                                        </div>


                                    </div>

                                    <!-- Table Setion End -->
                                    <div class="row mt-5">
                                        <div class="col-md-12 align-right">
                                            <button type="button"
                                                    class="btn btn-default btn-edit" onclick="Save()">
                                                Proceed
                                            </button>


                                            <!-- Edit Slider start-->
                                            <!-- Edit Slider  end-->
                                        </div>
                                    </div>

                                </div>
                               
                            </div>
                        </div>
                    </div>
                </div>

                <!--
                <end col-12></end> -->



            </div>




            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>
<!--end::Content-->
  }