@model Hrms.Lite.Shared.MIS.MISDashBoard
@using Kendo.Mvc.UI

<style>

    .profile-header-bis-new {
        width: 300px;
        height: 600px;
        position: relative;
        background-color: white;
        border-radius: 10px;
        box-shadow: rgba(99, 94, 102, 0.2) 0px -1px 15px 0px;
    }


    .k-map .k-i-marker-custom-marker {
        background-image: url('/images/icons/locationIN.png');
        background-size: 30px;
        width: 30px;
        height: 30px;
    }

    .k-map .k-i-marker-marker-out {
        background-image: url('/images/icons/locationOUT.png');
        background-size: 30px;
        width: 30px;
        height: 30px;
    }


    .top-head-pad {
        padding: 10px;
        padding-top: 56px;
    }

    .employee-profile-photo {
        background-color: white;
        width: 150px;
        height: 150px;
        display: flex;
        margin: 6px;
        border-radius: 91px;
        position: absolute;
        margin-left: 75px;
        top: -59px;
        box-shadow: rgba(99, 94, 102, 0.2) 0px -1px 15px 0px;
    }

    .profile-picker-emp {
        width: 100%;
        height: 100%;
        padding: 5px;
        border-radius: 50%;
    }




    .name-head {
        padding-top: 10px;
        color: #002F5D;
        padding-left: 19px;
        font-size: 26px;
        font-weight: 700;
    }




    .new-pad-data {
        padding-left: 10px;
    }


    .Personal-inf-text {
        font-size: 16px;
        font-weight: 600;
        margin-left: 10px;
        color: #01172D;
        padding-top: 10px;
    }

    .pad-2 {
        padding-top: 10px;
    }

    .data-align-center {
        padding-top: 100px;
        padding-left: 20px;
    }




    .k-tilelayout-item-header .k-card-title {
        font-size: 1.3rem;
        font-weight: bold;
    }

    .k-card-header {
        flex: 0 0 auto;
       
    }

    .k-card-body {
        overflow: hidden;
    }

    .k-tooltip {
        background-color: lightsteelblue;
    }

    .k-tilelayout-item:nth-child(2) {
        background: linear-gradient(to top, #9271d5 0%, var(--indigo) 100%);
        border-radius: 10px 10px 10px 10px;
        color: #fff !important;
        height: 150px;
    }

    .k-tilelayout-item:nth-child(3) {
        background: linear-gradient(to top, #217ff0 0%, #0956a9 100%);
        border-radius: 10px 10px 10px 10px;
        color: #fff !important;
        height: 150px;
    }







</style>
<script>

    $(document).ready(function () {

        const spr = setTimeout(hideSpinner, 1000)
    });


   
    var firstReset = true;
    function changeIcon(e) {
        var map = $("#map").getKendoMap();
        if (e.marker.dataItem.punchingStatus == 'In') {

            e.marker.options.shape = 'custom-marker';
        }
        else {
            e.marker.options.shape = 'marker-out';
        }

        if (firstReset) {

            firstReset = false;
            map.center([e.marker.dataItem.latitude, e.marker.dataItem.longitude]).zoom(13);
        }
    }

    function seriesOver(e)
    {
        console.log(e);
        if(e.dataItem.leaveDay!="")
        {
          
            e.sender.hideTooltip();
        }
    }

    function createToolTip(e) {
        var visual = e.createVisual();
       
        visual.options.tooltip = {
            content: e.dataItem.remark
        };

        return visual;
    }

</script>
