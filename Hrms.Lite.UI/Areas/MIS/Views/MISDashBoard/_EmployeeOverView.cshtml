<script id="attMonths" type="text/x-kendo-template">
    @(
                                    Html.Kendo().Chart<Hrms.Lite.Shared.MIS.AttendanceDayWise>()
                                                        .Name("monthAttEmpOv")
                                                        .Title("")
                                                            .Events(e => e.SeriesOver("seriesOver"))
                                                            
                                                        .Legend(legend => legend
                                                            .Position(ChartLegendPosition.Top)
                                                        )
                                                                                .DataSource(ds => ds.Read(read => read.Action("GetAttendanceEmpDayWise", "MISDashBoard").Data("getEmpOv")))
                                                        .Series(series =>
                                                        {
                                                            series.Line(model => model.hours).Name("Hours").CategoryField("day").Color("\\#F05A7E").Width(5)
                                                                    .NoteTextField("leaveDay")
                                           .Notes(notes => notes.Label(label => label.Position(ChartNoteLabelPosition.Outside)).Position(ChartNotePosition.Top).Visual("createToolTip"));


                                                        })
                                                            .ChartArea(chartArea => chartArea
                                                                               .Margin(margin => margin.Top(10).Right(5).Left(10).Bottom(200)))
                                                        .CategoryAxis(axis => axis
                                                            .Labels(labels => labels.Rotation(0))
                                                            .Crosshair(c => c.Visible(true))
                                                        )
                                                        .ValueAxis(axis => axis.Numeric()
                                                            .Labels(labels => labels.Format("{0:N0}"))
                                                        
                                                        )
                                                        .Tooltip(tooltip => tooltip
                                                            .Visible(true)
                                                            .Shared(true)

                                                            .Format("{0:N0}")
                                                        )

                                                        .ToClientTemplate()
                                )
</script>


<script id="hrTimeOffice" type="text/x-kendo-template">
    @(Html.Kendo().Chart<Hrms.Lite.Shared.MIS.AttendanceDayWise>()

                                                                           .Name("hrTOOv")

                                                                           .Title("")

                                                                            .HtmlAttributes(new { style = "width:100%;height:100%;" })
                                                                           .Legend(legend => legend
                                                                           .Position(ChartLegendPosition.Bottom)

                                                                           )
                                                                           .ChartArea(chartArea => chartArea
                                                                           .Margin(margin => margin.Top(10).Right(5).Left(10).Bottom(0)))
                                                                                                                   .DataSource(ds => ds.Read(read => read.Action("GetAttendanceEmpDayWise", "MISDashBoard").Data("getEmpOv")))
                                                                           .Series(series =>
                                                                           {
                                                                               series.Column(model => model.lateIn).Name("Late In").CategoryField("day")
                                                                               .Color("\\#FF9874").Spacing(0)
                                                                                .Tooltip(tooltip => tooltip.
                                                                                 Template("(Late In - \\#= (dataItem.lateIn)\\# )").Visible(true));

                                                                               series.Column(model => model.earlyOut).Name("Early Out").CategoryField("day")
                                                                               .Color("\\#7695FF").Spacing(0)
                                                                                .Tooltip(tooltip => tooltip.
                                                                                 Template("(Early Out  - \\#= (dataItem.earlyOut)\\# )").Visible(true));
                                                                           

                                                                           })
                                                                           .CategoryAxis(axis => axis
                                                                           .Labels(labels => labels.Rotation(0))
                                                                           .MajorGridLines(lines => lines.Visible(false))
                                                                           .Line(line => line.Visible(false))
                                                                           )
                                                                           .ValueAxis(axis => axis.Numeric()
                                                                           .Labels(labels => labels
                                                                           .Format("{0:N0}")
                                                                          
                                                                           )
                                                                          

                                                                           .Line(line => line.Visible(false))
                                                                           )
                                                                           .RenderAs(RenderingMode.Canvas)
                                                                           .Tooltip(tooltip => tooltip
                                                                           .Visible(true)

                                                                           .Format("{0:N0}")
                                                                           )
                                                                           .ToClientTemplate()
                                                                           )

</script>


<script id="empPunch" type="text/x-kendo-template">
    @(
                Html.Kendo().Chart<Hrms.Lite.Shared.MIS.EmployeeLateInEarlyOut>()
                .Name("punchOv")
                 .Title("")

             .Legend(legend => legend
             .Position(ChartLegendPosition.Right)
             .Orientation(ChartLegendOrientation.Vertical)
             .Visible(true)
                )
             .ChartArea(chart => chart
             .Background("transparent")


                                                                                      )
                                                                                      .DataSource(ds =>
                                                                                      {
                                                                                              ds.Read(read => read.Action("GetEmployeeLateInEarlyOut", "MISDashBoard").Data("getEmpOv"));

                                                                                      }
                                                                                      )

                                                                                      .Series(series => series

                                                                                      .Pie(model => model.hours, model => model.type)
                                                                                      .ColorField("color")

                                                                              .Labels(labels => labels.
                                                                                              Template("\\#= dataItem.type \\# - \\#= dataItem.hours \\#")
                                                                              .Position(ChartSeriesLabelsPosition.OutsideEnd)

                                                                              .Background("transparent")

                                                                              .Visible(true)
                                                                              )


                                                                      )
                                                                     .HtmlAttributes(new { style = "height:100%;width:100%;" })

                                                                             .Tooltip(tooltip => tooltip.Template("\\#= dataItem.type \\# - \\#= dataItem.hours \\#").Visible(true))

                                                                                  .ToClientTemplate()

                                                                              )



</script>


