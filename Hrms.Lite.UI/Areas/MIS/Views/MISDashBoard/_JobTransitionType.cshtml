@(Html.Kendo().TileLayout()
        .Name("tilelayout")
        .Columns(12)
        .RowsHeight("150px")
        .ColumnsWidth("250px")

        .Containers(c =>
        {
            
            c.Add().Header(h => h.Text("Job Transition Department Wise")).BodyTemplateId("transitiondepartment").ColSpan(4).RowSpan(2);
            c.Add().Header(h => h.Text("Job Transition Location Wise")).BodyTemplateId("transitionlocation").ColSpan(4).RowSpan(2);

            c.Add().Header(h => h.Text("Job Transition Division Wise")).BodyTemplateId("transitiondivision").ColSpan(4).RowSpan(2);
            c.Add().Header(h => h.Text("Job Transition Category Wise")).BodyTemplateId("transitioncategory").ColSpan(4).RowSpan(2);
            c.Add().Header(h => h.Text("Job Transition Grade Wise")).BodyTemplateId("transitiongrade").ColSpan(4).RowSpan(2);

            c.Add().Header(h => h.Text("Job Transition Region Wise")).BodyTemplateId("transitionregion").ColSpan(4).RowSpan(2);

            c.Add().Header(h => h.Text("Job Transition Month Wise")).BodyTemplateId("transitiontype").ColSpan(12).RowSpan(2);

        })
        .Reorderable(true)
        .Resizable(true)
        .Events(e => e.Resize("onTileResize"))
    )