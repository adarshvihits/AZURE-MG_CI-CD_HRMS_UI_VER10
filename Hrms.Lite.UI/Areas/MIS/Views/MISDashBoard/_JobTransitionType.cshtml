    function onPlotAreaOver(e) {
        $("#transitionType").css("cursor", "pointer");
    }
    function onPlotAreaClick(e) {
        var groupCom = $("#GroupCompanyCode").val();
        var financialYr = $("#finYear").val();
        var typeCode = $("#TransitionTypeCode").val();
        $.ajax({

            type: 'GET',
            url: '/MIS/MISDashBoard/ReloadDiv',
            dataType: 'html',
            data: { id: 45, type: 'Month', code: 0 },

            success: function (result) {
                window.location.href = '/MIS/MISDashBoard?id=45&groupCom=' + groupCom + '&financialYr=' + financialYr + '&typeCode=' + typeCode +'&type=Month&name=Job Transition&code=0';
            },
            error: function (xhr, textStatus, errorThrown) {
                debugger
                document.body.id = "kt_body";
                $('body').html(xhr.responseText);
            }
        });

    }

