<script id="transitiontype" type="text/x-kendo-template">
    @(
                    Html.Kendo().Chart<Hrms.Lite.Shared.MIS.TransitionTypeCount>()
                                            .Name("transitionType")
                                        .Title("")
                                                    .Events(e => e.DataBound("sortData").PlotAreaHover("onPlotAreaOver")
             .PlotAreaClick("onPlotAreaClick"))
                                        .Legend(legend => legend
                                            .Position(ChartLegendPosition.Bottom).Labels(x => x.Font("9px Arial,Helvetica,sans-serif"))
                                                  .Orientation(ChartLegendOrientation.Horizontal)
                                                  .Labels(x => x.Font("15px Arial,Helvetica,sans-serif"))
                                        )
                                                    .DataSource(ds => ds.Read(read => read.Action("GetTransitionTypeCount", "MISDashBoard").Data("getVal")))
                                        .Series(series =>
                                        {
                                            series.Line(model => model.count).Name("Transition Count").CategoryField("month").Color("\\#FF8F00").Width(5);


                                        })
                                        .ChartArea(ch => ch.Width(1750).Height(250))
                                        .CategoryAxis(axis => axis
                                            .Labels(labels => labels.Rotation(0))
                                            .Crosshair(c => c.Visible(true))
                                        )
                                        .ValueAxis(axis => axis.Numeric()
                                            .Labels(labels => labels.Format("{0:N0}"))

                                        )
                                        .Tooltip(tooltip => tooltip
                                            .Visible(true)
                                            .Shared(true)
                                            .Format("{0:N0}")
                                        )

                                        .ToClientTemplate()
                )
</script>

