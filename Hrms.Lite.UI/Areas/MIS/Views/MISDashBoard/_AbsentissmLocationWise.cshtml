@model Hrms.Lite.Shared.MIS.MISDashBoard
@using Kendo.Mvc.UI

@(Html.Kendo().Tooltip()
        .For("#graph")
        .Position(TooltipPosition.Top)
        .Content("Return To Graph")

        .Width(120)

    )

<div class="d-flex justify-content-end">

    <div style="width: 47px;height: 42px;background-color: #578BC6;display: flex;justify-content: center;align-items: center;border-radius: 6px;margin-bottom: 10px;/*! float: ; */">

        <a href="/MIS/MISDashBoard?id=6"> <span id="graph" class="k-icon k-font-icon k-i-chart-column-clustered" style="font-size: 23px;color: #ffff;"></span></a>
    </div>
</div>







<script>
    $(document).on("kendoReady", function () {
        $(".download").click(function () {
            var grid = $("#Grid").data("kendoGrid");
            var options = {
                format: $(this).data("format"),
                title: "DemoSheet"
            }
            $("#export-data").val(encodeURIComponent(JSON.stringify(options)));
            $("#export-model").val(encodeURIComponent(JSON.stringify(grid.columns)));
        });
    });
</script>

<style>
    .designation {
        display: block;
        font-weight: 600;
        font-size: 15px;
    }

    .description {
        display: block;
        padding-top: 12px;
    }

    .employeeID, .country {
        font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
        font-size: 50px;
        font-weight: bold;
        color: #898989;
        text-align: right;
    }


    .names {
        font-weight: bold !important;
        font-size: 1em !important;
    }

    td.photo, .employeeID {
        text-align: center;
    }



    .k-grid-pager {
        background-color: #dbeaee;
    }

    .k-grid td {
        /* background: linear-gradient(to bottom, rgba(0,0,0,0.05) 0%,rgba(0,0,0,0.15) 100%);*/
        padding: 20px;
        background-color: #cde3f0;
    }

    .k-grid .k-alt td {
        /* background: -moz-linear-gradient(top, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.1) 100%);
            background: -webkit-gradient(linear, left top, left bottom, color-stop(0%,rgba(0,0,0,0.2)), color-stop(100%,rgba(0,0,0,0.1)));
            background: -webkit-linear-gradient(top, rgba(0,0,0,0.2) 0%,rgba(0,0,0,0.1) 100%);
            background: -o-linear-gradient(top, rgba(0,0,0,0.2) 0%,rgba(0,0,0,0.1) 100%);
            background: -ms-linear-gradient(top, rgba(0,0,0,0.2) 0%,rgba(0,0,0,0.1) 100%);
            background: linear-gradient(to bottom, rgba(0,0,0,0.2) 0%,rgba(0,0,0,0.1) 100%);*/
        background-color: #c8cfef;
    }

    .k-grid tr {
        background-color: #616ead;
        color: #fff;
    }


    .photo img {
        width: 110px;
        height: 110px;
        display: flex;
        margin: auto;
        border-radius: 50%;
        BORDER: 4PX SOLID WHITE;
    }

    .namehead {
        padding-bottom: 10px;
        font-size: 13px;
        font-weight: 500;
    }

    .k-pager-numbers .k-link {
        background: none !important;
        border: 1px solid #EBEBFD !important;
        border-radius: 6px !important;
        color: #0d6efd !important;
        margin-left: 2px;
    }

    .k-grid-pager {
        background-color: #ffffff;
    }

    .k-pager-nav.k-link, .k-pager-refresh {
        border-radius: 6px !important;
    }
</style>



<div class="ihits-table table-border hover-color odd-even mobile-responsive-table employee-profile-list">






    @(
        Html.Kendo().Grid<Hrms.Lite.Shared.MIS.ABSEENTISM>()
        .Name("ActiveListtable")


        .Columns(columns =>
        {
            columns.Template(" ").Width(140).Title("Profile Picture" +
                "");
            columns.Bound(EmployeeProfile => EmployeeProfile.fullname).Width("290").Title("Name");
            columns.Bound(EmployeeProfile => EmployeeProfile.designation).Width(400).Title("Details Of Department");
            columns.Bound(EmployeeProfile => EmployeeProfile.dob).Title("DOB").Width("20");
            columns.Bound(EmployeeProfile => EmployeeProfile.doj).Title("DOJ").Width("20");
            //columns.Bound(EmployeeProfile => EmployeeProfile.requesteddate).Title("Grievence Date").Width("20");
            columns.Bound(EmployeeProfile => EmployeeProfile.gender).Title("Gender").Width("20");

            //columns.Bound(EmployeeProfile => EmployeeProfile.status).Title("Leave Details");

        })

        .Height(500)



        .ClientRowTemplate(
        "<tr data-uid='#: uid #'>" +
        "<td class='photo'>" +
        "<img src='" + Url.Content("#:data.absoluteuri#") + "' />" +
        "</td>" +

        "<td class='names'><div class='namehead'>#:data.fullname#</div>#:data.employeeid#</div></td>"
        +
        "<td class='details'>" +
       "<span class='designation'>#: data.designation #</span>" +
         "<span class='description'>Category : #: data.category# </span>" +
        "<span class='description'>Department  : #:  data.department# </span>" +
        "<span class='description'>Absent Date : #:  kendo.toString(kendo.parseDate(data.date), 'dd-MMM-yyyy')  #</span>" +
                "<span class='description'>Location : #:data.location#</span>" +


        "</td>" +
        "<td class='country'>" + "#:  kendo.toString(kendo.parseDate(data.dob), 'dd-MMM-yyyy')  #" +
        "</td>" +
        "<td class='country'>" +
        "#: kendo.toString(kendo.parseDate(data.doj), 'dd-MMM-yyyy') #" +
        "</td>" +

        "<td class='country'>" +
        "#: data.gender #" +
        "</td>" +


        "</tr>"
        )

        .ClientAltRowTemplate(
        "<tr class='k-alt' data-uid='#: uid #'>" +
        "<td class='photo'>" +
        "<img src='" + Url.Content("#:data.absoluteuri#") + "' />" +
        "</td>" +

        "<td class='names'><div class='namehead'>#:data.fullname#</div>#:data.employeeid#</div></td>"
        +
        "<td class='details'>" +
       "<span class='designation'>#: data.designation #</span>" +
         "<span class='description'>Category : #: data.category# </span>" +
        "<span class='description'>Department  : #:  data.department# </span>" +
        "<span class='description'>Absent Date : #:  kendo.toString(kendo.parseDate(data.date), 'dd-MMM-yyyy')  #</span>" +
           "<span class='description'>Location : #:data.location#</span>" +
        "</td>" +
        "<td class='country'>" + "#:  kendo.toString(kendo.parseDate(data.dob), 'dd-MMM-yyyy')  #" +
        "</td>" +
        "<td class='country'>" +
        "#: kendo.toString(kendo.parseDate(data.doj), 'dd-MMM-yyyy') #" +
        "</td>" +

        "<td class='country'>" +
        "#: data.gender #" +
        "</td>" +



        "</tr>"
        )

        .Scrollable().HtmlAttributes(new { style = "height:330px;" })
        .Pageable(pager => pager.Numeric(true).PreviousNext(true).Info(true).PageSizes(new[] { 10, 25 }).ButtonCount(5))
        .ToolBar(tools => tools.Excel())
        .Excel(excel => excel.AllPages(true)

        .FileName("Export.xlsx")

        .ProxyURL(Url.Action("Excel_Export_Save", "MISDashBoard"))
        )


        .HtmlAttributes(new { style = "height:430px;" })
        .DataSource(dataSource => dataSource
        .Ajax()
        .PageSize(10)
        .Read(read => read.Action("GetAbsLocationDetail", "MISDashBoard").Data("GetLocationdetaails"))

        )
        )




</div>






