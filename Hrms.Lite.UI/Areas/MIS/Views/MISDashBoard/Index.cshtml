<script>
    $(document).ready(function () {
        showSpinner();
        var queryString = window.location.search;

        // Parse the query string to extract parameters
        var params = new URLSearchParams(queryString);

        // Get the value of the "id" parameter
        var id = params.get("id");

        $(".export-pdf").click(function () {
            // Convert the DOM element to a drawing using kendo.drawing.drawDOM
            kendo.drawing.drawDOM($(".content-wrapper"))
                .then(function (group) {
                    // Render the result as a PDF file
                    return kendo.drawing.exportPDF(group, {
                        paperSize: "auto",
                        margin: { left: "1cm", top: "1cm", right: "1cm", bottom: "1cm" }
                    });
                })
                .done(function (data) {
                    // Save the PDF file
                    var dashName="HR-Dashboard.pdf"
                    if(id==1)
                    {
                        dashName = "New-Hires.pdf"
                    }
                    else if(id==2)
                    {
                        dashName = "Resignations.pdf"
                    } 
                    else if (id == 3) 
                    {
                        dashName = "Employee-Profile.pdf"
                    }
                    else if(id=="4")
                    {
                        dashName="Leave-Analysis.pdf"
                    }
                    else if (id == "5") 
                    {
                        dashName = "Salary-Analysis.pdf"
                    }
                    else if (id == "6") 
                    {
                        dashName = "Absenteeism.pdf"
                    }
                    else if (id == "7") 
                    {
                        dashName = "Historical-Trends.pdf"
                    }
                    else if (id == "8") 
                    {
                        dashName = "Recruitment-Analysis.pdf"
                    }
                      else if (id == "9") 
                    {
                        dashName = dashName;
                    }
                    else if (id == "10") {
                        dashName = "Work-Force-Time-Trends.pdf";
                    }
                     else if (id == "12") {
                        dashName = "Attendance-Over-View.pdf";
                    }
                     else if (id == "13") {
                        dashName = "Payroll-Over-View.pdf";
                    }
                     else if (id == "14") {
                        dashName = "Leave-Over-View.pdf";
                    }
                     else if (id == "15") {
                        dashName = "Punching-Over-View.pdf";
                    }
                    else if (id == "16") {
                        dashName = "Employee-Over-View.pdf";
                    }
                    kendo.saveAs({
                        dataURI: data,
                        fileName: dashName,
                        proxyURL: "@Url.Action("Pdf_Export_Save")"
                    });
                });
        });
    });
</script>
