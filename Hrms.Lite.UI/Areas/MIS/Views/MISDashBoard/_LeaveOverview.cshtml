@(Html.Kendo().TileLayout()
        .Name("tilelayout")
        .Columns(12)
        .RowsHeight("170px")
        .ColumnsWidth("250px")

        .Containers(c =>
        {
            c.Add().Header(h => h.Text("Leave Type")).BodyTemplateId("catagory").ColSpan(4).RowSpan(2);
            c.Add().Header(h => h.Text("Leave Days")).BodyTemplateId("leavebyWeek").ColSpan(4).RowSpan(2);
            c.Add().Header(h => h.Text("Leave Department Wise")).BodyTemplateId("leavebydepartmentOv").ColSpan(4).RowSpan(2);

            c.Add().Header(h => h.Text("Leave Location Wise")).BodyTemplateId("leavebylocationOv").ColSpan(4).RowSpan(2);
            c.Add().Header(h => h.Text("Leave Division Wise")).BodyTemplateId("leavebydivisionOv").ColSpan(4).RowSpan(2);
            c.Add().Header(h => h.Text("Leave Category Wise")).BodyTemplateId("leavebycategoryOv").ColSpan(4).RowSpan(2);
            c.Add().Header(h => h.Text("Leave Grade Wise")).BodyTemplateId("leavebygradeOv").ColSpan(6).RowSpan(2);
            c.Add().Header(h => h.Text("Leave Region Wise")).BodyTemplateId("leavebyregionOv").ColSpan(6).RowSpan(2);

        })
        .Reorderable(true)
        .Resizable(true)
        .Events(e => e.Resize("onTileResize"))
    )




