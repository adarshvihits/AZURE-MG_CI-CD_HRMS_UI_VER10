@model Hrms.Lite.Shared.MIS.MISDashBoard
@using Kendo.Mvc.UI

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">

<style>

    div.k-tooltip.k-chart-tooltip {
        margin-left: -50px;
        margin-top: -50px;
    }

    .k-tilelayout-item-header .k-card-title {
        font-size: 1rem;
    }

    .k-card-header {
        flex: 0 0 auto;
    }

    .k-card-body {
        overflow: hidden;
    }

    .arrow_up {
        font-size: 20px;
        color: #62c437;
        padding-right: 5px;
    }

    .down_arrow {
        font-size: 20px;
        color: red;
        padding-right: 5px;
        padding-top: 4px;
    }

    .common_new {
        background-color: #ffbb4d59;
        padding: 10px;
        width: 440px;
        border-radius: 10px;
    }

    .value_cls {
        color: #FF781B;
        font-size: 2rem;
        padding-right: 4px;
    }

    .new_emp {
        border-left: 2px solid red;
        margin: 12px;
        height: 35px;
        margin: 20px 5px;
        display: flex;
        align-items: center;
    }

    .downarrow {
        WIDTH: 20PX;
        transform: rotate(37deg);
    }

    .uparrow {
        WIDTH: 20PX;
        transform: rotate(37deg);
    }

    .uparrow {
        WIDTH: 20PX;
        transform: rotate(215deg);
    }

</style>

<script>
    $(document).ready(function () {

        const spr = setTimeout(hideSpinner, 1000)
    });
    function sortData(e) {

        var chart = $("#histJoinersMonth").data("kendoChart");

        var axis = e.sender.options.categoryAxis;

        var months = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday",
            "Sunday"];



        if (axis.categories != undefined) {
            axiscategories = axis.categories.sort((a, b) => months.indexOf(a) - months.indexOf(b));
        }
    }
    </script>


<div class="row">
    <div class="col-md-12">
        <script id="catagory" type="text/x-kendo-template">
            @(Html.Kendo().Chart<Hrms.Lite.Shared.MIS.CatagoryLeaveCountList>()
                                                                      .Name("leaveCatagoryOv")
                                                              .Title("")

                                                              .Legend(legend => legend

                                                              .Position(ChartLegendPosition.Bottom).Labels(x => x.Font("9px Arial,Helvetica,sans-serif"))
                                                  .Orientation(ChartLegendOrientation.Horizontal)
                                                  .Labels(x => x.Font("15px Arial,Helvetica,sans-serif"))

                                                              .Visible(true)
                                                              )
                                                              .ChartArea(chart => chart
                                                              .Background("transparent")


                                                              )
                                                              .DataSource(ds =>
                                                              {
                                                                      ds.Read(read => read.Action("GetLeaveType", "MISDashBoard").Data("getSalPeriod"));

                                                              }
                                                              )
                                                              .Series(series => series

                                                              .Donut(model => model.total, model => model.catagory).HoleSize(40).Size(40)

                                                              .Labels(labels => labels
                                                              .Template("\\#= dataItem.catagory \\# - \\#= dataItem.total \\#").Visible(true)
                                                              .Position(ChartSeriesLabelsPosition.OutsideEnd)

                                                              .Background("transparent")

                                                              .Visible(true)
                                                              )
                               .Tooltip(tooltip => tooltip.Template("\\#= dataItem.catagory \\# - \\#= dataItem.total \\# ").Visible(true))


                                                                  )//.SeriesColors("\\#166f99", "\\#2185b4")

                                                                   .HtmlAttributes(new { style = "height:100%;width:100%;" })


                                                                  .ToClientTemplate()
                                                              )



        </script>

        <script id="leavebyWeek" type="text/x-kendo-template">
            @(Html.Kendo().Chart<Hrms.Lite.Shared.MIS.GetLeaveDaysList>()

                                                                               .Name("leaveWeek")

                                                                           .Title("")
