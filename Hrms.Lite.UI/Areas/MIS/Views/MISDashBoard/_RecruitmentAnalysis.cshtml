<script id="vacTrend" type="text/x-kendo-template">
    @(
                        Html.Kendo().Chart<Hrms.Lite.Shared.MIS.VacancyTrend>()

                                                               .Name("vacancyTrend")

                                                               .Title("")
                                                                   .Events(e => e.DataBound("sortData").PlotAreaClick("VacancyDetailClick"))

                                                                   .HtmlAttributes(new { style = "width:100%;height:100%;" })
                                                               .Legend(legend => legend
                                                               .Position(ChartLegendPosition.Bottom).Labels(x => x.Font("9px Arial,Helvetica,sans-serif"))
                                                  .Orientation(ChartLegendOrientation.Horizontal)
                                                  .Labels(x => x.Font("15px Arial,Helvetica,sans-serif"))
                                                               )
                                                               .ChartArea(chartArea => chartArea
                                                               .Margin(margin => margin.Top(10).Right(5).Left(10).Bottom(0)))
                                                                                           .DataSource(ds => ds.Read(read => read.Action("GetRecruitmentVacancyTrend", "MISDashBoard").Data("getFY")))
                                                               .Series(series =>
                                                               {
                                                                   series.Column(model => model.total).Name("Vacancy").CategoryField("month").Color("\\#d72e2f"); ;

                                                               })
                                                           .CategoryAxis(axis => axis
                                                           //.Labels(labels => labels.Rotation(0))
                                                           .MajorGridLines(lines => lines.Visible(false))
                                                           .Line(line => line.Visible(false))
                                                           )
                                                           .ValueAxis(axis => axis.Numeric()
                                                           .Labels(labels => labels
                                                           .Format("{0:N0}")
                                                           //.Rotation(0)
                                                           )
                                                           .MajorUnit(50)

                                                           .Line(line => line.Visible(false))
                                                           )
                                                           .RenderAs(RenderingMode.Canvas)
                                                           .Tooltip(tooltip => tooltip
                                                           .Visible(true)
                                                           .Format("{0:N0}")
                                                           )
                                                           .ToClientTemplate()
                                                           )

</script>

<script id="vacDsg" type="text/x-kendo-template">
    @(
                        Html.Kendo().Chart<Hrms.Lite.Shared.MIS.TopVacancyDesignation>()

                                                               .Name("vacancyDsg")

                                                               .Title("")
       .Events(e => e.DataBound("sortData").PlotAreaClick("VacancyDesignationDetailClick"))
                                                                   .HtmlAttributes(new { style = "width:100%;height:100%;" })
                                                               .Legend(legend => legend
                                                               .Position(ChartLegendPosition.Bottom).Labels(x => x.Font("9px Arial,Helvetica,sans-serif"))
                                                  .Orientation(ChartLegendOrientation.Horizontal)
                                                  .Labels(x => x.Font("15px Arial,Helvetica,sans-serif"))
                                                               )
                                                               .ChartArea(chartArea => chartArea
                                                               .Margin(margin => margin.Top(10).Right(5).Left(10).Bottom(0)))
                                                                                           .DataSource(ds => ds.Read(read => read.Action("GetTopVacancyDesignation", "MISDashBoard").Data("getFY")))
                                                               .Series(series =>
                                                               {
                                                                   series.Column(model => model.total).Name("Designation").CategoryField("name").Color("\\#3a81c4"); ;

                                                               })
                                                           .CategoryAxis(axis => axis
                                                           //.Labels(labels => labels.Rotation(0))
                                                           .MajorGridLines(lines => lines.Visible(false))
                                                           .Line(line => line.Visible(false))
                                                           )
                                                           .ValueAxis(axis => axis.Numeric()
                                                           .Labels(labels => labels
                                                           .Format("{0:N0}")
                                                           //.Rotation(0)
                                                           )
                                                           .MajorUnit(100)

                                                           .Line(line => line.Visible(false))
                                                           )
                                                           .RenderAs(RenderingMode.Canvas)
                                                           .Tooltip(tooltip => tooltip
                                                           .Visible(true)
                                                           .Format("{0:N0}")
                                                           )
                                                           .ToClientTemplate()
                                                           )

</script>

@(Html.Kendo().TileLayout()
        .Name("tilelayout")
        .Columns(8)
         .RowsHeight("150px")
        .ColumnsWidth("250px")

        .Containers(c =>
        {
            c.Add().Header(h => h.Text("Vacancy")).BodyTemplateId("vacancy").ColSpan(2).RowSpan(1);
            c.Add().Header(h => h.Text("Interviews")).BodyTemplateId("interviewed").ColSpan(2).RowSpan(1);
            c.Add().Header(h => h.Text("Offered")).BodyTemplateId("offered").ColSpan(2).RowSpan(1);
            c.Add().Header(h => h.Text("Joined")).BodyTemplateId("joined").ColSpan(2).RowSpan(1);
            c.Add().Header(h => h.Text("Vacancy Created")).BodyTemplateId("vacTrend").ColSpan(4).RowSpan(3);
            c.Add().Header(h => h.Text("Vacancies Designation wise")).BodyTemplateId("vacDsg").ColSpan(4).RowSpan(3);


        })
        .Reorderable(true)
        .Resizable(true)
        .Events(e => e.Resize("onTileResize"))
    )