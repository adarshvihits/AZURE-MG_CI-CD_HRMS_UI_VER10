        const spr = setTimeout(hideSpinner, 1000)
    });
    function sortData(e) {

        var chart = $("#vacancyTrend").data("kendoChart");

        var axis = e.sender.options.categoryAxis;

        var months = ["January", "February", "March", "April", "May", "June",
            "July", "August", "September", "October", "November", "December"];



        if (axis.categories != undefined) {

          
            axiscategories = axis.categories.sort((a, b) => months.indexOf(a) - months.indexOf(b));
        }

       
    }
   </script>

<script id="vacancy" type="text/x-kendo-template">
    <div id="totVacancy" onclick="VacancyClick()"  style="color: \\#37B400; height:100%;display:flex; align-items:center;justify-content:center;font-size:2rem;">@Model.vacancy </div>
