<script>
    function VacancyDetailClick(e) {
        debugger;
        var GrpCompanyCode = $("#GroupCompanyCode").val();

        var FinancialYear = $("#finYear").val();

        var MONTH = e.category



        $.ajax({

            type: 'GET',
            url: '/MIS/MISDashBoard/ReloadDiv',
            dataType: 'html',
            data: { id: 120, FinancialYear: FinancialYear, GrpCompanyCode: GrpCompanyCode, MONTH: MONTH },

            success: function (result) {


                window.location.href = '/MIS/MISDashBoard?id=120&FinancialYear=' + FinancialYear + '&GrpCompanyCode=' + GrpCompanyCode + '&MONTH=' + MONTH;


            },
            error: function (xhr, textStatus, errorThrown) {
                debugger
                document.body.id = "kt_body";
                $('body').html(xhr.responseText);


            }
        });

    }

    function VacancyClick(e) {
        debugger;
        var GrpCompanyCode = $("#GroupCompanyCode").val();
        var FinancialYear = $("#finYear").val();

        $.ajax({
            type: 'GET',
            url: '/MIS/MISDashBoard/ReloadDiv',
            dataType: 'html',
            data: {
                id: 124,
                FinancialYear: FinancialYear,
                GrpCompanyCode: GrpCompanyCode,
                TYPE: 'VACANCY'
            },
            success: function (result) {

                var url = '/MIS/MISDashBoard?id=124&FinancialYear=' + encodeURIComponent(FinancialYear) + '&GrpCompanyCode=' + encodeURIComponent(GrpCompanyCode) + '&TYPE=VACANCY';
                window.location.href = url;
            },
            error: function (xhr, textStatus, errorThrown) {
                debugger;
