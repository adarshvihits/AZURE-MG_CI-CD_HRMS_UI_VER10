@(Html.Kendo().TileLayout()
        .Name("tilelayout")
        .Columns(12)
        .RowsHeight("150px")
        .ColumnsWidth("250px")

        .Containers(c =>
        {
            c.Add().Header(h => h.Text("Total")).BodyTemplateId("GrievanceByFinancialYear").ColSpan(4).RowSpan(4);
            c.Add().Header(h => h.Text("Completed")).BodyTemplateId("GrievanceCompletedByFinancialYear").ColSpan(4).RowSpan(2);
            c.Add().Header(h => h.Text("Accepted")).BodyTemplateId("GrievanceAcceptedByFinancialYear").ColSpan(4).RowSpan(2);
            c.Add().Header(h => h.Text("Non-Accepted")).BodyTemplateId("GrievanceNonAcceptedByFinancialYear").ColSpan(4).RowSpan(2);
            c.Add().Header(h => h.Text("Rejected")).BodyTemplateId("GrievanceRejectedByFinancialYear").ColSpan(4).RowSpan(2);

        })

        .Reorderable(true)
        .Resizable(true)
        .Events(e => e.Resize("onTileResize"))
    )