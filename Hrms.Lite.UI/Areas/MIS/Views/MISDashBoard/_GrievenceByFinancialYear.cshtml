<script id="GrievanceByFinancialYear" type="text/x-kendo-template">
    @(Html.Kendo().Chart<Hrms.Lite.Shared.MIS.MISGrievence>()

                                                               .Name("grvByFy")

                                                                      .Events(E => E.SeriesClick("onSeriesTotalClick")
                                                             .SeriesHover("onSeriesTotalOver"))

                                                           .Title("")

                                                               .HtmlAttributes(new { style = "width:100%;height:100%;" })
                                                           .Legend(legend => legend
                                                            .Position(ChartLegendPosition.Bottom).Labels(x => x.Font("9px Arial,Helvetica,sans-serif"))
                                                  .Orientation(ChartLegendOrientation.Horizontal)
                                                  .Labels(x => x.Font("15px Arial,Helvetica,sans-serif"))

                                                           )
                                                           .ChartArea(chartArea => chartArea
                                                           .Margin(margin => margin.Top(10).Right(5).Left(10).Bottom(0)))
                                                                               .DataSource(ds => ds.Read(read => read.Action("GetGrievance", "MISDashBoard").Data("getParams")))
                                                           .Series(series =>
                                                           {
                                                               series.Column(model => model.count).Name("Grievance Category").CategoryField("shortname").Color("\\#694F8E")
                                                                         .Tooltip(tooltip => tooltip.
                                                                                            Template("(\\#= (dataItem.name)\\# - \\#= (dataItem.count)\\# )").Visible(true));

                                                           })
                                                           .CategoryAxis(axis => axis
                                                           // .Labels(labels => labels.Rotation(45))
                                                           .MajorGridLines(lines => lines.Visible(false))
                                                           .Line(line => line.Visible(false))

                                                           )
                                                           .ValueAxis(axis => axis.Numeric()
                                                           .Labels(labels => labels
                                                           .Format("{0:N0}")
                                                           //.Rotation(90)
                                                           )
                                                           //.MajorUnit(500)

                                                           .Line(line => line.Visible(false))
                                                           )
                                                           .RenderAs(RenderingMode.Canvas)
                                                           .Tooltip(tooltip => tooltip
                                                           .Visible(true)
                                                           .Format("{0:N0}")
                                                           )
                                                           .ToClientTemplate()
                                                           )

