@model Hrms.Lite.Shared.MIS.MISDashBoard
@using Kendo.Mvc.UI

<script>
    $(document).ready(function () {

        const spr = setTimeout(hideSpinner, 1000)
    });


    function onSeriesTotalOver(e) {
        $("#grvByFy").css("cursor", "pointer");
    }
    function onSeriesTotalClick(e) {
        var groupCom = $("#GroupCompanyCode").val();
        var financialYear = $("#finYear").val()
        $.ajax({

            type: 'GET',
            url: '/MIS/MISDashBoard/ReloadDiv',
            dataType: 'html',
            data: { id: 42, type: 'Total', GrievanceCatid: e.dataItem.grievanceCatID},

            success: function (result) {


                window.location.href = '/MIS/MISDashBoard?id=42&groupCom=' + groupCom + '&financialYr=' + financialYear + '&type=Total&GrievanceCatid=' + e.dataItem.grievanceCatID;


            },
            error: function (xhr, textStatus, errorThrown) {
                debugger
                document.body.id = "kt_body";
                $('body').html(xhr.responseText);


            }
        });

    }

    //
