@model Hrms.Lite.Shared.MIS.MISDashBoard
@using Kendo.Mvc.UI

<style>
    .k-tilelayout-item-header .k-card-title {
        font-size: 1rem;
    }

    .k-card-header {
        flex: 0 0 auto;
    }

    .k-card-body {
        overflow: hidden;
    }

    .k-card:nth-child(1) {
        background-color: #1C5CF9 !important;
        border-radius: 10px 10px 10px 10px;
        color: #fff !important;
       
    }



    .k-card:nth-child(6) {
        background-color: #F6635C !important;
        border-radius: 10px 10px 10px 10px;
        color: #fff !important;
    }


</style>

<script>

    $(document).ready(function () {

        const spr = setTimeout(hideSpinner, 1000)
    });
</script>



<script>

    function onGenderSeriesClick(e) {
        //console.log(e);
        var groupCom = $("#GroupCompanyCode").val();
        var from = $("#From").val();
        var to = $("#To").val();
        $.ajax({

            type: 'GET',
            url: '/MIS/MISDashBoard/ReloadDiv',
            dataType: 'html',
            data: { id: 26, type: 'Gender', age: e.Category },

            success: function (result) {

                window.location.href = '/MIS/MISDashBoard?id=26&from=' + from + '&to=' + to + '&groupCom=' + groupCom + '&type=Gender&name=' + e.dataItem.name + '&age=' + e.category;



            },
            error: function (xhr, textStatus, errorThrown) {
                debugger
                document.body.id = "kt_body";
                $('body').html(xhr.responseText);


            }
        });
    }
    function onGenderSeriesHover(e) {
        $("#genderJoins").css("cursor", "pointer");
    }
    function onSeriesBHClick(e) {
        var groupCom = $("#GroupCompanyCode").val();
        var from = $("#From").val();
