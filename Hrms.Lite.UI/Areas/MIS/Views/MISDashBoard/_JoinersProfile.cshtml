<script id="avgJoinCount" type="text/x-kendo-template">
    <div id="avgJoin" style="color: \\#fff; height:100%;display:flex; align-items:center;justify-content:center;font-size:3rem;font-weight: 700;">@Model.averageJoinersCount </div>
</script>

<script id="joiningCount" type="text/x-kendo-template">
    <div id="hiresCount" style="color: \\#fff;height:100%;display:flex; align-items:center;justify-content:center;font-size:3rem;font-weight: 700">@Model.joiningCount </div>

</script>
<script id="badHires" type="text/x-kendo-template">
    <div id="badJoins" style="color: \\#fff;height:100%;display:flex; align-items:center;justify-content:center;font-size:3rem;font-weight: 700">@Model.badHires </div>

</script>
<script id="badHiresG" type="text/x-kendo-template">
    @(Html.Kendo().Chart<Hrms.Lite.Shared.MIS.BadHires>()
                                                          .Name("bHires")
                                                          .Title("")
                                                              .Events(E => E.SeriesClick("onSeriesBHClick")
                                                                              .SeriesHover("onSeriesBHOver"))
                                                          .Legend(legend => legend

                                                          .Position(ChartLegendPosition.Bottom).Labels(x => x.Font("9px Arial,Helvetica,sans-serif"))
                                                  .Orientation(ChartLegendOrientation.Horizontal)
                                                  .Labels(x => x.Font("15px Arial,Helvetica,sans-serif"))


                                                          .Visible(true)
                                                          )
                                                          .ChartArea(chart => chart
                                                          .Background("transparent")


                                                          )
                                                          .DataSource(ds =>
                                                          {
                                                              ds.Read(read => read.Action("GetBadHires", "MISDashBoard").Data("getParam"));


                                                          }
                                                          )
                                                          .Series(series => series

                                                          .Donut(model => model.total, model => model.type).HoleSize(40).Size(40)
                                                          .ColorField("color")
                                                          .Labels(labels => labels

                                                          .Background("transparent")

                                                          .Visible(true)
                                                          )


                                                                  )

                                                               .HtmlAttributes(new { style = "height:100%;width:100%;" })
                                                              .SeriesColors("\\#735bf7", "\\#a8a0fd")

                                                              .ToClientTemplate()
                                                          )



</script>
