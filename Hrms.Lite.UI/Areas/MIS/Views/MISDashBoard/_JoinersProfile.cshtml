<script id="monthresignation" type="text/x-kendo-template">
    @(
                    Html.Kendo().Chart<Hrms.Lite.Shared.MIS.MonthWiseTerminationList>()
                                        .Name("monthResignation")
                                        .Title("")

                                        .Legend(legend => legend
                                          .Position(ChartLegendPosition.Bottom).Labels(x => x.Font("9px Arial,Helvetica,sans-serif"))
                                                  .Orientation(ChartLegendOrientation.Horizontal)
                                                  .Labels(x => x.Font("15px Arial,Helvetica,sans-serif"))
                                        )
                                                .DataSource(ds => ds.Read(read => read.Action("GetResignationMonthwiseCount", "MISDashBoard")))
                                        .Series(series =>
                                        {
                                            series.Line(model => model.ejocount).Name("Joining").CategoryField("monthName").Color("\\#F86F03").Width(5);


                                        })
                                        .ChartArea(ch => ch.Width(850).Height(250))
                                        .CategoryAxis(axis => axis
                                            .Labels(labels => labels.Rotation(0))
                                        //.Crosshair(c => c.Visible(true))
                                        )
                                        .ValueAxis(axis => axis.Numeric()
                                            .Labels(labels => labels.Format("{0:N0}"))
                                        //.MajorUnit(500)
                                        )
                                        .Tooltip(tooltip => tooltip
                                            .Visible(true)
                                            .Shared(true)
                                            .Format("{0:N0}")
                                        )

                                        .ToClientTemplate()
                )
</script>

