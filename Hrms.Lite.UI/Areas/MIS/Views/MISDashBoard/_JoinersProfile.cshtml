    function onSeriesAGEClick(e) {
        var groupCom = $("#GroupCompanyCode").val();
        var from = $("#From").val();
        var to = $("#To").val();
        var age = e.category
        if (age == '60+') {
            age = '60-100';
        }
        else {
            age = age.replace(' Year', '');
        }
        $.ajax({

            type: 'GET',
            url: '/MIS/MISDashBoard/ReloadDiv',
            dataType: 'html',
            data: { id: 28, type: 'AGE', age: age },

            success: function (result) {


                window.location.href = '/MIS/MISDashBoard?id=28&from=' + from + '&to=' + to + '&groupCom=' + groupCom + '&type=AGE&age=' + age + '&name=Age ' + e.category;


            },
            error: function (xhr, textStatus, errorThrown) {
                debugger
                document.body.id = "kt_body";
                $('body').html(xhr.responseText);


            }
        });

    }
