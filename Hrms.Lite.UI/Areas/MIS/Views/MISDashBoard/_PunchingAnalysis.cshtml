@model Hrms.Lite.Shared.MIS.MISDashBoard
@using Kendo.Mvc.UI


<style>

    .export-app {
        display: table;
        width: 100%;
        height: 750px;
        padding: 0;
    }

        .export-app .demo-section {
            margin: 0 auto;
            border: 0;
        }

    .charts-wrapper {
        height: 250px;
        padding: 0 0 20px;
    }

    #applications,
    #users,
    #referrals {
        display: inline-block;
        width: 50%;
        height: 240px;
        vertical-align: top;
    }

    #applications,
    #referrals {
        width: 24%;
        height: 250px;
    }



    .demo-section.content-wrapper,
    .demo-section.export-app {
        display: block !important;
    }

    .demo-section.export-app {
        height: auto;
    }


    .k-tilelayout-item-header .k-card-title {
        font-size: 1rem;
    }

    .k-card-header {
        flex: 0 0 auto;
    }

    .k-card-body {
        overflow: hidden;
    }
</style>

<script>
    $(document).ready(function () {

        const spr = setTimeout(hideSpinner, 1000)
    });


</script>

<script id="hrTimeOffice" type="text/x-kendo-template">
    @(Html.Kendo().Chart<Hrms.Lite.Shared.MIS.HRTimeOffice>()

                                                                       .Name("hrTO")

                                                                       .Title("")

                                                                           .HtmlAttributes(new { style = "width:100%;height:100%;" })
                                                                       .Legend(legend => legend
                                                                      .Position(ChartLegendPosition.Bottom).Labels(x => x.Font("9px Arial,Helvetica,sans-serif"))
                                                  .Orientation(ChartLegendOrientation.Horizontal)
                                                  .Labels(x => x.Font("15px Arial,Helvetica,sans-serif"))
                                                                       )
                                                                       .ChartArea(chartArea => chartArea
                                                                       .Margin(margin => margin.Top(10).Right(5).Left(10).Bottom(0)))
                                                                                                       .DataSource(ds => ds.Read(read => read.Action("GetTimeOfficeHR", "MISDashBoard").Data("getParam")))
                                                                       .Series(series =>
                                                                       {
                                                                           series.Column(model => model.lateIn).Name("Late In").CategoryField("monthName")
                                                                           .Color("\\#16cc62").Spacing(0)
                                                                            .Tooltip(tooltip => tooltip.
                                                                             Template("(Late In - \\#= (dataItem.lateIn)\\# )").Visible(true));

                                                                           series.Column(model => model.earlyOut).Name("Early Out").CategoryField("monthName")
                                                                           .Color("\\#196ee6").Spacing(0)
                                                                            .Tooltip(tooltip => tooltip.
                                                                             Template("(Early Out  - \\#= (dataItem.earlyOut)\\# )").Visible(true));                                                                       

                                                                       })
                                                                       .CategoryAxis(axis => axis
                                                                       .Labels(labels => labels.Rotation(0))
                                                                       .MajorGridLines(lines => lines.Visible(false))
                                                                       .Line(line => line.Visible(false))
                                                                       )
                                                                       .ValueAxis(axis => axis.Numeric()
                                                                       .Labels(labels => labels
                                                                       .Format("{0:N0}")
                                                                       //.Rotation(0)
                                                                       )
                                                                      // .MajorUnit(100)

                                                                       .Line(line => line.Visible(false))
                                                                       )
                                                                       .RenderAs(RenderingMode.Canvas)
                                                                       .Tooltip(tooltip => tooltip
                                                                       .Visible(true)

                                                                       .Format("{0:N0}")
                                                                       )
                                                                       .ToClientTemplate()
                                                                       )

</script>
