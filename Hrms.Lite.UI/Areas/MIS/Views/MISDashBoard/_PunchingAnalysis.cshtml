@(Html.Kendo().TileLayout()
        .Name("tilelayout")
        .Columns(12)
        .RowsHeight("150px")
        .ColumnsWidth("250px")

        .Containers(c =>
        {

            c.Add().Header(h => h.Text("Early Departures and Tardy Arrivals of Past 6 Months")).BodyTemplateId("hrTimeOffice").ColSpan(4).RowSpan(2);
            c.Add().Header(h => h.Text("Late comers and Early Leavers Analysis Department Wise")).BodyTemplateId("hrTimeOfficeDepartment").ColSpan(4).RowSpan(2);
            c.Add().Header(h => h.Text("Late comers and Early Leavers Analysis Location Wise")).BodyTemplateId("hrTimeOfficeLocation").ColSpan(4).RowSpan(2);


            c.Add().Header(h => h.Text("Late comers and Early Leavers Analysis Division Wise")).BodyTemplateId("hrTimeOfficeDivision").ColSpan(4).RowSpan(2);
            c.Add().Header(h => h.Text("Late comers and Early Leavers Analysis Category Wise")).BodyTemplateId("hrTimeOfficeCategory").ColSpan(4).RowSpan(2);
            //c.Add().Header(h => h.Text("Late comers and Early Leavers Analysis Grade Wise")).BodyTemplateId("hrTimeOfficeGrade").ColSpan(3).RowSpan(2);
            c.Add().Header(h => h.Text("Late comers and Early Leavers Analysis Region Wise")).BodyTemplateId("hrTimeOfficeRegion").ColSpan(4).RowSpan(2);

        })
        .Reorderable(true)
        .Resizable(true)
        .Events(e => e.Resize("onTileResize"))
    )