<script id="incDpt" type="text/x-kendo-template">
    @(Html.Kendo().Chart<Hrms.Lite.Shared.MIS.SalaryIncrementRange>()
          .Name("incDepartment")
          .Title("")
               .HtmlAttributes(new { style = "width:100%;height:100%;" })
          .Legend(legend => legend
              .Position(ChartLegendPosition.Top)
          )
                      .DataSource(ds => ds.Read(read => read.Action("GetSalaryIncrementRange", "MISDashBoard").Data("getFY")))
          .Series(series =>
          {
                  series.RangeColumn(model => model.minPay, model => model.maxPay).Name("Increment").CategoryField("department").Color("\\#38761D");
             
          })
                  .ChartArea(chartArea => chartArea
                                                               .Margin(margin => margin.Top(10).Right(5).Left(10).Bottom(0)))
                                            .CategoryAxis(axis => axis
                                                .Labels(labels => labels.Rotation(0))
                                                .Crosshair(c => c.Visible(true))
                                            )
                                            .ValueAxis(axis => axis.Numeric()
                                                .Labels(labels => labels.Format("{0:N0}"))
                                                .MajorUnit(10000)
                                            )
          .Tooltip(tooltip => tooltip
              .Visible(true)
                              .Template("\\#= dataItem.minPay \\# - \\#= dataItem.maxPay \\#")
          ).ToClientTemplate()
      )
</script>

<script id="salaryAlw" type="text/x-kendo-template">
