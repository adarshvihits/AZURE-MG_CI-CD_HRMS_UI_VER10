<script>
    function onPlotAreaOver(e) {
        $("#monthSalary").css("cursor", "pointer");
    }
    function onPlotAreaClick(e) {
        var groupCom = $("#GroupCompanyCode").val();
        var finCode = $("#finYear").val();

        $.ajax({

            type: 'GET',
            url: '/MIS/MISDashBoard/ReloadDiv',
            dataType: 'html',
            data: { id: 58, type: 'MONTH', age: 0 },

            success: function (result) {

                
                window.location.href = '/MIS/MISDashBoard?id=58&groupCom=' + groupCom + '&finCode=' + finCode + '&type=MONTH&name=Month&age=0';


            },
            error: function (xhr, textStatus, errorThrown) {
                debugger
                document.body.id = "kt_body";
                $('body').html(xhr.responseText);


            }
        });

    }
