<script id="salaryMonths" type="text/x-kendo-template">
    @(
                        Html.Kendo().Chart<Hrms.Lite.Shared.MIS.MonthWiseSalaryTrend>()
                                        .Name("monthSalary")
                                        .Title("")
                                                    .Events(e => e.PlotAreaHover("onPlotAreaOver")
                                                                                                 .PlotAreaClick("onPlotAreaClick"))
                                        .Legend(legend => legend
                                            .Position(ChartLegendPosition.Bottom).Labels(x => x.Font("9px Arial,Helvetica,sans-serif"))
                                                  .Orientation(ChartLegendOrientation.Horizontal)
                                                  .Labels(x => x.Font("15px Arial,Helvetica,sans-serif"))
                                        )
                                                            .DataSource(ds => ds.Read(read => read.Action("GetSalaryMonthwise", "MISDashBoard").Data("getFY")))
                                        .Series(series =>
                                        {
                                            series.Line(model => model.total).Name("CTC").CategoryField("monthName").Color("\\#4158A6").Width(5);


                                        })
                                        .ChartArea(ch => ch.Width(550).Height(400))
                                        .CategoryAxis(axis => axis
                                            .Labels(labels => labels.Rotation(0))
                                            .Crosshair(c => c.Visible(true))
                                        )
                                        .ValueAxis(axis => axis.Numeric()
                                            .Labels(labels => labels.Format("{0:N0}"))
                                           // .MajorUnit(50)
                                        )
                                        .Tooltip(tooltip => tooltip
                                            .Visible(true)
                                            .Shared(true)
                                            .Format("{0:N0}")
                                                .Template("(\\#= (dataItem.total)\\# K)")
                                        )

                                        .ToClientTemplate()
                )
</script>

<script id="salbyDpt" type="text/x-kendo-template">
    @(
                    Html.Kendo().Chart<Hrms.Lite.Shared.MIS.SalaryDepartmentWise>()

                                                           .Name("salaryDpt")
                                                               .Events(e => e.SeriesHover("onSeriesDptOver")
                                                                                         .SeriesClick("onSeriesDptClick"))
                                                           .Title("")

                                                               .HtmlAttributes(new { style = "width:100%;height:100%;" })
                                                           .Legend(legend => legend
                                                           .Position(ChartLegendPosition.Bottom).Labels(x => x.Font("9px Arial,Helvetica,sans-serif"))
                                                  .Orientation(ChartLegendOrientation.Horizontal)
