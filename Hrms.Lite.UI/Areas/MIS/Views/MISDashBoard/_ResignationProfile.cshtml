<script id="gender" type="text/x-kendo-template">
    @(
        Html.Kendo().Chart<Hrms.Lite.Shared.MIS.GenderResignationCountList>()
                                                              .Name("genderBand")
                                                              .Title("")
                                                              .Events(e=>e.SeriesClick("onGenderSeriesClick")
                                                              .SeriesHover("onGenderSeriesHover"))
                                                              .Legend(legend => legend

                                                              .Position(ChartLegendPosition.Bottom).Labels(x => x.Font("9px Arial,Helvetica,sans-serif"))
                                                  .Orientation(ChartLegendOrientation.Horizontal)
                                                  .Labels(x => x.Font("15px Arial,Helvetica,sans-serif"))

                                                              .Labels(x => x.Font("18px Arial,Helvetica,sans-serif"))

                                                              .Visible(true)
                                                              )
                                                              .ChartArea(chart => chart
                                                              .Background("transparent")


                                                              )
                                                              .DataSource(ds =>
                                                              {
                                                                  ds.Read(read => read.Action("GetGenderResignationCount", "MISDashBoard").Data("getParam"));


                                                              }
                                                              )
                                                              .Series(series => series

                                                                  .Donut(model => model.genCount, model => model.name).HoleSize(40).Size(40)

                                                              .Labels(labels => labels
                                                              //Template("#= dataItem.name #:") //\n #= dataItem.count#
                                                              .Position(ChartSeriesLabelsPosition.OutsideEnd)

                                                              .Background("transparent")

                                                              .Visible(true)
                                                              )


                                                              )

                                                   .HtmlAttributes(new { style = "height:100%;width:100%;" })
                                                   .SeriesColors("\\#735bf7", "\\#a8a0fd")

                                                  .ToClientTemplate()
                                              )



</script>
<script id="monthresignation" type="text/x-kendo-template">
    @(
            Html.Kendo().Chart<Hrms.Lite.Shared.MIS.MonthWiseTerminationList>()
                                .Name("monthResignation")
                                .Title("")
                                     .Events(e => e.SeriesOver("onSeriesOver")
                                          .PlotAreaClick("onSeriesClick"))
                                .Legend(legend => legend
                                    .Position(ChartLegendPosition.Bottom).Labels(x => x.Font("9px Arial,Helvetica,sans-serif"))
                                                  .Orientation(ChartLegendOrientation.Horizontal)
                                                  .Labels(x => x.Font("15px Arial,Helvetica,sans-serif"))
                                )
                                            .DataSource(ds => ds.Read(read => read.Action("GetResignationMonthwiseCount", "MISDashBoard").Data("getParam")))
                                .Series(series =>
                                {
                                        series.Line(model => model.ejocount).Name("Joining").CategoryField("monthName").Color("\\#7ce5d3").Width(5);
                                        series.Line(model => model.esepcount).Name("Seperation").CategoryField("monthName").Color("\\#f76775").Width(5);

                                })
                                .ChartArea(ch => ch.Width(800).Height(300))
                                .CategoryAxis(axis => axis
                                    .Labels(labels => labels.Rotation(0))
                                    .Crosshair(c => c.Visible(true))
                                )
                                .ValueAxis(axis => axis.Numeric()
                                    .Labels(labels => labels.Format("{0:N0}"))
                                    //.MajorUnit(1000)
                                )
                                .Tooltip(tooltip => tooltip
                                    .Visible(true)
                                    .Shared(true)
                                    .Format("{0:N0}")
                                )

                                .ToClientTemplate()
        )
</script>

<script id="resignationbyreason" type="text/x-kendo-template">

    @(Html.Kendo().Chart<Hrms.Lite.Shared.MIS.GenderResignationReasonCountList>()

