            url: '/MIS/MISDashBoard/ReloadDiv',
            dataType: 'html',
            data: { id: 19, age: e.category },

            success: function (result) {

                window.location.href = '/MIS/MISDashBoard?id=19&from=' + from + '&to=' + to + '&groupCom=' + groupCom + '&age=' + e.category;


                // $("#MisDashBoard").html(result);
                // $("#joiningCount").html(result.joiningCount);

            },
            error: function (xhr, textStatus, errorThrown) {
                debugger
                document.body.id = "kt_body";
                $('body').html(xhr.responseText);


            }
        });
    }

