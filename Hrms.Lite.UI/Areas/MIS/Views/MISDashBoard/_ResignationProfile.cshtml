@(Html.Kendo().TileLayout()
        .Name("tilelayout")
        .Columns(12)
        .RowsHeight("150px")
        .ColumnsWidth("250px")

        .Containers(c =>
        {
            c.Add().Header(h => h.Text("Resignations")).BodyTemplateId("resignation").ColSpan(3).RowSpan(1);
            c.Add().Header(h => h.Text("Avg. Resignations/Month")).BodyTemplateId("avgresignation").ColSpan(3).RowSpan(1);
            c.Add().Header(h => h.Text("Joining")).BodyTemplateId("joiningCount").ColSpan(3).RowSpan(1);
            c.Add().Header(h => h.Text("Attrition")).BodyTemplateId("attritionRate").ColSpan(3).RowSpan(1);


            c.Add().Header(h => h.Text("Leavers By Gender")).BodyTemplateId("gender").ColSpan(3).RowSpan(2);

            c.Add().Header(h => h.Text("Hires Vs Leavers")).BodyTemplateId("monthresignation").ColSpan(6).RowSpan(2);


            c.Add().Header(h => h.Text("Resignations by Age Banding")).BodyTemplateId("resignationbyage").ColSpan(3).RowSpan(2);


            c.Add().Header(h => h.Text("Resignations by Service")).BodyTemplateId("resignationbytenure").ColSpan(3).RowSpan(2);
            c.Add().Header(h => h.Text("Resignations by Reason")).BodyTemplateId("resignationbyreason").ColSpan(3).RowSpan(2);
            c.Add().Header(h => h.Text("Resignations Department Wise")).BodyTemplateId("termbyDepartment").ColSpan(3).RowSpan(2);
            c.Add().Header(h => h.Text("Resignations Location Wise")).BodyTemplateId("termbyLocation").ColSpan(3).RowSpan(2);
            c.Add().Header(h => h.Text("Resignations Division Wise")).BodyTemplateId("termbyDivision").ColSpan(3).RowSpan(2);
            c.Add().Header(h => h.Text("Resignations Grade Wise")).BodyTemplateId("termbyGrade").ColSpan(3).RowSpan(2);
            c.Add().Header(h => h.Text("Resignations Category Wise")).BodyTemplateId("termbyCategory").ColSpan(3).RowSpan(2);
            c.Add().Header(h => h.Text("Resignations Region Wise")).BodyTemplateId("termbyRegion").ColSpan(3).RowSpan(2);

        })
        .Reorderable(true)
        .Resizable(true)
        .Events(e => e.Resize("onTileResize"))
    )
