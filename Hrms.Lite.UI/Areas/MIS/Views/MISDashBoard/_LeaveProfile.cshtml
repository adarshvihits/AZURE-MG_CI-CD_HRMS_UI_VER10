    function onEmpClick() {
        var crrntLp = $("#LeavePeriod_Code").val();
        var groupCom = $("#GroupCompanyCode").val();
        $.ajax({

            type: 'GET',
            url: '/MIS/MISDashBoard/ReloadDiv',
            dataType: 'html',
            data: { id: 90, type: 'All', code: '0' },

            success: function (result) {
                window.location.href = '/MIS/MISDashBoard?id=90&crrntLp=' + crrntLp + '&groupCom=' + groupCom + '&type=All&code=0';
            },
            error: function (xhr, textStatus, errorThrown) {
                debugger
                document.body.id = "kt_body";
                $('body').html(xhr.responseText);
            }
        });

