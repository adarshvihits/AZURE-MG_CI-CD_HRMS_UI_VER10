@(Html.Kendo().TileLayout()
        .Name("tilelayout")
        .Columns(12)
        .RowsHeight("145px")
        .ColumnsWidth("250px")

        .Containers(c =>
        {
            c.Add().Header(h => h.Text("Total Leave")).BodyTemplateId("leave").ColSpan(3).RowSpan(1);
            c.Add().Header(h => h.Text("Avg. Leave Per Employee")).BodyTemplateId("avg").ColSpan(3).RowSpan(1);
            c.Add().Header(h => h.Text("Total Lop")).BodyTemplateId("lop").ColSpan(3).RowSpan(1);
            c.Add().Header(h => h.Text("Absent")).BodyTemplateId("abs").ColSpan(3).RowSpan(1);

            c.Add().Header(h => h.Text("Select Option")).BodyTemplateId("comboBoxTemplate").ColSpan(12).RowSpan(1);


            c.Add().Header(h => h.Text("Today")).BodyTemplateId("Today").ColSpan(2).RowSpan(1);
            c.Add().Header(h => h.Text("Tomorrow")).BodyTemplateId("Tomorrow").ColSpan(2).RowSpan(1);
            c.Add().Header(h => h.Text("Yesterday")).BodyTemplateId("Yesterday").ColSpan(2).RowSpan(1);
            c.Add().Header(h => h.Text("Current Weak")).BodyTemplateId("CurrentWeak").ColSpan(2).RowSpan(1);
            c.Add().Header(h => h.Text("Current Month")).BodyTemplateId("CurrentMonth").ColSpan(2).RowSpan(1);
            c.Add().Header(h => h.Text("Previous Month")).BodyTemplateId("PreviousMonth").ColSpan(2).RowSpan(1);

            c.Add().Header(h => h.Text("Leaves By Age")).BodyTemplateId("leavebyage").ColSpan(6).RowSpan(2);
            c.Add().Header(h => h.Text("Leaves By Catagory")).BodyTemplateId("catagory").ColSpan(6).RowSpan(4);

            c.Add().Header(h => h.Text("Leave By Department")).BodyTemplateId("leavebydepartment").ColSpan(6).RowSpan(2);
            c.Add().Header(h => h.Text("Leave By Location")).BodyTemplateId("leavebylocation").ColSpan(6).RowSpan(2);

            c.Add().Header(h => h.Text("Leave By Division")).BodyTemplateId("leavebydivision").ColSpan(6).RowSpan(2);
            c.Add().Header(h => h.Text("Leave By Category")).BodyTemplateId("leavebycategory").ColSpan(6).RowSpan(2);

            c.Add().Header(h => h.Text("Leave By Grade")).BodyTemplateId("leavebygrade").ColSpan(6).RowSpan(2);
            c.Add().Header(h => h.Text("Leave By Region")).BodyTemplateId("leavebyregion").ColSpan(6).RowSpan(2);

            c.Add().Header(h => h.Text("Total Leave Days Trend")).BodyTemplateId("leavemonths").ColSpan(6).RowSpan(2);


        })
        .Reorderable(true)
        .Resizable(true)
        .Events(e => e.Resize("onTileResize"))
    )