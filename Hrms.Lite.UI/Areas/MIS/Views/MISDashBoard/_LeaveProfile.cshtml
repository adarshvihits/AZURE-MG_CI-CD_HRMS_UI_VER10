<script id="leavebyage" type="text/x-kendo-template">
    @(
                    Html.Kendo().Chart<Hrms.Lite.Shared.MIS.AgeBandLeaveCountList>()

                                                           .Name("leaveAge")

                                                           .Title("")
                                                               .Events(e => e.SeriesHover("onSeriesAgeHover")
                                                 .SeriesClick("onSeriesAgeClick"))
                                                               .HtmlAttributes(new { style = "width:100%;height:200px;" })
                                                           .Legend(legend => legend
                                                           .Position(ChartLegendPosition.Bottom).Labels(x => x.Font("9px Arial,Helvetica,sans-serif"))
                                                  .Orientation(ChartLegendOrientation.Horizontal)
                                                  .Labels(x => x.Font("15px Arial,Helvetica,sans-serif"))

                                                           )
                                                           .ChartArea(chartArea => chartArea
                                                           .Margin(margin => margin.Top(10).Right(5).Left(10).Bottom(0)))
                                                                                   .DataSource(ds => ds.Read(read => read.Action("GetLeaveageBandCount", "MISDashBoard").Data("getLeavePeriod")))
                                                           .Series(series =>
                                                           {
                                                                   series.Column(model => model.total).Name("Years").CategoryField("years").Color("\\#1a659e"); ;

                                                           })
                                                       .CategoryAxis(axis => axis
                                                       //.Labels(labels => labels.Rotation(0))
                                                       .MajorGridLines(lines => lines.Visible(false))
                                                       .Line(line => line.Visible(false))
                                                       )
                                                       .ValueAxis(axis => axis.Numeric()
                                                       .Labels(labels => labels
                                                       .Format("{0:N0}")
                                                       //.Rotation(0)
                                                       )
                                                      // .MajorUnit(1000)

                                                       .Line(line => line.Visible(false))
                                                       )
                                                       .RenderAs(RenderingMode.Canvas)
                                                       .Tooltip(tooltip => tooltip
                                                        .Template("\\#= (dataItem.years)\\# : \\#= (dataItem.total)\\# ")
                                                       .Visible(true)
                                                       .Format("{0:N0}")
                                                       )
                                                       .ToClientTemplate()
                                                       )

</script>


<script id="leavemonths" type="text/x-kendo-template">
    @(
                Html.Kendo().Chart<Hrms.Lite.Shared.MIS.MonthWiseLeaveList>()
                                    .Name("monthLeave")
                                    .Title("")
                                             .Events(e => e.DataBound("sortData").PlotAreaHover("onPlotAreaHover")
                                                             .PlotAreaClick("onPlotAreaClick"))
                                    .Legend(legend => legend
                                        .Position(ChartLegendPosition.Bottom).Labels(x => x.Font("9px Arial,Helvetica,sans-serif"))
                                                  .Orientation(ChartLegendOrientation.Horizontal)
                                                  .Labels(x => x.Font("15px Arial,Helvetica,sans-serif"))
                                    )
                                                .DataSource(ds => ds.Read(read => read.Action("GetLeaveMonthwiseCount", "MISDashBoard").Data("getLeavePeriod")))
                                    .Series(series =>
                                    {
                                            series.Line(model => model.leave).Name("Leave").CategoryField("month").Color("\\#ffb900").Width(5);


                                    })
                                    .ChartArea(ch => ch.Width(950).Height(300))
                                    .CategoryAxis(axis => axis
                                        .Labels(labels => labels.Rotation(0))
                                        .Crosshair(c => c.Visible(true))
                                    )
                                    .ValueAxis(axis => axis.Numeric()
                                        .Labels(labels => labels.Format("{0:N0}"))
                                        //.MajorUnit(1000)
                                    )
                                    .Tooltip(tooltip => tooltip
                                        .Visible(true)
                                        .Shared(true)
                                        .Format("{0:N0}")
                                    )

                                    .ToClientTemplate()
            )
</script>

