<script id="absMonths" type="text/x-kendo-template">

    @(
                                Html.Kendo().Chart<Hrms.Lite.Shared.MIS.AbsMonthWise>()
                                            .Name("monthAbs")
                                            .Title("")
                                                .Events(events => events.Render("onRender").PlotAreaClick("MonthWiseDetailClick"))
                                            .Legend(legend => legend
                                                .Position(ChartLegendPosition.Bottom).Labels(x => x.Font("9px Arial,Helvetica,sans-serif"))
                                                  .Orientation(ChartLegendOrientation.Horizontal)
                                                  .Labels(x => x.Font("15px Arial,Helvetica,sans-serif"))
                                            )
                                                                    .DataSource(ds => ds.Read(read => read.Action("GetAbsMonth", "MISDashBoard").Data("getParam")))
                                            .Series(series =>
                                            {
                                                series.Line(model => model.total).Name("Absent Rate").CategoryField("monthName").Color("\\#FF69B4").Width(5);


                                            })
                                            .ChartArea(ch => ch.Width(800).Height(350))
                                            .CategoryAxis(axis => axis
                                                .Labels(labels => labels.Rotation(0))
                                                .Crosshair(c => c.Visible(true))
                                            )
                                            .ValueAxis(axis => axis.Numeric()
                                                .Labels(labels => labels.Format("{0:N0}"))
                                                .MajorUnit(50)
                                            )
                                            .Tooltip(tooltip => tooltip
                                                .Visible(true)
                                                .Shared(true)
                                                .Format("{0:N0}")
                                                    .Template("(\\#= (dataItem.total)\\# %)")
                                            )

                                            .ToClientTemplate()
                    )
</script>
