@(Html.Kendo().TileLayout()
        .Name("tilelayout")
        .Columns(12)
        .RowsHeight("100px")
        .ColumnsWidth("200px")

        .Containers(c =>
        {
            c.Add().Header(h => h.Text("Absenteeism Rate")).BodyTemplateId("absRate").ColSpan(3).RowSpan(1);
            c.Add().Header(h => h.Text("Absenteeism Count")).BodyTemplateId("absCount").ColSpan(3).RowSpan(1);
            c.Add().Header(h => h.Text("Absenteeism Month wise")).BodyTemplateId("absMonths").ColSpan(6).RowSpan(4);
            c.Add().Header(h => h.Text("Absenteeism Age Band")).BodyTemplateId("absbyAge").ColSpan(6).RowSpan(3);
            c.Add().Header(h => h.Text("Absenteeism Service Band")).BodyTemplateId("absbyTenure").ColSpan(6).RowSpan(3);
            c.Add().Header(h => h.Text("Absenteeism Department Wise")).BodyTemplateId("absbyDepartment").ColSpan(6).RowSpan(3);
            c.Add().Header(h => h.Text("Absenteeism Location Wise")).BodyTemplateId("absbyLocation").ColSpan(6).RowSpan(3);
            c.Add().Header(h => h.Text("Absenteeism Division Wise")).BodyTemplateId("absbyDivision").ColSpan(6).RowSpan(3);
            c.Add().Header(h => h.Text("Absenteeism Category Wise")).BodyTemplateId("absbyCategory").ColSpan(6).RowSpan(3);
            c.Add().Header(h => h.Text("Absenteeism Region Wise")).BodyTemplateId("absbyRegion").ColSpan(6).RowSpan(3);
            c.Add().Header(h => h.Text("Absenteeism Grade Wise")).BodyTemplateId("absbyGrade").ColSpan(6).RowSpan(3);
            c.Add().Header(h => h.Text("Absenteeism Days")).BodyTemplateId("absbyWeek").ColSpan(6).RowSpan(3);

        })
        .Reorderable(true)
