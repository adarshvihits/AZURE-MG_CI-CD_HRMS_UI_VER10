@model Hrms.Lite.Shared.MIS.MISDashBoard
@using Kendo.Mvc.UI



<script>
    $(document).ready(function () {

        const spr = setTimeout(hideSpinner, 1000)
    });
    $(document).ready(function () {

        kendo.ui.progress($(".chart-loading"), true);
    });
    function onRender(e) {
        // Clear up the loading indicator for this chart
        var loading = $(".chart-loading");

        kendo.ui.progress(loading, false);
    }

    function sortData(e) {

        var chart = $("#histJoinersMonth").data("kendoChart");

        var axis = e.sender.options.categoryAxis;

        var months = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday",
            "Sunday"];



        if (axis.categories != undefined) {
            axiscategories = axis.categories.sort((a, b) => months.indexOf(a) - months.indexOf(b));
        }
    }

</script>
<style>
    .k-tilelayout-item-header .k-card-title {
        font-size: 1rem;
    }

    .k-card-header {
        flex: 0 0 auto;
        background-color: transparent !important;
    }

    .k-card-body {
        overflow: hidden;
    }

    .k-card:nth-child(1) {
        background-color: #1C5CF9 !important;
        border-radius: 10px 10px 10px 10px;
        color: #fff !important;
        height: 100px;
    }

    .k-tilelayout-item:first-child .k-card-header {
        background-color: #1C5CF9 !important;
        border-radius: 10px 10px 0px 0px;
        color: #fff !important;
    }

    #absRate {
        background-color: #FF7A00 !important;

    }
    #absCount {
        background-color: #FF7A00 !important;
    }

    #absenRate, #absenCount {
        color: #fff !important;
        font-weight: 800 !important;
    }

    .k-card:nth-child(2) {
        background-color: #FF7A00 !important;
        border-radius: 10px 10px 10px 10px;
        color: #fff !important;
        height: 100px;
    }


</style>
<div class="chart-loading"></div>
<script id="absRate" type="text/x-kendo-template">
    <div id="absenRate" style="height:100%;display:flex; align-items:center;justify-content:center;font-size:2rem;">@Model.absRate </div>
</script>
<script id="absCount" type="text/x-kendo-template">
    <div id="absenCount" style="height:100%;display:flex; align-items:center;justify-content:center;font-size:2rem;">@Model.absenteesmCount </div>
</script>


<script>




    function MonthWiseDetailClick(e) {
        debugger;
        var gc = $("#GroupCompanyCode").val();

        var fromdate = $("#From").val();
        var todate = $("#To").val();
        var month = e.category.toLowerCase();
        var monthcode;

        switch (month) {
            case "january":
                monthcode = 1;
                break;
            case "february":
                monthcode = 2;
                break;
            case "march":
                monthcode = 3;
                break;
            case "april":
                monthcode = 4;
                break;
            case "may":
                monthcode = 5;
                break;
            case "june":
                monthcode = 6;
                break;
            case "july":
                monthcode = 7;
                break;
            case "august":
                monthcode = 8;
                break;
            case "september":
                monthcode = 9;
                break;
            case "october":
                monthcode = 10;
                break;
            case "november":
                monthcode = 11;
                break;
            case "december":
                monthcode = 12;
                break;
            default:

                break;
        }

        $.ajax({

            type: 'GET',
            url: '/MIS/MISDashBoard/ReloadDiv',
            dataType: 'html',
            data: { id: 110, FROMDATE: fromdate, TODATE: todate, GROUPCOMPANYCODE: gc, MONTHCODE: monthcode },

            success: function (result) {


                window.location.href = '/MIS/MISDashBoard?id=110&FROMDATE=' + fromdate + '&TODATE=' + todate + '&GROUPCOMPANYCODE=' + gc + '&MONTHCODE=' + monthcode;


            },
            error: function (xhr, textStatus, errorThrown) {
                debugger
                document.body.id = "kt_body";
                $('body').html(xhr.responseText);


            }
        });

    }



