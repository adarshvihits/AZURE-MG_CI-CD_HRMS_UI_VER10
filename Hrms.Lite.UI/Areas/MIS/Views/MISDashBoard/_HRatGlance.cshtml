@model Hrms.Lite.Shared.MIS.MISDashBoard
@using Kendo.Mvc.UI
<script>
    $(document).ready(function () {

        const spr = setTimeout(hideSpinner, 1000)
    });
   
        function columnVisual(e) {
        console.log(e);
        if (e.category=='Male')
            return createMaleColumn(e.rect, e.options.color);
            else
            return createFeMaleColumn(e.rect, e.options.color);
        }
    function createMaleColumn(rect, color) {
        var origin = rect.origin;
        var height = rect.size.height;
        var group = new kendo.drawing.Group();

        var bodyHeight = (30/100)*height;
      
        var legHeight = (100 / 100) * height;

        var diameter = (10 / 100) * height;
        // Create the head as a circle
        var head = new kendo.drawing.Circle(new kendo.geometry.Circle([origin.x + 50, origin.y], 20), {
            fill: { color: color }
        });
        group.append(head);

        // Create the body as a rectangle
        var body = new kendo.drawing.Rect(new kendo.geometry.Rect([origin.x + 40, origin.y + 30], [20,  bodyHeight]), {
            fill: { color: color }
        });
        group.append(body);

      

        // Create the legs as rectangles with increased width
        var leftLeg = new kendo.drawing.Rect(new kendo.geometry.Rect([origin.x + 35, origin.y + height - 70], [15, legHeight]), {
            fill: { color: color }
        });
        group.append(leftLeg);

        var rightLeg = new kendo.drawing.Rect(new kendo.geometry.Rect([origin.x + 50, origin.y + height - 70], [15, legHeight]), {
            fill: { color: color }
        });
        group.append(rightLeg);

        return group;
    }

    function createFeMaleColumn(rect, color) {
        var origin = rect.origin;
        var height = rect.size.height;
        var group = new kendo.drawing.Group();

        var bodyHeight = (30 / 100) * height;

         var diameter = (10 / 100) * height;

        var legHeight = (100 / 100) * height;
        console.log(legHeight);

        // Create the head as a circle
        var head = new kendo.drawing.Circle(new kendo.geometry.Circle([origin.x + 50, origin.y], diameter), {
            fill: { color: color }
        });
        group.append(head);

        // Create the body as a path (a triangle)
        var body = new kendo.drawing.Path()
            .moveTo(origin.x + 50, origin.y + bodyHeight-30)
            .lineTo(origin.x, 150)
           .lineTo(origin.x+95, 150)
            
            .close()
            .fill("#89CFF0");
        group.append(body);

        // Create the legs as rectangles with increased width
        var leftLeg = new kendo.drawing.Rect(new kendo.geometry.Rect([origin.x + 35, origin.y + height - 70], [15, legHeight]), {
            fill: { color: color }
        });
        group.append(leftLeg);

        var rightLeg = new kendo.drawing.Rect(new kendo.geometry.Rect([origin.x + 50, origin.y + height - 70], [15, legHeight]), {
            fill: { color: color }
        });
        group.append(rightLeg);

        return group;

    }


   

</script>

