<script id="trcount" type="text/x-kendo-template">
    @(
                    Html.Kendo().Chart<Hrms.Lite.Shared.MIS.MonthlyTrainings>()
                                                                        .Name("trCount")
                                                                    .Title("")
                                                                       .Events(e => e.DataBound("sortData").SeriesHover("onSeriesTrCountHover")
                                                                       )
                                                                    .Legend(legend => legend
                                                                        .Position(ChartLegendPosition.Top)
                                                                    )
                                                                                        .DataSource(ds => ds.Read(read => read.Action("GetMonthlyTrainings", "MISDashBoard").Data("getTrainingVal")))
                                                                    .Series(series =>
                                                                    {
                                                                        //series.Line(model => model.count).Name("Transition Count").CategoryField("department").Color("\\#6cf57e");
                                                                        series.Column(model => model.trainingcount).Name("Training Count").CategoryField("month").Color("\\#89CFF0")
                                                                                 .Tooltip(tooltip => tooltip.
                                                                                                         Template("(\\#= (dataItem.month)\\# - \\#= (dataItem.trainingcount)\\# )").Visible(true));
                                                                    })
                                                                .ChartArea(ch => ch.Width(550).Height(250))
                                                                .CategoryAxis(axis => axis
                                                                    .Labels(labels => labels.Rotation(0))
                                                                    .Crosshair(c => c.Visible(true))
                                                                )
                                                                .ValueAxis(axis => axis.Numeric()
                                                                    .Labels(labels => labels.Format("{0:N0}"))

                                                                )
                                                                .Tooltip(tooltip => tooltip
                                                                    .Visible(true)
                                                                    .Shared(true)
                                                                    .Format("{0:N0}")
                                                                )

                                                                .ToClientTemplate()
                                        )
</script>

@(Html.Kendo().TileLayout()
        .Name("tilelayout")
        .Columns(6)
        .RowsHeight("150px")
        .ColumnsWidth("250px")

        .Containers(c =>
        {
            c.Add().Header(h => h.Text("Yearly Training Expense")).BodyTemplateId("yearlytr").ColSpan(3).RowSpan(2);
            c.Add().Header(h => h.Text("Per Head Training Expense")).BodyTemplateId("perheadtr").ColSpan(3).RowSpan(2);
            c.Add().Header(h => h.Text("Training Employee Count")).BodyTemplateId("empcount").ColSpan(3).RowSpan(2);
            c.Add().Header(h => h.Text("Training Count")).BodyTemplateId("trcount").ColSpan(3).RowSpan(2);

        })
        .Reorderable(true)
        .Resizable(true)
        .Events(e => e.Resize("onTileResize"))
    )