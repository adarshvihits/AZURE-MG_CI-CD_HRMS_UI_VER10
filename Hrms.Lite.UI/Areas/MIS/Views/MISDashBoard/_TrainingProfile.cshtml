@model Hrms.Lite.Shared.MIS.MISDashBoard
@*@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}*@
@using Kendo.Mvc.UI

<script>
function onSeriesYearlyCostHover(e) {
        $("#yearlyTr").css("cursor", "pointer");
    }
    function onSeriesphtrHover(e) {
        $("#perHeadTr").css("cursor", "pointer");
    }
    function onSeriesEmpCountHover(e) {
        $("#empCount").css("cursor", "pointer");
    }
    function onSeriesTrCountHover(e) {
        $("#trCount").css("cursor", "pointer");
    }
    function onSeriesTrCountClick(e) {
        var financialYr = $("#finYear").val();
        //var code = $("#Code").val();
        $.ajax({

            type: 'GET',
            url: '/MIS/MISDashBoard/ReloadDiv',
            dataType: 'html',
            data: { id: 131, code: e.dataItem.code },

            success: function (result) {
                window.location.href = '/MIS/MISDashBoard?id=131&financialYr=' + financialYr + '&name=' + e.dataItem.fullname + '&code=' + e.dataItem.code;
            },
            error: function (xhr, textStatus, errorThrown) {
                debugger
                document.body.id = "kt_body";
                $('body').html(xhr.responseText);
            }
        });

    }
    function onSeriesYearlyCostClick(e) {
       // var financialYr = $("#finYear").val();
        //var code = $("#Code").val();
        $.ajax({

            type: 'GET',
            url: '/MIS/MISDashBoard/ReloadDiv',
            dataType: 'html',
            data: { id: 132, code: e.dataItem.code },

            success: function (result) {
                window.location.href = '/MIS/MISDashBoard?id=132&name=' + e.dataItem.name + '&code=' + e.dataItem.code;
            },
            error: function (xhr, textStatus, errorThrown) {
                debugger
                document.body.id = "kt_body";
                $('body').html(xhr.responseText);
            }
        });

    }
    function sortData(e) {

        var chart = $("#histJoinersMonth").data("kendoChart");

        var axis = e.sender.options.categoryAxis;

        var months = ["January", "February", "March", "April", "May", "June",
            "July", "August", "September", "October", "November", "December"];

        if (axis.categories != undefined) {
            axiscategories = axis.categories.sort((a, b) => months.indexOf(a) - months.indexOf(b));
        }
    }
</script>

<script id="yearlytr" type="text/x-kendo-template">
    @(
        Html.Kendo().Chart<Hrms.Lite.Shared.MIS.YearlyTrainingCost>()
                                                            .Name("yearlyTr")
                                                        .Title("")
                                                           .Events(e => e.SeriesHover("onSeriesYearlyCostHover")
                                                           .SeriesClick("onSeriesYearlyCostClick")
                                                           )
                                                        .Legend(legend => legend
                                                            .Position(ChartLegendPosition.Top)
                                                        )
                                                                            .DataSource(ds => ds.Read(read => read.Action("GetYearlyTrainingCost", "MISDashBoard").Data("getTrainingVal")))
                                                        .Series(series =>
                                                        {
                                                            //series.Line(model => model.count).Name("Transition Count").CategoryField("department").Color("\\#6cf57e");
                                                                series.Column(model => model.trainingexpense).Name("Yearly Training Cost").CategoryField("name").Color("\\#89CFF0").Spacing(0)
                                                                         .Tooltip(tooltip => tooltip.
                                                                                         Template("(\\#= (dataItem.name)\\# - \\#= (dataItem.trainingexpense)\\# )").Visible(true));
                                                                series.Column(model => model.allotedamount).Name("Yearly Alloted Cost").CategoryField("name").Color("\\#f5a6d3").Spacing(0)
                                                                             .Tooltip(tooltip => tooltip.
                                                                                             Template("(\\#= (dataItem.name)\\# - \\#= (dataItem.allotedamount)\\# )").Visible(true));
                                                    })
                                                    .ChartArea(ch => ch.Width(550).Height(250))
                                                    .CategoryAxis(axis => axis
                                                        .Labels(labels => labels.Rotation(0))
                                                        .Crosshair(c => c.Visible(true))
                                                    )
                                                    .ValueAxis(axis => axis.Numeric()
                                                        .Labels(labels => labels.Format("{0:N0}"))

                                                    )
                                                    .Tooltip(tooltip => tooltip
                                                        .Visible(true)
                                                        .Shared(true)
                                                        .Format("{0:N0}")
                                                    )

                                                    .ToClientTemplate()
                            )
</script>

