    function onSeriesAgeOver(e) {
        $("#hrByAg").css("cursor", "pointer");
    }
    function onSeriesAgeClick(e) {
        var groupCom = $("#GroupCompanyCode").val();
        var age = e.category
        if (age == '60+') {
            age = '60-100';
        }
        else {
            age = age.replace(' Year', '');
        }
        $.ajax({
            type: 'GET',
            url: '/MIS/MISDashBoard/ReloadDiv',
            dataType: 'html',
            data: { id: 36, type: 'AGE', age: age },
            success: function (result) {
                window.location.href = '/MIS/MISDashBoard?id=36&groupCom=' + groupCom + '&type=AGE&name=Age&age=' + e.category;
            },
