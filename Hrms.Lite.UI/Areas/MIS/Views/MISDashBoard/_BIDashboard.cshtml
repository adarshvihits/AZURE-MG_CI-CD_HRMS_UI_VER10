<script>
    function onSeriesDptOver(e) {
        $("#hrByDept").css("cursor", "pointer");
    }
    function onSeriesDptClick(e) {
        var groupCom = $("#GroupCompanyCode").val();
        $.ajax({
            type: 'GET',
            url: '/MIS/MISDashBoard/ReloadDiv',
            dataType: 'html',
            data: { id: 37, type: 'Department', age: e.dataItem.code },

            success: function (result) {


                window.location.href = '/MIS/MISDashBoard?id=37&groupCom=' + groupCom + '&type=Department&name=' + e.dataItem.department + '&age=' + e.dataItem.code;


            },
            error: function (xhr, textStatus, errorThrown) {
                debugger
                document.body.id = "kt_body";
                $('body').html(xhr.responseText);


            }
        });

    }
</script>



<script>
    function view(divId) {
        var url = '@Url.Action("Index", "MISDashBoard", new { area = "MIS" })';
        url += '?id='+divId;
        window.location.href = url;
    }
</script>

<script>
    function onEmpClick() {
        var groupCom = $("#GroupCompanyCode").val();
        $.ajax({
            type: 'GET',
            url: '/MIS/MISDashBoard/ReloadDiv',
            dataType: 'html',
            data: { id: 35, type: 'ActiveEmployees', name: 'ActiveEmployees' },
            success: function (result) {
                window.location.href = '/MIS/MISDashBoard?id=35&groupCom=' + groupCom + '&type=ActiveEmployees&name=ActiveEmployees&age=0';
            },
            error: function (xhr, textStatus, errorThrown) {
