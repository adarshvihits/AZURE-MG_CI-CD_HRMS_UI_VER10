        <script id="salaryAlw" type="text/x-kendo-template">
            @(
                                Html.Kendo().Chart<Hrms.Lite.Shared.MIS.AllowanceOverView>()
                                                                                          .Name("salAlw")
                                                                                          .Title("")
                                                                                          .Events(e=>e.SeriesClick("onAlwClick").SeriesHover("onAlwHover"))
                                                                                          

                                                                  .Legend(legend => legend

                                                                      .Position(ChartLegendPosition.Bottom).Labels(x => x.Font("9px Arial,Helvetica,sans-serif"))
                                                  .Orientation(ChartLegendOrientation.Horizontal)
                                                  .Labels(x => x.Font("15px Arial,Helvetica,sans-serif"))

                                                                          )
                                                                          .DataSource(ds =>
                                                                          {
                                                                              ds.Read(read => read.Action("GetPRAllowance", "MISDashBoard").Data("getSalPeriod"));


                                                                          }
                                                                          )
                                                                          .Series(series => series

                                                                          .Pie(model => model.total, model => model.allowance)

                                                                          .Labels(labels => labels.
                                                                                  Template("\\#= dataItem.shrtName \\# - \\#= dataItem.total \\#")
                                                                          .Position(ChartSeriesLabelsPosition.OutsideEnd)

                                                                          .Background("transparent")

                                                                          .Visible(true)
                                                                          )


                                                                  )//.SeriesColors("\\#166f99", "\\#2185b4", "\\#8d4194", "\\#75744d", "\\#f76d31")
                                                                 .HtmlAttributes(new { style = "height:100%;width:100%;" })

                                                                 .Tooltip(tooltip => tooltip.Template("\\#= dataItem.allowance \\# - \\#= dataItem.total \\#").Visible(true))





                                                                              .ToClientTemplate()

                                                                          )



        </script>

