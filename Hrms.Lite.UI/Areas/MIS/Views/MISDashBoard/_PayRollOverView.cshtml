        <script id="allowanceComparison" type="text/x-kendo-template">
            @(
                                Html.Kendo().Chart<Hrms.Lite.Shared.MIS.AllowanceMonthComparisonList>()
                                                    .Name("alwComp")
                                                .Title("")

                                                .Legend(legend => legend
                                                    .Position(ChartLegendPosition.Bottom).Labels(x => x.Font("9px Arial,Helvetica,sans-serif"))
                                                  .Orientation(ChartLegendOrientation.Horizontal)
                                                  .Labels(x => x.Font("15px Arial,Helvetica,sans-serif"))
                                                )
                                                                        .DataSource(ds => ds.Read(read => read.Action("GetAllowanceMonthComparison", "MISDashBoard").Data("getSalPeriod")))
                                                .Series(series =>
                                                {
                                                        series.Line(model => model.currMonth).Name("Month").CategoryField("shrtName").Color("\\#ee6055").Width(5);
                                                        series.Line(model => model.prvMonth).Name("Previous Month").CategoryField("shrtName").Color("\\#662e9b").Width(5);

                                                })

                                                   

                                                .ChartArea(ch => ch.Width(850).Height(250))
                                                .CategoryAxis(axis => axis
                                                    .Labels(labels => labels.Rotation(30))
                                                    .Crosshair(c => c.Visible(true))
                                                )
                                                .ValueAxis(axis => axis.Numeric()
                                                    .Labels(labels => labels.Format("{0:N0}"))
                                                  //  .MajorUnit(20000)
                                                )
                                                .Tooltip(tooltip => tooltip
                                                    .Visible(true)
                                                    .Shared(true)
                                                    .Format("{0:N0}")
                                                )

                                                .ToClientTemplate()
                        )
        </script>

