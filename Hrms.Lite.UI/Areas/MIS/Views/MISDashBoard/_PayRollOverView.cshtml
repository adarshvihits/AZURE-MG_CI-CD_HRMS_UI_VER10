<script>

    $(document).ready(function () {

        const spr = setTimeout(hideSpinner, 1000)
    });
    function onEmpClick() {
        var currntLp = $("#CurrentSalaryPeriodCode").val();
        var gc = $("#GroupCompanyCode").val();

        $.ajax({

            type: 'GET',
            url: '/MIS/MISDashBoard/ReloadDiv',
            dataType: 'html',
            data: { id: 80, month: currntLp, groupCom: gc },

            success: function (result) {

                window.location.href = '/MIS/MISDashBoard?id=80&month=' + currntLp ;



            },
            error: function (xhr, textStatus, errorThrown) {
                debugger
                document.body.id = "kt_body";
                $('body').html(xhr.responseText);


            }
        });
    }

    function onAlwClick(e) {
        var currntLp = $("#CurrentSalaryPeriodCode").val();
        var gc = $("#GroupCompanyCode").val();

        $.ajax({

            type: 'GET',
            url: '/MIS/MISDashBoard/ReloadDiv',
            dataType: 'html',
            data: { id: 81, month: currntLp, groupCom: gc },

            success: function (result) {

                window.location.href = '/MIS/MISDashBoard?id=81&month=' + currntLp+"&type=Allowance";



            },
            error: function (xhr, textStatus, errorThrown) {
                debugger
                document.body.id = "kt_body";
                $('body').html(xhr.responseText);


            }
        });
    }

    function onAlwHover(e) {
        $("#salAlw").css("cursor", "pointer");
    }

    function onDedClick(e) {
        var currntLp = $("#CurrentSalaryPeriodCode").val();
        var gc = $("#GroupCompanyCode").val();

        $.ajax({

            type: 'GET',
            url: '/MIS/MISDashBoard/ReloadDiv',
            dataType: 'html',
            data: { id: 81, month: currntLp, groupCom: gc },

            success: function (result) {

                window.location.href = '/MIS/MISDashBoard?id=81&month=' + currntLp + "&type=Deduction";



            },
            error: function (xhr, textStatus, errorThrown) {
                debugger
                document.body.id = "kt_body";
                $('body').html(xhr.responseText);


            }
        });
    }

    function onDedHover(e) {
        $("#salDed").css("cursor", "pointer");
    }

</script>


