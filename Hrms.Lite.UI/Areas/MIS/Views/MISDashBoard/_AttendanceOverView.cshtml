        <div class="row">
            <div class="col-md-12">
                <div style="margin-bottom:10px;">
                    <input type="hidden" id="hdnDay" value="1" />
                    <script id="Eo" type="text/x-kendo-template">
            <div id="earlyOut" style="color: \\#fff ; height:100%;display:flex; align-items:center;justify-content:center;font-size:3rem; font-weight:700;">@Model.earlyOut </div>
                    </script>

                    <script id="Li" type="text/x-kendo-template">
            <div id="lateIn" style="color: \\#fff;height:100%;display:flex; align-items:center;justify-content:center;font-size:3rem; font-weight:700;">@Model.lateIn </div>

                    </script>
                    <script id="Ovt" type="text/x-kendo-template">
            <div id="ot" style="color: \\#fff;height:100%;display:flex; align-items:center;justify-content:center;font-size:3rem; font-weight:700;">@Model.ot </div>

                    </script>
                    <script id="toth" type="text/x-kendo-template">
            <div id="th" style="color: \\#fff;height:100%;display:flex; align-items:center;justify-content:center;font-size:3rem; font-weight:700;">@Model.th </div>

                    </script>
                </div>
        <script id="attMonths" type="text/x-kendo-template">
            @(
                                        Html.Kendo().Chart<Hrms.Lite.Shared.MIS.AttendanceDayWise>()
                                                            .Name("monthAtt")
                                                            .Title("")
                                                            // .Events(e => e.DataBound("sortData"))
                                                            .Events(e=>e.SeriesClick("axisClick")
                                                            .PlotAreaClick("plotClick"))
                                                            .Legend(legend => legend
                                                               .Position(ChartLegendPosition.Bottom).Labels(x => x.Font("9px Arial,Helvetica,sans-serif"))
                                                  .Orientation(ChartLegendOrientation.Horizontal)
                                                  .Labels(x => x.Font("15px Arial,Helvetica,sans-serif"))
                                                            )
                                                                                .DataSource(ds => ds.Read(read => read.Action("GetAttendanceDayWise", "MISDashBoard").Data("getSalPeriod")))
                                                            .Series(series =>
                                                            {
                                                                series.Line(model => model.hours).Name("Hours").CategoryField("day").Color("\\#ff6700").Width(5);


                                                            })
                                                            .ChartArea(ch => ch.Width(850).Height(350))
                                                            .CategoryAxis(axis => axis
                                                                .Labels(labels => labels.Rotation(0))
                                                                .Crosshair(c => c.Visible(true))
                                                            )
                                                            .ValueAxis(axis => axis.Numeric()
                                                                .Labels(labels => labels.Format("{0:N0}"))
                                                            //.MajorUnit(1000)
                                                            )
                                                            .Tooltip(tooltip => tooltip
                                                                .Visible(true)
                                                                .Shared(true)
                                                                
                                                                .Format("{0:N0}")
                                                            )

                                                            .ToClientTemplate()
                                    )
        </script>

        <script id="catagory" type="text/x-kendo-template">
            @(Html.Kendo().Chart<Hrms.Lite.Shared.MIS.AttendanceDateWise>()
                                                                  .Name("attDate")
                                                                  .Events(e=>e.SeriesClick("onSeriesClick")
                                                                  .SeriesHover("onSeriesHover"))
                                                              .Title("")
                                                              .Events(e=>e.Render("onRender"))
                                                              .Legend(legend => legend

                                                              .Position(ChartLegendPosition.Bottom).Labels(x => x.Font("9px Arial,Helvetica,sans-serif"))
                                                  .Orientation(ChartLegendOrientation.Horizontal)
                                                  .Labels(x => x.Font("15px Arial,Helvetica,sans-serif"))

                                                              .Visible(true)
                                                              )
                                                              .ChartArea(chart => chart
                                                              .Background("transparent")


                                                              )
                                                              .DataSource(ds =>
                                                              {
                                                                      ds.Read(read => read.Action("GetAttendanceDateWise", "MISDashBoard").Data("getParamForAtt"));

                                                              }
                                                              )
                                                              .Series(series => series

                                                              .Donut(model => model.total, model => model.category).HoleSize(40).Size(40)
                                                                  .ColorField("color")
                                                              .Labels(labels => labels
                                                              .Template("\\#= dataItem.category \\# - \\#= dataItem.total \\#").Visible(true)
                                                              .Position(ChartSeriesLabelsPosition.OutsideEnd)

                                                              .Background("transparent")

                                                              .Visible(true)
                                                              )
                               .Tooltip(tooltip => tooltip.Template("\\#= dataItem.category \\# - \\#= dataItem.total \\# ").Visible(true))


                                                                  )

                                                                   .HtmlAttributes(new { style = "height:100%;width:100%;" })


                                                                  .ToClientTemplate()
                                                              )



        </script>
            </div>
        </div>
        <div id="monthsDiv" class="s_slip_container">


            @await Html.PartialAsync("~/Areas/MIS/Views/MISDashBoard/_Months.cshtml", Model)

        



        </div>




