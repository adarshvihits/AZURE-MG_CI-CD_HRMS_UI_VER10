@model Hrms.Lite.Shared.MIS.MISDashBoard
@using Kendo.Mvc.UI

<script>
    $(document).ready(function () {

        const spr = setTimeout(hideSpinner, 1000)
    });
    flag=0;
    function sortData(e) {

        var chart = $("#histJoinersMonth").data("kendoChart");

        var axis = e.sender.options.categoryAxis;

        var months = ["January", "February", "March", "April", "May", "June",
            "July", "August", "September", "October", "November", "December"];

        if (axis.categories != undefined) {
            axiscategories = axis.categories.sort((a, b) => months.indexOf(a) - months.indexOf(b));
        }
    }
    function onRender(e) {
        if(flag==0)
        {
        $("#attDate").parent().parent().find(".k-card-title").html("1" + " " + $("#monthTab").find("p").text())
        flag=1;
        }
        else
        {
            ;
        }
    }
    function plotClick(e) {
        var currntLp = $("#CurrentSalaryPeriodCode").val();
        var gc = $("#GroupCompanyCode").val();
        $("#hdnMonth").val(currntLp);
        $("#hdnList").val(e.category);
        $("#hdnDay").val(e.category);
        var attDate = $("#attDate").data("kendoChart");
        attDate.dataSource.read();
        $("#attDate").parent().parent().find(".k-card-title").html(e.category + " " + $(".box_months.active").find("p").text())
    }
    function axisClick(e)
    {
              

    }
    function onSeriesHover(e) {
        $("#attDate").css("cursor", "pointer");
    }
    function onSeriesClick(e) {
     var month=   $("#hdnMonth").val();
      var day=  $("#hdnList").val();
        $.ajax({

            type: 'GET',
            url: '/MIS/MISDashBoard/ReloadDiv',
            dataType: 'html',
            data: { id: 60, type: 'Month',month: month,day:day },

            success: function (result) {
                

                window.location.href = '/MIS/MISDashBoard?id=60&type=att&name=' + e.dataItem.punchingDate + '&month=' + month +'&day='+day;


            },
            error: function (xhr, textStatus, errorThrown) {
                debugger
                document.body.id = "kt_body";
                $('body').html(xhr.responseText);


            }
        });

    }

    $(document).ready(function () {
        
        var currntLp = $("#CurrentSalaryPeriodCode").val();
        $("#hdnMonth").val(currntLp);
      
    });

</script>

