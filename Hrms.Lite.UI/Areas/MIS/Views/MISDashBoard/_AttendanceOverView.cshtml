@(Html.Kendo().TileLayout()
        .Name("tilelayout1")
        .Columns(12)
        .RowsHeight("100px")
        .ColumnsWidth("250px")

        .Containers(c =>
        {
            c.Add().Header(h => h.Text("Early out")).BodyTemplateId("Eo").ColSpan(3).RowSpan(1);
            c.Add().Header(h => h.Text("Late in")).BodyTemplateId("Li").ColSpan(3).RowSpan(1);
            c.Add().Header(h => h.Text("Over Time")).BodyTemplateId("Ovt").ColSpan(3).RowSpan(1);
            c.Add().Header(h => h.Text("Total hrs")).BodyTemplateId("toth").ColSpan(3).RowSpan(1);

           

        })
        .Reorderable(true)
        .Resizable(true)
        .Events(e => e.Resize("onTileResize"))
    )



@(Html.Kendo().TileLayout()
        .Name("tilelayout")
        .Columns(12)
        .RowsHeight("150px")
        .ColumnsWidth("250px")

        .Containers(c =>
        {
          
          
            c.Add().Header(h => h.Text("Total Working Hours")).BodyTemplateId("attMonths").ColSpan(6).RowSpan(3);
            c.Add().Header(h => h.Text("Leaves By Catagory")).BodyTemplateId("catagory").ColSpan(6).RowSpan(3);

        })
        .Reorderable(true)
        .Resizable(true)
        .Events(e => e.Resize("onTileResize"))
    )