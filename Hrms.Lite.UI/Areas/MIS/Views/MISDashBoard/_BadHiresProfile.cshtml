@using Kendo.Mvc.UI


<script>
    function onPlotAreaOver(e) {
        $("#bhMonth").css("cursor", "pointer");
    }
    function onPlotAreaClick(e) {
        var groupCom = $("#GroupCompanyCode").val();
        var financialYr = $("#finYear").val();
        $.ajax({

            type: 'GET',
            url: '/MIS/MISDashBoard/ReloadDiv',
            dataType: 'html',
            data: { id: 129, type: 'Month', code: 0 },

            success: function (result) {
                window.location.href = '/MIS/MISDashBoard?id=129&groupCom=' + groupCom + '&financialYr=' + financialYr + '&type=Month&name=Month&code=0';
            },
            error: function (xhr, textStatus, errorThrown) {
                debugger
                document.body.id = "kt_body";
                $('body').html(xhr.responseText);
            }
        });

    }
