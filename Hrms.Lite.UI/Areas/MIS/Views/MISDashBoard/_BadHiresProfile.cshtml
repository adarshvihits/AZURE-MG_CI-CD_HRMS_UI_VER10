<script id="bhmonth" type="text/x-kendo-template">
    @(
                        Html.Kendo().Chart<Hrms.Lite.Shared.MIS.BadHiresMonth>()
                                                .Name("bhMonth")
                                            .Title("")
                                                        .Events(e => e.DataBound("sortData").PlotAreaHover("onPlotAreaOver")
                 .PlotAreaClick("onPlotAreaClick")
                                                        )
                                            .Legend(legend => legend
                                                .Position(ChartLegendPosition.Top)
                                            )
                                                        .DataSource(ds => ds.Read(read => read.Action("GetBadHiresMonth", "MISDashBoard").Data("getValBH")))
                                            .Series(series =>
                                            {
                                                series.Line(model => model.count).Name("Bad Hires").CategoryField("month").Color("\\#6cf57e");


                                            })
                                            .ChartArea(ch => ch.Width(750).Height(250))
                                            .CategoryAxis(axis => axis
                                                .Labels(labels => labels.Rotation(0))
                                                .Crosshair(c => c.Visible(true))
                                            )
                                            .ValueAxis(axis => axis.Numeric()
                                                .Labels(labels => labels.Format("{0:N0}"))

                                            )
                                            .Tooltip(tooltip => tooltip
                                                .Visible(true)
                                                .Shared(true)
                                                .Format("{0:N0}")
                                            )

                                            .ToClientTemplate()
                    )
</script>

<script id="bhgender" type="text/x-kendo-template">
    @(
            Html.Kendo().Chart<Hrms.Lite.Shared.MIS.BadHiresGender>()
                                                                  .Name("bhGender")
                                                                  .Title("")
                                                                  .Events(e => e.SeriesClick("onGenderSeriesClick")
                                                                  .SeriesHover("onGenderSeriesHover"))
                                                                  .Legend(legend => legend

                                                                  .Position(ChartLegendPosition.Right)
                                                                  .Orientation(ChartLegendOrientation.Vertical)
                                                                  .Visible(true)
                                                                  )
                                                                  .ChartArea(chart => chart
                                                                  .Background("transparent")
                                                                  )
                                                                  .DataSource(ds =>
                                                                  {
                                                                      ds.Read(read => read.Action("GetBadHiresGender", "MISDashBoard").Data("getValBH"));
                                                                  }
                                                                  )
                                                                  .Series(series => series

                                                                      .Donut(model => model.count, model => model.gender).HoleSize(40).Size(40)

                                                                  .Labels(labels => labels
                                                                  .Template("\\#= dataItem.gender \\# - \\#= dataItem.count \\#").Visible(true)
                                                                  //.Template("\\#= (dataItem.gender) \\# - \\#= (dataItem.count)#\\")
                                                                  .Position(ChartSeriesLabelsPosition.OutsideEnd)
                                                                  .Background("transparent")
                                                                  .Visible(true)
                                                                  )
                                                                  )
                                                       .HtmlAttributes(new { style = "height:100%;width:100%;" })
                                                       .SeriesColors("\\#166f99", "\\#2185b4")

                                                      .ToClientTemplate()
                                                  )
</script>

<script id="bhage" type="text/x-kendo-template">
    @(
                Html.Kendo().Chart<Hrms.Lite.Shared.MIS.BadHiresAge>()

