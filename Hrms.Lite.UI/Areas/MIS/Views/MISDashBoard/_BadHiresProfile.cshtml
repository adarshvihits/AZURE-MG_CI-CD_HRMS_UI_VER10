@(Html.Kendo().TileLayout()
        .Name("tilelayout")
        .Columns(6)
        .RowsHeight("150px")
        .ColumnsWidth("250px")

        .Containers(c =>
        {
            c.Add().Header(h => h.Text("Bad Hires Month Wise")).BodyTemplateId("bhmonth").ColSpan(4).RowSpan(2);
            c.Add().Header(h => h.Text("Bad Hires Gender Wise")).BodyTemplateId("bhgender").ColSpan(2).RowSpan(2);
            c.Add().Header(h => h.Text("Bad Hires Age Wise")).BodyTemplateId("bhage").ColSpan(3).RowSpan(2);
            c.Add().Header(h => h.Text("Bad Hires Department Wise")).BodyTemplateId("bhdepartment").ColSpan(3).RowSpan(2);
            c.Add().Header(h => h.Text("Bad Hires Location Wise")).BodyTemplateId("bhlocation").ColSpan(3).RowSpan(2);
            c.Add().Header(h => h.Text("Bad Hires Division Wise")).BodyTemplateId("bhdivision").ColSpan(3).RowSpan(2);
            c.Add().Header(h => h.Text("Bad Hires Category Wise")).BodyTemplateId("bhcategory").ColSpan(3).RowSpan(2);
            c.Add().Header(h => h.Text("Bad Hires Grade Wise")).BodyTemplateId("bhgrade").ColSpan(3).RowSpan(2);
            c.Add().Header(h => h.Text("Bad Hires Region Wise")).BodyTemplateId("bhregion").ColSpan(3).RowSpan(2);

        })
        .Reorderable(true)
        .Resizable(true)
        .Events(e => e.Resize("onTileResize"))
    )