@(Html.Kendo().TileLayout()
        .Name("tilelayout")
        .Columns(12)
        .RowsHeight("100px")
        .ColumnsWidth("200px")

        .Containers(c =>
        {
          
            c.Add().Header(h => h.Text("New Hires Trend Gender wise")).BodyTemplateId("hisJoiners").ColSpan(4).RowSpan(3);
            c.Add().Header(h => h.Text("Resignations Trend")).BodyTemplateId("hisTerminations").ColSpan(4).RowSpan(3);
             c.Add().Header(h => h.Text("Bad Hires Trend")).BodyTemplateId("hisBadHires").ColSpan(4).RowSpan(3);

           c.Add().Header(h => h.Text("New Hires Trend ")).BodyTemplateId("hisJoinersMonth").ColSpan(6).RowSpan(3);
            c.Add().Header(h => h.Text("Resignations Trend ")).BodyTemplateId("hisTerminationsMonth").ColSpan(6).RowSpan(3);
            c.Add().Header(h => h.Text("WFH Trend ")).BodyTemplateId("hisWFH").ColSpan(6).RowSpan(3);
            c.Add().Header(h => h.Text("LOP Trend ")).BodyTemplateId("hisLOP").ColSpan(6).RowSpan(3);
            c.Add().Header(h => h.Text("Salary Trend ")).BodyTemplateId("hisSalary").ColSpan(6).RowSpan(3);
            c.Add().Header(h => h.Text("Salary Increment Trend ")).BodyTemplateId("hisSalaryInc").ColSpan(6).RowSpan(3);
           

        })
        .Reorderable(true)
        .Resizable(true)
        .Events(e => e.Resize("onTileResize"))
    )

