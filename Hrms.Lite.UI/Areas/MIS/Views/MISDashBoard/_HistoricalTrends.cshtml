    <script>
           // Create a new drawing group
    var group = new kendo.drawing.Group();

    // Create the head as a circle
    var head = new kendo.drawing.Circle(new kendo.geometry.Circle([50, 50], 30), {
        fill: { color: "#009bd7" }
    });
    group.append(head);

    // Create the body as a rectangle
    var body = new kendo.drawing.Rect(new kendo.geometry.Rect([40, 80], [20, 40]), {
        fill: { color: "#009bd7" }
    });
    group.append(body);



    // Create the arms as rectangles
    var leftArm = new kendo.drawing.Rect(new kendo.geometry.Rect([30, 90], [10, 20]));
    //group.append(leftArm);

    var rightArm = new kendo.drawing.Rect(new kendo.geometry.Rect([60, 90], [10, 20]));
    //group.append(rightArm);

    // Create the legs as rectangles
    //var leftLeg = new kendo.drawing.Rect(new kendo.geometry.Rect([40, 120], [10, 30]));
    var leftLeg = new kendo.drawing.Rect(new kendo.geometry.Rect([40, 120], [10, 30]), {
        fill: { color: "#009bd7" }
    });
    group.append(leftLeg);

    //var rightLeg = new kendo.drawing.Rect(new kendo.geometry.Rect([50, 120], [10, 30]));
    //group.append(rightLeg);

    var rightLeg = new kendo.drawing.Rect(new kendo.geometry.Rect([50, 120], [10, 30]), {
        fill: { color: "#009bd7" }
    });
    group.append(rightLeg);


    // Draw the group on the surface
    var surface = kendo.drawing.Surface.create($("#surface"));
    surface.draw(group);

</script>





