<script id="leavemonths" type="text/x-kendo-template">
    @(
                        Html.Kendo().Chart<Hrms.Lite.Shared.MIS.MonthWiseLeaveTrend>()
                                        .Name("monthLeave")
                                        .Title("").Events(e=>e.PlotAreaClick("LeaveClick"))
                                             .HtmlAttributes(new { style = "width:100%;height:100%;" })
                                        .Legend(legend => legend
                                            .Position(ChartLegendPosition.Top)
                                        )
                                                                .DataSource(ds => ds.Read(read => read.Action("GetEmployeeLeaveTrend", "MISDashBoard").Data("getEmpCode"))
                                                                .Group(g => g.Add(a => a.type)))

                                        .Series(series =>
                                        {
                                            series.Line(model => model.total, categoryExpression: model => model.firstDay).Name("\\#= group.value \\#").CategoryField("firstDay").Width(5);


                                        }).SeriesColors("\\#C40C0C", "\\#874CCC", "\\#8B322C")
                                           .ChartArea(chartArea => chartArea
                                        .Margin(margin => margin.Top(10).Right(5).Left(10).Bottom(0)))
                                        .Events(ev=>ev.DataBound("sortData"))
                                        .CategoryAxis(axis => axis
                                        .BaseUnit(ChartAxisBaseUnit.Months)
                                            .Labels(labels => labels//.Rotation(45)
                                                .DateFormats(dateFormat => dateFormat.Months("MMMM"))

                                            )
                                            .Crosshair(c => c.Visible(true))
                                        )
                                        .ValueAxis(axis => axis.Numeric()
                                            .Labels(labels => labels.Format("{0:N0}"))
                                            .MajorUnit(5)
                                        )
                                            .Tooltip(tooltip => tooltip
                                               .Visible(true)
                                                       .Template("\\#= series.name \\#: \\#= value \\#")
                                           )

                                        .ToClientTemplate()
                )
</script>

