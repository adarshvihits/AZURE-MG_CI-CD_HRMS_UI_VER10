<script id="maps" type="text/x-kendo-template">

    @(
        Html.Kendo().Map()
                                .Name("map")

                                .Center(9.6332, 78.8170)
                                .Zoom(7)
                                .Events(e => e.MarkerCreated("changeIcon"))

                                .Layers(layers =>
                                {
                                    layers.Add()
                            .Type(MapLayerType.Tile)

                            .UrlTemplate("https:\\#= subdomain \\#.tile.openstreetmap.org/\\#= zoom \\#/\\#= x \\#/\\#= y \\#.png")
                           .Subdomains("a", "b", "c")
                            .Attribution("© <a href='https://osm.org/copyright'>OpenStreetMap contributors</a>");
                                    layers.Add()
                                    .Type(MapLayerType.Marker)
                                    //.Shape("customMarker")

                                    .DataSource(dataSource => dataSource
                                          .Read(read => read.Action("GetEmployeeMap", "MISDashBoard"))

                                    )


                               .LocationField("latLng")
                               .TitleField("location")
                               .Tooltip(tooltip =>
                                                                tooltip.Template("<div><div style='width:200px;color:black;  white-space:normal;font-weight:700;'> \\#= marker.dataItem.location \\#  </div><div style='width:200px; color:black; white-space:normal'>Time : \\#=  kendo.toString(marker.dataItem.punchingTime, 'g')  \\# </div><div style='width:200px;color:black; white-space:normal'>Status : \\#= marker.dataItem.punchingStatus \\# </div></div>"))
                               ;
                                }).ToClientTemplate()

)

</script>

