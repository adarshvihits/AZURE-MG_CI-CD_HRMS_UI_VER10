<script>

    $(document).ready(function () {

        const spr = setTimeout(hideSpinner, 1000)
    });




    $(document).ready(function () {

    });

      // var options = map.options;
       // console.log(map);
   // });
    var firstReset = true;
    function changeIcon(e){
        var map = $("#map").getKendoMap();
       // console.log(e.marker.dataItem.punchingStatus);
        if (e.marker.dataItem.punchingStatus == 'In')
        {

            e.marker.options.shape = 'custom-marker';
        }
        else
        {
            e.marker.options.shape = 'marker-out';
        }

        if (firstReset) {

            firstReset = false;
            map.center([e.marker.dataItem.latitude, e.marker.dataItem.longitude]).zoom(13);
        }

        //var map = $("#map").data("kendoMap");
        //map.center([32.7758, -96.7966]).zoom(10);

      // console.log(e.marker.element)
       // console.log(e);
    }


    function sortData(e){
        var axis = e.sender.options.categoryAxis;
       // console.log(axis);
      //  axis.categories = axis.categories.sort();
    }
    function sortGrowthData(e) {
        var axis = e.sender.options.categoryAxis;
       // console.log(axis);
          axis.categories = axis.categories.sort();
    }
    function toggleHandler(e) {
        e.preventDefault();
        var visual = e.visual;
        var transform = null;
        if (e.show) {
            transform = kendo.geometry.transform().scale(1.5, 1.5, visual.rect().center());
        }
        visual.transform(transform);
    }

    function markerVisual(e) {
        var src = '@Url.Content("~/images/icons/rewards.png")';
        var image = new kendo.drawing.Image(src, e.rect);
        return image;
    }

</script>
