@model Hrms.Lite.Shared.MIS.CompanyMIS


<div class="col-md-6">
<div class="ihits-table table-border  mobile-responsive-table employee-profile-report-list company-list  vertical-scroll-205" >
    <table>
        <thead>
            <tr class="table-light">
                <th scope="col">Department</th>
                <th scope="col">Count</th>

        </thead>
        <tbody>
            @if (Model.MISDetailsList != null && Model.MISDetailsList.Count > 0)
            {

                for (int i = 0; i < Model.MISDetailsList.Count; i++)
                {
                    <tr>
                        <td data-label="Designation">
                            @Model.MISDetailsList[i].name

                        </td>
                        <td data-label="Count">@Model.MISDetailsList[i].count</td>

                    </tr>
                }
            }




        </tbody>
    </table>

</div>
</div>
<div class="col-md-6">
    @await Html.PartialAsync("_chart", Model)
    </div>
