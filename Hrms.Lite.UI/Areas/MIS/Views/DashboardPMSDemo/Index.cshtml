  <style>
 body{
    background-color: #C5DCFB;
 }
 .hr-bgbox{
    background-color: #E4EDFE;
    border: 2px solid #052C53;
    border-radius: 50px;
    margin-top: 15px;
 }
.hr-bgbox h2 {
text-align: center;
padding-top: 50px;

}
 .hr-bgbox h2 span{
    color: #22407A;
 }
 .imgleft{
    padding-top: 50%;
 }
 .hr-rightbox {
    padding: 1px 15px 3px 2px;
    border-radius: 50px;
    margin: 10px;
    background-color: #fff;
    color: #000;
    transform: translateY(0);
  transition: 0.4s;
  cursor: pointer;
}

.hr-rightbox:hover{
    transform: translateY(-10px);
}
.hr-icon{
    padding: 8px;
    background: #FCC354;
    margin-right: 4px;

    border-radius: 50%;
}
.hr-icon img{
    width: 25px;
    height: 25px;
}



.hr-rightbox h4{
    font-size: 14px;
    transform: rotateY(0);
    transition: .3s linear;
    line-height: 3;
    padding-left: 10px;
    margin-bottom: 0rem;

}
  </style>




