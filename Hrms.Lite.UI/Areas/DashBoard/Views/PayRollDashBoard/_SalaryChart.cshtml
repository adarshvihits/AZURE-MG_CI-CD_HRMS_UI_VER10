@model IEnumerable<Hrms.Lite.Shared.DashBoard.Graph>
@using Kendo.Mvc.UI;


<div class="demo-section wide">
    @(Html.Kendo().Chart(Model)
        .Name("chart")
        .Title("")
        .Legend(legend => legend
            //.Position(ChartLegendPosition.Bottom)
            .Visible(false)
        )
        .ChartArea(chartArea => chartArea
            .Background("transparent").Height(230).Width(800)
        )
        .SeriesDefaults(seriesDefaults =>
            seriesDefaults.Line().Style(ChartSeriesStyle.Smooth)
        )
        .Series(series => {

            series.Line(model => model.CTC).Name("CTC").CategoryField("SalaryPeriodName").Color("#48C91B");
            series.Line(model => model.NET).Name("Net").CategoryField("SalaryPeriodName").Color("#1C5CF9");
            series.Line(model => model.Gross).Name("Gross").CategoryField("SalaryPeriodName").Color("#FF7A00");

        })
        .CategoryAxis(axis => axis
            //.Categories("2002", "2003", "2004", "2005", "2006", "2007", "2008", "2009", "2010", "2011")
            .MajorGridLines(lines => lines.Visible(false))
        )
        .ValueAxis(axis => axis
            .Numeric().Labels(labels => labels.Format("{0}"))
            .Line(line => line.Visible(false))
            .AxisCrossingValue(-10)
        )
        .Tooltip(tooltip => tooltip
            .Visible(true).Template("<span style='color:black'><b>#= series.name #</b> <br />  Amount : #= value #</span>")
        //.Format("{0}")
        )
    )
</div>