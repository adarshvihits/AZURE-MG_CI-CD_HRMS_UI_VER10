@model Hrms.Lite.Shared.DashBoard.PayRollDashBoardNew
<script src="~/js/settings.js"></script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table vertical-scroll-200 Approval-Tracker-poup-tble ">
    <table id="TrackerTable" class="">
        <thead>
            <tr class="table-light">
                <th scope="col">Particular</th>
                <th scope="col">Count</th>

            </tr>
        </thead>
        <tbody>
            @if (Model.PayrollDashBoardList != null && Model.PayrollDashBoardList.Count > 0)
            {

                for (int i = 0; i < Model.PayrollDashBoardList.Count; i++)
                {
                    <tr>
                        <td data-label="Particular">
                            @if (@Model.PayrollDashBoardList[i].Type == "PT Confirmation")
                            {
                                <a href="@Url.Action("Index", "PTConfirmation", new { Area = "PayRoll" } )">@Model.PayrollDashBoardList[i].Type</a>
                            }
                            else if (@Model.PayrollDashBoardList[i].Type == "Loan Confirmation")
                            {
                                <a href="@Url.Action("Index", "LoanConfirmation", new { Area = "PayRoll" } )">@Model.PayrollDashBoardList[i].Type</a>
                            }
                            else  //TDS
                            {
                                <a href="@Url.Action("Index", "TDSConfirmation", new { Area = "PayRoll" } )">@Model.PayrollDashBoardList[i].Type</a>
                            }
                        </td>
                        
                        <td data-label="Count">
                            @Model.PayrollDashBoardList[i].Count
                        </td>
                                         


                    </tr>


                }
            }




                </tbody>


    </table>

</div>