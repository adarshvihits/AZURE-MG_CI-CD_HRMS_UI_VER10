@model Hrms.Lite.Shared.DashBoard.PayRollDashBoardNew
<script src="~/js/settings.js"></script>

<style>
    .dataTables_scrollBody {
        height: 30vh !important;
    }
</style>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table outstandloanbalance-list   ">

    <table class="common-table">
        <thead>
            <tr class="table-dark ">

                <th scope="col">ID </th>
                <th scope="col">Employee Name</th>
                <th scope="col">
                    Designation
                </th>
                <th scope="col">
                    Department

                </th>
                <th scope="col">
                    Location

                </th>
                <th scope="col">
                    Loan Type

                </th>
                <th scope="col">
                    Loan Balance

                </th>
                <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Remaining Tenure">
                    Rem. Tenure
                </th>
                <th scope="col">
                    Employee Status
                </th>

            </tr>
        </thead>
        <tbody>
            @if (Model.PayrollDashBoardList != null && Model.PayrollDashBoardList.Count > 0)
            {

                for (int i = 0; i < Model.PayrollDashBoardList.Count; i++)
                {
                    <tr>
                        <td data-label="ID ">
                            @Model.PayrollDashBoardList[i].EmployeeID
                        </td>
                        <td data-label="Employee Name">
                            @Model.PayrollDashBoardList[i].FullName
                        </td>
                        <td data-label="Designation">
                            @Model.PayrollDashBoardList[i].Designation
                        </td>
                        <td data-label="Department">
                            @Model.PayrollDashBoardList[i].Department
                        </td>

                        <td data-label="Location">
                            @Model.PayrollDashBoardList[i].Location
                        </td>

                        <td data-label=" Loan Type">
                            @Model.PayrollDashBoardList[i].LoanType
                        </td>
                        <td data-label="Loan Balance">
                            @Model.PayrollDashBoardList[i].LoanBalance
                        </td>
                        <td data-label="Remaining Tenure">
                            @Model.PayrollDashBoardList[i].RemainingTenure
                        </td>
                        <td data-label="Employee Status">
                            @Model.PayrollDashBoardList[i].EmployeeStatus
                        </td>
                    </tr>
                }
            }


            </tbody>
     
            <tr style=" position: sticky; bottom: 0;" class="table-light">


                <td data-label="No of days">

                    Total
                </td>


                <td data-label="No of days">
                </td>

                <td data-label="No of days">
                </td>


                <td data-label="No of days">
                </td>
                <td data-label="No of days">
                </td>
                <td data-label="No of days">
                </td>
                <td data-label="No of days">
                    <strong>
                        <span id="loanBalance">@Model.LoanBalance</span>
                    </strong>
                </td>
                <td data-label="No of days">
                </td>
                <td data-label="No of days">
                </td>




            </tr>

    
    











    </table>
</div>
<!-- <end table></end> -->