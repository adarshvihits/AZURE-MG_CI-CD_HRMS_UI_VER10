@model Hrms.Lite.Shared.DashBoard.PayRollDashBoardNew
    <script src="~/js/settings.js"></script>
    <style>
        .dataTables_scrollBody {
            height: 32vh !important;
        }
    </style>
    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table fandfpendingcount-list ">
        <table class="common-table">
            <thead>
                <tr class="table-dark">

                    <th scope="col">ID </th>
                    <th scope="col">Employee Name</th>

                    <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Last Working Date">
                        LWD
                    </th>
                    <th scope="col">
                        Aging
                    </th>
                    <th scope="col" data-bs-toggle="tooltip" title="" data-bs-original-title="Salary Processing Status">
                        Salary Pro. Status

                    </th>
                    <th scope="col">
                        Held Amount


                    </th>
                    <th scope="col">
                        F&F Status
                    </th>
                </tr>
            </thead>
            <tbody>

                @if (Model.PayrollDashBoardList != null && Model.PayrollDashBoardList.Count > 0)
                {

                    for (int i = 0; i < Model.PayrollDashBoardList.Count; i++)
                    {
                        <tr>
                            <td data-label="ID ">
                                @Model.PayrollDashBoardList[i].EmployeeID
                            </td>
                            <td data-label="Employee Name">
                                <div class="tooltip-outer">
                                    <a class="tooltip-link" style="color: #3F4254;"> @Model.PayrollDashBoardList[i].FullName</a>
                                    <div class="tooltip-hover mt-8">
                                        <div class="profile-header pb-6 mb-2"
                                             style="padding-bottom: 2px !important;  padding-top: 5px !important; background-color: transparent;">
                                            <div class="row">
                                                <div class="col-md-2">
                                                    <div class="image-input image-input-outline image-input-circle  float-right"
                                                         id="kt_image_4"
                                                         style="background-image: url(images/blank.png)">
                                                        <div class="image-input-wrapper">
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-md-10 pl-7">
                                                    <div class="row">

                                                        <div class="flex-grow-1">
                                                            <!--begin::Title-->
                                                            <div class="d-flex justify-content-between flex-wrap align-items-center">
                                                                <div class="d-flex mr-3 header-profile-name pt-4"
                                                                     style="color:black ;">
                                                                    <a href="#" class=""
                                                                       style="color:black ;">
                                                                        Royal
                                                                    </a>
                                                                    <span> ( IHS001 )</span>

                                                                </div>

                                                            </div>

                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="profile-header-overflow"></div>
                                        </div>
                                        <div class="row pl-5">
                                            <div class="col-md-12">
                                                <div class="border-btm-line">
                                                    <b>Designation: </b>Designer
                                                </div>
                                                <div class="border-btm-line">
                                                    <b>Department: </b>Software

                                                </div>
                                                <div class="">
                                                    <b>Location: </b>Kochi

                                                </div>


                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>


                            <td data-label="LWD">
                                @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.PayrollDashBoardList[i].LWD))
                            </td>
                            <td data-label="Aging">
                                @Model.PayrollDashBoardList[i].Aging
                            </td>
                            <td data-label=" Salary Processing Status">
                                @Model.PayrollDashBoardList[i].SalaryProcessingStatus
                            </td>
                            <td data-label="Held Amount">
                                @Model.PayrollDashBoardList[i].HeldAmount
                            </td>

                            <td data-label="F&F Status">
                                @Model.PayrollDashBoardList[i].FnFStatus
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>