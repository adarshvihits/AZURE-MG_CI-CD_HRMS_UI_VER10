@model Hrms.Lite.Shared.DashBoard.PayRollDashBoardNew
<div class="ihits-table table-border hover-color odd-even mobile-responsive new-dash-table  Attedance-Status-new-tble-list vertical-scroll-250">
    <table class="tble-new-color-chng">
        <thead>
            <tr class="table-color-new ">

                <th class="table-radius-new-payroll" scope="col">Type</th>
                <th scope="col">Yes</th>
                <th scope="col">NO</th>
                <th class="table-radius-new-payroll-end" scope="col">Change</th>

            </tr>
        </thead>
        <tbody>

            @if (Model != null && Model.ApplicableCountList != null && Model.ApplicableCountList.Count > 0)
            {
                for (int i = 0; i < Model.ApplicableCountList.Count; i++)
                { 
                    <tr>
                        <td data-label="Name">@Model.ApplicableCountList[i].TYPE</td>
                        <td data-label="Name"><a onclick="GetApplicableCountDetails('@Model.ApplicableCountList[i].TYPE','YES')">@Model.ApplicableCountList[i].YES</a></td>
                        <td data-label="Name"><a onclick="GetApplicableCountDetails('@Model.ApplicableCountList[i].TYPE','NO')">@Model.ApplicableCountList[i].NO</a></td>
                        <td data-label="Name"><a onclick="GetApplicableCountDetails('@Model.ApplicableCountList[i].TYPE','VARIANCE')">@Model.ApplicableCountList[i].CHANGE</a></td>


                    </tr>
                }
            }

