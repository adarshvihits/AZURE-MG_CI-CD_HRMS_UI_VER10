

@model Hrms.Lite.Shared.DashBoard.PayRollDashBoardNew


<script src="~/js/datatables.min.js"></script>
<script src="~/js/settings.js"></script>
<script>

    $(".search-slider-inner").click(function () {
        $(".form-control").toggleClass('field-width-big')
    });

</script>
<style>
    .dataTables_scrollBody {
        height: 25vh !important;
    }

    .ihits-table.table-border table tbody tr td:nth-child(1) {
        padding: 10px 11px !important;
    }

    .modal-body {
        padding: 0px 20px;
    }
</style>

<div class="row tab-style-button">
    <div class="tab-button-wrap align-items-center">








        <div class="tab-items select-option high">
            <div class="sraech-slider">
                <div class="search-slider-inner">
                    <i class="fa fa-search"></i>
                </div>
                <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                       placeholder="ID/Name">
            </div>
            @*<div class="sraech-slider">



                    <div class="search-slider-inner">
                        <i class="fa fa-search" onclick="$('#searchList').focus();"></i>
                    </div>
                    <input id="searchList" type="text" class="form-control form-control-sm"
                           placeholder="ID/Name" onkeyup="EmployeeSearch('PopUp_PayRollDashBoard_Notfn')">
                </div>*@


            <button data-bs-toggle="tooltip" title=""
                    class="btn btn-excel"
                    data-bs-original-title="Export to Excel" onclick="ExportToExcelPopUp()">
                <i class="icon-xl far fa-file-excel"></i>
            </button>

        </div>


    </div>
</div>




<div class="ihits-table table-border hover-color odd-even mobile-responsive-table  p-5">
    @Html.HiddenFor(m => m.PayrollDashBoardList.Count)
    <table id="PopUp_PayRollDashBoard_Notfn" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Designation</th>
                <th scope="col">Department</th>
                <th scope="col">Location</th>

                @if (@ViewBag.type == "Employment PF variance" || @ViewBag.type == "Employer Contribution to EPS variance" || @ViewBag.type == "Employer contribution to EPF variance" || @ViewBag.type == "Employee Maximum Limit variance" || @ViewBag.type == "Employer Maximum Limit variance")
                {
                    <th scope="col">Based on Settings</th>
                    <th scope="col">Current</th>
                    @if (@ViewBag.type == "Employer contribution to EPF variance")
                    {
                        <th scope="col">Age</th>
                    }
                }




            </tr>
        </thead>
        @if (Model.PayrollDashBoardList != null && Model.PayrollDashBoardList.Count > 0)
        {
            for (int i = 0; i < Model.PayrollDashBoardList.Count; i++)
            {
                <tr>
                    <td data-label="id">
                        @Model.PayrollDashBoardList[i].EmployeeID
                    </td>
                    <td data-label="name">
                        @Model.PayrollDashBoardList[i].FullName
                    </td>
                    <td data-label="Designation">
                        @Model.PayrollDashBoardList[i].Designation
                    </td>
                    <td data-label="department">
                        @Model.PayrollDashBoardList[i].Department
                    </td>
                    <td data-label="location">
                        @Model.PayrollDashBoardList[i].Location
                    </td>
                    @if (@ViewBag.type == "Employment PF variance" || @ViewBag.type == "Employer Contribution to EPS variance" || @ViewBag.type == "Employer contribution to EPF variance" || @ViewBag.type == "Employee Maximum Limit variance" || @ViewBag.type == "Employer Maximum Limit variance")
                    {

                        <td data-label="BasedOn Settings">
                            @Model.PayrollDashBoardList[i].OldValue
                        </td>
                        <td data-label="Current">
                            @Model.PayrollDashBoardList[i].CurrentValue
                        </td>
                        @if (@ViewBag.type == "Employer contribution to EPF variance")
                        {
                            <td data-label="Current">
                                @Model.PayrollDashBoardList[i].Age
                            </td>
                        }
                    }


                </tr>


            }
        }


    </table>
</div>
