@model Hrms.Lite.Shared.DashBoard.PayRollDashBoardNew
<script src="~/js/settings.js"></script>
<style>
    .dataTables_scrollBody {
        height: 32vh !important;
    }
</style>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table salaryvarience-list ">
    <table class="common-table">
        <thead>
            <tr class="table-dark">

                <th scope="col">ID </th>
                <th scope="col">Employee Name</th>

                <th scope="col">
                    Designation
                </th>
                <th scope="col">
                    Department
                </th>
                <th scope="col">
                    Location
                </th>
                <th scope="col">
                    Payroll Group
                </th>               
            </tr>
        </thead>
        <tbody>
            @if (Model.PayrollDashBoardList != null && Model.PayrollDashBoardList.Count > 0)
            {

                for (int i = 0; i < Model.PayrollDashBoardList.Count; i++)
                {
                    <tr>
                        <td data-label="ID">@Model.PayrollDashBoardList[i].EmployeeID</td>
                        <td data-label="Employee Name">
                            @Model.PayrollDashBoardList[i].FullName

                        </td>
                        <td data-label="Designation" class=""> @Model.PayrollDashBoardList[i].Designation</td>

                        <td data-label="Department" class="basic-cols"> @Model.PayrollDashBoardList[i].Department</td>
                        <td data-label="Location" class=" basic-cols"> @Model.PayrollDashBoardList[i].Location</td>
                        <td data-label="PayrollGroup" class=" basic-cols">@Model.PayrollDashBoardList[i].PayrollGroup</td>                        




                    </tr>

                }
            }
        </tbody>
    </table>
</div>