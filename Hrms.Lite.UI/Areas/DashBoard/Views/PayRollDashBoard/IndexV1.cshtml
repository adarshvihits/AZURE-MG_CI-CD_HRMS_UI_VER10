                                <div class="card-body d-flex flex-column p-0" style="position: relative;">
                                    <!--begin::Stats-->
                                    <div class="flex-grow-1 card-spacer-x pt-6">

                                        <div class="d-flex">
                                            <span class="approval_icon">
                                                <!--start::Svg Icon-->

                                                <img src="/images/icons/notebook.svg">
                                                <!--end::Svg Icon-->
                                            </span>
                                            <div class="approval_count pr-3">@Model.PendingTask</div>
                                        </div>


                                        <div class="d-flex justify-content-between align-items-center pt-7">
                                            <div class="d-flex align-items-center">

                                                <a href="#" class="text-dark-75 text-hover-primary font-weight-bolder font-size-h3">
                                                    Salary Posting Pending
                                                </a>
                                            </div>
                                            @*<div class="">
                                                    <a href="#">  <img src="/images/icons/card_arrow.svg"></a>

                                                </div>*@
                                        </div>

                                    </div>
                                    <!--end::Stats-->

                                </div>
                                <!--end::Body-->
                            </div>
                            <!--end::Tiles Widget 3-->
                        </div>



                        <!--begin::Tiles Widget 4-->
                        <div class="col-xl-3">
                            <div class="card gutter-b step-item" style="height: 130px" data-bs-toggle="modal" data-target="" onclick="onLabelClick('FandFPending','fandfpendingPopup')">
