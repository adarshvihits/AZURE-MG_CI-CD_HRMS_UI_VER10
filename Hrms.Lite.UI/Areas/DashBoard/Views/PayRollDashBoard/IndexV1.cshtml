                                            <div class="d-flex align-items-center justify-content-between mb-3 bottom_border"  data-bs-toggle="modal" data-target="" onclick="onLabelClick('SalaryVariance','salaryvariencePopup')">



                                                <div class="active_employee_icon">
                                                    <!--start::Svg Icon-->
                                                    <img src="/images/icons/bank_account.svg">
                                                    <a class=" font-weight-bolder font-size-h3">Salary Variance</a>

                                                    <!--end::Svg Icon-->
                                                </div>


                                                <div>
                                                    <span class="text-dark-75 font-weight-bolder font-size-h3">@Model.SalaryVariance</span>
                                                </div>


                                            </div>




