                                                    </span>
                                                    <div class="approval_count pr-3">@Model.SalaryVariance</div>
                                                </div>



                                                <div class="d-flex justify-content-between align-items-center pt-7">
                                                    <div class="d-flex align-items-center">

                                                        <a href="#" class="text-dark-75 text-hover-primary font-weight-bolder font-size-h3">Salary Variance</a>
                                                    </div>
                           
                                                </div>

                                            </div>











                                        </div>
                                      
                                    </div>*@






                                    <div class="card gutter-b">
                                        <!--begin::Body-->
