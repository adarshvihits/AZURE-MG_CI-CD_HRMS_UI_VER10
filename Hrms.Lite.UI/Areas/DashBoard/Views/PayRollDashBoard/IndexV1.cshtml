                                                                <div class="pf_no"></div>
                                                            </div>*@

                                                        <div class="row  pt-3">
                                                            <div class="col-md-3">
                                                                <span class="ml-0 pf_no" @*data-bs-toggle="modal" data-target="" onclick="onPFESIClick('PF Applicability','NO','pfNoPopup')"*@>
