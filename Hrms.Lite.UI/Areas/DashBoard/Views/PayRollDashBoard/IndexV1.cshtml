                                                            </div>
                                                            <div class="col-md-3">
                                                                <span class="pf_no" @*data-bs-toggle="modal" data-target="" onclick="onPFESIClick('PF Applicability','YES','pfYesPopup')"*@>Yes</span>
                                                            </div>
                                                            <div class="col-md-3">
                                                                <span class="pf_no" @*data-bs-toggle="modal" data-target="" onclick="onPFESIClick('PF Applicability','VARIANCE','pfVarPopup')"*@>Var</span>
                                                            </div>
                                                        </div>
