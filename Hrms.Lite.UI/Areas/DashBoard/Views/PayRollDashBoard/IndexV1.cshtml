                                            <div class="icon_left">

                                                <img src="~/images/icons/Loan_balance.svg" />
                                            </div>

                                            <div class="loan_balance">
                                                <a href="#">  @Model.OutstandingLoanBalance </a>
                                            </div>
                                        </div>


                                    </div>
                                    <!--end::Stats-->
                                    <!--end::Body-->
                                </div>

                            </div>






                        </div>
                    </div>
