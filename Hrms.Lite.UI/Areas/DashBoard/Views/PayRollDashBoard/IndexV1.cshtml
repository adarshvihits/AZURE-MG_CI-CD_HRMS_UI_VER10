                                <div class="card-body d-flex flex-column p-0" style="position: relative;">
                                    <!--begin::Stats-->
                                    <div class="flex-grow-1 card-spacer-x pt-6">

                                        <div class="d-flex">
                                            <span class="approval_icon">
                                                <!--start::Svg Icon-->

                                                <img src="/images/icons/onboarding-pending.svg">
                                                <!--end::Svg Icon-->
                                            </span>
                                            <div class="approval_count pr-3">@Model.PayrollConfirmations</div>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center pt-7" 
                                             data-bs-toggle="modal" data-target="" onclick="onLabelClick('PayrollConfirmations','PayrollConfirmationspopup')">
                                            <div class="d-flex align-items-center">

                                                <a class="text-dark-75 text-hover-primary font-weight-bolder font-size-h3"> Payroll Confirmations</a>
                                            </div>


                                        </div>
                                    </div>
                                    <!--end::Stats-->

                                </div>
                                <!--end::Body-->
                            </div>
                        </div>
                        <!--end::Tiles Widget 2-->
                        <div class="col-xl-3">
