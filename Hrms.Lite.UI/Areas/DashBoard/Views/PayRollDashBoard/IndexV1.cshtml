                                                </div>
                                            </div>






                                        </div>
                                        <!--end::Body-->
                                    </div>
                                </div>
                                <!--begin::Tiles Widget 4-->
                                <!--begin::Tiles Widget 4-->
                                <div class="col-xl-6">

                                    <div class="card gutter-b">
                                        <!--begin::Body-->
                                        <div class="card-body active_employee flex-grow-1 card-spacer-x pt-8 cuser-pointer-hand">


                                            <div class="d-flex align-items-center justify-content-between mb-3 bottom_border" data-bs-toggle="modal" data-target="" >



                                                <div class="active_employee_icon">
                                                    <!--start::Svg Icon-->
                                                    <img src="/images/icons/bank_account.svg">
                                                    <a class=" font-weight-bolder font-size-h3">Salary Hold</a>

                                                    <!--end::Svg Icon-->
                                                </div>


                                                <div>
                                                    <span class="text-dark-75 font-weight-bolder font-size-h3">@Model.SalaryVariance</span>
                                                </div>


                                            </div>




                                            <div class="d-flex align-items-center justify-content-between mb-3 cuser-pointer-hand" >


                                                <div class="active_employee_icon">
                                                    <!--start::Svg Icon-->
                                                    <img src="~/images/icons/salary.svg" />

                                                    <a class=" font-weight-bolder font-size-h3">Salary Release</a>
                                                    <!--end::Svg Icon-->
                                                </div>


                                                <div>
                                                    <span class="text-dark-75 font-weight-bolder font-size-h3">2</span>

                                                </div>
                                            </div>






                                        </div>
                                        <!--end::Body-->
                                    </div>
                                </div>
                                <!--begin::Tiles Widget 4-->







                            </div>












                        </div>

                        <!--begin::Tiles salary section -->

                        <div class="col-xl-6">
                            <div class="card gutter-b salary_section" style="height:280px;">

                                <div class="row">

                                    <div class="col-xl-6 border_right">

                                        <div class="flex-grow-1 card-spacer-x pt-6">

                                            <a href="#" class="salary_text">Total Salary <span>YTD</span></a><br />
                                            <div class="d-flex pt-4">
                                                <span class="approval_icon">
                                                    <!--start::Svg Icon-->

                                                    <img src="~/images/icons/total_salary.svg" />
                                                    <!--end::Svg Icon-->
                                                </span>


                                                <div class="total_salary">@Model.TotalSalaryYTD</div>



                                            </div>

                                        </div>

                                    </div>

                                    <div class="col-xl-6">

                                        <div class="flex-grow-1 card-spacer-x pt-6">

                                            <a href="#" class="salary_text">
                                                Average Salary
                                            </a><br />
                                            <div class="d-flex pt-4">
                                                <span class="approval_icon">
                                                    <!--start::Svg Icon-->

                                                    <img src="~/images/icons/average_salary.svg" />
                                                    <!--end::Svg Icon-->
                                                </span>


                                                <div class="total_salary">@Model.AverageSalary</div>

                                            </div>



                                        </div>

                                    </div>
                                </div>



                            </div>




                        </div>
                        <!--begin::Tiles salary section -->
                    </div>



                    <div class="row">

                        <div class="col-xl-12">
                            <div class="card-body d-flex flex-column p-0" style="position: relative;">


                                <div class="card card-body ">


                                    @*<img src="~/images/icons/graph.svg" />*@

                                    @await Html.PartialAsync("_Chart",Model.PayrollDashBoardDiagram)



                                </div>



                            </div>
                        </div>

                    </div>


                </div>
            </div>
        </div>
    </div>
</div>


