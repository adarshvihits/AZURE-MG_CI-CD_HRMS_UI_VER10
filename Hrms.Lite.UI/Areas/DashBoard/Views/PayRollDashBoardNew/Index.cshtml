@model Hrms.Lite.Shared.DashBoard.PayRollDashBoardNew
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/css/DashBoard.css" rel="stylesheet" />
<script src="~/scripts/DashBoard/payRollDashboard.js"></script>
<link href='https://fonts.googleapis.com/css?family=Roboto Slab' rel='stylesheet'>
<style>






















    .payroll-tble-left {
        margin-left: 55px;
    }

    .payroll-tile-left {
        margin-left: 15px;
    }



    .note_cls {
        background-color: #fff;
        height: 100%;
        margin-left: 50px;
    }
</style>



<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Dashboard
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home" , new { Area="" })"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Payroll

                    </li>

                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->


<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->


            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body h-100   " style="padding: 0px !important; overflow-x: hidden;">
                            <div class="databank_line">
                                <h3>Payroll</h3>
                            </div>
                            <div class="row h-100">
                                <div class="col-xl-8 col-lg-7 col-md-6">
                                    <div class="common_left">


                                        @*<div class="border-btm-linetop">
                                            <h1 class="Payroll-head">Payroll</h1>
                                        </div>*@
                                        <div class="row table-padding">

                                            <div class="col-xl-6 col-lg-12">
                                                <div class="slide-padding">
                                                    <div class="row">
                                                        <div class="col-md-6 col-6">
                                                            <a class="step-item" onclick="onLabelClick('FandFPending','fandfpendingPopup')">
                                                                <div class="tile-1">

                                                                    <div style="display:flex; align-items:center; padding-bottom:10px;">
                                                                        <div class="icon-head">
                                                                            <img src="~/images/F & F Pending Count.png" />
                                                                        </div>
                                                                        <h1 class="tile-counts">@Model.FandFPendingCount</h1>
                                                                    </div>

                                                                    <div class="F&F-Pending-Count-head">
                                                                        <h1 class="tile-head">F & F Pending Count </h1>
                                                                    </div>
                                                            </a>
                                                        </div>

                                                    </div>



                                                    <div class="col-md-6 col-6">
                                                        <a class="step-item" onclick="onLabelClick('SalaryVariance','salaryvariencePopup')">
                                                            <div class="tile-1 payroll-tile-left">
                                                                <div style="display:flex; align-items:center; padding-bottom:10px;">
                                                                    <div class="icon-head">
                                                                        <img src="~/images/Salary Variance.png" />
                                                                    </div>
                                                                    <h1 class="tile-counts">@Model.SalaryVariance</h1>
                                                                </div>
                                                                <div class="Salary Variance">
                                                                    <h1 class="tile-head">Salary Variance</h1>
                                                                </div>

                                                            </div>

                                                        </a>

                                                    </div>


                                                </div>


                                                <!-- 2nd-row-start-here-->



                                                <div class="row pt-10 padding_newcls">
                                                    <div class="col-md-6 col-6">
                                                        <a class="step-item" onclick="onLabelClick('OutstandingLoanBalance','outstandloanbalancePopup')">
                                                            <div class="tile-1">
                                                                <div style="display:flex; align-items:center; padding-bottom:10px;">
                                                                    <div class="icon-head">
                                                                        <img src="~/images/Loan Balance (2).png" />
                                                                    </div>

                                                                    <h1 class="tile-counts">@Model.LoanBalance</h1>
                                                                </div>

                                                                <div class="Loan Balance">
                                                                    <h1 class="tile-head">Loan Balance</h1>
                                                                </div>

                                                            </div>
                                                        </a>
                                                    </div>



                                                    <div class="col-md-6 col-6">
                                                        <a class="step-item">
                                                            <div class="tile-1 payroll-tile-left">
                                                                <div style="display:flex; align-items:center; padding-bottom:10px;">
                                                                    <div class="icon-head">
                                                                        <img src="~/images/Ac No Variance.png" />
                                                                    </div>

                                                                    <h1 class="tile-counts">@Model.AccNoVariance</h1>
                                                                </div>

                                                                <div class="A/c No Variance">
                                                                    <h1 class="tile-head">A/c No Variance</h1>
                                                                </div>

                                                            </div>
                                                        </a>


                                                    </div>


                                                </div>

                                                <!-- 2nd-row-end-here-->
                                                <!-- 3nd-row-start-here-->

                                                <div class="row pt-10 padding_newcls">
                                                    <div class="col-md-6 col-6">
                                                        <a class="step-item">
                                                            <div class="tile-1">
                                                                <div style="display:flex; align-items:center; padding-bottom:10px;">
                                                                    <div class="icon-head">
                                                                        <img src="~/images/Salary Hold.png" />
                                                                    </div>
                                                                    <h1 class="tile-counts">@Model.SalaryHold</h1>
                                                                </div>
                                                                <div class="Salary Hold">
                                                                    <h1 class="tile-head">Salary Hold</h1>
                                                                </div>

                                                            </div>
                                                        </a>
                                                    </div>



                                                    <div class="col-md-6 col-6">
                                                        <a class="step-item">
                                                            <div class="tile-1 payroll-tile-left">
                                                                <div style="display:flex; align-items:center; padding-bottom:10px;">
                                                                    <div class="icon-head">
                                                                        <img src="~/images/Salary Hold.png" />
                                                                    </div>
                                                                    <h1 class="tile-counts">00</h1>
                                                                </div>
                                                                <div class="Salary Hold">
                                                                    <h1 class="tile-head">Demo</h1>
                                                                </div>

                                                            </div>

                                                        </a>

                                                    </div>


                                                </div>

                                                <!-- 3nd-row-end-here-->






                                            </div>
                                        </div>



                                        <!-- table-start-here-->

                                        <div class="col-xl-6 col-lg-12 size_bottom">
                                            <div class="payroll-tble-left">
                                                <h1 class="table-heading">PF Applicability  </h1>
                                                <div class="ihits-table table-border hover-color odd-even mobile-responsive new-dash-table  PF-Applicability-tble-list">
                                                    <table>
                                                        <thead>
                                                            <tr class="table-color-new ">


                                                                <th class="table-radius-new" scope="col">YES</th>
                                                                <th scope="col">No</th>
                                                                <th class="table-radius-right" scope="col">Change</th>

                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr>
                                                                <td data-label="Name">
                                                                    <a data-bs-toggle="modal" data-target="" onclick="onPFESIClick('PF Applicability', 'YES', 'pfYesPopup','PF')"> @Model.PFApplicable</a>
                                                                </td>
                                                                <td data-label="Name">
                                                                    <a data-bs-toggle="modal" data-target="" onclick="onPFESIClick('PF Applicability', 'NO', 'pfNoPopup','PF')">@Model.PFNotApplicable</a>
                                                                </td>
                                                                <td data-label="Name">
                                                                    <a data-bs-toggle="modal" data-target="" onclick="onPFESIClick('PF Applicability','VARIANCE','pfVarPopup','PF')">@Model.PFVariance</a>
                                                                </td>

                                                            </tr>




                                                        </tbody>
                                                    </table>
                                                </div>

                                            </div>




                                            <!-- 2ndtable-start-here-->

                                            <div class="payroll-tble-left pt-8">
                                                <h1 class="table-heading">ESI Applicability  </h1>
                                                <div class="ihits-table table-border hover-color odd-even mobile-responsive new-dash-table ESI-Applicability-tble-list-dashboard">
                                                    <table>
                                                        <thead>
                                                            <tr class="table-color-new-2ndtable ">


                                                                <th class="table-radius-new" scope="col">YES</th>
                                                                <th scope="col">No</th>
                                                                <th class="table-radius-right" scope="col">Change</th>

                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr>
                                                                <td data-label="Name">
                                                                    <a data-bs-toggle="modal" data-target="" onclick="onPFESIClick('ESI Applicability','YES','esiYesPopup','ESI')">@Model.ESIApplicable</a>
                                                                </td>
                                                                <td data-label="Name">
                                                                    <a data-bs-toggle="modal" data-target="" onclick="onPFESIClick('ESI Applicability', 'NO', 'esiNoPopup','ESI'); $('.pfOREsi').html('ESI Group')">@Model.ESINotApplicable</a>
                                                                </td>
                                                                <td data-label="Name">
                                                                    <a data-bs-toggle="modal" data-target="" onclick="onPFESIClick('ESI Applicability','VARIANCE','esiVarPopup','ESI')">@Model.ESIVariance</a>
                                                                </td>

                                                            </tr>




                                                        </tbody>
                                                    </table>
                                                </div>





                                            </div>
                                            <!-- 2ndtable-end-here-->



                                        </div>










                                    </div>
                                </div>


                                <div class="row dashboard_footer">
                                    <div class="col-md-3">
                                        <div class="footer_img">
                                            <img src="~/images/icons/footerimg.svg" />
                                        </div>
                                    </div>
                                    <div class="col-md-9 d-flex align-items-center">
                                        <div>Copyright@2023 <span></span>          Technologies Pvt Ltd . ALL right reserved</div>
                                    </div>
                                </div>


                            </div>



                            <div class="col-xl-4 col-lg-5 col-md-6 ">
                                <div class="note_cls">
                                    <div class="notificatiobn_new">


                                        <div class="d-flex">


                                            <div class="right_notification">
                                                <img @*src="~/images/icons/Icon material-notifications-active.svg"*@ class="notification_img" />
                                            </div>
                                            <div class="note_right">Notifications</div>
                                        </div>
                                    </div>
                                    <div class="common_scroll">
                                        @if (Model != null && Model.DashBoardNotificationList.Count > 0)
                                        {
                                            for (int i = 0; i < Model.DashBoardNotificationList.Count; i = i + 2)
                                            {
                                                if (i == 0)
                                                {
                                                    <div class="common-rightcls back_color">
                                                        <div class="row">
                                                            <div class="col-md-10">
                                                                <div class="d-flex align-items-center h-100">
                                                                    <div class="dots back_new">

                                                                    </div>
                                                                    <div class="reg_pending back_white">@Model.DashBoardNotificationList[i].Type</div>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-2">
                                                                <div class="right_code back_new">
                                                                    <div class="white_count">@Model.DashBoardNotificationList[i].count</div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    if (Model.DashBoardNotificationList[i + 1].Type != "")
                                                    {
                                                        <div class="common-rightcls right_blue">
                                                            <div class="row">
                                                                <div class="col-md-10">
                                                                    <div class="d-flex align-items-center h-100">
                                                                        <div class="dots">

                                                                        </div>
                                                                        <div class="reg_pending">@Model.DashBoardNotificationList[i + 1].Type</div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-2">
                                                                    <div class="right_code">
                                                                        <div>@Model.DashBoardNotificationList[i + 1].count</div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                                else
                                                {
                                                    if (Model.DashBoardNotificationList[i].Type != "")
                                                    {
                                                        <div class="common-rightcls ">
                                                            <div class="row">
                                                                <div class="col-md-10">
                                                                    <div class="d-flex align-items-center h-100">
                                                                        <div class="dots">

                                                                        </div>
                                                                        <div class="reg_pending">@Model.DashBoardNotificationList[i].Type</div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-2">
                                                                    <div class="right_code">
                                                                        <div>@Model.DashBoardNotificationList[i].count</div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                    if (Model.DashBoardNotificationList.Count != (i + 1))
                                                    {
                                                        if (Model.DashBoardNotificationList[i + 1].Type != "")
                                                        {
                                                            <div class="common-rightcls right_blue">
                                                                <div class="row">
                                                                    <div class="col-md-10">
                                                                        <div class="d-flex align-items-center h-100">
                                                                            <div class="dots">

                                                                            </div>
                                                                            <div class="reg_pending">@Model.DashBoardNotificationList[i + 1].Type</div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-2">
                                                                        <div class="right_code">
                                                                            <div>@Model.DashBoardNotificationList[i + 1].count</div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                    </div>
                                </div>
                            </div>

                        </div>


                        </div>
                    </div>
                </div>



            </div>
            <!--end::Container-->
        </div>
        <!--end::Entry-->
    </div>
    <!--end::Content-->


    <div class="modal fade payDash_FandFPending" tabindex="-1" aria-labelledby="myLargeModalLabel" aria-hidden="true" style="display: none;">
        <div class="modal-dialog" style="max-width:1030px;">
