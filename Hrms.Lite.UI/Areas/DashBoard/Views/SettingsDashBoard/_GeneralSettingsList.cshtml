@model Hrms.Lite.Shared.DashBoard.SettingsDashBoard
<script src="~/js/settings.js"></script>

<style>
    .count_value {
        color: #48a3d7 !important;
        padding: 6px 7px;
        border-radius: 4px;
        width: 100%;
        text-align: center;
        font-weight: 500 !important;
        font-size:13px !important;
    }
    .settings_values table thead tr th:nth-child(1) {
        margin: 10px 0px;
        border-bottom-left-radius: 10px !important;
        border-top-left-radius: 10px !important;
        background-color: #f2f5f6;
        padding: 16px 12px;
    }

    .settings_values table thead tr th:nth-child(2) {
        margin: 10px 0px;
        border-bottom-right-radius: 10px !important;
        border-top-right-radius: 10px !important;
        background-color: #f2f5f6;
        padding: 16px 12px;
    }
</style>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table settings_values vertical-scroll-350">

    @Html.HiddenFor(m => m.GeneralSettingsList.Count)

    <table id="SettingsDashBoardTable" class="">
        <thead>
            <tr >
                <th scope="col">Company Settings</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.GeneralSettingsList != null && Model.GeneralSettingsList.Count > 0)
                {
                    for (int i = 0; i < Model.GeneralSettingsList.Count; i++)

                    {
                        <tr>
                            <td data-label="Name">@Model.GeneralSettingsList[i].Name </td>
                            <td data-label="Item Count" class="count_value">@Model.GeneralSettingsList[i].ItemCount </td>
                            
                        </tr>
                    }
                }
            }
        </tbody>
    </table>


</div>
