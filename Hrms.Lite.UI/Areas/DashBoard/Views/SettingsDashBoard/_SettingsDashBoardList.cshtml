@model Hrms.Lite.Shared.DashBoard.SettingsDashBoard
<script src="~/js/settings.js"></script>
<style>
    
    .settings_last_update {
        color: #00582d !important;
        background-color: #3cd18826;
        padding: 6px 7px;
        border-radius: 4px;
        width: 100%;
        text-align: center;
        font-weight: 500;
    }
    .settings_item_count table thead tr th:nth-child(1) {
        margin: 10px 0px;
        border-bottom-left-radius: 10px !important;
        border-top-left-radius: 10px !important;
        background-color: #f2f5f6;
        padding: 16px 12px;
    }
    .settings_item_count table thead tr th:nth-child(2) {
        margin: 10px 0px;
      
        background-color: #f2f5f6;
        padding: 16px 12px;
    }
    .settings_item_count table thead tr th:nth-child(3) {
        margin: 10px 0px;
        border-bottom-right-radius: 10px !important;
        border-top-right-radius: 10px !important;
        background-color: #f2f5f6;
        padding: 16px 12px;
    }
    .ihits-table.table-border table thead tr th {
  
    
        color: #000;
    }
    .settings_notification_count {
        color: rgb(240 71 112) !important;
        background-color: rgb(240 71 112 / 15%);
        padding: 6px 7px;
        border-radius: 4px;
        width: 100%;
        text-align: center;
        font-weight: 500;
    }
   
</style>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table settings_item_count vertical-scroll-350">

    @Html.HiddenFor(m => m.SettingsDashBoardList.Count)

    <table id="SettingsDashBoardTable" class="">
        <thead>
            <tr>
                <th scope="col">Classification</th>
                <th scope="col">Last Updated</th>
                <th scope="col">Count</th>

            </tr>
        </thead>
        <tbody>
            @{
                if (Model.SettingsDashBoardList != null && Model.SettingsDashBoardList.Count > 0)
                {
                    for (int i = 0; i < Model.SettingsDashBoardList.Count; i++)

                    {
                        <tr>
                            <td data-label="Name">@Model.SettingsDashBoardList[i].Name </td>
                            <td data-label="Last Updated">
                                <div class=" settings_last_update">
                                    @Model.SettingsDashBoardList[i].LastUpdated

                                    
                                </div>
                            </td>
                            <td data-label="Item Count">
                                <div class="notification_attendance settings_notification_count">
                                    @Model.SettingsDashBoardList[i].ItemCount
                                </div>
                            </td>

                        </tr>
                    }
                }
            }
        </tbody>
  </table>


</div>
