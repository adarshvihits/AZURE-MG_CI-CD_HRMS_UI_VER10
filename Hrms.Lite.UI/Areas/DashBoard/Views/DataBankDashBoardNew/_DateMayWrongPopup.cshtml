@model Hrms.Lite.Shared.DashBoard.DataBankDashBoardNew

<script src="~/js/settings.js"></script>

<style>
    .dataTables_scrollBody {
        height: 30vh !important;
    }

    .dataTables_scrollHeadInner table {
        width: 100% !important;
    }
</style>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table ">
    @Html.HiddenFor(m => m.Notification_PopUp.Count)

    <table class="common-table">
        <thead>
            <tr class="table-dark">

                <th scope="col">ID </th>
                <th scope="col">Employee Name</th>
                <th scope="col">
                    Designation
                </th>
                <th scope="col">
                    Department

                </th>
                <th scope="col">
                    Location

                </th>
                <th scope="col">
                    Type
                </th>
                <th scope="col">
                    Date
                </th>


            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Notification_PopUp != null && Model.Notification_PopUp.Count > 0)
            {
                @for (int i = 0; i < Model.Notification_PopUp.Count; i++)
                {
            <tr>
                <td>@Model.Notification_PopUp[i].ID</td>
                <td>@Model.Notification_PopUp[i].Name</td>
                <td>@Model.Notification_PopUp[i].Designation</td>
                <td>@Model.Notification_PopUp[i].Department</td>
                <td>@Model.Notification_PopUp[i].Location</td>
                <td>@Model.Notification_PopUp[i].Type</td>
                <td>@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.Notification_PopUp[i].Date))</td>
            </tr>
                }
            }
        </tbody>
    </table>
</div>
