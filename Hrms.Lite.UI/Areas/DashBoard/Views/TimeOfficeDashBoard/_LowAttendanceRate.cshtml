@model Hrms.Lite.Shared.DashBoard.LowAttendanceRate
<script src="~/js/settings.js"></script>

<style>
    .dataTables_scrollBody {
        height: 28vh !important;
    }
</style>



<div class="ihits-table table-border hover-color odd-even mobile-responsive-table lowattendance ">
    <table class="common-table">
        <thead>
            <tr class="table-dark">
                @{
                    for (int i = 0; i < Model.Head.Count; i++)
                    {
                        <th scope="col">
                            @Model.Head[i]
                        </th>
                    }

                }
            </tr>
        </thead>
        <tbody>
            @if (Model.Rows != null && Model.Rows.Count > 0)
            {

                for (int j = 0; j < Model.Rows.Count; j++)
                {

                    <tr>
                        @for (int k = 0; k < Model.Rows[j].Columns.Count; k++)
                        {
                            <td data-label="">
                                @Model.Rows[j].Columns[k]
                            </td>
                        }
                    </tr>






                }
            }
        </tbody>
    </table>
</div>
