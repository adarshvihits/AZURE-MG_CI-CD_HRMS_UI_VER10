@model Hrms.Lite.Shared.DashBoard.TimeOfficeDashBoardNew
<h1 class="table-heading">Work Status </h1>
<div class="ihits-table table-border hover-color odd-even mobile-responsive new-dash-table  work-status-tble-list">
    <table>
        <thead>
            <tr class="table-color-new ">

                <th class="table-radius-new" scope="col"></th>
                <th scope="col">Leave</th>
                <th scope="col">WFH</th>
                <th scope="col">Onduty</th>
                <th class="table-radius-right" scope="col">AB</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.TimeOfficeDashBoardWorkStatusList != null && Model.TimeOfficeDashBoardWorkStatusList.Count > 0)
            {


                for (int i = 0; i < Model.TimeOfficeDashBoardWorkStatusList.Count; i++)

                {
                    <tr>
                        <td data-label="Name">@Model.TimeOfficeDashBoardWorkStatusList[i].Type</td>
                        <td data-label="Name">@Model.TimeOfficeDashBoardWorkStatusList[i].Leave</td>
                        <td data-label="Name">@Model.TimeOfficeDashBoardWorkStatusList[i].WFH</td>
                        <td data-label="Name">@Model.TimeOfficeDashBoardWorkStatusList[i].Onduty</td>
                        <td data-label="Name">@Model.TimeOfficeDashBoardWorkStatusList[i].AB</td>
                    </tr>

                }
            }

        </tbody>
    </table>
</div>
