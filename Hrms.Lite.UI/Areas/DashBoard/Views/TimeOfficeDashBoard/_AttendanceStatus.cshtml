@model Hrms.Lite.Shared.DashBoard.TimeOfficeDashBoardNew

<style>
    .ihits-table.table-border table tbody tr td {
        padding: 13px 6px !important;
    
    }
</style>
<div class="ihits-table table-border hover-color odd-even mobile-responsive   responsive-new-clsss    work_status_listV3 vertical-scroll-200">
    <table class="tble-new-color-chng">
        <thead>
            <tr class="table-color-new ">

                <th class="table-radius-new" scope="col"></th>
                <th scope="col">Leave</th>
                <th scope="col">WFH</th>
                <th scope="col">Onduty</th>
                <th scope="col">AB</th>
                <th scope="col">RA</th>
                <th scope="col">E.OuT</th>
                <th scope="col">S.L</th>
                <th scope="col">L.Hrs</th>                
                <th scope="col">Late.In</th>
            </tr>
        </thead>
        <tbody>

            @if (Model.TimeOfficeDashBoardWorkStatusList != null && Model.TimeOfficeDashBoardWorkStatusList.Count > 0)
            {


                for (int i = 0; i < Model.TimeOfficeDashBoardWorkStatusList.Count; i++)

                {
            <tr>
                <td data-label="Type">@Model.TimeOfficeDashBoardWorkStatusList[i].Type</td>
                <td data-label="Leave">@Model.TimeOfficeDashBoardWorkStatusList[i].Leave</td>
                <td data-label="WFH">@Model.TimeOfficeDashBoardWorkStatusList[i].WFH</td>
                <td data-label="Onduty">@Model.TimeOfficeDashBoardWorkStatusList[i].Onduty</td>
                <td data-label="AB">@Model.TimeOfficeDashBoardWorkStatusList[i].AB</td>
                <td data-label="RA">@Model.TimeOfficeDashBoardWorkStatusList[i].RA</td>
                <td data-label="E.OVT">@Model.TimeOfficeDashBoardWorkStatusList[i].E_OUT</td>
                <td data-label="S.L">@Model.TimeOfficeDashBoardWorkStatusList[i].SL</td>
                <td data-label="L.Hrs">@Model.TimeOfficeDashBoardWorkStatusList[i].L_HRS</td>                
                <td data-label="Late.In">@Model.TimeOfficeDashBoardWorkStatusList[i].LATE_IN</td>
            </tr>

                }
            }



        </tbody>
    </table>
</div>