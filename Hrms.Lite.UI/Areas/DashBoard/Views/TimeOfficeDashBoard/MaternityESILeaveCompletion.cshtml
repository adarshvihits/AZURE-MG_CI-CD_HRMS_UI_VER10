@model Hrms.Lite.Shared.DashBoard.TimeOfficeDashBoardNew
<script src="~/js/settings.js"></script>

<script src="~/js/tooltip.js"></script>
<style>
    .dataTables_scrollBody {
        height: 30vh !important;
    }
</style>



<script>
    $(document).ready(function () {
        debugger;
        fillData_Maternityesileave();
    });

</script>







<div class="ihits-table table-border hover-color odd-even mobile-responsive-table maternityesileavecompletion-list ">
    <table class="common-table"  id="DashBoard_TimeOffice_Maternityesileave_Tbl">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">EndDate</th>

            </tr>
        </thead>
        <tbody>
            @if (Model.TimeOfficeDashBoardDetailsList != null && Model.TimeOfficeDashBoardDetailsList.Count > 0)
            {

                for (int i = 0; i < Model.TimeOfficeDashBoardDetailsList.Count; i++)
                {
            <tr>


                <td data-label="ID">
                    @Model.TimeOfficeDashBoardDetailsList[i].EmployeeID
                </td>
                <td data-label="Employee Name">
                    @Model.TimeOfficeDashBoardDetailsList[i].FullName
                </td>
                <td data-label="EndDate">
                    @Model.TimeOfficeDashBoardDetailsList[i].EndDate
                </td>
            </tr>
                }
            }
        </tbody>
    </table>
</div>