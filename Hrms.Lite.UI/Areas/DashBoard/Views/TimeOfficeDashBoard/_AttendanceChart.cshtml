@model IEnumerable<Hrms.Lite.Shared.DashBoard.TimeOfficeDashBoardDiagram>
@using Kendo.Mvc.UI;


<div class="demo-section wide">
 
        @(Html.Kendo().Chart(Model)
            .Name("chart")
            .Title("")
            .Legend(legend => legend
                //.Position(ChartLegendPosition.Bottom)
                .Visible(false)
            )
            .ChartArea(chartArea => chartArea
                .Background("transparent")//.Height(250).Width(650)
            )
            .HtmlAttributes(new { style = "width:100%; height:200px" })
            .SeriesDefaults(seriesDefaults =>
                seriesDefaults.Line().Style(ChartSeriesStyle.Smooth)
            )
            .Series(series =>
            {

                series.Line(model => model.COUNT).Name(ViewBag.Classsification).CategoryField("SalaryPeriodName").Color("#FF7A00");

            })
            .CategoryAxis(axis => axis
                //.Categories("2002", "2003", "2004", "2005", "2006", "2007", "2008", "2009", "2010", "2011")
                .MajorGridLines(lines => lines.Visible(false))
            )
            .ValueAxis(axis => axis
                .Numeric().Labels(labels => labels.Format("{0}"))
                .Line(line => line.Visible(false))
                .AxisCrossingValue(-10)
            )
            .Tooltip(tooltip => tooltip
                .Visible(true).Template("<span style='color:black'><b>#= series.name #</b> <br />  Count : #= value #</span>")
            //.Format("{0}")
            )
    )
    
</div>