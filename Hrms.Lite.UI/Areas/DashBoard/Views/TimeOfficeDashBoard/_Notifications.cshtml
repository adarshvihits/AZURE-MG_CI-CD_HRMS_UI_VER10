@model Hrms.Lite.Shared.DashBoard.TimeOfficeDashBoardNew

@if (Model != null && Model.DashBoardNotificationList.Count > 0)
{
    int[] codes = { 1, 2, 3, 4, 5, 6, 7, 13,15 };
