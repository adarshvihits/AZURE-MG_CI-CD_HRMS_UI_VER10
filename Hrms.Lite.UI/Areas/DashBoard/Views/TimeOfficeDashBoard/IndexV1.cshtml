@model Hrms.Lite.Shared.DashBoard.TimeOfficeDashBoard
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}
@using Kendo.Mvc.UI
@*<script src="~/js/jquery.min.js"></script>*@


<script src="~/js/jquery.min.js"></script>
<link href="~/css/kendo/2023.1.117/kendo.bootstrap-main.min.css" rel="stylesheet" />
<script src="~/js/kendo/kendo.all.min.js"></script>
<script src="~/js/kendo/kendo.aspnetmvc.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>
<link href="~/css/DashBoard.css" rel="stylesheet" />
<script src="~/scripts/DashBoard/timeOfficedashboard.js"></script>
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->

        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Dashboard</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index","Home",new { Area=""})"><i class="icon-nm fas fa-home"></i></a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        Time Office
                    </li>
                </ul>
            </div>
        </div>


    </div>
    <!--end::Container-->
</div>
<!--end::Header-->

<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                    <!-- Dashboard start here -->

                    <div class="row">




                        <!--begin::Tiles Widget 2-->
                        <div class="col-xl-3">
                            <div class="card gutter-b" style="height: 130px" data-bs-toggle="modal" data-target="" onclick="onLabelClick('APPROVAL PENDING','timeDash_ApprovalPendingPopup')">
                                <!--begin::Body-->
                                <div class="card-body d-flex flex-column p-0" style="position: relative;">
                                    <!--begin::Stats-->
                                    <div class="flex-grow-1 card-spacer-x pt-6">

                                        <div class="d-flex">

                                            <span class="approval_icon">
                                                <!--start::Svg Icon-->

                                                <img src="~/images/icons/onboarding-pending.svg" />
                                                <!--end::Svg Icon-->
                                            </span>
                                            <div class="approval_count">@Model.ApprovalPending</div>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center pt-7">
                                            <a class="text-dark-75 text-hover-primary  cuser-pointer-hand font-weight-bolder font-size-h3">Approval Pending</a>

                                            <div class="">
                                                @*<a href="#">  <img src="~/images/icons/card_arrow.svg" /></a>*@

                                            </div>
                                        </div>







                                    </div>
                                    <!--end::Stats-->

                                </div>
                                <!--end::Body-->
                            </div>
                        </div>
                        <!--end::Tiles Widget 2-->
                        <div class="col-xl-3">
                            <!--begin::Tiles Widget 3-->
                            <div class="card gutter-b" style="height: 130px" data-bs-toggle="modal" data-target="" onclick="onLabelClick('LowAttendanceRate','lowattendanceratePopup')">
                                <!--begin::Body-->
                                <div class="card-body d-flex flex-column p-0" style="position: relative;">
                                    <!--begin::Stats-->
                                    <div class="flex-grow-1 card-spacer-x pt-6">
                                        <div class="d-flex">


                                            <span class="approval_icon">
                                                <!--start::Svg Icon-->

                                                <img src="~/images/icons/notebook.svg" />
                                                <!--end::Svg Icon-->
                                            </span>

                                            <div class="approval_count">@Model.LowAttendanceRate</div>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center pt-7">

                                            <a class="text-dark-75 text-hover-primary cuser-pointer-hand font-weight-bolder font-size-h3">
                                                Low Attendance Rate
                                            </a>


                                            <div class="">
                                                @*<a href="#">  <img src="~/images/icons/card_arrow.svg" /></a>*@

                                            </div>
                                        </div>





                                    </div>
                                    <!--end::Stats-->

                                </div>
                                <!--end::Body-->
                            </div>
                            <!--end::Tiles Widget 3-->
                        </div>



                        <!--begin::Tiles Widget 4-->
                        <div class="col-xl-3">
                            <div class="card gutter-b" style="height: 130px" data-bs-toggle="modal" data-target="" onclick="onLabelClick('MISSING','timeDash_missingPopup')">
                                <!--begin::Body-->
                                <div class="card-body d-flex flex-column p-0" style="position: relative;">
                                    <!--begin::Stats-->
                                    <div class="flex-grow-1 card-spacer-x pt-6">

                                        <div class="d-flex">
                                            <span class="approval_icon">
                                                <!--start::Svg Icon-->

                                                <img src="~/images/icons/calendar3.svg" />
                                                <!--end::Svg Icon-->
                                            </span>
                                            <div class="approval_count">@Model.AttendanceSettingsMissing</div>

                                        </div>

                                        <div class="d-flex justify-content-between align-items-center pt-7">
                                            <a class="text-dark-75 text-hover-primary cuser-pointer-hand  font-weight-bolder font-size-h3">Attendance Settings Missing</a>
                                            <div class="">
                                                @*<a href="#">  <img src="~/images/icons/card_arrow.svg" /></a>*@

                                            </div>
                                        </div>








                                    </div>
                                    <!--end::Stats-->

                                </div>
                                <!--end::Body-->
                            </div>
                        </div>
                        <!--begin::Tiles Widget 4-->

                        <div class="col-xl-3">
                            <div class="card gutter-b" style="height: 130px" data-bs-toggle="modal" data-target="" onclick="onLabelClick('Upcoming Leaves','timeDash_upcomingleavesPopup')">
                                <!--begin::Body-->
                                <div class="card-body d-flex flex-column p-0" style="position: relative;">
                                    <!--begin::Stats-->
                                    <div class="flex-grow-1 card-spacer-x pt-6 ">
                                        <div class="d-flex">
                                            <span class="approval_icon">
                                                <!--start::Svg Icon-->

                                                <img src="~/images/icons/Approval_tracker.svg" />
                                                <!--end::Svg Icon-->
                                            </span>
                                            <div class="approval_count">@Model.UpcomingLeaves</div>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center pt-7">

                                            <a class="text-dark-75 text-hover-primary cuser-pointer-hand   font-weight-bolder font-size-h3">Upcoming Leaves</a>

                                            <div class="">
                                                @*<a href="#"> <img src="~/images/icons/card_arrow.svg" /></a>*@

                                            </div>
                                        </div>








                                    </div>
                                    <!--end::Stats-->


                                </div>
                                <!--end::Body-->
                            </div>

                        </div>






                    </div>


                    <!--middile section -->

                    <div class="row middile_section">
                        <div class="col-xl-4">
                            <!--begin::Stats Widget 1-->
                            <div class="card gutter-b">
                                <!--begin::Body-->
                                <div class="card-body active_employee flex-grow-1 card-spacer-x pt-8">



                                    <div class="d-flex align-items-center justify-content-between mb-3 bottom_border" data-bs-toggle="modal" data-target="" onclick="onLabelClick('PreviousMonthAdjustments','timeDash_previousmonthadjstPopup')">


                                        <div class="active_employee_icon">
                                            <!--start::Svg Icon-->

                                            <img src="~/images/icons/Layer 2.svg" />

                                            <a class="text-dark-75 text-hover-primary cuser-pointer-hand font-weight-bolder font-size-h3">Previous Month Adjustments</a>
                                            <!--end::Svg Icon-->
                                        </div>

                                        <div>
                                            <span class="text-dark-75 font-weight-bolder font-size-h3">@Model.PreviousMonthAdjustments</span>

                                        </div>




                                    </div>


                                    <div class="d-flex align-items-center justify-content-between mb-3" data-bs-toggle="modal" data-target="" onclick="onLabelClick('LESSHOURS','timeDash_lesshourPopup')">


                                        <div class="active_employee_icon">
                                            <!--start::Svg Icon-->

                                            <img src="~/images/icons/onboarding-pending.svg" />

                                            <a class="text-dark-75 text-hover-primary cuser-pointer-hand font-weight-bolder font-size-h3">Less Hours</a>
                                            <!--end::Svg Icon-->
                                        </div>


                                        <div>
                                            <span class="text-dark-75 font-weight-bolder font-size-h3">@Model.LessHours</span>

                                        </div>
                                    </div>


                                </div>
                                <!--end::Body-->
                            </div>
                            <!--end::Stats Widget 1-->
                        </div>

                        <div class="col-xl-4">
                            <!--begin::Stats Widget 1-->
                            <div class="card gutter-b">
                                <!--begin::Body-->
                                <div class="card-body active_employee flex-grow-1 card-spacer-x pt-8">



                                    <div class="d-flex align-items-center justify-content-between mb-3 bottom_border " data-bs-toggle="modal" data-target="" onclick="onLabelClick('ContinousAbsenteesim','timeDash_absenteesimPopup')">


                                        <div class="active_employee_icon">
                                            <!--start::Svg Icon-->

                                            <img src="~/images/icons/Layer -2.svg" />

                                            <a class="text-dark-75 cuser-pointer-hand text-hover-primary font-weight-bolder">
                                                Continuous Absenteeism
                                            </a>


                                            <!--end::Svg Icon-->
                                        </div>


                                        <div>
                                            <span class="text-dark-75 font-weight-bolder font-size-h3">@Model.ContinousAbsenteesim</span>

                                        </div>
                                    </div>


                                    <div class="d-flex align-items-center justify-content-between flex-grow-1" data-bs-toggle="modal" data-target="" onclick="onLabelClick('Duty Roster Variance','timeDash_dutyrosterPopup')">


                                        <div class="active_employee_icon">
                                            <!--start::Svg Icon-->

                                            <img src="~/images/icons/onboarding-pending.svg" />

                                            <a class="text-dark-75 text-hover-primary cuser-pointer-hand font-weight-bolder font-size-h3">Duty Roster Variance</a>
                                            <!--end::Svg Icon-->
                                        </div>


                                        <div>
                                            <span class="text-dark-75 font-weight-bolder font-size-h3">@Model.DutyRosterVariance</span>

                                        </div>
                                    </div>

                                </div>
                                <!--end::Body-->
                            </div>
                            <!--end::Stats Widget 1-->
                        </div>

                        <div class="col-xl-4">
                            <!--begin::Stats Widget 1-->
                            <div class="card gutter-b">
                                <!--begin::Body-->
                                <div class="card-body active_employee flex-grow-1 card-spacer-x pt-8">



                                    <div class="d-flex align-items-center justify-content-between mb-3 bottom_border" data-bs-toggle="modal" data-target="" onclick="onLabelClick('AUTHORISED LOP','authorisedlopPopup')">


                                        <div class="active_employee_icon">
                                            <!--start::Svg Icon-->

                                            <img src="~/images/icons/Layer 2.svg" />
                                            <a class="text-dark-75 text-hover-primary cuser-pointer-hand  font-weight-bolder font-size-h3">Authorised LOP</a>

                                            <!--end::Svg Icon-->
                                        </div>


                                        <div>
                                            <span class="text-dark-75 font-weight-bolder font-size-h3"><span class="">@Model.AuthorisedLOP</span></span>

                                        </div>
                                    </div>


                                    <div class="d-flex align-items-center justify-content-between mb-3" data-bs-toggle="modal" data-target="" onclick="onLabelClick('UN AUTHORISED LOP','unauthorisedlopPopup')">


                                        <div class="active_employee_icon">
                                            <!--start::Svg Icon-->


                                            <img src="~/images/icons/calendar3.svg" />
                                            <a class="text-dark-75 text-hover-primary cuser-pointer-hand  font-weight-bolder font-size-h3">Unauthorized LOPs</a>
                                            <!--end::Svg Icon-->
                                        </div>


                                        <div>
                                            <span class="text-dark-75 font-weight-bolder font-size-h3">@Model.UnauthorizedLOPs</span>

                                        </div>
                                    </div>



                                </div>
                                <!--end::Body-->
                            </div>
                            <!--end::Stats Widget 1-->
                        </div>
                    </div>



                    <!--middile section end -->
                    <!--footer section start -->


                    <div class="row">
                        <div class="col-lg-6">
                            <!--begin::Card-->
                            <div class="card gutter-b  card-spacer-x pt-3" style="height:315px">
                                <!--begin::Header-->
                                <!--end::Header-->
                                <div class="card-body">
                                    <!--begin::Chart-->

                                    <div class="row ">
                                        <h6> Absenteeism by Day </h6>
                                    </div>

                                    @*<div class="Time_AbscenteeismChart">

                                        </div>*@

                                    @await Html.PartialAsync("~/Areas/DashBoard/Views/TimeOfficeDashBoard/_AbsenteeismChart.cshtml", Model.Absenteeism_by_Day)

                                </div>
                            </div>
                            <!--end::Card-->
                        </div>
                        <div class="col-lg-6">
                            <!--begin::Card-->
                            <div class="card gutter-b  card-spacer-x pt-3" style="height:315px;">




                                <div class="card-body">

                                    <div class="row">
                                        <div class="col-md-6">
                                            <h6>Today Check In Time Status </h6>
                                        </div>
                                        <div class="col-md-6">

                                            @Html.DropDownListFor(m => m.ShiftDetails.Code, (SelectList)ViewBag.Shift, new { @class = "form-control form-control-sm", @onchange = "onShiftChange(this)" })
                                        </div>

                                    </div>

