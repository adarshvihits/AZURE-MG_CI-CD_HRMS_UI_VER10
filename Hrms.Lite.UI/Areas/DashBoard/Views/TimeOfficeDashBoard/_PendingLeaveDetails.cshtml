@model Hrms.Lite.Shared.DashBoard.TimeOfficeDashBoard
<script src="~/js/settings.js"></script>
<style>
    .dataTables_scrollBody {
        height: 30vh !important;
    }
</style>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table leaveapprove">
    <table class="common-table">
        <thead>
            <tr class="table-dark">
               
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                @*<th scope="col"> Request Type</th>*@             

                <th scope="col">Date of Application</th>
                <th scope="col">
                    From
                </th>
                <th scope="col">To</th>
                <th scope="col">No: of Days</th>
                <th scope="col">Application Status</th>

            </tr>
        </thead>
        <tbody>
            @if (Model.TimeOfficeDashBoardDetailsList != null && Model.TimeOfficeDashBoardDetailsList.Count > 0)
            {

                for (int i = 0; i < Model.TimeOfficeDashBoardDetailsList.Count; i++)
                {
                    <tr>
                      
                          <td data-label="ID">
                                @Model.TimeOfficeDashBoardDetailsList[i].EmployeeID
                            </td>
                            <td data-label="Employee Name">
                                @Model.TimeOfficeDashBoardDetailsList[i].FullName
                            </td>
                            @*<td data-label="Request Type">
                                @Model.TimeOfficeDashBoardDetailsList[i].Type
                            </td>*@
                       
                        <td data-label="Date of Application">
                            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.TimeOfficeDashBoardDetailsList[i].DateofApplication))
                        </td>
                        <td data-label="From">
                            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.TimeOfficeDashBoardDetailsList[i].From))
                        </td>
                        <td data-label="To">
                            @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.TimeOfficeDashBoardDetailsList[i].To))
                        </td>
                        <td data-label="No: of Days">
                            @Model.TimeOfficeDashBoardDetailsList[i].NoOfDays
                        </td>
                        <td data-label="Application Status">
                            @Model.TimeOfficeDashBoardDetailsList[i].ApplicationStatus
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
