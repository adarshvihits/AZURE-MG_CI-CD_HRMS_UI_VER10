@model Hrms.Lite.Shared.DashBoard.TimeOfficeDashBoardNew

@if (Model != null && Model.DashBoardNotificationList.Count > 0)
{
    int[] codes = { 1, 2, 3, 4, 5, 6, 7, 13,15 };
    for (int i = 0; i < Model.DashBoardNotificationList.Count; i++)
    {
        if (codes.Contains(Model.DashBoardNotificationList[i].Code))
        {
            <div class="notifi-common-space notifi-border-back-box">
                <a onclick="GetNotificationPopUp(@Model.DashBoardNotificationList[i].Code,'@Model.DashBoardNotificationList[i].Type')">
                    <div class="row">
                        <div class="col-md-10">
                            <div class="d-flex align-items-center h-100">
                                <div class="dots back_new">

                                </div>
                                <div class="notifi-textz back_white">@Model.DashBoardNotificationList[i].Type</div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="notifi-slide-count back_new">
                                <div class="white_count">@Model.DashBoardNotificationList[i].count</div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
        else
        {
            <div class="notifi-common-space notifi-border-back-box">
                <a href="@Model.DashBoardNotificationList[i].Action">
                    <div class="row">
                        <div class="col-md-10">
                            <div class="d-flex align-items-center h-100">
                                <div class="dots back_new">

                                </div>
                                <div class="notifi-textz back_white">@Model.DashBoardNotificationList[i].Type</div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <div class="notifi-slide-count back_new">
                                <div class="white_count">@Model.DashBoardNotificationList[i].count</div>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }


    }
}


