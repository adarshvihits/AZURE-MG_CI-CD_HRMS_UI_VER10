@model Hrms.Lite.Shared.DashBoard.TimeOfficeDashBoardNew
    @*<script src="~/js/jquery.min.js"></script>
    <script src="~/js/datatables.min.js"></script>*@
    <script src="~/js/settings.js"></script>

    <style>
        .dataTables_scrollBody {
            height: 30vh !important;
        }

        .dataTables_scrollHeadInner table {
            width: 100% !important;
        }
    </style>
    <script>
        var searchClk = 0;
        $(document).ready(function () {
            debugger;
            fillData_DutyRoaster();
        });


        function onSearchClick() {
            debugger
            if (searchClk == 0) {
                searchClk = 1;
                $('#dataTableSearch').addClass('field-width-big');
                CursorFocusOnSearch();
            }
            else {
                searchClk = 0;
                $('#dataTableSearch').removeClass('field-width-big');
            }
        }


    </script>
    <div class="row tab-style-button">
        <div class="tab-button-wrap align-items-center">


            <div class="tab-items pl-3 pt-3 lows">


            </div>

            <div class="tab-items select-option ">

                <div class="sraech-slider">
                    <div class="search-slider-inner">
                        <i class="fa fa-search" onclick="onSearchClick()"></i>
                    </div>
                    <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                           placeholder="ID/Name">
                </div>

                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left" data-bs-original-title="Export to Excel" onclick="ExportToExcel()">
                    <i class="icon-xl far fa-file-excel"></i>
                </a>


            </div>



        </div>
    </div>

    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table  dutyrostervariance-list">
        @Html.HiddenFor(m => m.TimeOfficeDashBoardDetailsList.Count)

        <table id="Duty_Roaster_Tbl">
            <thead>
                <tr class="table-dark">

                    <th scope="col">ID </th>
                    <th scope="col">Employee Name</th>
                    <th scope="col">
                        Designation
                    </th>
                    <th scope="col">
                        Department

                    </th>
                    <th scope="col">
                        Location
                    </th>
                    <th scope="col">
                        Date
                    </th>
                    <th scope="col">
                        Shift Hours
                    </th>
                    <th scope="col">
                        Worked Hours
                    </th>
                </tr>
            </thead>
            <tbody>
            </tbody>
        </table>
    </div>