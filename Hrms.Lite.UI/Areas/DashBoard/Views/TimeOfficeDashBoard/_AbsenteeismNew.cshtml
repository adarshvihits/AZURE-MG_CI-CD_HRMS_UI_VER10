


@model Hrms.Lite.Shared.DashBoard.TimeOfficeDashBoardNew
    
 
    <style>
        .dataTables_scrollBody {
            height: 22vh !important;
        }

        .dataTables_scrollHeadInner table {
            width: 100% !important;
        }
    </style>
    <script>
        var searchClk = 0;
        $(document).ready(function () {
            debugger;           
            fillData_Absenteeism();
        });

        function onSearchClick() {
            debugger
           
            if (searchClk == 0) {
                searchClk = 1;              
                $('.dataTableSearch2').addClass('field-width-big');
                CursorFocusOnSearch();
            }
            else {
                searchClk = 0;
                $('.dataTableSearch2').removeClass('field-width-big');
            }
        }


    </script>

    <div class="row tab-style-button">
        <div class="tab-button-wrap align-items-center">
            <div class="tab-items pl-3 pt-3 lows">


            </div>

            <div class="tab-items select-option ">

                <div class="sraech-slider">
                    <div class="search-slider-inner">
                        <i class="fa fa-search"  onclick="onSearchClick()"></i>
                    </div>
                    <input type="text" id="dataTableSearch" class="form-control form-control-sm dataTableSearch2"
                           placeholder="ID/Name">
                </div>

                <a data-bs-toggle="tooltip" title="" class="btn btn-excel float-left" data-bs-original-title="Export to Excel" onclick="ExportToExcelcontinousabsenteesim()">
                    <i class="icon-xl far fa-file-excel"></i>
                </a>


            </div>



        </div>
    </div>
          

            <div class="ihits-table table-border hover-color odd-even mobile-responsive-table  continousabsenteesim-list">
                @Html.HiddenFor(m => m.TimeOfficeDashBoardDetailsList.Count)
                <table id="DashBoard_TimeOffice_Absenteeism_Tbl">
                    <thead>
                        <tr class="table-dark">

                            <th scope="col">ID </th>
                            <th scope="col">Employee Name</th>
                            <th scope="col">
                                Designation
                            </th>
                            <th scope="col">
                                Department

                            </th>
                            <th scope="col">
                                Location

                            </th>

                            <th scope="col">
                                No: of Days

                            </th>
                            <th scope="col">
                                From

                            </th>
                            <th scope="col">
                                To

                            </th>


                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
