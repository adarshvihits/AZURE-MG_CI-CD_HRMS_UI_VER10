@model Hrms.Lite.Shared.DashBoard.TimeOfficeDashBoardNew
    @*<script src="~/js/jquery.min.js"></script>
    <script src="~/js/datatables.min.js"></script>*@

    @*<script src="~/js/settings.js"></script>*@
    @*<style>
        .dataTables_scrollBody {
            height: 30vh !important;
        }

        .dataTables_scrollHeadInner table {
            width: 100% !important;
        }
    </style>*@
<script>
    $(document).ready(function () {
        debugger;
        $('#exampleModalLabelauth').html($('#TimeOfficeDashBoardDetailsList_0__FullName').val()+ '('+$('#TimeOfficeDashBoardDetailsList_0__EmployeeID').val()+')');
    });
</script>

    <div class="ihits-table table-border hover-color odd-even mobile-responsive-table unauthorised-nub-od-days-list vertical-scroll-250">
        @Html.HiddenFor(m => m.TimeOfficeDashBoardDetailsList.Count)

        <table id="Auth_And_UnAuthorized_POPUP_TBL">
            <thead>
                <tr class="table-dark">

                    <th scope="col">Sl.No </th>
                    <th scope="col">Date</th>

                </tr>
            </thead>
            <tbody>

                @{ var slno = 0;


                }

                @if (Model.TimeOfficeDashBoardDetailsList != null && Model.TimeOfficeDashBoardDetailsList.Count > 0)
                {
                  
                    for (int i = 0; i < Model.TimeOfficeDashBoardDetailsList.Count; i++)
                    {




                        slno++;

                <tr>
                    @Html.HiddenFor(m => m.TimeOfficeDashBoardDetailsList[0].FullName)
                    @Html.HiddenFor(m => m.TimeOfficeDashBoardDetailsList[0].EmployeeID)
                    <td data-label="slno">@slno</td>

                    <td data-label="date">@Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.TimeOfficeDashBoardDetailsList[i].From))</td>
                    @*<td data-label="date"> @Html.DisplayFor(Model => Model.TimeOfficeDashBoardDetailsList[i].From)</td>*@





                </tr>


                    }
                }

            </tbody>
        </table>
    </div>
