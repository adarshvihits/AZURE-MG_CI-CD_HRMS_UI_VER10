<style>
    .ihits-table.table-border table thead tr th {
        padding: 9px 5px;
        font-weight: 500;
        color: #fff;
    }

    .ihits-table.table-border table thead tr.table-dark th, .ihits-table.table-border table tbody tr.table-dark td {
        background-color: #c3d3e2 !important;
    }

    .ihits-table.table-border table tbody tr td {
        padding: 16px 12px !important;
    }

    .ihits-table table tbody tr {
        /* border-bottom: 1px solid #F6F7F9; */
        border-bottom: none;
        background-color: #f2f5f6;
        margin: 15px 0px;
        border-radius: 8px;
    }

    .ihits-table.table-border table thead tr.table-dark th, .ihits-table.table-border table tbody tr.table-dark td {
        background-color: #f2f5f6 !important;
        padding: 15px 10px;
    }

    .ihits-table.table-border table thead tr.table-dark th, .ihits-table.table-border table tbody tr.table-dark td {
        background-color: #264f94;
        background-color: var(--main-color-one);
        border: none !important;
        color: #000;
    }

   

    .home-demo h2 {
        color: #FFF;
        text-align: center;
        padding: 5rem 0;
        margin: 0;
        font-style: italic;
        font-weight: 300;
        background: #ff3f4d;
    }
    .owl-prev{
        display:none !important;
    }
    .owl-next {
        display: none !important;
    }
    .owl_img {
        width: 100%;
        height: 200px;
        object-fit: cover;
    }
    .owl_img img{
        width: 100%;
        height: 100%;
        object-fit:cover;
    }
    .item p {
        font-size: 13px;
        color: #8e8e8e;
        text-align:justify;
        padding-top:12px;
    }
    .photos_gallery_head{
        font-size:15px;
    }
</style>
<script>
    $(function () {
        // Owl Carousel
        var owl = $(".owl-carousel");
        owl.owlCarousel({
            items: 2,
            margin: 10,
            loop: true,
            nav: true,
            autoplay:true
        });
    });

</script>

