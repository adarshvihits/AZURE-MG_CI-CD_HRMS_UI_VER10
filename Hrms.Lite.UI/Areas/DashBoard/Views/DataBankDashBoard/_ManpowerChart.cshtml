@model Hrms.Lite.Shared.DashBoard.DataBankDashBoard
@using Kendo.Mvc.UI
<div class="demo-section wide" @*style="position: relative;"*@>
    @*<label id="my-button" style="position: absolute; top: 95px; left: 170px;">@Model.ManPowerTotal</label>*@


    @(Html.Kendo().Chart<Hrms.Lite.Shared.DashBoard.DataBankDashBoard>()
    .Name("chart")
    .HtmlAttributes(new { style = "width: 460px; height: 203px; margin:0 auto;" })
    .ChartArea(chartArea => chartArea
        .Background("transparent"))
    .Title(title => title
        .Text("")
        .Position(ChartTitlePosition.Bottom)
    )
    .Legend(legend => legend
        .Visible(true)
    )
    .Events(events => events
       .Render("onRender"))
    .SeriesDefaults(series =>
        series.Donut().StartAngle(150).HoleSize(45)
    )
   .Series(series =>
   {
       series.Donut(new dynamic[] {
            new { category = Model.ManPowerChart[0].Type, value = Model.ManPowerChart[0].count, color = "#F23812" },
            new { category = Model.ManPowerChart[1].Type, value = Model.ManPowerChart[1].count, color = "#FCC103" },
            new { category = Model.ManPowerChart[2].Type, value = Model.ManPowerChart[2].count, color = "#F97F06" },
            new { category = Model.ManPowerChart[3].Type, value = Model.ManPowerChart[3].count, color = "#3A7CE9" },
            new { category = Model.ManPowerChart[4].Type, value = Model.ManPowerChart[4].count, color = "#343443" }
        })
       .Size(50);

   })
    .Tooltip(tooltip => tooltip
        .Visible(true)
        .Template("#= category #: #= kendo.toString(value, 'n0') #")
    )
    .RenderAs(RenderingMode.Canvas)
)



</div>
<script>
    function onRender(e) {
        // Calculate the total value of all data points
        //var total = 0;
        //e.sender.dataSource.view().forEach(function (dataItem) {
        //    total += dataItem.count;
        //});

        // Create and style the label element        
        $('.chart-center-label').remove();
        var label = $('<div class="chart-center-label">' + '@Model.ManPowerTotal' + '</div>');
        label.css({
            'font-size': '16px',
            'font-weight': 'bold',
            'text-align': 'center',
            'line-height': '48px'
        });

        // Add the label element to the chart container
        var chartContainer = e.sender.wrapper;
        debugger;
        //chartContainer[0].outerText = "";
        chartContainer.append(label);
    }

    function onSeriesClick(e) {
        debugger;
        //var chart = $("#chart").data("kendoChart");
        //var options = chart.options;
        //if (options.series[0].data[e.point.index].explode == true)
        //    options.series[0].data[e.point.index].explode = false;
        //else
        //    options.series[0].data[e.point.index].explode = true;
        //chart.setOptions(options);
        if (e.sender.options.series[0].data[e.point.index].explode == true)
            e.sender.options.series[0].data[e.point.index].explode = false;
        else
            e.sender.options.series[0].data[e.point.index].explode = true; 
        e.sender.options.transitions = false;
        e.sender.redraw();
    }
</script>

<style>
    .chart-center-label {
        position: absolute;
        top: 50%;
        left: 30%;
        transform: translate(-50%, -50%);
    }

    .wide p {display:none;}

</style>




