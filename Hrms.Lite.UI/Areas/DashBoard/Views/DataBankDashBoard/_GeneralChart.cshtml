@model Hrms.Lite.Shared.DashBoard.DataBankDashBoard
@using Kendo.Mvc.UI



<div id="slider">
    <a href="#" class="control_next">></a>
    <a href="#" class="control_prev"><</a>
    <ul>
        <li>
            <div class="demo-section wide" id="Agechartdiv">
                <h6>Age</h6>
                @(Html.Kendo().Chart<Hrms.Lite.Shared.DashBoard.DataBankDashBoard>()
        .Name("Age")
        .HtmlAttributes(new { style = "width: 220px; height: 220px; margin:0 auto;" })
        .ChartArea(chartArea => chartArea
            .Background("transparent"))
        .Title(title => title
            .Text("")
            .Position(ChartTitlePosition.Bottom)
        )
        .Legend(legend => legend
            .Visible(true).Position(ChartLegendPosition.Bottom)
        )
        .SeriesDefaults(series =>
            series.Pie().StartAngle(150).Padding(25)

        )
        .Series(series =>
        {


            series.Pie(new dynamic[] {
                new { category = Model.AgeChart[0].Type, value = Model.AgeChart[0].count, color = "#36B9EA" },
                new { category = Model.AgeChart[1].Type, value = Model.AgeChart[1].count, color = "#FB337B" },
                new { category = Model.AgeChart[2].Type, value = Model.AgeChart[2].count, color = "#44DABE" },
                new { category = Model.AgeChart[3].Type, value = Model.AgeChart[3].count, color = "#FCC103" },
            });


        })
        .Tooltip(tooltip => tooltip
            .Visible(true)
            .Template("#= category # : #= value #")
        ).RenderAs(RenderingMode.Canvas)

    )




            </div>
        </li>
        <li style="background: #aaa;">
            <div class="demo-section wide" id="Agechartdiv">
                <h6>Gender</h6>
                @(Html.Kendo().Chart<Hrms.Lite.Shared.DashBoard.DataBankDashBoard>()
        .Name("Gender")
        .HtmlAttributes(new { style = "width: 220px; height: 220px; margin:0 auto;" })
        .ChartArea(chartArea => chartArea
            .Background("transparent"))
        .Title(title => title
            .Text("")
            .Position(ChartTitlePosition.Bottom)
        )
        .Legend(legend => legend
            .Visible(true).Position(ChartLegendPosition.Bottom)
        )
        .SeriesDefaults(series =>
            series.Donut().StartAngle(150).Padding(25)

        )
        .Series(series =>
        {


        series.Pie(new dynamic[] {
            new {category=Model.GenderChart[0].Type,value=Model.GenderChart[0].count,color="#36B9EA"},
            new {category=Model.GenderChart[1].Type,value=Model.GenderChart[1].count,color="#FB337B"},
            new {category=Model.GenderChart[2].Type,value=Model.GenderChart[2].count,color="#44DABE"},
            }).Size(40);


    })
        .Tooltip(tooltip => tooltip
            .Visible(true)
            .Template("#= category # : #= value #")
        ).RenderAs(RenderingMode.Canvas)

)




            </div>
        </li>
        <li><div class="demo-section wide" id="Agechartdiv">
    <h6>Y/S</h6>
    @(Html.Kendo().Chart<Hrms.Lite.Shared.DashBoard.DataBankDashBoard>()
        .Name("Y/S")
        .HtmlAttributes(new { style = "width: 220px; height: 220px; margin:0 auto;" })
        .ChartArea(chartArea => chartArea
            .Background("transparent"))
        .Title(title => title
            .Text("")
            .Position(ChartTitlePosition.Bottom)
        )
        .Legend(legend => legend
            .Visible(true).Position(ChartLegendPosition.Bottom)
        )
        .SeriesDefaults(series =>
            series.Donut().StartAngle(150).Padding(25)

        )
        .Series(series =>
        {


            series.Pie(new dynamic[] {
            new {category=Model.YOSChart[0].Type,value=Model.YOSChart[0].count,color="#36B9EA"},
            new {category=Model.YOSChart[1].Type,value=Model.YOSChart[1].count,color="#FB337B"},
            new {category=Model.YOSChart[2].Type,value=Model.YOSChart[2].count,color="#44DABE"},
            new {category=Model.YOSChart[3].Type,value=Model.YOSChart[3].count,color="#FCC103"},
            new {category=Model.YOSChart[4].Type,value=Model.YOSChart[4].count,color="#F23812"},
            new {category=Model.YOSChart[5].Type,value=Model.YOSChart[5].count,color="#FCC103"},
            new {category=Model.YOSChart[6].Type,value=Model.YOSChart[6].count,color="#F97F06"},
            new {category=Model.YOSChart[7].Type,value=Model.YOSChart[7].count,color="#3A7CE9"},
            }).Size(40);


        })
        .Tooltip(tooltip => tooltip
            .Visible(true)
            .Template("#= category # : #= value #")
        ).RenderAs(RenderingMode.Canvas)

)




</div>
        @*</li>
        <li style="background: #aaa;">SLIDE 4</li>*@
    </ul>
</div>







