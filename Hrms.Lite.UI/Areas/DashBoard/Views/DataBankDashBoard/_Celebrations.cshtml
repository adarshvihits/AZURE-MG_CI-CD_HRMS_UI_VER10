@model Hrms.Lite.Shared.DashBoard.DataBankDashBoard
<div class="card card-stretch gutter-b">

    <div class="card-body">

        <div id="carouselExampleControls" class="carousel slide" data-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <div class="profile_container">
          @if (Model.DataBankDashBoardDetailsList != null && Model.DataBankDashBoardDetailsList.Count > 0)
          {

              for (int i = 0; i < Model.DataBankDashBoardDetailsList.Count; i++)
              {
                  <div class="profile_img">

                      <img src="/images/nived.png">

                  </div>


                  <div class="profile_details">
                      <h6>@Model.DataBankDashBoardDetailsList[i].FullName</h6>
                      <p>@Model.DataBankDashBoardDetailsList[i].Designation</p>
                      <p>
                          @Html.Encode(String.Format("{0:dd-MMM-yyyy}", Model.DataBankDashBoardDetailsList[i].CelbtnDate))
                       </p>
                      <div class="d-flex flex-wrap mb-4">
                          <a href="#" class="text-dark-50 text-hover-primary font-weight-bold mr-lg-8 mr-5 mb-lg-0 mb-2">
                              <i class="flaticon2-new-email mr-2 font-size-lg"></i>@Model.DataBankDashBoardDetailsList[i].Type
                          </a>

                      </div>
                  </div>


              }
          }

        </div>

                </div>
             
              
            </div>

            <a class="carousel-control-prev" href="#carouselExampleControls" role="button" data-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="sr-only">Previous</span>
            </a>
            <a class="carousel-control-next" href="#carouselExampleControls" role="button" data-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="sr-only">Next</span>
            </a>
        </div>



    </div>
</div>