@model Hrms.Lite.Shared.DashBoard.DataBankDashBoard
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table vertical-scroll-200 Approval-Tracker-poup-tble ">
    <table id="" class="">
        <thead>
            <tr class="table-light">
                <th scope="col">Type</th>
                <th scope="col">Count</th>

            </tr>
        </thead>
        <tbody>
            @if (Model.DataBankDashBoardList != null && Model.DataBankDashBoardList.Count > 0)
            {

                for (int i = 0; i < Model.DataBankDashBoardList.Count; i++)
                {
                    <tr>
                        <td data-label="Type">@Model.DataBankDashBoardList[i].Type</td>

                        <td data-label="Count">
                            @if (Model.ListType == "DOCUMENTS MISSING")
                            {
                                <a onclick="onLabelClick('DOCUMENTS MISSING','dashInfoMissingPopup','@Model.DataBankDashBoardList[i].Type')">@Model.DataBankDashBoardList[i].count</a>
                            }
                            else if (Model.ListType == "UPCOMING RENEWALS")
                            { 
                                
                                <a onclick="onLabelClick('UPCOMING RENEWALS','dashRenewelPopup','@Model.DataBankDashBoardList[i].Type')">@Model.DataBankDashBoardList[i].count</a>
                            }
                            else if (Model.ListType == "OVERDUE RENEWALS")
                            { 
                                
                                <a onclick="onLabelClick('OVERDUE RENEWALS','dashRenewelPopup','@Model.DataBankDashBoardList[i].Type')">@Model.DataBankDashBoardList[i].count</a>
                            }
                            else
                            {
                                <a onclick="onLabelClick('MISSING','dashInfoMissingPopup','@Model.DataBankDashBoardList[i].Type')">@Model.DataBankDashBoardList[i].count</a>
                            }

                        </td>



                    </tr>


                }
            }




        </tbody>


    </table>

</div>