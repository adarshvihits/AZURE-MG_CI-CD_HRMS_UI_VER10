@model Hrms.Lite.Shared.DashBoard.DataBankDashBoard
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table  Recent-Master-Changes-list vertical-scroll-250">
    <table>
        <thead>
            <tr class="table-light">
                <th scope="col">Master Name</th>
                <th scope="col">Edit / Delete</th>
                <th scope="col">Count</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.DataBankDashBoardList != null && Model.DataBankDashBoardList.Count > 0)
            {

                for (int i = 0; i < Model.DataBankDashBoardList.Count; i++)
                {

            <tr>
                <td data-label="Master Name">@Model.DataBankDashBoardList[i].Type</td>
                <td data-label="Edit / Delete">
                    @Model.DataBankDashBoardList[i].Action
            </td>
            <td data-label="Count">
                @Model.DataBankDashBoardList[i].count
            </td>
            </tr>


                }
            }

        </tbody>


    </table>

</div>