<div class="demo-section wide">

    @(Html.Kendo().Chart(Model)
        .Name("OpenPosition")       
        .HtmlAttributes(new { style = "width: 100%; height: 400px;" })
        .ChartArea(chartArea => chartArea
            .Background("transparent"))
        .Title(title => title
            .Text("")
            .Position(ChartTitlePosition.Bottom)
        )
        .Legend(legend => legend
            .Visible(false).Position(ChartLegendPosition.Right))
        .Events(events =>
        {
            events.LegendItemClick("function(e) { e.preventDefault(); }");
        })
        .SeriesDefaults(series =>
            series.Pie().StartAngle(150).AutoFit(true)

        )
        .Series(series =>
        {
            series.Pie(m => m.Count, m => m.Name);

            //series.Pie(new dynamic[] {
            //    new { category = Model.Today_Check_In_Time_Status[0].Type, value = Model.Today_Check_In_Time_Status[0].count, color = "#36B9EA" },
            //    new { category = Model.Today_Check_In_Time_Status[1].Type, value = Model.Today_Check_In_Time_Status[1].count, color = "#FB337B" },
            //    new { category = Model.Today_Check_In_Time_Status[2].Type, value = Model.Today_Check_In_Time_Status[2].count, color = "#44DABE" },
            //    new { category = Model.Today_Check_In_Time_Status[3].Type, value = Model.Today_Check_In_Time_Status[3].count, color = "#FCC103" },
            //});


        })
        .Tooltip(tooltip => tooltip
            .Visible(true)
            .Template("#= category # : #= value #")
        ).RenderAs(RenderingMode.Canvas)

    )




</div>


