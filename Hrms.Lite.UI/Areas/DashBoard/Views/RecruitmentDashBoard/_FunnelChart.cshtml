@model IEnumerable<Hrms.Lite.Shared.DashBoard.RecruitmentDashBoardChartList>
@using Kendo.Mvc.UI
<style>

    .wide p {
        display: none;
    }
</style>
<div class="demo-section wide">
    @(Html.Kendo().Chart(Model).Name("funnelChart")
    .HtmlAttributes(new { style = "width: 100%; height: 200px;" })
            .Series(series =>
                series.Funnel(m => m.Count,m=> m.Name)
            )
            //.Title(t => t.Text("October").Position(ChartTitlePosition.Bottom))
            .Legend(l => l.Visible(false))
            .SeriesDefaults(sd =>
            {
                sd.Funnel().Labels(lbls =>
                {
                    lbls.Visible(true)
                        .Background("transparent")
                        .Color("white")
                        .Format("N0");
                })
                .DynamicSlope(false)
                .DynamicHeight(false);
            })
            .Tooltip(tt => tt.Visible(true).Template("#=category#"))
            .RenderAs(RenderingMode.Canvas)
        )
    </div>
