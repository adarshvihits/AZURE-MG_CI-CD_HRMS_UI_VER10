@model Hrms.Lite.Shared.DashBoard.LandingPage
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="~/js/jquery.min.js"></script>
<script src="~/js/DataTables-1.11.3/js/jquery.dataTables.min.js" defer></script>

<script src="~/scripts/dashboard/landingpage.js"></script>
<link href="~/css/kendo/2023.1.117/kendo.bootstrap-main.min.css" rel="stylesheet" />
<script src="~/js/kendo/kendo.all.min.js"></script>
<script src="~/js/kendo/kendo.aspnetmvc.min.js"></script>

<style>
    .multiselect-filter {
        position: sticky;
        top: 0;
        z-index: 10;
        background-color: white;
    }

        .multiselect-filter .input-group {
            padding: 5px;
            margin: 0px;
            border-radius: 2px;
        }

    .multiselect-search {
        border-radius: 5px !important;
        height: 26px;
    }
</style>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">Login History</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "LandingPage", new { Area = "DashBoard" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Login History
                    </li>
                </ul>
            </div>
        </div>
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body " id="divListGraph">
                            
                            @await Html.PartialAsync("~/Areas/Dashboard/Views/LandingPage/_CombinedView.cshtml", Model)

                        </div>


                    </div>
                </div>
            </div>

        </div>

    </div>

</div>
