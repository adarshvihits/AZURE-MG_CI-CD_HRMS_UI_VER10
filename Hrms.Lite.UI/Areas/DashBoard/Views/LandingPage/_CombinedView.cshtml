@model Hrms.Lite.Shared.DashBoard.LandingPage

<div class="page_white" >
    <div class="row">
        <div class="col-md-6">

            <div class="row tab-style-button">

                <div class="tab-button-wrap">
                    <div class="tab-items ">
                        <label>From</label>
                        <div class="input-group date">
                            @Html.TextBoxFor(Model => Model.fromDate, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2",
                           @readonly = "true", @onchange = "validate(this, 'fromDte');onDateChange(); "
                       })
                            <div class="input-group-append">
                                <span class="input-group-text">
                                    <i class="la la-calendar"></i>
                                </span>
                            </div>
                        </div>
                        <span id="fromDte"></span>
                    </div>
                    <div class="tab-items ">
                        <label>To</label>
                        <div class="input-group date">
                            @Html.TextBoxFor(Model => Model.toDate, "{0:dd-MMM-yyyy}", 
                           new { @class = "form-control kt_datepicker_2", @readonly = "true", @onchange = " validate(this, 'toDte');onDateChange(); " })
                            <div class="input-group-append">
                                <span class="input-group-text">
                                    <i class="la la-calendar"></i>
                                </span>
                            </div>
                        </div>
                        <span id="toDte"></span>
                    </div>


                    <div class="tab-items select-option d-flex align-items-center">

                        <div class="sraech-slider" onclick="CursorFocusOnSearch()">
                            <div class="search-slider-inner">
                                <i class="fa fa-search"></i>
                            </div>
                            <input type="text" id="dataTableSearch" class="form-control form-control-sm"
                                   placeholder="Search here">

                        </div>

                    </div>




                </div>


            </div>





            <div id="loginlist">
                @await Html.PartialAsync("~/Areas/Dashboard/Views/LandingPage/_LoginList.cshtml", Model)
            </div>


        </div>
        <div class="col-md-6">

            <div class="  graph-hei-databank ">

                <div class="customGraph">
                    @await Html.PartialAsync("~/Areas/Dashboard/Views/LandingPage/_LoginChart.cshtml", Model.LoginDetailDiagram)
                </div>


            </div>
        </div>
    </div>
</div>