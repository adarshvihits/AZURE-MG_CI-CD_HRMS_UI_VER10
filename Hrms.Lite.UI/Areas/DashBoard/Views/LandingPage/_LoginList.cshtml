@model Hrms.Lite.Shared.DashBoard.LandingPage


<script src="~/js/settings.js"></script>

<div class="ihits-table table-border hover-color odd-even mobile-responsive-table login_details_list">
    <table id="loginTable" class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">Login Name</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Type</th>
                <th scope="col">Login Time</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.LoginDetails != null && Model.LoginDetails.Count > 0)
            {

                for (int i = 0; i < Model.LoginDetails.Count; i++)
                {
                    <tr>
                        <td data-label="Login Name">@Model.LoginDetails[i].UserName</td>
                        <td data-label="Employee Name">@Model.LoginDetails[i].EmpName</td>
                        <td data-label="Type">@Model.LoginDetails[i].Software</td>
                        <td data-label="Login Time">@Model.LoginDetails[i].LastLogin</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>