@model Hrms.Lite.Shared.DashBoard.LandingPage

<style>
    .blue_hover::before {
        background-color: rgba(122, 112, 186, 0.1);
    }

    .red_hover::before {
        background-color: rgb(250 158 52 / 15%);
    }

    .rose_hover::before {
        background-color: rgb(240 71 112 / 15%);
    }

    .green_hover::before {
        background-color: #3cd18826;
    }

    .high_class {
        background-color: #f04770;
        color: #fff;
        padding: 2px 5px;
        font-size: 9px;
        border-radius: 4px;
        margin-left: 10px;
        margin-right: 0px !important;
    }

    .medium_class {
        background-color: #ff7f15;
        color: #fff;
        padding: 2px 5px;
        font-size: 9px;
        border-radius: 4px;
        margin-left: 10px;
        margin-right: 0px !important;
    }

    .low_class {
        background-color: #ffc107;
        color: #fff;
        padding: 2px 5px;
        font-size: 9px;
        border-radius: 4px;
        margin-left: 10px;
        margin-right: 0px !important;
    }
</style>
<div class="notification_number payroll_notificationpage">
    <ul class="enrolled-class pl-0">

        @if (Model != null && Model.PayrollNotificationList.Count > 0)
        {
            int[] codes = { 10 };
            for (int i = 0; i < Model.PayrollNotificationList.Count; i = i + 1)
            {

                if (codes.Contains(Model.PayrollNotificationList[i].Code))
                {
                    @if (Model.PayrollNotificationList[i].Priority == "HIGH")
                    {


                        <a onclick="GetDataBankNotificationPopUp(@Model.PayrollNotificationList[i].Code,'@Model.PayrollNotificationList[i].Type')">
                        <li class="d-flex align-items-center gap-2 justify-content-between">


                            <div class="row d-flex justify-content-center w-100" style="align-items:center;">
                                <div class="col-md-8 d-flex" style="align-items:center;">
                                    <span class="  @Model.PayrollNotificationList[i].lightcolourclass" style="border: 1px solid @Model.PayrollNotificationList[i].colour ; background-color: @Model.PayrollNotificationList[i].colour ;"></span>
                                    <h5 class="text-truncate">@Model.PayrollNotificationList[i].Type</h5>
                                </div>


                                <div class="col-md-4">
                                    <div class="dropdown icon-dropdown pad-bt-r ">

                                        <div class="btn_notification btn_second_child" style="background-color: @Model.PayrollNotificationList[i].colour;" id="userdropdown12" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            @Model.PayrollNotificationList[i].count

                                            <div class="high_class">H</div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                            <div class="d-flex align-items-center p-0 ">



                            </div>
                            <div class="flex-shrink-0">

                            </div>
                        </li>
                        </a>
                    }
                    else if (Model.PayrollNotificationList[i].Priority == "MEDIUM")
                    {
                        <a onclick="GetDataBankNotificationPopUp(@Model.PayrollNotificationList[i].Code,'@Model.PayrollNotificationList[i].Type')">
                        <li class="d-flex align-items-center gap-2 justify-content-between">

                            <div class="row">
                                <div class="8">
                                    <span class="  @Model.PayrollNotificationList[i].lightcolourclass" style="border: 1px solid @Model.PayrollNotificationList[i].colour ; background-color: @Model.PayrollNotificationList[i].colour ;"></span>
                                    <h5 class="text-truncate">@Model.PayrollNotificationList[i].Type</h5>
                                </div>

                                <div class="4">
                                    <div class="dropdown icon-dropdown pad-bt-r ">
                                        <div class="medium_class">Medium</div>
                                        <div class="btn_notification btn_second_child" style="color: @Model.PayrollNotificationList[i].colour;" id="userdropdown12" type="button" data-bs-toggle="dropdown" aria-expanded="false">@Model.PayrollNotificationList[i].count</div>
                                    </div>
                                </div>

                            </div>

                            <div class="d-flex align-items-center">


                            </div>
                            <div class="flex-shrink-0">

                            </div>
                        </li>
                        </a>
                    }
                    else
                    {
                        <a onclick="GetDataBankNotificationPopUp(@Model.PayrollNotificationList[i].Code,'@Model.PayrollNotificationList[i].Type')">
                        <li class="d-flex align-items-center gap-2 justify-content-between">

                            <div class="row d-flex justify-content-center w-100" style="align-items:center;">
                                <div class="col-md-8 d-flex" style="align-items:center;">
                                    <span class="  @Model.PayrollNotificationList[i].lightcolourclass" style="border: 1px solid @Model.PayrollNotificationList[i].colour ; background-color: @Model.PayrollNotificationList[i].colour ;"></span>
                                    <h5 class="text-truncate">@Model.PayrollNotificationList[i].Type</h5>

                                </div>


                                <div class="col-md-4">
                                    <div class="dropdown icon-dropdown pad-bt-r ">
                                        <div class="btn_notification btn_second_child" style="background-color: @Model.PayrollNotificationList[i].colour;" id="userdropdown12" type="button" data-bs-toggle="dropdown" aria-expanded="false">
