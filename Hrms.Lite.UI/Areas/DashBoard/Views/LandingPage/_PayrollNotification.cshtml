                        </li>
                        </a>
                    }
                }
                else
                {




                    @if (Model.PayrollNotificationList[i].Priority == "HIGH")
                    {
                        <a onclick="OnPFMissingClick('@Model.PayrollNotificationList[i].Type', '@Model.PayrollNotificationList[i].Action')">

                            @*<a href="@Model.PayrollNotificationList[i].Action">*@
                        <li class="d-flex align-items-center gap-2 justify-content-between">

                            <div class="row d-flex justify-content-center w-100" style="align-items:center;">
                                <div class="col-md-8 d-flex" style="align-items:center;">

                                    <span class="  @Model.PayrollNotificationList[i].lightcolourclass" style="border: 1px solid @Model.PayrollNotificationList[i].colour ; background-color: @Model.PayrollNotificationList[i].colour ;"></span>
                                    <h5 class="text-truncate">@Model.PayrollNotificationList[i].Type</h5>

                                </div>


                                <div class="col-md-4">
