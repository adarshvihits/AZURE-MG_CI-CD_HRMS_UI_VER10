                                        <div class="btn_notification btn_second_child d-flex justify-content-center ml-2" style="background-color: @Model.PayrollNotificationList[i].colour;" id="userdropdown12" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            @Model.PayrollNotificationList[i].count
                                            <div class="high_class">H</div>

                                        </div>


                                    </div>


                                </div>

                            </div>



                        </li>
                        </a>
                    }
                    else if (Model.PayrollNotificationList[i].Priority == "MEDIUM")
                    {
                        <a onclick="OnPFMissingClick('@Model.PayrollNotificationList[i].Type', '@Model.PayrollNotificationList[i].Action')">
