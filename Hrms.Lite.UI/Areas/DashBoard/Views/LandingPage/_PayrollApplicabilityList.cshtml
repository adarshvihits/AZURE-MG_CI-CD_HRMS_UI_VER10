                                <td data-label="Name">Offday Wage</td>
                                <td data-label="Name"><div onclick="GetApplicableCountDetails('Offday Wage','YES')" class="notification_attendance_list">19</div></td>
                                <td data-label="Name"><div onclick="GetApplicableCountDetails('Offday Wage','NO')" class="notification_attendance">5788</div></td>
