                                <td data-label="Name"><div onclick="GetApplicableCountDetails('ESI','VARIANCE')" class="notification_attendance_count">2</div></td>


                            </tr>
                            <tr>
                                <td data-label="Name">PT</td>
                                <td data-label="Name"><div onclick="GetApplicableCountDetails('PT','YES')" class="notification_attendance_list">86</div></td>
                                <td data-label="Name"><div onclick="GetApplicableCountDetails('PT','NO')" class="notification_attendance">5721</div></td>
                                <td data-label="Name"><div onclick="GetApplicableCountDetails('PT','VARIANCE')" class="notification_attendance_count">1</div></td>


                            </tr>
                            <tr>
                                <td data-label="Name">LWF</td>
                                <td data-label="Name"><div onclick="GetApplicableCountDetails('LWF','YES')" class="notification_attendance_list">54</div></td>
