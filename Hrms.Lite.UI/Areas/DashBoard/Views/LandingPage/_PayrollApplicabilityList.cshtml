@model Hrms.Lite.Shared.DashBoard.LandingPage
    <style>
        .attendance_table {
            border-collapse: separate;
            border-spacing: 0 10px;
        }
        .ihits-table.table-border table tbody tr td {
            padding: 10px 6px !important;
            border: 1px dotted rgba(106, 113, 133, 0.3);
            border-right: none;
            border-left: 0;
        }
        .new-dash-table table tbody tr td:nth-child(1) {
            border-left: 1px dotted rgba(106, 113, 133, 0.3) !important;
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;
        }

        .new-dash-table table tbody tr td:nth-child(4) {
            border-right: 1px dotted rgba(106, 113, 133, 0.3) !important;
            border-top-right-radius: 8px;
            border-bottom-right-radius: 8px;
        }
        .ihits-table.table-border table tbody tr td:nth-child(1) {
            padding: 16px 11px !important;
        }
        .new-dash-table table thead tr th:nth-child(4) {
            border-top-right-radius: 8px;
            border-bottom-right-radius: 8px;
        }
        .new-dash-table table thead tr th:nth-child(1) {
            border-top-left-radius: 8px;
            border-bottom-left-radius: 8px;
         
        }
    </style>

    <div class="ihits-table table-border hover-color odd-even mobile-responsive new-dash-table   ">
        <table class="tble-new-color-chng attendance_table ">
            <thead>
                <tr class="table-color-new ">

                    <th class="table-radius-new-payroll" scope="col">Type</th>
                    <th scope="col">Yes</th>
                    <th scope="col">NO</th>
                    <th class="table-radius-new-payroll-end" scope="col">Change</th>

                </tr>
            </thead>
            <tbody>

                @if (Model != null && Model.PayrollApplicableList != null && Model.PayrollApplicableList.Count > 0)
                {
                    for (int i = 0; i < Model.PayrollApplicableList.Count; i++)
                    {

                        <tr>
                            <td data-label="Name">@Model.PayrollApplicableList[i].TYPE</td>
                            <td data-label="Name"><div onclick="GetApplicableCountDetails('@Model.PayrollApplicableList[i].TYPE','YES')" class="notification_attendance_list">@Model.PayrollApplicableList[i].YES</div></td>
                            <td data-label="Name"><div onclick="GetApplicableCountDetails('@Model.PayrollApplicableList[i].TYPE','NO')" class="notification_attendance">@Model.PayrollApplicableList[i].NO</div></td>
                            <td data-label="Name"><div onclick="GetApplicableCountDetails('@Model.PayrollApplicableList[i].TYPE','VARIANCE')" class="notification_attendance_count">@Model.PayrollApplicableList[i].CHANGE</div></td>


                        </tr>
