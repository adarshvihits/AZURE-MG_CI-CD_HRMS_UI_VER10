                                <td data-label="Name">LWF</td>
                                <td data-label="Name"><div onclick="GetApplicableCountDetails('LWF','YES')" class="notification_attendance_list">54</div></td>
                                <td data-label="Name"><div onclick="GetApplicableCountDetails('LWF','NO')" class="notification_attendance">5753</div></td>
                                <td data-label="Name"><div onclick="GetApplicableCountDetails('LWF','VARIANCE')" class="notification_attendance_count">0</div></td>


                            </tr>
