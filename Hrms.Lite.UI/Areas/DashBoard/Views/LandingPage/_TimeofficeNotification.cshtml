                            <div class="row d-flex justify-content-center w-100" style="align-items:center;">
                                <div class="col-md-8 d-flex" style="align-items:center;">
                                    <span class="  @Model.TimeOfficeNotificationList[i].lightcolourclass" style="border: 1px solid @Model.TimeOfficeNotificationList[i].colour ; background-color: @Model.TimeOfficeNotificationList[i].colour ;"></span>
                                    <h5 class="text-truncate">@Model.TimeOfficeNotificationList[i].Type</h5>

                                </div>



                                <div class="col-md-4">
                                    <div class="dropdown icon-dropdown pad-bt-r " >
                                        <div class="btn_notification btn_second_child d-flex justify-content-center ml-2" style="background-color: @Model.TimeOfficeNotificationList[i].colour;" id="userdropdown12" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            @Model.TimeOfficeNotificationList[i].count

                                            <div class="medium_class">M</div>

                                        </div>




                                    </div>
                                </div>


                            </div>



                        </li>
                        </a>
                    }
                    else
                    {
                        <a href="@Model.TimeOfficeNotificationList[i].Action">
                        <li class="d-flex align-items-center gap-2 justify-content-between">

                            <div class="row d-flex justify-content-center w-100" style="align-items:center;">
                                <div class="col-md-8 d-flex" style="align-items:center;">
                                    <span class="  @Model.TimeOfficeNotificationList[i].lightcolourclass" style="border: 1px solid @Model.TimeOfficeNotificationList[i].colour ; background-color: @Model.TimeOfficeNotificationList[i].colour ;"></span>
                                    <h5 class="text-truncate">@Model.TimeOfficeNotificationList[i].Type</h5>
                                </div>



                                <div class="col-md-4">

                                    <div class="dropdown icon-dropdown pad-bt-r " >
                                        <div class="btn_notification btn_second_child" style="background-color: @Model.TimeOfficeNotificationList[i].colour;" id="userdropdown12" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            @Model.TimeOfficeNotificationList[i].count

                                            <div class="low_class">L</div>

                                        </div>
                                    </div>
                                </div>



                            </div>


                        </li>
                        </a>
                    }


                }
            }
        }
    </ul>
</div>

