@model Hrms.Lite.Shared.DashBoard.LandingPage

<script src="~/js/settings.js"></script>
<style>
    .dataTables_scrollBody {
        height: 32vh !important;
    }
</style>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table salaryvarience-list ">
    <table class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Old Location</th>
                <th scope="col">New Location</th>
                <th scope="col">Effective Date</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.JobTransferPopupDetails != null && Model.JobTransferPopupDetails.Count > 0)
            {

                for (int i = 0; i < Model.JobTransferPopupDetails.Count; i++)
                {
            <tr>
                <td data-label="ID">@Model.JobTransferPopupDetails[i].EmpID</td>
                <td data-label="Employee Name">@Model.JobTransferPopupDetails[i].EmpName</td>
                <td data-label="Old Location">@Model.JobTransferPopupDetails[i].OLdLoc</td>
                <td data-label="New Location">@Model.JobTransferPopupDetails[i].NewLoc</td>
                <td data-label="Effective Date">@Model.JobTransferPopupDetails[i].EffDate</td>
            </tr>
                }
            }
        </tbody>
    </table>
</div>