@model Hrms.Lite.Shared.DashBoard.LandingPage

<script src="~/js/settings.js"></script>
<style>
    .dataTables_scrollBody {
        height: 32vh !important;
    }
</style>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table salaryvarience-list ">
    <table class="common-table">
        <thead>
            <tr class="table-dark">
                <th scope="col">ID</th>
                <th scope="col">Employee Name</th>
                <th scope="col">Old Designation</th>
                <th scope="col">New Designation</th>
                <th scope="col">Effective Date</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.PromotionPopupDetails != null && Model.PromotionPopupDetails.Count > 0)
            {

                for (int i = 0; i < Model.PromotionPopupDetails.Count; i++)
                {
                    <tr>
                        <td data-label="ID">@Model.PromotionPopupDetails[i].EmpID</td>
                        <td data-label="Employee Name">@Model.PromotionPopupDetails[i].EmpName</td>
                        <td data-label="Old Location">@Model.PromotionPopupDetails[i].OLdDesignation</td>
                        <td data-label="New Location">@Model.PromotionPopupDetails[i].NewDesignation</td>
                        <td data-label="Effective Date">@Model.PromotionPopupDetails[i].EffDate</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>