                                                            <div class="row">

                                                                <div class="col-md-3">
                                                                    <div class="row ">
                                                                        <div class="col-md-12">
                                                                            <div class="form-group newpasscode">
                                                                                <label class="">Company Code</label>
                                                                                @Html.TextBoxFor(m => m.CompanyID, new { @class = "form-control form-control-sm disable", @placeholder = "Company Code", @onblur = "validate(this,'CmpId')" })
                                                                                <span id="CmpId"></span>
                                                                            </div>
                                                                            <div class="form-group newpasscode">
                                                                                <label class="">Employee ID</label>
                                                                                @Html.TextBoxFor(m => m.EmployeeID, new { @class = "form-control form-control-sm disable", @placeholder = "Employee ID", @onblur = "validate(this,'EmpId')" })
                                                                                <span id="EmpId"></span>
                                                                            </div>
                                                                            <div class="form-group newpasscode">
                                                                                <label class="">Date Of Birth</label>
                                                                                <div class="input-group date">

                                                                                    @Html.TextBoxFor(m => m.DOB, "{0:dd-MMM-yyyy}", new { @class = "form-control kt_datepicker_2 disable", @readonly = "true", @placeholder = "Date Of Birth", @onchange = "validate(this,'DB')" })
                                                                                    <div class="input-group-append">
