@model Hrms.Lite.Shared.Master.UserRoleDetails

<div class="row">
    <div class="col-md-3">
        <div style="padding-top:10px;" class="ihits-table table-border hover-color odd-even mobile-responsive-table user-pop  vertical-scroll-250">

            <table id="PopUpTable">
                <thead>
                    <tr class="table-light">
                        <th scope="col">Sl No.</th>
                        <th scope="col">Designations</th>


                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Designation != null && Model.Designation.Count > 0)
                    {

                        for (int i = 0; i < Model.Designation.Count; i++)
                        {
                            <tr>
                                <td data-label="Sl">
                                    @(i +1)
                                </td>
                                <td data-label="Designation">
                                    @Model.Designation[i].Name
                                </td>

                            </tr>


                        }
                    }
                </tbody>


            </table>
        </div>


    </div>
    <div class="col-md-3">
        <div style="padding-top:10px;" class="ihits-table table-border hover-color odd-even mobile-responsive-table user-pop  vertical-scroll-250">

            <table id="PopUpTable">
                <thead>

                    <tr class="table-light">
                        <th scope="col">Sl No.</th>
                        <th scope="col">Region</th>


                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Region != null && Model.Region.Count > 0)
                    {

                        for (int i = 0; i < Model.Region.Count; i++)
                        {
                            <tr>
                                <td data-label="Sl">
                                    @(i+1)
                                </td>
                                <td data-label="">
                                    @Model.Region[i].Name
                                </td>

                            </tr>

                        }
                    }

                </tbody>


            </table>
        </div>


    </div>



    <div class="col-md-3">
        <div style="padding-top:10px;" class="ihits-table table-border hover-color odd-even mobile-responsive-table user-pop  vertical-scroll-250">

            <table id="PopUpTable">
                <thead>

                    <tr class="table-light">
                        <th scope="col">Sl No.</th>
                        <th scope="col"> Locations</th>


                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Location != null && Model.Location.Count > 0)
                    {

                        for (int i = 0; i < Model.Location.Count; i++)
                        {
                            <tr>
                                <td data-label="Sl">
                                    @(i+1)
                                </td>
                                <td data-label="Applicable Menu">
                                    @Model.Location[i].Name
                                </td>

                            </tr>

                        }
                    }

                </tbody>


            </table>
        </div>


    </div>
    <div class="col-md-3">
        <div style="padding-top:10px;" class="ihits-table table-border hover-color odd-even mobile-responsive-table user-pop  vertical-scroll-250">

            <table id="PopUpTable">
                <thead>

                    <tr class="table-light">
                        <th scope="col">Sl No.</th>
                        <th scope="col">Menus</th>


                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.ApplicableMenus != null && Model.ApplicableMenus.Count > 0)
                    {

                        for (int i = 0; i < Model.ApplicableMenus.Count; i++)
                        {
                            <tr>
                                <td data-label="Sl">
                                    @(i+1)
                                </td>
                                <td data-label="Applicable Menu">
                                    @Model.ApplicableMenus[i].Menus
                                </td>

                            </tr>

                        }
                    }

                </tbody>


            </table>
        </div>


    </div>
</div>
