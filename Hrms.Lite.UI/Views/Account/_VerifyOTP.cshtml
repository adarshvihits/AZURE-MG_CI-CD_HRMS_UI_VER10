@model Hrms.Lite.Shared.Account.ForgetPassword

<div class="row">
    <div class="col-md-3">
        <div class="form-group newpasscode">
            <label class="">Enter OTP</label>
            @Html.TextBoxFor(m => m.EnterOTP, new { @class = "form-control form-control-sm", @placeholder = "Enter OTP" })
        </div>

    </div>
    <div class="pt-5 col-md-3">
        <a type="button"
           class="btn btn-default  mobile-full-width " onclick="return Verify()">
            Verify
        </a>
    </div>

</div>
