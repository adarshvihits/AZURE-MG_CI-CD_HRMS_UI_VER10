@model Hrms.Lite.Shared.Account.ForgetPassword
    <script src="~/scripts/Account/login.js"></script>
    <div class="">
        <div class="row">
            <div class="col-md-3">

                <div class="form-group newpasscode">
                    <label class="">New Password</label>

                    @Html.TextBoxFor(m => m.NewPassword, new { @class = "form-control form-control-sm", @placeholder = "New Password", @type = "password", @onkeyup = " validatePolicy()" })
                    <span id="newpwd"></span>
                </div>
                <div class="form-group newpasscode">
                    <label class="">Confirm Password</label>

                    @Html.TextBoxFor(m => m.ConfirmPassword, new { @class = "form-control form-control-sm", @placeholder = "Confirm Password", @type = "password", @onblur = "validateconfirm(this,'confirmpwd')" })
                    <span id="confirmpwd"></span>
                </div>
                <div class="row  ">

                    <div class="col-md-12 align-right">
                        <a type="button" style="width:100% ;"
                           class="btn btn-default  mobile-full-width m-0" onclick="ForgotPasswordSave()">
                            Save
                        </a>

                    </div>

                </div>
            </div>

            <div class="col-md-4">


                <div class="pt-4">
                    <h4 class="changepass">
                        Your Password Should Meet The Below
                        Requirements
                    </h4>
                    <ul class="pass">
                        <li id="minmaxPassword" class="list-style list-cancelicon">
                            @Html.HiddenFor(m => m.PasswordPolicySettings.MinimumLength)
                            @Html.HiddenFor(m => m.PasswordPolicySettings.MaximumLength)
                            @Html.HiddenFor(m => m.PasswordPolicySettings.MinimumUppercaseLetters)
                            @Html.HiddenFor(m => m.PasswordPolicySettings.MinimumLowercaseLetters)
                            @Html.HiddenFor(m => m.PasswordPolicySettings.MinimumSpecialCharacter)
                            @Html.HiddenFor(m => m.PasswordPolicySettings.MinimumNumericValues)

                            At least @Model.PasswordPolicySettings.MinimumLength characters (Maximum @Model.PasswordPolicySettings.MaximumLength Character)
                        </li>
                        @if (Model.PasswordPolicySettings.MinimumUppercaseLetters != 0)
                        {
                            <li id="upperPassword" class="list-style list-cancelicon">
                                At least @Model.PasswordPolicySettings.MinimumUppercaseLetters uppercase letter
                            </li>
                        }
                        @if (Model.PasswordPolicySettings.MinimumLowercaseLetters != 0)
                        {
                            <li id="lowerPassword" class="list-style list-cancelicon">
                                At least @Model.PasswordPolicySettings.MinimumLowercaseLetters lowercase letter
                            </li>
                        }
                        @if (Model.PasswordPolicySettings.MinimumSpecialCharacter != 0)
                        {
                            <li id="specialPassword" class="list-style list-cancelicon">
                                At least @Model.PasswordPolicySettings.MinimumSpecialCharacter special character - supported special
                                charactera are ! @@ # $ % ^ & * ()
                            </li>
                        }
                        @if (Model.PasswordPolicySettings.MinimumNumericValues != 0)
                        {
                            <li id="numeralPassword" class="list-style list-cancelicon">
                                At least @Model.PasswordPolicySettings.MinimumNumericValues numeral value
                            </li>
                        }
                        <li>
                            Password will be vaild for @Model.PasswordPolicySettings.PasswordExpiryDays days
                        </li>
                        @if (@Model.PasswordPolicySettings.EnforcePasswordHistory != 0)
                        {
                            <li>
                                Do not repeat the last @Model.PasswordPolicySettings.EnforcePasswordHistory passwords
                            </li>
                        }
                    </ul>
                </div>


            </div>

        </div>
    </div>
