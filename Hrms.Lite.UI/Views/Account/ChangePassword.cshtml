@model Hrms.Lite.Shared.Account.ChangePassword
@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json;
@{

    Hrms.Lite.Shared.Account.Login CurrentUserrr = JsonConvert.DeserializeObject<Hrms.Lite.Shared.Account.Login>(Context.Session.GetString("User"));
    if (@CurrentUserrr.authUser.IsNewLogin != true)
        Layout = "~/Views/Shared/_Layout.cshtml";
    else
        Layout = "~/Views/Shared/_LayoutChangePwd.cshtml";

}
<script src="~/js/jquery.min.js"></script>
<script src="~/scripts/Account/login.js"></script>

<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Change Password
                </h3>
                @*@if (@CurrentUserrr.authUser.IsNewLogin != true){
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>
                    <li class="breadcrumb-item text-muted">
                        Change Password

                    </li>

                </ul>
                }*@

            </div>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<!--begin::Content-->


<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->

            <div class="row height-100per">

                <div class="col-md-12">
                    <div class="card card-custom height-100per">

                        <div class="card-body">
                            <div class="changepassword">
                                <div class=" pb-3">
                                    <h4 class="changeword">Change Password</h4>
                                </div>
                                <div class="row tab-style-button">
                                    @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "changePass" }))
                                    {
                                        <div class="col-md-3">
                                            <div class="row ">
                                                <div class="col-md-12">
                                                    <div class="form-group newpasscode">
                                                        <label class="">Enter Current Password</label>
                                                        @Html.TextBoxFor(m => m.EnterCurrentPassword, new { @class = "form-control form-control-sm", @placeholder = "Enter Current Password", @type = "password", @onblur = "validate(this,'currentpwd')" })
                                                        <span id="currentpwd"></span>
                                                    </div>
                                                    <div class="form-group newpasscode">
                                                        <label class="">New Password</label>
                                                        @Html.TextBoxFor(m => m.NewPassword, new { @class = "form-control form-control-sm", @placeholder = "New Password", @type = "password", @onkeyup = " validatePolicy()" })
                                                        <span id="newpwd"></span>
                                                    </div>
                                                    <div class="form-group newpasscode">
                                                        <label class="">Confirm Password</label>
                                                        @Html.TextBoxFor(m => m.ConfirmPassword, new { @class = "form-control form-control-sm", @placeholder = "Confirm Password", @type = "password", @onblur = "validateconfirm(this,'confirmpwd')" })
                                                        <span id="confirmpwd"></span>
                                                    </div>
                                                    @{string HideClass = ""; }
                                                    @if (Model.PasswordPolicySettings.ChangePasswordOTPRequired == true)
                                                    {
                                                        HideClass = "hide";
                                                        <div id="verifyOtp" class="d-flex align-items-center justify-content-between hide">
                                                            <div class="form-group">
                                                                @Html.TextBoxFor(m => m.OTP, new { @class = "form-control form-control-sm", @placeholder = "Enter OTP", @onblur = "validate(this,'otpSpan')" })
                                                                <span id="otpSpan"></span>
                                                            </div>
                                                            <div>
                                                                <button type="button" id="verOTP" class="btn btn-default  mobile-full-width" onclick="ChangePasswordVerify()">
                                                                    Verify
                                                                </button>
                                                            </div>
                                                        </div>
                                                    }
                                                    <div class="row chPwd @HideClass my-3">

                                                        <div class="col-md-12 align-right">
                                                            <a type="button" style="width:100% ;"
                                                               class="btn btn-default  mobile-full-width m-0" onclick="ChangePassword()">
                                                                Save
                                                            </a>

                                                        </div>

                                                    </div>
                                                </div>

                                            </div>
                                        </div>
                                    }
                                    @if (Model.PasswordPolicySettings.ChangePasswordOTPRequired == true)
                                    {
                                        <div class="col-md-2 d-flex">
                                            <div>
                                                <button type="button" class="btn btn-default  mobile-full-width genOtp" onclick="ChangePasswordGenerateOTP()" style=" margin-top: 160px; " >
                                                    Generate OTP
                                                </button>
                                            </div>
                                        </div>
                                    }
                                    <div class="col-md-6">


                                        <div class="pt-4">
                                            <h4 class="changepass">
                                                Your Password Should Meet The Below
                                                Requirements
                                            </h4>
                                            <ul class="pass">
                                                <li id="minmaxPassword" class="list-style list-cancelicon">
                                                    @Html.HiddenFor(m => m.PasswordPolicySettings.MinimumLength)
                                                    @Html.HiddenFor(m => m.PasswordPolicySettings.MaximumLength)
                                                    @Html.HiddenFor(m => m.PasswordPolicySettings.MinimumUppercaseLetters)
                                                    @Html.HiddenFor(m => m.PasswordPolicySettings.MinimumLowercaseLetters)
                                                    @Html.HiddenFor(m => m.PasswordPolicySettings.MinimumSpecialCharacter)
                                                    @Html.HiddenFor(m => m.PasswordPolicySettings.MinimumNumericValues)

                                                    At least @Model.PasswordPolicySettings.MinimumLength characters (Maximum @Model.PasswordPolicySettings.MaximumLength Character)
                                                </li>
                                                @if (Model.PasswordPolicySettings.MinimumUppercaseLetters != 0) {
                                                <li id="upperPassword" class="list-style list-cancelicon">
                                                    At least @Model.PasswordPolicySettings.MinimumUppercaseLetters uppercase letter
                                                </li>
                                                }
                                                @if (Model.PasswordPolicySettings.MinimumLowercaseLetters != 0) {
                                                <li id="lowerPassword" class="list-style list-cancelicon">
                                                    At least @Model.PasswordPolicySettings.MinimumLowercaseLetters lowercase letter
                                                </li>
                                                }
                                                @if (Model.PasswordPolicySettings.MinimumSpecialCharacter != 0) {
                                                <li id="specialPassword" class="list-style list-cancelicon">
                                                    At least @Model.PasswordPolicySettings.MinimumSpecialCharacter special character - supported special
                                                    charactera are ! @@ # $ % ^ & * ()
                                                </li>
                                                }
                                                @if (Model.PasswordPolicySettings.MinimumNumericValues != 0) {
                                                <li id="numeralPassword" class="list-style list-cancelicon">
                                                    At least @Model.PasswordPolicySettings.MinimumNumericValues numeral value
                                                </li>
                                                }
                                                <li>
                                                    Password will be vaild for @Model.PasswordPolicySettings.PasswordExpiryDays days
                                                </li>
                                                @if (@Model.PasswordPolicySettings.EnforcePasswordHistory != 0) {
                                                <li>
                                                    Do not repeat the last @Model.PasswordPolicySettings.EnforcePasswordHistory passwords
                                                </li>
                                                }
                                            </ul>
                                        </div>


                                    </div>

                                </div>


                            </div>



                        </div>
                    </div>
                </div>

                <!--
                <end col-12></end> -->



            </div>




            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->
</div>
<!--end::Content-->
