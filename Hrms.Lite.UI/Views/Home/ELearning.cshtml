
@{

    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!--begin::Header-->
<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->

        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">ELearning Dashboard</h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="@Url.Action("Index", "Home", new { Area = "" })" class="">
                            <i class="icon-nm fas fa-home mt-1"></i>
                        </a>
                    </li>

                    <li class="breadcrumb-item text-muted">
                        ELearning Dashboard
                    </li>
                </ul>








            </div>




        </div>


    </div>
    <!--end::Container-->
</div>
<!--end::Header-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per h-100 footer-row-fixed p-0">

                <div class="card-body p-0">
                    <div class="row">
                        <div class="col-md-3">

                            <div class="dlab-cource bg-primary-gradient">
                                <div class="d-flex align-items-center">
                                    <span class="course-icon">
                                        <img src="~/js/e-learn/01.svg"  class="bg-ico"/>
                                    </span>
                                    <div class="ms-2">
                                        <h4 class="mb-0">1.500</h4>
                                        <span>All Lession</span>
                                    </div>
                                </div>
                                <img class="" src="~/js/e-learn/01-white.svg" style="width:90px;" alt="">
                            </div>




                        </div>





                        <div class="col-md-3">

                            <div class="dlab-cource bg-danger-gradient">
                                <div class="d-flex align-items-center">
                                    <span class="course-icon">
                                        <img src="~/js/e-learn/02.svg" class="bg-ico" />
                                    </span>
                                    <div class="ms-2">
                                        <h4 class="mb-0">1.500</h4>
                                        <span>Lession</span>
                                    </div>
                                </div>
                                <img class="" src="~/js/e-learn/02-white.svg" style="width:90px;" alt="">
                            </div>




                        </div>





                        <div class="col-md-3">

                            <div class="dlab-cource bg-success-gradient ">
                                <div class="d-flex align-items-center">
                                    <span class="course-icon">
                                        <img src="~/js/e-learn/03.svg" class="bg-ico" />
                                    </span>
                                    <div class="ms-2">
                                        <h4 class="mb-0">1.500</h4>
                                        <span>Course Completed </span>
                                    </div>
                                </div>
                                <img class="" src="~/js/e-learn/03-white.svg" style="width:90px;" alt="">
                            </div>




                        </div>


                        <div class="col-md-3">
                     
                            <div class="dlab-cource bg-warning-gradient">
                                <div class="d-flex align-items-center">
                                    <span class="course-icon">
                                        <img src="~/js/e-learn/04.svg" class="bg-ico" />
                                    </span>
                                    <div class="ms-2">
                                        <h4 class="mb-0">1.500</h4>
                                        <span>New Joined</span>
                                    </div>
                                </div>
                                <img src="~/js/e-learn/04-white.svg" style="width:90px;" alt="" />
                            </div>




                        </div>

                    </div>
                    <div class="row">




                        <div class="col-md-6">

                            <div class="card">
                                <div class="card-body">

                                    <img src="~/js/e-learn/graph.JPG" class="img-fluid" />
                                </div>
                            </div>







                        </div>

                        <div class="col-md-6">

                            <div class="card">
                                <div class="card-body">

                                    <img src="~/js/e-learn/graph.JPG" class="img-fluid" />
                                </div>
                            </div>







                        </div>















                        
                    </div>
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>
    <!--end::Entry-->

</div>
