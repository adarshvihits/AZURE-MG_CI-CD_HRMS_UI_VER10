@model Hrms.Lite.Shared.Account.CustomSoftware

<script src="~/scripts/logoupload.js"></script>
@if (ViewBag.Type == "SoftwareLogo")
{

    @using (Html.BeginForm("UploadSoftwareLogo", "CustomizeSoftware", FormMethod.Post, new {@id="uploadLogo", @class = "display-flex", enctype = "multipart/form-data" }))
    {
        <div id="kt_header" class="header header-fixed">
            <!--begin::Container-->
            <div class="container-fluid d-flex align-items-stretch justify-content-between">
                <!--begin::Header Menu Wrapper-->
                <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
                    <!--begin::Header Menu-->
                    <div class="d-flex align-items-baseline flex-wrap mr-5">
                        <h3 class="main-title">
                            Upload Software Logo
                        </h3>
                        <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                            <li class="breadcrumb-item ">
                                <a href="dashboard.html"><i class="icon-nm fas fa-home"></i></a>
                            </li>

                            <li class="breadcrumb-item text-muted">
                                Upload Software Logo

                            </li>

                        </ul>
                    </div>
                </div>
                <!--end::Header Menu Wrapper-->
                <!--begin::Topbar-->
                <!--end::Topbar-->
            </div>
            <!--end::Container-->
        </div>

        <!--begin::Wrapper-->
        <div class="content d-flex flex-column flex-column-fluid" id="kt_content">
            <!--begin::Header-->
            <!--begin::Entry-->
            <div class="d-flex flex-column-fluid">
                <!--begin::Container-->
                <div class="container full-width">
                    <!--begin::Dashboard-->
                    <!--begin::Row-->



                    <div class="card card-custom height-100per footer-row-fixed">

                        <div class="card-body">
                            <!--begin: Search Form-->
                          

                            <div class="page_white">
                               
                              
                               
                                <div class="row">
                                    <div class="col-md-3">
                                        @Html.TextBoxFor(m => m.SoftwareLogo.FileData, new { @type = "file", @class = "form-control" })

                                        <span class="Mandatory">Please Upload SVG Logo</span>
                                        <div class="profile-header-overflow"></div>
                                        <div class="form-group pt-3">
                                            <input type="submit" value="Upload" />
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        @Html.TextBoxFor(m => m.SoftwareLogo.FileData, new { @type = "file", @class = "form-control" })

                                        <span class="Mandatory">Please Upload JPG Logo</span>
                                        <div class="profile-header-overflow"></div>
                                        <div class="form-group pt-3">
                                            <input type="button" value="Upload" onclick="uploadjpglogo()" />
                                        </div>
                                    </div>
                                </div>


                                        <br />

                                        <span>@Html.Raw(ViewBag.Message)</span>

                                 








                            </div>




                            <!--end: Datatable-->
                        </div>
                    </div>


                    <!--end::Row-->
                    <!--begin::Row-->
                    <!--end::Row-->
                    <!--end::Dashboard-->
                </div>
                <!--end::Container-->
            </div>


        </div>
        <!--end::Wrapper-->
        }
    }

else

    @using(Html.BeginForm("UploadSoftwareName", "CustomizeSoftware", FormMethod.Post, new
    { @class = "display-flex",
enctype = "multipart/form-data"
}))
{

<div id="kt_header" class="header header-fixed">
    <!--begin::Container-->
    <div class="container-fluid d-flex align-items-stretch justify-content-between">
        <!--begin::Header Menu Wrapper-->
        <div class="header-menu-wrapper header-menu-wrapper-left" id="kt_header_menu_wrapper">
            <!--begin::Header Menu-->
            <div class="d-flex align-items-baseline flex-wrap mr-5">
                <h3 class="main-title">
                    Upload Software Name
                </h3>
                <ul class="breadcrumb breadcrumb-transparent breadcrumb-dot font-weight-bold p-0 my-2 font-size-sm">
                    <li class="breadcrumb-item ">
                        <a href="dashboard.html"><i class="icon-nm fas fa-home"></i></a>
                    </li>
                    <!-- <li class="breadcrumb-item text-muted">
                      <a href="financial-year.html">Financial Year List</a>
                    </li> -->
                    <li class="breadcrumb-item text-muted">
                        Upload Software Name

                    </li>

                </ul>
            </div>
        </div>
        <!--end::Header Menu Wrapper-->
        <!--begin::Topbar-->
        <!--end::Topbar-->
    </div>
    <!--end::Container-->
</div>

<!--begin::Wrapper-->
<div class="content d-flex flex-column flex-column-fluid" id="kt_content">
    <!--begin::Header-->
    <!--begin::Entry-->
    <div class="d-flex flex-column-fluid">
        <!--begin::Container-->
        <div class="container full-width">
            <!--begin::Dashboard-->
            <!--begin::Row-->



            <div class="card card-custom height-100per footer-row-fixed">

                <div class="card-body">
                    <!--begin: Search Form-->
                    @*<div class="profile-header position-relative box-shadow-none mb-2">
                            <input type="file" name="postedFile" class="form-control" />
                            <span class="Mandatory">Plesae Upload .svg files</span>
                            <div class="profile-header-overflow"></div>
                        </div>*@

                    <div class="mb-3">
                        <label for="formFile" class="form-label">HRMS NAME </label>
                        @Html.TextBoxFor(m => m.HRMS_SoftwareName.FileData, new { @type = "file", @class = "form-control" })
                        <span> saved file name:</span> @Html.DisplayFor(m => m.HRMS_SoftwareName.FileName)
                        <br />   <br />   <br />
                        <label for="formFile" class="form-label">ESSP NAME</label>
                        @Html.TextBoxFor(m => m.SoftwareName.FileData, new { @type = "file", @class = "form-control" })
                        <span> saved file name:</span> @Html.DisplayFor(m => m.SoftwareName.FileName)




                    </div>


                    <div class="page_white">

                        <div class="row">
                            <div class="col-md-7">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <input type="submit" value="Upload" />
                                        </div>
                                    </div>

                                </div>


                                <br />

                                <span>@Html.Raw(ViewBag.Message)</span>

                            </div>







                        </div>

                    </div>




                    <!--end: Datatable-->
                </div>
            </div>


            <!--end::Row-->
            <!--begin::Row-->
            <!--end::Row-->
            <!--end::Dashboard-->
        </div>
        <!--end::Container-->
    </div>


</div>
<!--end::Wrapper-->

}