<style>

    .btn-container {
        --btn-container-bg: #f9edd2;
        --btn-container-border: #edca78;
    }

    .active,
    input[type="radio"]:checked + label {
        --active-btn-bg: #fffdfa;
        --active-btn-box-shadow: rgba(237, 202, 120, 0.6);
        --active-btn-text: #b48218;
    }

    .inactive,
    label {
        --inactive-btn-text: #b48218;
    }

    /*Needed for both*/

    .btn-container {
        display: flex;
        flex-direction: row;
        justify-content: space-around;
        align-items: center;
        padding: 3px;
        margin-right: 12px;
        background-color: #ffffff;
        border: #b3ab99 1px solid;
        width: 25%;
        height: 34px;
        margin-top: 5px;
        border-radius: 10px;
    }
    

    /*To be used with links on individual pages*/

        .btn-container .active,
        .inactive {
            width: 45.5%;
            height: 60%;
            padding: 10px 20px;
            border: 0px;
            border-radius: 8px;
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
        }

    .btn-container .active {
        background-color: var(--active-btn-bg);
        box-shadow: 0 0 10px 1px var(--active-btn-box-shadow);
        font-weight: bold;
        color: var(--active-btn-text);
    }

    .btn-container .inactive {
        background-color: transparent;
        color: var(--inactive-btn-text);
        text-decoration: none;
    }

    /*To be used as radio buttons*/

    input[type="radio"] {
        visibility: hidden;
        height: 0;
        width: 0;
        margin: 0;
    }

    .btn-container label {
        width: 48.5%;
        height: 60%;
        font-size: 12px;
        font-weight: 400;
        padding: 11px 3px;
        border: 0px;
        border-radius: 5px;
        cursor: pointer;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        color: #657389;
    }

    input[type="radio"]:checked + label {
        background-color: #37b678;
        /* box-shadow: 0 0 10px 1px rgb(162 183 173); */
        font-weight: bold;
        color: #ffffff;
    }

</style>

