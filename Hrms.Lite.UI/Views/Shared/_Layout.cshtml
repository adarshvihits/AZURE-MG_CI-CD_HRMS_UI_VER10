<script>
    function onGrpcompChange(sender) {
        var grp = $(sender).val();
        $.ajax({
            type: 'Get',
            url: '/DashBoard/LandingPage/GroupCompnyChange',
            dataType: 'json',
            data: { GrpCompanyCode: $(sender).val() },
            success: function (response) {
                debugger
                console.log(response); if (response == true) {
                    document.getElementById("GroupCompanyCode").value = grp;
                    document.getElementById('landingGrp').submit();
                }
            },

            error: function (xhr, textStatus, errorThrown) {
                debugger
                document.body.id = "kt_body";
                $('body').html(xhr.responseText);
            }
        });
    }
    function myFunction() {
        var x = document.getElementById("kt_aside");
        if (x.style.display === "none") {
            x.style.left = "0px";
            /* x.style.width = "280px";*/
            x.style.display = "block";
        } else {
            x.style.display = "none";
            x.style.left = "-280px";
        }
    }

    function onBodyClick() {
        $('#kt_aside').css('display', 'none');
        searchInput.classList.remove("active");
        $('#msd').val('');
    }

</script>

