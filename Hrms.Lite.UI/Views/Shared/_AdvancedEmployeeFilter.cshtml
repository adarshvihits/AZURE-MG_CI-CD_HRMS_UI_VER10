                            </div>
                        </div>


                        <div class="col-md-3 hide" id="yosDiv">
                            <label></label>
                            <div class="form-group mt-6 mt-m-2px">
                                @Html.TextBoxFor(m => m.Advance_Filter.YrsOfExperience, new { @class = "form-control form-control-sm reset", @placeholder = "", @onblur = "validate(this,'yosfrom')" })
