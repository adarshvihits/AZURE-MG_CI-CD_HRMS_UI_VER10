                <div class="filter-slider-item-box">
                    <h4>Date Filter</h4>
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group">
                                <label>Type</label>

                                @Html.HiddenFor(m => m.Date_Filter.DateType.Name)

                                @Html.DropDownListFor(m => m.Date_Filter.DateType.Code, (SelectList)Model.Advance_Filter.DateType, "All", new
                                {
                                    @class = "form-control form-control-sm reset"
                               ,
                                    @onchange = "OnDateTypeChange()"
                           })
                            </div>
                        </div>
                        <div class="col-md-4 pr-1 hide" id="fromDate">
                            <div class="form-group">
                                <label>From</label>
                                <div class="input-group date">

                                    @Html.TextBoxFor(m => m.Date_Filter.FromDate, "{0:dd-MMM-yyyy}", new
                                    {
                                        @class = "form-control kt_datepicker_2 reset",
                                        @readonly = "readonly",
                                   @placeholder = "Date",
                                   //@onchange = "onFromDateChange()"
                               })
                                    <div class="input-group-append">
                                        <span class="input-group-text">
                                            <i class="la la-calendar"></i>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 pl-1 hide" id="toDate">
