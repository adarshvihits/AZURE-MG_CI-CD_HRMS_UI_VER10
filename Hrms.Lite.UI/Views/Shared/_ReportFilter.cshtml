

@model Hrms.Lite.Shared.General.Filter
<script src="~/scripts/filter.js"></script>


@using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "display-flex", @id = "BasicFilter" }))
{


    <div id="filterForm" class="slider-forms basicFilter">
        <div class="slider-inner-style new-inner-style">
            <div class="slider-form-close"><i class="ki ki-close icon-xs text-muted" onclick="CloseSlider('basicFilter')"></i></div>

            <div class="location-slider">
                <h4>Basic Filter</h4>
            </div>

            <div class="add-padding">
                <div class="filter-slider-item-box">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Functional Designation</label>

                                @Html.HiddenFor(m => m.Tabindex)
                                @Html.HiddenFor(m => m.SearchId)
                                @Html.HiddenFor(m => m.Basic_Filter.Designation.Name)
                                @Html.DropDownListFor(m => m.Basic_Filter.Designation.Code, (SelectList)Model.Basic_Filter.Designation.DropdownData, "All", new { @class = "form-control form-control-sm reset", onchange = "onDesignationChange()" })



                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Department</label>
                                @Html.HiddenFor(m => m.Basic_Filter.Department.Name)

                                @Html.DropDownListFor(m => m.Basic_Filter.Department.Code, (SelectList)Model.Basic_Filter.Department.DropdownData, "All", new { @class = "form-control form-control-sm reset", onchange = "onDepartmentChange()" })

                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Location</label>

                                @Html.HiddenFor(m => m.Basic_Filter.Location.Name)

                                @Html.DropDownListFor(m => m.Basic_Filter.Location.Code, (SelectList)Model.Basic_Filter.Location.DropdownData, "All", new { @class = "form-control form-control-sm reset", onchange = "onLocationChange()" })

                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Category</label>

                                @Html.HiddenFor(m => m.Basic_Filter.Category.Name)

                                @Html.DropDownListFor(m => m.Basic_Filter.Category.Code, (SelectList)Model.Basic_Filter.Category.DropdownData, "All", new { @class = "form-control form-control-sm reset", onchange = "onCategoryChange()" })

                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Designation</label>
                                @Html.HiddenFor(m => m.Basic_Filter.Grade.Name)

                                @Html.DropDownListFor(m => m.Basic_Filter.Grade.Code, (SelectList)Model.Basic_Filter.Grade.DropdownData, "All", new { @class = "form-control form-control-sm reset", onchange = "onGradeChange()" })

                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Payroll Group</label>
                                @Html.HiddenFor(m => m.Basic_Filter.PayrollGroup.Name)

                                @Html.DropDownListFor(m => m.Basic_Filter.PayrollGroup.Code, (SelectList)Model.Basic_Filter.PayrollGroup.DropdownData, "All", new { @class = "form-control form-control-sm reset", onchange = "onPayRollGroup()" })

                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Region</label>
                                @Html.HiddenFor(m => m.Basic_Filter.Region.Name)

                                @Html.DropDownListFor(m => m.Basic_Filter.Region.Code, (SelectList)Model.Basic_Filter.Region.DropdownData, "All", new { @class = "form-control form-control-sm reset", onchange = "onRegionFilterChange()" })

                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label>State</label>
                                @Html.HiddenFor(m => m.Basic_Filter.State.Name)

                                @Html.DropDownListFor(m => m.Basic_Filter.State.Code, (SelectList)Model.Basic_Filter.State.DropdownData, "All", new { @class = "form-control form-control-sm reset", onchange = "onStateFilterChange()" })

                            </div>
                        </div>
                    </div>


                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>PF Group</label>
                                @Html.HiddenFor(m => m.Basic_Filter.PFGroup.Name)

                                @Html.DropDownListFor(m => m.Basic_Filter.PFGroup.Code, (SelectList)Model.Basic_Filter.PFGroup.DropdownData, "All", new { @class = "form-control form-control-sm reset", onchange = "onPfGroupFilterChange()" })

                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="form-group">
                                <label>ESI Group</label>
                                @Html.HiddenFor(m => m.Basic_Filter.ESIGroup.Name)

                                @Html.DropDownListFor(m => m.Basic_Filter.ESIGroup.Code, (SelectList)Model.Basic_Filter.ESIGroup.DropdownData, "All", new { @class = "form-control form-control-sm reset", onchange = "onEsiGroupFilterChange()" })

                            </div>
                        </div>
                    </div>



                </div>
                <div class="filter-slider-item-box">
                    <h4>Optional Filter</h4>
                    <div class="row">


                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Division</label>
                                @Html.HiddenFor(m => m.Optional_Filter.Division.Name)

                                @Html.DropDownListFor(m => m.Optional_Filter.Division.Code, (SelectList)Model.Optional_Filter.Division.DropdownData, "All", new { @class = "form-control form-control-sm reset", onchange = "OnDivisionchange()" })



                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Section</label>
                                @Html.HiddenFor(m => m.Optional_Filter.Section.Name)
                                @Html.DropDownListFor(m => m.Optional_Filter.Section.Code, (SelectList)Model.Optional_Filter.Section.DropdownData, "All", new { @class = "form-control form-control-sm reset", onchange = "onSectionChange()" })

                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Employment Type</label>
                                @Html.HiddenFor(m => m.Optional_Filter.EmploymentType.Name)
                                @Html.DropDownListFor(m => m.Optional_Filter.EmploymentType.Code, (SelectList)Model.Optional_Filter.EmploymentType.DropdownData, "All", new { @class = "form-control form-control-sm reset", onchange = "OnEmploymentTypeChange()" })

                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Work Location</label>
                                @Html.HiddenFor(m => m.Optional_Filter.WorkLocation.Name)
                                @Html.DropDownListFor(m => m.Optional_Filter.WorkLocation.Code, (SelectList)Model.Optional_Filter.WorkLocation.DropdownData, "All", new { @class = "form-control form-control-sm reset", onchange = "OnWorkLocationChange()" })

                            </div>
                        </div>
                    </div>
                    <div class="row">

                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Wage Grade</label>
                                @Html.HiddenFor(m => m.Optional_Filter.WageGradeMaster.Name)
                                @Html.DropDownListFor(m => m.Optional_Filter.WageGradeMaster.Code, (SelectList)Model.Optional_Filter.WageGradeMaster.DropdownData, "All", new { @class = "form-control form-control-sm reset", onchange = "onWageGradeChange()" })

                            </div>
                        </div>
                      
                      
                    </div>
                 

                </div>

                

                <div class="row card-footer-bottom-fixed border-none">
                    <div class="col-md-12 align-right">
                        <button type="button" class="btn btn-secondary  mobile-full-width" onclick="ApplyFilter('reset')">
                            Reset
                        </button>
                        <button type="button" class="btn btn-default  mobile-full-width" onclick="ApplyFilter('apply')">

                            Apply
                        </button>
                    </div>

                </div>

            </div>



        </div>


    </div>
}