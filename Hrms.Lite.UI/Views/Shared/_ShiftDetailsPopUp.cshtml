@model   Hrms.Lite.Shared.DataBank.Generic.Master.ShiftDetails
    <script src="~/js/tooltip.js"></script>
<div class="ihits-table table-border hover-color odd-even mobile-responsive-table shift_details vertical-scroll-250">
    <table>
        <thead>
            <tr class="table-dark">
                <th scope="col" data-bs-toggle="tooltip" title=""
                   data-bs-original-title="Shift Name">Shft Name</th>
                <th scope="col" data-bs-toggle="tooltip" title=""
                   data-bs-original-title="Shift Code">Shft Code</th>
                <th scope="col" data-bs-toggle="tooltip" title=""
                   data-bs-original-title="Shift Category">Shft Cate</th>
                <th scope="col" >Start Time</th>
                <th scope="col">End Time</th>
                <th scope="col" data-bs-toggle="tooltip" title=""
                   data-bs-original-title="Scheduled Hours">Sch. Hrs </th>
                <th scope="col" data-bs-toggle="tooltip" title=""
                   data-bs-original-title="Full day Hours">FD Hrs</th>
                <th scope="col" data-bs-toggle="tooltip" title=""
                   data-bs-original-title="Half day hours">HD Hrs</th>
                <th scope="col" data-bs-toggle="tooltip" title=""
                   data-bs-original-title="Break start time">Brk start </th>
                <th scope="col" data-bs-toggle="tooltip" title=""
                   data-bs-original-title="Break End time">Brk End </th>
                <th scope="col"  data-bs-toggle="tooltip" title=""
                   data-bs-original-title="Break Hours">Brk Hrs</th>

            </tr>
        </thead>
        <tbody>
            @if (Model.ShiftList != null && Model.ShiftList.Count > 0)
            {
                @foreach (var item in Model.ShiftList)
                {
                    <tr>
                        <td data-label="Shift Name">@item.Name</td>
                        <td data-label="Shift Code">
                            @item.ShiftCode
                        </td>
                        <td data-label="Shift Category">@item.ShiftCategory.Name </td>
                        <td data-label="Start Time">@item.ShiftStartTime</td>
                        <td data-label="End Time">@item.ShiftEndTime</td>
                        <td data-label="Scheduled Hours">@item.ScheduledHour</td>
                        <td data-label="Full day Hours">@item.FullDayHour</td>
                        <td data-label="Half start Hours">@item.HalfDayHour</td>
                        <td data-label="Break start time">@item.BreakHourStartTime</td>
                        <td data-label="Break End Time">@item.BreakHourEndTime</td>
                        <td data-label="Break Hours">@item.BreakHour</td>
                    </tr>

                }
            }


        </tbody>
    </table>
</div>